+// The CrASHink tab: options that belong to this firmware fork rather
+// than to upstream CrossInk. New fork-only settings go here.
+inline std::vector<SettingInfo> buildCrashinkSettingsList(const std::vector<SettingInfo>& allSettings) {
+  std::vector<SettingInfo> settings;
+  settings.push_back(SettingInfo::Action(StrId::STR_STATUS_BAR_ICONS, SettingAction::StatusIcons));
+  addSettingByName(settings, allSettings, StrId::STR_READEST_AUTO_SYNC);
+  return settings;
+}
