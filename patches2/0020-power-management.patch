diff --git a/lib/hal/HalFrontlight.cpp b/lib/hal/HalFrontlight.cpp
index 2abea91af2bc5a2e37653eb202cc0bb19708fb19..4a44a1357f11f67bd4c4f42caa719f74ffa06a64 100644
--- a/lib/hal/HalFrontlight.cpp
+++ b/lib/hal/HalFrontlight.cpp
@@ -8,6 +8,9 @@ void HalFrontlight::begin(const uint8_t brightness, const uint8_t warmth, const
   if (!manager.present()) {
     return;
   }
+#ifdef FREEINK_FRONTLIGHT_LS
+  manager.releaseOnWake();
+#endif
   manager.begin();
   lastBrightness = brightness > 100 ? 100 : brightness;
   manager.setColorTemperature(warmth > 100 ? 100 : warmth);
@@ -34,3 +37,11 @@ void HalFrontlight::setOn(const bool on) {
   lit = on;
   manager.setBrightness(lit ? lastBrightness : 0);
 }
+
+void HalFrontlight::prepareForDeepSleep() {
+  if (!manager.present()) return;
+  setOn(false);
+#ifdef FREEINK_FRONTLIGHT_LS
+  manager.park();
+#endif
+}
