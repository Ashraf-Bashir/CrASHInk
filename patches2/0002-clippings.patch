new file mode 100644
--- /dev/null
+++ b/src/activities/reader/ClippingListPaging.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <algorithm>
+
+struct ClippingListPaging {
+  int total, rows, top;
+  int pageRows() const { return std::max(1, rows); }
+  int pages() const { return std::max(1, (total + pageRows() - 1) / pageRows()); }
+  int page() const { return std::min(pages(), (std::max(0, top) + pageRows() - 1) / pageRows() + 1); }
+  int destination(bool next) const {
+    return std::max(0, std::min(std::max(0, top) + (next ? pageRows() : -pageRows()), std::max(0, total - pageRows())));
+  }
+};
