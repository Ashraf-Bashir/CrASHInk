+namespace {
+bool contains(const Rect& r, int x, int y, int pad = 0) {
+  return r.width > 0 && r.height > 0 && x >= r.x - pad && x < r.x + r.width + pad && y >= r.y - pad &&
+         y < r.y + r.height + pad;
+}
+void disk(const GfxRenderer& renderer, int x, int y, int radius, bool black) {
+  for (int dy = -radius; dy <= radius; ++dy)
+    for (int dx = -radius; dx <= radius; ++dx)
+      if (dx * dx + dy * dy <= radius * radius) renderer.drawPixel(x + dx, y + dy, black);
+}
+
+void toolbarIcon(const GfxRenderer& renderer, const HighlightToolbar::Bounds& button, HighlightToolbar::Action action) {
+  const int x = button.x + (button.width - 24) / 2;
+  const int y = button.y + (button.height - 24) / 2;
+  const auto line = [&](int x1, int y1, int x2, int y2) { renderer.drawLine(x + x1, y + y1, x + x2, y + y2, 3, true); };
+  if (action == HighlightToolbar::Action::Delete) {
+    line(4, 5, 20, 5);
+    line(9, 2, 15, 2);
+    line(9, 2, 9, 5);
+    line(15, 2, 15, 5);
+    line(6, 8, 7, 22);
+    line(7, 22, 17, 22);
+    line(17, 22, 18, 8);
+    line(10, 10, 10, 18);
+    line(14, 10, 14, 18);
+  } else {
+    line(3, 21, 5, 14);
+    line(5, 14, 17, 2);
+    line(17, 2, 22, 7);
+    line(22, 7, 10, 19);
+    line(10, 19, 3, 21);
+    line(14, 5, 19, 10);
+  }
+}
+
+}  // namespace
+
+OnPageHighlightActivity::OnPageHighlightActivity(GfxRenderer& renderer, MappedInputManager& input,
+                                                 std::shared_ptr<Epub> book, std::unique_ptr<Page> page,
+                                                 size_t clippingIndex, int left, int top, float hint,
+                                                 void* readerContext, PageLoader pageLoader)
+    : Activity("OnPageHighlight", renderer, input),
+      book(std::move(book)),
+      page(std::move(page)),
+      index(clippingIndex),
+      left(left),
+      top(top),
+      hint(hint),
+      readerContext(readerContext),
+      pageLoader(pageLoader) {}
+
+void OnPageHighlightActivity::onEnter() {
+  Activity::onEnter();
+  const auto* clip = CLIPPINGS.clippingAt(index);
+  std::string text;
+  if (clip) spine = clip->spineIndex;
+  // Temporary quote/page strings are bounded by CLIPPING_TEXT_MAX (60 KiB),
+  // released before the first render; no second framebuffer is retained.
+  ready = clip && clip->tableSelection == UINT16_MAX && CLIPPINGS.readClippingText(index, text) &&
+          ChapterXPathResolver::locateText(book, spine, text, hint, original) && !original.loose;
+  range = saved = {original.start, original.end};
+  text.clear();
+  text.shrink_to_fit();
+  ready = ready && buildWords();
+  failed = !ready;
+  requestUpdate();
+}
+
+bool OnPageHighlightActivity::visitLine(const PageTextLine& line, bool measure, std::string& text) {
+  if (!line.block || line.isTableText) return false;
+  const auto& block = *line.block;
+  const uint16_t row = buildRow++;
+  for (uint16_t i = 0; i < block.wordCount(); ++i) {
+    std::string token(block.wordText(i));
+    if (block.wordEndsWithInsertedHyphen(i) && !token.empty() && token.back() == '-') token.pop_back();
+    const uint32_t length = ChapterXPathResolver::strictTextLength(token);
+    if (!length) continue;
+    if (measure) {
+      if (++wordCount > 1024 || text.size() + token.size() + 1 > CLIPPING_TEXT_MAX) return false;
+      text += token;
+      text += ' ';
+    } else {
+      const auto geometry = pageWordGeometry(renderer, SETTINGS.getReaderFontId(), line, block, i);
+      const int font = block.resolvedFontId(renderer, SETTINGS.getReaderFontId());
+      const auto style = static_cast<EpdFontFamily::Style>(block.wordStyle(i) & ~EpdFontFamily::UNDERLINE);
+      const bool rtl = (BidiUtils::detectParagraphLevel(token.c_str(), block.getBlockStyle().isRtl ? 1 : 0) & 1) != 0;
+      const int rawX = block.wordXpos(i);
+      // Reuse the token's own buffer to measure prefixes; no extra strings or
+      // per-frame glyph measurements are needed while the handles move.
+      const auto advance = [&](size_t bytes) {
+        if (!bytes) return 0;
+        const char old = token[bytes];
+        token[bytes] = '\0';
+        const int width = renderer.getTextAdvanceX(font, token.c_str(), style);
+        token[bytes] = old;
+        return width;
+      };
+      forEachHighlightWordSlice(token, original.total, saved.start, saved.end,
+          [](std::string_view glyph) { return ChapterXPathResolver::strictTextLength(std::string(glyph)); },
+          [&](size_t first, size_t end, uint32_t start, uint32_t last) {
+            auto& word = words[wordCount++];
+            const int from = advance(first), to = advance(end);
+            const int fullWidth = advance(token.size());
+            const int pieceLeft = rtl ? fullWidth - to : from;
+            const int pieceRight = rtl ? fullWidth - from : to;
+            const int x = first == 0 && end == token.size() ? geometry.xOffset
+                              : std::max(geometry.xOffset, rawX + pieceLeft);
+            const int right = first == 0 && end == token.size() ? geometry.xOffset + geometry.width
+                              : std::min(geometry.xOffset + geometry.width, rawX + pieceRight);
+            word.rect = Rect{left + line.xPos + x, top + line.yPos, std::max(0, right - x),
+                             line.lineHeight > 0 ? line.lineHeight : renderer.getLineHeight(SETTINGS.getReaderFontId())};
+            word.row = row;
+            word.rtl = rtl;
+            word.start = start;
+            word.end = last;
+          });
+      original.total += length;
+    }
+  }
+  return true;
+}
+
+bool OnPageHighlightActivity::buildWords() {
+  std::string text;
+  text.reserve(std::min<size_t>(CLIPPING_TEXT_MAX, 4096));
+  struct Context {
+    OnPageHighlightActivity* self;
+    bool measure;
+    std::string* text;
+  } context{this, true, &text};
+  const auto visitor = [](const PageTextLine& line, void* raw) {
+    auto& c = *static_cast<Context*>(raw);
+    return c.self->visitLine(line, c.measure, *c.text);
+  };
+  if (!page || !page->forEachTextLine(visitor, &context) || !wordCount) return false;
+  XPathTextLocation pageLocation;
+  if (!ChapterXPathResolver::locateText(book, spine, text, hint, pageLocation) || pageLocation.loose) return false;
+  const uint32_t pageLength = ChapterXPathResolver::strictTextLength(text);
+  if (pageLocation.end - pageLocation.start + 1 != pageLength ||
+      (!dragging.load() && (range.end < pageLocation.start || range.start > pageLocation.end)))
+    return false;
+  // Activity-lifetime page geometry: <=1024 words (~28 KiB), too large for
+  // the task stack. Fallible and allocated once, never while dragging/rendering.
+  // The two saved endpoints can each split one layout word.
+  words = makeUniqueNoThrow<Word[]>(wordCount + 2);
+  if (!words) {
+    LOG_ERR("CLIP", "Cannot allocate on-page word geometry");
+    return false;
+  }
+  wordCount = 0;
+  buildRow = 0;
+  context.measure = false;
+  const uint32_t total = original.total;
+  original.total = pageLocation.start;
+  const bool ok = page->forEachTextLine(visitor, &context);
+  original.total = total;
+  if (ok && wordCount) {
+    int first = words[0].rect.y, last = first;
+    for (size_t i = 0; i < wordCount; ++i) {
+      first = std::min(first, words[i].rect.y);
+      last = std::max(last, words[i].rect.y + words[i].rect.height);
+    }
+    firstTextY.store(first);
+    lastTextBottom.store(last);
+  }
+  return ok;
+}
+
+bool OnPageHighlightActivity::turnPage(const int direction) {
+  if (!pageLoader || !readerContext || !ready || activeEdge < 0 || (direction != -1 && direction != 1)) return false;
+  float nextHint = hint;
+  auto next = pageLoader(readerContext, pageOffset + direction, nextHint);
+  if (!next) return false;  // chapter boundary or read failure: preserve the draft
+  auto previousPage = std::move(page);
+  auto previousWords = std::move(words);
+  const size_t previousCount = wordCount;
+  const auto previousRow = buildRow;
+  const float previousHint = hint;
+  const int previousTop = firstTextY.load(), previousBottom = lastTextBottom.load();
+  page = std::move(next);
+  hint = nextHint;
+  wordCount = 0;
+  buildRow = 0;
+  // Keep the previous geometry until this page has an exact chapter mapping.
+  // At most two bounded geometry arrays during a page change; no framebuffer.
+  bool valid = buildWords() && wordCount > 0;
+  if (valid) {
+    const auto& boundary = words[direction > 0 ? 0 : wordCount - 1];
+    auto candidate = range;
+    valid = candidate.move(activeEdge == 0, boundary.start, boundary.end) ||
+            (candidate.start == range.start && candidate.end == range.end &&
+             (activeEdge == 0 ? boundary.start == range.start : boundary.end == range.end));
+    if (valid) range = candidate;
+  }
+  if (!valid) {
+    page = std::move(previousPage);
+    words = std::move(previousWords);
+    wordCount = previousCount;
+    buildRow = previousRow;
+    hint = previousHint;
+    firstTextY.store(previousTop);
+    lastTextBottom.store(previousBottom);
+    LOG_ERR("CLIP", "Cannot map adjacent page for highlight adjustment");
+    return false;
+  }
+  pageOffset += direction;
+  dragOffsetX = dragOffsetY = 0;
+  dragFrameReady = false;  // paint the NEW page text before any differential selection
+  firstSnapshot = {};
+  lastSnapshot = {};
+  waitForPageMotion.store(true);
+  return true;
+}
+
+void OnPageHighlightActivity::returnAction(bool editor, int x, int y) {
+  setResult(HighlightPageAction{editor, static_cast<uint16_t>(index), x, y});
+  finish();
+}
+
+void OnPageHighlightActivity::updateDrag() {
+  if (!ready || activeEdge < 0 || waitForPageMotion.load()) return;
+  const int x = dragX.load() + dragOffsetX, y = dragY.load() + dragOffsetY;
+  size_t best = wordCount;
+  int64_t distance = INT64_MAX;
+  for (size_t i = 0; i < wordCount; ++i) {
+    const auto& r = words[i].rect;
+    if (!contains(r, x, y)) continue;
+    const int dx = x - r.x - r.width / 2;
+    const int dy = y < r.y ? r.y - y : y > r.y + r.height ? y - r.y - r.height : 0;
+    const int64_t d = static_cast<int64_t>(dy) * dy * 16 + static_cast<int64_t>(dx) * dx;
+    if (d < distance) {
+      distance = d;
+      best = i;
+    }
+  }
+  if (best < wordCount) range.move(activeEdge == 0, words[best].start, words[best].end);
+}
+
+void OnPageHighlightActivity::saveRange() {
+  if (range.start == saved.start && range.end == saved.end) return;
+  auto location = original;
+  location.start = range.start;
+  location.end = range.end;
+  std::string text;
+  // Only the release commits, so dragging performs no chapter reads or SD writes.
+  if (!ChapterXPathResolver::extractText(book, spine, location, text) || text.empty() ||
+      !CLIPPINGS.updateClippingText(index, text)) {
+    failed = true;
+    range = saved;
+  } else {
+    saved = range;
+    failed = false;
+  }
+}
+
+void OnPageHighlightActivity::loop() {
+  int x = 0, y = 0;
+  if (dragging.load()) {
+    if (mappedInput.isScreenTouchHeld(x, y)) {
+      if (x != dragX.load() || y != dragY.load()) {
+        waitForPageMotion.store(false);
+        dragX.store(x);
+        dragY.store(y);
+        requestUpdate();
+      }
+      const int direction =
+          dragPaging.track(x, y, firstTextY.load(), lastTextBottom.load(), renderer.getScreenHeight(), millis());
+      if (direction && !RenderLock::peek()) {
+        RenderLock lock(*this);
+        if (turnPage(direction)) requestUpdate();
+        dragPaging.turned(x, y);  // do not retry failed/boundary reads until movement
+      }
+      return;
+    }
+    releasePending = true;
+  }
+  if (releasePending) {
+    if (RenderLock::peek()) return;
+    RenderLock lock(*this);
+    updateDrag();
+    saveRange();
+    activeEdge = -1;
+    dragging.store(false);
+    releasePending = false;
+    if (failed)
+      requestUpdate();
+    else {
+      closeAfterAdjustment = true;
+      setResult(HighlightPageAction{false, static_cast<uint16_t>(index), 0, 0, pageOffset, true});
+      finish();
+    }
+    return;
+  }
+  if (RenderLock::peek()) return;
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    finish();
+    return;
+  }
+  if (mappedInput.wasScreenTouchDown(x, y) || mappedInput.isScreenTouchHeld(x, y)) {
+    RenderLock lock(*this);
+    const bool first = contains(firstHandle, x, y, 14), last = contains(lastHandle, x, y, 14);
+    if (ready && (first || last) && !toolbar.indexAt(x, y)) {
+      const auto distance = [&](const Rect& h) {
+        const int64_t dx = x - h.x - h.width / 2;
+        const int64_t dy = y - h.y - h.height / 2;
+        return dx * dx + dy * dy;
+      };
+      activeEdge = first && (!last || distance(firstHandle) <= distance(lastHandle)) ? 0 : 1;
+      const Rect& handle = activeEdge == 0 ? firstHandle : lastHandle;
+      dragOffsetY = (activeEdge == 0 ? firstAnchorY : lastAnchorY) - handle.y - handle.height / 2;
+      // Anchor inside the selected edge, even when two word pieces touch.
+      // Merely grabbing a handle must not select the neighboring piece.
+      dragOffsetX = handle.x + handle.width / 2 - x;
+      for (size_t i = 0; i < wordCount; ++i) {
+        const auto& word = words[i];
+        if ((activeEdge == 0 && range.start == word.start) || (activeEdge == 1 && range.end == word.end)) {
+          dragOffsetX += (activeEdge == 0) != word.rtl ? 1 : -1;
+          break;
+        }
+      }
+      dragX.store(x);
+      dragY.store(y);
+      dragPaging.begin(x, y);
+      waitForPageMotion.store(false);
+      dragging.store(true);
+      requestUpdate();  // hide Edit as soon as a handle is touched
+      return;
+    }
+  }
+  unsigned long held = 0;
+  if (mappedInput.isScreenTouchTapCandidate(x, y, held) && held >= HighlightTouchPolicy::SelectionHoldMs &&
+      !toolbar.indexAt(x, y).has_value()) {
+    returnAction(false, x, y);
+    return;
+  }
+  if (mappedInput.wasScreenTapped(x, y)) {
+    if (ignoreOpeningRelease) {
+      ignoreOpeningRelease = false;
+      return;
+    }
+    if (const auto item = toolbar.indexAt(x, y)) {
+      switch (HighlightToolbar::Actions[*item]) {
+        case HighlightToolbar::Action::Edit:
+          returnAction(true);
+          break;
+        case HighlightToolbar::Action::Delete: {
+          RenderLock lock(*this);
+          if (CLIPPINGS.removeClippingAt(index))
+            finish();
+          else {
+            failed = true;
+            requestUpdate();
+          }
+          break;
+        }
+      }
+    } else if (!contains(firstHandle, x, y, 14) && !contains(lastHandle, x, y, 14))
+      finish();
+  } else
+    ignoreOpeningRelease = false;
+}
+
+void OnPageHighlightActivity::HandleSnapshot::capture(GfxRenderer& renderer, const Rect& handle, int stemY) {
+  rect = Rect{};
+  valid = true;
+  if (!handle.width) return;
+  const int x = std::max(0, handle.x - 4), y = std::max(0, std::min(handle.y, stemY) - 4);
+  const int right = std::min(renderer.getScreenWidth(), handle.x + handle.width + 4);
+  const int bottom = std::min(renderer.getScreenHeight(), std::max(handle.y + handle.height, stemY + 4) + 4);
+  rect = Rect{x, y, right - x, bottom - y};
+  valid = renderer.readFramebufferRegion(x, y, rect.width, rect.height, bytes.data(), bytes.size()) != 0;
+}
+void OnPageHighlightActivity::HandleSnapshot::restore(GfxRenderer& renderer) const {
+  if (valid && rect.width > 0) renderer.writeFramebufferRegion(rect.x, rect.y, rect.width, rect.height, bytes.data());
+}
+
+void OnPageHighlightActivity::render(RenderLock&&) {
+  // A queued drag repaint must not flash the toolbar before the parent resumes.
+  if (closeAfterAdjustment) return;
+  updateDrag();
+  const bool incremental = dragging.load() && dragFrameReady && firstSnapshot.valid && lastSnapshot.valid;
+  if (incremental) {
+    lastSnapshot.restore(renderer);
+    firstSnapshot.restore(renderer);
+  } else
+    renderer.clearScreen();
+  if (page && !incremental) {
+    const GfxRenderer::TextWeightScope weight(renderer, SETTINGS.textWeightOffset());
+    renderer.setInvertImages(SETTINGS.invertImagesDark != 0);
+    auto scope = renderer.getFontCacheManager()->createPrewarmScope();
+    page->render(renderer, SETTINGS.getReaderFontId(), left, top, true);
+    scope.endScanAndPrewarm();
+    page->render(renderer, SETTINGS.getReaderFontId(), left, top, true);
+  }
+  firstHandle = Rect{};
+  lastHandle = Rect{};
+  Rect selection{};
+  int firstStemY = 0, lastStemY = 0;
+  for (size_t i = 0; ready && i < wordCount; ++i) {
+    const auto& w = words[i];
+    const bool selected = w.end >= range.start && w.start <= range.end;
+    const bool wasSelected = incremental && w.end >= paintedRange.start && w.start <= paintedRange.end;
+    const auto& r = w.rect;
+    if (selected != wasSelected) renderer.invertRect(r.x, r.y, r.width, r.height);
+    if (i > 0 && words[i - 1].row == w.row) {
+      const auto& previous = words[i - 1];
+      const bool joined = selected && previous.end >= range.start && previous.start <= range.end;
+      const bool wasJoined = wasSelected && previous.end >= paintedRange.start && previous.start <= paintedRange.end;
+      if (joined != wasJoined) {
+        const auto& p = previous.rect;
+        const auto gap = SelectionGap::between({p.x, p.y, p.width, p.height}, {r.x, r.y, r.width, r.height});
+        if (gap.width > 0) renderer.invertRect(gap.x, gap.y, gap.width, gap.height);
+      }
+    }
+    if (!selected) continue;
+    if (!selection.width)
+      selection = r;
+    else {
+      const int right = std::max(selection.x + selection.width, r.x + r.width);
+      const int bottom = std::max(selection.y + selection.height, r.y + r.height);
+      selection.x = std::min(selection.x, r.x);
+      selection.y = std::min(selection.y, r.y);
+      selection.width = right - selection.x;
+      selection.height = bottom - selection.y;
+    }
+    if (range.start >= w.start && range.start <= w.end) {
+      firstAnchorY = r.y + r.height / 2;
+      firstStemY = r.y;
+      firstHandle = Rect{std::clamp(w.rtl ? r.x + r.width - 10 : r.x - 10, 0, renderer.getScreenWidth() - 20),
+                         std::clamp(r.y - 20, 0, renderer.getScreenHeight() - 20), 20, 20};
+    }
+    if (range.end >= w.start && range.end <= w.end) {
+      lastAnchorY = r.y + r.height / 2;
+      lastStemY = r.y + r.height;
+      lastHandle = Rect{std::clamp(w.rtl ? r.x - 10 : r.x + r.width - 10, 0, renderer.getScreenWidth() - 20),
+                        std::clamp(r.y + r.height, 0, renderer.getScreenHeight() - 20), 20, 20};
+    }
+  }
+  if (dragging.load()) {
+    firstSnapshot.capture(renderer, firstHandle, firstStemY);
+    lastSnapshot.capture(renderer, lastHandle, lastStemY);
+  }
+  for (const bool last : {false, true}) {
+    const Rect& h = last ? lastHandle : firstHandle;
+    if (!h.width) continue;
+    const int x = h.x + h.width / 2, y = h.y + h.height / 2;
+    const int stemY = last ? lastStemY : firstStemY;
+    renderer.drawLine(x, stemY, x, y, 4, false);
+    renderer.drawLine(x, stemY, x, y, 2, true);
+    disk(renderer, x, y, 9, false);
+    disk(renderer, x, y, 7, true);
+  }
+  toolbar = {};
+  if (!dragging.load()) {
+    int bezelTop, bezelRight, bezelBottom, bezelLeft;
+    renderer.getOrientedViewableTRBL(&bezelTop, &bezelRight, &bezelBottom, &bezelLeft);
+    const HighlightToolbar::Bounds view{bezelLeft + 6, bezelTop + 6,
+                                        renderer.getScreenWidth() - bezelLeft - bezelRight - 12,
+                                        renderer.getScreenHeight() - bezelTop - bezelBottom - 12};
+    toolbar = HighlightToolbar::nearSelection({selection.x, selection.y, selection.width, selection.height}, view,
+                                              {firstHandle.x, firstHandle.y, firstHandle.width, firstHandle.height},
+                                              {lastHandle.x, lastHandle.y, lastHandle.width, lastHandle.height});
+    const int width = toolbar.area.width, height = toolbar.area.height;
+    const auto& card = toolbar.area;
+    // One flat white surface, without a shadow or stacked outline.
+    renderer.fillRoundedRect(card.x, card.y, width, height, 8, Color::White);
+    renderer.drawRoundedRect(card.x, card.y, width, height, 1, 8, true);
+    for (size_t i = 0; i < HighlightToolbar::Actions.size(); ++i) {
+      const auto button = toolbar.button(i);
+      if (i % toolbar.columns != 0)
+        renderer.drawLine(button.x, button.y + 10, button.x, button.y + button.height - 10, 1, true);
+      if (i >= toolbar.columns)
+        renderer.drawLine(button.x + 10, button.y, button.x + button.width - 10, button.y, 1, true);
+      toolbarIcon(renderer, button, HighlightToolbar::Actions[i]);
+    }
+    // Counteract output inversion only for the floating controls.
+    renderer.preserveImagePolarity(card.x, card.y, width, height);
+  }
+  if (failed) renderer.drawText(SMALL_FONT_ID, 8, renderer.getScreenHeight() - 24, tr(STR_HIGHLIGHT_EDIT_UNAVAILABLE));
+  paintedRange = range;
+  dragFrameReady = dragging.load();
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
