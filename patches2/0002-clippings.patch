diff --git a/src/activities/reader/HighlightChapterGroups.h b/src/activities/reader/HighlightChapterGroups.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/HighlightChapterGroups.h
@@ -0,0 +1,61 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+class HighlightChapterGroups {
+ public:
+  struct Entry {
+    uint32_t chapter;
+    uint16_t clipping;
+  };
+  struct Group {
+    uint32_t chapter;
+    uint32_t begin;
+    uint32_t count;
+    bool open = false;
+  };
+  std::vector<Entry> entries;
+  std::vector<Group> groups;
+  // Negative values identify headers; nonnegative values are ORIGINAL clipping indexes.
+  std::vector<int32_t> rows;
+  void build(std::vector<Entry> values) {
+    std::vector<uint32_t> opened;
+    opened.reserve(groups.size());
+    for (const auto& group : groups)
+      if (group.open) opened.push_back(group.chapter);
+    entries = std::move(values);
+    std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) {
+      return a.chapter != b.chapter ? a.chapter < b.chapter : a.clipping < b.clipping;
+    });
+    size_t count = 0;
+    for (size_t i = 0; i < entries.size(); ++i)
+      if (i == 0 || entries[i].chapter != entries[i - 1].chapter) ++count;
+    groups.clear();
+    groups.reserve(count);
+    for (size_t i = 0; i < entries.size(); ++i) {
+      if (groups.empty() || groups.back().chapter != entries[i].chapter)
+        groups.push_back({entries[i].chapter, static_cast<uint32_t>(i), 0,
+                          std::find(opened.begin(), opened.end(), entries[i].chapter) != opened.end()});
+      ++groups.back().count;
+    }
+    rows.reserve(entries.size() + groups.size());
+    rebuild();
+  }
+  void rebuild() {
+    rows.clear();
+    for (size_t i = 0; i < groups.size(); ++i) {
+      rows.push_back(-static_cast<int32_t>(i) - 1);
+      if (groups[i].open)
+        for (size_t j = groups[i].begin; j < groups[i].begin + groups[i].count; ++j)
+          rows.push_back(entries[j].clipping);
+    }
+  }
+  bool header(int row) const { return row >= 0 && row < static_cast<int>(rows.size()) && rows[row] < 0; }
+  void toggle(int row) {
+    if (!header(row)) return;
+    const size_t group = static_cast<size_t>(-rows[row] - 1);
+    groups[group].open = !groups[group].open;
+    rebuild();
+  }
+};
diff --git a/src/activities/reader/HighlightChapterLabels.h b/src/activities/reader/HighlightChapterLabels.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/HighlightChapterLabels.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Neither a title nor a TOC entry alone identifies a chapter. Match both when
+// merging EPUB parts; without TOC metadata, retain the logical spine identity.
+// Stable keys preserve expanded groups through rebuilds and deletes.
+class HighlightChapterLabels {
+ public:
+  struct Label { uint32_t key; uint16_t spine; std::string title; int toc = -1; };
+  std::vector<Label> labels;
+  static std::string normalizedTitle(const std::string& text) {
+    std::string result;
+    result.reserve(text.size());
+    bool pendingSpace = false;
+    for (size_t i = 0; i < text.size();) {
+      const auto c = static_cast<unsigned char>(text[i]);
+      size_t space = (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\f' || c == '\v') ? 1 : 0;
+      if (i + 1 < text.size() && c == 0xC2 && static_cast<unsigned char>(text[i + 1]) == 0xA0) space = 2;
+      if (i + 2 < text.size() && c == 0xE2 && static_cast<unsigned char>(text[i + 1]) == 0x80) {
+        const auto last = static_cast<unsigned char>(text[i + 2]);
+        if ((last >= 0x80 && last <= 0x8A) || last == 0xA8 || last == 0xA9 || last == 0xAF) space = 3;
+        if (last == 0x8B || last == 0x8E || last == 0x8F) { i += 3; continue; }
+      }
+      if (space) { pendingSpace = !result.empty(); i += space; continue; }
+      if (pendingSpace) { result += ' '; pendingSpace = false; }
+      result += text[i++];
+    }
+    return result;
+  }
+  uint32_t keyFor(uint16_t spine, const std::string& title, int toc = -1) {
+    const std::string normalized = normalizedTitle(title);
+    uint32_t count = 0;
+    for (const auto& label : labels) {
+      if (label.title == normalized &&
+          (label.spine == spine || (toc >= 0 && label.toc == toc && !normalized.empty()))) return label.key;
+      if (label.spine == spine) ++count;
+    }
+    const uint32_t key = (static_cast<uint32_t>(spine) << 16) | count;
+    labels.push_back({key, spine, normalized, toc});
+    return key;
+  }
+  const char* title(uint32_t key) const {
+    for (const auto& label : labels) if (label.key == key) return label.title.c_str();
+    return "";
+  }
+};
diff --git a/src/activities/reader/HighlightDragPaging.h b/src/activities/reader/HighlightDragPaging.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/HighlightDragPaging.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <cstdint>
+
+// Main-loop-only dwell state. One page per deliberate edge approach; after a
+// turn, wait for fresh movement so a stationary finger cannot skip text.
+struct HighlightDragPaging {
+  int x = 0, y = 0, direction = 0;
+  uint32_t entered = 0;
+  bool moved = false, waiting = false;
+  void begin(int px, int py) {
+    x = px;
+    y = py;
+    direction = 0;
+    entered = 0;
+    moved = false;
+    waiting = false;
+  }
+  void turned(int px, int py) {
+    begin(px, py);
+    waiting = true;
+  }
+  int track(int px, int py, int textTop, int textBottom, int screenHeight, uint32_t now) {
+    const bool motion = px != x || py != y;
+    x = px;
+    y = py;
+    if (waiting && !motion) return 0;
+    if (motion) {
+      moved = true;
+      waiting = false;
+    }
+    if (!moved) return 0;
+    const int target = py < 48 || py < textTop - 8 ? -1 : py >= screenHeight - 48 || py > textBottom + 8 ? 1 : 0;
+    if (target != direction) {
+      direction = target;
+      entered = now;
+      return 0;
+    }
+    return target && static_cast<uint32_t>(now - entered) >= 200 ? target : 0;
+  }
+};
diff --git a/src/activities/reader/HighlightEditActivity.cpp b/src/activities/reader/HighlightEditActivity.cpp
