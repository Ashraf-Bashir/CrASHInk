+#pragma once
+
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+#include "ClippingTextMatcher.h"
+
+// A rejection filter only: collisions and uncertain fragments always fall back
+// to the existing matcher. No text, layout coordinates, or owning pointers.
+namespace clippingPageFilter {
+struct Prefix {
+  uint32_t hash = 2166136261U;
+  uint8_t length = 0;
+  uint8_t shortHashes[2] = {};
+};
+inline bool space(uint32_t cp) {
+  return (cp < 128 && std::isspace(static_cast<unsigned char>(cp))) || cp == 0xA0 || cp == 0x2003 || cp == 0x202F;
+}
+inline uint32_t append(uint32_t hash, uint32_t cp) {
+  return (hash ^ ClippingTextMatcher::foldForMatch(cp)) * 16777619U;
+}
+inline uint8_t shortHash(uint32_t hash) { return static_cast<uint8_t>(hash ^ (hash >> 16)); }
+inline uint64_t hashBit(uint32_t hash) { return uint64_t{1} << ((hash ^ (hash >> 16)) & 63); }
+inline Prefix prefix(const char* text, size_t size) {
+  Prefix result;
+  size_t offset = 0;
+  while (offset < size && result.length < 3) {
+    const auto cp = ClippingTextMatcher::nextCodepoint(text, size, offset);
+    if (!result.length && ClippingTextMatcher::isEdgePunctuation(cp)) continue;
+    result.hash = append(result.hash, cp);
+    if (result.length < 2) result.shortHashes[result.length] = shortHash(result.hash);
+    ++result.length;
+  }
+  return result;
+}
+struct Text {
+  uint64_t continuations = 0;
+  uint32_t firstHash = 0;
+  uint8_t shortHashes[2] = {};
+  uint8_t firstLength = 0;  // 0: not built; 255: cannot safely reject
+  void build(const char* text, size_t size) {
+    *this = {};
+    size_t offset = 0;
+    while (offset < size) {
+      size_t start = offset;
+      auto cp = ClippingTextMatcher::nextCodepoint(text, size, offset);
+      if (space(cp)) continue;
+      size_t end = offset;
+      while (offset < size) {
+        size_t next = offset;
+        cp = ClippingTextMatcher::nextCodepoint(text, size, next);
+        if (space(cp)) break;
+        offset = next;
+        end = offset;
+      }
