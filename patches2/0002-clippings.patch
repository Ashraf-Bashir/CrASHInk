+#include "fontIds.h"
+
+namespace {
+// KOReader's boundary controls use the symbols ◁▒▒, ▷☓▒, ▒☓◁, ▒▒▷.
+// Draw the same outline arrows, crossed-out word and shaded word blocks
+// directly: the UI font need not contain these Unicode glyphs.
+void drawBoundaryIcon(const GfxRenderer& renderer, const Rect& rect, const int action) {
+  constexpr int cell = 14;
+  constexpr int gap = 3;
+  constexpr int height = 18;
+  const int left = rect.x + (rect.width - (3 * cell + 2 * gap)) / 2;
+  const int top = rect.y + (rect.height - height) / 2;
+  for (int slot = 0; slot < 3; ++slot) {
+    const int x = left + slot * (cell + gap);
+    const bool arrow = (action < 2 && slot == 0) || (action >= 2 && slot == 2);
+    const bool removed = (action == 1 || action == 2) && slot == 1;
+    if (arrow) {
+      const bool pointsLeft = action == 0 || action == 2;
+      const int tip = pointsLeft ? x + 1 : x + cell - 2;
+      const int base = pointsLeft ? x + cell - 2 : x + 1;
+      renderer.drawLine(tip, top + height / 2, base, top + 1, 2, true);
+      renderer.drawLine(base, top + 1, base, top + height - 2, 2, true);
+      renderer.drawLine(base, top + height - 2, tip, top + height / 2, 2, true);
+    } else if (removed) {
+      renderer.drawLine(x + 2, top + 2, x + cell - 3, top + height - 3, 2, true);
+      renderer.drawLine(x + cell - 3, top + 2, x + 2, top + height - 3, 2, true);
+    } else {
+      for (int y = 0; y < height; y += 2) {
+        for (int dx = (y / 2) % 2; dx < cell; dx += 2) renderer.fillRect(x + dx, top + y, 1, 1, true);
+      }
+    }
+  }
+}
+
+// One bounded preview line at a time, without a second copy of the full draft.
+std::string nextLine(const GfxRenderer& renderer, const std::string& text, size_t& offset, int width) {
+  while (offset < text.size() && text[offset] == ' ') ++offset;
+  const size_t start = offset;
+  size_t lastSpace = std::string::npos;
+  std::string line;
+  line.reserve(128);
+  while (offset < text.size()) {
+    const unsigned char ch = text[offset];
+    size_t bytes = ch < 0x80 ? 1 : ch < 0xE0 ? 2 : ch < 0xF0 ? 3 : ch <= 0xF4 ? 4 : 1;
+    if (offset + bytes > text.size()) bytes = 1;
+    line.append(text, offset, bytes);
+    if (renderer.getTextWidth(UI_10_FONT_ID, line.c_str()) > width && offset > start) {
+      if (lastSpace != std::string::npos) offset = lastSpace;
+      line = text.substr(start, offset - start);
+      break;
+    }
+    if (ch == ' ') lastSpace = offset;
+    offset += bytes;
+  }
+  return line;
+}
+}  // namespace
+
+HighlightEditActivity::HighlightEditActivity(GfxRenderer& renderer, MappedInputManager& input,
+                                             std::shared_ptr<Epub> book, size_t index, float positionHint)
+    : Activity("HighlightEdit", renderer, input), book(std::move(book)), index(index), hint(positionHint) {}
+
+void HighlightEditActivity::onEnter() {
+  Activity::onEnter();
+  const Clipping* clipping = CLIPPINGS.clippingAt(index);
+  if (clipping && CLIPPINGS.readClippingText(index, draft)) {
+    spine = clipping->spineIndex;
+    tableSelection = clipping->tableSelection != UINT16_MAX;
+    std::string normalized;
+    // Strict matching preserves the actual words; never edit a fuzzy guess.
+    editable = ChapterXPathResolver::locateText(book, spine, draft, hint, location) && !location.loose &&
+               ChapterXPathResolver::extractText(book, spine, location, normalized) && !normalized.empty();
+    if (editable) {
+      draft = std::move(normalized);
+      hint = location.total ? static_cast<float>(location.start) / location.total : hint;
+    }
+  }
+  originalDraft.reset(draft);
+  changed = false;
+  refreshContext();
+  failed = !editable;
+  requestUpdate();
+}
+
+void HighlightEditActivity::refreshContext() {
+  if (!editable) return;
+  // Keep nearby whole words for repeated adjustments. Refill only an exhausted
+  // side; never relocate the quote after each click (repeated quotes can drift).
+  for (const bool before : {true, false}) {
+    auto& text = before ? beforeContext : afterContext;
+    if (!text.empty() || (before ? location.start == 0 : location.end + 1 >= location.total)) continue;
+    for (uint32_t budget = 256; budget <= CLIPPING_TEXT_MAX; budget *= 2) {
+      auto context = location;
+      context.start = before ? (location.start > budget ? location.start - budget : 0) : location.end + 1;
+      context.end = before ? location.start - 1 : std::min(location.total - 1, context.start + budget - 1);
+      if (!ChapterXPathResolver::extractText(book, spine, context, text)) break;
+      const bool edge = before ? context.start == 0 : context.end + 1 == location.total;
+      const auto split = before ? text.find(' ') : text.rfind(' ');
+      if (edge) break;
+      if (split != std::string::npos) {
+        if (before)
+          text.erase(0, split + 1);
+        else
+          text.erase(split);
+        break;
+      }
+      text.clear();
+    }
+  }
+}
+
+Rect HighlightEditActivity::buttonRect(int button) const {
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  constexpr int gap = 6;
+  constexpr int height = 44;
+  const int row = button < 4 ? 0 : 1;
+  const int cols = row == 0 ? 4 : 3;
+  const int col = row == 0 ? button : button - 4;
+  const int width = (safe.width - gap * (cols + 1)) / cols;
+  return Rect{safe.x + gap + col * (width + gap), safe.y + safe.height - (2 - row) * (height + gap), width, height};
+}
+
+Rect HighlightEditActivity::closeRect() const {
+  const Rect header = TouchHeaderBackButton::compactHeaderRect(renderer);
+  return Rect{header.x + header.width - 48, header.y, 48, 48};
+}
+
+void HighlightEditActivity::adjust(HighlightWordEdit::Action action) {
+  // The panel refresh may take hundreds of ms. Let the main task keep accepting
+  // clicks while the render task displays; preserve their order in a bounded FIFO.
+  const unsigned write = actionWrite.load(std::memory_order_relaxed);
+  if (write - actionRead.load(std::memory_order_acquire) >= queuedActions.size()) return;
+  queuedActions[write % queuedActions.size()] = action;
+  actionWrite.store(write + 1, std::memory_order_release);
+  requestUpdate();
+}
+
+void HighlightEditActivity::applyQueuedActions() {
+  unsigned read = actionRead.load(std::memory_order_relaxed);
+  const unsigned write = actionWrite.load(std::memory_order_acquire);
+  while (read != write) {
+    applyAdjustment(queuedActions[read % queuedActions.size()]);
+    actionRead.store(++read, std::memory_order_release);
+  }
+}
+
+void HighlightEditActivity::applyAdjustment(HighlightWordEdit::Action action) {
+  failed = false;
+  if (!editable) {
+    failed = true;
+    return;
+  }
+  const bool start = action == HighlightWordEdit::Action::ExtendStart || action == HighlightWordEdit::Action::TrimStart;
+  const bool extending =
+      action == HighlightWordEdit::Action::ExtendStart || action == HighlightWordEdit::Action::ExtendEnd;
+  std::string neighbour;
+  auto& context = start ? beforeContext : afterContext;
+  if (extending) {
+    if (tableSelection) {
+      failed = true;
+      return;
+    }
+    refreshContext();
+    if (context.empty()) {
+      failed = true;
+      return;
+    }
+    const auto split = start ? context.rfind(' ') : context.find(' ');
+    neighbour = start ? context.substr(split == std::string::npos ? 0 : split + 1) : context.substr(0, split);
+  }
+  std::string replacement;
+  if (!HighlightWordEdit::adjust(draft, action, neighbour, CLIPPING_TEXT_MAX, replacement)) {
+    failed = true;
+    return;
+  }
+  std::string removed;
+  if (extending) {
+    if (start)
+      context.erase(context.size() - neighbour.size());
+    else
+      context.erase(0, neighbour.size());
+    if (!context.empty() && context.front() == ' ') context.erase(0, 1);
+    if (!context.empty() && context.back() == ' ') context.pop_back();
+  } else {
+    removed = start ? draft.substr(0, draft.find(' ')) : draft.substr(draft.rfind(' ') + 1);
+    if (start) {
+      if (!context.empty()) context += ' ';
+      context += removed;
+    } else
+      context = removed + (context.empty() ? "" : " ") + context;
+    // Bound nearby context growth after a long sequence of trims.
+    if (context.size() > 4096) {
+      const auto split = start ? context.find(' ', context.size() - 2048) : context.rfind(' ', 2048);
+      if (split != std::string::npos) {
+        if (start)
+          context.erase(0, split + 1);
+        else
+          context.erase(split);
+      }
+    }
+  }
+  const uint32_t count = ChapterXPathResolver::strictTextLength(extending ? neighbour : removed);
+  if (start)
+    location.start = extending ? location.start - count : location.start + count;
+  else
+    location.end = extending ? location.end + count : location.end - count;
+  draft = std::move(replacement);
+  changed = originalDraft.changed(draft);
+  hint = location.total ? static_cast<float>(location.start) / location.total : hint;
+  previewPage = start ? 0 : INT_MAX;
+}
+
+void HighlightEditActivity::cancel() {
+  ActivityResult result;
+  result.isCancelled = true;
+  setResult(std::move(result));
+  finish();
+}
+
+void HighlightEditActivity::accept() {
+  RenderLock lock(*this);
+  applyQueuedActions();
+  if (!changed) return;
+  if (CLIPPINGS.updateClippingText(index, draft)) {
+    finish();
+  } else {
+    LOG_ERR("CLIP", "Failed to save edited clipping %u", static_cast<unsigned>(index));
+    failed = true;
+    requestUpdate();
+  }
+}
+
+void HighlightEditActivity::openSavedClipping() {
+  RenderLock lock(*this);
+  const Clipping* clipping = CLIPPINGS.clippingAt(index);
+  if (!clipping) return;
+  // Open navigates to the saved range; Save is the action that commits edits.
+  setResult(ClippingJumpResult{clipping->spineIndex, clipping->startPage, clipping->pageCount, clipping->paragraphIndex,
+                               static_cast<uint16_t>(index)});
+  finish();
+}
+
+void HighlightEditActivity::loop() {
+  if (mappedInput.wasTapInRect(closeRect().x, closeRect().y, closeRect().width, closeRect().height) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    cancel();
+    return;
+  }
+  if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
+    accept();
+    return;
+  }
+  const auto swipe = mappedInput.wasSwipe();
+  if (swipe == MappedInputManager::SwipeDir::Up || swipe == MappedInputManager::SwipeDir::Down) {
+    RenderLock lock(*this);
+    if (swipe == MappedInputManager::SwipeDir::Up && previewPage < previewPages - 1) {
+      ++previewPage;
+      requestUpdate();
+    } else if (swipe == MappedInputManager::SwipeDir::Down && previewPage > 0) {
+      --previewPage;
+      requestUpdate();
+    }
+    return;
+  }
+  for (int i = 0; i < 7; ++i) {
+    const Rect rect = buttonRect(i);
+    if (!mappedInput.wasTapInRect(rect.x, rect.y, rect.width, rect.height)) continue;
+    if (i < 4) {
+      static constexpr HighlightWordEdit::Action actions[] = {
+          HighlightWordEdit::Action::ExtendStart, HighlightWordEdit::Action::TrimStart,
+          HighlightWordEdit::Action::TrimEnd, HighlightWordEdit::Action::ExtendEnd};
+      adjust(actions[i]);
+    } else if (i == 4) {
+      accept();
+    } else if (i == 5) {
+      openSavedClipping();
+    } else if (i == 6) {
+      RenderLock lock(*this);
+      if (CLIPPINGS.removeClippingAt(index))
+        finish();
+      else {
+        failed = true;
+        requestUpdate();
+      }
+    } else {
+      cancel();
+    }
+    return;
+  }
+}
+
+void HighlightEditActivity::render(RenderLock&&) {
+  applyQueuedActions();
+  refreshContext();
+  renderer.clearScreen();
+  const Rect title = TouchHeaderBackButton::compactHeaderRect(renderer);
+  renderer.drawText(UI_10_FONT_ID, title.x + 12, title.y + 12, tr(STR_EDIT_HIGHLIGHT));
+  const Rect close = closeRect();
+  renderer.drawLine(close.x + 14, close.y + 14, close.x + close.width - 14, close.y + close.height - 14, 2, true);
+  renderer.drawLine(close.x + close.width - 14, close.y + 14, close.x + 14, close.y + close.height - 14, 2, true);
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  const Rect header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+  const int contextTop = header.y + header.height + 8;
+  const int width = std::max(1, safe.width - 24);
+  const int lineStep = renderer.getLineHeight(UI_10_FONT_ID) + 4;
+  const int top = contextTop + lineStep + 4;
+  const int rows = std::max(1, (buttonRect(0).y - top - lineStep - 44) / std::max(1, lineStep));
+  size_t offset = 0;
+  int lines = 0;
+  while (offset < draft.size()) {
+    nextLine(renderer, draft, offset, width);
+    ++lines;
+  }
+  previewPages = std::max(1, (lines + rows - 1) / rows);
+  previewPage = std::min(previewPage, previewPages - 1);
+  offset = 0;
+  for (int line = 0; line < (previewPage + 1) * rows && offset < draft.size(); ++line) {
+    const std::string text = nextLine(renderer, draft, offset, width);
+    if (line >= previewPage * rows) {
+      const int y = top + (line % rows) * lineStep;
+      renderer.fillRect(safe.x + 10, y, width + 4, lineStep, true);
+      renderer.drawText(UI_10_FONT_ID, safe.x + 12, y, text.c_str(), false);
+    }
+  }
+  if (previewPage == 0 && !beforeContext.empty()) {
+    size_t start = 0;
+    while (start < beforeContext.size() &&
+           renderer.getTextWidth(UI_10_FONT_ID, beforeContext.c_str() + start) > width - 24) {
+      ++start;
+      while (start < beforeContext.size() && (static_cast<unsigned char>(beforeContext[start]) & 0xC0) == 0x80) ++start;
+    }
+    const std::string before = "... " + beforeContext.substr(start);
+    renderer.drawText(UI_10_FONT_ID, safe.x + 12, contextTop, before.c_str());
+  }
+  if (previewPage == previewPages - 1 && !afterContext.empty()) {
+    const std::string after = renderer.truncatedText(UI_10_FONT_ID, afterContext.c_str(), width);
+    renderer.drawText(UI_10_FONT_ID, safe.x + 12, top + std::min(rows, lines - previewPage * rows) * lineStep + 4,
+                      after.c_str());
+  }
+  char page[24];
+  snprintf(page, sizeof(page), "%d/%d", previewPage + 1, previewPages);
+  renderer.drawText(SMALL_FONT_ID, safe.x + 12, buttonRect(0).y - 30,
+                    failed ? tr(STR_HIGHLIGHT_EDIT_UNAVAILABLE) : page);
+  const char* labels[] = {tr(STR_SAVE), tr(STR_OPEN), tr(STR_DELETE)};
+  for (int i = 0; i < 7; ++i) {
+    const Rect rect = buttonRect(i);
+    renderer.drawRect(rect.x, rect.y, rect.width, rect.height, true);
+    if (i < 4) {
+      drawBoundaryIcon(renderer, rect, i);
+      continue;
+    }
+    const std::string label = renderer.truncatedText(UI_10_FONT_ID, labels[i - 4], rect.width - 8);
+    renderer.drawText(UI_10_FONT_ID, rect.x + (rect.width - renderer.getTextWidth(UI_10_FONT_ID, label.c_str())) / 2,
+                      rect.y + (rect.height - renderer.getLineHeight(UI_10_FONT_ID)) / 2, label.c_str());
+    if (i == 4 && !changed) {
+      // Dim the label and frame without an extra framebuffer or gray refresh.
+      for (int y = rect.y; y < rect.y + rect.height; ++y)
+        for (int x = rect.x + ((y - rect.y) & 1); x < rect.x + rect.width; x += 2) renderer.drawPixel(x, y, false);
+    }
+  }
+  renderer.displayBuffer();
+}
