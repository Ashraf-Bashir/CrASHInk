+bool ClippingStore::removeClippings(const std::vector<bool>& remove) {
+  if (loadFailed_) return false;
+  ++contentRevision_;
+  if (remove.size() != clippings.size()) return false;
+  std::vector<Clipping> kept;
+  kept.reserve(clippings.size());
+  for (size_t i = 0; i < clippings.size(); ++i) {
+    if (!remove[i]) kept.push_back(clippings[i]);
+  }
+  if (kept.size() == clippings.size()) return true;
+  kept.swap(clippings);
+  dirty = true;
+  if (!saveToFile()) {
+    kept.swap(clippings);
+    dirty = true;
+    return false;
+  }
+  return true;
+}
