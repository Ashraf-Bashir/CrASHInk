diff --git a/src/activities/reader/HighlightWordSlices.h b/src/activities/reader/HighlightWordSlices.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/HighlightWordSlices.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+// Split a layout word at the saved selection's exact chapter boundaries.
+// At most two extra pieces per page, allocated only during editor setup.
+// Each UTF-8 glyph stays intact, including strict-match ligature expansion.
+template <typename Length, typename Emit>
+void forEachHighlightWordSlice(std::string_view text, uint32_t wordStart, uint32_t selectionStart,
+                               uint32_t selectionEnd, Length&& strictLength, Emit&& emit) {
+  size_t firstByte = 0;
+  uint32_t firstPosition = wordStart, position = wordStart;
+  for (size_t byte = 0; byte < text.size();) {
+    if (position > firstPosition &&
+        (position == selectionStart || (selectionEnd != UINT32_MAX && position == selectionEnd + 1))) {
+      emit(firstByte, byte, firstPosition, position - 1);
+      firstByte = byte;
+      firstPosition = position;
+    }
+    size_t next = byte + 1;
+    while (next < text.size() && (static_cast<unsigned char>(text[next]) & 0xC0) == 0x80) ++next;
+    position += strictLength(text.substr(byte, next - byte));
+    byte = next;
+  }
+  if (position > firstPosition) emit(firstByte, text.size(), firstPosition, position - 1);
+}
