+ int screenY=0;
+ const Navigator* getWordAt(int i) const {return i>=0 && i<2?this:nullptr;}
+};
+struct DictionaryLookupController {
+ unsigned lookups=0;std::string text;
+ static size_t phraseWordCount(const std::string& text) {return text.empty()?0:text.find(' ')==std::string::npos?1:2;}
+ void lookupOrPopup(const std::string& value,size_t) {++lookups;text=value;}
+ bool isLookingUp() const {return lookups>0;}
+};
+struct Selection {
+ bool touchDragLookup_=true,touchDragHasMoved_=false;
+ TouchDragInput touchDragInput_;
+ unsigned long touchPageEdgeSince_=0;bool touchEndpointHit_=false;
+ bool touchPageAwaitMotion_=false;int touchPageArrivalX_=0,touchPageArrivalY_=0;
+ int touchDragStartX_=0,touchDragStartY_=0;
+ Input mappedInput;Renderer renderer;Navigator navigator;DictionaryLookupController controller;
+ unsigned clips=0,captures=0,pageLoads=0;bool pageOk=false;
+ void requestUpdate() {}
+ bool continueTouchSelectionOnNextPage() {++pageLoads;if(pageOk){pageOk=false;navigator.current=0;return true;}return false;}
+ std::string finishTouchLookupPhrase() {return navigator.current?"one two":"one";}
+ void finishSelectionAsClipping() {++clips;}
+ void captureClippingRequest() {++captures;}
+ void loop();
+};
+#include "TouchRelease.inc"
+int main() {
+ Selection busy;
+ RenderLock::busy=true;
+ busy.mappedInput.x=50;busy.loop();
+ busy.mappedInput.x=0;busy.loop();
+ busy.mappedInput.x=50;busy.loop();
+ assert(busy.navigator.selectCalls==0);
+ busy.mappedInput.held=false;busy.loop();
+ assert(busy.controller.lookups==0 && busy.clips==0 && busy.touchDragInput_.released);
+ RenderLock::busy=false;busy.loop();
+ assert(busy.clips==1 && busy.controller.lookups==0 && busy.navigator.selectCalls==1);
+ Selection slow;
+ // Holding for arbitrarily many input frames never starts dictionary lookup.
+ for(int i=0;i<10000;++i) slow.loop();
+ assert(slow.controller.lookups==0 && slow.clips==0 && slow.touchDragLookup_);
+ slow.mappedInput.x=50;slow.loop();
+ for(int i=0;i<10000;++i) slow.loop();
+ assert(slow.controller.lookups==0 && slow.clips==0 && slow.pageLoads==0);
+ slow.mappedInput.held=false;slow.loop();
+ assert(slow.clips==1 && slow.controller.lookups==0 && !slow.touchDragLookup_);
+ Selection crossing;crossing.pageOk=true;crossing.mappedInput.x=100;crossing.mappedInput.y=300;
+ for(int i=0;i<500 && !crossing.touchPageAwaitMotion_;++i) crossing.loop();
+ assert(crossing.touchPageAwaitMotion_ && crossing.navigator.current==0);
+ const auto updates=crossing.navigator.selectCalls;
+ for(int i=0;i<100;++i) crossing.loop();
+ assert(crossing.navigator.current==0 && crossing.navigator.selectCalls==updates);
+ crossing.mappedInput.x=0;crossing.mappedInput.y=0;crossing.loop();
+ assert(!crossing.touchPageAwaitMotion_ && crossing.navigator.current==0);
+ Selection skippedLast;skippedLast.pageOk=true;skippedLast.mappedInput.x=0;skippedLast.mappedInput.y=300;
+ for(int i=0;i<500 && !skippedLast.touchPageAwaitMotion_;++i) skippedLast.loop();
+ assert(skippedLast.touchPageAwaitMotion_ && skippedLast.pageLoads==1);
+ Selection edgeBusy;edgeBusy.pageOk=true;edgeBusy.mappedInput.y=300;
+ RenderLock::busy=true;edgeBusy.loop();
+ assert(edgeBusy.touchPageEdgeSince_!=0);
+ for(int i=0;i<250;++i) millis();
+ RenderLock::busy=false;edgeBusy.loop();
+ assert(edgeBusy.touchPageAwaitMotion_ && edgeBusy.pageLoads==1);
+ Selection one;
+ for(int i=0;i<10000;++i) one.loop();
+ one.mappedInput.held=false;one.loop();
+ assert(one.clips==0 && one.controller.lookups==1 && one.controller.text=="one" && one.captures==1);
+ Selection reversed;
+ reversed.mappedInput.x=50;reversed.loop();
+ reversed.mappedInput.x=0;reversed.loop();
+ assert(reversed.controller.lookups==0);
+ reversed.mappedInput.held=false;reversed.loop();
+ assert(reversed.clips==0 && reversed.controller.lookups==1);
+ std::cout<<"Production touch flow: no lookup while held; release selects single-word lookup or multi-word highlight\n";
+}
