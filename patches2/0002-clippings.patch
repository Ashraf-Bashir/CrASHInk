+ void fillRect(int x,int y,int w,int h,bool black) const {for(int j=0;j<h;++j)for(int i=0;i<w;++i)drawPixel(x+i,y+j,black);}
+ void invertRect(int x,int y,int w,int h) const {for(int j=std::max(0,y);j<std::min(320,y+h);++j)for(int i=std::max(0,x);i<std::min(240,x+w);++i)pixels[j*240+i]^=1;}
+ void drawLine(int x,int y,int a,int b,int width,bool black) const {
+  const int steps=std::max(std::abs(a-x),std::abs(b-y));
+  for(int i=0;i<=steps;++i)fillRect(x+(a-x)*i/std::max(1,steps),y+(b-y)*i/std::max(1,steps),width,width,black);
+ }
+ void fillRectDither(int x,int y,int w,int h,Color) const {for(int j=0;j<h;++j)for(int i=0;i<w;++i)drawPixel(x+i,y+j,(i+j)%2);}
+ void fillRoundedRect(int x,int y,int w,int h,int,Color color) const {fillRect(x,y,w,h,color==Color::Black);}
+ void drawRoundedRect(int x,int y,int w,int h,int,int,bool black) const {drawLine(x,y,x+w-1,y,1,black);drawLine(x,y+h-1,x+w-1,y+h-1,1,black);drawLine(x,y,x,y+h-1,1,black);drawLine(x+w-1,y,x+w-1,y+h-1,1,black);}
+ template<class... T> void drawText(T...) const {}
+ void displayBuffer(int) {}
+ size_t readFramebufferRegion(int x,int y,int w,int h,uint8_t* out,size_t capacity) const {
+  const size_t stride=(w+7)/8,size=stride*h;if(size>capacity||x<0||y<0||x+w>240||y+h>320)return 0;
+  std::fill(out,out+size,0);for(int j=0;j<h;++j)for(int i=0;i<w;++i)if(pixels[(y+j)*240+x+i])out[j*stride+i/8]|=1<<(i%8);return size;
+ }
+ void writeFramebufferRegion(int x,int y,int w,int h,const uint8_t* data) {const size_t stride=(w+7)/8;for(int j=0;j<h;++j)for(int i=0;i<w;++i)drawPixel(x+i,y+j,(data[j*stride+i/8]>>(i%8))&1);}
+};
+struct Page {
+ unsigned renders=0;unsigned pattern=17;
+ void render(GfxRenderer& renderer,int,int,int,bool) {++renders;for(size_t i=0;i<renderer.pixels.size();++i)renderer.pixels[i]=(i%pattern==0);}
+};
+class OnPageHighlightActivity {
+ public:
+ struct Word {Rect rect;uint32_t start,end;bool rtl=false;uint16_t row=0;};
+ GfxRenderer renderer;std::unique_ptr<Page> page=std::make_unique<Page>();
+ Word words[4]={{{20,80,40,20},0,4},{{80,80,40,20},5,9},{{20,120,40,20},10,14},{{80,120,40,20},15,19}};
+ size_t wordCount=4;int left=0,top=0;
+ bool ready=true,failed=false,dragFrameReady=false,closeAfterAdjustment=false;
+ int firstAnchorY=0,lastAnchorY=0;
+ Rect firstHandle{},lastHandle{};HighlightToolbar::Layout toolbar{};
+ std::atomic<bool> dragging{true};
+ OnPageHighlightRange range{0,4},paintedRange{};
+ struct HandleSnapshot {
+  std::array<uint8_t,256> bytes{};Rect rect{};bool valid=true;
+  void capture(GfxRenderer&,const Rect&,int);void restore(GfxRenderer&) const;
+ } firstSnapshot,lastSnapshot;
+ void updateDrag() {}
+ void render(RenderLock&&);
+};
+#include "OnPageRender.inc"
+int main() {
+ const auto rtlGap=SelectionGap::between({80,20,40,20},{20,20,40,20});
+ assert(rtlGap.x==60 && rtlGap.width==20);
+ assert(SelectionGap::between({20,20,40,20},{20,50,40,20}).width==0);
+ OnPageHighlightActivity actual;actual.render(RenderLock{});
+ assert(actual.page->renders==2);
+ for(auto range:{OnPageHighlightRange{0,19},{0,9},{5,14},{10,19},{15,19},{0,4}}) {
+  actual.range=range;actual.render(RenderLock{});
+  OnPageHighlightActivity reference;reference.range=range;reference.render(RenderLock{});
+  assert(actual.renderer.pixels==reference.renderer.pixels);
+  if(range.start==0 && range.end==19) {
+    const size_t gap=90*240+70;
+    assert(actual.renderer.pixels[gap] != (gap%17==0));
+  }
+  assert(actual.page->renders==2); // no page/glyph render during subsequent moves
+ }
+ actual.dragging=false;actual.render(RenderLock{});
+ assert(actual.page->renders==4 && actual.toolbar.count==2);
+ assert(actual.toolbar.area.x>=6 && actual.toolbar.area.y>=6);
+ assert(actual.toolbar.area.x+actual.toolbar.area.width<=234);
+ assert(actual.toolbar.area.y+actual.toolbar.area.height<=314);
+ OnPageHighlightActivity light,dark;
+ light.dragging=false;dark.dragging=false;dark.renderer.dark=true;
+ light.render(RenderLock{});dark.render(RenderLock{});
+ const auto card=light.toolbar.area;
+ for(int y=card.y;y<card.y+card.height;++y)
+   for(int x=card.x;x<card.x+card.width;++x)
+     assert(light.renderer.pixels[y*240+x] == (dark.renderer.pixels[y*240+x]^1));
+ // A joined layout token is split at the saved end, before the dash.
+ OnPageHighlightActivity joined;
+ joined.wordCount=0;joined.range={0,6};
+ forEachHighlightWordSlice("selling—some",0,0,6,
+   [](std::string_view){return 1U;},
+   [&](size_t first,size_t end,uint32_t start,uint32_t last) {
+     auto& w=joined.words[joined.wordCount++];
+     w={Rect{20+int(first)*4,80,int(end-first)*4,20},start,last,false,0};
+   });
+ assert(joined.wordCount==2 && joined.words[0].end==6 && joined.words[1].start==7);
+ joined.render(RenderLock{});
+ assert(joined.lastHandle.x+10==48); // end handle is immediately after selling
+ for(int y=84;y<96;++y)for(int x=49;x<74;++x) {
+   const size_t pixel=y*240+x;
+   assert(joined.renderer.pixels[pixel] == (pixel%17==0)); // dash/some untouched
+ }
+ size_t pieces=0;
+ forEachHighlightWordSlice("before—selling—after",100,107,113,
+   [](std::string_view){return 1U;},
+   [&](size_t,size_t,uint32_t start,uint32_t end) {
+     if(pieces==1)assert(start==107 && end==113);
+     ++pieces;
+   });
+ assert(pieces==3);
+ // Paging resets differential paint and must render the actual new text.
+ OnPageHighlightActivity swapped;swapped.render(RenderLock{});
+ swapped.page=std::make_unique<Page>();swapped.page->pattern=19;
+ swapped.dragFrameReady=false;swapped.render(RenderLock{});
+ assert(swapped.page->renders==2);
+ for(int y=180;y<200;++y)for(int x=0;x<240;++x) {
+   const size_t pixel=y*240+x;assert(swapped.renderer.pixels[pixel]==(pixel%19==0));
+ }
+ const auto renderCount=actual.page->renders;
+ actual.closeAfterAdjustment=true;actual.render(RenderLock{});
+ assert(actual.page->renders==renderCount); // pending repaint cannot flash a popup
+ std::cout<<"Saved highlight drag: incremental pixels match clean redraws, no page renders during movement, floating toolbar on release\n";
+}
