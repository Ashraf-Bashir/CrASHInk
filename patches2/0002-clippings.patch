+class OnPageHighlightActivity final : public Activity {
+ public:
+  using PageLoader = std::unique_ptr<Page> (*)(void*, int, float&);
+  OnPageHighlightActivity(GfxRenderer& renderer, MappedInputManager& input, std::shared_ptr<Epub> book,
+                          std::unique_ptr<Page> page, size_t clippingIndex, int left, int top, float hint,
+                          void* readerContext = nullptr, PageLoader pageLoader = nullptr);
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  bool allowGlobalHomeSwipeGesture() const override { return false; }
+  bool allowFrontlightPanelGesture() const override { return false; }
+
+ private:
+  struct Word {
+    Rect rect{};
+    uint32_t start = 0, end = 0;
+    bool rtl = false;
+    uint16_t row = 0;
+  };
+  std::shared_ptr<Epub> book;
+  std::unique_ptr<Page> page;
+  std::unique_ptr<Word[]> words;
+  size_t wordCount = 0, index;
+  uint16_t buildRow = 0;
+  int left, top;
+  float hint;
+  void* readerContext = nullptr;
+  PageLoader pageLoader = nullptr;
+  int pageOffset = 0;
+  HighlightDragPaging dragPaging;
+  std::atomic<bool> waitForPageMotion{false};
+  std::atomic<int> firstTextY{0}, lastTextBottom{0};
+  bool turnPage(int direction);
+  uint16_t spine = 0;
+  XPathTextLocation original{};
+  OnPageHighlightRange range{}, saved{};
+  Rect firstHandle{}, lastHandle{};
+  HighlightToolbar::Layout toolbar{};
+  // Two tiny handle regions (512 bytes total), never a full-page snapshot.
+  struct HandleSnapshot {
+    std::array<uint8_t, 256> bytes{};
+    Rect rect{};
+    bool valid = true;
+    void capture(GfxRenderer& renderer, const Rect& handle, int stemY);
+    void restore(GfxRenderer& renderer) const;
+  } firstSnapshot, lastSnapshot;
+  bool dragFrameReady = false;
+  bool closeAfterAdjustment = false;
+  OnPageHighlightRange paintedRange{};
+  bool ready = false, failed = false;
+  int activeEdge = -1;
+  int firstAnchorY = 0, lastAnchorY = 0, dragOffsetY = 0, dragOffsetX = 0;
+  std::atomic<bool> dragging{false};
+  std::atomic<int> dragX{0}, dragY{0};
+  bool releasePending = false, ignoreOpeningRelease = true;
