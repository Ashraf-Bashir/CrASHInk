new file mode 100644
--- /dev/null
+++ b/src/components/DisclosureIcon.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <FreeInkUICore.h>
+
+#include <array>
+#include <cstdint>
+
+// Mask bitmaps reserve real layout space for indentation. Text-leading spaces
+// are deliberately unsuitable: FreeInkUI trims them when wrapping labels.
+namespace disclosureIcon {
+constexpr unsigned BASE = 16, STEP = 12, DEPTH = 4, HEIGHT = 16, BYTES = 128;
+using Bits = std::array<uint8_t, BYTES>;
+constexpr Bits make(unsigned depth, bool expanded, bool leaf) {
+  Bits bits{};
+  for (auto& byte : bits) byte = 255;
+  const unsigned stride = (BASE + STEP * depth + 7) / 8;
+  if (!leaf) {
+    for (int y = 0; y < 11; ++y) {
+      for (int x = 0; x < 9; ++x) {
+        const int distance = y > 5 ? y - 5 : 5 - y;
+        const bool ink = expanded ? (y < 9 && (x > 4 ? x - 4 : 4 - x) <= (8 - y) / 2) : x <= (5 - distance) * 8 / 5;
+        if (ink) {
+          const unsigned px = depth * STEP + 3 + x, py = 2 + y;
+          bits[py * stride + px / 8] &= static_cast<uint8_t>(~(1U << (7 - px % 8)));
+        }
+      }
+    }
+  }
+  return bits;
+}
+constexpr auto arrows(bool expanded) {
+  std::array<Bits, DEPTH + 1> result{};
+  for (unsigned depth = 0; depth <= DEPTH; ++depth) result[depth] = make(depth, expanded, false);
+  return result;
+}
+inline constexpr auto right = arrows(false);
+inline constexpr auto down = arrows(true);
+inline constexpr auto blank = make(0, false, true);
+inline freeink::ui::BitmapRef bitmap(unsigned depth, bool branch, bool expanded, unsigned rowHeight) {
+  const unsigned limit = rowHeight > BASE ? (rowHeight - BASE) / STEP : 0;
+  if (depth > DEPTH) depth = DEPTH;
+  if (depth > limit) depth = limit;
+  return {branch ? (expanded ? down[depth].data() : right[depth].data()) : blank.data(),
+          static_cast<uint16_t>(BASE + depth * STEP), HEIGHT, freeink::ui::BitmapFormat::Mask1};
+}
+}  // namespace disclosureIcon
