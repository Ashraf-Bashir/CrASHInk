diff --git a/src/activities/reader/OnPageHighlightModel.h b/src/activities/reader/OnPageHighlightModel.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/OnPageHighlightModel.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+// Inclusive chapter positions. Off-page ends stay untouched when the visible
+// end moves; crossing the other end clamps to one word rather than reversing.
+struct OnPageHighlightRange {
+  uint32_t start = 0, end = 0;
+  bool move(bool first, uint32_t wordStart, uint32_t wordEnd) {
+    if (wordStart > wordEnd || (first ? wordStart > end : wordEnd < start)) return false;
+    const auto oldStart = start, oldEnd = end;
+    if (first)
+      start = std::min(wordStart, end);
+    else
+      end = std::max(wordEnd, start);
+    return start != oldStart || end != oldEnd;
+  }
+};
diff --git a/src/activities/reader/SelectionGap.h b/src/activities/reader/SelectionGap.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/SelectionGap.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <algorithm>
+namespace SelectionGap {
+struct Rect {
+  int x = 0, y = 0, width = 0, height = 0;
+};
+// Only call for adjacent words on the same text line. The intersection in Y
+// avoids painting line spacing; outer selection margins are never included.
+inline Rect between(const Rect& a, const Rect& b) {
+  if (a.width <= 0 || b.width <= 0 || a.height <= 0 || b.height <= 0) return {};
+  const int top = std::max(a.y, b.y), bottom = std::min(a.y + a.height, b.y + b.height);
+  if (bottom <= top) return {};
+  if (a.x + a.width <= b.x) return {a.x + a.width, top, b.x - a.x - a.width, bottom - top};
+  if (b.x + b.width <= a.x) return {b.x + b.width, top, a.x - b.x - b.width, bottom - top};
+  return {};
+}
+}  // namespace SelectionGap
diff --git a/src/activities/reader/TouchDragInput.h b/src/activities/reader/TouchDragInput.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/TouchDragInput.h
@@ -0,0 +1,17 @@
+#pragma once
+// Main-task-only coalescing: retain the latest contact point and a release
+// while the render task owns the page. No input FIFO or heap allocation.
+struct TouchDragInput {
+  int x = 0, y = 0;
+  bool pointPending = false, released = false;
+  void record(bool held, int px, int py) {
+    if (released) return;
+    if (held) {
+      x = px;
+      y = py;
+      pointPending = true;
+    } else
+      released = true;
+  }
+  void reset() { pointPending = released = false; }
+};
