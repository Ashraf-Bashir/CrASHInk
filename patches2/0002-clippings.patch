+ 'bool ClippingStore::updateClippingText(', 'ClippingStore::AddResult ClippingStore::addClipping(',
+ 'bool ClippingStore::removeClippingAt(', 'bool ClippingStore::removeClippings(', 'void ClippingStore::clearAll()']
