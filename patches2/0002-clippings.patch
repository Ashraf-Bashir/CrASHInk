+      if (!value.length || std::memchr(text + start, 0, end - start)) {
+        firstLength = 255;
+        return;
+      }
+      if (!firstLength) {
+        firstHash = value.hash;
+        firstLength = value.length;
+        shortHashes[0] = value.shortHashes[0];
+        shortHashes[1] = value.shortHashes[1];
+      }
+      continuations |= hashBit(value.hash);
