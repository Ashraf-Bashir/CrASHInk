+#include <cassert>
+#include <iostream>
+
+#include "clippings/HighlightNeighbourWord.h"
+#include "clippings/HighlightWordEdit.h"
+#include "clippings/HighlightDraftState.h"
+
+int main() {
+  using HighlightWordEdit::Action;
+  HighlightDraftState baseline;
+  const std::string original = "alpha bravo";
+  baseline.reset(original);
+  assert(!baseline.changed(original));
+  for (const auto extend : {Action::ExtendStart, Action::ExtendEnd}) {
+    std::string extended, restored;
+    assert(HighlightWordEdit::adjust(original, extend, "caf\xc3\xa9.", 1024, extended));
+    assert(baseline.changed(extended));
+    assert(HighlightWordEdit::adjust(extended, extend == Action::ExtendStart ? Action::TrimStart : Action::TrimEnd,
+                                   "", 1024, restored));
+    assert(restored == original && !baseline.changed(restored));
+  }
+  for (const auto trim : {Action::TrimStart, Action::TrimEnd}) {
+    std::string reduced, restored;
+    assert(HighlightWordEdit::adjust(original, trim, "", 1024, reduced));
+    assert(baseline.changed(reduced));
+    assert(HighlightWordEdit::adjust(reduced, trim == Action::TrimStart ? Action::ExtendStart : Action::ExtendEnd,
+                                   trim == Action::TrimStart ? "alpha" : "bravo", 1024, restored));
+    assert(restored == original && !baseline.changed(restored));
+  }
+  std::string huge(60 * 1024, 'x');
+  baseline.reset(huge);
+  assert(!baseline.changed(huge));
+  huge.back() = 'y'; assert(baseline.changed(huge));
+  huge.back() = 'x'; assert(!baseline.changed(huge));
+  const auto book = std::make_shared<Epub>(std::vector<std::string>{
+      "<html><body><p>Before, alpha <em>bravo</em> caf&#233;. After!</p><p>Next paragraph.</p></body></html>"});
+  XPathTextLocation location;
+  assert(ChapterXPathResolver::locateText(book, 0, "alpha bravo", -1, location));
+  std::string word, result;
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, true, word));
+  assert(word == "Before,");
+  assert(HighlightWordEdit::adjust("alpha bravo", Action::ExtendStart, word, 1024, result));
+  assert(result == "Before, alpha bravo");
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  assert(word == "caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust("alpha bravo", Action::ExtendEnd, word, 1024, result));
+  assert(result == "alpha bravo caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust(result, Action::TrimStart, "", 1024, word));
+  assert(word == "bravo caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust(word, Action::TrimEnd, "", 1024, result));
+  assert(result == "bravo");
+  assert(!HighlightWordEdit::adjust("bravo", Action::TrimStart, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::TrimEnd, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::ExtendEnd, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::ExtendEnd, "six", 8, result));
+  assert(ChapterXPathResolver::locateText(book, 0, "Before,", -1, location));
+  assert(!HighlightWordEdit::neighbourWord(book, 0, location, true, word));
+  assert(ChapterXPathResolver::locateText(book, 0, "paragraph.", -1, location));
+  assert(!HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  // A block/page boundary supplies a word separator, not a glued token.
+  assert(ChapterXPathResolver::locateText(book, 0, "After!", -1, location));
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  assert(word == "Next");
+  const auto rtl = std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>قبل كلمة بعد</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(rtl, 0, "كلمة", -1, location));
+  assert(HighlightWordEdit::neighbourWord(rtl, 0, location, true, word) && word == "قبل");
+  assert(HighlightWordEdit::neighbourWord(rtl, 0, location, false, word) && word == "بعد");
+  const auto softHyphen =
+      std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>one hy&#173;phen two</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(softHyphen, 0, "two", -1, location));
+  assert(HighlightWordEdit::neighbourWord(softHyphen, 0, location, true, word) && word == "hyphen");
+  // A clipped context edge must not return the last part of a long word.
+  const std::string longWord(600, 'x');
+  const auto longBook = std::make_shared<Epub>(
+      std::vector<std::string>{"<html><body><p>prefix " + longWord + " target</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(longBook, 0, "target", -1, location));
+  assert(HighlightWordEdit::neighbourWord(longBook, 0, location, true, word));
+  assert(word == longWord);
+  std::cout << "Highlight word editing checks passed\n";
+}
