+      // internal UTF-8 boundaries so the rejection filter cannot hide a valid
+      // continuation before the neighboring-page verifier gets to inspect it.
+      size_t suffix = start;
+      while (suffix < end) {
+        ClippingTextMatcher::nextCodepoint(text, end, suffix);
+        if (suffix >= end) break;
+        size_t peek = suffix;
+        if (ClippingTextMatcher::isEdgePunctuation(ClippingTextMatcher::nextCodepoint(text, end, peek))) continue;
+        const auto tail = prefix(text + suffix, end - suffix);
+        if (tail.length == 3) continuations |= hashBit(tail.hash);
+      }
