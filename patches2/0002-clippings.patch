+    end = source.index('\n}', start) + 3
+    return source[start:end]
+constants = source[source.index('constexpr uint8_t LEGACY_VERSION'):source.index('struct ClippingFileHeader')]
+methods = [
+ 'bool ClippingStore::loadForBook(', 'bool ClippingStore::readFromFile() {',
