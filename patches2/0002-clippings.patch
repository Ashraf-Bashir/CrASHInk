+  bool forEachTextLine(bool (*visit)(const PageTextLine&, void*), void* context) const {
+    return visit({&block}, context);
+  }
+};
+struct Section {
+  int currentPage = 0, pageCount = 4;
+  std::vector<Page> pages = {{{{"unused"}}}, {{{"unrelated"}}}, {{{"alpha"}}}, {{{"beta"}}}};
+  std::vector<int> reads;
+  bool failPage = false;
+  std::unique_ptr<Page> loadPage(int index) {
+    reads.push_back(index);
+    if (failPage) return nullptr;
+    return std::make_unique<Page>(pages.at(index));
+  }
+};
