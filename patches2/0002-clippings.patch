@@ -0,0 +1,59 @@
+#include <cassert>
+#include <iostream>
+
+#include "activities/reader/ClippingListPaging.h"
+#include "activities/reader/HighlightChapterGroups.h"
+#include "components/DisclosureIcon.h"
+int main() {
+  HighlightChapterGroups groups;
+  groups.build({{4, 2}, {1, 0}, {4, 3}, {2, 1}});
+  assert(groups.groups.size() == 3 && groups.rows.size() == 3);
+  groups.toggle(0);
+  assert(groups.rows[1] == 0);
+  groups.toggle(2);
+  assert(groups.rows[3] == 1);
+  groups.build({{1, 0}, {4, 1}});
+  assert(groups.groups[0].open && groups.rows[1] == 0);
+  assert(groups.groups.size() == 2);
+  groups.build({});
+  assert(groups.rows.empty());
+  for (int total = 0; total <= 300; ++total) {
+    for (int rows = 1; rows <= 20; ++rows) {
+      ClippingListPaging pager{total, rows, 0};
+      assert(pager.page() == 1);
+      int moves = 0;
+      while (pager.destination(true) != pager.top) {
+        const int before = pager.top;
+        pager.top = pager.destination(true);
+        assert(pager.top > before && pager.top - before <= rows);
+        assert(pager.page() >= 1 && pager.page() <= pager.pages());
+        assert(++moves < 400);
+      }
+      assert(pager.page() == pager.pages());
+      while (pager.top > 0) {
+        const int before = pager.top;
+        pager.top = pager.destination(false);
+        assert(pager.top < before && before - pager.top <= rows);
+      }
+      assert(pager.page() == 1);
+    }
+  }
+  for (unsigned depth = 0; depth <= 8; ++depth) {
+    for (unsigned rowHeight : {32U, 48U, 64U, 80U}) {
+      const auto collapsed = disclosureIcon::bitmap(depth, true, false, rowHeight);
+      const auto expanded = disclosureIcon::bitmap(depth, true, true, rowHeight);
+      const auto leaf = disclosureIcon::bitmap(depth, false, false, rowHeight);
+      assert(collapsed.width <= rowHeight && collapsed.width == expanded.width && leaf.width == collapsed.width);
+      unsigned rightPixels = 0, downPixels = 0, leafPixels = 0;
+      freeink::ui::forEachBitmapPixel({0, 0, static_cast<int16_t>(collapsed.width), 16}, collapsed,
+                                      freeink::ui::BitmapMode::Contain, [&](int16_t, int16_t) { ++rightPixels; });
+      freeink::ui::forEachBitmapPixel({0, 0, static_cast<int16_t>(expanded.width), 16}, expanded,
+                                      freeink::ui::BitmapMode::Contain, [&](int16_t, int16_t) { ++downPixels; });
+      freeink::ui::forEachBitmapPixel({0, 0, static_cast<int16_t>(leaf.width), 16}, leaf,
+                                      freeink::ui::BitmapMode::Contain, [&](int16_t, int16_t) { ++leafPixels; });
+      assert(rightPixels > 20 && downPixels > 20 && leafPixels == 0);
+    }
+  }
+  assert(disclosureIcon::bitmap(1, false, false, 64).width > disclosureIcon::bitmap(0, true, false, 64).width);
+  std::cout << "Highlight chapter group checks passed\n";
+}
