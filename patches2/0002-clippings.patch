@@ -0,0 +1,25 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// Keep only a baseline fingerprint: a long quote must not need another full
+// 60-KiB string just to detect reversals back to the original selection.
+class HighlightDraftState {
+  uint64_t originalHash = 0;
+  size_t originalBytes = 0;
+  static uint64_t fingerprint(const std::string& text) {
+    uint64_t value = 14695981039346656037ULL;
+    for (const unsigned char byte : text) value = (value ^ byte) * 1099511628211ULL;
+    return value;
+  }
+
+ public:
+  void reset(const std::string& text) {
+    originalBytes = text.size();
+    originalHash = fingerprint(text);
+  }
+  bool changed(const std::string& text) const {
+    return text.size() != originalBytes || fingerprint(text) != originalHash;
+  }
+};
