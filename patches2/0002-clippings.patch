@@ -0,0 +1,114 @@
+#include <cassert>
+#include <iostream>
+
+#include "GfxRenderer.h"
+#include "util/WordSelectNavigator.h"
+
+int main() {
+  WordSelectNavigator nav;
+  WordSelectNavigator::HighlightSnapshotStorage storage;
+  nav.setHighlightSnapshotStorage(&storage);
+  std::vector<WordSelectNavigator::WordInfo> words(4);
+  for (int i = 0; i < 4; ++i) {
+    words[i].screenX = 20 + i * 60;
+    words[i].screenY = 20;
+    words[i].width = 40;
+    words[i].row = 0;
+  }
+  nav.load(std::move(words), {{20, 0, 4}}, "", false);
+  nav.setTouchDragCursorVisible(true);
+  nav.selectWordAtPoint(25, 25, 20);
+  assert(nav.beginTouchMultiSelect());
+  bool hit = true;
+  nav.selectWordAtPoint(79,25,20,&hit); // whitespace just before next word
+  assert(!hit && nav.getCurrentFlatIndex()==0);
+  nav.selectWordAtPoint(85,19,20,&hit); // above its actual line box
+  assert(!hit && nav.getCurrentFlatIndex()==0);
+  nav.selectWordAtPoint(85,25,20,&hit);
+  assert(hit && nav.getCurrentFlatIndex()==1);
+  nav.selectWordAtPoint(25,25,20);
+  GfxRenderer renderer;
+  for (size_t i = 0; i < renderer.pixels.size(); ++i) renderer.pixels[i] = (i % 13) == 0;
+  const auto base = renderer.pixels;
+  assert(nav.renderHighlightDifferential(renderer, 20, -1, 0, true));
+  // Grow, shrink, and reverse across the anchor. Every result must match a
+  // clean page plus the ordinary multi-word highlight, without stale pixels.
+  int prev = 0;
+  for (int next : {2, 1, 3, 0, 2}) {
+    nav.selectWordAtPoint(25 + next * 60, 25, 20);
+    assert(nav.renderHighlightDifferential(renderer, 20, prev, next, true));
+    GfxRenderer reference;
+    reference.pixels = base;
+    nav.renderHighlight(reference, 20, true);
+    if (renderer.pixels != reference.pixels) {
+      for (size_t p = 0; p < renderer.pixels.size(); ++p)
+        if (renderer.pixels[p] != reference.pixels[p]) {
+          std::cerr << "next=" << next << " pixel=" << p % 800 << "," << p / 800
+                    << " actual=" << int(renderer.pixels[p]) << " expected=" << int(reference.pixels[p]) << "\n";
+          break;
+        }
+      assert(false);
+    }
+    prev = next;
+  }
+  renderer.pixels = base;
+  nav.selectWordAtPoint(145, 25, 20);
+  assert(nav.beginTouchMultiSelect());
+  assert(nav.renderHighlightDifferential(renderer, 20, -1, 2, true));
+  prev = 2;
+  for (int next : {0, 1, 3, 2}) {
+    nav.selectWordAtPoint(25 + next * 60, 25, 20);
+    assert(nav.renderHighlightDifferential(renderer, 20, prev, next, true));
+    GfxRenderer reference;
+    reference.pixels = base;
+    nav.renderHighlight(reference, 20, true);
+    assert(renderer.pixels == reference.pixels);
+    prev = next;
+  }
+  assert(renderer.snapshots == 0);
+  // Large touch ranges never fall back when they exceed snapshot capacity.
+  nav.reset();
+  std::vector<WordSelectNavigator::WordInfo> large(2);
+  large[0].screenX = 20;
+  large[0].screenY = 20;
+  large[0].width = 40;
+  large[0].row = 0;
+  large[1].screenX = 720;
+  large[1].screenY = 420;
+  large[1].width = 40;
+  large[1].row = 1;
+  nav.load(std::move(large), {{20, 0, 1}, {420, 1, 1}}, "", false);
+  nav.selectWordAtPoint(25, 25, 20);
+  assert(nav.beginTouchMultiSelect());
+  nav.selectWordAtPoint(725, 425, 20);
+  nav.setTouchDragCursorVisible(true);
+  assert(nav.renderHighlightDifferential(renderer, 20, -1, 1, true));
+  assert(renderer.snapshots == 0);
+  nav.reset();
+  std::vector<WordSelectNavigator::WordInfo> split(3);
+  for (int i=0;i<3;++i) {split[i].screenX=20+i*60;split[i].screenY=20;split[i].width=40;split[i].row=0;}
+  split[0].continuationIndex=1;split[1].continuationOf=0;
+  nav.load(std::move(split),{{20,0,3}},"",false);
+  nav.setTouchDragCursorVisible(true);
+  nav.selectWordAtPoint(145,25,20);assert(nav.beginTouchMultiSelect());
+  renderer.pixels=base;prev=-1;
+  for(int next:{2,0,1,2}) {
+    nav.selectWordAtPoint(25+next*60,25,20);
+    assert(nav.renderHighlightDifferential(renderer,20,prev,next,true));
+    GfxRenderer reference;reference.pixels=base;nav.renderHighlight(reference,20,true);
+    assert(renderer.pixels==reference.pixels);prev=next;
+  }
+  assert(renderer.snapshots==0);
+  nav.reset();
+  std::vector<WordSelectNavigator::WordInfo> spaced(2);
+  for(int i=0;i<2;++i){spaced[i].screenX=20+i*60;spaced[i].screenY=20;spaced[i].width=40;spaced[i].row=0;}
+  nav.load(std::move(spaced),{{20,0,2}},"",false);nav.setTouchDragCursorVisible(true);
+  nav.selectWordAtPoint(25,25,20);assert(nav.beginTouchMultiSelect());
+  nav.selectWordAtPoint(85,25,20);renderer.pixels.assign(renderer.pixels.size(),0);
+  assert(nav.renderHighlightDifferential(renderer,20,-1,1,true));
+  assert(renderer.pixels[25*800+70]==1); // inter-word space is part of the block
+  assert(renderer.pixels[25*800+10]==0 && renderer.pixels[25*800+125]==0);
+  nav.selectWordAtPoint(25,25,20);assert(nav.renderHighlightDifferential(renderer,20,1,0,true));
+  assert(renderer.pixels[25*800+70]==0); // trimming removes the old gap too
+  std::cout << "Drag differential rendering checks passed\n";
+}
