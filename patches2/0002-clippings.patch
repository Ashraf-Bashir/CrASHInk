+  bool readClippingText(const Clipping& clip, std::string& text, FsFile&) {
+    ++reads;
+    if (failRead) return false;
+    text = texts.at(&clip - records.data());
+    clip.textFilter.build(text.data(), text.size());
+    return true;
+  }
+  bool cacheResolvedLayoutRange(size_t index, uint16_t page, uint16_t first, uint16_t last, uint32_t signature) {
+    return cacheClippingResolvedLayoutRange(records[index], page, first, last, signature);
+  }
+} CLIPPINGS;
+bool hasEmSpacePrefix(const char* s) { return std::strlen(s) >= 3 && std::memcmp(s, "\xE2\x80\x83", 3) == 0; }
+#include "ClippingFullMatcher.inc"
+uint8_t tableColumnForSelection(uint16_t selection) {
+  return selection == UINT16_MAX ? UINT8_MAX : selection % TableFragmentRow::MAX_SERIALIZED_CELLS;
+}
+class EpubReaderActivity {
+ public:
+  std::unique_ptr<Section> section = std::make_unique<Section>();
+  int currentSpineIndex = 0;
+  uint32_t activeSectionLayoutSignature = 17;
+  void collectClippingPageMatches(const Page&, ClippingPageMatchCache::Entry&, bool);
+};
+#include "ClippingCollector.inc"
+int main() {
+  {
+    EpubReaderActivity joined;
+    joined.section->pages[0].block.words = {"We", "were", "selling—some"};
+    Clipping stored;
+    stored.spineIndex = 0; stored.pageCount = 4;
+    stored.startPage = stored.endPage = 0;
+    stored.startWordIndex = 0; stored.endWordIndex = 2;
+    stored.layoutSignature = clippingWordLayoutSignature(17);
+    CLIPPINGS.records = {stored}; CLIPPINGS.texts = {"We were selling"};
+    ClippingPageMatchCache::Entry result; result.page = 0;
+    joined.collectClippingPageMatches(joined.section->pages[0], result, false);
+    assert(result.ready && result.count == 1 && result.matches[0].endByte == 7);
+    assert(result.matches[0].endWord == 2);
+    assert(CLIPPINGS.texts[0] == "We were selling");
+  }
+  {
+    EpubReaderActivity continuation;
+    continuation.section->pages[0].block.words = {"Did", "I", "make", "smart", "notes", "for", "myself?", "Once", "you", "have", "your", "main", "point", "and", "a", "few", "examples", "or", "subpoints", "in", "mind,", "write", "them", "down", "on", "a", "small", "note", "card", "using", "as", "few", "words", "as", "possible", "and", "no", "com-"};
+    auto& before = continuation.section->pages[0].block;
+    before.hyphens.assign(before.words.size(),false);before.hyphens.back()=true;
+    continuation.section->pages[1].block.words = {"plete", "sentences.", "Know", "that", "notes", "have", "only", "one", "purpose:", "to", "remind", "you", "of", "the", "points", "you", "need", "to", "make", "and", "the", "details", "you", "might", "otherwise", "forget,", "like", "statistics"};
+    continuation.section->pages[2].block.words = {"or", "names.", "Nothing", "else", "belongs", "in", "your", "notes.", "Afterward"};
+    const std::string quote="Did I make smart notes for myself? Once you have your main point and a few examples or subpoints in mind, write them down on a small note card using as few words as possible and no complete sentences. Know that notes have only one purpose: to remind you of the points you need to make and the details you might otherwise forget, like statistics or names. Nothing else belongs in your notes.";
+    Clipping clip;clip.spineIndex=0;clip.pageCount=1000;clip.wordCount=80;
+    CLIPPINGS.records={clip};CLIPPINGS.texts={quote};
+    CLIPPINGS.records[0].textFilter.build(quote.data(),quote.size());
+    for(int page=0;page<3;++page) {
+      ClippingPageMatchCache::Entry result;result.page=page;
+      continuation.collectClippingPageMatches(continuation.section->pages[page],result,false);
+      assert(result.ready && result.count==1 && result.matches[0].startWord==0);
+      assert(result.matches[0].endWord==(page==2?7:continuation.section->pages[page].block.words.size()-1));
+      assert(page==2 || result.matches[0].endByte==UINT16_MAX);
+    }
+    // A suffix alone is not enough: authored hyphens/unrelated previous words
+    // must not turn a coincidental page-start fragment into a highlight.
+    before.hyphens.back()=false;
+    ClippingPageMatchCache::Entry unrelated;unrelated.page=1;
+    continuation.collectClippingPageMatches(continuation.section->pages[1],unrelated,false);
+    assert(unrelated.ready && unrelated.count==0);
+    before.hyphens.back()=true;before.words.back()="other-";
+    ClippingPageMatchCache::Entry wrongPrefix;wrongPrefix.page=1;
+    continuation.collectClippingPageMatches(continuation.section->pages[1],wrongPrefix,false);
+    assert(wrongPrefix.ready && wrongPrefix.count==0);
+    assert(CLIPPINGS.texts[0]==quote && continuation.section->currentPage==0);
+  }
+  // A quote can consist of just the word crossing the boundary, including UTF-8.
+  for (const auto& parts : std::vector<std::array<std::string,3>>{
+         {"com-","plete","complete"}, {"COM-","PLETE","complete"}, {"caf-","éine","caféine"}}) {
+    EpubReaderActivity single;
+    single.section->pages[0].block.words={parts[0]};single.section->pages[0].block.hyphens={true};
+    single.section->pages[1].block.words={parts[1],"unselected"};
+    Clipping clip;clip.spineIndex=0;clip.pageCount=1000;clip.wordCount=1;
+    CLIPPINGS.records={clip};CLIPPINGS.texts={parts[2]};
+    CLIPPINGS.records[0].textFilter.build(parts[2].data(),parts[2].size());
+    for(int page=0;page<2;++page) {
+      ClippingPageMatchCache::Entry result;result.page=page;
+      single.collectClippingPageMatches(single.section->pages[page],result,false);
+      assert(result.ready&&result.count==1&&result.matches[0].startWord==0&&result.matches[0].endWord==0);
+      assert(page==1||result.matches[0].endByte==UINT16_MAX);
+    }
+  }
+  CLIPPINGS.reads = 0;
+  EpubReaderActivity reader;
+  Clipping clip;
+  clip.spineIndex = 0;
+  clip.pageCount = 1000;
+  clip.wordCount = 2;
+  // 500 imported clips; the matching one is intentionally last so every slice
+  // must resume its real production collector cursor correctly.
+  CLIPPINGS.records.assign(500, clip);
+  CLIPPINGS.texts.assign(500, "different wording");
+  CLIPPINGS.texts.back() = "alpha beta";
+  ClippingPageMatchCache cache;
+  ClippingPageMatchCache::Key key{reader.section.get(), 17, 1, 0, 4};
+  assert(cache.resetFor(key));
+  auto& entry = cache.claim(2);
+  size_t slices = 0;
+  while (!entry.ready) {
+    const auto before = entry.nextClipping;
+    reader.collectClippingPageMatches(reader.section->pages[2], entry, true);
+    assert(entry.nextClipping > before && entry.nextClipping - before <= 8);
+    assert(++slices <= 500);
+  }
+  assert(entry.count == 1 && entry.clippingIndices[0] == 499);
+  assert(entry.matches[0].startWord == 0 && entry.matches[0].endWord == 0);
+  assert(reader.section->currentPage == 0);  // prefetched page != visible page
+  assert(std::find(reader.section->reads.begin(), reader.section->reads.end(), 3) != reader.section->reads.end());
+  ClippingPageMatchCache::Entry synchronous;
+  synchronous.page = 2;
+  reader.collectClippingPageMatches(reader.section->pages[2], synchronous, false);
+  assert(synchronous.ready && synchronous.count == entry.count);
+  assert(synchronous.clippingIndices[0] == entry.clippingIndices[0]);
+  assert(synchronous.matches[0].startWord == entry.matches[0].startWord);
+  const auto textReads = CLIPPINGS.reads, pageReads = reader.section->reads.size();
+  for (int repaint = 0; repaint < 100; ++repaint) {
+    auto& hit = cache.claim(2);
+    if (!hit.ready) reader.collectClippingPageMatches(reader.section->pages[2], hit, false);
+    assert(hit.count == 1);
+  }
+  assert(CLIPPINGS.reads == textReads && reader.section->reads.size() == pageReads);
+  // Cache pages with no matches too; otherwise empty pages retain the delay.
+  auto& empty = cache.claim(1);
+  reader.collectClippingPageMatches(reader.section->pages[1], empty, false);
+  assert(empty.ready && empty.count == 0);
+  assert(cache.find(1)->ready);
+  // Every piece of layout/content identity must invalidate positive and negative results.
+  for (int field = 0; field < 5; ++field) {
+    auto changed = key;
+    if (field == 0) ++changed.layout;
+    if (field == 1) ++changed.revision;
+    if (field == 2) ++changed.spine;
+    if (field == 3) ++changed.pageCount;
+    if (field == 4) changed.section = nullptr;
+    assert(cache.resetFor(changed));
+    assert(cache.find(1) == nullptr && cache.find(2) == nullptr);
+    cache.resetFor(key);
+    cache.claim(1).ready = true;
+    cache.claim(2).ready = true;
+  }
+  // A failed SD read is never frozen into a cached "no highlight" result.
+  CLIPPINGS.failRead = true;
+  ClippingPageMatchCache::Entry failed;
+  failed.page = 2;
+  reader.collectClippingPageMatches(reader.section->pages[2], failed, false);
+  assert(failed.failed && !failed.ready);
+  CLIPPINGS.failRead = false;
+  reader.collectClippingPageMatches(reader.section->pages[2], failed, false);
+  assert(failed.ready && failed.count == 1);
+  reader.section->failPage = true;
+  ClippingPageMatchCache::Entry failedNeighbor;
+  failedNeighbor.page = 2;
+  reader.collectClippingPageMatches(reader.section->pages[2], failedNeighbor, false);
+  assert(failedNeighbor.failed && !failedNeighbor.ready);
+  reader.section->failPage = false;
+  reader.collectClippingPageMatches(reader.section->pages[2], failedNeighbor, false);
+  assert(failedNeighbor.ready && failedNeighbor.count == 1);
+  for (int i = 0; i < 30; ++i) cache.claim(i).ready = true;
+  assert(cache.find(29) && !cache.find(0));
+  std::cout << "500-clipping idle preparation: " << slices
+            << " bounded slices; 100 cached renders: 0 text reads, 0 neighbor loads; invalidation, negative cache, and "
+               "I/O retries passed\n";
+}
diff --git a/test/clipping_page_turn/ClippingPageTurnIoTest.cpp b/test/clipping_page_turn/ClippingPageTurnIoTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/clipping_page_turn/ClippingPageTurnIoTest.cpp
@@ -0,0 +1,104 @@
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "clippings/ClippingPageFilter.h"
+#define LOG_ERR(...) \
+  do {               \
+  } while (0)
+constexpr size_t CLIPPING_TEXT_MAX = 60U * 1024U;
+#include "ClippingRecord.inc"
+struct HalFile {
+  static inline unsigned readers = 0, opens = 0;
+  bool opened = false, failSeek = false, shortRead = false;
+  std::string bytes;
+  size_t position = 0;
+  explicit operator bool() const { return opened; }
+  bool seek(size_t offset) {
+    position = offset;
+    return opened && !failSeek && offset <= bytes.size();
+  }
+  int read(char* out, size_t size) {
+    const size_t count = std::min(size, bytes.size() - position);
+    const size_t actual = shortRead && count ? count - 1 : count;
+    std::memcpy(out, bytes.data() + position, actual);
+    position += actual;
+    return actual;
+  }
+  ~HalFile() {
+    if (opened) --readers;
+  }
+};
+using FsFile = HalFile;
+struct StorageStub {
+  bool failOpen = false;
+  std::string bytes;
+  bool openFileForRead(const char*, const std::string&, HalFile& file) {
+    if (failOpen) return false;
+    assert(!file.opened && HalFile::readers == 0);  // same-path reader restriction
+    file.opened = true;
+    file.bytes = bytes;
+    ++HalFile::readers;
+    ++HalFile::opens;
+    return true;
+  }
+} Storage;
+class ClippingStore {
+ public:
+  std::string storeFilePath = "clippings.bin";
+  std::vector<Clipping> clippings;
+  uint32_t contentRevision_ = 1;
+  bool loadFailed_ = false;
+  bool dirty = false, failWrite = false;
+  bool writeToFile(const std::string*, size_t) { return !failWrite; }
+  bool openTextReader(FsFile&) const;
+  bool readClippingText(const Clipping&, std::string&) const;
+  bool readClippingText(const Clipping&, std::string&, FsFile&) const;
+  bool updateClippingText(size_t, const std::string&);
+};
+#include "ClippingStoreReaders.inc"
+int main() {
+  ClippingStore store;
+  Storage.bytes = "alpha beta gamma";
+  Clipping clip;
+  clip.textLength = Storage.bytes.size();
+  std::string text;
+  for (int i = 0; i < 500; ++i) assert(store.readClippingText(clip, text));
+  const auto before = HalFile::opens;
+  assert(before == 500 && clip.textFilter.firstLength != 0);
+  {
+    FsFile reader;
+    assert(store.openTextReader(reader));
+    for (int i = 0; i < 500; ++i) assert(store.readClippingText(clip, text, reader));
+    assert(text == Storage.bytes && HalFile::opens == before + 1);
+    clip.textFilter = {};
+    reader.shortRead = true;
+    assert(!store.readClippingText(clip, text, reader));
+    assert(text.empty() && clip.textFilter.firstLength == 0);
+    reader.shortRead = false;
+    reader.failSeek = true;
+    assert(!store.readClippingText(clip, text, reader));
+  }
+  assert(HalFile::readers == 0);
+  Storage.failOpen = true;
+  text = "stale";
+  assert(!store.readClippingText(clip, text) && text.empty());
+  Storage.failOpen = false;
+  assert(store.readClippingText(clip, text));
+  store.clippings.push_back(clip);
+  const auto oldHash = clip.textFilter.firstHash;
+  store.failWrite = true;
+  assert(!store.updateClippingText(0, "new wording"));
+  assert(store.clippings[0].textFilter.firstHash == oldHash);
+  store.failWrite = false;
+  assert(store.updateClippingText(0, "new wording"));
+  assert(store.clippings[0].textFilter.firstLength == 0);
+  Storage.bytes = "new wording";
+  assert(store.readClippingText(store.clippings[0], text));
+  assert(store.clippings[0].textFilter.firstHash != oldHash);
+  std::cout << "500 clipping reads: file opens 500 -> 1; failed I/O, edit invalidation and rollback passed\n";
+}
diff --git a/test/clipping_page_turn/ClippingPageTurnTest.cpp b/test/clipping_page_turn/ClippingPageTurnTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/clipping_page_turn/ClippingPageTurnTest.cpp
@@ -0,0 +1,213 @@
+#include <algorithm>
+#include <cassert>
+#include <cctype>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <random>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+#include "ClippingStore.h"
+#include "clippings/ClippingPageMatchCache.h"
+#include "clippings/ClippingHighlightGeometry.h"
+#include "clippings/ClippingMatchTracker.h"
+#include "clippings/ClippingPageFilter.h"
+
+// Only the page-storage adapter is simulated. ExtractMatcher.py compiles the
+// production tokenizer and matcher directly, so this test cannot drift to a copy.
+struct TextBlock {
+  std::vector<std::string> words;
+  std::vector<bool> hyphens;
+  uint16_t wordCount() const { return words.size(); }
+  const char* wordText(uint16_t i) const { return words[i].c_str(); }
+  bool wordEndsWithInsertedHyphen(uint16_t i) const { return !hyphens.empty() && hyphens[i]; }
+};
+struct PageTextLine {
+  const TextBlock* block;
+  uint16_t tableSelection = UINT16_MAX;
+};
+struct TableFragmentRow {
+  static constexpr uint8_t MAX_SERIALIZED_CELLS = 8;
+};
+struct Page {
+  TextBlock block;
+  mutable size_t traversals = 0;
+  bool forEachTextLine(bool (*visit)(const PageTextLine&, void*), void* context) const {
+    ++traversals;
+    return visit({&block}, context);
+  }
+};
+bool hasEmSpacePrefix(const char* s) { return std::strlen(s) >= 3 && std::memcmp(s, "\xE2\x80\x83", 3) == 0; }
+#include "ReaderClippingMatcher.inc"
+
+clippingPageFilter::Page filterFor(const Page& page) {
+  clippingPageFilter::Page result;
+  for (size_t i = 0; i < page.block.words.size(); ++i) {
+    const char* s = page.block.wordText(i);
+    result.addWord(s + (hasEmSpacePrefix(s) ? 3 : 0), page.block.wordEndsWithInsertedHyphen(i));
+  }
+  return result;
+}
+clippingPageFilter::Text filterFor(const std::string& text) {
+  clippingPageFilter::Text result;
+  result.build(text.data(), text.size());
+  return result;
+}
+void compare(const Page& page, const std::string& text) {
+  ClippingPageMatch oldMatch, newMatch, shortMatch;
+  bool oldUnique = false, newUnique = false;
+  const bool oldFound = findClippingTextInPages(page, text, oldMatch, &oldUnique);
+  const bool oldShort = !oldFound && findClippingTextInPages(page, text, shortMatch, nullptr, UINT8_MAX, true);
+  bool newShort = false;
+  uint8_t directions = 0;
+  const bool newFound =
+      findClippingTextInPages(page, text, newMatch, &newUnique, UINT8_MAX, false, UINT16_MAX, &directions, &newShort);
+  assert(oldFound == newFound);
+  assert(oldFound || oldShort == newShort);
+  if (oldFound) {
+    assert(oldUnique == newUnique);
+    assert(oldMatch.startWord == newMatch.startWord && oldMatch.endWord == newMatch.endWord);
+    assert(oldMatch.startsAtClipStart == newMatch.startsAtClipStart &&
+           oldMatch.reachesClipEnd == newMatch.reachesClipEnd);
+  }
+  if (oldFound || oldShort) assert(filterFor(page).mayMatch(filterFor(text), false));
+}
+int main() {
+  {
+    Page joined;
+    joined.block.words = {"We", "were", "all", "in", "the", "business", "of", "selling—some"};
+    ClippingPageMatch match;
+    assert(findClippingTextInPages(joined, "We were all in the business of selling", match));
+    assert(match.startWord == 0 && match.endWord == 7 && match.endByte == 7);
+    assert(match.reachesClipEnd);
+    assert(findClippingTextInPages(joined, "selling", match));
+    assert(match.endByte == 7);
+    assert(!findClippingTextInPages(joined, "sell", match));
+    joined.block.words = {"selling–some"};
+    assert(findClippingTextInPages(joined, "selling", match) && match.endByte == 7);
+    joined.block.words = {"selling—some"};
+    assert(findClippingTextInPages(joined, "selling—some", match) && match.endByte == 14);
+  }
+
+  // First-word matching, continuations, short words, punctuation, UTF-8 folding,
+  // inserted hyphens and table-column bypass must never be rejected.
+  for (const auto& text : {"alpha beta", "alpha", "before alpha beta", "a bcd", "abcd", "ALPHA BETA",
+                           "\xE2\x80\x9C"
+                           "alpha beta",
+                           "alpha beta?",
+                           "alpha\xC2\xA0"
+                           "beta"}) {
+    for (const auto& words : std::vector<std::vector<std::string>>{{"alpha", "beta"},
+                                                                   {"alpha", "beta", "tail"},
+                                                                   {"a", "bcd"},
+                                                                   {"beta"},
+                                                                   {"\"alpha", "beta?"},
+                                                                   {"alp", "ha", "beta"}}) {
+      compare(Page{{words}}, text);
+    }
+  }
+  Page hyphen{{{"a-", "lpha", "beta"}, {true, false, false}}};
+  compare(hyphen, "alpha beta");
+  compare(Page{{{"caf\xC3\xA9", "\xE2\x80\x94", "today"}}}, "CAF\xC3\x89 \xE2\x80\x94 today");
+  assert(filterFor(Page{{{"unrelated"}}}).mayMatch(filterFor("different column"), true));
+  clippingPageFilter::Text unknown;
+  assert(filterFor(Page{{{"unrelated"}}}).mayMatch(unknown, false));
+  auto edited = filterFor("old selection");
+  edited = {};
+  assert(filterFor(Page{{{"new"}}}).mayMatch(edited, false));
+
+  const std::vector<std::string> vocabulary = {"after",    "before",
+                                               "chapter",  "river",
+                                               "mountain", "people",
+                                               "quiet",    "garden",
+                                               "window",   "forest",
+                                               "memory",   "orange",
+                                               "violet",   "yellow",
+                                               "zebra",    "broken",
+                                               "silver",   "eastern",
+                                               "frozen",   "travel",
+                                               "knowing",  "deeply",
+                                               "a",        "an",
+                                               "I",        "the",
+                                               "and",      "but",
+                                               "of",       "to",
+                                               "in",       "is",
+                                               "he",       "we",
+                                               "it",       "on",
+                                               "as",       "be",
+                                               "or",       "\"quoted",
+                                               "quoted?",  "can\xE2\x80\x99t",
+                                               "can't",    "dash\xE2\x80\x94word",
+                                               "dash-word"};
+  std::mt19937 random(4517);
+  for (size_t n = 0; n < 12000; ++n) {
+    Page page;
+    for (size_t j = 0, count = 1 + random() % 25; j < count; ++j)
+      page.block.words.push_back(vocabulary[random() % vocabulary.size()]);
+    std::string text;
+    if (n % 3 == 0) {
+      const auto begin = random() % page.block.words.size();
+      for (size_t j = begin; j < page.block.words.size(); ++j) {
+        if (!text.empty()) text += ' ';
+        text += page.block.words[j];
+      }
+    } else {
+      for (size_t j = 0, count = 1 + random() % 20; j < count; ++j) {
+        if (!text.empty()) text += ' ';
+        text += vocabulary[random() % vocabulary.size()];
+      }
+    }
+    compare(page, text);
+  }
+
+  // A highlight-heavy chapter: 500 clippings, 100 turns. All filters are
+  // warmed once (as on the first render); count would-be SD reads and compare
+  // every result against the unfiltered production matcher.
+  std::vector<std::string> clips;
+  std::vector<clippingPageFilter::Text> filters;
+  for (size_t i = 0; i < 500; ++i) {
+    std::string text;
+    for (size_t j = 0; j < 8; ++j) {
+      if (j) text += ' ';
+      text += vocabulary[random() % 22];
+    }
+    clips.push_back(text);
+    filters.push_back(filterFor(text));
+  }
+  size_t reads = 0, baselineReads = 0, oldTraversals = 0, newTraversals = 0;
+  for (size_t turn = 0; turn < 100; ++turn) {
+    Page page;
+    for (size_t j = 0; j < 24; ++j) page.block.words.push_back(vocabulary[random() % 22]);
+    const auto pageFilter = filterFor(page);
+    for (size_t i = 0; i < clips.size(); ++i) {
+      ++baselineReads;
+      ClippingPageMatch match;
+      bool unique;
+      uint8_t directions = 0;
+      bool shortFound = false;
+      page.traversals = 0;
+      const bool oldFound = findClippingTextInPages(page, clips[i], match, &unique);
+      const bool oldShort = !oldFound && findClippingTextInPages(page, clips[i], match, nullptr, UINT8_MAX, true);
+      oldTraversals += page.traversals;
+      page.traversals = 0;
+      if (pageFilter.mayMatch(filters[i], false)) {
+        ++reads;
+        const bool found = findClippingTextInPages(page, clips[i], match, &unique, UINT8_MAX, false, UINT16_MAX,
+                                                   &directions, &shortFound);
+        assert(found == oldFound);
+        assert(found || shortFound == oldShort);
+      } else
+        assert(!oldFound && !oldShort);
+      newTraversals += page.traversals;
+    }
+  }
+  std::cerr << "reads=" << reads << "/" << baselineReads << " traversals=" << newTraversals << "/" << oldTraversals
+            << "\n";
+  assert(reads < baselineReads * 0.95);
+  assert(newTraversals < oldTraversals * 0.65);
+  std::cout << "SD text reads: " << baselineReads << " -> " << reads << "; page traversals: " << oldTraversals << " -> "
+            << newTraversals << "; 12000 equivalence cases passed\n";
+}
