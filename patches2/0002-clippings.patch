+struct Page {
+  uint64_t starts[3][4] = {};
+  uint64_t shortWords[2][4] = {};
+  uint64_t continuationQueries = 0;
+  bool first = true;
+  bool uncertainStart = false;
+  bool uncertainContinuation = false;
+  void addWord(const char* text, bool insertedHyphen) {
+    size_t size = std::strlen(text);
+    if (insertedHyphen && size && text[size - 1] == '-') --size;
+    size_t offset = 0;
+    uint32_t hash = 2166136261U;
+    uint8_t length = 0;
+    uint64_t queries = 0;
+    while (offset < size && length < 3) {
+      const auto cp = ClippingTextMatcher::nextCodepoint(text, size, offset);
+      if (!length && ClippingTextMatcher::isEdgePunctuation(cp)) continue;
+      hash = append(hash, cp);
+      const uint8_t key = shortHash(hash);
+      starts[length++][key / 64] |= uint64_t{1} << (key % 64);
+      queries |= hashBit(hash);
+    }
+    // Short hyphen fragments may precede the rest of a token on another line.
+    const bool uncertain = !length;
+    if (length && length < 3) {
+      const uint8_t key = shortHash(hash);
+      shortWords[length - 1][key / 64] |= uint64_t{1} << (key % 64);
+    }
+    uncertainStart |= uncertain;
+    if (first) {
+      continuationQueries = queries;
+      uncertainContinuation = uncertain || length < 3;
+      first = false;
+    }
+  }
+  bool mayMatch(const Text& text, bool tableColumn) const {
+    // A table-column continuation can start after another column's words.
+    if (tableColumn || text.firstLength == 0 || text.firstLength == 255 || uncertainStart || uncertainContinuation)
+      return true;
+    for (uint8_t i = 0; i < 2 && i + 1 < text.firstLength; ++i) {
+      const auto key = text.shortHashes[i];
+      if (shortWords[i][key / 64] & (uint64_t{1} << (key % 64))) return true;
+    }
+    const uint8_t key = shortHash(text.firstHash);
+    return (starts[text.firstLength - 1][key / 64] & (uint64_t{1} << (key % 64))) ||
