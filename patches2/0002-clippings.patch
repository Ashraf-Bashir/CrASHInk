+++ b/test/clipping_store_safety/ClippingStoreSafetyTest.cpp
@@ -0,0 +1,194 @@
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "ClippingStore.h"
+#define LOG_ERR(...) \
+  do {               \
+  } while (0)
+#define LOG_INF(...) \
+  do {               \
+  } while (0)
+using Bytes = std::vector<uint8_t>;
+std::map<std::string, Bytes> files;
+unsigned writes = 0, appends = 0, openFailures = 0;
+bool failRename = false;
+class HalFile {
+  const Bytes* bytes = nullptr;
+  size_t cursor = 0;
+
+ public:
+  void open(const Bytes& data) {
+    bytes = &data;
+    cursor = 0;
+  }
+  explicit operator bool() const { return bytes; }
+  int read(void* out, size_t count) {
+    const size_t available = bytes && cursor < bytes->size() ? bytes->size() - cursor : 0;
+    const size_t copied = std::min(count, available);
+    if (copied) std::memcpy(out, bytes->data() + cursor, copied);
+    cursor += copied;
+    return copied;
+  }
+  bool seekCur(size_t count) {
+    cursor += count;
+    return true;
+  }  // intentionally allows seeking past EOF
+  size_t position() const { return cursor; }
+  size_t size() const { return bytes ? bytes->size() : 0; }
+  void close() { bytes = nullptr; }
+};
+using FsFile = HalFile;
+struct StorageStub {
+  bool exists(const char* path) const { return files.count(path); }
+  bool rename(const char* from, const char* to) {
+    if (failRename || !files.count(from) || files.count(to)) return false;
+    files[to] = files[from];
+    files.erase(from);
+    return true;
+  }
+  bool remove(const char* path) { return files.erase(path); }
+  bool openFileForRead(const char*, const std::string& path, FsFile& file) {
+    if (openFailures) {
+      --openFailures;
+      return false;
+    }
+    if (!files.count(path)) return false;
+    file.open(files[path]);
+    return true;
+  }
+} Storage;
+namespace serialization {
+template <typename T>
+bool tryReadPod(FsFile& file, T& value) {
+  return file.read(&value, sizeof(value)) == sizeof(value);
+}
+bool tryReadString(FsFile& file, std::string& value) {
+  uint32_t size = 0;
+  if (!tryReadPod(file, size) || size > 4096) return false;
+  value.resize(size);
+  return !size || file.read(value.data(), size) == size;
+}
+}  // namespace serialization
+namespace MemoryBudget {
+struct Heap {
+  uint32_t maxAllocHeap = UINT32_MAX;
+};
+Heap snapshot() { return {}; }
+Heap psramSnapshot() { return {}; }
+}  // namespace MemoryBudget
+std::string storeFilePathForBook(const std::string&, const std::string&) { return "book.bin"; }
+void copyBounded(char* out, size_t size, const char* text) { std::snprintf(out, size, "%s", text); }
+int utf8SafeTruncateBuffer(const char*, int size) { return size; }
+unsigned long millis() { return 1000; }
+bool ClippingStore::writeToFile(const std::string*, size_t, const std::string*, const char*) {
+  ++writes;
+  return true;
+}
+bool ClippingStore::appendLastToFile(const std::string&, const char*) {
+  ++appends;
+  return false;
+}
+#include "StoreSafety.inc"
+template <typename T>
+void pod(Bytes& out, T value) {
+  const auto* begin = reinterpret_cast<const uint8_t*>(&value);
+  out.insert(out.end(), begin, begin + sizeof(value));
+}
+void string(Bytes& out, const std::string& text) {
+  pod<uint32_t>(out, text.size());
+  out.insert(out.end(), text.begin(), text.end());
+}
+Bytes database(uint8_t version) {
+  Bytes result;
+  pod(result, version);
+  pod<uint16_t>(result, 3);
+  string(result, "Book");
+  string(result, "Author");
+  string(result, "book.epub");
+  for (uint16_t chapter = 0; chapter < 3; ++chapter) {
+    pod(result, chapter);                                  // spine
+    for (int i = 0; i < 2; ++i) pod<uint16_t>(result, 0);  // start/end pages
+    pod<uint16_t>(result, 12);                             // page count
+    pod<uint16_t>(result, 1);
+    pod<uint16_t>(result, 3);  // words
+    pod<uint16_t>(result, 3);
+    pod<uint16_t>(result, 0);
+    pod<uint32_t>(result, 42);  // count, paragraph, timestamp
+    if (version >= 3) pod<uint32_t>(result, 17);
+    if (version >= 4) pod<uint16_t>(result, UINT16_MAX);
+    result.insert(result.end(), 48, 0);
+    const std::string text = "chapter " + std::to_string(chapter) + " highlight";
+    if (version == 1)
+      pod<uint32_t>(result, text.size());
+    else
+      pod<uint16_t>(result, text.size());
+    result.insert(result.end(), text.begin(), text.end());
+  }
+  return result;
+}
+void noOverwrite(ClippingStore& store) {
+  const auto before = files;
+  const auto previousWrites = writes, previousAppends = appends;
+  assert(store.hasLoadError() && store.clippingCount() == 0);
+  assert(store.addClipping(2, 0, 0, 1, 0, 1, 2, "Chapter 2", 0, "new highlight", UINT16_MAX, 17) ==
+         ClippingStore::AddResult::SaveFailed);
+  assert(!store.updateClippingText(0, "replacement"));
+  assert(!store.removeClippingAt(0));
+  assert(!store.removeClippings({}));
+  assert(!store.saveToFile());
+  assert(files == before && writes == previousWrites && appends == previousAppends);
+}
+int main() {
+  size_t truncations = 0;
+  for (uint8_t version = 1; version <= 4; ++version) {
+    const auto valid = database(version);
+    files = {{"book.bin", valid}};
+    ClippingStore good;
+    assert(good.loadForBook("book.epub", "Book", "Author", "epub"));
+    assert(good.clippingCount() == 3 && !good.hasLoadError());
+    for (size_t cut = 0; cut < valid.size(); ++cut) {
+      files = {{"book.bin", Bytes(valid.begin(), valid.begin() + cut)}};
+      ClippingStore broken;
+      assert(!broken.loadForBook("book.epub", "Book", "Author", "epub"));
+      noOverwrite(broken);
+      ++truncations;
+    }
+  }
+  const auto valid = database(4);
+  files = {{"book.bin.bak", valid}};
+  ClippingStore backup;
+  assert(backup.loadForBook("book.epub", "Book", "Author", "epub") && backup.clippingCount() == 3);
+  assert(files.at("book.bin") == valid && !files.count("book.bin.bak"));
+  files = {{"book.bin.tmp", valid}};
+  ClippingStore temporary;
+  assert(temporary.loadForBook("book.epub", "Book", "Author", "epub") && temporary.clippingCount() == 3);
+  assert(files.at("book.bin") == valid);
+  files = {{"book.bin.tmp", Bytes(valid.begin(), valid.end() - 1)}};
+  ClippingStore incomplete;
+  assert(!incomplete.loadForBook("book.epub", "Book", "Author", "epub"));
+  noOverwrite(incomplete);
+  files = {{"book.bin.bak", valid}};
+  failRename = true;
+  ClippingStore failedRename;
+  assert(!failedRename.loadForBook("book.epub", "Book", "Author", "epub"));
+  noOverwrite(failedRename);
+  failRename = false;
+  files = {{"book.bin", valid}};
+  openFailures = 1;
+  ClippingStore retried;
+  assert(retried.loadForBook("book.epub", "Book", "Author", "epub") && retried.clippingCount() == 3);
+  files["book.bin.bak"] = valid;
+  files["book.bin.tmp"] = valid;
+  retried.clearAll();
+  assert(files.empty() && !retried.hasLoadError());
+  std::cout << truncations
+            << " truncated-file cases blocked destructive writes; v1-v4 loads, backup/temp recovery, and transient "
+               "read retry passed\n";
+}
