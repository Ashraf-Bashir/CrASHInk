+struct {int getReaderFontId() const {return 0;}} SETTINGS;
+struct RenderLock {
+ static inline bool busy=false;
+ template<class T> explicit RenderLock(T&) {}
+ static bool peek() {return busy;}
+};
+unsigned long millis() {static unsigned long time=1;return time++;}
+struct Navigator {
+ int current=0,selectCalls=0;
+ int screenX=10,width=40;bool isRtl=false;
+ int heightOr(int height) const {return height;}
+ int getCurrentFlatIndex() const {return current;}
+ int getLastFlatIndex() const {return 1;}
