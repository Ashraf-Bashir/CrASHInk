@@ -0,0 +1,84 @@
+#include "CrASHinkStorage.h"
+
+#include <Epub.h>
+#include <FsHelpers.h>
+#include <HalStorage.h>
+#include <Logging.h>
+
+#include <string>
+#include <string_view>
+
+namespace crashinkStorage {
+namespace {
+constexpr char migrationMarker[] = "/crashink/.storage-v1";
+constexpr char legacyRoot[] = "/.crosspoint";
+constexpr char clippingSource[] = "/.crosspoint/clippings";
+constexpr char clippingTarget[] = "/crashink/clippings";
+constexpr char readestTarget[] = "/crashink/readest";
+constexpr char libraryTarget[] = "/crashink/library";
+
+// Close each entry before renaming it. Only one directory and one entry
+// are open at a time, with no buffer proportional to the library size.
+bool moveEntries(const char* source, bool clippings) {
+  bool allMoved = true;
+  HalFile dir = Storage.open(source);
+  if (!dir || !dir.isDirectory()) return false;
+  char name[120];
+  while (auto entry = dir.openNextFile()) {
+    name[0] = 0;
+    const size_t length = entry.getName(name, sizeof(name));
+    const bool file = !entry.isDirectory();
+    entry.close();
+    if (!file || length == 0 || length >= sizeof(name) - 1) continue;
+    const std::string_view leaf(name, length);
+    const char* target = clippings ? clippingTarget : nullptr;
+    if (!clippings) {
+      if (leaf.starts_with("readest.") || leaf.starts_with("readest_")) target = readestTarget;
+      if (leaf.starts_with("library.") || leaf.starts_with("library-") || leaf.starts_with("opened."))
+        target = libraryTarget;
+    }
+    if (!target) continue;
+    const std::string from = std::string(source) + "/" + name;
+    const std::string to = std::string(target) + "/" + name;
+    if (Storage.exists(to.c_str())) {
+      LOG_ERR("CRASHINK", "Storage migration left both copies of %s intact", name);
+      allMoved = false;
+      continue;
+    }
+    if (!Storage.rename(from.c_str(), to.c_str())) {
+      LOG_ERR("CRASHINK", "Storage migration could not move %s", from.c_str());
+      allMoved = false;
+      continue;
+    }
+    if (target == readestTarget && leaf.ends_with(".epub")) {
+      const std::string oldCache = Epub::cachePathForFilePath(from, legacyRoot);
+      if (Storage.exists(oldCache.c_str()) && !Storage.removeDir(oldCache.c_str()))
+        LOG_ERR("CRASHINK", "Could not remove old cache for %s", name);
+    }
+  }
+  const bool failed = FsHelpers::directoryIterationFailed(dir);
+  dir.close();
+  return allMoved && !failed;
+}
+}  // namespace
+
+void migrate() {
+  if (!Storage.ensureDirectoryExists("/crashink") || !Storage.ensureDirectoryExists(readestTarget) ||
+      !Storage.ensureDirectoryExists(libraryTarget)) {
+    LOG_ERR("CRASHINK", "Could not prepare SD storage folders");
+    return;
+  }
+  if (Storage.exists(migrationMarker) && Storage.exists(clippingTarget)) return;
+  if (Storage.exists(clippingSource) && !Storage.exists(clippingTarget))
+    Storage.rename(clippingSource, clippingTarget);
+  if (!Storage.ensureDirectoryExists(clippingTarget)) {
+    LOG_ERR("CRASHINK", "Could not prepare clipping folder");
+    return;
+  }
+  const bool clipsMoved = !Storage.exists(clippingSource) ||
+                          (moveEntries(clippingSource, true) && Storage.rmdir(clippingSource));
+  const bool filesMoved = !Storage.exists(legacyRoot) || moveEntries(legacyRoot, false);
+  if (clipsMoved && filesMoved && !Storage.writeFile(migrationMarker, "1"))
+    LOG_ERR("CRASHINK", "Could not save the SD storage migration marker");
+}
+}  // namespace crashinkStorage
