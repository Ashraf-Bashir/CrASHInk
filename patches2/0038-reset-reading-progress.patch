+bool RecentBookProgress::resetEpubProgress(const std::string& bookPath) {
+  if (!FsHelpers::hasEpubExtension(bookPath)) return false;
+  const std::lock_guard<std::mutex> lock(percentCacheMutex);
+  const auto cachePath = Epub::resolveCachePathForFilePath(bookPath, "/.crosspoint");
+  if (!Storage.exists(cachePath.c_str())) {
+    Storage.mkdir("/.crosspoint");
+    if (!Storage.mkdir(cachePath.c_str())) return false;
+  }
+
+  if (auto* entry = findPercent(cachePath)) entry->path.clear();
+  library::invalidateRecentViewCache();
+  // Remove recovery copies before the authoritative position, so a later
+  // open cannot restore the position from a stale backup.
+  for (const char* name : {"/progress.bin.tmp", "/progress.bin.bak", EPUB_PERCENT_CACHE_FILE, "/progress.bin"}) {
+    const auto file = cachePath + name;
+    if (Storage.exists(file.c_str()) && !Storage.remove(file.c_str())) {
+      LOG_ERR("RBPR", "Could not remove reading progress: %s", file.c_str());
+      return false;
+    }
+  }
+  if (!saveCachedEpubPercentToCachePath(cachePath, 0.0f)) return false;
+  rememberPercent(cachePath, 0.0f);
+  return true;
+}
+
+bool RecentBookProgress::hasResetEpubProgress(const std::string& bookPath) {
+  const auto cachePath = Epub::cachePathForFilePath(bookPath, "/.crosspoint");
+  const std::lock_guard<std::mutex> lock(percentCacheMutex);
+  const auto* entry = findPercent(cachePath);
+  const float saved = entry ? entry->percent : loadCachedEpubPercentFromCachePath(cachePath);
+  // A zero percentage without a position is the explicit reset state.
+  return saved == 0.0f && !Storage.exists((cachePath + "/progress.bin").c_str());
+}
