+// Normalize directory names while leaving files and any conflicting copies intact.
+bool moveHiddenTree(const std::string& source, const std::string& target) {
+  bool allMoved = true;
+  HalFile directory = Storage.open(source.c_str());
+  if (!directory || !directory.isDirectory()) return false;
+  char name[256];
+  while (auto entry = directory.openNextFile()) {
+    name[0] = 0;
+    const size_t length = entry.getName(name, sizeof(name));
+    const bool isDirectory = entry.isDirectory();
+    entry.close();
+    if (!length || length >= sizeof(name) - 1) {
+      allMoved = false;
+      continue;
+    }
+    const std::string_view leaf(name, length);
+    if (leaf == "." || leaf == ".." || (!isDirectory && source == target)) continue;
+    const std::string from = source + "/" + name;
+    const std::string to = target + (isDirectory && name[0] != '.' ? "/." : "/") + name;
+    const auto resume = directory.position();
+    directory.close();
+    bool moved = true;
+    if (from == to) {
+      moved = moveHiddenTree(from, to);
+    } else if (!Storage.exists(to.c_str())) {
+      moved = Storage.rename(from.c_str(), to.c_str());
+      if (moved && isDirectory) moved = moveHiddenTree(to, to);
+    } else if (isDirectory) {
+      moved = moveHiddenTree(from, to) && Storage.rmdir(from.c_str());
+    } else {
+      moved = false;
+    }
+    if (!moved) {
+      LOG_ERR("CRASHINK", "Could not migrate SD entry %s", from.c_str());
+      allMoved = false;
+    }
+    directory = Storage.open(source.c_str());
+    if (!directory || !directory.seek(resume)) return false;
+  }
+  return allMoved && !FsHelpers::directoryIterationFailed(directory);
+}

