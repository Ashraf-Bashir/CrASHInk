diff --git a/lib/GfxRenderer/ImageTone.h b/lib/GfxRenderer/ImageTone.h
new file mode 100644
index 0000000000000000000000000000000000000000..18b3ad4d7973307c669b306150055a8bb2504812
--- /dev/null
+++ b/lib/GfxRenderer/ImageTone.h
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <cstdint>
+
+enum class ImageTone : uint8_t { Normal, Light, Dark };
+
+// The cache has four grayscale levels. Move half of the midtone pixels one
+// step to shift the image without collapsing both shades or changing black
+// and white line art. Use the same physical pattern in every plane.
+constexpr uint8_t applyImageTone(uint8_t level, ImageTone tone, int panelX, int panelY) {
+  if (tone == ImageTone::Normal || level == 0 || level >= 3 || ((panelX ^ panelY) & 2) == 0) return level;
+  return static_cast<uint8_t>(tone == ImageTone::Light ? level + 1 : level - 1);
+}
