diff --git a/src/util/ReaderStatusBarConfig.h b/src/util/ReaderStatusBarConfig.h
index 4a33e9b745cb659026059fe101107eb368e7a8a3..dbbcd8baa1a52a9474d6db6b9cdbbc1471ad644e 100644
--- a/src/util/ReaderStatusBarConfig.h
+++ b/src/util/ReaderStatusBarConfig.h
@@ -68,6 +68,19 @@ struct ReaderStatusBarConfig {
   }
 };

+// Keep the clock beside the battery on every status bar that shows it.
+inline void placeClockAtRight(ReaderStatusBarConfig& config) {
+  auto& slots = config.slots;
+  if (!config.contains(ReaderStatusBarItem::Clock)) return;
+  const auto battery = std::find(slots.begin(), slots.end(), ReaderStatusBarItem::Battery);
+  const bool hasBattery = battery != slots.end();
+  if (hasBattery) std::iter_swap(battery, slots.begin() + ReaderStatusBarConfig::RIGHT_THIRD);
+  const auto clock = std::find(slots.begin(), slots.end(), ReaderStatusBarItem::Clock);
+  std::replace(clock + 1, slots.end(), ReaderStatusBarItem::Clock, ReaderStatusBarItem::Empty);
+  std::iter_swap(clock, slots.begin() + (hasBattery ? ReaderStatusBarConfig::RIGHT_SECOND
+                                                   : ReaderStatusBarConfig::RIGHT_THIRD));
+}
