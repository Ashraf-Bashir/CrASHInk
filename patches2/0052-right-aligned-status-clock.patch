+
+TEST(ReaderStatusBarConfig, DisplayClockSitsImmediatelyBeforeBattery) {
+  DisplayStatusBarConfig display;
+  display.slots[0] = ReaderStatusBarItem::Clock;
+  display.slots[1] = ReaderStatusBarItem::Clock;
+  auto bar = display.asReaderConfig();
+  placeClockAtRight(bar);
+  EXPECT_EQ(bar.slots[ReaderStatusBarConfig::LEFT_FIRST], ReaderStatusBarItem::Empty);
+  EXPECT_EQ(bar.slots[ReaderStatusBarConfig::CENTER], ReaderStatusBarItem::Empty);
+  EXPECT_EQ(bar.slots[ReaderStatusBarConfig::RIGHT_SECOND], ReaderStatusBarItem::Clock);
+  EXPECT_EQ(bar.slots[ReaderStatusBarConfig::RIGHT_THIRD], ReaderStatusBarItem::Battery);
+}
+
+TEST(ReaderStatusBarConfig, ReaderClockMovesRightWithoutDroppingOtherItems) {
+  ReaderStatusBarConfig bar;
+  bar.slots[ReaderStatusBarConfig::CENTER] = ReaderStatusBarItem::Clock;
+  bar.slots[ReaderStatusBarConfig::RIGHT_THIRD] = ReaderStatusBarItem::BookProgressPercentage;
+  placeClockAtRight(bar);
+  EXPECT_EQ(bar.slots[ReaderStatusBarConfig::CENTER], ReaderStatusBarItem::BookProgressPercentage);
+  EXPECT_EQ(bar.slots[ReaderStatusBarConfig::RIGHT_THIRD], ReaderStatusBarItem::Clock);
+}
