diff --git a/test/touch_page_turn/test_swipe_only.py b/test/touch_page_turn/test_swipe_only.py
new file mode 100644
--- /dev/null
+++ b/test/touch_page_turn/test_swipe_only.py
@@ -0,0 +1,65 @@
+"""Compile and exercise the production touch routing function in isolation."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'src/activities/reader/ReaderUtils.h').read_text()
+start = source.index('inline TouchPageTurn detectTouchPageTurn(')
+end = source.index('\ninline bool isBottomStatusBarTap', start)
+fixture = r'''
+#include <cassert>
+#include <cstdint>
+#define CROSSINK_APP_CAP_TOUCH 1
+struct { bool touchReaderControls=true; uint8_t pageTurnGesture=0, previousPageGesture=0; } SETTINGS;
+struct GfxRenderer {};
+struct MappedInputManager {
+ enum class SwipeDir { None, Left, Right, Up, Down };
+ SwipeDir swipe=SwipeDir::None;
+ bool touch=true, tap=false;
+ bool hasTouch() const { return touch; }
+ SwipeDir wasSwipe() const { return swipe; }
+ bool wasScreenTapped(int& x,int& y) const { x=120; y=300; return tap; }
+ unsigned long getHeldTime() const { return 50; }
+};
+struct TouchPageTurn { bool prev,next,tapped; int x,y; unsigned long heldMs; };
+'''
+checks = r'''
+int main() {
+ GfxRenderer renderer;
+ MappedInputManager input;
+ // Every old persisted gesture combination must now behave identically.
+ for(int next=0;next<5;++next) for(int prev=0;prev<5;++prev) {
+  SETTINGS.pageTurnGesture=next; SETTINGS.previousPageGesture=prev;
+  input.swipe=MappedInputManager::SwipeDir::None; input.tap=true;
+  auto tap=detectTouchPageTurn(renderer,input);
+  assert(tap.tapped && !tap.next && !tap.prev && tap.x==120 && tap.y==300);
+  input.tap=false;
+  for(bool rtl : {false,true}) {
+   input.swipe=MappedInputManager::SwipeDir::Left;
+   auto left=detectTouchPageTurn(renderer,input,rtl);
+   assert(left.next==!rtl && left.prev==rtl && !left.tapped);
+   input.swipe=MappedInputManager::SwipeDir::Right;
+   auto right=detectTouchPageTurn(renderer,input,rtl);
+   assert(right.prev==!rtl && right.next==rtl);
+  }
+ }
+ input.swipe=MappedInputManager::SwipeDir::Left;
+ SETTINGS.touchReaderControls=false;
+ auto disabled=detectTouchPageTurn(renderer,input);
+ assert(!disabled.next && !disabled.prev && !disabled.tapped);
+ SETTINGS.touchReaderControls=true; input.touch=false;
+ disabled=detectTouchPageTurn(renderer,input);
+ assert(!disabled.next && !disabled.prev);
+}
+'''
+with tempfile.TemporaryDirectory() as directory:
+    cpp = Path(directory)/'test.cpp'
+    cpp.write_text('#include <initializer_list>\n' + fixture + source[start:end] + checks)
+    executable = Path(directory)/'test'
+    subprocess.run(['c++','-std=c++17',str(cpp),'-o',str(executable)],check=True)
+    subprocess.run([str(executable)],check=True)
+settings = (root/'src/SettingsList.cpp').read_text()
+assert '&CrossPointSettings::pageTurnGesture' not in settings
+assert '&CrossPointSettings::previousPageGesture' not in settings
+print('Swipe-only routing passed: legacy settings, LTR/RTL, taps, disabled touch, settings removal.')
