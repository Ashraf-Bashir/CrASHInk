+bool GfxRenderer::supportsRegionalGrayscale() const {
+#ifdef SIMULATOR
+  return false;
+#else
+  return !display.isInverted() && display.grayscaleCapabilities(HalDisplay::GrayscaleMode::Direct).regionalDirect;
+#endif
+}
+
+bool GfxRenderer::displayDirectGrayRegion(int x, int y, int width, int height) const {
+#ifdef SIMULATOR
+  return false;
+#else
+  if (width <= 0 || height <= 0) return false;
+  int ax, ay, bx, by;
+  screenToPanel(x, y, ax, ay);
+  screenToPanel(x + width - 1, y + height - 1, bx, by);
+  const int x0 = std::max(0, std::min(ax, bx));
+  const int y0 = std::max(0, std::min(ay, by));
+  const int x1 = std::min<int>(panelWidth - 1, std::max(ax, bx));
+  const int y1 = std::min<int>(panelHeight - 1, std::max(ay, by));
+  if (x1 < x0 || y1 < y0) return true;  // The image is completely outside the viewport.
+  return display.displayDirectGrayRegion(x0, y0, x1 - x0 + 1, y1 - y0 + 1, fadingFix);
+#endif
+}
+
 bool GfxRenderer::beginCombinedGrayscale() const {
   if (!supportsCombinedGrayscale()) return false;
   return supportsDirectGrayscale() ? displayDirectGrayscaleBase() : displayAbsoluteGrayscaleBase();
