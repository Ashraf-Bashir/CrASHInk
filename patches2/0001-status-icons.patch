+++ b/src/activities/settings/StatusIconsActivity.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <array>
+
+#include "StatusIconRow.h"
+#include "activities/Activity.h"
+#include "components/OptionPopup.h"
+
+// CrASHink > Status Bar Icons: switch each small icon at the left of
+// the reader's top status bar on or off, and choose their left-to-right order.
+class StatusIconsActivity final : public Activity {
+  OptionPopup popup;
+  std::array<uint8_t, StatusIconRow::Count> draftOrder{};
+  uint8_t draftHidden = 0;
+  void showOverview(int selectedRow);
+  void editRow(int row);
+  void saveDraft();
+
+ public:
+  StatusIconsActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+      : Activity("StatusIcons", renderer, mappedInput) {}
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+};
