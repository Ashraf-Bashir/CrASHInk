+void BaseTheme::drawFrontlightStatusIndicator(const GfxRenderer& renderer, int topY, bool darkMode) const {
+  // Pinned to the top-left corner, positioned entirely independently of the
+  // clock (centered) and battery (wherever its own header/status-bar logic
+  // puts it) so neither is affected.
+  //
+  // A single lamp icon, not a percentage readout: based on the exact same
+  // icon_lightbulb_28 / icon_lightbulb_off_28 the frontlight panel already
+  // draws next to its own "Brightness NN%" label (FrontlightPanelActivity),
+  // rather than hand-drawn glyphs, but rotated 90deg (head right, base left)
+  // and shrunk to 20px so it lies flat in the horizontal status bar row
+  // instead of standing upright at panel size, then flipped top-to-bottom to
+  // match how it actually renders on real hardware. A pair of 7px custom
+  // icons plus tiny percentage text was tried first and was illegible at
+  // status-bar size, and an upright 14px version of this same icon was
+  // still too small to read; 20px, laid on its side, is the size/orientation
+  // that stays legible in that thin row. The lightbulb-off variant already
+  // reads as "off" (a strike-through) on its own, so no separate number is
+  // needed to say whether the light is lit.
+  //
+  // Reads Frontlight.isOn() live on every call, the same way
+  // FrontlightPanelActivity::loop() re-syncs its own bulb icon from
+  // Frontlight.isOn() every frame (so a power-button light toggle, which
+  // can happen while any screen is open, is picked up here too).
+  if (!Frontlight.present()) {
+    return;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int iconY = baseTopY + (statusBarHeight - frontlightStatusIconSize) / 2;
+  const auto layout = statusIconLayout(orientedMarginLeft + metrics.statusBarHorizontalMargin);
+  if (!layout.visible(StatusIconRow::Lamp)) {
+    return;
+  }
+  const int x = layout.x(StatusIconRow::Lamp);
+
+  const uint8_t* bits = Frontlight.isOn() ? icon_lightbulb_h_bits : icon_lightbulb_off_h_bits;
+  if (darkMode) {
+    renderer.drawIconInverted(bits, x, iconY, frontlightStatusIconSize);
+  } else {
+    renderer.drawIcon(bits, x, iconY, frontlightStatusIconSize);
+  }
+}
