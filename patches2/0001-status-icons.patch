diff --git a/src/activities/settings/StatusIconsActivity.cpp b/src/activities/settings/StatusIconsActivity.cpp
new file mode 100644
--- /dev/null
+++ b/src/activities/settings/StatusIconsActivity.cpp
@@ -0,0 +1,95 @@
+#include "StatusIconsActivity.h"
+
+#include <I18n.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "CrossPointSettings.h"
+
+namespace {
+constexpr StrId slotLabels[StatusIconRow::Count] = {StrId::STR_ICON_FRONTLIGHT, StrId::STR_ICON_TOUCHSCREEN,
+                                                    StrId::STR_ICON_READEST, StrId::STR_ICON_HIGHLIGHTER};
+}  // namespace
+
+void StatusIconsActivity::onEnter() {
+  Activity::onEnter();
+  popup.setDismissOnOutsideTouchDown(true);
+  std::copy_n(SETTINGS.statusIconOrder, draftOrder.size(), draftOrder.begin());
+  StatusIconRow::sanitizeOrder(draftOrder.data());
+  draftHidden = SETTINGS.statusIconHidden;
+  showOverview(0);
+}
+
+void StatusIconsActivity::showOverview(const int selectedRow) {
+  std::vector<std::string> rows;
+  rows.reserve(StatusIconRow::Count);
+  for (uint8_t i = 0; i < StatusIconRow::Count; ++i) {
+    const uint8_t slot = draftOrder[i];
+    const bool shown = (draftHidden & (1u << slot)) == 0;
+    rows.emplace_back(std::to_string(i + 1) + ". " + I18N.get(slotLabels[slot]) + ": " +
+                      I18N.get(shown ? StrId::STR_ON : StrId::STR_OFF));
+  }
+  popup.showConfirmed(
+      StrId::STR_STATUS_BAR_ICONS, rows, selectedRow, [this](int selected) { editRow(selected); },
+      [this] { saveDraft(); }, [this] { finish(); });
+  requestUpdate();
+}
+
+void StatusIconsActivity::editRow(const int row) {
+  if (row < 0 || row >= StatusIconRow::Count) return;
+  const uint8_t slot = draftOrder[row];
+  const bool shown = (draftHidden & (1u << slot)) == 0;
+  enum Choice : uint8_t { Toggle, Up, Down };
+  std::vector<std::string> labels;
+  std::vector<Choice> choices;
+  labels.emplace_back(I18N.get(shown ? StrId::STR_HIDE : StrId::STR_SHOW));
+  choices.push_back(Toggle);
+  if (row > 0) {
+    labels.emplace_back(I18N.get(StrId::STR_MOVE_UP));
+    choices.push_back(Up);
+  }
+  if (row + 1 < StatusIconRow::Count) {
+    labels.emplace_back(I18N.get(StrId::STR_MOVE_DOWN));
+    choices.push_back(Down);
+  }
+  popup.show(slotLabels[slot], labels, 0, [this, row, slot, choices](int selected) {
+    if (selected < 0 || static_cast<size_t>(selected) >= choices.size()) return;
+    int newRow = row;
+    switch (choices[selected]) {
+      case Toggle:
+        draftHidden ^= static_cast<uint8_t>(1u << slot);
+        break;
+      case Up:
+        std::swap(draftOrder[row], draftOrder[row - 1]);
+        newRow = row - 1;
+        break;
+      case Down:
+        std::swap(draftOrder[row], draftOrder[row + 1]);
+        newRow = row + 1;
+        break;
+    }
+    showOverview(newRow);
+  });
+  popup.setCancelCallback([this, row] { showOverview(row); });
+}
+
+void StatusIconsActivity::saveDraft() {
+  std::copy(draftOrder.begin(), draftOrder.end(), SETTINGS.statusIconOrder);
+  SETTINGS.statusIconHidden = draftHidden;
+  SETTINGS.saveToFile();
+  finish();
+}
+
+void StatusIconsActivity::loop() {
+  if (popup.handleInput(mappedInput, [this] { requestUpdate(); })) return;
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    finish();
+  }
+}
+
+void StatusIconsActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+  popup.processRender(renderer, mappedInput);
+}
diff --git a/src/activities/settings/StatusIconsActivity.h b/src/activities/settings/StatusIconsActivity.h
new file mode 100644
