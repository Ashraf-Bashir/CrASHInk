+bool BaseTheme::isFrontlightIndicatorTap(const GfxRenderer& renderer, int topY, int touchX, int touchY) const {
+  if (!Frontlight.present()) {
+    return false;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return false;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+
+  // Generous hit box, not the icon's own tight bounds: the whole top status
+  // bar row's height, and a horizontal zone that runs to the middle of the
+  // gap to the neighbouring icons (or well past the last one), since a 20px
+  // glyph is a hard target to hit precisely with a finger. Follows the user's
+  // icon order, so it stays right when icons are moved or hidden.
+  const auto layout = statusIconLayout(orientedMarginLeft + metrics.statusBarHorizontalMargin);
+  int hitLeft = 0;
+  int hitRight = 0;
+  if (!layout.hitRange(StatusIconRow::Lamp, hitLeft, hitRight)) {
+    return false;
+  }
+  const int hitTop = baseTopY;
+  const int hitBottom = baseTopY + statusBarHeight;
+
+  return touchX >= hitLeft && touchX < hitRight && touchY >= hitTop && touchY < hitBottom;
