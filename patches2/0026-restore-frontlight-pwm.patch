diff --git a/lib/hal/HalFrontlight.cpp b/lib/hal/HalFrontlight.cpp
index 4a44a1357f11f67bd4c4f42caa719f74ffa06a64..4e262d6611e2829a7efd0490a907a279427be199 100644
--- a/lib/hal/HalFrontlight.cpp
+++ b/lib/hal/HalFrontlight.cpp
@@ -1,15 +1,26 @@
 #include "HalFrontlight.h"

+#include <BoardConfig.h>
 #include <Logging.h>

+#if !defined(SIMULATOR) && FREEINK_DEVICE_X4PRO
+#include <Arduino.h>
+#include <driver/gpio.h>
+#endif
+
 HalFrontlight HalFrontlight::instance;

 void HalFrontlight::begin(const uint8_t brightness, const uint8_t warmth, const bool on) {
   if (!manager.present()) {
     return;
   }
-#ifdef FREEINK_FRONTLIGHT_LS
-  manager.releaseOnWake();
+#if !defined(SIMULATOR) && FREEINK_DEVICE_X4PRO
+  if (BoardConfig::isX4Pro()) {
+    const auto& pins = BoardConfig::ACTIVE.frontlight;
+    for (const int8_t pin : {pins.gpio, pins.gpioWarm}) {
+      if (pin >= 0) gpio_hold_dis(static_cast<gpio_num_t>(pin));
+    }
+  }
 #endif
   manager.begin();
   lastBrightness = brightness > 100 ? 100 : brightness;
@@ -41,7 +52,18 @@ void HalFrontlight::setOn(const bool on) {
 void HalFrontlight::prepareForDeepSleep() {
   if (!manager.present()) return;
   setOn(false);
-#ifdef FREEINK_FRONTLIGHT_LS
-  manager.park();
+#if !defined(SIMULATOR) && FREEINK_DEVICE_X4PRO
+  if (BoardConfig::isX4Pro()) {
+    // Keep the normal PWM clock for the board's 25 kHz, 10-bit frontlight.
+    // Deep sleep only needs the LED pins detached and held at the off level.
+    const auto& pins = BoardConfig::ACTIVE.frontlight;
+    for (const int8_t pin : {pins.gpio, pins.gpioWarm}) {
+      if (pin < 0) continue;
+      ledcDetach(pin);
+      pinMode(pin, OUTPUT);
+      digitalWrite(pin, pins.activeHigh ? LOW : HIGH);
+      gpio_hold_en(static_cast<gpio_num_t>(pin));
+    }
+  }
 #endif
 }
