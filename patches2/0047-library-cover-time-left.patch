+uint32_t RecentBookProgress::loadCachedEpubTimeLeft(const RecentBook& book) {
+  const float progress = loadCachedEpubPercent(book);
+  if (progress < 0.5f || progress >= 99.5f) return 0;
+  const auto cachePath = Epub::cachePathForFilePath(book.path, "/.crosspoint");
+  const std::lock_guard<std::mutex> lock(percentCacheMutex);
+  auto* entry = findPercent(cachePath);
+  if (!entry) return 0;  // The progress cache was invalidated between reads.
+  if (!entry->timeLeftLoaded) {
+    const auto resolved = Epub::resolveCachePathForFilePath(book.path, "/.crosspoint");
+    const auto stats = BookReadingStats::load(resolved);
+    entry->timeLeft = stats.isCompleted ? 0 : stats.estimatedTimeLeftSeconds;
+    entry->timeLeftLoaded = true;
+  }
+  return entry->timeLeft;
+}
+
+void RecentBookProgress::rememberEpubTimeLeft(const std::string& cachePath, const uint32_t seconds) {
+  const std::lock_guard<std::mutex> lock(percentCacheMutex);
+  if (auto* entry = findPercent(cachePath)) {
+    entry->timeLeft = seconds;
+    entry->timeLeftLoaded = true;
+  }
+}
+
+void RecentBookProgress::invalidateEpubTimeLeft(const std::string& bookPath) {
+  const auto cachePath = Epub::cachePathForFilePath(bookPath, "/.crosspoint");
+  const std::lock_guard<std::mutex> lock(percentCacheMutex);
+  if (auto* entry = findPercent(cachePath)) entry->timeLeftLoaded = false;
+}
