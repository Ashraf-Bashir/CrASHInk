 ## [Unreleased]

+
+- Image refresh blanks each image separately, keeping text between inline images visible while images are prepared for display. Pending images use an empty background instead of a temporary box border.

 - Saved highlight handles can extend or shorten across adjacent pages in the same chapter; edge dragging loads the actual page and saves once on release.

diff --git a/lib/Epub/Epub/Page.h b/lib/Epub/Epub/Page.h
--- a/lib/Epub/Epub/Page.h
+++ b/lib/Epub/Epub/Page.h
@@ -222,6 +222,34 @@
       return element->getTag() == TAG_PageImage &&
              static_cast<const PageImage&>(*element).getImageBlock().needsDecode();
     });
+  }
+
+  // Visit individual image rectangles without collecting/merging them. The
+  // space between separate inline images can contain readable page text.
+  template <typename Callback>
+  bool forEachImageRect(Callback&& visit) const {
+    bool found = false;
+    for (const auto& element : elements) {
+      if (element->getTag() != TAG_PageImage) continue;
+      const auto& image = static_cast<const PageImage&>(*element);
+      const auto& block = image.getImageBlock();
+      if (block.getWidth() <= 0 || block.getHeight() <= 0) continue;
+      visit(image.xPos, image.yPos, block.getWidth(), block.getHeight());
+      found = true;
+    }
+    return found;
+  }
+
+  // Total area of all images on the page, in pixels (overlaps counted twice; good enough for a size test).
+  int32_t imageArea() const {
+    int32_t area = 0;
+    for (const auto& el : elements) {
+      if (el->getTag() == TAG_PageImage) {
+        const auto& block = static_cast<const PageImage&>(*el).getImageBlock();
+        area += static_cast<int32_t>(block.getWidth()) * block.getHeight();
+      }
+    }
+    return area;
   }

   // Get bounding box of all images on the page (union of image rects)
