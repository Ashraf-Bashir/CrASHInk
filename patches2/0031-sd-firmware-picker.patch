+void FileBrowserActivity::loadFirmwareFiles() {
+  files.clear();
+  auto root = Storage.open(basepath.c_str());
+  if (!root || !root.isDirectory() || !fileNameBuffer) return;
+
+  struct FirmwareEntry {
+    std::string name;
+    uint32_t modified;
+  };
+  std::vector<FirmwareEntry> entries;
+  for (auto file = root.openNextFile(); file; file = root.openNextFile()) {
+    file.getName(fileNameBuffer.get(), NAME_BUFFER_SIZE);
+    if (acceptFirmware(fileNameBuffer.get(), file.isDirectory())) {
+      if (entries.size() == static_cast<size_t>(INT16_MAX) ||
+          !hasHeapForFileEntryAppend(entries, std::strlen(fileNameBuffer.get()))) {
+        fileListMemoryLimited = true;
+        return;
+      }
+      const auto modified = file.modificationTime();
+      entries.push_back({fileNameBuffer.get(), modified != 0 ? modified : file.creationTime()});
+    }
+    file.close();
+  }
+  if (FsHelpers::directoryIterationFailed(root)) {
+    fileListReadFailed = true;
+    return;
+  }
+  root.close();
+
+  std::sort(entries.begin(), entries.end(), [](const FirmwareEntry& a, const FirmwareEntry& b) {
+    if (a.modified != b.modified) return a.modified > b.modified;
+    return FsHelpers::naturalLess(a.name, b.name);
+  });
+  const auto bytes = entries.size() * sizeof(std::string);
+  if (ESP.getMaxAllocHeap() < bytes + FILE_BROWSER_APPEND_MIN_MAX_ALLOC_AFTER_ALLOC) {
+    fileListMemoryLimited = true;
+    return;
+  }
+  files.reserve(entries.size());
+  for (auto& entry : entries) files.push_back(std::move(entry.name));
+}
