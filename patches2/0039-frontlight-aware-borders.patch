+// Keep the active viewport and physical mask in sync with emitted light.
+bool updateLightLeakBorders() {
+  static std::array<uint8_t, 4> applied{};
+  std::array<uint8_t, 4> desired{};
+  if (Frontlight.present() && Frontlight.isOn() && Frontlight.brightness() > 0) {
+    desired = {SETTINGS.lightLeakTop, SETTINGS.lightLeakRight, SETTINGS.lightLeakBottom, SETTINGS.lightLeakLeft};
+  }
+  if (desired == applied) return false;
+
+  RenderLock lock;
+  display.waitRefreshComplete();
+  // Overlay redraws keep their backdrop. Clear the old mask before exposing
+  // those pixels so a light toggle also removes the border beneath the panel.
+  display.maskLightLeakBorder(display.getFrameBuffer(), 0, display.getDisplayHeight(), !display.isInverted());
+  renderer.setLightLeakBorder(desired[0], desired[1], desired[2], desired[3]);
+  applied = desired;
+  return true;
+}
