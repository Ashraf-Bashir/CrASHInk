+static unsigned long& inactivityTimestamp() {
+  static unsigned long lastActivityTime = millis();
+  return lastActivityTime;
+}
+
+static bool autoSleepDeadlineReached(const unsigned long now, const unsigned long timeoutMs) {
+  return timeoutMs > 0 && !buttonShortcutController.isQuickLocked() && !gpio.isPressed(HalGPIO::BTN_POWER) &&
+         now - inactivityTimestamp() >= timeoutMs;
+}
+
+bool shouldStopLibraryScanForSleep(const bool touchActivity) {
+  auto& lastActivityTime = inactivityTimestamp();
+  const auto now = millis();
+  if (touchActivity || gpio.wasAnyPressed() || gpio.wasAnyReleased()) lastActivityTime = now;
+  return autoSleepDeadlineReached(now, SETTINGS.getSleepTimeoutMs());
+}
