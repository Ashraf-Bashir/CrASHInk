+class OpenedBooks {
+ public:
+  bool open();
+  void close();
+  uint32_t count() const { return rows; }
+  bool read(uint32_t row, std::string& path);
+  static bool exists();
+  using PathAt = const std::string& (*)(uint32_t row, const void* context);
+  static bool seed(uint32_t count, PathAt pathAt, const void* context);
+  static bool touch(const std::string& path);
+  static bool remove(const std::string& path);
+  static bool rename(const std::string& before, const std::string& after);
+
+ private:
+  FsFile index;
+  uint32_t rows = 0;
+};
+}  // namespace library
