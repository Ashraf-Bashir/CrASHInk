+++ b/test/library_thumbnails/worker_stubs/freertos/task.h
@@ -0,0 +1,27 @@
+#pragma once
+#include "FreeRTOS.h"
+#include <condition_variable>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+struct NativeTask { std::mutex lock; std::condition_variable cv; unsigned notifications = 0; std::thread thread; };
+using TaskHandle_t = NativeTask*;
+inline thread_local NativeTask* currentTask = nullptr;
+inline std::vector<std::unique_ptr<NativeTask>> nativeTasks;
+inline bool failTaskCreate = false;
+inline int xTaskCreate(void (*entry)(void*), const char*, uint32_t, void* context, unsigned, TaskHandle_t* handle) {
+  if (failTaskCreate) return 0;
+  auto task = std::make_unique<NativeTask>(); *handle = task.get();
+  auto* ptr = task.get(); nativeTasks.push_back(std::move(task));
+  ptr->thread = std::thread([=] { currentTask = ptr; entry(context); }); return pdPASS;
+}
+inline void xTaskNotifyGive(TaskHandle_t task) { std::lock_guard<std::mutex> guard(task->lock); ++task->notifications; task->cv.notify_one(); }
+inline unsigned ulTaskNotifyTake(int, uint32_t) {
+  std::unique_lock<std::mutex> guard(currentTask->lock);
+  currentTask->cv.wait(guard, [] { return currentTask->notifications != 0; });
+  const auto count = currentTask->notifications; currentTask->notifications = 0; return count;
+}
+inline void vTaskDelay(unsigned) { std::this_thread::yield(); }
+inline void vTaskDelete(TaskHandle_t) {}
+inline void joinNativeTasks() { for (auto& task : nativeTasks) if (task->thread.joinable()) task->thread.join(); nativeTasks.clear(); }
