@@ -0,0 +1,18 @@
+#pragma once
+#include <algorithm>
+
+// Shared cover proportions/insets for Home and Library. Keep bitmap generation
+// at the exact painted size to avoid resampling already-dithered artwork.
+namespace CoverGridLayout {
+inline constexpr int Columns = 3;
+inline constexpr int CellInset = 6;
+struct Size {
+  int width;
+  int height;
+};
+inline Size coverSize(const int availableWidth, const int rowHeight) {
+  const int maxWidth = availableWidth / Columns - 2 * CellInset;
+  const int height = std::max(1, std::min(rowHeight - 2 * CellInset, maxWidth * 3 / 2));
+  return {std::max(1, height * 2 / 3), height};
+}
+}  // namespace CoverGridLayout
