@@ -0,0 +1,234 @@
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "components/CoverGridLayout.h"
+#define LOG_ERR(...) ((void)0)
+struct RecentBook {
+  enum class CoverState { Unknown, Missing };
+  std::string path, title, author, coverBmpPath;
+  CoverState coverState = CoverState::Unknown;
+};
+std::vector<RecentBook> recents;
+const RecentBook* recentBookForPath(const std::string& path) {
+  for (auto& book : recents)
+    if (book.path == path) return &book;
+  return nullptr;
+}
+struct CrossPointSettings {
+  enum { RECENT_BOOKS_LIST, RECENT_BOOKS_GRID };
+  int libraryView = 0, recentBooksView = 0, libraryUseMetadata = 1;
+} SETTINGS;
+namespace FsHelpers {
+bool hasEpubExtension(const std::string& path) { return path.ends_with(".epub"); }
+bool hasXtcExtension(const std::string& path) { return path.ends_with(".xtc"); }
+}  // namespace FsHelpers
+struct Epub {
+  static std::string cachePathForFilePath(const std::string& path, const std::string& dir) { return dir + path; }
+};
+struct Xtc {
+  std::string cache;
+  Xtc(const std::string& path, const std::string& dir) : cache(dir + path) {}
+  std::string getThumbBmpPath(int w, int h) const {
+    return cache + "/thumb_" + std::to_string(w) + "x" + std::to_string(h) + ".bmp";
+  }
+};
+std::set<std::string> files;
+bool hasValidGridThumb(const std::string& path, int, int) { return files.contains(path); }
+bool libraryCheckedThisBoot = false, libraryChangedThisBoot = false;
+uint64_t warmedCoverView = 0;
+namespace library {
+class LibraryChangeProbe {
+ public:
+  enum class State { Idle, ReadingIndex, Walking, Unchanged, Changed, Unavailable };
+  State next = State::Walking;
+  int steps = 0, begins = 0;
+  void reset() {}
+  template <typename T>
+  void begin(const T&) {
+    ++begins;
+  }
+  template <typename T>
+  State step(T&) {
+    ++steps;
+    return next;
+  }
+};
+bool dirty = false;
+bool libraryIndexNeedsRefresh() { return dirty; }
+const char* libraryIndexPath() { return "/library.idx"; }
+}  // namespace library
+struct FakeIndex {
+  struct Header {
+    uint8_t metadataEnabled = 1;
+  } head;
+  bool opened = false, valid = true;
+  void close() { opened = false; }
+  bool isOpen() const { return opened; }
+  bool open(const char*) { return opened = valid; }
+  bool openForReconciliation(const char*) { return opened = valid; }
+  const Header& header() const { return head; }
+};
+struct FakeWorker {
+  std::vector<int> jobs;
+  bool running = false, complete = true;
+  int row = -1;
+  std::string thumb;
+  bool busy() const { return running; }
+  bool submit(const char*, const char* dest, int, int, int next) {
+    if (running) return false;
+    running = true;
+    row = next;
+    thumb = dest;
+    jobs.push_back(next);
+    return true;
+  }
+  bool collect(int& result, bool& changed) {
+    if (!running || !complete) return false;
+    files.insert(thumb);
+    result = row;
+    changed = true;
+    running = false;
+    return true;
+  }
+};
+struct LibraryActivity {
+  enum class Sort { RecentlyRead, Title };
+  Sort sort = Sort::Title;
+  FakeIndex index;
+  FakeWorker coverWorker;
+  struct {
+    void invalidate(int = -1) {}
+  } paintedCovers;
+  uint16_t dirtyCoverSlots = 0, failedCoverSlots = 0;
+  bool filterWork = false;
+  uint64_t viewCacheKey(bool) const { return 123; }
+  library::LibraryChangeProbe changeProbe;
+  bool changeCheckStarted = false, refreshCheckFailed = false, refreshSuggested = false;
+  bool scanFailed = false, uiReady = true, scanCancelledThisVisit = false;
+  int scans = 0, filters = 0, paints = 0;
+  int gridCoverWidth = 100, gridCoverHeight = 150, gridPageStart = 0, loadedGridPageStart = -1, nextGridCoverRow = -1;
+  int prefetchCoverRow = -1, prefetchStopRow = -1;
+  bool prefetchFinished = false;
+  std::vector<RecentBook> books;
+  int rowCount() const { return books.size(); }
+  bool readBook(int row, RecentBook& book) {
+    if (row < 0 || row >= rowCount()) return false;
+    book = books[row];
+    return true;
+  }
+  void applyFilter() { ++filters; }
+  void rebuildIndex(bool) {
+    ++scans;
+    library::dirty = false;
+    libraryCheckedThisBoot = libraryChangedThisBoot = false;
+    warmedCoverView = 0;
+    index.opened = true;
+    applyFilter();
+  }
+  void requestUpdate() { ++paints; }
+  bool gridEnabled() const;
+  void loadGridPageCovers();
+  bool loadGridCover(int row);
+  void refreshIndexIfNeeded(bool showScanning = false);
+  void pollLibraryChanges();
+};
+#include "LibraryThumbnailMethods.inc"
+struct LibraryThumbnails : testing::Test {
+  LibraryActivity screen;
+  void SetUp() override {
+    SETTINGS = {};
+    SETTINGS.libraryView = CrossPointSettings::RECENT_BOOKS_GRID;
+    library::dirty = false;
+    recents.clear();
+    files.clear();
+    for (int i = 0; i < 30; ++i) {
+      RecentBook b;
+      b.path = "/book" + std::to_string(i) + ".epub";
+      screen.books.push_back(b);
+    }
+  }
+  void tick(int count = 100) {
+    while (count--) screen.loadGridPageCovers();
+  }
+};
+TEST_F(LibraryThumbnails, FixedThreeColumnsAndNineBooksPerPage) {
+  EXPECT_EQ(gridColumns(), 3);
+  EXPECT_EQ(gridPageSize(), 9);
+}
+TEST_F(LibraryThumbnails, VisiblePageFirstThenPreloadsAllOtherPagesWithoutAddingRecents) {
+  tick();
+  ASSERT_EQ(screen.coverWorker.jobs.size(), 30u);
+  for (int i = 0; i < 30; ++i) EXPECT_EQ(screen.coverWorker.jobs[i], i);
+  EXPECT_TRUE(recents.empty());
+  EXPECT_EQ(screen.paints, 1);
+}
+TEST_F(LibraryThumbnails, BusyConversionNeverWaitsOrQueuesMoreJobs) {
+  screen.coverWorker.complete = false;
+  tick();
+  EXPECT_EQ(screen.coverWorker.jobs.size(), 1u);
+  EXPECT_EQ(screen.paints, 0);
+  screen.gridPageStart = 18;
+  screen.nextGridCoverRow = -1;
+  screen.loadedGridPageStart = -1;
+  screen.prefetchCoverRow = -1;
+  screen.prefetchFinished = false;
+  screen.coverWorker.complete = true;
+  tick(1);
+  ASSERT_EQ(screen.coverWorker.jobs.size(), 2u);
+  EXPECT_EQ(screen.coverWorker.jobs[1], 18);
+}
+TEST_F(LibraryThumbnails, DiskCacheAvoidsReconversionAfterReopening) {
+  tick();
+  screen = LibraryActivity{};
+  for (int i = 0; i < 30; ++i) {
+    RecentBook b;
+    b.path = "/book" + std::to_string(i) + ".epub";
+    screen.books.push_back(b);
+  }
+  tick();
+  EXPECT_TRUE(screen.coverWorker.jobs.empty());
+}
+TEST_F(LibraryThumbnails, ListViewDoesNotGenerateCoversAndRecentViewIsIndependent) {
+  SETTINGS.libraryView = CrossPointSettings::RECENT_BOOKS_LIST;
+  tick();
+  EXPECT_TRUE(screen.coverWorker.jobs.empty());
+  screen.sort = LibraryActivity::Sort::RecentlyRead;
+  SETTINGS.recentBooksView = CrossPointSettings::RECENT_BOOKS_GRID;
+  EXPECT_TRUE(screen.gridEnabled());
+}
+TEST_F(LibraryThumbnails, TextAndKnownMissingCoversAreNotSubmitted) {
+  screen.books[0].path = "/note.txt";
+  EXPECT_FALSE(screen.loadGridCover(0));
+  auto missing = screen.books[1];
+  missing.coverState = RecentBook::CoverState::Missing;
+  recents.push_back(missing);
+  EXPECT_FALSE(screen.loadGridCover(1));
+  EXPECT_TRUE(screen.coverWorker.jobs.empty());
+}
+TEST_F(LibraryThumbnails, ValidSavedIndexDoesNotRescanOnLibraryVisits) {
+  screen.refreshIndexIfNeeded();
+  screen.index.close();
+  screen.refreshIndexIfNeeded();
+  EXPECT_EQ(screen.scans, 0);
+  EXPECT_EQ(screen.filters, 2);
+}
+TEST_F(LibraryThumbnails, KnownChangesOfferRefreshWithoutRebuild) {
+  library::dirty = true;
+  screen.refreshIndexIfNeeded();
+  EXPECT_TRUE(screen.refreshSuggested);
+  EXPECT_EQ(screen.scans, 0);
+}
+TEST_F(LibraryThumbnails, ProbeWaitsForFirstPaintAndOffersOptionalRefresh) {
+  screen.uiReady = false;
+  screen.pollLibraryChanges();
+  EXPECT_EQ(screen.changeProbe.steps, 0);
+  screen.uiReady = true;
+  screen.changeProbe.next = library::LibraryChangeProbe::State::Changed;
+  screen.pollLibraryChanges();
+  EXPECT_TRUE(screen.refreshSuggested);
+  EXPECT_EQ(screen.scans, 0);
+}
