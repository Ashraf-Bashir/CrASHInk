index 0000000000000000000000000000000000000000..4260f1d324f942edcd7f40eae79d2ffd1d5cd9a8
--- /dev/null
+++ b/test/library_thumbnails/LibraryTouchTest.cpp
@@ -0,0 +1,148 @@
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "LibraryInputBuffer.h"
+struct Snapshot {
+  bool touchPressed = false, touchReleased = false, longPress = false;
+  int touchX = -1, touchY = -1;
+};
+struct MappedInputManager {
+  enum class SwipeDir { None, Left, Right, Up, Down };
+  SwipeDir swipe = SwipeDir::None;
+  bool down = false, held = false, released = false;
+  int x = 100, y = 100;
+  Snapshot snap;
+  bool wasScreenTouchDown(int& px, int& py) {
+    px = x;
+    py = y;
+    return down;
+  }
+  bool isScreenTouchHeld(int& px, int& py) {
+    px = x;
+    py = y;
+    return held;
+  }
+  bool wasScreenTouchReleased() { return released; }
+  SwipeDir wasSwipe() { return swipe; }
+};
+Snapshot touchSnapshotFrom(const MappedInputManager& input) { return input.snap; }
+struct LibraryActivity {
+  MappedInputManager mappedInput;
+  bool touchTracking = false, touchMoved = false, touchCancelled = false;
+  int touchStartX = 0, touchStartY = 0, touchLastX = 0, touchLastY = 0;
+  LibraryInputBuffer pending;
+  bool gridEnabled() const { return true; }
+  void queueInput(LibraryInputBuffer::Type type, int x = -1, int y = -1) {
+    pending.push({type, static_cast<int16_t>(x), static_cast<int16_t>(y)});
+  }
+  void captureTouch();
+};
+#include "LibraryTouchMethods.inc"
+using Type = LibraryInputBuffer::Type;
+TEST(LibraryTouch, FastSwipesWinOverTapAndLongPressEvenWithoutHeldSamples) {
+  for (auto direction : {MappedInputManager::SwipeDir::Left, MappedInputManager::SwipeDir::Right,
+                         MappedInputManager::SwipeDir::Up, MappedInputManager::SwipeDir::Down}) {
+    LibraryActivity screen;
+    auto& input = screen.mappedInput;
+    input.down = true;
+    input.snap = {true, false, false, 100, 100};
+    screen.captureTouch();
+    screen.pending.clear();
+    input.down = false;
+    input.released = true;
+    input.swipe = direction;
+    input.snap = {false, true, true, 100, 100};
+    screen.captureTouch();
+    LibraryInputBuffer::Event event;
+    ASSERT_TRUE(screen.pending.pop(event));
+    EXPECT_EQ(event.type, Type::TouchRelease);
+    EXPECT_EQ(event.x, -1);
+    ASSERT_TRUE(screen.pending.pop(event));
+    EXPECT_NE(event.type, Type::TouchRelease);
+    EXPECT_NE(event.type, Type::TouchLongPress);
+    EXPECT_FALSE(screen.pending.pop(event));
+  }
+}
+TEST(LibraryTouch, SlowHorizontalDragPagesAndCannotOpenCover) {
+  LibraryActivity screen;
+  auto& input = screen.mappedInput;
+  input.down = true;
+  input.held = true;
+  input.snap = {true, false, false, 150, 100};
+  input.x = 150;
+  screen.captureTouch();
+  input.down = false;
+  input.x = 50;
+  input.snap = {};
+  screen.captureTouch();
+  screen.pending.clear();
+  input.held = false;
+  input.released = true;
+  input.snap = {false, true, false, 150, 100};
+  screen.captureTouch();
+  LibraryInputBuffer::Event event;
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.type, Type::TouchRelease);
+  EXPECT_EQ(event.x, -1);
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.type, Type::SwipeLeft);
+}
+TEST(LibraryTouch, MovingAwayAndBackCancelsTapButStationaryHoldKeepsMenu) {
+  LibraryActivity screen;
+  auto& input = screen.mappedInput;
+  input.down = true;
+  input.held = true;
+  screen.captureTouch();
+  input.down = false;
+  input.x = 140;
+  screen.captureTouch();
+  input.x = 100;
+  screen.captureTouch();
+  input.held = false;
+  input.released = true;
+  input.snap = {false, true, false, 100, 100};
+  screen.captureTouch();
+  LibraryInputBuffer::Event event;
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.x, -1);
+  screen = LibraryActivity{};
+  screen.mappedInput.released = true;
+  screen.mappedInput.snap = {false, true, true, 100, 100};
+  screen.captureTouch();
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.type, Type::TouchLongPress);
+  EXPECT_EQ(event.x, 100);
+}
+
+TEST(LibraryTouch, ReleaseAfterEarlierFlickStaysCancelledUntilFreshContact) {
+  LibraryActivity screen;
+  auto& input = screen.mappedInput;
+  input.down = true;
+  input.snap = {true, false, false, 100, 100};
+  screen.captureTouch();
+  input.down = false;
+  input.swipe = MappedInputManager::SwipeDir::Left;
+  input.snap = {};
+  screen.captureTouch();
+  screen.pending.clear();
+  input.swipe = MappedInputManager::SwipeDir::None;
+  input.released = true;
+  input.snap = {false, true, false, 100, 100};
+  screen.captureTouch();
+  LibraryInputBuffer::Event event;
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.x, -1);
+  input.down = true;
+  input.released = false;
+  input.snap = {true, false, false, 100, 100};
+  screen.captureTouch();
+  screen.pending.clear();
+  input.down = false;
+  input.released = true;
+  input.snap = {false, true, false, 100, 100};
+  screen.captureTouch();
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.x, 100);
+}
diff --git a/test/library_thumbnails/OpenedBooksTest.cpp b/test/library_thumbnails/OpenedBooksTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a53ddc631714589fc8ea3801c8e007d6685479b0
--- /dev/null
+++ b/test/library_thumbnails/OpenedBooksTest.cpp
@@ -0,0 +1,105 @@
+#include <OpenedBooks.h>
+#include <gtest/gtest.h>
+
+#include <string>
+#include <vector>
+using library::OpenedBooks;
+namespace {
+std::vector<std::string> all() {
+  OpenedBooks file;
+  if (!file.open()) return {};
+  std::vector<std::string> result;
+  for (uint32_t i = 0; i < file.count(); ++i) {
+    std::string path;
+    EXPECT_TRUE(file.read(i, path));
+    result.push_back(path);
+  }
+  file.close();
+  return result;
+}
+}  // namespace
+TEST(OpenedBooks, KeepsMoreThanEighteenAndPromotesWithoutDuplicates) {
+  fake::reset();
+  for (int i = 0; i < 100; ++i) ASSERT_TRUE(OpenedBooks::touch("/book" + std::to_string(i) + ".epub"));
+  auto paths = all();
+  ASSERT_EQ(paths.size(), 100u);
+  EXPECT_EQ(paths.front(), "/book99.epub");
+  EXPECT_EQ(paths.back(), "/book0.epub");
+  ASSERT_TRUE(OpenedBooks::touch("/book4.epub"));
+  paths = all();
+  ASSERT_EQ(paths.size(), 100u);
+  EXPECT_EQ(paths[0], "/book4.epub");
+  EXPECT_EQ(paths[1], "/book99.epub");
+  fake::resetIoCounters();
+  OpenedBooks file;
+  ASSERT_TRUE(file.open());
+  std::string path;
+  ASSERT_TRUE(file.read(85, path));
+  EXPECT_LE(fake::reads, 4u);  // header, one entry, path length and path; no whole-history scan.
+  file.close();
+}
+TEST(OpenedBooks, CurrentBookMetadataRefreshDoesNotRewriteOrdering) {
+  fake::reset();
+  ASSERT_TRUE(OpenedBooks::touch("/a.epub"));
+  const auto writes = fake::writesByPath;
+  ASSERT_TRUE(OpenedBooks::touch("/a.epub"));
+  EXPECT_EQ(fake::writesByPath, writes);
+}
+TEST(OpenedBooks, RenameKeepsPositionAndRemoveDoesNotAffectOtherBooks) {
+  fake::reset();
+  for (const char* p : {"/a.epub", "/b.epub", "/c.epub"}) ASSERT_TRUE(OpenedBooks::touch(p));
+  ASSERT_TRUE(OpenedBooks::rename("/b.epub", "/renamed.epub"));
+  EXPECT_EQ(all(), (std::vector<std::string>{"/c.epub", "/renamed.epub", "/a.epub"}));
+  ASSERT_TRUE(OpenedBooks::remove("/renamed.epub"));
+  EXPECT_EQ(all(), (std::vector<std::string>{"/c.epub", "/a.epub"}));
+}
+TEST(OpenedBooks, FailedWriteAndFailedPublicationRetainPreviousSnapshot) {
+  fake::reset();
+  ASSERT_TRUE(OpenedBooks::touch("/a.epub"));
+  fake::failWritePath = "/.crosspoint/opened.tmp";
+  EXPECT_FALSE(OpenedBooks::touch("/b.epub"));
+  EXPECT_EQ(all(), (std::vector<std::string>{"/a.epub"}));
+  fake::failRenameToPath = "/.crosspoint/opened.idx";
+  EXPECT_FALSE(OpenedBooks::touch("/b.epub"));
+  EXPECT_EQ(all(), (std::vector<std::string>{"/a.epub"}));
+  ASSERT_TRUE(OpenedBooks::touch("/b.epub"));
+  EXPECT_EQ(all(), (std::vector<std::string>{"/b.epub", "/a.epub"}));
+}
+TEST(OpenedBooks, BackupRecoversInterruptedPublicationAndCorruptHeader) {
+  fake::reset();
+  ASSERT_TRUE(OpenedBooks::touch("/a.epub"));
+  ASSERT_TRUE(OpenedBooks::touch("/b.epub"));
+  fake::files["/.crosspoint/opened.idx"]->bytes.resize(3);
+  EXPECT_EQ(all(), (std::vector<std::string>{"/a.epub"}));
+  ASSERT_TRUE(OpenedBooks::touch("/c.epub"));
+  EXPECT_EQ(all(), (std::vector<std::string>{"/c.epub", "/a.epub"}));
+}
+TEST(OpenedBooks, RejectsInvalidPathAndCorruptPathPayload) {
+  fake::reset();
+  EXPECT_FALSE(OpenedBooks::touch("relative.epub"));
+  EXPECT_FALSE(OpenedBooks::touch("/" + std::string(511, 'x')));
+  ASSERT_TRUE(OpenedBooks::touch("/a.epub"));
+  fake::files["/.crosspoint/opened.paths"]->bytes.back() ^= 1;
+  OpenedBooks file;
+  ASSERT_TRUE(file.open());
+  std::string path;
+  EXPECT_FALSE(file.read(0, path));
+  EXPECT_TRUE(path.empty());
+  file.close();
+}
+
+TEST(OpenedBooks, MigrationPublishesAllEntriesTogetherAndRetriesAfterFailure) {
+  fake::reset();
+  const std::vector<std::string> paths = {"/new.epub", "/middle.epub", "/old.epub"};
+  auto pathAt = [](uint32_t row, const void* context) -> const std::string& {
+    return (*static_cast<const std::vector<std::string>*>(context))[row];
+  };
+  fake::failWritePath = "/.crosspoint/opened.tmp";
+  EXPECT_FALSE(OpenedBooks::seed(paths.size(), pathAt, &paths));
+  EXPECT_FALSE(OpenedBooks::exists());
+  ASSERT_TRUE(OpenedBooks::seed(paths.size(), pathAt, &paths));
+  EXPECT_EQ(all(), paths);
+  ASSERT_TRUE(OpenedBooks::touch("/next.epub"));
+  ASSERT_TRUE(OpenedBooks::seed(paths.size(), pathAt, &paths));
+  EXPECT_EQ(all().front(), "/next.epub");
+}
