new file mode 100644
--- /dev/null
+++ b/src/activities/library/LibraryCoverWorker.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+// One disk-only thumbnail conversion at a time. Never reads the UI/index,
+// mutates recent books, touches fonts, or calls the renderer from its task.
+class LibraryCoverWorker {
+ public:
+  ~LibraryCoverWorker() { stop(); }
+  bool start();
+  void stop();
+  bool submit(const char* book, const char* thumb, int width, int height, int row);
+  bool collect(int& row, bool& changed);
+  bool busy() const;
+  bool isWriting(const char* thumb) const;
+
+ private:
+  enum class State : uint8_t { Idle, Running, Done };
+  std::atomic<State> state{State::Idle};
+  std::atomic<bool> stopping{false};
+  std::atomic<bool> exited{true};
+  TaskHandle_t task = nullptr;
+  // Fixed job storage rather than a growing work queue (~1 KiB plus one
+  // 6 KiB worker stack). The main loop owns writes while state is Idle.
+  char bookPath[512]{};
+  char thumbPath[512]{};
+  int width = 0, height = 0, row = -1;
+  bool changed = false;
+  static void trampoline(void* context);
+  void run();
+  bool generate();
+};
