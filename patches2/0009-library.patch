+  uint8_t libraryUseMetadata = 1, libraryShowSeries = 1, libraryShowGenre = 1, libraryHideFinishedBooks = 0;
+  uint8_t libraryShowEpub = 1, libraryShowXtc = 1, libraryShowTxt = 1, libraryShowMarkdown = 1;
