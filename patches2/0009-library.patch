+  bool wasTapInRect(int a, int b, int w, int h) const { return tapped && x >= a && x < a + w && y >= b && y < b + h; }
+  bool wasReleased(Button b) const { return (b == Button::Back && back) || (b == Button::Confirm && confirm); }
