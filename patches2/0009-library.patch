+#include <cstdint>
+namespace library {
+// Small disposable snapshots: at most 4096 filter bits or 36 recent-row bytes.
+// They contain no book text/covers and are invalidated independently of the index.
+bool loadViewCache(bool recent, uint64_t key, uint16_t sourceCount, uint16_t& count, void* data, size_t bytes,
+                   uint16_t* processed = nullptr);
+bool saveViewCache(bool recent, uint64_t key, uint16_t sourceCount, uint16_t count, const void* data, size_t bytes,
+                   uint16_t processed = UINT16_MAX);
+void invalidateViewCache();
