@@ -299,3 +299,54 @@ TEST(LibraryIndexFile, DisplayTextAcceptsMissingMetadataAndRejectsMalformedField
   ASSERT_TRUE(index.open("/library.clx"));
   EXPECT_FALSE(index.readDisplayText(record, title, author));
 }
+
+TEST(LibraryIndexFile, OrdinaryPathLookupsReuseFolderCheckpointsAndResetOnReopen) {
+  library::ClixHeader header{};
+  std::memcpy(header.magic, library::CLIX_MAGIC, sizeof(header.magic));
+  header.formatVersion = library::CLIX_FORMAT_VERSION;
+  header.foldVersion = library::CLIX_FOLD_VERSION;
+  header.bookCount = 1;
+  header.folderCount = 1024;
+  std::vector<uint8_t> folders;
+  for (int i = 0; i < header.folderCount; ++i) {
+    const std::string path = "/f" + std::to_string(i);
+    folders.push_back(static_cast<uint8_t>(path.size()));
+    folders.insert(folders.end(), path.begin(), path.end());
+  }
+  library::layoutSections(header, folders.size(), 1);
+  std::vector<uint8_t> bytes(header.selfSize, 0);
+  std::memcpy(bytes.data(), &header, sizeof(header));
+  std::memcpy(bytes.data() + header.folderStart, folders.data(), folders.size());
+  bytes[header.nameStart] = 'b';
+  Storage.setFile("/folders.clx", bytes);
+  library::LibraryIndexFile index;
+  ASSERT_TRUE(index.open("/folders.clx"));
+  library::ClixRecord record{};
+  record.folderId = 1023;
+  record.nameLen = 1;
+  // readName's blob starts after the stored path hash.
+  header.nameLen = sizeof(uint64_t) + 1;
+  library::layoutSections(header, folders.size(), header.nameLen);
+  bytes.resize(header.selfSize);
+  std::memcpy(bytes.data(), &header, sizeof(header));
+  std::memcpy(bytes.data() + header.folderStart, folders.data(), folders.size());
+  bytes[header.nameStart + sizeof(uint64_t)] = 'b';
+  index.close();
+  Storage.setFile("/folders.clx", bytes);
+  ASSERT_TRUE(index.open("/folders.clx"));
+  std::string path;
+  ASSERT_TRUE(index.readPath(record, path));
+  EXPECT_EQ(path, "/f1023/b");
+  HalFile::readCalls = 0;
+  for (int i = 0; i < 9; ++i) ASSERT_TRUE(index.readPath(record, path));
+  // At most stride(8) folder lengths + folder text + filename per lookup,
+  // rather than 1024 folder lengths each time.
+  EXPECT_LE(HalFile::readCalls, 9u * 11u);
+  index.close();
+  ASSERT_TRUE(index.open("/folders.clx"));
+  HalFile::readCalls = 0;
+  ASSERT_TRUE(index.readPath(record, path));
+  EXPECT_GT(HalFile::readCalls, 0u);
+  // Checkpoints are rebuilt with sequential sector reads, not 1024 tiny reads.
+  EXPECT_LE(HalFile::readCalls, 32u);
+}
