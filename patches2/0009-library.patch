+
+bool LibraryActivity::paintGridCover(fui::DrawTarget& target, const fui::Rect rect, const int slot) {
+  const auto ink = fui::Paint::solid(fui::Color::Black);
+  // Same two-pixel shadow and one-pixel square frame as Home.
+  target.fill(fui::Rect{rect.right(), static_cast<int16_t>(rect.y + 2), 2, rect.height}, ink);
+  target.fill(fui::Rect{static_cast<int16_t>(rect.x + 2), rect.bottom(), rect.width, 2}, ink);
+  target.fill(rect, fui::Paint::solid(fui::Color::White));
+  bool drawn = false;
+  const bool available = readBook(gridPageStart + slot, rowScratch);
+  if (available) {
+    const auto path = gridThumbPath(rowScratch, rect.width, rect.height);
+    // The worker publishes only closed files. Never render a partially written BMP.
+    if (!path.empty() && !(failedCoverSlots & (1u << slot)) && !coverWorker.isWriting(path.c_str())) {
+      drawn = paintedCovers.paint(rect, slot, path, false);
+    }
+  }
+  if (!drawn) {
+    failedCoverSlots |= static_cast<uint16_t>(1u << slot);
+    const fui::Rect book{static_cast<int16_t>(rect.x + 7), static_cast<int16_t>(rect.y + 7),
+                         static_cast<int16_t>(std::max(1, rect.width - 14)),
+                         static_cast<int16_t>(std::max(1, rect.height - 14))};
+    target.stroke(book, ink, 1, 2);
+    target.fill(fui::Rect{static_cast<int16_t>(book.x + 6), book.y, 1, book.height}, ink);
+    auto style = placeholderText;
+    style.align = fui::TextAlign::Center;
+    style.maxLines = 5;
+    target.text(fui::Rect{static_cast<int16_t>(book.x + 12), static_cast<int16_t>(book.y + 8),
+                          static_cast<int16_t>(std::max(1, book.width - 20)),
+                          static_cast<int16_t>(std::max(1, book.height - 16))},
+                available ? rowScratch.title.c_str() : tr(STR_LIBRARY_UNAVAILABLE), style);
+  }
+  target.stroke(rect, ink, 1, 0);
