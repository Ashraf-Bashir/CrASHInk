+  ASSERT_TRUE(index.open(INDEX));
+  library::LibraryChangeProbe probe;
+  probe.begin(index);
+  fake::failDirectoryIterationPath = "/";
+  EXPECT_EQ(completeChangeProbe(probe, index), library::LibraryChangeProbe::State::Unavailable);
+}
+TEST_F(LibraryBuilderTest, ChangeProbeYieldsBetweenEntriesAndCanBeCancelled) {
+  initial();
+  LibraryIndexFile index;
+  ASSERT_TRUE(index.open(INDEX));
+  library::LibraryChangeProbe probe;
+  probe.begin(index);
+  fake::resetIoCounters();
+  fake::directoryEntriesByPath.clear();
+  EXPECT_EQ(probe.step(index), library::LibraryChangeProbe::State::ReadingIndex);
