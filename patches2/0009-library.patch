+  EXPECT_FALSE(screen.filterWork);
+  EXPECT_EQ(screen.filteredCount, 0);
+  screen.index.failAt = -1;
+  screen.applyFilter();
+  screen.query = "no-match";
+  screen.applyFilter();
+  screen.advanceFilter();
+  screen.advanceFilter();
+  EXPECT_EQ(screen.filteredCount, 0);
+  EXPECT_FALSE(screen.filterWork);
