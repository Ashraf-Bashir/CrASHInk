+
+TEST(LibraryFilterPacing, WarmViewRestoresCountsAndRowsWithoutReadingAnyBooks) {
+  fake::reset();
+  LibraryActivity cold;
+  cold.index.names = {"target.epub", "other.txt", "target2.epub"};
+  cold.query = "target";
+  cold.applyFilter();
+  while (cold.filterWork) cold.advanceFilter();
