+  warm.index.names = cold.index.names;
+  warm.query = cold.query;
+  warm.applyFilter();
+  EXPECT_FALSE(warm.filterWork);
+  EXPECT_EQ(warm.index.reads, 0);
+  EXPECT_EQ(warm.filteredCount, 2);
+  EXPECT_EQ(warm.filteredSourceRow(0), 0);
+  EXPECT_EQ(warm.filteredSourceRow(1), 2);
+  library::invalidateViewCache();
+  warm.applyFilter();
