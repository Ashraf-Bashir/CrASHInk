+void LibraryActivity::pollLibraryChanges() {
+  // Start after the first library paint. All access shares this activity's render
+  // lock and index handle (SdFat permits only one reader per path).
+  if (!uiReady || refreshSuggested || scanCancelledThisVisit) return;
+  if (library::libraryIndexNeedsRefresh()) {
+    changeProbe.reset();
+    refreshSuggested = true;
+    requestUpdate();
+    return;
+  }
+  if (!changeCheckStarted) {
+    changeCheckStarted = true;
+    if (libraryCheckedThisBoot) {
+      if (libraryChangedThisBoot) {
+        refreshSuggested = true;
+        requestUpdate();
+      }
+      return;
+    }
+    if (!index.isOpen() && !index.open(library::libraryIndexPath())) {
+      refreshSuggested = true;
+      requestUpdate();
+      return;
+    }
+    changeProbe.begin(index);
+  }
+  if (libraryCheckedThisBoot) return;
+  const auto status = changeProbe.step(index);
+  if (status == library::LibraryChangeProbe::State::Unchanged) libraryCheckedThisBoot = true;
+  if (status == library::LibraryChangeProbe::State::Changed ||
+      status == library::LibraryChangeProbe::State::Unavailable) {
+    libraryCheckedThisBoot = true;
+    libraryChangedThisBoot = true;
+    refreshSuggested = true;
+    refreshCheckFailed = status == library::LibraryChangeProbe::State::Unavailable;
+    requestUpdate();
+  }
 }

