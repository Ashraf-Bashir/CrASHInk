+  bool readBook(int row, RecentBook& book) {
+    if (row < 0 || row >= rowCount()) return false;
+    book = books[row];
+    return true;
+  }
+  void applyFilter() { ++filters; }
+  void rebuildIndex(bool) {
+    ++scans;
+    library::dirty = false;
+    libraryCheckedThisBoot = libraryChangedThisBoot = false;
+    warmedCoverView = 0;
+    index.opened = true;
+    applyFilter();
+  }
+  void requestUpdate() { ++paints; }
+  bool gridEnabled() const;
+  void loadGridPageCovers();
+  bool loadGridCover(int row);
+  void refreshIndexIfNeeded(bool showScanning = false);
+  void pollLibraryChanges();
+};
+#include "LibraryThumbnailMethods.inc"
+struct LibraryThumbnails : testing::Test {
+  LibraryActivity screen;
+  void SetUp() override {
+    SETTINGS = {};
+    SETTINGS.libraryView = CrossPointSettings::RECENT_BOOKS_GRID;
+    library::dirty = false;
+    recents.clear();
+    files.clear();
+    for (int i = 0; i < 30; ++i) {
+      RecentBook b;
+      b.path = "/book" + std::to_string(i) + ".epub";
+      screen.books.push_back(b);
+    }
+  }
+  void tick(int count = 100) {
+    while (count--) screen.loadGridPageCovers();
+  }
+};
+TEST_F(LibraryThumbnails, FixedThreeColumnsAndNineBooksPerPage) {
+  EXPECT_EQ(gridColumns(), 3);
+  EXPECT_EQ(gridPageSize(), 9);
+}
+TEST_F(LibraryThumbnails, VisiblePageFirstThenPreloadsAllOtherPagesWithoutAddingRecents) {
+  tick();
+  ASSERT_EQ(screen.coverWorker.jobs.size(), 30u);
+  for (int i = 0; i < 30; ++i) EXPECT_EQ(screen.coverWorker.jobs[i], i);
+  EXPECT_TRUE(recents.empty());
+  EXPECT_EQ(screen.paints, 1);
+}
+TEST_F(LibraryThumbnails, BusyConversionNeverWaitsOrQueuesMoreJobs) {
+  screen.coverWorker.complete = false;
+  tick();
+  EXPECT_EQ(screen.coverWorker.jobs.size(), 1u);
+  EXPECT_EQ(screen.paints, 0);
+  screen.gridPageStart = 18;
+  screen.nextGridCoverRow = -1;
+  screen.loadedGridPageStart = -1;
+  screen.prefetchCoverRow = -1;
+  screen.prefetchFinished = false;
+  screen.coverWorker.complete = true;
+  tick(1);
+  ASSERT_EQ(screen.coverWorker.jobs.size(), 2u);
+  EXPECT_EQ(screen.coverWorker.jobs[1], 18);
+}
+TEST_F(LibraryThumbnails, DiskCacheAvoidsReconversionAfterReopening) {
+  tick();
+  screen = LibraryActivity{};
+  for (int i = 0; i < 30; ++i) {
+    RecentBook b;
+    b.path = "/book" + std::to_string(i) + ".epub";
+    screen.books.push_back(b);
+  }
+  tick();
+  EXPECT_TRUE(screen.coverWorker.jobs.empty());
+}
+TEST_F(LibraryThumbnails, ListViewDoesNotGenerateCoversAndRecentViewIsIndependent) {
+  SETTINGS.libraryView = CrossPointSettings::RECENT_BOOKS_LIST;
+  tick();
+  EXPECT_TRUE(screen.coverWorker.jobs.empty());
+  screen.sort = LibraryActivity::Sort::RecentlyRead;
+  SETTINGS.recentBooksView = CrossPointSettings::RECENT_BOOKS_GRID;
+  EXPECT_TRUE(screen.gridEnabled());
+}
+TEST_F(LibraryThumbnails, TextAndKnownMissingCoversAreNotSubmitted) {
+  screen.books[0].path = "/note.txt";
+  EXPECT_FALSE(screen.loadGridCover(0));
+  auto missing = screen.books[1];
+  missing.coverState = RecentBook::CoverState::Missing;
+  recents.push_back(missing);
+  EXPECT_FALSE(screen.loadGridCover(1));
+  EXPECT_TRUE(screen.coverWorker.jobs.empty());
+}
+TEST_F(LibraryThumbnails, ValidSavedIndexDoesNotRescanOnLibraryVisits) {
+  screen.refreshIndexIfNeeded();
+  screen.index.close();
+  screen.refreshIndexIfNeeded();
+  EXPECT_EQ(screen.scans, 0);
+  EXPECT_EQ(screen.filters, 2);
+}
+TEST_F(LibraryThumbnails, KnownChangesOfferRefreshWithoutRebuild) {
+  library::dirty = true;
+  screen.refreshIndexIfNeeded();
+  EXPECT_TRUE(screen.refreshSuggested);
+  EXPECT_EQ(screen.scans, 0);
+}
+TEST_F(LibraryThumbnails, ProbeWaitsForFirstPaintAndOffersOptionalRefresh) {
+  screen.uiReady = false;
+  screen.pollLibraryChanges();
+  EXPECT_EQ(screen.changeProbe.steps, 0);
+  screen.uiReady = true;
+  screen.changeProbe.next = library::LibraryChangeProbe::State::Changed;
+  screen.pollLibraryChanges();
+  EXPECT_TRUE(screen.refreshSuggested);
+  EXPECT_EQ(screen.scans, 0);
+}
diff --git a/test/library_thumbnails/LibraryTouchTest.cpp b/test/library_thumbnails/LibraryTouchTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/library_thumbnails/LibraryTouchTest.cpp
@@ -0,0 +1,117 @@
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "LibraryInputBuffer.h"
+struct Snapshot {
+  bool touchPressed = false, touchReleased = false, longPress = false;
+  int touchX = -1, touchY = -1;
+};
+struct MappedInputManager {
+  enum class SwipeDir { None, Left, Right, Up, Down };
+  SwipeDir swipe = SwipeDir::None;
+  bool down = false, held = false, released = false;
+  int x = 100, y = 100;
+  Snapshot snap;
+  bool wasScreenTouchDown(int& px, int& py) {
+    px = x;
+    py = y;
+    return down;
+  }
+  bool isScreenTouchHeld(int& px, int& py) {
+    px = x;
+    py = y;
+    return held;
+  }
+  bool wasScreenTouchReleased() { return released; }
+  SwipeDir wasSwipe() { return swipe; }
+};
+Snapshot touchSnapshotFrom(const MappedInputManager& input) { return input.snap; }
+struct LibraryActivity {
+  MappedInputManager mappedInput;
+  bool touchTracking = false, touchMoved = false;
+  int touchStartX = 0, touchStartY = 0, touchLastX = 0, touchLastY = 0;
+  LibraryInputBuffer pending;
+  bool gridEnabled() const { return true; }
+  void queueInput(LibraryInputBuffer::Type type, int x = -1, int y = -1) {
+    pending.push({type, static_cast<int16_t>(x), static_cast<int16_t>(y)});
+  }
+  void captureTouch();
+};
+#include "LibraryTouchMethods.inc"
+using Type = LibraryInputBuffer::Type;
+TEST(LibraryTouch, FastSwipesWinOverTapAndLongPressEvenWithoutHeldSamples) {
+  for (auto direction : {MappedInputManager::SwipeDir::Left, MappedInputManager::SwipeDir::Right,
+                         MappedInputManager::SwipeDir::Up, MappedInputManager::SwipeDir::Down}) {
+    LibraryActivity screen;
+    auto& input = screen.mappedInput;
+    input.down = true;
+    input.snap = {true, false, false, 100, 100};
+    screen.captureTouch();
+    screen.pending.clear();
+    input.down = false;
+    input.released = true;
+    input.swipe = direction;
+    input.snap = {false, true, true, 100, 100};
+    screen.captureTouch();
+    LibraryInputBuffer::Event event;
+    ASSERT_TRUE(screen.pending.pop(event));
+    EXPECT_EQ(event.type, Type::TouchRelease);
+    EXPECT_EQ(event.x, -1);
+    ASSERT_TRUE(screen.pending.pop(event));
+    EXPECT_NE(event.type, Type::TouchRelease);
+    EXPECT_NE(event.type, Type::TouchLongPress);
+    EXPECT_FALSE(screen.pending.pop(event));
+  }
+}
+TEST(LibraryTouch, SlowHorizontalDragPagesAndCannotOpenCover) {
+  LibraryActivity screen;
+  auto& input = screen.mappedInput;
+  input.down = true;
+  input.held = true;
+  input.snap = {true, false, false, 150, 100};
+  input.x = 150;
+  screen.captureTouch();
+  input.down = false;
+  input.x = 50;
+  input.snap = {};
+  screen.captureTouch();
+  screen.pending.clear();
+  input.held = false;
+  input.released = true;
+  input.snap = {false, true, false, 150, 100};
+  screen.captureTouch();
+  LibraryInputBuffer::Event event;
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.type, Type::TouchRelease);
+  EXPECT_EQ(event.x, -1);
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.type, Type::SwipeLeft);
+}
+TEST(LibraryTouch, MovingAwayAndBackCancelsTapButStationaryHoldKeepsMenu) {
+  LibraryActivity screen;
+  auto& input = screen.mappedInput;
+  input.down = true;
+  input.held = true;
+  screen.captureTouch();
+  input.down = false;
+  input.x = 140;
+  screen.captureTouch();
+  input.x = 100;
+  screen.captureTouch();
+  input.held = false;
+  input.released = true;
+  input.snap = {false, true, false, 100, 100};
+  screen.captureTouch();
+  LibraryInputBuffer::Event event;
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.x, -1);
+  screen = LibraryActivity{};
+  screen.mappedInput.released = true;
+  screen.mappedInput.snap = {false, true, true, 100, 100};
+  screen.captureTouch();
+  ASSERT_TRUE(screen.pending.pop(event));
+  EXPECT_EQ(event.type, Type::TouchLongPress);
+  EXPECT_EQ(event.x, 100);
+}
