@@ -0,0 +1,60 @@
+#include <OpenedBooks.h>
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+struct RecentBook {
+  std::string path, title;
+  bool missing = false;
+};
+struct RecentBooksStore {
+  std::vector<RecentBook> books;
+  const auto& getBooks() const { return books; }
+  static bool isMissing(const RecentBook& book) { return book.missing; }
+} RECENT_BOOKS;
+void ensureReusableCoverPath(RecentBook&) {}
+struct HomeActivity {
+  bool coverGridUi = true;
+  int recentGridPage = 0;
+  library::OpenedBooks openedBooks;
+  uint32_t openedBookCount = 0;
+  std::vector<RecentBook> recentBooks;
+  void loadRecentBooks(int maxBooks);
+};
+#include "HomePagingMethods.inc"
+
+TEST(HomePaging, AllDiskHistoryAppearsOnceBelowPersistentFeaturedBook) {
+  fake::reset();
+  RECENT_BOOKS.books.clear();  // No dependence on the old eighteen-entry metadata cache.
+  for (int i = 99; i >= 0; --i) ASSERT_TRUE(library::OpenedBooks::touch("/" + std::to_string(i) + ".epub"));
+  HomeActivity home;
+  std::vector<std::string> seen;
+  for (int page = 0; page < 17; ++page) {
+    home.recentGridPage = page;
+    home.loadRecentBooks(7);
+    ASSERT_LE(home.recentBooks.size(), 7u);
+    ASSERT_EQ(home.openedBookCount, 100u);
+    ASSERT_EQ(home.recentBooks.front().path, "/0.epub");
+    for (size_t i = 1; i < home.recentBooks.size(); ++i) seen.push_back(home.recentBooks[i].path);
+  }
+  ASSERT_EQ(seen.size(), 99u);
+  for (int i = 1; i < 100; ++i) EXPECT_EQ(seen[i - 1], "/" + std::to_string(i) + ".epub");
+  fake::resetIoCounters();
+  home.recentGridPage = 13;
+  home.loadRecentBooks(7);
+  EXPECT_LE(fake::reads, 30u);  // One page, independent of the full history size.
+  home.recentGridPage = 0;
+  home.loadRecentBooks(7);
+  EXPECT_EQ(home.recentBooks[1].path, "/1.epub");
+}
+TEST(HomePaging, HotMetadataIsReusedAndColdBooksNeedNoContentParsing) {
+  fake::reset();
+  RECENT_BOOKS.books = {{"/first.epub", "First"}};
+  for (const char* path : {"/old.epub", "/first.epub"}) ASSERT_TRUE(library::OpenedBooks::touch(path));
+  HomeActivity home;
+  home.loadRecentBooks(7);
+  ASSERT_EQ(home.recentBooks.size(), 2u);
+  EXPECT_EQ(home.recentBooks.front().path, "/first.epub");
+  EXPECT_EQ(home.recentBooks[1].title, "old");
+}
diff --git a/test/library_thumbnails/LibraryCoverWorkerTest.cpp b/test/library_thumbnails/LibraryCoverWorkerTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fd9c3a4b2465179555c94cbf5e4c83ec85b6cc1d
--- /dev/null
+++ b/test/library_thumbnails/LibraryCoverWorkerTest.cpp
@@ -0,0 +1,87 @@
+#include <gtest/gtest.h>
+
+#include <chrono>
+#include <future>
+
+#include "LibraryCoverWorker.h"
+#include "WorkerProbe.h"
+using namespace std::chrono_literals;
+struct LibraryCoverWorkerTest : testing::Test {
+  LibraryCoverWorker worker;
+  void SetUp() override {
+    workerprobe::entered = false;
+    workerprobe::proceed = true;
+    workerprobe::conversions = 0;
+    workerprobe::missing = false;
+    workerprobe::files.clear();
+    failTaskCreate = false;
+  }
+  void TearDown() override {
+    workerprobe::proceed = true;
+    worker.stop();
+    joinNativeTasks();
+  }
+  bool await(const std::function<bool()>& condition) {
+    const auto end = std::chrono::steady_clock::now() + 2s;
+    while (std::chrono::steady_clock::now() < end) {
+      if (condition()) return true;
+      std::this_thread::yield();
+    }
+    return condition();
+  }
+};
+TEST_F(LibraryCoverWorkerTest, SlowConversionDoesNotBlockSubmittingInputAndNeverUsesRenderer) {
+  workerprobe::proceed = false;
+  ASSERT_TRUE(worker.start());
+  ASSERT_TRUE(worker.submit("/a.epub", "/cache/a.bmp", 100, 150, 3));
+  ASSERT_TRUE(await([] { return workerprobe::entered.load(); }));
+  EXPECT_TRUE(worker.busy());
+  EXPECT_TRUE(worker.isWriting("/cache/a.bmp"));
+  EXPECT_FALSE(worker.isWriting("/cache/b.bmp"));
+  EXPECT_FALSE(worker.submit("/b.epub", "/cache/b.bmp", 100, 150, 4));
+  int row = -1;
+  bool changed = false;
+  EXPECT_FALSE(worker.collect(row, changed));
+  // Main/input thread remains runnable while actual worker code is decoding.
+  int inputPolls = 0;
+  for (int i = 0; i < 1000; ++i) ++inputPolls;
+  EXPECT_EQ(inputPolls, 1000);
+  EXPECT_TRUE(workerprobe::noRenderer);
+  workerprobe::proceed = true;
+  ASSERT_TRUE(await([&] { return worker.collect(row, changed); }));
+  EXPECT_EQ(row, 3);
+  EXPECT_TRUE(changed);
+  EXPECT_FALSE(worker.busy());
+  EXPECT_FALSE(worker.isWriting("/cache/a.bmp"));
+}
+TEST_F(LibraryCoverWorkerTest, StopJoinsCurrentConversionBeforeFreeingTheWorker) {
+  workerprobe::proceed = false;
+  ASSERT_TRUE(worker.start());
+  ASSERT_TRUE(worker.submit("/a.epub", "/cache/a.bmp", 100, 150, 0));
+  ASSERT_TRUE(await([] { return workerprobe::entered.load(); }));
+  auto stopping = std::async(std::launch::async, [&] { worker.stop(); });
+  EXPECT_EQ(stopping.wait_for(10ms), std::future_status::timeout);
+  workerprobe::proceed = true;
+  EXPECT_EQ(stopping.wait_for(2s), std::future_status::ready);
+  stopping.get();
+  EXPECT_FALSE(worker.busy());
+}
+TEST_F(LibraryCoverWorkerTest, StartFailureDoesNotFallBackToBlockingConversion) {
+  failTaskCreate = true;
+  EXPECT_FALSE(worker.start());
+  EXPECT_FALSE(worker.submit("/a.epub", "/cache/a.bmp", 100, 150, 0));
+  EXPECT_EQ(workerprobe::conversions, 0);
+}
+TEST_F(LibraryCoverWorkerTest, ConfirmedMissingCoverIsCachedButNoSuccessPublished) {
+  workerprobe::missing = true;
+  ASSERT_TRUE(worker.start());
+  ASSERT_TRUE(worker.submit("/a.epub", "/cache/a.bmp", 100, 150, 0));
+  int row;
+  bool changed;
+  ASSERT_TRUE(await([&] { return worker.collect(row, changed); }));
+  EXPECT_FALSE(changed);
+  EXPECT_TRUE(workerprobe::files.contains("/.crosspoint/a.epub/library-cover-missing"));
+  ASSERT_TRUE(worker.submit("/a.epub", "/cache/a.bmp", 100, 150, 0));
+  ASSERT_TRUE(await([&] { return worker.collect(row, changed); }));
+  EXPECT_EQ(workerprobe::conversions, 1);
+}
