+#include "BookCoverCache.h"
+
+#include <Bitmap.h>
+#include <Epub.h>
+#include <FsHelpers.h>
+#include <HalStorage.h>
+#include <Xtc.h>
+
+#include "RecentBooksStore.h"
+
+std::string gridThumbPath(const RecentBook& book, const int width, const int height) {
+  if (FsHelpers::hasEpubExtension(book.path))
+    return Epub::cachePathForFilePath(book.path, "/.crosspoint") + "/thumb_" + std::to_string(width) + "x" +
+           std::to_string(height) + ".bmp";
+  if (FsHelpers::hasXtcExtension(book.path)) return Xtc(book.path, "/.crosspoint").getThumbBmpPath(width, height);
+  return {};
+}
+
+bool hasValidGridThumb(const std::string& path, const int width, const int height) {
+  FsFile file;
+  if (path.empty() || !Storage.exists(path.c_str()) || !Storage.openFileForRead("LIB", path, file)) return false;
+  Bitmap bitmap(file);
+  const bool valid =
+      bitmap.parseHeaders() == BmpReaderError::Ok && bitmap.getWidth() == width && bitmap.getHeight() == height;
+  file.close();
+  return valid;
+}
