+#include <HalStorage.h>
+#include <LibraryViewCache.h>
+#include <Memory.h>
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+#define LOG_ERR(...) ((void)0)
+struct {
+  bool libraryHideFinishedBooks = false, libraryShowEpub = true, libraryShowXtc = false, libraryShowTxt = true,
+       libraryShowMarkdown = true;
+} SETTINGS;
+namespace library {
+enum class SortOrder { TitleAsc };
+enum { FileEpub = 1, FileXtc = 2, FileTxt = 4, FileMarkdown = 8 };
+inline uint8_t fileTypeFor(const std::string& name) {
+  return name.ends_with(".epub")  ? FileEpub
+         : name.ends_with(".txt") ? FileTxt
+         : name.ends_with(".xtc") ? FileXtc
+                                  : FileMarkdown;
+}
+inline std::string fold(const std::string& s) { return s; }
+inline void foldInto(const std::string& s, std::string& out) { out = s; }
+inline bool matchesQuery(const std::string& text, const std::string& needle) {
+  return text.find(needle) != std::string::npos;
+}
+struct ClixRecord {
+  uint16_t ordinal = 0;
+};
+struct LibraryIndexFile {
+  static constexpr int FOLDER_CHECKPOINT_COUNT = 128;
+  std::vector<std::string> names;
+  int reads = 0, failAt = -1;
+  bool isOpen() const { return true; }
+  uint16_t bookCount() const { return names.size(); }
+  uint16_t ordinalForRow(SortOrder, uint16_t row) { return row; }
+  bool readRecord(uint16_t row, ClixRecord& out) {
+    ++reads;
+    out.ordinal = row;
+    return row < names.size() && row != failAt;
+  }
+  bool readName(const ClixRecord& r, std::string& out) {
+    out = names[r.ordinal];
+    return true;
+  }
+  bool readDisplayText(const ClixRecord& r, std::string& title, std::string& author) {
+    title = names[r.ordinal];
+    author.clear();
+    return true;
+  }
+  bool readPathHash(const ClixRecord& r, uint64_t& hash) {
+    hash = r.ordinal;
+    return true;
+  }
+  bool buildFolderCheckpoints(uint32_t*, uint16_t& stride) {
+    stride = 1;
+    return true;
+  }
+  bool readPath(const ClixRecord& r, std::string& out, const uint32_t*, uint16_t) {
+    out = "/" + names[r.ordinal];
+    return true;
+  }
+};
+}  // namespace library
+uint8_t visibleLibraryFileTypes() {
+  return (SETTINGS.libraryShowEpub ? 1 : 0) | (SETTINGS.libraryShowXtc ? 2 : 0) | (SETTINGS.libraryShowTxt ? 4 : 0) |
+         (SETTINGS.libraryShowMarkdown ? 8 : 0);
+}
+struct BookReadingStats {
+  bool isCompleted = false;
+  static BookReadingStats load(const std::string&) { return {}; }
+};
+struct Xtc {
+  Xtc(const std::string&, const std::string&) {}
+  std::string getCachePath() const { return {}; }
+};
+uint64_t warmedCoverView = 0;
+struct LibraryActivity {
+  enum class Sort { Title, RecentlyRead };
+  Sort sort = Sort::Title;
+  library::LibraryIndexFile index;
+  static constexpr uint16_t FILTER_BLOCK_ROWS = 256;
+  std::unique_ptr<uint8_t[]> filterBits;
+  std::unique_ptr<uint16_t[]> filterRanks;
+  uint16_t filteredCount = 0, filterProcessedCount = 0, filterSourceCount = 0;
+  library::SortOrder filterOrder = library::SortOrder::TitleAsc;
+  bool filterFailed = false, uiReady = true, prefetchFinished = false;
+  int loadedGridPageStart = -1, paints = 0, prefetchCoverRow = -1, gridPageStart = 0;
+  int gridPageSize() const { return 9; }
+  std::string query;
+  struct FilterWork {
+    uint16_t cursor = 0, folderStride = 0;
+    std::unique_ptr<uint32_t[]> folderOffsets;
+    std::string needle, title, author, name, path, cachePath, combined, folded;
+  };
+  std::unique_ptr<FilterWork> filterWork;
+  struct {
+    void invalidate() {}
+  } paintedCovers;
+  int paintedGridPageStart = -1;
+  uint16_t failedCoverSlots = 0;
+  uint64_t cachedViewKey = 0;
+  uint64_t viewCacheKey(bool) const { return std::hash<std::string>{}(query) ^ visibleLibraryFileTypes(); }
+  bool restoreFilterCache();
+  void saveFilterCache();
+  void resolveRecents() {}
+  void advanceRecentFilter() {}
+  bool hasActiveFilter() const { return !query.empty() || !SETTINGS.libraryShowXtc; }
+  library::SortOrder indexOrder() const { return library::SortOrder::TitleAsc; }
+  void requestUpdate() { ++paints; }
+  void applyFilter();
+  void advanceFilter();
+  uint16_t filteredSourceRow(uint16_t row) const;
+};
+#include "LibraryFilterMethods.inc"
+TEST(LibraryFilterPacing, EntryDoesNoBookReadsAndEachIdleStepProcessesOnlyOneSourceRecord) {
+  LibraryActivity screen;
+  for (int i = 0; i < 600; ++i)
+    screen.index.names.push_back(std::to_string(i) + (i % 7 == 0 ? "_target.epub" : ".txt"));
+  screen.query = "target";
+  screen.applyFilter();
+  EXPECT_EQ(screen.index.reads, 0);
+  ASSERT_TRUE(screen.filterWork);
+  screen.uiReady = false;
+  screen.advanceFilter();
+  EXPECT_EQ(screen.index.reads, 0);
+  screen.uiReady = true;
+  std::vector<uint16_t> matches;
+  for (int i = 0; i < 600; ++i) {
+    const int before = screen.index.reads;
+    screen.advanceFilter();
+    EXPECT_EQ(screen.index.reads - before, 1);
+    if (i % 7 == 0) matches.push_back(i);
+    ASSERT_EQ(screen.filteredCount, matches.size());
+    // Check mappings while filtering is incomplete, especially either side of
+    // the sparse-rank block boundary; unfinished blocks must not enter the search.
+    for (uint16_t row = 0; row < matches.size(); ++row) EXPECT_EQ(screen.filteredSourceRow(row), matches[row]);
+  }
+  EXPECT_FALSE(screen.filterWork);
+  EXPECT_FALSE(screen.filterFailed);
+}
+TEST(LibraryFilterPacing, FailureAndChangingFilterCancelThePendingPassSafely) {
+  LibraryActivity screen;
+  screen.index.names = {"a.epub", "b.epub"};
+  screen.index.failAt = 1;
+  screen.applyFilter();
+  screen.advanceFilter();
+  screen.advanceFilter();
+  EXPECT_TRUE(screen.filterFailed);
+  EXPECT_FALSE(screen.filterWork);
+  EXPECT_EQ(screen.filteredCount, 0);
+  screen.index.failAt = -1;
+  screen.applyFilter();
+  screen.query = "no-match";
+  screen.applyFilter();
+  screen.advanceFilter();
+  screen.advanceFilter();
+  EXPECT_EQ(screen.filteredCount, 0);
+  EXPECT_FALSE(screen.filterWork);
+}
+
+TEST(LibraryFilterPacing, WarmViewRestoresCountsAndRowsWithoutReadingAnyBooks) {
+  fake::reset();
+  LibraryActivity cold;
+  cold.index.names = {"target.epub", "other.txt", "target2.epub"};
+  cold.query = "target";
+  cold.applyFilter();
+  while (cold.filterWork) cold.advanceFilter();
+  ASSERT_EQ(cold.filteredCount, 2);
+  LibraryActivity warm;
+  warm.index.names = cold.index.names;
+  warm.query = cold.query;
+  warm.applyFilter();
+  EXPECT_FALSE(warm.filterWork);
+  EXPECT_EQ(warm.index.reads, 0);
+  EXPECT_EQ(warm.filteredCount, 2);
+  EXPECT_EQ(warm.filteredSourceRow(0), 0);
+  EXPECT_EQ(warm.filteredSourceRow(1), 2);
+  library::invalidateViewCache();
+  warm.applyFilter();
+  EXPECT_TRUE(warm.filterWork);
+}
+
+TEST(LibraryFilterPacing, LeavingEarlyResumesAfterAlreadyProcessedBooks) {
+  fake::reset();
+  LibraryActivity cold;
+  cold.query = "target";
+  cold.index.names = {"target1.epub", "target2.epub", "target3.epub"};
+  cold.applyFilter();
+  cold.advanceFilter();
+  cold.advanceFilter();
+  ASSERT_TRUE(cold.filterWork);
+  ASSERT_EQ(cold.filterProcessedCount, 2);
+  ASSERT_TRUE(library::saveViewCache(false, cold.cachedViewKey, cold.filterSourceCount, cold.filteredCount,
+                                     cold.filterBits.get(), 1, cold.filterProcessedCount));
+  LibraryActivity resumed;
+  resumed.query = cold.query;
+  resumed.index.names = cold.index.names;
+  resumed.applyFilter();
+  ASSERT_TRUE(resumed.filterWork);
+  EXPECT_EQ(resumed.filterWork->cursor, 2);
+  EXPECT_EQ(resumed.index.reads, 0);
+  EXPECT_EQ(resumed.filteredCount, 2);
+  resumed.advanceFilter();
+  EXPECT_EQ(resumed.index.reads, 1);
+  EXPECT_EQ(resumed.filteredCount, 3);
+  EXPECT_FALSE(resumed.filterWork);
+}
diff --git a/test/library_thumbnails/LibraryThumbnailsTest.cpp b/test/library_thumbnails/LibraryThumbnailsTest.cpp
