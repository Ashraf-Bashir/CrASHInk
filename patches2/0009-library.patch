+// Exercise the real metadata-only checker against indexes built by the real
+// builder, sharing one open index handle just as LibraryActivity does.
+#include "LibraryChangeProbe.h"
+namespace {
+library::LibraryChangeProbe::State completeChangeProbe(library::LibraryChangeProbe& probe,
+                                                       library::LibraryIndexFile& index) {
+  for (int i = 0; i < 10000; ++i) {
+    const auto state = probe.step(index);
+    if (state != library::LibraryChangeProbe::State::ReadingIndex &&
+        state != library::LibraryChangeProbe::State::Walking)
+      return state;
+  }
+  ADD_FAILURE() << "Change check did not finish within its bounded fixture";
+  return library::LibraryChangeProbe::State::Unavailable;
+}
+}  // namespace
+TEST_F(LibraryBuilderTest, ChangeProbeMatchesUnchangedIndexWithoutParsingBooks) {
+  initial();
+  LibraryIndexFile index;
+  ASSERT_TRUE(index.open(INDEX));
+  library::LibraryChangeProbe probe;
+  static_assert(sizeof(probe) < 4096, "Metadata checker must stay bounded on C3");
+  probe.begin(index);
+  const auto parsesBefore = fake::parses;
+  EXPECT_EQ(completeChangeProbe(probe, index), library::LibraryChangeProbe::State::Unchanged);
+  EXPECT_EQ(fake::parses, parsesBefore);
+}
+TEST_F(LibraryBuilderTest, ChangeProbeDetectsAddedDeletedRenamedAndModifiedBooks) {
+  for (int change = 0; change < 4; ++change) {
+    fake::reset();
+    fake::add("/a.epub");
+    fake::add("/b.epub");
+    ASSERT_TRUE(buildLibraryIndex("/", stats, false));
+    LibraryIndexFile index;
+    ASSERT_TRUE(index.open(INDEX));
+    if (change == 0) fake::add("/new.epub");
+    if (change == 1) fake::files.erase("/b.epub");
+    if (change == 2) {
+      fake::files["/renamed.epub"] = fake::files["/b.epub"];
+      fake::files.erase("/b.epub");
+    }
+    if (change == 3) ++fake::files["/b.epub"]->time;
+    library::LibraryChangeProbe probe;
+    probe.begin(index);
+    EXPECT_EQ(completeChangeProbe(probe, index), library::LibraryChangeProbe::State::Changed) << change;
+  }
+}
+TEST_F(LibraryBuilderTest, ChangeProbeHandlesNestedFoldersAndIgnoresHiddenAndNonBooks) {
+  fake::add("/Books/Author/nested.epub");
+  fake::add("/.ignored/not-indexed.epub");
+  fake::add("/notes.json");
+  initial();
+  fake::add("/.ignored/new.epub");
+  fake::add("/other.jpg");
+  LibraryIndexFile index;
+  ASSERT_TRUE(index.open(INDEX));
+  library::LibraryChangeProbe probe;
+  probe.begin(index);
+  EXPECT_EQ(completeChangeProbe(probe, index), library::LibraryChangeProbe::State::Unchanged);
+  fake::add("/Books/Author/new.epub");
+  probe.begin(index);
+  EXPECT_EQ(completeChangeProbe(probe, index), library::LibraryChangeProbe::State::Changed);
+}
+TEST_F(LibraryBuilderTest, ChangeProbeCannotReportUnchangedAfterDirectoryReadFailure) {
+  initial();
