diff --git a/src/activities/library/LibraryCoverWorker.cpp b/src/activities/library/LibraryCoverWorker.cpp
new file mode 100644
--- /dev/null
+++ b/src/activities/library/LibraryCoverWorker.cpp
@@ -0,0 +1,105 @@
+#include "LibraryCoverWorker.h"
+
+#include <Epub.h>
+#include <FsHelpers.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <Memory.h>
+#include <Xtc.h>
+
+#include <cstring>
+#include <string>
+
+bool LibraryCoverWorker::start() {
+  if (task) return true;
+  stopping.store(false);
+  exited.store(false);
+  state.store(State::Idle);
+  // Low priority: input/render work preempts conversion even on single-core C3.
+  if (xTaskCreate(&trampoline, "LibraryCovers", 6144, this, tskIDLE_PRIORITY, &task) != pdPASS) {
+    task = nullptr;
+    exited.store(true);
+    LOG_ERR("LIB", "Cannot start cover worker; keeping cached covers/placeholders");
+    return false;
+  }
+  return true;
+}
+void LibraryCoverWorker::stop() {
+  if (!task) return;
+  stopping.store(true, std::memory_order_release);
+  xTaskNotifyGive(task);
+  // Finish the current file operation before teardown; never kill a task with
+  // open ZIP/BMP files or while it owns the storage mutex.
+  while (!exited.load(std::memory_order_acquire)) vTaskDelay(1);
+  task = nullptr;
+  state.store(State::Idle);
+}
+bool LibraryCoverWorker::busy() const { return state.load(std::memory_order_acquire) != State::Idle; }
+bool LibraryCoverWorker::isWriting(const char* thumb) const {
+  return state.load(std::memory_order_acquire) == State::Running && std::strcmp(thumbPath, thumb) == 0;
+}
+bool LibraryCoverWorker::submit(const char* book, const char* thumb, const int w, const int h, const int bookRow) {
+  if (!task || busy() || stopping.load() || std::strlen(book) >= sizeof(bookPath) ||
+      std::strlen(thumb) >= sizeof(thumbPath))
+    return false;
+  std::strcpy(bookPath, book);
+  std::strcpy(thumbPath, thumb);
+  width = w;
+  height = h;
+  row = bookRow;
+  changed = false;
+  state.store(State::Running, std::memory_order_release);
+  xTaskNotifyGive(task);
+  return true;
+}
+bool LibraryCoverWorker::collect(int& bookRow, bool& updated) {
+  if (state.load(std::memory_order_acquire) != State::Done) return false;
+  bookRow = row;
+  updated = changed;
+  state.store(State::Idle, std::memory_order_release);
+  return true;
+}
+void LibraryCoverWorker::trampoline(void* context) { static_cast<LibraryCoverWorker*>(context)->run(); }
+void LibraryCoverWorker::run() {
+  for (;;) {
+    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+    if (stopping.load(std::memory_order_acquire)) break;
+    if (state.load(std::memory_order_acquire) != State::Running) continue;
+    changed = generate();
+    state.store(State::Done, std::memory_order_release);
+  }
+  exited.store(true, std::memory_order_release);
+  vTaskDelete(nullptr);
+}
+bool LibraryCoverWorker::generate() {
+  const std::string path(bookPath);
+  if (FsHelpers::hasEpubExtension(path)) {
+    // Source-only metadata avoids loading the reader's TOC/layout/font caches.
+    auto epub = makeUniqueNoThrow<Epub>(path, "/.crosspoint");
+    if (!epub) {
+      LOG_ERR("LIB", "Cannot allocate thumbnail EPUB");
+      return false;
+    }
+    const auto missingPath = epub->getCachePath() + "/library-cover-missing";
+    if (Storage.exists(missingPath.c_str())) return false;
+    bool missing = false;
+    const bool generated = epub->generateThumbBmpFromSource(width, height, nullptr, 0, &missing);
+    if (missing) {
+      FsFile marker;
+      if (Storage.openFileForWrite("LIB", missingPath, marker))
+        marker.close();
+      else
+        LOG_ERR("LIB", "Cannot cache missing cover");
+    }
+    return generated;
+  }
+  if (FsHelpers::hasXtcExtension(path)) {
+    auto xtc = makeUniqueNoThrow<Xtc>(path, "/.crosspoint");
+    if (!xtc) {
+      LOG_ERR("LIB", "Cannot allocate thumbnail XTC");
+      return false;
+    }
+    return xtc->load() && xtc->generateThumbBmp(width, height);
+  }
+  return false;
+}
