+class EndOfBookOptions {
+ public:
+  enum class Action { None, Redraw, OpenBook, GoHome, LastPage };
+  GfxRenderer renderer;
+  std::atomic<bool> uiReady{true};
+  std::atomic<int> selector{0};
+  std::vector<std::string> names{"next.epub"};
+  FakeApp app;
+  Rect closeRect() const;
+  std::string fullPath(size_t i) const { return names[i]; }
+  Action handleMenuInput(const MappedInputManager&, std::string*, bool rtlBook = false);
+};
+struct Epub {
+  int getSpineItemsCount() const { return 4; }
+  std::string getPath() const { return "/Books/current.epub"; }
+  std::string getTitle() const { return "Current"; }
+  std::string getAuthor() const { return "Author"; }
+  std::string getThumbBmpPath() const { return "cover.bmp"; }
+};
+struct Recents {
+  int adds = 0;
+  void addOrUpdateBook(std::string, std::string, std::string, std::string) { ++adds; }
+} RECENT_BOOKS;
+struct EpubReaderActivity {
+  std::unique_ptr<Epub> epub = std::make_unique<Epub>();
+  int currentSpineIndex = 4, nextPageNumber = 42;
+  uint16_t pendingPageJump = 0;
+  struct {
+    bool isCompleted = false;
+  } stats;
+  bool pendingReadFolderMove = true, recentsEntryRemoved = true;
+  int redraws = 0;
+  void requestUpdate() { ++redraws; }
+  void returnToLastBookPage();
+};
+struct RenderLock {
+  explicit RenderLock(EpubReaderActivity&) {}
+};
+#include "EndDismiss.inc"
+int main() {
+  using A = EndOfBookOptions::Action;
+  for (bool suggestions : {false, true}) {
+    EndOfBookOptions menu;
+    if (!suggestions) menu.names.clear();
+    MappedInputManager input;
+    std::string path;
+    input.tapped = true;
+    input.x = 455;
+    input.y = 25;
+    input.releasedTouch = true;
+    assert(menu.handleMenuInput(input, &path) == A::LastPage);
+    assert(menu.app.routes == 0);
+    assert(path.empty());
+    input.tapped = false;
+    input.swipe = MappedInputManager::SwipeDir::Right;
+    assert(menu.handleMenuInput(input, &path) == A::LastPage);
+    assert(menu.app.routes == 0);
+    input.swipe = MappedInputManager::SwipeDir::Left;
+    assert(menu.handleMenuInput(input, &path, true) == A::LastPage);
+    assert(menu.app.routes == 0);
+    assert(menu.handleMenuInput(input, &path, false) == A::Redraw);
+    assert(menu.app.routes == 0);
+    input.swipe = MappedInputManager::SwipeDir::None;
+    input.releasedTouch = false;
+    input.back = true;
+    assert(menu.handleMenuInput(input, &path) == A::LastPage);
+  }
+  {
+    EndOfBookOptions menu;
+    MappedInputManager input;
+    input.releasedTouch = true;
+    std::string path;
+    assert(menu.handleMenuInput(input, &path) == A::OpenBook);
+    assert(path == "next.epub");
+  }
+  for (bool manuallyFinished : {false, true}) {
+    EpubReaderActivity reader;
+    reader.stats.isCompleted = manuallyFinished;
+    RECENT_BOOKS.adds = 0;
+    reader.returnToLastBookPage();
+    assert(reader.currentSpineIndex == 3);
+    assert(reader.nextPageNumber == 0);
+    assert(reader.pendingPageJump == std::numeric_limits<uint16_t>::max());
+    assert(reader.pendingReadFolderMove == manuallyFinished);
+    assert(!reader.recentsEntryRemoved);
+    assert(RECENT_BOOKS.adds == 1);
+    assert(reader.redraws == 1);
+    reader.returnToLastBookPage();
+    assert(RECENT_BOOKS.adds == 1);
+  }
+  std::cout << "End-of-book dismissal scenarios passed\n";
+}
