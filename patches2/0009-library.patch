+++ b/lib/LibraryIndex/OpenedBooks.cpp
@@ -0,0 +1,242 @@
+#include "OpenedBooks.h"
+
+#include <Logging.h>
+
+#include <cstring>
+#include <limits>
+
+namespace library {
+namespace {
+constexpr char INDEX[] = "/.crosspoint/opened.idx";
+constexpr char BACKUP[] = "/.crosspoint/opened.bak";
+constexpr char TEMP[] = "/.crosspoint/opened.tmp";
+constexpr char PATHS[] = "/.crosspoint/opened.paths";
+constexpr uint32_t MAGIC = 0x3142504f;  // OPB1
+#pragma pack(push, 1)
+struct Header {
+  uint32_t magic = MAGIC;
+  uint16_t version = 1, stride = 20;
+  uint32_t count = 0;
+  uint64_t revision = 0;
+};
+struct Entry {
+  uint64_t hash = 0;
+  uint32_t offset = 0;
+  uint64_t opened = 0;
+};
+#pragma pack(pop)
+static_assert(sizeof(Header) == 20 && sizeof(Entry) == 20);
+uint64_t hashPath(const std::string& path) {
+  uint64_t hash = 14695981039346656037ULL;
+  for (unsigned char c : path) {
+    hash ^= c;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
+bool header(FsFile& file, Header& h) {
+  return file.seekSet(0) && file.read(&h, sizeof(h)) == sizeof(h) && h.magic == MAGIC && h.version == 1 &&
+         h.stride == sizeof(Entry) && file.fileSize() == sizeof(h) + static_cast<uint64_t>(h.count) * sizeof(Entry);
+}
+bool openIndex(FsFile& file, Header& h, bool* backup = nullptr) {
+  if (backup) *backup = false;
+  if (Storage.openFileForRead("HIST", INDEX, file)) {
+    if (header(file, h)) return true;
+    file.close();
+  }
+  if (Storage.openFileForRead("HIST", BACKUP, file)) {
+    if (header(file, h)) {
+      if (backup) *backup = true;
+      return true;
+    }
+    file.close();
+  }
+  return false;
+}
+bool entryAt(FsFile& file, uint32_t row, Entry& entry) {
+  return file.seekSet(sizeof(Header) + static_cast<uint64_t>(row) * sizeof(Entry)) &&
+         file.read(&entry, sizeof(entry)) == sizeof(entry);
+}
+bool readPath(const Entry& entry, std::string& path) {
+  FsFile file;
+  if (!Storage.openFileForRead("HIST", PATHS, file)) return false;
+  uint16_t length = 0;
+  bool ok = file.seekSet(entry.offset) && file.read(&length, sizeof(length)) == sizeof(length) && length > 0 &&
+            length < 512 && static_cast<uint64_t>(entry.offset) + sizeof(length) + length <= file.fileSize();
+  if (ok) {
+    path.resize(length);
+    ok = file.read(path.data(), length) == length && path.front() == '/' && path.find('\0') == std::string::npos &&
+         hashPath(path) == entry.hash;
+  }
+  file.close();
+  if (!ok) path.clear();
+  return ok;
+}
+bool appendPath(const std::string& path, Entry& entry) {
+  FsFile file = Storage.open(PATHS, O_WRONLY | O_CREAT | O_APPEND);
+  if (!file) return false;
+  const uint64_t offset = file.fileSize();
+  const uint16_t length = path.size();
+  const bool ok = offset <= UINT32_MAX - sizeof(length) - length && file.seekSet(offset) &&
+                  file.write(&length, sizeof(length)) == sizeof(length) && file.write(path.data(), length) == length &&
+                  file.sync();
+  file.close();
+  entry.hash = hashPath(path);
+  entry.offset = static_cast<uint32_t>(offset);
+  return ok;
+}
+bool publish(bool recovered) {
+  if (recovered) {
+    if (Storage.exists(INDEX) && !Storage.remove(INDEX)) return false;
+    if (!Storage.rename(BACKUP, INDEX)) return false;
+  }
+  // Preserve the last complete snapshot until the replacement is synced and
+  // renamed. A failed rename rolls back; startup can also read the backup.
+  if (Storage.exists(INDEX)) {
+    if (Storage.exists(BACKUP) && !Storage.remove(BACKUP)) return false;
+    if (!Storage.rename(INDEX, BACKUP)) return false;
+  }
+  if (!Storage.rename(TEMP, INDEX)) {
+    if (!Storage.exists(INDEX) && Storage.exists(BACKUP)) Storage.rename(BACKUP, INDEX);
+    return false;
+  }
+  return true;
+}
+enum class Change { Touch, Remove, Rename };
+bool change(const std::string& path, Change mode, const std::string& replacement = {}) {
+  if (path.empty() || path.front() != '/' || path.size() >= 512 ||
+      (mode == Change::Rename && (replacement.empty() || replacement.front() != '/' || replacement.size() >= 512)))
+    return false;
+  FsFile old;
+  Header h;
+  bool recovered = false;
+  const bool foundIndex = openIndex(old, h, &recovered);
+  if (!foundIndex && (Storage.exists(INDEX) || Storage.exists(BACKUP))) {
+    LOG_ERR("HIST", "Cannot read opened-book ordering; preserving files");
+    return false;
+  }
+  if (!foundIndex) h = Header{};
+  const uint64_t hash = hashPath(path);
+  Entry selected;
+  uint32_t selectedRow = UINT32_MAX;
+  std::string check;
+  check.reserve(511);  // One reusable path, bounded independently of history size.
+  if (h.count && !old.seekSet(sizeof(Header))) {
+    old.close();
+    return false;
+  }
+  for (uint32_t row = 0; row < h.count; ++row) {
+    Entry entry;
+    if (old.read(&entry, sizeof(entry)) != sizeof(entry)) {
+      old.close();
+      return false;
+    }
+    if (entry.hash == hash) {
+      if (!readPath(entry, check)) {
+        old.close();
+        return false;
+      }
+      if (check == path) {
+        selected = entry;
+        selectedRow = row;
+        break;
+      }
+    }
+  }
+  if (mode != Change::Touch && selectedRow == UINT32_MAX) {
+    old.close();
+    return true;
+  }
+  // Metadata refreshes for the current book do not rewrite history.
+  if (mode == Change::Touch && selectedRow == 0) {
+    old.close();
+    return true;
+  }
+  if (h.revision == UINT64_MAX || (mode == Change::Touch && selectedRow == UINT32_MAX && h.count == UINT32_MAX)) {
+    old.close();
+    return false;
+  }
+  if ((mode == Change::Touch && selectedRow == UINT32_MAX) || mode == Change::Rename) {
+    if (!appendPath(mode == Change::Rename ? replacement : path, selected)) {
+      old.close();
+      return false;
+    }
+  }
+  Header next = h;
+  ++next.revision;
+  if (mode == Change::Touch) {
+    selected.opened = next.revision;
+    if (selectedRow == UINT32_MAX) ++next.count;
+  } else if (mode == Change::Remove)
+    --next.count;
+  FsFile out;
+  if (!Storage.openFileForWrite("HIST", TEMP, out)) {
+    old.close();
+    return false;
+  }
+  bool ok = out.write(&next, sizeof(next)) == sizeof(next);
+  if (mode == Change::Touch) ok = ok && out.write(&selected, sizeof(selected)) == sizeof(selected);
+  if (h.count) ok = ok && old.seekSet(sizeof(Header));
+  for (uint32_t row = 0; row < h.count && ok; ++row) {
+    Entry entry;
+    ok = old.read(&entry, sizeof(entry)) == sizeof(entry);
+    if (row == selectedRow && mode != Change::Rename) continue;
+    if (row == selectedRow) entry = selected;
+    if (ok) ok = out.write(&entry, sizeof(entry)) == sizeof(entry);
+  }
+  ok = ok && out.sync();
+  out.close();
+  old.close();
+  if (!ok) {
+    Storage.remove(TEMP);
+    return false;
+  }
+  return publish(recovered);
+}
+}  // namespace
+bool OpenedBooks::seed(uint32_t count, PathAt pathAt, const void* context) {
+  if (exists()) return true;
+  if (!pathAt) return false;
+  FsFile out;
+  if (!Storage.openFileForWrite("HIST", TEMP, out)) return false;
+  Header h;
+  h.count = count;
+  h.revision = count;
+  bool ok = out.write(&h, sizeof(h)) == sizeof(h);
+  for (uint32_t row = 0; row < count && ok; ++row) {
+    const auto& path = pathAt(row, context);
+    Entry entry;
+    ok = !path.empty() && path.front() == '/' && path.size() < 512 && appendPath(path, entry);
+    entry.opened = count - row;
+    if (ok) ok = out.write(&entry, sizeof(entry)) == sizeof(entry);
+  }
+  ok = ok && out.sync();
+  out.close();
+  if (!ok) {
+    Storage.remove(TEMP);
+    return false;
+  }
+  return publish(false);
+}
+bool OpenedBooks::exists() { return Storage.exists(INDEX) || Storage.exists(BACKUP); }
+bool OpenedBooks::open() {
+  close();
+  Header h;
+  if (!openIndex(index, h)) return false;
+  rows = h.count;
+  return true;
+}
+void OpenedBooks::close() {
+  index.close();
+  rows = 0;
+}
+bool OpenedBooks::read(uint32_t row, std::string& path) {
+  Entry entry;
+  return row < rows && entryAt(index, row, entry) && readPath(entry, path);
+}
+bool OpenedBooks::touch(const std::string& path) { return change(path, Change::Touch); }
+bool OpenedBooks::remove(const std::string& path) { return change(path, Change::Remove); }
+bool OpenedBooks::rename(const std::string& before, const std::string& after) {
+  return change(before, Change::Rename, after);
+}
+}  // namespace library
