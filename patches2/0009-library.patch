+#include "LibraryFilterMethods.inc"
+TEST(LibraryFilterPacing, EntryDoesNoBookReadsAndEachIdleStepProcessesOnlyOneSourceRecord) {
+  LibraryActivity screen;
+  for (int i = 0; i < 600; ++i)
+    screen.index.names.push_back(std::to_string(i) + (i % 7 == 0 ? "_target.epub" : ".txt"));
+  screen.query = "target";
+  screen.applyFilter();
+  EXPECT_EQ(screen.index.reads, 0);
+  ASSERT_TRUE(screen.filterWork);
+  screen.uiReady = false;
+  screen.advanceFilter();
+  EXPECT_EQ(screen.index.reads, 0);
+  screen.uiReady = true;
+  std::vector<uint16_t> matches;
+  for (int i = 0; i < 600; ++i) {
+    const int before = screen.index.reads;
+    screen.advanceFilter();
+    EXPECT_EQ(screen.index.reads - before, 1);
+    if (i % 7 == 0) matches.push_back(i);
+    ASSERT_EQ(screen.filteredCount, matches.size());
+    // Check mappings while filtering is incomplete, especially either side of
+    // the sparse-rank block boundary; unfinished blocks must not enter the search.
+    for (uint16_t row = 0; row < matches.size(); ++row) EXPECT_EQ(screen.filteredSourceRow(row), matches[row]);
+  }
+  EXPECT_FALSE(screen.filterWork);
+  EXPECT_FALSE(screen.filterFailed);
+}
+TEST(LibraryFilterPacing, FailureAndChangingFilterCancelThePendingPassSafely) {
