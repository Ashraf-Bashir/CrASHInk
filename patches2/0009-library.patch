diff --git a/lib/LibraryIndex/LibraryViewCache.cpp b/lib/LibraryIndex/LibraryViewCache.cpp
new file mode 100644
--- /dev/null
+++ b/lib/LibraryIndex/LibraryViewCache.cpp
@@ -0,0 +1,85 @@
+#include "LibraryViewCache.h"
+
+#include <HalStorage.h>
+#include <Logging.h>
+
+#include <cstring>
+namespace library {
+namespace {
+const char* path(bool recent) {
+  return recent ? "/.crosspoint/library-recents.cache" : "/.crosspoint/library-filter.cache";
+}
+#pragma pack(push, 1)
+struct Header {
+  uint32_t magic;
+  uint16_t version, bytes;
+  uint64_t key;
+  uint16_t sourceCount, count, processed;
+  uint64_t checksum;
+};
+#pragma pack(pop)
+uint64_t hash(const void* data, size_t bytes) {
+  uint64_t value = 14695981039346656037ULL;
+  const auto* p = static_cast<const uint8_t*>(data);
+  for (size_t i = 0; i < bytes; ++i) {
+    value ^= p[i];
+    value *= 1099511628211ULL;
+  }
+  return value;
+}
+uint64_t checksum(const Header& h, const void* data, size_t bytes) {
+  return hash(data, bytes) ^ h.key ^ (static_cast<uint64_t>(h.sourceCount) << 48) ^
+         (static_cast<uint64_t>(h.count) << 32) ^ (static_cast<uint64_t>(h.processed) << 16) ^ h.bytes;
+}
+static_assert(sizeof(Header) == 30);
+}  // namespace
+bool loadViewCache(bool recent, uint64_t key, uint16_t sourceCount, uint16_t& count, void* data, size_t bytes,
+                   uint16_t* processed) {
+  count = 0;
+  if (processed) *processed = 0;
+  FsFile file;
+  if (!Storage.openFileForRead("LIB", path(recent), file)) return false;
+  Header h{};
+  bool ok = file.read(&h, sizeof(h)) == sizeof(h) && h.magic == 0x3156434c && h.version == 2 && h.bytes == bytes &&
+            h.key == key && h.sourceCount == sourceCount && h.count <= h.processed && h.processed <= sourceCount &&
+            (processed || h.processed == sourceCount) && file.fileSize() == sizeof(h) + bytes;
+  if (ok) ok = file.read(data, bytes) == static_cast<int>(bytes) && checksum(h, data, bytes) == h.checksum;
+  file.close();
+  if (ok) {
+    count = h.count;
+    if (processed) *processed = h.processed;
+  } else
+    std::memset(data, 0, bytes);
+  return ok;
+}
+bool saveViewCache(bool recent, uint64_t key, uint16_t sourceCount, uint16_t count, const void* data, size_t bytes,
+                   uint16_t processed) {
+  if (processed == UINT16_MAX) processed = sourceCount;
+  if (processed > sourceCount || count > processed || bytes > 4096 || count > sourceCount) return false;
