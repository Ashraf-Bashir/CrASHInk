diff --git a/src/activities/reader/ClipSelectionPaging.h b/src/activities/reader/ClipSelectionPaging.h
index 0247eb5..d570586 100644
--- a/src/activities/reader/ClipSelectionPaging.h
+++ b/src/activities/reader/ClipSelectionPaging.h
@@ -19,6 +19,15 @@ inline bool hasDraggedFrom(const int startX, const int startY, const int x, cons
          deltaY <= -TOUCH_DRAG_MOVEMENT_PX;
 }
 
+// A drag that ends on the last word of a page only carries on to the next page
+// when the finger goes on past that word, to the right or further down. Simply
+// stopping on the last word (however long) finishes the highlight there.
+constexpr int TOUCH_PAGE_OVERSHOOT_PX = 16;
+
+inline bool isPastPageEnd(const WordRef& word, const int x, const int y) {
+  return x >= word.x + word.w + TOUCH_PAGE_OVERSHOOT_PX || y >= word.y + word.h + TOUCH_PAGE_OVERSHOOT_PX;
+}
+
 inline bool hasHeldPageEndLongEnough(const uint32_t now, const uint32_t heldSince) {
   return static_cast<uint32_t>(now - heldSince) >= TOUCH_PAGE_ADVANCE_HOLD_MS;
 }
