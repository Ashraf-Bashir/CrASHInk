diff --git a/src/readest/ReadestPositionResolver.h b/src/readest/ReadestPositionResolver.h
new file mode 100644
--- /dev/null
+++ b/src/readest/ReadestPositionResolver.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <ProgressMapper.h>
+
+#include <memory>
+#include <string>
+#include <utility>
+
+namespace ReadestPositionResolver {
+// A different file hash alone cannot establish matching chapter numbering.
+// Without the original copy, only the optimizer's explicit source map can
+// translate Readest's XPath into this book. Failure leaves the output empty.
+inline bool mapWithoutSourceCopy(const std::shared_ptr<Epub>& deviceBook, const std::string& sourceXPath,
+                                 std::string& deviceXPath) {
+  deviceXPath.clear();
+  if (!deviceBook || !deviceBook->hasSourceSpineMap() || sourceXPath.empty()) return false;
+  std::string mapped = sourceXPath;
+  int spine = -1;
+  if (!ProgressMapper::sourceXPathToCurrent(deviceBook, mapped, spine) || spine < 0 ||
+      spine >= deviceBook->getSpineItemsCount()) {
+    return false;
+  }
+  deviceXPath = std::move(mapped);
+  return true;
+}
+}  // namespace ReadestPositionResolver
