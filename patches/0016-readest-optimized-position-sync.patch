diff --git a/test/readest_source_position/ReadestSourcePositionTest.cpp b/test/readest_source_position/ReadestSourcePositionTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/readest_source_position/ReadestSourcePositionTest.cpp
@@ -0,0 +1,28 @@
+#include <cassert>
+#include <iostream>
+#include "src/readest/ReadestPositionResolver.h"
+
+int main() {
+  auto book = std::make_shared<Epub>();
+  const std::string source = "/body/DocFragment[3]/body/p[40]/text().7";
+  std::string mapped;
+  assert(ReadestPositionResolver::mapWithoutSourceCopy(book, source, mapped));
+  assert(mapped == "/body/DocFragment[6]/body/p[10]/text().7");
+  assert(mapped != source);
+  // A converted book without a map must not silently use original numbering.
+  book->hasMap = false;
+  assert(!ReadestPositionResolver::mapWithoutSourceCopy(book, source, mapped));
+  assert(mapped.empty());
+  book->hasMap = true;
+  book->mappingSucceeds = false;
+  assert(!ReadestPositionResolver::mapWithoutSourceCopy(book, source, mapped));
+  assert(mapped.empty());
+  book->mappingSucceeds = true;
+  book->mappedSpine = 8;
+  assert(!ReadestPositionResolver::mapWithoutSourceCopy(book, source, mapped));
+  book->mappedSpine = -1;
+  assert(!ReadestPositionResolver::mapWithoutSourceCopy(book, source, mapped));
+  assert(!ReadestPositionResolver::mapWithoutSourceCopy(nullptr, source, mapped));
+  assert(!ReadestPositionResolver::mapWithoutSourceCopy(book, "", mapped));
+  std::cout << "Readest source-position routing checks passed\n";
+}
diff --git a/test/readest_source_position/stubs/ProgressMapper.h b/test/readest_source_position/stubs/ProgressMapper.h
new file mode 100644
--- /dev/null
+++ b/test/readest_source_position/stubs/ProgressMapper.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <memory>
+#include <string>
+class Epub {
+ public:
+  bool hasMap = true;
+  bool mappingSucceeds = true;
+  int mappedSpine = 5;
+  bool hasSourceSpineMap() const { return hasMap; }
+  int getSpineItemsCount() const { return 8; }
+};
+class ProgressMapper {
+ public:
+  static bool sourceXPathToCurrent(const std::shared_ptr<Epub>& book, std::string& xpath, int& spine) {
+    if (!book->mappingSucceeds) return false;
+    spine = book->mappedSpine;
+    // The original's chapter 3 was split; this point is in device chapter 6.
+    if (xpath != "/body/DocFragment[3]/body/p[40]/text().7") return false;
+    xpath = "/body/DocFragment[6]/body/p[10]/text().7";
+    return true;
+  }
+};
