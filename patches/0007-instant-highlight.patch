+size_t DictionaryLookupController::phraseWordCount(const std::string& phrase) {
+  size_t words = 0;
+  bool inWord = false;
+  for (const char ch : phrase) {
+    const bool space = ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r';
+    if (!space && !inWord) words++;
+    inWord = !space;
+  }
+  return words;
+}
