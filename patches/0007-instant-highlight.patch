+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include "EpdFontFamily.h"
+namespace BidiUtils {
+enum class BidiBaseDir { RTL, LTR };
+}
+class GfxRenderer {
+ public:
+  enum class Orientation { Portrait, PortraitInverted, LandscapeClockwise, LandscapeCounterClockwise };
+  mutable std::vector<uint8_t> pixels = std::vector<uint8_t>(800 * 480, 0);
+  Orientation getOrientation() const { return Orientation::Portrait; }
+  void fillRect(int x, int y, int w, int h, bool black = true) const {
+    for (int j = std::max(0, y); j < std::min(480, y + h); ++j)
+      for (int i = std::max(0, x); i < std::min(800, x + w); ++i) pixels[j * 800 + i] = black;
+  }
+  void drawLine(int x, int y, int x2, int y2, int width, bool black) const {
+    fillRect(std::min(x, x2), std::min(y, y2), std::abs(x2 - x) + 1, std::abs(y2 - y) + width, black);
+  }
+  template <class... Args>
+  void drawText(Args...) const {}
+  size_t readFramebufferRegion(uint16_t x, uint16_t y, uint16_t w, uint16_t h, uint8_t* out, size_t capacity) const {
+    size_t stride = (w + 7) / 8, bytes = stride * h;
+    if (bytes > capacity || x + w > 800 || y + h > 480) return 0;
+    std::fill(out, out + bytes, 0);
+    for (int j = 0; j < h; ++j)
+      for (int i = 0; i < w; ++i)
+        if (pixels[(y + j) * 800 + x + i]) out[j * stride + i / 8] |= 1 << (i % 8);
+    return bytes;
+  }
+  void writeFramebufferRegion(uint16_t x, uint16_t y, uint16_t w, uint16_t h, const uint8_t* data) {
+    size_t stride = (w + 7) / 8;
+    for (int j = 0; j < h; ++j)
+      for (int i = 0; i < w; ++i) pixels[(y + j) * 800 + x + i] = (data[j * stride + i / 8] >> (i % 8)) & 1;
+  }
+};
