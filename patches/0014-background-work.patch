+++ b/test/library_thumbnails/LibraryRefreshTest.cpp
@@ -0,0 +1,72 @@
+#include <atomic>
+#include <cassert>
+#include <iostream>
+#include <memory>
+#include <utility>
+#define LOG_ERR(...) do {} while (0)
+#define LOG_INF(...) do {} while (0)
+enum class StrId { STR_LIBRARY_SCAN_CANCELLED, STR_LIBRARY_TOO_MANY_BOOKS, STR_LIBRARY_SCAN_FAILED };
+namespace library {
+enum class BuildFailure { None, Cancelled, TooManyBooks };
+struct BuildStats { BuildFailure failure=BuildFailure::None; bool indexReplaced=false; };
+inline bool cacheValid=true,dirty=false;
+inline unsigned invalidations=0;
+void invalidateViewCache(){cacheValid=false;++invalidations;}
+bool libraryIndexNeedsRefresh(){return dirty;}
+const char* libraryIndexPath(){return "/library.idx";}
+}
+struct {bool pruneMissing(){return false;}void saveToFile(){}} RECENT_BOOKS;
+namespace RecentBookProgress {inline unsigned invalidations=0;void invalidateEpubPercents(){++invalidations;}}
+bool libraryCheckedThisBoot=false,libraryChangedThisBoot=false;
+unsigned warmedCoverView=123;
+class LibraryActivity {
+ public:
+ enum class Sort {RecentlyRead,DateAdded,Series,Genre,Title};
+ Sort sort=Sort::RecentlyRead;
+ struct Scan {std::atomic<bool> ready{false};bool succeeded=true,refresh=true;library::BuildStats stats;};
+ std::unique_ptr<Scan> scan;
+ bool scanQueued=false,queuedRefresh=false,scanFailed=false,scanCancelledThisVisit=false;
+ bool refreshSuggested=false,descending=true,workerBusy=false;
+ unsigned launches=0,filters=0,freshFilters=0,viewports=0,updates=0;
+ StrId scanFailureText=StrId::STR_LIBRARY_SCAN_FAILED;
+ struct Index {bool ok=true;bool open(const char*){return ok;}bool openForReconciliation(const char*){return false;}
+ struct Header {int formatVersion=4;} h;const Header& header(){return h;}}index;
+ struct {bool preparing=false;bool isPreparingBook(){return preparing;}}activityManager;
+ struct {void start(){}}coverWorker;
+ bool backgroundScanActive(){return workerBusy;}
+ void applyFilter(){++filters;if(!library::cacheValid)++freshFilters;library::cacheValid=true;}
+ void resetViewport(){++viewports;}
+ void requestUpdate(){++updates;}
+ void refreshIndexIfNeeded(){++filters;}
+ void rebuildIndex(bool refresh=false);void pollScan();void finishScan(const Scan&);void refreshLibrary();
+};
+#include "LibraryRefresh.inc"
+int main(){
+ // Refresh reconciles files in both views; opening a book is never a prerequisite.
+ for(auto sort:{LibraryActivity::Sort::RecentlyRead,LibraryActivity::Sort::DateAdded}){
+  LibraryActivity a;a.sort=sort;a.refreshLibrary();
+  assert(a.launches==1&&a.scan&&a.scan->refresh);
+  // An old in-memory filter may finish while the catalog worker is running.
+  library::cacheValid=true;a.scan->ready=true;a.pollScan();
+  assert(!a.scan&&!a.scanFailed&&a.freshFilters==1&&a.filters==1);
+ }
+ // Repeated Refresh during a scan coalesces into exactly one follow-up check.
+ LibraryActivity queued;queued.refreshLibrary();queued.refreshLibrary();queued.refreshLibrary();
+ assert(queued.launches==1&&queued.scanQueued&&queued.queuedRefresh);
+ queued.scan->ready=true;queued.pollScan();
+ assert(queued.launches==2&&queued.scan&&!queued.scanQueued&&!queued.queuedRefresh);
+ queued.scan->ready=true;queued.pollScan();assert(queued.launches==2&&!queued.scan);
+ // Busy book preparation queues reconciliation without touching its storage.
+ LibraryActivity busy;busy.activityManager.preparing=true;busy.refreshLibrary();
+ assert(busy.launches==0&&busy.scanQueued&&busy.queuedRefresh);
+ busy.pollScan();assert(busy.launches==0);
+ busy.activityManager.preparing=false;busy.pollScan();assert(busy.launches==1&&busy.scan->refresh);
+ // Even an unchanged index must not restore stale progress/filter membership.
+ LibraryActivity unchanged;unchanged.refreshLibrary();unchanged.scan->stats.indexReplaced=false;
+ unchanged.scan->ready=true;unchanged.pollScan();assert(unchanged.freshFilters==1);
+ // Failed scans retain the previous cache and expose the failure.
+ LibraryActivity failed;failed.refreshLibrary();failed.scan->succeeded=false;failed.scan->ready=true;
+ const auto count=library::invalidations;failed.pollScan();
+ assert(failed.scanFailed&&failed.refreshSuggested&&library::invalidations==count);
+ std::cout<<"Both Library sorts, refresh handoff invalidation, queued retries, and scan failure passed\n";
+}
