+from pathlib import Path
+import sys
+s=Path(sys.argv[1]).read_text()
+a=s.index('void LibraryActivity::rebuildIndex(')
+b=s.index('  changeProbe.reset();',a)
+guard=s[a:b].replace('void LibraryActivity::rebuildIndex(const bool refresh)', 'void LibraryActivity::rebuildIndex(const bool refresh)')
+out=guard+'  ++launches;\n  scan = std::make_unique<Scan>();\n  scan->refresh = refresh;\n}\n'
+a=s.index('void LibraryActivity::pollScan()')
+b=s.index('void LibraryActivity::readRecentBook(',a)
+out+=s[a:b]
+a=s.index('void LibraryActivity::refreshLibrary()')
+b=s.index('void LibraryActivity::toggleFinishedBooks()',a)
+out+=s[a:b]
+Path(sys.argv[2]).write_text(out)
