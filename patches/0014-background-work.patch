+bool ActivityManager::closeExpiredActivityScope(const bool forSleep) {
+  const auto target = std::find_if(stackActivities.begin(), stackActivities.end(), [&](const auto& activity) {
+    return forSleep ? activity->closeBeforeSleep() : activity->idleTimeoutExpired();
+  });
+  const bool closesTop = forSleep && currentActivity && currentActivity->closeBeforeSleep();
+  if (target == stackActivities.end() && !closesTop) return false;
+
+  // On idle, resume the owning app first so it can drain writes through its
+  // normal result handlers. Sleep closes the owner and all of its children.
+  const size_t keep = target == stackActivities.end()
+                          ? stackActivities.size()
+                          : static_cast<size_t>(target - stackActivities.begin()) + (forSleep ? 0 : 1);
+  RenderLock lock;
+  exitActivity(lock);
+  while (stackActivities.size() > keep) {
+    stackActivities.back()->onExit();
+    stackActivities.pop_back();
+  }
+  if (!stackActivities.empty()) {
+    currentActivity = std::move(stackActivities.back());
+    stackActivities.pop_back();
+    currentActivity->resultHandler = nullptr;
+    restoredActivityNeedsRender = true;
+  }
+  if (!forSleep) requestUpdate();
+  return true;
 }
 
