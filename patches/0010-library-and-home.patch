+};
+struct MappedInputManager {
+  enum class SwipeDir { None, Left, Right, Up, Down };
+  enum class Button { Confirm, Back, PageBack, PageForward, Left, Right };
+  SwipeDir swipe = SwipeDir::None;
+  bool tapped = false, releasedTouch = false, back = false, confirm = false;
+  int x = 0, y = 0;
+  unsigned held = 0;
+  SwipeDir wasSwipe() const { return swipe; }
+  bool hasTouchHardware() const { return true; }
+  bool wasTapInRect(int a, int b, int w, int h) const { return tapped && x >= a && x < a + w && y >= b && y < b + h; }
+  bool wasReleased(Button b) const { return (b == Button::Back && back) || (b == Button::Confirm && confirm); }
+  unsigned getHeldTime() const { return held; }
+};
+namespace ReaderUtils {
+constexpr unsigned GO_HOME_MS = 1000;
+}
