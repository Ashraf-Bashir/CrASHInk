+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+#include "components/AppNavigation.h"
+struct Rect {int x,y,width,height;explicit Rect(int x,int y,int w,int h):x(x),y(y),width(w),height(h){}};
+namespace HalDisplay {constexpr int FAST_REFRESH=0;}
+namespace EpdFontFamily {constexpr int BOLD=1,REGULAR=0;}
+constexpr int UI_12_FONT_ID=0;
+struct RenderLock {};
+struct GfxRenderer {
+ enum Orientation {Portrait,LandscapeClockwise};Orientation orientation=LandscapeClockwise;
+ mutable std::vector<uint8_t> pixels=std::vector<uint8_t>(480*800,255);
+ struct Label {int x,y;std::string text;};mutable std::vector<Label> labels;
+ int paints=0;
+ void setOrientation(Orientation o){orientation=o;}
+ int getScreenWidth()const{return orientation==Portrait?480:800;}int getScreenHeight()const{return orientation==Portrait?800:480;}
+ void getOrientedViewableTRBL(int* t,int* r,int* b,int* l)const{*t=*r=*b=*l=0;}
+ void clearScreen(){std::fill(pixels.begin(),pixels.end(),255);labels.clear();}
+ void drawPixel(int x,int y,bool black)const{if(x>=0&&x<getScreenWidth()&&y>=0&&y<getScreenHeight())pixels[y*getScreenWidth()+x]=black?0:255;}
+ void fillRect(int x,int y,int w,int h,bool black=true)const{for(int j=0;j<h;++j)for(int i=0;i<w;++i)drawPixel(x+i,y+j,black);}
+ void drawLine(int x,int y,int a,int b,int width=1,bool black=true)const {int n=std::max(std::abs(a-x),std::abs(b-y));for(int i=0;i<=n;++i)fillRect(x+(a-x)*i/std::max(1,n),y+(b-y)*i/std::max(1,n),width,width,black);}
+ void drawRoundedRect(int x,int y,int w,int h,int stroke,int radius,bool black)const {
+  for(int j=0;j<h;++j)for(int i=0;i<w;++i){int dx=std::max({radius-i,0,i-(w-1-radius)}),dy=std::max({radius-j,0,j-(h-1-radius)});if(dx*dx+dy*dy>radius*radius)continue;int ix=i-stroke,iy=j-stroke,iw=w-2*stroke,ih=h-2*stroke,rr=std::max(0,radius-stroke);int ax=std::max({rr-ix,0,ix-(iw-1-rr)}),ay=std::max({rr-iy,0,iy-(ih-1-rr)});if(ix<0||iy<0||ix>=iw||iy>=ih||ax*ax+ay*ay>rr*rr)drawPixel(x+i,y+j,black);}
+ }
+ int getTextWidth(int,const char* text)const{return std::string(text).size()*12;}
+ std::string truncatedText(int,const char* text,int)const{return text;}
+ void drawText(int,int x,int y,const char* text,bool=true,int=0)const{labels.push_back({x,y,text});}
+ void displayBuffer(int){++paints;}
+};
+struct MappedInputManager {
+ enum class Button {Left,Right,Up,Down,Confirm};enum class SwipeDir {None,Left,Right};
+ int release=-1,x=0,y=0;bool down=false,held=false,tap=false,home=false;SwipeDir swipe=SwipeDir::None;
+ bool wasReleased(Button b)const{return release==int(b);}bool wasHomeGesture(){bool h=home;home=false;return h;}
+ bool wasScreenTouchDown(int& a,int& b)const{a=x;b=y;return down;}bool isScreenTouchHeld(int& a,int& b)const{a=x;b=y;return held;}
+ bool wasScreenTapped(int& a,int& b)const{a=x;b=y;return tap;}SwipeDir wasSwipe()const{return swipe;}
+ void suppressCurrentTouchContact(){down=held=tap=false;}void suppressNextBackRelease(){}void clearDeferredHomeGesture(){home=false;}
+ void clear(){release=-1;down=held=tap=home=false;swipe=SwipeDir::None;}
+};
+inline int redraws=0;
+struct Activity {
+ GfxRenderer& renderer;MappedInputManager& mappedInput;
+ Activity(const char*,GfxRenderer& r,MappedInputManager& i):renderer(r),mappedInput(i){}virtual ~Activity()=default;
+ virtual bool isHomeActivity()const{return false;}virtual void onEnter(){}virtual void loop(){}virtual void render(RenderLock&&){}
+ void requestUpdate(){++redraws;}
+};
+struct FakeWorkflowy:Activity {bool calendar;FakeWorkflowy(GfxRenderer& r,MappedInputManager& i,bool c=false):Activity("WF",r,i),calendar(c){}};
+using WorkflowyDailyActivity=FakeWorkflowy;
+struct Manager {
+ std::vector<AppNavigation::View> opened;std::unique_ptr<Activity> pending;
+ void goToLibrary(){opened.push_back(AppNavigation::View::Library);}void goToFileBrowser(){opened.push_back(AppNavigation::View::Browse);}void goToFileTransfer(){opened.push_back(AppNavigation::View::Transfer);}void goToSettings(){opened.push_back(AppNavigation::View::Settings);}
+ void replaceActivity(std::unique_ptr<WorkflowyDailyActivity> p){opened.push_back(p->calendar?AppNavigation::View::Calendar:AppNavigation::View::Workflowy);pending=std::move(p);}
+};inline Manager activityManager;
+template<class T,class... Args>std::unique_ptr<T> makeUniqueNoThrow(Args&&... args){return std::make_unique<T>(std::forward<Args>(args)...);}
+#define LOG_ERR(...) ((void)0)
+namespace UITheme {inline int getStatusBarHeight(){return 24;}}
+struct Gui {void drawDisplayStatusBar(GfxRenderer&,int){}};inline Gui GUI;
+enum StrId {STR_LIBRARY,STR_WORKFLOWY,STR_WORKFLOWY_CALENDAR_VIEW,STR_BROWSE,STR_FILE_TRANSFER,STR_SETTINGS_SHORT};
+inline const char* tr(StrId id){constexpr const char* words[]={"Library","Workflowy","Calendar","Browse","File Transfer","Settings"};return words[id];}
