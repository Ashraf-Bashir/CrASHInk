+uint32_t RecentBookProgress::loadCachedEpubTimeLeft(const RecentBook& book) {
+  const float progress = loadCachedEpubPercent(book);
+  if (progress < 0.5f || progress >= 99.5f) return 0;
+  const auto cachePath = Epub::cachePathForFilePath(book.path, "/.crosspoint");
+  const std::lock_guard<std::mutex> lock(percentCacheMutex);
+  auto* entry = findPercent(cachePath);
+  if (!entry) return 0;  // The progress cache was invalidated between reads.
+  if (!entry->timeLeftLoaded) {
