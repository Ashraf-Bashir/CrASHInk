+struct InputSnapshot {
+  bool touchPressed = false, touchReleased = false;
+};
+struct ActionEvent {
+  int action = 0, value = 0;
+};
+}  // namespace fui
+fui::InputSnapshot touchSnapshotFrom(const MappedInputManager& i) { return {false, i.releasedTouch}; }
+struct FakeApp {
+  int routes = 0;
