diff --git a/src/components/CoverGridLayout.h b/src/components/CoverGridLayout.h
new file mode 100644
--- /dev/null
+++ b/src/components/CoverGridLayout.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <algorithm>
+
+// Shared cover proportions/insets for Home and Library. Keep bitmap generation
+// at the exact painted size to avoid resampling already-dithered artwork.
+namespace CoverGridLayout {
+inline constexpr int Columns = 3;
+inline constexpr int CellInset = 6;
+struct Size {
+  int width;
+  int height;
+};
+inline Size coverSize(const int availableWidth, const int rowHeight) {
+  const int maxWidth = availableWidth / Columns - 2 * CellInset;
+  const int height = std::max(1, std::min(rowHeight - 2 * CellInset, maxWidth * 3 / 2));
+  return {std::max(1, height * 2 / 3), height};
+}
+}  // namespace CoverGridLayout
diff --git a/src/components/CoverProgressBadge.h b/src/components/CoverProgressBadge.h
new file mode 100644
--- /dev/null
+++ b/src/components/CoverProgressBadge.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <FreeInkUIGfxRenderer.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+#include "activities/reader/ReadingStatsUtils.h"
+
+namespace CoverProgressBadge {
+inline void draw(freeink::ui::DrawTarget& target, const freeink::ui::Rect cover, const int percent,
+                 const uint32_t timeLeftSeconds = 0) {
+  namespace fui = freeink::ui;
+  if (percent < 0) return;
+  char label[32];
+  const int percentLength = snprintf(label, sizeof(label), "%d%%", std::min(percent, 100));
+  if (timeLeftSeconds > 0) {
+    char duration[20];
+    formatCompactReadingDuration(timeLeftSeconds, duration, sizeof(duration));
+    // Compact the hours and minutes for the cover badge.
+    const char* space = std::strchr(duration, ' ');
+    if (space) std::memmove(duration + (space - duration), space + 1, std::strlen(space));
+    snprintf(label + percentLength, sizeof(label) - percentLength, " %s", duration);
+  }
+  fui::TextStyle style{};
+  style.font = fui::GfxRendererTarget::FONT_SMALL;
+  style.bold = true;
+  style.align = fui::TextAlign::Center;
+  constexpr int16_t inset = 4;
+  int width = target.measureText(style.font, label, style).width + 12;
+  if (width + 2 * inset > cover.width && timeLeftSeconds > 0) {
+    label[percentLength] = '\0';
+    width = target.measureText(style.font, label, style).width + 12;
+  }
+  const int height = target.lineHeight(style.font) + 6;
+  if (width + 2 * inset > cover.width || height + 2 * inset > cover.height) return;
+  const fui::Rect badge{static_cast<int16_t>(cover.x + (cover.width - width) / 2),
+                        static_cast<int16_t>(cover.bottom() - inset - height),
+                        static_cast<int16_t>(width), static_cast<int16_t>(height)};
+  target.fill(badge, fui::Paint::solid(fui::Color::White), 5);
+  target.stroke(badge, fui::Paint::solid(fui::Color::Black), 1, 5);
+  target.text(badge.inset(fui::Insets{3, 4, 3, 4}), label, style);
+}
+}  // namespace CoverProgressBadge
