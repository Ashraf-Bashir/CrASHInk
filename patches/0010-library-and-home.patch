+
+void LibraryActivity::openBookBatchActions() {
+  if (selectedBooks.empty()) return;
+  static constexpr StrId choices[]{StrId::STR_MARK_FINISHED, StrId::STR_MARK_UNFINISHED, StrId::STR_DELETE};
+  actionPopup.show(StrId::STR_LIBRARY_BATCH_ACTIONS, choices, 3, 0, [this](int choice) {
+    const auto action = static_cast<BatchAction>(choice);
+    if (action == BatchAction::Delete) {
+      char message[80];
+      snprintf(message, sizeof(message), tr(STR_LIBRARY_BATCH_DELETE_MESSAGE), unsigned(selectedBooks.size()));
+      openDialog(makeUniqueNoThrow<ConfirmationActivity>(renderer, mappedInput, tr(STR_DELETE), message),
+                 [this](const ActivityResult& result) {
+                   if (!result.isCancelled) applyBookBatch(BatchAction::Delete);
+                 });
+    } else {
+      applyBookBatch(action);
+    }
+  });
+  requestUpdate();
+}
+
+void LibraryActivity::applyBookBatch(BatchAction action) {
+  coverWorker.stop();
+  index.close();
+  auto books = std::move(selectedBooks);
+  finishBookSelection();
+  bool filesChanged = false;
+  bool stateChanged = false;
+  unsigned succeeded = 0;
+  for (const auto& [path, title] : books) {
+    if (action == BatchAction::Delete) {
+      if (Storage.remove(path.c_str())) {
+        filesChanged = true;
+        BookActions::clearFileMetadata(path);
+        RECENT_BOOKS.removeByPath(path);
+        if (APP_STATE.openEpubPath == path) {
+          APP_STATE.openEpubPath.clear();
+          stateChanged = true;
+        }
+        ++succeeded;
+      }
+    } else if (Storage.exists(path.c_str()) && BookActions::setBookCompleted(path, title, action == BatchAction::Finish)) {
+      RecentBookProgress::invalidateEpubTimeLeft(path);
+      if (action == BatchAction::Finish && SETTINGS.moveFinishedToReadFolder && !Storage.exists(path.c_str()))
+        filesChanged = true;
+      ++succeeded;
+    }
+    yield();
+  }
+  if (stateChanged) APP_STATE.saveToFile();
+  if (filesChanged) {
+    library::invalidateLibraryIndex();
+    scanCancelledThisVisit = false;
+  }
+  paintedGridPageStart = -1;
+  if (filesChanged && sort != Sort::RecentlyRead) {
+    rebuildIndex(true, true);
+    resetViewport();
+    requestUpdate();
+  } else {
+    reloadAfterBookAction();
+  }
+  coverWorker.start();
+  if (succeeded != books.size()) {
+    char message[80];
+    snprintf(message, sizeof(message), tr(STR_LIBRARY_BATCH_RESULT), succeeded, unsigned(books.size()));
+    BookActions::drawToast(renderer, message);
+    delay(ACTION_FEEDBACK_MS);
+  }
+}
