diff --git a/test/app_launcher/LauncherTest.cpp b/test/app_launcher/LauncherTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..33288a71d7ae08451c7d3bff5eb67e1becef2cd5
--- /dev/null
+++ b/test/app_launcher/LauncherTest.cpp
@@ -0,0 +1,21 @@
+#include "Harness.h"
+#include "activities/home/AppLauncherActivity.h"
+#include "components/CrASHinkLogo.h"
+void dump(const GfxRenderer& r,const char* path){std::ofstream f(path,std::ios::binary);f<<"P5\n"<<r.getScreenWidth()<<" "<<r.getScreenHeight()<<"\n255\n";f.write((const char*)r.pixels.data(),r.getScreenWidth()*r.getScreenHeight());}
+int main(){
+ GfxRenderer renderer;MappedInputManager input;
+ // A carried-over exit release must never select Calendar on the invisible Home.
+ input.tap=true;input.x=100;input.y=600;
+ AppLauncherActivity home(renderer,input);home.onEnter();assert(redraws==1&&renderer.orientation==GfxRenderer::Portrait);
+ home.loop();assert(activityManager.opened.empty());home.render(RenderLock{});assert(renderer.paints==1);
+ input.tap=true;home.loop();assert(activityManager.opened.empty());input.clear();
+ dump(renderer,"/tmp/crashink-launcher-native.pgm");std::ofstream labels("/tmp/crashink-launcher-labels.tsv");for(auto& l:renderer.labels)labels<<l.x<<"\t"<<l.y<<"\t"<<l.text<<"\n";labels.close();
+ // Right advances, Left reverses, Home selects the visible tile once.
+ input.release=int(MappedInputManager::Button::Right);home.loop();input.clear();input.home=true;home.loop();assert(activityManager.opened.back()==AppNavigation::View::Workflowy);
+ auto n=activityManager.opened.size();input.home=true;home.loop();assert(activityManager.opened.size()==n);
+ AppLauncherActivity next(renderer,input);input.clear();next.onEnter();next.render(RenderLock{});input.release=int(MappedInputManager::Button::Left);next.loop();input.clear();input.home=true;next.loop();assert(activityManager.opened.back()==AppNavigation::View::Settings);
+ // Bottom-right gear is fresh-touch activated; a swipe over it does not open it.
+ AppLauncherActivity touch(renderer,input);input.clear();touch.onEnter();touch.render(RenderLock{});input.x=360;input.y=650;input.down=true;touch.loop();input.clear();input.x=360;input.y=650;input.swipe=MappedInputManager::SwipeDir::Left;touch.loop();input.swipe=MappedInputManager::SwipeDir::None;input.tap=true;n=activityManager.opened.size();touch.loop();assert(activityManager.opened.size()==n);input.clear();input.x=360;input.y=650;input.down=true;touch.loop();input.down=false;input.tap=true;touch.loop();assert(activityManager.opened.back()==AppNavigation::View::Settings);
+ for(int view=0;view<6;++view){renderer.clearScreen();AppNavigation::draw(renderer,static_cast<AppNavigation::View>(view));input.clear();input.x=40;input.y=780;assert(AppNavigation::handleInput(renderer,input,static_cast<AppNavigation::View>(view))==false);input.tap=true;assert(AppNavigation::handleInput(renderer,input,static_cast<AppNavigation::View>(view)));}
+ renderer.clearScreen();drawCrASHinkLogo(renderer,180,300);dump(renderer,"/tmp/crashink-smile-native.pgm");
+}
