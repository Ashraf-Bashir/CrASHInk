+
+void BaseTheme::drawTouchscreenIndicator(const GfxRenderer& renderer, int topY, bool darkMode) const {
+  // Sits immediately to the right of the frontlight lamp icon, in the same
+  // top status bar row - drawn from drawTopStatusBarClock() right after
+  // drawFrontlightTempIndicators() so it shares that function's placement
+  // guarantees (renders every time, independent of clock/battery settings).
+  //
+  // Shows whether the reader touchscreen (SETTINGS.disableReaderTouchscreen)
+  // is currently usable: a plain hand when it is, the same hand with a
+  // diagonal strike through it when it's been turned off. Only relevant on
+  // touch hardware, so it's skipped entirely on button-only devices.
+  if (!gpio.hasTouch()) {
+    return;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int iconY = baseTopY + (statusBarHeight - touchStatusIconSize) / 2;
+  const int lampX = orientedMarginLeft + metrics.statusBarHorizontalMargin;
+  const int x = lampX + frontlightStatusIconSize + statusIndicatorGap;
+
+  const uint8_t* bits = SETTINGS.disableReaderTouchscreen ? icon_hand_off_bits : icon_hand_bits;
+  if (darkMode) {
+    renderer.drawIconInverted(bits, x, iconY, touchStatusIconSize);
+  } else {
+    renderer.drawIcon(bits, x, iconY, touchStatusIconSize);
+  }
+}
