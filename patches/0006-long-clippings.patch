+  for (int field = 0; field < 5; ++field) {
+    auto changed = key;
+    if (field == 0) ++changed.layout;
+    if (field == 1) ++changed.revision;
+    if (field == 2) ++changed.spine;
+    if (field == 3) ++changed.pageCount;
+    if (field == 4) changed.section = nullptr;
+    assert(cache.resetFor(changed));
+    assert(cache.find(1) == nullptr && cache.find(2) == nullptr);
+    cache.resetFor(key);
+    cache.claim(1).ready = true;
+    cache.claim(2).ready = true;
+  }
+  // A failed SD read is never frozen into a cached "no highlight" result.
+  CLIPPINGS.failRead = true;
+  ClippingPageMatchCache::Entry failed;
+  failed.page = 2;
+  reader.collectClippingPageMatches(reader.section->pages[2], failed, false);
+  assert(failed.failed && !failed.ready);
+  CLIPPINGS.failRead = false;
+  reader.collectClippingPageMatches(reader.section->pages[2], failed, false);
+  assert(failed.ready && failed.count == 1);
+  reader.section->failPage = true;
+  ClippingPageMatchCache::Entry failedNeighbor;
+  failedNeighbor.page = 2;
+  reader.collectClippingPageMatches(reader.section->pages[2], failedNeighbor, false);
+  assert(failedNeighbor.failed && !failedNeighbor.ready);
+  reader.section->failPage = false;
+  reader.collectClippingPageMatches(reader.section->pages[2], failedNeighbor, false);
+  assert(failedNeighbor.ready && failedNeighbor.count == 1);
+  for (int i = 0; i < 30; ++i) cache.claim(i).ready = true;
+  assert(cache.find(29) && !cache.find(0));
+  std::cout << "500-clipping idle preparation: " << slices
+            << " bounded slices; 100 cached renders: 0 text reads, 0 neighbor loads; invalidation, negative cache, and "
+               "I/O retries passed\n";
+}

