diff --git a/test/clipping_page_turn/ClippingPageTurnIoTest.cpp b/test/clipping_page_turn/ClippingPageTurnIoTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/clipping_page_turn/ClippingPageTurnIoTest.cpp
@@ -0,0 +1,102 @@
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "clippings/ClippingPageFilter.h"
+#define LOG_ERR(...) \
+  do {               \
+  } while (0)
+constexpr size_t CLIPPING_TEXT_MAX = 60U * 1024U;
+#include "ClippingRecord.inc"
+struct HalFile {
+  static inline unsigned readers = 0, opens = 0;
+  bool opened = false, failSeek = false, shortRead = false;
+  std::string bytes;
+  size_t position = 0;
+  explicit operator bool() const { return opened; }
+  bool seek(size_t offset) {
+    position = offset;
+    return opened && !failSeek && offset <= bytes.size();
+  }
+  int read(char* out, size_t size) {
+    const size_t count = std::min(size, bytes.size() - position);
+    const size_t actual = shortRead && count ? count - 1 : count;
+    std::memcpy(out, bytes.data() + position, actual);
+    position += actual;
+    return actual;
+  }
+  ~HalFile() {
+    if (opened) --readers;
+  }
+};
+using FsFile = HalFile;
+struct StorageStub {
+  bool failOpen = false;
+  std::string bytes;
+  bool openFileForRead(const char*, const std::string&, HalFile& file) {
+    if (failOpen) return false;
+    assert(!file.opened && HalFile::readers == 0);  // same-path reader restriction
+    file.opened = true;
+    file.bytes = bytes;
+    ++HalFile::readers;
+    ++HalFile::opens;
+    return true;
+  }
+} Storage;
+class ClippingStore {
+ public:
+  std::string storeFilePath = "clippings.bin";
+  std::vector<Clipping> clippings;
+  bool dirty = false, failWrite = false;
+  bool writeToFile(const std::string*, size_t) { return !failWrite; }
+  bool openTextReader(FsFile&) const;
+  bool readClippingText(const Clipping&, std::string&) const;
+  bool readClippingText(const Clipping&, std::string&, FsFile&) const;
+  bool updateClippingText(size_t, const std::string&);
+};
+#include "ClippingStoreReaders.inc"
+int main() {
+  ClippingStore store;
+  Storage.bytes = "alpha beta gamma";
+  Clipping clip;
+  clip.textLength = Storage.bytes.size();
+  std::string text;
+  for (int i = 0; i < 500; ++i) assert(store.readClippingText(clip, text));
+  const auto before = HalFile::opens;
+  assert(before == 500 && clip.textFilter.firstLength != 0);
+  {
+    FsFile reader;
+    assert(store.openTextReader(reader));
+    for (int i = 0; i < 500; ++i) assert(store.readClippingText(clip, text, reader));
+    assert(text == Storage.bytes && HalFile::opens == before + 1);
+    clip.textFilter = {};
+    reader.shortRead = true;
+    assert(!store.readClippingText(clip, text, reader));
+    assert(text.empty() && clip.textFilter.firstLength == 0);
+    reader.shortRead = false;
+    reader.failSeek = true;
+    assert(!store.readClippingText(clip, text, reader));
+  }
+  assert(HalFile::readers == 0);
+  Storage.failOpen = true;
+  text = "stale";
+  assert(!store.readClippingText(clip, text) && text.empty());
+  Storage.failOpen = false;
+  assert(store.readClippingText(clip, text));
+  store.clippings.push_back(clip);
+  const auto oldHash = clip.textFilter.firstHash;
+  store.failWrite = true;
+  assert(!store.updateClippingText(0, "new wording"));
+  assert(store.clippings[0].textFilter.firstHash == oldHash);
+  store.failWrite = false;
+  assert(store.updateClippingText(0, "new wording"));
+  assert(store.clippings[0].textFilter.firstLength == 0);
+  Storage.bytes = "new wording";
+  assert(store.readClippingText(store.clippings[0], text));
+  assert(store.clippings[0].textFilter.firstHash != oldHash);
+  std::cout << "500 clipping reads: file opens 500 -> 1; failed I/O, edit invalidation and rollback passed\n";
+}

