+bool ClippingStore::appendLastToFile(const std::string& text, const char* chapterTitle) {
+  // Only an existing current-format file whose records end exactly where memory
+  // says they do. Everything else takes the atomic full rewrite.
+  if (clippings.size() < 2 || fileVersion != VERSION || storeFilePath.empty()) return false;
+  const std::string backupPath = storeFilePath + ".bak";
+  const std::string tmpPath = storeFilePath + ".tmp";
+  if (!Storage.exists(storeFilePath.c_str()) || Storage.exists(backupPath.c_str()) ||
+      Storage.exists(tmpPath.c_str())) {
+    return false;
+  }
+  const Clipping& previous = clippings[clippings.size() - 2];
+  const uint32_t recordStart = previous.textOffset + previous.textLength;
+  Clipping& clipping = clippings.back();
+  const uint16_t count = static_cast<uint16_t>(clippings.size());
+
+  FsFile f = Storage.open(storeFilePath.c_str(), O_RDWR);
+  if (!f) return false;
+  uint8_t version = 0;
+  uint16_t storedCount = 0;
+  if (!serialization::tryReadPod(f, version) || version != VERSION || !serialization::tryReadPod(f, storedCount) ||
+      storedCount != count - 1 || f.size() < recordStart || !f.seek(recordStart)) {
+    f.close();
+    return false;
+  }
+  // Bytes past recordStart can only be an earlier append that never reached
+  // its count update; they are overwritten here.
+  bool ok = writeClippingRecord(f, clipping, chapterTitle) && serialization::tryWritePod(f, clipping.textLength);
+  const uint32_t textOffset = static_cast<uint32_t>(f.position());
+  if (ok && clipping.textLength > 0) {
+    ok = f.write(reinterpret_cast<const uint8_t*>(text.data()), clipping.textLength) == clipping.textLength;
+  }
+  ok = ok && f.sync();
+  // Commit point: the record exists for readers once the header counts it.
+  ok = ok && f.seek(sizeof(uint8_t)) && serialization::tryWritePod(f, count) && f.sync();
+  f.close();
+  if (!ok) {
+    LOG_ERR("CLIP", "Clipping append failed, rewriting store: %s", storeFilePath.c_str());
+    return false;
+  }
+  clipping.textOffset = textOffset;
+  return true;
+}
+
+uint32_t ClippingStore::titleOffset(const Clipping& clipping) const {
+  return clipping.textOffset - textLengthFieldBytes(fileVersion) - CLIPPING_CHAPTER_TITLE_MAX;
+}
+
+bool ClippingStore::readChapterTitle(const size_t index, std::string& out) const {
+  out.clear();
+  const Clipping* clipping = clippingAt(index);
+  if (!clipping || storeFilePath.empty()) return false;
+  FsFile f;
+  if (!Storage.openFileForRead("CLIP", storeFilePath, f)) return false;
+  char title[CLIPPING_CHAPTER_TITLE_MAX] = {};
+  const bool ok = f.seek(titleOffset(*clipping)) &&
+                  f.read(reinterpret_cast<uint8_t*>(title), sizeof(title)) == static_cast<int>(sizeof(title));
+  f.close();
+  if (!ok) return false;
+  sanitizeChapterTitle(title);
+  out = title;
+  return true;
+}
