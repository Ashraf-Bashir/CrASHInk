diff --git a/src/clippings/ClippingPageFilter.h b/src/clippings/ClippingPageFilter.h
new file mode 100644
--- /dev/null
+++ b/src/clippings/ClippingPageFilter.h
@@ -0,0 +1,124 @@
+#pragma once
+
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+#include "ClippingTextMatcher.h"
+
+// A rejection filter only: collisions and uncertain fragments always fall back
+// to the existing matcher. No text, layout coordinates, or owning pointers.
+namespace clippingPageFilter {
+struct Prefix {
+  uint32_t hash = 2166136261U;
+  uint8_t length = 0;
+  uint8_t shortHashes[2] = {};
+};
+inline bool space(uint32_t cp) {
+  return (cp < 128 && std::isspace(static_cast<unsigned char>(cp))) || cp == 0xA0 || cp == 0x2003 || cp == 0x202F;
+}
+inline uint32_t append(uint32_t hash, uint32_t cp) {
+  return (hash ^ ClippingTextMatcher::foldForMatch(cp)) * 16777619U;
+}
+inline uint8_t shortHash(uint32_t hash) { return static_cast<uint8_t>(hash ^ (hash >> 16)); }
+inline uint64_t hashBit(uint32_t hash) { return uint64_t{1} << ((hash ^ (hash >> 16)) & 63); }
+inline Prefix prefix(const char* text, size_t size) {
+  Prefix result;
+  size_t offset = 0;
+  while (offset < size && result.length < 3) {
+    const auto cp = ClippingTextMatcher::nextCodepoint(text, size, offset);
+    if (!result.length && ClippingTextMatcher::isEdgePunctuation(cp)) continue;
+    result.hash = append(result.hash, cp);
+    if (result.length < 2) result.shortHashes[result.length] = shortHash(result.hash);
+    ++result.length;
+  }
+  return result;
+}
+struct Text {
+  uint64_t continuations = 0;
+  uint32_t firstHash = 0;
+  uint8_t shortHashes[2] = {};
+  uint8_t firstLength = 0;  // 0: not built; 255: cannot safely reject
+  void build(const char* text, size_t size) {
+    *this = {};
+    size_t offset = 0;
+    while (offset < size) {
+      size_t start = offset;
+      auto cp = ClippingTextMatcher::nextCodepoint(text, size, offset);
+      if (space(cp)) continue;
+      size_t end = offset;
+      while (offset < size) {
+        size_t next = offset;
+        cp = ClippingTextMatcher::nextCodepoint(text, size, next);
+        if (space(cp)) break;
+        offset = next;
+        end = offset;
+      }
+      const auto value = prefix(text + start, end - start);
+      // Punctuation-only tokens and embedded NUL text take the original path.
+      if (!value.length || std::memchr(text + start, 0, end - start)) {
+        firstLength = 255;
+        return;
+      }
+      if (!firstLength) {
+        firstHash = value.hash;
+        firstLength = value.length;
+        shortHashes[0] = value.shortHashes[0];
+        shortHashes[1] = value.shortHashes[1];
+      }
+      continuations |= hashBit(value.hash);
+    }
+    if (!firstLength) firstLength = 255;
+  }
+};
+static_assert(sizeof(Text) <= 16, "Per-clipping filter must stay bounded");
+struct Page {
+  uint64_t starts[3][4] = {};
+  uint64_t shortWords[2][4] = {};
+  uint64_t continuationQueries = 0;
+  bool first = true;
+  bool uncertainStart = false;
+  bool uncertainContinuation = false;
+  void addWord(const char* text, bool insertedHyphen) {
+    size_t size = std::strlen(text);
+    if (insertedHyphen && size && text[size - 1] == '-') --size;
+    size_t offset = 0;
+    uint32_t hash = 2166136261U;
+    uint8_t length = 0;
+    uint64_t queries = 0;
+    while (offset < size && length < 3) {
+      const auto cp = ClippingTextMatcher::nextCodepoint(text, size, offset);
+      if (!length && ClippingTextMatcher::isEdgePunctuation(cp)) continue;
+      hash = append(hash, cp);
+      const uint8_t key = shortHash(hash);
+      starts[length++][key / 64] |= uint64_t{1} << (key % 64);
+      queries |= hashBit(hash);
+    }
+    // Short hyphen fragments may precede the rest of a token on another line.
+    const bool uncertain = !length;
+    if (length && length < 3) {
+      const uint8_t key = shortHash(hash);
+      shortWords[length - 1][key / 64] |= uint64_t{1} << (key % 64);
+    }
+    uncertainStart |= uncertain;
+    if (first) {
+      continuationQueries = queries;
+      uncertainContinuation = uncertain || length < 3;
+      first = false;
+    }
+  }
+  bool mayMatch(const Text& text, bool tableColumn) const {
+    // A table-column continuation can start after another column's words.
+    if (tableColumn || text.firstLength == 0 || text.firstLength == 255 || uncertainStart || uncertainContinuation)
+      return true;
+    for (uint8_t i = 0; i < 2 && i + 1 < text.firstLength; ++i) {
+      const auto key = text.shortHashes[i];
+      if (shortWords[i][key / 64] & (uint64_t{1} << (key % 64))) return true;
+    }
+    const uint8_t key = shortHash(text.firstHash);
+    return (starts[text.firstLength - 1][key / 64] & (uint64_t{1} << (key % 64))) ||
+           (continuationQueries & text.continuations);
+  }
+};
+}  // namespace clippingPageFilter

