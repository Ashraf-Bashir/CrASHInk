+class EpubReaderActivity {
+ public:
+  std::unique_ptr<Section> section = std::make_unique<Section>();
+  int currentSpineIndex = 0;
+  uint32_t activeSectionLayoutSignature = 17;
+  void collectClippingPageMatches(const Page&, ClippingPageMatchCache::Entry&, bool);
+};
+#include "ClippingCollector.inc"
+int main() {
+  EpubReaderActivity reader;
+  Clipping clip;
+  clip.spineIndex = 0;
+  clip.pageCount = 1000;
+  clip.wordCount = 2;
+  // 500 imported clips; the matching one is intentionally last so every slice
+  // must resume its real production collector cursor correctly.
+  CLIPPINGS.records.assign(500, clip);
+  CLIPPINGS.texts.assign(500, "different wording");
+  CLIPPINGS.texts.back() = "alpha beta";
+  ClippingPageMatchCache cache;
+  ClippingPageMatchCache::Key key{reader.section.get(), 17, 1, 0, 4};
+  assert(cache.resetFor(key));
+  auto& entry = cache.claim(2);
+  size_t slices = 0;
+  while (!entry.ready) {
+    const auto before = entry.nextClipping;
+    reader.collectClippingPageMatches(reader.section->pages[2], entry, true);
+    assert(entry.nextClipping > before && entry.nextClipping - before <= 8);
+    assert(++slices <= 500);
+  }
+  assert(entry.count == 1 && entry.clippingIndices[0] == 499);
+  assert(entry.matches[0].startWord == 0 && entry.matches[0].endWord == 0);
+  assert(reader.section->currentPage == 0);  // prefetched page != visible page
+  assert(std::find(reader.section->reads.begin(), reader.section->reads.end(), 3) != reader.section->reads.end());
+  ClippingPageMatchCache::Entry synchronous;
+  synchronous.page = 2;
+  reader.collectClippingPageMatches(reader.section->pages[2], synchronous, false);
+  assert(synchronous.ready && synchronous.count == entry.count);
+  assert(synchronous.clippingIndices[0] == entry.clippingIndices[0]);
+  assert(synchronous.matches[0].startWord == entry.matches[0].startWord);
+  const auto textReads = CLIPPINGS.reads, pageReads = reader.section->reads.size();
+  for (int repaint = 0; repaint < 100; ++repaint) {
+    auto& hit = cache.claim(2);
+    if (!hit.ready) reader.collectClippingPageMatches(reader.section->pages[2], hit, false);
+    assert(hit.count == 1);
+  }
+  assert(CLIPPINGS.reads == textReads && reader.section->reads.size() == pageReads);
+  // Cache pages with no matches too; otherwise empty pages retain the delay.
+  auto& empty = cache.claim(1);
+  reader.collectClippingPageMatches(reader.section->pages[1], empty, false);
+  assert(empty.ready && empty.count == 0);
+  assert(cache.find(1)->ready);
