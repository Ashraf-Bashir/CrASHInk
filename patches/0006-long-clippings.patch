diff --git a/src/clippings/ClippingPageMatchCache.h b/src/clippings/ClippingPageMatchCache.h
new file mode 100644
--- /dev/null
+++ b/src/clippings/ClippingPageMatchCache.h
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Resolved positive AND negative results. Entries contain no Page/TextBlock
+// pointers; repainting a prepared page needs no text reads or text matching.
+class ClippingPageMatchCache {
+ public:
+  struct Match {
+    uint16_t startWord = 0;
+    uint16_t endWord = 0;
+    uint16_t tableSelection = UINT16_MAX;
+    uint16_t matchedTokens = 0;
+    bool startsAtClipStart = false;
+    bool reachesClipEnd = false;
+  };
+  static constexpr size_t MATCHES = 16;
+  static constexpr size_t PAGES = 6;
+  struct Key {
+    const void* section = nullptr;
+    uint32_t layout = 0;
+    uint32_t revision = 0;
+    int spine = -1;
+    int pageCount = 0;
+    bool operator==(const Key& other) const {
+      return section == other.section && layout == other.layout && revision == other.revision && spine == other.spine &&
+             pageCount == other.pageCount;
+    }
+  };
+  struct Entry {
+    std::array<Match, MATCHES> matches{};
+    std::array<size_t, MATCHES> clippingIndices{};
+    size_t nextClipping = 0;
+    uint32_t usedAt = 0;
+    int page = -1;
+    uint16_t count = 0;
+    bool ready = false;
+    bool failed = false;
+  };
+  bool resetFor(const Key& next) {
+    if (key == next) return false;
+    key = next;
+    entries = {};
+    tick = 0;
+    return true;
+  }
+  Entry* find(int page) {
+    for (auto& entry : entries) {
+      if (entry.page == page) {
+        entry.usedAt = ++tick;
+        return &entry;
+      }
+    }
+    return nullptr;
+  }
+  Entry& claim(int page) {
+    if (auto* entry = find(page)) return *entry;
+    auto* victim = &entries[0];
+    for (auto& entry : entries) {
+      if (entry.page < 0) {
+        victim = &entry;
+        break;
+      }
+      if (entry.usedAt < victim->usedAt) victim = &entry;
+    }
+    *victim = {};
+    victim->page = page;
+    victim->usedAt = ++tick;
+    return *victim;
+  }
+
+ private:
+  Key key;
+  std::array<Entry, PAGES> entries{};
+  uint32_t tick = 0;
+};
+static_assert(sizeof(ClippingPageMatchCache) <= 2304, "Bounded nearby-page result cache");

