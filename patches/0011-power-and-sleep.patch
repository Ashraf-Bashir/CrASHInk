+  const size_t bytes = file->size();
+  if (bytes == 0 || bytes > INT32_MAX) {
+    file->close();
+    return nullptr;
+  }
+  *size = static_cast<int32_t>(bytes);
+  return file.release();  // AnimatedGIF calls closeGif for this handle.
+}
+
+void closeGif(void* handle) {
+  auto* file = static_cast<HalFile*>(handle);
+  if (!file) return;
+  file->close();
+  delete file;
+}
+
+int32_t readGif(GIFFILE* source, uint8_t* buffer, int32_t length) {
+  auto* file = static_cast<HalFile*>(source->fHandle);
+  const int32_t remaining = source->iSize - source->iPos;
+  if (length <= 0 || remaining <= 0) return 0;
+  const int read = file->read(buffer, std::min(length, remaining));
+  if (read > 0) source->iPos += read;
+  return std::max(0, read);
+}
+
+int32_t seekGif(GIFFILE* source, int32_t position) {
+  auto* file = static_cast<HalFile*>(source->fHandle);
+  if (position < 0 || position > source->iSize || !file->seek(position)) return -1;
+  source->iPos = position;
+  return position;
+}
+
+constexpr size_t headerSize = 70;
+
+// The sleeping cover renderer already accepts top-down 2-bit grayscale BMPs.
+bool writeHeader(HalFile& out, int width, int height, int stride, bool imageLevels) {
+  std::array<uint8_t, headerSize> header{};
+  const auto set = [&](size_t pos, uint32_t value, int bytes = 4) {
+    for (int i = 0; i < bytes; ++i) header[pos + i] = static_cast<uint8_t>(value >> (i * 8));
+  };
+  header[0] = 'B';
+  header[1] = 'M';
+  set(2, headerSize + stride * height);
+  set(10, headerSize);
+  set(14, 40);
+  set(18, width);
+  set(22, static_cast<uint32_t>(-height));
+  set(26, 1, 2);
+  set(28, 2, 2);
+  set(34, stride * height);
+  set(46, 4);
+  set(50, 4);
+  const uint8_t levels[] = {0, uint8_t(imageLevels ? 120 : 85), uint8_t(imageLevels ? 190 : 170), 255};
+  for (int i = 0; i < 4; ++i) memset(header.data() + 54 + 4 * i, levels[i], 3);
+  return out.write(header.data(), header.size()) == header.size();
+}
+
+struct GifRows {
+  HalFile& out;
+  uint8_t* row;
+  int width, height, stride, sourceWidth, sourceHeight;
+  bool failed = false;
+  bool drew = false;
+};
+
+void writeGifRow(GIFDRAW* source) {
+  auto& ctx = *static_cast<GifRows*>(source->pUser);
+  if (ctx.failed) return;
+  const int sourceY = source->iY + source->y;
+  if (sourceY < 0 || sourceY >= ctx.sourceHeight) {
+    ctx.failed = true;
+    return;
+  }
+  ctx.drew = true;
+  const auto scaleY = [&](int y) { return (y * ctx.height + ctx.sourceHeight - 1) / ctx.sourceHeight; };
+  const int first = scaleY(sourceY);
+  const int end = scaleY(sourceY + 1);
+  if (first == end) return;
+  memset(ctx.row, 0xff, ctx.stride);
+  for (int x = 0; x < ctx.width; ++x) {
+    const int pixel = x * ctx.sourceWidth / ctx.width - source->iX;
+    if (pixel < 0 || pixel >= source->iWidth) continue;
+    const uint8_t value = source->pPixels[pixel];
+    if (source->ucHasTransparency && value == source->ucTransparent) continue;
+    const auto* rgb = source->pPalette24 + value * 3;
+    const int gray = (77 * rgb[0] + 150 * rgb[1] + 29 * rgb[2]) >> 8;
+    const int shift = 6 - 2 * (x % 4);
+    ctx.row[x / 4] = (ctx.row[x / 4] & ~(3 << shift)) | (((gray * 3 + 127) / 255) << shift);
+  }
+  ctx.failed = !ctx.out.seek(headerSize + first * ctx.stride);
+  // Interlaced GIFs can deliver rows out of order, so seek to the scaled row.
+  for (int y = first; y < end && !ctx.failed; ++y)
+    ctx.failed = ctx.out.write(ctx.row, ctx.stride) != static_cast<size_t>(ctx.stride);
+}
+}  // namespace
+
+bool SleepGif::toBitmap(const std::string& path, HalFile& output, int maxWidth, int maxHeight, bool imageLevels) {
+  // AnimatedGIF owns its LZW tables. Heap allocation avoids a large stack frame.
+  auto gif = makeUniqueNoThrow<AnimatedGIF>();
+  if (!gif) return false;
+  gif->begin(GIF_PALETTE_RGB888);
+  if (!gif->open(path.c_str(), openGif, closeGif, readGif, seekGif, writeGifRow)) {
+    LOG_ERR("SLP", "Could not open sleep GIF (error %d): %s", gif->getLastError(), path.c_str());
+    gif->close();
+    return false;
+  }
+  const int sourceWidth = gif->getCanvasWidth();
+  const int sourceHeight = gif->getCanvasHeight();
+  // Bound decode time while still allowing tall phone-size backgrounds.
+  if (sourceWidth <= 0 || sourceHeight <= 0 || sourceHeight > 4096 || maxWidth <= 0 || maxHeight <= 0) {
+    gif->close();
+    return false;
+  }
+  const int width = std::max(1, std::min({sourceWidth, maxWidth, sourceWidth * maxHeight / sourceHeight}));
+  const int height = std::max(1, sourceHeight * width / sourceWidth);
+  const int stride = (width + 15) / 16 * 4;
+  auto row = makeUniqueNoThrow<uint8_t[]>(stride);
+  if (!row || !writeHeader(output, width, height, stride, imageLevels)) {
+    gif->close();
+    return false;
+  }
+  // Initialize the canvas for transparent pixels and GIFs whose first frame is
+  // smaller than the canvas. No full image buffer is needed.
+  memset(row.get(), 0xff, stride);
+  for (int y = 0; y < height; ++y) {
+    if (output.write(row.get(), stride) != static_cast<size_t>(stride)) {
+      gif->close();
+      return false;
+    }
+  }
+  GifRows ctx{output, row.get(), width, height, stride, sourceWidth, sourceHeight};
+  const int result = gif->playFrame(false, nullptr, &ctx);
+  const bool success = result >= 0 && ctx.drew && !ctx.failed && gif->getLastError() == GIF_SUCCESS;
+  gif->close();
+  return success;
+}
