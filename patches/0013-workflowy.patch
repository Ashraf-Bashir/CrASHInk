+    std::string zoomId;
+    size_t page;
+  };
+  std::vector<View> viewStack;
+  struct Prefetch {
+    std::string key, parent, target;
+    unsigned depth = 0, generation = 0;
+    bool root = false;
+    std::atomic<bool> ready{false};
+    std::atomic<bool> cancel{false};
+    int status = 0, transport = 0;
+    std::vector<Node> children;
+  };
+  std::shared_ptr<Prefetch> prefetch;
