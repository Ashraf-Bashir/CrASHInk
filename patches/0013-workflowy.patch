+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "activities/Activity.h"
+
+class WorkflowyDailyActivity final : public Activity {
+ public:
+  WorkflowyDailyActivity(GfxRenderer& renderer, MappedInputManager& input);
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  bool allowGlobalHomeSwipeGesture() const override { return false; }
+
+ private:
+  struct Node {
+    std::string id;
+    std::string title;
+    unsigned depth = 0;
+    int priority = 0;
+    bool todo = false;
+    bool done = false;
+    bool expanded = false;
+    bool leaf = false;
+  };
+
+  enum class Step { Start, Waiting, Load, Ready };
+  Step step = Step::Start;
+  std::vector<Node> rows;
+  std::string credential;
+  std::string date;
+  const char* message = nullptr;
+  bool ownsWifi = false;
+  bool showDone = false;
+  size_t page = 0;
+  int touchX = 0;
+  int touchY = 0;
+  int lastX = 0;
+  int lastY = 0;
+  unsigned long touchAt = 0;
+  bool tracking = false;
+  bool moved = false;
+
+  struct Layout {
+    int x, top, width, rowTop, footer, rowsPerPage;
+  };
+  Layout layout() const;
+  int rowAt(int x, int y) const;
+  size_t visibleCount() const;
+  void nextPage(int delta);
+  void showMessage(const char* text);
+  void connect();
+  void editKey();
+  int request(const char* method, const std::string& path, const std::string& body, uint8_t* response = nullptr,
+              size_t* received = nullptr);
+  bool loadChildren(const std::string& parent, unsigned depth, std::vector<Node>& result);
+  void loadDay();
+  void toggle(size_t row);
+  void expand(size_t row);
+  void actions(size_t row);
+  void edit(size_t row);
+  void chooseDate(std::string moveId = {});
+  void moveToDate(const std::string& id, const std::string& target);
+};
