+  std::function<bool()> undoAction;
+  bool undoReady = false;
+  bool undoIsDelete = false;
+  std::string pendingDelete;
+  unsigned long deleteAt = 0;
+  void offerUndo(std::function<bool()> action, bool forDelete = false);
+  void undo();
+  bool queueCapture(const std::string& body);
+  void flushCapture();
+  void reviewCapture();
+  void commitDelete();
+  struct MoveOrigin {
+    std::string parent, parentNode, neighbour;
+    unsigned depth;
+    bool after;
+  };
+  MoveOrigin moveOrigin(size_t source) const;
+  bool restoreMove(const std::string& id, const MoveOrigin& origin);
+  bool reorderSiblings(const std::string& parentId, const std::string& parentNode, unsigned depth,
+                       std::string sourceId, std::string targetId, bool after, bool recordUndo);
+  bool moveNode(const std::string& id, const std::string& parent, const char* position = "bottom");
+  void indent(size_t source, size_t target);
+  bool dragging = false;
+  std::string zoomId;
+  struct View {
