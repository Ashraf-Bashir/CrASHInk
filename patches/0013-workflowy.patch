+void WorkflowyDailyActivity::toggleSelection(size_t row) {
+  if (!selectionEligible(rows[row])) return;
+  {
+    RenderLock lock(*this);
+    rows[row].selected = !rows[row].selected;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::selectAll() {
+  {
+    RenderLock lock(*this);
+    for (auto& row : rows) row.selected = selectionEligible(row);
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::showBulkMenu() {
+  if (selectionCount() == 0) return;
+  const bool hasTodo = std::any_of(rows.begin(), rows.end(),
+                                   [&](const Node& row) { return row.todo && row.selected; });
+  std::vector<std::string> choices;
+  if (hasTodo) {
+    choices.emplace_back(tr(STR_WORKFLOWY_MARK_DONE));
+    choices.emplace_back(tr(STR_WORKFLOWY_MARK_UNDONE));
+  }
+  choices.emplace_back(tr(STR_WORKFLOWY_MOVE));
+  choices.emplace_back(tr(STR_DELETE));
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                            renderer, mappedInput, "WorkflowyBulk", StrId::STR_WORKFLOWY_BULK_ACTIONS,
+                            std::move(choices), 0, false, true),
+                         [this, hasTodo](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    int selected = std::get<OptionSelectionResult>(result.data).index;
+    if (hasTodo) {
+      if (selected == 0) return startBulk(BulkAction::Done);
+      if (selected == 1) return startBulk(BulkAction::Undone);
+      selected -= 2;
+    }
+    if (selected == 0) return showBulkMoveMenu();
+    if (selected == 1) {
+      char prompt[64];
+      snprintf(prompt, sizeof(prompt), tr(STR_WORKFLOWY_BULK_DELETE), static_cast<unsigned>(selectionCount()));
+      startActivityForResult(std::make_unique<ConfirmationActivity>(renderer, mappedInput, tr(STR_DELETE), prompt),
+                             [this](const ActivityResult& confirmed) {
+        if (!confirmed.isCancelled) startBulk(BulkAction::Delete);
+      });
+    }
+  });
+}
+
+void WorkflowyDailyActivity::showBulkMoveMenu() {
+  std::vector<std::string> targets, labels;
+  if (!zoomId.empty() && rows.size() > 1 && rows[1].depth > 0) {
+    targets.push_back(parentDestination(rows[1].id));
+    labels.emplace_back(tr(STR_WORKFLOWY_MOVE_PARENT));
+  }
+  constexpr StrId days[] = {StrId::STR_WORKFLOWY_MOVE_YESTERDAY, StrId::STR_WORKFLOWY_MOVE_TODAY,
+                             StrId::STR_WORKFLOWY_MOVE_TOMORROW};
+  for (int delta = -1; delta <= 1; ++delta) {
+    auto day = isoDate(delta);
+    if (day.empty() && delta >= 0) day = delta == 0 ? "today" : "tomorrow";
+    if (day.empty() || day == date || (delta == 0 && date == "today") || (delta == 1 && date == "tomorrow")) continue;
+    targets.push_back(std::move(day));
+    labels.emplace_back(I18n::getInstance().get(days[delta + 1]));
+  }
+  labels.emplace_back(tr(STR_WORKFLOWY_MOVE_DATE));
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyBulkMove", StrId::STR_WORKFLOWY_MOVE,
+                             std::move(labels), 0, false, true),
+                         [this, targets = std::move(targets)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t choice = std::get<OptionSelectionResult>(result.data).index;
+    if (choice < targets.size()) return startBulk(BulkAction::MoveDate, targets[choice]);
+    const auto today = isoDate(0);
+    startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, StrId::STR_WORKFLOWY_MOVE_DATE,
+                              validDate(date) ? date : today, today), [this](const ActivityResult& picked) {
+      if (!picked.isCancelled) startBulk(BulkAction::MoveDate, std::get<KeyboardResult>(picked.data).text);
+    });
+  });
+}
+
+void WorkflowyDailyActivity::startBulk(BulkAction action, std::string target) {
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const bool completion = action == BulkAction::Done || action == BulkAction::Undone;
+  const bool done = action == BulkAction::Done;
+  const auto label = completion ? (done ? StrId::STR_WORKFLOWY_MARK_DONE : StrId::STR_WORKFLOWY_MARK_UNDONE)
+                                : (action == BulkAction::Delete ? StrId::STR_DELETE : StrId::STR_WORKFLOWY_MOVE);
+  std::vector<std::string> items;
+  for (const auto& row : rows) {
+    if (row.selected && !itemPending(row.id) && (!completion || (row.todo && row.done != done))) items.push_back(row.id);
+  }
+  if (items.size() > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  for (const auto& id : items) {
+    auto path = "/" + id;
+    std::string body;
+    if (completion) path += done ? "/complete" : "/uncomplete";
+    else if (action == BulkAction::MoveDate) {
+      JsonDocument update;
+      update["parent_id"] = target;
+      update["position"] = "bottom";
+      path += "/move";
+      body = encode(update);
+    }
+    if (!queueSave(std::move(path), std::move(body), false, [this, id, done, completion, action, target](const Save& save) {
+          if (save.status < 200 || save.status >= 300) {
+            if (completion) updateCompletion(id, !done);
+            return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+          }
+          if (!completion) {
+            const bool sameDay = action == BulkAction::MoveDate && (target == date ||
+                (date == "today" && target == isoDate(0)) || (date == "tomorrow" && target == isoDate(1)));
+            removeNode(id, sameDay);
+          }
+        }, action == BulkAction::Delete ? "DELETE" : "POST", label, id)) break;
+    if (completion) updateCompletion(id, done);
+  }
+  cancelSelection();
+}
+
+void WorkflowyDailyActivity::actions(const size_t row) {
+  if (itemPending(rows[row].id)) return;
+  std::vector<std::string> options{
+      tr(STR_EDIT), tr(STR_WORKFLOWY_ZOOM), tr(STR_WORKFLOWY_MOVE),
+      tr(STR_WORKFLOWY_TURN_INTO), tr(STR_DELETE)};
+  if (zoomId.empty() || row != 0) {
+    options.emplace_back(tr(STR_WORKFLOWY_ADD_ABOVE));
+    options.emplace_back(tr(STR_WORKFLOWY_ADD_BELOW));
+  }
+  const int complete = rows[row].todo ? static_cast<int>(options.size()) : -1;
+  if (complete >= 0)
+    options.emplace_back(rows[row].done ? tr(STR_WORKFLOWY_MARK_UNDONE) : tr(STR_WORKFLOWY_MARK_DONE));
+  const int multi = selectionEligible(rows[row]) ? static_cast<int>(options.size()) : -1;
+  if (multi >= 0) options.emplace_back(tr(STR_WORKFLOWY_SELECT_MULTIPLE));
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyItem", StrId::STR_WORKFLOWY, std::move(options),
+                             0, false, true),
+                         [this, row, complete, multi](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const int selected = std::get<OptionSelectionResult>(result.data).index;
+    const auto id = rows[row].id;
+    if (multi >= 0 && selected == multi) {
+      {
+        RenderLock lock(*this);
+        selecting = true;
+      }
+      return toggleSelection(row);
+    }
+    if (complete >= 0 && selected == complete) return toggle(row);
+    if (selected == 0) return edit(row);
+    if ((zoomId.empty() || row != 0) && (selected == 5 || selected == 6))
+      return edit(row, selected == 5 ? -1 : 1);
+    if (selected == 1) return zoom(row);
+    if (selected == 2) return showMoveMenu(row);
+    if (selected == 3) {
+      const bool todo = !rows[row].todo;
+      const auto label = todo ? StrId::STR_WORKFLOWY_TO_TODO : StrId::STR_WORKFLOWY_TO_BULLET;
+      startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                                 renderer, mappedInput, "WorkflowyTurnInto", StrId::STR_WORKFLOWY_TURN_INTO,
+                                 std::vector<std::string>{todo ? tr(STR_WORKFLOWY_TODO_TYPE) : tr(STR_WORKFLOWY_BULLET_TYPE)},
+                                 0, false, true),
+                             [this, id, todo, label](const ActivityResult& choice) {
+        if (choice.isCancelled || itemPending(id)) return;
+        const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        if (item == rows.end()) return;
+        const auto title = item->title;
+        JsonDocument update;
+        update["layoutMode"] = todo ? "todo" : "bullets";
+        if (queueSave("/" + id, encode(update), false, [this, id, todo, title](const Save& save) {
+              if (save.status >= 200 && save.status < 300) return;
+              applyTitle(id, title, !todo);
+              showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+            }, "POST", label, id)) {
+          applyTitle(id, title, todo);
+        }
+      });
+    } else if (selected == 4) {
+      startActivityForResult(std::make_unique<ConfirmationActivity>(
+                                 renderer, mappedInput, tr(STR_DELETE), rows[row].title),
+                             [this, id](const ActivityResult& confirmation) {
+        if (confirmation.isCancelled) return;
+        if (!hasActiveStationWifiConnection()) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+        commitDelete();
+        if (!pendingDelete.empty()) return;
+        {
+          RenderLock lock(*this);
+          pendingDelete = id;
+          deleteAt = millis() + DELETE_GRACE;
+          layoutDirty = true;
+        }
+        offerUndo([this] {
+          RenderLock lock(*this);
+          pendingDelete.clear();
+          layoutDirty = true;
+          return true;
+        }, true);
+      });
+    }
+  });
+}
+
+std::string WorkflowyDailyActivity::parentOf(const std::string& id) const {
+  if (id.empty()) return {};
+  const auto findParent = [&](const std::vector<Node>& outline) -> std::string {
+    auto node = std::find_if(outline.begin(), outline.end(), [&](const Node& item) { return item.id == id; });
+    if (node == outline.end() || node->depth == 0) return {};
+    const auto depth = node->depth;
+    while (node != outline.begin()) {
+      if ((--node)->depth < depth) return node->id;
+    }
+    return {};
+  };
+  if (auto parent = findParent(rows); !parent.empty()) return parent;
+  for (auto view = viewStack.rbegin(); view != viewStack.rend(); ++view) {
+    if (auto parent = findParent(view->rows); !parent.empty()) return parent;
+  }
+  return {};
+}
+
+std::string WorkflowyDailyActivity::parentDestination(const std::string& id) const {
+  auto destination = parentOf(parentOf(id));
+  return destination.empty() ? date : destination;
+}
+
+void WorkflowyDailyActivity::showMoveMenu(size_t row) {
+  const auto id = rows[row].id;
+  const bool sibling = zoomId.empty() || row != 0;
+  const auto origin = moveOrigin(row);
+  enum class Move { Top, Bottom, Parent, Date, Day };
+  struct Choice { Move action; std::string target; };
+  std::vector<Choice> choices;
+  std::vector<std::string> labels;
+  const auto add = [&](Move move, StrId label, std::string target = {}) {
+    choices.push_back({move, std::move(target)});
+    labels.emplace_back(I18n::getInstance().get(label));
+  };
+  if (sibling && origin.after) add(Move::Top, StrId::STR_WORKFLOWY_MOVE_TOP);
+  const auto next = std::find_if(rows.begin() + row + 1, rows.end(),
+                                 [&](const Node& node) { return node.depth <= rows[row].depth; });
+  if (sibling && next != rows.end() && next->depth == rows[row].depth) add(Move::Bottom, StrId::STR_WORKFLOWY_MOVE_BOTTOM);
+  if (!parentOf(id).empty()) add(Move::Parent, StrId::STR_WORKFLOWY_MOVE_PARENT, parentDestination(id));
+  constexpr StrId dayLabels[] = {StrId::STR_WORKFLOWY_MOVE_YESTERDAY, StrId::STR_WORKFLOWY_MOVE_TODAY,
+                                  StrId::STR_WORKFLOWY_MOVE_TOMORROW};
+  for (int delta = -1; delta <= 1; ++delta) {
+    auto day = isoDate(delta);
+    if (day.empty() && delta >= 0) day = delta == 0 ? "today" : "tomorrow";
+    const bool current = day == date || (delta == 0 && date == "today") || (delta == 1 && date == "tomorrow");
+    if (!day.empty() && !current) add(Move::Day, dayLabels[delta + 1], std::move(day));
+  }
+  add(Move::Date, StrId::STR_WORKFLOWY_MOVE_DATE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyMove", StrId::STR_WORKFLOWY_MOVE,
+                             std::move(labels), 0, false, true),
+                         [this, id, choices = std::move(choices)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const auto choice = std::get<OptionSelectionResult>(result.data).index;
+    if (choice < 0 || static_cast<size_t>(choice) >= choices.size() || itemPending(id)) return;
+    const auto& move = choices[choice];
+    if (move.action == Move::Date) return chooseDate(id);
+    if (move.action == Move::Day || move.action == Move::Parent) return moveToDate(id, move.target);
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& item) { return item.id == id; });
+    if (node != rows.end()) moveToBoundary(node - rows.begin(), move.action == Move::Bottom);
+  });
+}
+
+void WorkflowyDailyActivity::shiftDay(int delta) {
+  auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  if (source.empty()) return chooseDate();
+  int year, month, day;
+  if (sscanf(source.c_str(), "%d-%d-%d", &year, &month, &day) != 3) return;
+  day += delta;
+  if (day < 1) {
+    if (--month < 1) { month = 12; --year; }
+    day = monthLength(year, month);
+  } else if (day > monthLength(year, month)) {
+    if (++month > 12) { month = 1; ++year; }
+    day = 1;
+  }
+  char target[16];
+  snprintf(target, sizeof(target), "%04d-%02d-%02d", year, month, day);
+  if (validDate(target)) moveToDate({}, target);
+}
+
+void WorkflowyDailyActivity::moveToDate(const std::string& id, const std::string& target) {
+  if (id.empty()) {
+    if (date == target) return;
+    {
+      RenderLock lock(*this);
+      date = target;
+      zoomId.clear();
+      viewStack.clear();
+      selecting = false;
+      page = 0;
+      rows.clear();
+      layoutDirty = true;
+    }
+    if (step != Step::Start) loadDay();
+    return;
+  }
+  const auto old = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+  if (old == rows.end()) return;
+  const auto original = moveOrigin(old - rows.begin());
+  JsonDocument update;
+  update["parent_id"] = target;
+  update["position"] = "bottom";
+  if (itemPending(id) || !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  queueSave("/" + id + "/move", encode(update), false, [this, id, target, original](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    const bool currentDay = target == date || (date == "today" && target == isoDate(0)) ||
+                            (date == "tomorrow" && target == isoDate(1));
+    const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    const bool moveToNode = !currentDay && target != original.parent && !validDate(target) &&
+                            target != "today" && target != "tomorrow";
+    Node moved;
+    const bool locallyVisible = moveToNode && item != rows.end();
+    if (locallyVisible) moved = *item;
+    removeNode(id, currentDay);
+    if (locallyVisible) {
+      RenderLock lock(*this);
+      appendChild(rows, target, moved);
+      for (auto& view : viewStack) appendChild(view.rows, target, moved);
+      layoutDirty = true;
+    }
+    offerUndo([this, id, original] { return restoreMove(id, original); });
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::chooseDate(std::string moveId) {
+  const auto title = moveId.empty() ? StrId::STR_WORKFLOWY_SHOW_DATE : StrId::STR_WORKFLOWY_MOVE_DATE;
+  const auto today = isoDate(0);
+  const auto selected = validDate(date) ? date : date == "tomorrow" ? isoDate(1) : today;
+  startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, title, selected, today),
+                         [this, moveId = std::move(moveId)](const ActivityResult& result) {
+    if (!result.isCancelled) moveToDate(moveId, std::get<KeyboardResult>(result.data).text);
+  });
+}
+
+WorkflowyDailyActivity::Layout WorkflowyDailyActivity::layout() const {
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int rowTop = top + CONTENT_TOP + (!zoomId.empty() && !selecting ? 30 : 0);
+  const int footer = renderer.getScreenHeight() - bottom - 52;
+  const int pageLabel = std::max(32, renderer.getLineHeight(SMALL_FONT_ID) + 3);
+  return {left + 8, top, renderer.getScreenWidth() - right - left - 16, rowTop, footer,
+          footer - pageLabel, std::max(1, renderer.getLineHeight(UI_12_FONT_ID))};
+}
+
+void WorkflowyDailyActivity::layoutRows(const Layout& bounds) {
+  if (!layoutDirty && laidOut == bounds) return;
+  laidOut = bounds;
+  layoutDirty = false;
+  outlineLines.clear();
+  placements.clear();
+  pageStarts.assign(1, 0);
+  const int firstLineHeight = std::max(ROW_HEIGHT, bounds.lineHeight + 12);
+  int y = bounds.rowTop;
+  const unsigned visibleDepth = zoomId.empty() ? 0 : 1;
+  const auto placeRow = [&](size_t i) {
+    const auto& node = rows[i];
+    if (node.depth > visibleDepth) return;
+    if (node.done && !showDone && !itemPending(node.id) && (i != 0 || zoomId.empty())) return;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int width = std::max(1, bounds.width - indent - 25 - ROW_ARROW_TARGET);
+    size_t first = outlineLines.size();
+    if (wrapItems) {
+      const auto measure = [&](std::string_view text) {
+        return renderer.getTextWidth(UI_12_FONT_ID, std::string(text).c_str());
+      };
+      workflowy::wrapOutlineText(node.title, width, measure, outlineLines);
+      const auto capacityAt = [&](int top) {
+        return static_cast<size_t>(std::max(1, 1 + (bounds.rowBottom - top - firstLineHeight) / bounds.lineHeight));
+      };
+      const auto firstCapacity = capacityAt(y + firstLineHeight <= bounds.rowBottom ? y : bounds.rowTop);
+      if (outlineLines.size() - first > firstCapacity) {
+        const auto fullCapacity = capacityAt(bounds.rowTop);
+        const int allowance = renderer.getTextWidth(UI_12_FONT_ID, CONTINUATION) + CONTINUATION_GAP;
+        outlineLines.resize(first);
+        workflowy::wrapOutlineTextByLine(node.title, [&](size_t line) {
+          const bool leading = line >= firstCapacity && (line - firstCapacity) % fullCapacity == 0;
+          const bool trailing = line < firstCapacity ? line + 1 == firstCapacity
+                                                     : (line - firstCapacity + 1) % fullCapacity == 0;
+          return std::max(1, width - (static_cast<int>(leading) + static_cast<int>(trailing)) * allowance);
+        }, measure, outlineLines);
+      }
+    } else {
+      outlineLines.push_back({0, node.title.size()});
+    }
+    while (first < outlineLines.size()) {
+      if (y != bounds.rowTop && y + firstLineHeight > bounds.rowBottom) {
+        pageStarts.push_back(placements.size());
+        y = bounds.rowTop;
+      }
+      const int capacity = std::max(1, 1 + (bounds.rowBottom - y - firstLineHeight) / bounds.lineHeight);
+      const auto count = std::min(static_cast<size_t>(capacity), outlineLines.size() - first);
+      const int height = firstLineHeight + (static_cast<int>(count) - 1) * bounds.lineHeight;
+      placements.push_back({i, first, count, y, y + height});
+      first += count;
+      y += height;
+    }
+  };
+  const size_t firstItem = !zoomId.empty() && !rows.empty() ? 1 : 0;
+  if (firstItem) placeRow(0);
+  for (size_t i = firstItem; i < rows.size(); ++i) {
+    if (!rows[i].done) placeRow(i);
+  }
+  if (showDone) {
+    for (size_t i = firstItem; i < rows.size(); ++i) {
+      if (rows[i].done) placeRow(i);
+    }
+  }
+  if (wrapAnchor >= 0) {
+    const auto match = std::find_if(placements.begin(), placements.end(), [&](const Placement& placement) {
+      return placement.row == static_cast<size_t>(wrapAnchor);
+    });
+    if (match != placements.end()) {
+      const auto index = static_cast<size_t>(match - placements.begin());
+      page = std::upper_bound(pageStarts.begin(), pageStarts.end(), index) - pageStarts.begin() - 1;
+    }
+    wrapAnchor = -1;
+  }
+  page = std::min(page, pageStarts.size() - 1);
+
+}
+
+int WorkflowyDailyActivity::rowAt(const int x, int y, const bool dropping) const {
+  RenderLock lock;
+  if (layoutDirty || paintedPage != page || page >= pageStarts.size()) return -1;
+  if (!dropping && (x < laidOut.x || x >= laidOut.x + laidOut.width)) return -1;
+  const auto first = pageStarts[page];
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  if (first == end) return -1;
+  if (dropping) {
+    if (y < laidOut.rowTop - 4 || y >= laidOut.rowBottom) return -1;
+    // Treat the outline gutter and the unused space below the final row as
+    // part of the drop area. The header and toolbar still cancel the drop.
+    y = std::clamp(y, placements[first].top, placements[end - 1].bottom - 1);
+  }
+  for (auto i = first; i < end; ++i) {
+    const auto& hit = placements[i];
+    if (y >= hit.top && y < hit.bottom) return static_cast<int>(hit.row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::nextPage(const int delta, const bool edge) {
+  {
+    RenderLock lock(*this);
+    const int last = pageStarts.empty() ? 0 : static_cast<int>(pageStarts.size() - 1);
+    const auto next = static_cast<size_t>(edge ? (delta < 0 ? 0 : last)
+                                               : std::clamp(static_cast<int>(page) + delta, 0, last));
+    if (next == page) return;
+    page = next;
+  }
+  requestUpdate();
+}
+
+int WorkflowyDailyActivity::parentRow(size_t row) const {
+  const auto depth = rows[row].depth;
+  while (row > 0) {
+    --row;
+    if (rows[row].depth < depth) return static_cast<int>(row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::zoom(size_t row) {
+  if (rows[row].id == zoomId) return;
+  Node root = rows[row];
+  std::vector<Node> focused;
+  const bool cached = row + 1 < rows.size() && rows[row + 1].depth > root.depth;
+  if (!cached && !root.leaf) {
+    if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    {
+      RenderLock lock(*this);
+      requestedBranch = root.id;
+      message = nullptr;
+      if (prefetch && prefetch->parent != root.id) prefetch->cancel.store(true, std::memory_order_relaxed);
+    }
+    requestUpdate();
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    if (cached) {
+      const auto first = rows.begin() + row + 1;
+      auto end = first;
+      while (end != rows.end() && end->depth > root.depth) ++end;
+      focused.reserve(end - first + 1);
+      focused.insert(focused.end(), std::make_move_iterator(first), std::make_move_iterator(end));
+      rows.erase(first, end);
+      for (auto& node : focused) node.depth -= root.depth;
+    }
+    root.depth = 0;
+    root.leaf = focused.empty();
+    root.childrenConfirmed = !root.leaf;
+    focused.insert(focused.begin(), std::move(root));
+    ++generation;
+    requestedBranch.clear();
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    viewStack.push_back({std::move(rows), std::move(zoomId), page});
+    zoomId = focused.front().id;
+    rows = std::move(focused);
+    page = 0;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::back() {
+  if (viewStack.empty()) {
+    commitDelete();
+    if (!saves.empty()) {
+      leaveAfterSave = true;
+      return;
+    }
+    return finish();
+  }
+  returnToDepth(viewStack.size() - 1);
+}
+
+void WorkflowyDailyActivity::returnToDepth(size_t depth) {
+  if (depth >= viewStack.size()) return;
+  {
+    RenderLock lock(*this);
+    ++generation;
+    if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+    requestedBranch.clear();
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    while (viewStack.size() > depth) {
+      auto previous = std::move(viewStack.back());
+      viewStack.pop_back();
+      const auto owner = std::find_if(previous.rows.begin(), previous.rows.end(),
+                                      [&](const Node& node) { return node.id == zoomId; });
+      if (!rows.empty() && rows.front().id == zoomId && owner != previous.rows.end()) {
+        const auto depth = owner->depth;
+        auto end = owner + 1;
+        while (end != previous.rows.end() && end->depth > depth) ++end;
+        *owner = std::move(rows.front());
+        owner->depth = depth;
+        const bool fits = previous.rows.size() - static_cast<size_t>(end - (owner + 1)) +
+                          rows.size() - 1 <= MAX_CACHED_BRANCH_ROWS;
+        const auto where = previous.rows.erase(owner + 1, end);
+        if (fits) {
+          for (auto i = rows.begin() + 1; i != rows.end(); ++i) i->depth += depth;
+          previous.rows.insert(where, std::make_move_iterator(rows.begin() + 1), std::make_move_iterator(rows.end()));
+        }
+      }
+      rows = std::move(previous.rows);
+      zoomId = std::move(previous.zoomId);
+      page = previous.page;
+    }
+    wrapAnchor = -1;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::showBreadcrumbMenu() {
+  if (viewStack.size() < 3) return;
+  std::vector<std::string> ancestors;
+  ancestors.reserve(viewStack.size() - 2);
+  const int width = std::max(1, layout().width - 56);
+  for (size_t depth = 1; depth + 1 < viewStack.size(); ++depth) {
+    const auto& view = viewStack[depth];
+    const char* label = view.rows.empty() ? tr(STR_WORKFLOWY) : view.rows.front().title.c_str();
+    ancestors.push_back(renderer.truncatedText(UI_12_FONT_ID, label, width));
+  }
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                            renderer, mappedInput, "WorkflowyAncestors", StrId::STR_WORKFLOWY,
+                            std::move(ancestors), 0, false, true),
+                         [this](const ActivityResult& result) {
+    if (!result.isCancelled) {
+      const int index = std::get<OptionSelectionResult>(result.data).index;
+      if (index >= 0) returnToDepth(static_cast<size_t>(index) + 1);
+    }
+  });
+}
+
+void WorkflowyDailyActivity::drawBreadcrumbs(const Layout& bounds, int right) {
+  const auto depth = viewStack.size();
+  if (depth == 0) return;
+  const int total = std::max(0, right - bounds.x);
+  const int dayWidth = std::min(92, total / 3);
+  const int moreWidth = depth > 2 ? std::min(38, total / 6) : 0;
+  const int parentWidth = depth > 1 ? (total - dayWidth - moreWidth) / 2 : 0;
+  breadcrumbHits = {depth, bounds.x + dayWidth, bounds.x + dayWidth + moreWidth,
+                     bounds.x + dayWidth + moreWidth + parentWidth};
+  const int y = bounds.top + CONTENT_TOP + 5;
+  const auto draw = [&](int left, int end, const char* label, bool ancestor) {
+    const int labelWidth = end - left - (ancestor ? 15 : 0);
+    if (labelWidth <= 0) return;
+    const auto fitted = renderer.truncatedText(SMALL_FONT_ID, label, labelWidth);
+    renderer.drawText(SMALL_FONT_ID, left, y, fitted.c_str());
+    if (ancestor) renderer.drawText(SMALL_FONT_ID, end - 12, y, "›");
+  };
+  const char* day = date.empty() || date == "today" || date == isoDate(0) ? tr(STR_WORKFLOWY_TODAY) : date.c_str();
+  draw(bounds.x, breadcrumbHits.dayEnd, day, true);
+  if (moreWidth) draw(breadcrumbHits.dayEnd, breadcrumbHits.moreEnd, "...", true);
+  if (parentWidth) {
+    const auto& parent = viewStack.back();
+    draw(breadcrumbHits.moreEnd, breadcrumbHits.parentEnd,
+         parent.rows.empty() ? tr(STR_WORKFLOWY) : parent.rows.front().title.c_str(), true);
+  }
+  draw(breadcrumbHits.parentEnd, right, rows.empty() ? tr(STR_WORKFLOWY) : rows.front().title.c_str(), false);
+}
+
+bool WorkflowyDailyActivity::tapBreadcrumb(int x, int y) {
+  if (selecting || viewStack.empty()) return false;
+  const auto bounds = layout();
+  if (y < bounds.top + CONTENT_TOP || y >= bounds.rowTop || x < bounds.x) return false;
+  BreadcrumbHits hit;
+  {
+    RenderLock lock(*this);
+    hit = breadcrumbHits;
+  }
+  if (hit.depth == 0 || viewStack.size() != hit.depth || x >= hit.parentEnd) return false;
+  if (x < hit.dayEnd) returnToDepth(0);
+  else if (x < hit.moreEnd) showBreadcrumbMenu();
+  else returnToDepth(hit.depth - 1);
+  return true;
+}
+
+bool WorkflowyDailyActivity::reorder(size_t source, size_t target, bool after, bool recordUndo) {
+  if (itemPending(rows[source].id) || itemPending(rows[target].id)) return false;
+  const int parent = parentRow(source);
+  if (source == target || parent != parentRow(target)) return false;
+  const auto parentNode = parent < 0 ? "" : rows[parent].id;
+  return reorderSiblings(parent < 0 ? date : parentNode, parentNode, rows[source].depth,
+                         rows[source].id, rows[target].id, after, recordUndo);
+}
+
+bool WorkflowyDailyActivity::reorderSiblings(const std::string& parentId, const std::string& parentNode, unsigned depth,
+                                             std::string sourceId, std::string targetId,
+                                             bool after, bool recordUndo) {
+  struct OrderResult {
+    std::vector<Node> siblings;
+    std::string neighbour;
+    bool wasFirst = false;
+    bool loaded = false;
+  };
+  auto orderResult = std::make_shared<OrderResult>();
+  const auto source = std::find_if(rows.begin(), rows.end(), [&](const Node& row) { return row.id == sourceId; });
+  const auto localOrigin = source == rows.end() ? MoveOrigin{} : moveOrigin(source - rows.begin());
+  const bool queued = queueSave({}, {}, false,
+                   [this, parentId, parentNode, depth, sourceId, orderResult, recordUndo, localOrigin](const Save& save) {
+    if (orderResult->loaded) {
+      RenderLock lock(*this);
+      if (!parentNode.empty() || (zoomId.empty() && parentId == date)) replaceSiblings(rows, parentNode, orderResult->siblings);
+      for (auto& view : viewStack) {
+        if (!parentNode.empty() || (view.zoomId.empty() && parentId == date))
+          replaceSiblings(view.rows, parentNode, orderResult->siblings);
+      }
+      layoutDirty = true;
+    }
+    if (save.status != 200) {
+      if (!orderResult->loaded && !localOrigin.neighbour.empty()) moveVisibleBoundary(sourceId, localOrigin, false, true);
+      return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    }
+    if (recordUndo) {
+      offerUndo([this, sourceId, parentId, parentNode, depth, neighbour = orderResult->neighbour,
+                 wasFirst = orderResult->wasFirst] {
+        return reorderSiblings(parentId, parentNode, depth, sourceId, neighbour, !wasFirst, false);
+      });
+    }
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, sourceId,
+     [parentId, depth, sourceId, targetId, after, orderResult](Save& save) {
+    std::vector<Node> siblings;
+    save.status = fetchChildren(save.key, parentId, depth, siblings, nullptr, &save.transport);
+    if (save.status != 200) return;
+    std::vector<size_t> order;
+    size_t source = siblings.size(), target = siblings.size();
+    for (size_t i = 0; i < siblings.size(); ++i) {
+      if (siblings[i].id == sourceId) source = i;
+      else order.push_back(i);
+      if (siblings[i].id == targetId) target = i;
+    }
+    const auto position = std::find(order.begin(), order.end(), target);
+    if (source == siblings.size() || position == order.end() || siblings.size() < 2) {
+      save.status = -3;
+      return;
+    }
+    orderResult->wasFirst = source == 0;
+    orderResult->neighbour = siblings[source == 0 ? 1 : source - 1].id;
+    order.insert(position + (after ? 1 : 0), source);
+    const auto stationary = workflowy::stationaryRange(order);
+    const auto move = [&](size_t i, const char* placement) {
+      JsonDocument update;
+      update["parent_id"] = parentId;
+      update["position"] = placement;
+      save.status = requestWithKey(save.key, "POST", "/" + siblings[order[i]].id + "/move", encode(update),
+                                   nullptr, nullptr, 0, nullptr, nullptr, &save.transport, &save.error);
+      return save.status == 200;
+    };
+    bool ok = true;
+    for (size_t i = stationary.begin; i > 0 && ok; --i) ok = move(i - 1, "top");
+    for (size_t i = stationary.end; i < order.size() && ok; ++i) ok = move(i, "bottom");
+    if (ok) {
+      for (const auto i : order) orderResult->siblings.push_back(std::move(siblings[i]));
+      orderResult->loaded = true;
+    } else {
+      orderResult->loaded = fetchChildren(save.key, parentId, depth, orderResult->siblings) == 200;
+    }
+  });
+  if (queued && !localOrigin.parent.empty()) {
+    moveVisibleBoundary(sourceId, MoveOrigin{parentId, parentNode, targetId, depth, after}, false, true);
+  }
+  return queued;
+}
+
+void WorkflowyDailyActivity::offerUndo(std::function<bool()> action, bool forDelete) {
+  undoIsDelete = forDelete;
+  undoAction = std::move(action);
+  {
+    RenderLock lock(*this);
+    undoReady = true;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::undo() {
+  if (!undoAction) return;
+  if (!undoIsDelete && !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  if (!undoAction()) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  undoAction = {};
+  {
+    RenderLock lock(*this);
+    undoReady = false;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::commitDelete() {
+  if (pendingDelete.empty() || !hasActiveStationWifiConnection()) return;
+  const auto id = pendingDelete;
+  if (!queueSave("/" + id, {}, false, [this, id](const Save& save) {
+        if (save.status >= 200 && save.status < 300) removeNode(id);
+        else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }, "DELETE", StrId::STR_DELETE, id)) return;
+  {
+    RenderLock lock(*this);
+    pendingDelete.clear();
+    if (undoIsDelete) undoReady = false;
+    layoutDirty = true;
+  }
+  if (undoIsDelete) undoAction = {};
+}
+
+bool WorkflowyDailyActivity::queueCapture(const std::string& body) {
+  JsonDocument queue, item;
+  if ((!outbox.empty() && deserializeJson(queue, outbox)) || deserializeJson(item, body)) return false;
+  const auto account = std::to_string(std::hash<std::string>{}(credential));
+  if (queue["items"].isNull()) queue["items"].to<JsonArray>();
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() && queue["account"].as<std::string>() != account) return false;
+  queue["account"] = account;
+  if (items.size() >= OUTBOX_ITEMS || !items.add(item.as<JsonVariantConst>())) return false;
+  auto saved = encode(queue);
+  if (saved.size() > OUTBOX_LIMIT || !workflowy::writeSetting(OUTBOX, saved)) return false;
+  outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    pendingCount = items.size();
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::flushCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential))) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  }
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() == 0) return;
+  std::string body;
+  serializeJson(items[0], body);
+  queue["sending"] = true;
+  auto marked = encode(queue);
+  if (!workflowy::writeSetting(OUTBOX, marked)) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+  }
+  outbox = std::move(marked);
+  if (!queueSave("", std::move(body), false, [this](const Save& save) { finishCapture(save.status); },
+                 "POST", StrId::STR_WORKFLOWY_ADD)) {
+    finishCapture(-5);
+    return;
+  }
+  RenderLock lock(*this);
+  saves.back()->fromOutbox = true;
+}
+
+void WorkflowyDailyActivity::finishCapture(int status) {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  auto items = queue["items"].as<JsonArray>();
+  if (status >= 200 && status < 300) items.remove(0);
+  // An interrupted request may have created the item. Leave it queued for explicit review.
+  const bool uncertain = status == 0 || status >= 500;
+  queue["sending"] = uncertain;
+  auto saved = encode(queue);
+  const bool persisted = workflowy::writeSetting(OUTBOX, saved);
+  if (persisted) outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    outboxUncertain = uncertain || !persisted;
+    if (persisted) pendingCount = items.size();
+  }
+  if (queueVisible) refreshOfflineQueuePreview();
+  retryOutboxAt = millis() + (status >= 200 && status < 300 ? 350 : 30000);
+  if (status >= 200 && status < 300) {
+    rootCheckedAt = millis() - SYNC_INTERVAL;
+    nextPrefetchAt = millis();
+    requestUpdate();
+  } else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+}
+
+void WorkflowyDailyActivity::reviewCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential)))
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  const auto name = plainTitle(queue["items"][0]["name"] | "");
+  std::vector<std::string> options{tr(STR_WORKFLOWY_OUTBOX_SENT), tr(STR_WORKFLOWY_OUTBOX_RETRY)};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyOutbox", StrId::STR_WORKFLOWY_SYNC_CHECK,
+                             std::move(options), 0, false, true),
+                         [this, name](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const bool sent = std::get<OptionSelectionResult>(result.data).index == 0;
+    startActivityForResult(std::make_unique<ConfirmationActivity>(
+                               renderer, mappedInput, (sent ? tr(STR_WORKFLOWY_OUTBOX_SENT) : tr(STR_WORKFLOWY_OUTBOX_RETRY)),
+                               name),
+                           [this, sent](const ActivityResult& confirmation) {
+      if (confirmation.isCancelled) return;
+      JsonDocument queue;
+      if (deserializeJson(queue, outbox)) return;
+      auto items = queue["items"].as<JsonArray>();
+      if (sent) items.remove(0);
+      queue["sending"] = false;
+      auto saved = encode(queue);
+      if (!workflowy::writeSetting(OUTBOX, saved)) return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      outbox = std::move(saved);
+      {
+        RenderLock lock(*this);
+        outboxUncertain = false;
+        pendingCount = items.size();
+      }
+      retryOutboxAt = millis();
+      if (queueVisible) refreshOfflineQueuePreview();
+      requestUpdate();
+    });
+  });
+}
+
+WorkflowyDailyActivity::MoveOrigin WorkflowyDailyActivity::moveOrigin(size_t source) const {
+  const int parent = parentRow(source);
+  const std::string parentNode = parent < 0 ? "" : rows[parent].id;
+  const unsigned depth = rows[source].depth;
+  MoveOrigin origin{parent < 0 ? date : parentNode, parentNode, {}, depth, false};
+  for (size_t i = parent < 0 ? 0 : parent + 1; i < rows.size() && rows[i].depth >= depth; ++i) {
+    if (i == source || rows[i].depth != depth) continue;
+    if (i > source && !origin.neighbour.empty()) break;
+    origin.neighbour = rows[i].id;
+    origin.after = i < source;
+    if (i > source) break;
+  }
+  return origin;
+}
+
+void WorkflowyDailyActivity::moveToBoundary(size_t row, bool bottom) {
+  if (itemPending(rows[row].id) || rows[row].id == zoomId) return;
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const auto id = rows[row].id;
+  const auto origin = moveOrigin(row);
+  JsonDocument update;
+  update["parent_id"] = origin.parent;
+  update["position"] = bottom ? "bottom" : "top";
+  if (queueSave("/" + id + "/move", encode(update), false, [this, id, origin, bottom](const Save& save) {
+        if (save.status < 200 || save.status >= 300) {
+          moveVisibleBoundary(id, origin, bottom, true);
+          return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+        }
+        offerUndo([this, id, origin] { return restoreMove(id, origin); });
+      }, "POST", bottom ? StrId::STR_WORKFLOWY_MOVE_BOTTOM : StrId::STR_WORKFLOWY_MOVE_TOP, id)) {
+    moveVisibleBoundary(id, origin, bottom, false);
+  }
+}
+
+void WorkflowyDailyActivity::moveVisibleBoundary(const std::string& id, const MoveOrigin& origin, bool bottom, bool restore) {
+  {
+    RenderLock lock(*this);
+    const auto rotateBranch = [&](std::vector<Node>& outline) {
+      const auto item = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (item == outline.end()) return;
+      const auto depth = item->depth;
+      if (depth == 0 && !outline.empty() && outline.front().id == id && id == zoomId) return;
+      auto end = item + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      auto destination = item;
+      if (restore) {
+        destination = std::find_if(outline.begin(), outline.end(), [&](const Node& node) {
+          return node.id == origin.neighbour && node.depth == depth;
+        });
+        if (destination == outline.end()) return;
+        if (origin.after) {
+          ++destination;
+          while (destination != outline.end() && destination->depth > depth) ++destination;
+        }
+      } else if (bottom) {
+        destination = end;
+        while (destination != outline.end() && destination->depth >= depth) ++destination;
+      } else {
+        while (destination != outline.begin() && std::prev(destination)->depth >= depth) --destination;
+      }
+      if (destination < item) std::rotate(destination, item, end);
+      if (destination > end) std::rotate(item, end, destination);
+    };
+    if (id != zoomId) rotateBranch(rows);
+    for (auto& view : viewStack) if (id != view.zoomId) rotateBranch(view.rows);
+    layoutDirty = true;
+  }
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::restoreMove(const std::string& id, const MoveOrigin& origin) {
+  if (itemPending(id)) return false;
+  JsonDocument update;
+  update["parent_id"] = origin.parent;
+  update["position"] = "bottom";
+  return queueSave("/" + id + "/move", encode(update), false, [this, id, origin](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    if (!origin.neighbour.empty() &&
+        reorderSiblings(origin.parent, origin.parentNode, origin.depth, id, origin.neighbour, origin.after, false)) return;
+    loadDay();
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::indent(size_t source, size_t target) {
+  if (itemPending(rows[source].id) || itemPending(rows[target].id)) return;
+  const auto id = rows[source].id;
+  const auto destination = rows[target].id;
+  const auto original = moveOrigin(source);
+  JsonDocument update;
+  update["parent_id"] = destination;
+  update["position"] = "top";
+  queueSave("/" + id + "/move", encode(update), false, [this, id, destination, original](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    removeNode(id);
+    {
+      RenderLock lock(*this);
+      for (auto& node : rows) {
+        if (node.id != destination) continue;
+        node.leaf = false;
+        node.childrenConfirmed = true;
+      }
+    }
+    offerUndo([this, id, original] { return restoreMove(id, original); });
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::prefetchTask(void* argument) {
+  {
+    std::unique_ptr<std::shared_ptr<Prefetch>> holder(static_cast<std::shared_ptr<Prefetch>*>(argument));
+    auto& job = **holder;
+    job.status = fetchChildren(job.key, job.target, job.depth, job.children, &job.cancel, &job.transport);
+    job.ready.store(true, std::memory_order_release);
+  }
+  vTaskDelete(nullptr);
+}
+
+void WorkflowyDailyActivity::pollPrefetch() {
+  const auto now = millis();
+  if (prefetch) {
+    if (!prefetch->ready.load(std::memory_order_acquire)) return;
+    auto job = std::move(prefetch);
+    if (job->generation != generation || job->cancel.load(std::memory_order_relaxed)) return;
+    bool changed = false;
+    int zoomRow = -1;
+    {
+      RenderLock lock(*this);
+      if (job->root) {
+        rootCheckedAt = now;
+        if (awaitingOutline) {
+          awaitingOutline = false;
+          lastStatus = job->status;
+          lastTransport = job->transport;
+          lastServerError.clear();
+          changed = true;
+          message = job->status == 200 ? nullptr
+                    : job->status == -2 ? tr(STR_WORKFLOWY_CLOCK_FAILED)
+                    : job->status == -3 ? tr(STR_WORKFLOWY_DAILY_READ_FAILED)
+                    : job->status == 401 || job->status == 403 ? tr(STR_WORKFLOWY_AUTH_FAILED)
+                                                               : tr(STR_WORKFLOWY_NETWORK_FAILED);
+        }
+      }
+      if (!requestedBranch.empty() && requestedBranch == job->parent) {
+        const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == job->parent; });
+        requestedBranch.clear();
+        lastStatus = job->status;
+        lastTransport = job->transport;
+        lastServerError.clear();
+        changed = true;
+        if (job->status != 200) {
+          message = tr(STR_WORKFLOWY_DAILY_READ_FAILED);
+        } else if (owner != rows.end()) {
+          const auto index = static_cast<size_t>(owner - rows.begin());
+          auto end = owner + 1;
+          while (end != rows.end() && end->depth > owner->depth) ++end;
+          if (rows.size() - static_cast<size_t>(end - (owner + 1)) + job->children.size() > MAX_ROWS) {
+            message = tr(STR_WORKFLOWY_DAILY_READ_FAILED);
+          } else {
+            replaceSiblings(rows, job->parent, job->children);
+            if (!rows[index].leaf) zoomRow = static_cast<int>(index);
+            message = nullptr;
+            layoutDirty = true;
+          }
+        }
+      } else if (job->status == 200) {
+        changed |= replaceSiblings(rows, job->parent, job->children);
+        layoutDirty |= changed;
+      }
+    }
+    if (zoomRow >= 0) return zoom(zoomRow);
+    if (changed) requestUpdate();
+    return;
+  }
+  const bool interactive = !requestedBranch.empty();
+  if (interactive && !online) {
+    {
+      RenderLock lock(*this);
+      requestedBranch.clear();
+    }
+    return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  }
+  if ((!interactive && static_cast<long>(now - nextPrefetchAt) < 0) || credential.empty() || date.empty() || !online)
+    return;
+  std::string parent;
+  unsigned depth = 0;
+  const bool root = !interactive && now - rootCheckedAt >= SYNC_INTERVAL;
+  {
+    RenderLock lock(*this);
+    if (interactive) {
+      const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == requestedBranch; });
+      if (owner == rows.end()) {
+        requestedBranch.clear();
+        return;
+      }
+      parent = owner->id;
+      depth = owner->depth + 1;
+    } else if (root) {
+      parent = zoomId;
+      depth = zoomId.empty() ? 0 : 1;
+    } else {
+      return;
+    }
+  }
+  auto job = makeUniqueNoThrow<Prefetch>();
+  nextPrefetchAt = now + 5000;
+  const auto failStart = [&] {
+    if (!interactive) return;
+    {
+      RenderLock lock(*this);
+      requestedBranch.clear();
+      lastStatus = 0;
+      lastTransport = ESP_ERR_NO_MEM;
+      lastServerError.clear();
+    }
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  };
+  if (!job) return failStart();
+  job->key = credential;
+  job->target = parent.empty() ? date : parent;
+  job->parent = std::move(parent);
+  job->generation = generation;
+  job->depth = depth;
+  job->root = root;
+  prefetch = std::move(job);
+  auto holder = makeUniqueNoThrow<std::shared_ptr<Prefetch>>(prefetch);
+  if (!holder) {
+    prefetch.reset();
+    return failStart();
+  }
+  // The task owns the argument and touches no activity or renderer state.
+  auto* argument = holder.release();
+  if (xTaskCreate(prefetchTask, "wf-prefetch", 8192, argument, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete argument;
+    prefetch.reset();
+    return failStart();
+  }
+  nextPrefetchAt = now + 250;
+}
+
+void WorkflowyDailyActivity::loop() {
+  using Button = MappedInputManager::Button;
+  using Swipe = MappedInputManager::SwipeDir;
+  if (mappedInput.wasReleased(Button::Back)) {
+    if (queueVisible) return showPendingOperations();
+    if (selecting) return cancelSelection();
+    return back();
+  }
+  int tapX = 0, tapY = 0;
+  const bool sdkTap = mappedInput.wasScreenTapped(tapX, tapY);
+  const auto now = millis();
+  if (queueVisible) {
+    const auto bounds = layout();
+    const int uncertainY = bounds.rowTop + (!requestedBranch.empty() ? ROW_HEIGHT : 0);
+    if (sdkTap && outboxUncertain && queuePage == 0 && tapY >= uncertainY && tapY < uncertainY + ROW_HEIGHT &&
+        saves.empty()) {
+      return reviewCapture();
+    }
+    if (sdkTap && (tapY < bounds.rowTop || tapY >= bounds.footer)) return showPendingOperations();
+    const auto swipe = mappedInput.wasSwipe();
+    if (swipe == Swipe::Up || swipe == Swipe::Down) {
+      RenderLock lock(*this);
+      const size_t visible = std::max(1, (bounds.rowBottom - bounds.rowTop) / ROW_HEIGHT);
+      if (swipe == Swipe::Down && queuePage) --queuePage;
+      else if (swipe == Swipe::Up && (queuePage + 1) * visible < pendingOperationsCount()) ++queuePage;
+    }
+    if (step == Step::Ready) pollWifiConnection();
+    if (step == Step::Load) loadDay();
+    if (!pollSave() && swipe != Swipe::None) requestUpdate();
+    if (saves.empty() && (!requestedBranch.empty() || awaitingOutline)) pollPrefetch();
+    else if (saves.empty() && pendingCount && !outboxUncertain && hasActiveStationWifiConnection() &&
+             static_cast<long>(now - retryOutboxAt) >= 0) flushCapture();
+    return;
+  }
+  const bool tapped = sdkTap && (tracking || gestureEndedAt == 0 || now - gestureEndedAt >= 120);
+  // The calendar is local. Open it before processing Wi-Fi or outline work.
+  if (tapped && !selecting && step != Step::Waiting && !dragging && !(tracking && moved)) {
+    const auto bounds = layout();
+    const int right = bounds.x + bounds.width;
+    if (tapY >= bounds.top + 28 && tapY < bounds.top + 63 && tapX >= bounds.x && tapX < right) {
+      if (tapX >= right - ICON_TARGET) {
+        tracking = false;
+        return chooseDate();
+      }
+      const int dayRight = right - ICON_TARGET - COUNT_TARGET;
+      if (tapX < dayRight) {
+        tracking = false;
+        if (tapX < bounds.x + DAY_TARGET) return shiftDay(-1);
+        if (tapX >= dayRight - DAY_TARGET) return shiftDay(1);
+        return chooseDate();
+      }
+    }
+  }
+  if (step == Step::Start) return connect();
+  if (step == Step::Load) return loadDay();
+  if (step != Step::Ready) return;
+  pollWifiConnection();
+  if (step != Step::Ready) return;
+  int touchDownX, touchDownY;
+  const bool stillTouching = sdkTap || tracking || mappedInput.wasScreenTouchReleased() ||
+                             mappedInput.wasScreenTouchDown(touchDownX, touchDownY);
+  if (!stillTouching && pollSave()) return;
+  if (static_cast<long>(now - nextLinkCheck) >= 0) {
+    nextLinkCheck = now + 500;
+    const bool connected = hasActiveStationWifiConnection();
+    if (connected != online) {
+      {
+        RenderLock lock(*this);
+        online = connected;
+      }
+      if (connected && !awaitingOutline) loadDay();
+      else requestUpdate();
+    }
+  }
+  if (isErrorNotice(message) && mappedInput.wasReleased(Button::Confirm)) return showErrorDetails();
+  if (mappedInput.wasReleased(Button::Up)) return nextPage(-1);
+  if (mappedInput.wasReleased(Button::Down)) return nextPage(1);
+  int x = 0, y = 0;
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    tracking = true;
+    dragRow = -1;
+    moved = false;
+    peakY = 0;
+    touchX = lastX = x;
+    touchY = lastY = y;
+    touchAt = millis();
+  }
+  if (tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    lastX = x;
+    lastY = y;
+    const int dx = std::abs(x - touchX), dy = std::abs(y - touchY);
+    if (dy > std::abs(peakY)) peakY = y - touchY;
+    if (!selecting && !moved && dragRow < 0 && millis() - touchAt >= 550) {
+      const int row = rowAt(touchX, touchY);
+      if (row >= 0 && !itemPending(rows[row].id)) dragRow = row;
+    }
+    moved |= std::max(dx, dy) > 26;
+    if (online && dragRow >= 0 && (dragging || dy > 26)) {
+      dragging = true;
+      const int over = rowAt(x, y, true);
+      const int nextDrop = over >= 0 && over != dragRow && !itemPending(rows[over].id) &&
+                           parentRow(over) == parentRow(dragRow) ? over : -1;
+      const bool inside = nextDrop >= 0 && x - touchX >= 32 && rows[nextDrop].depth < 8;
+      bool changed;
+      {
+        RenderLock lock(*this);
+        changed = dropRow != nextDrop || dropInside != inside;
+        dropInside = inside;
+        dropRow = nextDrop;
+        dropAfter = nextDrop > dragRow;
+      }
+      if (changed) requestUpdate(true);
+      return;
+    }
+  }
+  Swipe swipe = Swipe::None;
+  int swipeX = 0, swipeY = 0, endX = 0, endY = 0;
+  const bool sdkSwipe = mappedInput.wasSwipeWithPoints(swipe, swipeX, swipeY, endX, endY);
+  const bool release = mappedInput.wasScreenTouchReleased();
+  if (dragging) {
+    if (!release && !sdkSwipe) return;
+    tracking = false;
+    dragging = false;
+    gestureEndedAt = now;
+    int target;
+    bool after, inside;
+    {
+      RenderLock lock(*this);
+      target = dropRow;
+      after = dropAfter;
+      inside = dropInside;
+      dropRow = -1;
+    }
+    requestUpdate();
+    if (target >= 0) {
+      if (inside) indent(dragRow, target);
+      else reorder(dragRow, target, after);
+    }
+    return;
+  }
+  if (swipe == Swipe::None && release && tracking) {
+    const int dx = lastX - touchX;
+    if (std::abs(peakY) >= 28 && std::abs(peakY) >= std::abs(dx))
+      swipe = peakY < 0 ? Swipe::Up : Swipe::Down;
+    else if (std::abs(dx) >= 60)
+      swipe = dx < 0 ? Swipe::Left : Swipe::Right;
+  }
+  if (swipe != Swipe::None) {
+    const int row = sdkSwipe ? rowAt(swipeX, swipeY) : rowAt(touchX, touchY);
+    tracking = false;
+    gestureEndedAt = now;
+    if (swipe == Swipe::Up || swipe == Swipe::Down) return nextPage(swipe == Swipe::Up ? 1 : -1);
+    if (!selecting && row >= 0 && !itemPending(rows[row].id)) {
+      if (swipe == Swipe::Right) toggle(row);
+      else actions(row);
+    }
+    return;
+  }
+  if (tapped) {
+    const int statusTop = layout().top + UITheme::getTopStatusBarInset(renderer);
+    const bool lamp = GUI.isFrontlightIndicatorTap(renderer, statusTop, tapX, tapY);
+    const bool hand = GUI.isTouchscreenIndicatorHit(renderer, statusTop, tapX, tapY);
+    if (lamp || hand) {
+      tracking = false;
+      if (lamp) {
+        const bool lightOn = !Frontlight.isOn();
+        Frontlight.setOn(lightOn);
+        SETTINGS.frontlightOn = lightOn ? 1 : 0;
+      } else {
+        SETTINGS.disableReaderTouchscreen = SETTINGS.disableReaderTouchscreen ? 0 : 1;
+      }
+      activityManager.persistGlobalSettings();
+      requestUpdate();
+      return;
+    }
+    if (GUI.isReadestIndicatorTap(renderer, statusTop, tapX, tapY)) {
+      tracking = false;
+      startActivityForResult(std::make_unique<ReadestSettingsActivity>(renderer, mappedInput), {});
+      return;
+    }
+    if (GUI.isHighlightIndicatorTap(renderer, statusTop, tapX, tapY)) {
+      tracking = false;
+      startActivityForResult(std::make_unique<SavedItemsHomeActivity>(renderer, mappedInput), {});
+      return;
+    }
+  }
+  if (tapped) {
+    const auto bounds = layout();
+    if (tapY >= bounds.top + STATUS_TOP && tapY < bounds.top + STATUS_TOP + STATUS_HEIGHT &&
+        tapX >= bounds.x && tapX < bounds.x + bounds.width) {
+      const auto pending = pendingOperationsCount();
+      const auto* notice = statusNotice();
+      const int divider = bounds.x + bounds.width / 2;
+      if (pending && (!notice || tapX >= divider)) return showPendingOperations();
+      if (isErrorNotice(message)) {
+        tracking = false;
+        mappedInput.suppressCurrentTouchContact();
+        return showErrorDetails();
+      }
+    }
+  }
+  if (tapped && tapBreadcrumb(tapX, tapY)) {
+    tracking = false;
+    return;
+  }
+  if (!selecting && tapped && tapArrow(tapX, tapY)) {
+    tracking = false;
+    return;
+  }
+  const bool held = release && tracking && !moved && now - touchAt >= 550;
+  if (!tapped && !held) {
+    if (release) tracking = false;
+    if (!tracking && !release && saves.empty() && !connectingWifi) {
+      if (!requestedBranch.empty()) pollPrefetch();
+      else if (online && !pendingDelete.empty() && static_cast<long>(millis() - deleteAt) >= 0) commitDelete();
+      else if (online && pendingCount && !outboxUncertain && !prefetch &&
+               static_cast<long>(millis() - retryOutboxAt) >= 0) flushCapture();
+      else if (now - touchAt >= 180) pollPrefetch();
+    }
+    return;
+  }
+  const bool dragged = tracking && moved;
+  tracking = false;
+  x = held ? touchX : tapX;
+  y = held ? touchY : tapY;
+  const auto bounds = layout();
+  if (selecting && y >= bounds.top + 28 && y < bounds.top + STATUS_TOP && !held) {
+    const int right = bounds.x + bounds.width;
+    if (x < bounds.x + ICON_TARGET) return cancelSelection();
+    if (x >= right - ICON_TARGET) return showBulkMenu();
+    if (x >= right - ICON_TARGET - 104) return selectAll();
+    return;
+  }
+  if (y >= bounds.rowBottom && y < bounds.footer) {
+    const int zone = (x - bounds.x) * 8 / bounds.width;
+    if (pageStarts.size() <= 1) return;
+    if (zone >= 0 && zone < 2) return nextPage(-1, zone == 0);
+    if (zone >= 6 && zone < 8) return nextPage(1, zone == 7);
+  }
+  if (y >= bounds.footer) {
+    if (selecting) {
+      if (x < bounds.x + bounds.width / 5) cancelSelection();
+      return;
+    }
+    const int control = std::clamp((x - bounds.x) * FOOTER_CONTROLS / bounds.width, 0, FOOTER_CONTROLS - 1);
+    if (control == 0) return back();
+    if (control == 5) return refresh(held);
+    if (control == 2) {
+      if (!credential.empty() && !date.empty()) edit(rows.size());
+      return;
+    }
+    if (control == 3) {
+      if (undoReady) undo();
+      return;
+    }
+    {
+      RenderLock lock(*this);
+      if (control == 1) showDone = !showDone;
+      else wrapItems = !wrapItems;
+      message = nullptr;
+      layoutDirty = true;
+      if (page < pageStarts.size() && pageStarts[page] < placements.size())
+        wrapAnchor = static_cast<int>(placements[pageStarts[page]].row);
+    }
+    requestUpdate();
+    return;
+  }
+  const int row = rowAt(x, y);
+  if (row < 0 || itemPending(rows[row].id)) return;
+  if (selecting) {
+    if (tapped && !held) toggleSelection(row);
+    return;
+  }
+  if (dragged) return;
+  const int indent = std::min<unsigned>(rows[row].depth, 8) * 16;
+  if (held) return actions(row);
+  size_t cursor = std::string::npos;
+  bool checkboxHit = false;
+  {
+    RenderLock lock(*this);
+    const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+    for (auto i = pageStarts[page]; i < end; ++i) {
+      const auto& placement = placements[i];
+      if (placement.row != static_cast<size_t>(row) || y < placement.top || y >= placement.bottom) continue;
+      const bool firstFragment = i == 0 || placements[i - 1].row != placement.row;
+      checkboxHit = firstFragment && rows[row].todo && x < bounds.x + indent + 30;
+      if (!checkboxHit) {
+        const auto line = std::min(placement.lineCount - 1,
+                                  static_cast<size_t>(std::max(0, y - placement.top - 6) / bounds.lineHeight));
+        const int prefix = !firstFragment && line == 0
+                               ? renderer.getTextWidth(UI_12_FONT_ID, CONTINUATION) + CONTINUATION_GAP : 0;
+        cursor = cursorAt(rows[row].title, outlineLines[placement.firstLine + line], x - bounds.x - indent - 25 - prefix);
+      }
+      break;
+    }
+  }
+  if (checkboxHit) return toggle(row);
+  edit(row, 0, cursor);
+}
+
+const char* WorkflowyDailyActivity::statusNotice() const {
+  if (isErrorNotice(message)) return message;
+  if (connectingWifi) return tr(STR_CONNECTING);
+  if (awaitingOutline && online) return tr(STR_LOADING_POPUP);
+  if (message) return message;
+  if (!online) return tr(STR_WORKFLOWY_OFFLINE);
+  return nullptr;
+}
+
+void WorkflowyDailyActivity::drawStatus(const Layout& bounds, const size_t pending, const char* notice) {
+  const auto badge = [&](const char* label, const int left, const int span, const bool tappable) {
+    const int caretWidth = tappable ? 15 : 0;
+    const auto fitted = renderer.truncatedText(SMALL_FONT_ID, label, span - 20 - caretWidth);
+    const int width = renderer.getTextWidth(SMALL_FONT_ID, fitted.c_str()) + 16 + caretWidth;
+    const int x = left + (span - width) / 2;
+    const int top = bounds.top + STATUS_TOP;
+    const int textY = top + (STATUS_HEIGHT - renderer.getLineHeight(SMALL_FONT_ID)) / 2;
+    renderer.drawRoundedRect(x, top, width, STATUS_HEIGHT, 1, 7, true);
+    renderer.drawText(SMALL_FONT_ID, x + 8, textY, fitted.c_str());
+    if (tappable) {
+      const int tip = x + width - 8;
+      const int mid = top + STATUS_HEIGHT / 2;
+      renderer.drawLine(tip - 4, mid - 4, tip, mid);
+      renderer.drawLine(tip, mid, tip - 4, mid + 4);
+    }
+  };
+  const int noticeWidth = pending && notice ? bounds.width / 2 : bounds.width;
+  if (notice) badge(notice, bounds.x, noticeWidth, isErrorNotice(message));
+  if (!pending) return;
+  char count[52];
+  const char* label;
+  if (pending == 1) {
+    const auto action = !saves.empty() ? saves.front()->label
+                      : !requestedBranch.empty() ? StrId::STR_WORKFLOWY_ZOOM
+                      : outboxUncertain ? StrId::STR_WORKFLOWY_SYNC_CHECK : StrId::STR_WORKFLOWY_ADD;
+    label = I18n::getInstance().get(action);
+  } else {
+    snprintf(count, sizeof(count), tr(STR_WORKFLOWY_ACTIONS_PENDING), static_cast<unsigned>(pending));
+    label = count;
+  }
+  const int inset = notice ? noticeWidth : 0;
+  badge(label, bounds.x + inset, bounds.width - inset, true);
+}
+
+void WorkflowyDailyActivity::render(RenderLock&&) {
+  const auto bounds = layout();
+  renderer.clearScreen();
+  GUI.drawDisplayStatusBar(renderer, bounds.top);
+  breadcrumbHits = {};
+  if (queueVisible) {
+    renderer.drawText(UI_12_FONT_ID, bounds.x, bounds.top + 32, tr(STR_WORKFLOWY_PENDING), true, EpdFontFamily::BOLD);
+    const int right = bounds.x + bounds.width - 18;
+    const int cy = bounds.top + 46;
+    renderer.drawLine(right - 6, cy - 6, right + 6, cy + 6, 2);
+    renderer.drawLine(right + 6, cy - 6, right - 6, cy + 6, 2);
+    renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+    const size_t visible = std::max(1, (bounds.rowBottom - bounds.rowTop) / ROW_HEIGHT);
+    const size_t inFlightCapture = std::any_of(saves.begin(), saves.end(), [](const auto& save) {
+      return save->fromOutbox;
+    }) && !offlineQueuePreview.empty() ? 1 : 0;
+    const size_t branchEntries = !requestedBranch.empty();
+    const auto offlineStart = saves.size() + branchEntries;
+    const auto total = offlineStart + offlineQueuePreview.size() - inFlightCapture;
+    queuePage = std::min(queuePage, total == 0 ? 0 : (total - 1) / visible);
+    const auto opening = branchEntries ? std::find_if(rows.begin(), rows.end(), [&](const Node& node) {
+      return node.id == requestedBranch;
+    }) : rows.end();
+    for (size_t i = queuePage * visible; i < total && i < (queuePage + 1) * visible; ++i) {
+      const auto* save = i < saves.size() ? saves[i].get() : nullptr;
+      const bool openingItem = !save && i < offlineStart;
+      const auto type = save ? save->label : openingItem ? StrId::STR_WORKFLOWY_ZOOM : StrId::STR_WORKFLOWY_ADD;
+      const auto name = save ? std::string_view(save->title)
+                        : openingItem ? (opening == rows.end() ? std::string_view{} : std::string_view(opening->title))
+                        : std::string_view(offlineQueuePreview[i - offlineStart + inFlightCapture]);
+      auto text = std::to_string(i + 1) + ". " + I18n::getInstance().get(type);
+      if (!name.empty()) {
+        text += " · ";
+        text += name;
+      }
+      if (!save && !openingItem && outboxUncertain && i == offlineStart) {
+        text += " · ";
+        text += tr(STR_WORKFLOWY_SYNC_CHECK);
+      }
+      const auto fitted = renderer.truncatedText(UI_12_FONT_ID, text.c_str(), bounds.width - 14);
+      renderer.drawText(UI_12_FONT_ID, bounds.x + 4, bounds.rowTop + (i % visible) * ROW_HEIGHT + 6, fitted.c_str());
+    }
+    if (!total) renderer.drawCenteredText(UI_12_FONT_ID, bounds.rowTop + 12, tr(STR_WORKFLOWY_QUEUE_EMPTY));
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer + 13, tr(STR_BACK));
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+    return;
+  }
+  if (selecting) {
+    const int cy = bounds.top + 46;
+    const int left = bounds.x + 17;
+    const int right = bounds.x + bounds.width;
+    renderer.drawLine(left - 6, cy - 6, left + 6, cy + 6, 2, true);
+    renderer.drawLine(left + 6, cy - 6, left - 6, cy + 6, 2, true);
+    char summary[40];
+    snprintf(summary, sizeof(summary), tr(STR_WORKFLOWY_SELECTION_COUNT), static_cast<unsigned>(selectionCount()));
+    renderer.drawText(UI_12_FONT_ID, bounds.x + ICON_TARGET, cy - 12, summary);
+    renderer.drawText(SMALL_FONT_ID, right - ICON_TARGET - 96, cy - 9, tr(STR_WORKFLOWY_SELECT_ALL));
+    for (const int dx : {-7, 0, 7}) renderer.fillRect(right - 22 + dx, cy - 1, 3, 3);
+  } else {
+    std::string heading = date.empty() || date == "today" ? isoDate(0) : date == "tomorrow" ? isoDate(1) : date;
+    const char* relative = nullptr;
+    if (date == "today" || date.empty() || date == isoDate(0)) relative = tr(STR_WORKFLOWY_TODAY);
+    else if (date == "tomorrow" || date == isoDate(1)) relative = tr(STR_WORKFLOWY_TOMORROW);
+    else if (date == isoDate(-1)) relative = tr(STR_WORKFLOWY_YESTERDAY);
+    if (relative) heading += heading.empty() ? relative : std::string(", ") + relative;
+    unsigned completed = 0, totalTodos = 0;
+    const unsigned outlineDepth = zoomId.empty() ? 0 : 1;
+    for (const auto& row : rows) {
+      if (row.depth == outlineDepth && row.todo) {
+        ++totalTodos;
+        if (row.done) ++completed;
+      }
+    }
+    char todoCount[24];
+    snprintf(todoCount, sizeof(todoCount), "%u/%u", completed, totalTodos);
+    const int right = bounds.x + bounds.width;
+    const int cx = right - ICON_TARGET / 2, cy = bounds.top + 46;
+    const int dayRight = right - ICON_TARGET - COUNT_TARGET;
+    const int dateLeft = bounds.x + DAY_TARGET;
+    const int dateRight = dayRight - DAY_TARGET;
+    const int countX = dayRight + (COUNT_TARGET - renderer.getTextWidth(SMALL_FONT_ID, todoCount)) / 2;
+    renderer.drawText(SMALL_FONT_ID, countX, bounds.top + 36, todoCount);
+    if (!zoomId.empty()) drawBreadcrumbs(bounds, right);
+    const int dateWidth = dateRight - dateLeft;
+    // Choose one font for all three relative dates. Switching days should
+    // never shrink only the longer Yesterday or Tomorrow label.
+    int dateFont = UI_12_FONT_ID;
+    for (const auto label : {StrId::STR_WORKFLOWY_TODAY, StrId::STR_WORKFLOWY_YESTERDAY, StrId::STR_WORKFLOWY_TOMORROW}) {
+      const auto sample = std::string("2000-00-00, ") + I18n::getInstance().get(label);
+      if (renderer.getTextWidth(UI_12_FONT_ID, sample.c_str(), EpdFontFamily::BOLD) > dateWidth) {
+        dateFont = SMALL_FONT_ID;
+        break;
+      }
+    }
+    const auto drawDate = [&](const std::string& text, int y) {
+      const int width = renderer.getTextWidth(dateFont, text.c_str(), EpdFontFamily::BOLD);
+      renderer.drawText(dateFont, (dateLeft + dateRight - width) / 2, y, text.c_str(), true, EpdFontFamily::BOLD);
+    };
+    if (renderer.getTextWidth(dateFont, heading.c_str(), EpdFontFamily::BOLD) > dateWidth) {
+      if (const auto split = heading.find(", "); split != std::string::npos) {
+        drawDate(heading.substr(0, split + 1), bounds.top + 28);
+        drawDate(heading.substr(split + 2), bounds.top + 46);
+      } else {
+        drawDate(heading, bounds.top + 36);
+      }
+    } else {
+      drawDate(heading, bounds.top + (dateFont == UI_12_FONT_ID ? 32 : 36));
+    }
+    for (const int direction : {-1, 1}) {
+      const int arrowX = direction < 0 ? bounds.x + DAY_TARGET / 2 : dayRight - DAY_TARGET / 2;
+      renderer.drawLine(arrowX - direction * 4, cy - 6, arrowX + direction * 4, cy, 2);
+      renderer.drawLine(arrowX + direction * 4, cy, arrowX - direction * 4, cy + 6, 2);
+    }
+    renderer.drawRect(cx - 10, cy - 9, 21, 19);
+    renderer.drawLine(cx - 10, cy - 3, cx + 10, cy - 3);
+    renderer.drawLine(cx - 5, cy - 12, cx - 5, cy - 6);
+    renderer.drawLine(cx + 5, cy - 12, cx + 5, cy - 6);
+  }
+  renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+  layoutRows(bounds);
+  paintedPage = page;
+  paintedArrows.clear();
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  for (auto i = pageStarts[page]; i < end; ++i) {
+    const auto& placement = placements[i];
+    const auto& node = rows[placement.row];
+    const int y = placement.top + 6;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int start = bounds.x + indent;
+    if ((selecting && node.selected) || itemPending(node.id)) {
+      renderer.fillRectDither(start, placement.top + 1, bounds.x + bounds.width - start,
+                              placement.bottom - placement.top - 2, Color::LightGray);
+    }
+    if (node.depth) renderer.drawLine(start - 7, y - 5, start - 7, placement.bottom - 1);
+    const bool firstFragment = i == 0 || placements[i - 1].row != placement.row;
+    if (firstFragment && selecting && selectionEligible(node)) {
+      renderer.drawRect(start + 1, y + 4, 18, 18);
+      if (node.selected) {
+        renderer.fillRect(start + 1, y + 4, 18, 18);
+        renderer.drawLine(start + 5, y + 12, start + 8, y + 15, 2, false);
+        renderer.drawLine(start + 8, y + 15, start + 14, y + 8, 2, false);
+      }
+    } else if (firstFragment && !selecting) {
+      if (node.todo) {
+        if (node.done) {
+          renderer.fillRect(start + 1, y + 4, 18, 18);
+          renderer.drawLine(start + 5, y + 12, start + 8, y + 15, 2, false);
+          renderer.drawLine(start + 8, y + 15, start + 14, y + 8, 2, false);
+        } else {
+          renderer.drawRect(start + 1, y + 4, 18, 18);
+        }
+      } else {
+        renderer.fillRoundedRect(start + 6, y + 10, 7, 7, 3, Color::Black);
+      }
+    }
+    const int textX = start + 25;
+    const auto title = std::string_view(node.title);
+    const bool continues = i + 1 == end && end < placements.size() && placements[end].row == placement.row;
+    for (size_t line = 0; line < placement.lineCount; ++line) {
+      auto span = outlineLines[placement.firstLine + line];
+      const int lineY = y + static_cast<int>(line) * bounds.lineHeight;
+      const bool leading = !firstFragment && line == 0;
+      const int prefix = leading ? renderer.getTextWidth(UI_12_FONT_ID, CONTINUATION) + CONTINUATION_GAP : 0;
+      const int lineX = textX + prefix;
+      std::string text;
+      if (wrapItems) {
+        text = title.substr(span.begin, span.end - span.begin);
+      } else {
+        const int width = bounds.x + bounds.width - textX - ROW_ARROW_TARGET;
+        text = renderer.truncatedText(UI_12_FONT_ID, node.title.c_str(), width);
+        if (text != title && text.ends_with("…")) span.end = text.size() - 3;
+      }
+      const auto measure = [&](size_t end) {
+        return renderer.getTextWidth(UI_12_FONT_ID, std::string(title.substr(span.begin, end - span.begin)).c_str());
+      };
+      workflowy::forEachTag(title, [&](workflowy::TextSpan tag) {
+        if (tag.end <= span.begin || tag.begin >= span.end) return;
+        const int startX = lineX + measure(std::max(tag.begin, span.begin));
+        const int endX = lineX + measure(std::min(tag.end, span.end));
+        if (endX - startX > 2)
+          renderer.fillRectDither(startX + 1, lineY, endX - startX - 2, bounds.lineHeight, Color::LightGray);
+      });
+      if (leading) renderer.drawText(UI_12_FONT_ID, textX, lineY, CONTINUATION);
+      renderer.drawText(UI_12_FONT_ID, lineX, lineY, text.c_str());
+      if (node.done || (continues && line + 1 == placement.lineCount)) {
+        const int tail = lineX + renderer.getTextWidth(UI_12_FONT_ID, text.c_str());
+        if (node.done) renderer.drawLine(lineX, lineY + 12, tail, lineY + 12);
+        if (continues && line + 1 == placement.lineCount)
+          renderer.drawText(UI_12_FONT_ID, tail + CONTINUATION_GAP, lineY, CONTINUATION);
+      }
+    }
+    if (!selecting && firstFragment && !node.leaf && node.id != zoomId) {
+      paintedArrows.push_back({node.id, placement.top, placement.bottom});
+      const int tipX = bounds.x + bounds.width - 10;
+      const int xs[3] = {tipX - 5, tipX + 4, tipX - 5};
+      const int ys[3] = {y + 8, y + 13, y + 18};
+      if (node.childrenConfirmed) {
+        renderer.fillPolygon(xs, ys, 3, true);
+      } else {
+        renderer.drawLine(tipX - 5, y + 8, tipX + 1, y + 13);
+        renderer.drawLine(tipX + 1, y + 13, tipX - 5, y + 18);
+      }
+    }
+  }
+  // Paint the marker over row artwork and keep its full thickness inside
+  // the target row, including at the last row on the page.
+  if (dropRow >= 0) {
+    for (auto i = pageStarts[page]; i < end; ++i) {
+      const auto& placement = placements[i];
+      if (placement.row != static_cast<size_t>(dropRow)) continue;
+      constexpr int thickness = 4;
+      const int left = bounds.x + 16 * (std::min<unsigned>(rows[placement.row].depth, 8) + dropInside);
+      const int marker = dropAfter || dropInside ? placement.bottom - thickness : placement.top;
+      renderer.fillRect(left, marker, bounds.x + bounds.width - left, thickness, true);
+      break;
+    }
+  }
+  const auto total = pageStarts.size();
+  const auto pending = pendingOperationsCount();
+  const auto* notice = statusNotice();
+  if (!pending && !notice && placements.empty()) notice = tr(STR_WORKFLOWY_EMPTY);
+  drawStatus(bounds, pending, notice);
+  constexpr int ICON_STROKE = 3;
+  if (total > 1) {
+    char pages[24];
+    snprintf(pages, sizeof(pages), "%u/%u", static_cast<unsigned>(page + 1), static_cast<unsigned>(total));
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer - renderer.getLineHeight(SMALL_FONT_ID) - 5, pages);
+    const int y = (bounds.rowBottom + bounds.footer) / 2;
+    for (const int direction : {-1, 1}) {
+      const bool enabled = direction < 0 ? page > 0 : page + 1 < total;
+      if (!enabled) continue;
+      for (const bool edge : {false, true}) {
+        const int slot = direction < 0 ? (edge ? 0 : 1) : (edge ? 7 : 6);
+        const int x = bounds.x + (2 * slot + 1) * bounds.width / 16;
+        const int tip = x + direction * 4;
+        renderer.drawLine(x - direction * 4, y - 6, tip, y, ICON_STROKE, true);
+        renderer.drawLine(tip, y, x - direction * 4, y + 6, ICON_STROKE, true);
+        if (edge) renderer.drawLine(tip + direction * 4, y - 6, tip + direction * 4, y + 6, ICON_STROKE, true);
+      }
+    }
+  }
+  renderer.drawLine(bounds.x, bounds.footer, bounds.x + bounds.width - 1, bounds.footer);
+  if (!selecting) {
+    const int iconY = bounds.footer + 23;
+    const auto iconX = [&](int slot) { return bounds.x + (2 * slot + 1) * bounds.width / (2 * FOOTER_CONTROLS); };
+    int x = iconX(0);
+    renderer.drawLine(x - 9, iconY, x + 9, iconY, ICON_STROKE, true);
+    renderer.drawLine(x - 9, iconY, x - 3, iconY - 6, ICON_STROKE, true);
+    renderer.drawLine(x - 9, iconY, x - 3, iconY + 6, ICON_STROKE, true);
+    const int viewX = iconX(1);
+    const int eyeX[] = {viewX - 11, viewX - 7, viewX, viewX + 7, viewX + 11, viewX + 7, viewX, viewX - 7};
+    const int eyeY[] = {iconY, iconY - 4, iconY - 6, iconY - 4, iconY, iconY + 4, iconY + 6, iconY + 4};
+    for (int i = 0; i < 8; ++i) {
+      const int next = (i + 1) % 8;
+      renderer.drawLine(eyeX[i], eyeY[i], eyeX[next], eyeY[next], ICON_STROKE, true);
+    }
+    renderer.fillRect(viewX - 2, iconY - 2, 5, 5);
+    if (!showDone) {
+      renderer.drawLine(viewX - 10, iconY + 8, viewX + 10, iconY - 8, ICON_STROKE + 2, false);
+      renderer.drawLine(viewX - 11, iconY + 7, viewX + 9, iconY - 9, ICON_STROKE, true);
+    }
+    x = iconX(2);
+    renderer.drawLine(x - 8, iconY, x + 8, iconY, ICON_STROKE, true);
+    renderer.drawLine(x, iconY - 8, x, iconY + 8, ICON_STROKE, true);
+    x = iconX(3);
+    const int undoWidth = undoReady ? ICON_STROKE : ICON_STROKE - 1;
+    renderer.drawLine(x - 10, iconY - 3, x + 4, iconY - 3, undoWidth, true);
+    renderer.drawLine(x + 4, iconY - 3, x + 9, iconY + 2, undoWidth, true);
+    renderer.drawLine(x + 9, iconY + 2, x + 4, iconY + 8, undoWidth, true);
+    renderer.drawLine(x + 4, iconY + 8, x - 3, iconY + 8, undoWidth, true);
+    renderer.drawLine(x - 10, iconY - 3, x - 4, iconY - 9, undoWidth, true);
+    renderer.drawLine(x - 10, iconY - 3, x - 4, iconY + 3, undoWidth, true);
+    x = iconX(4);
+    const int wrapWidth = wrapItems ? ICON_STROKE : ICON_STROKE - 1;
+    renderer.drawLine(x - 11, iconY - 7, x + 4, iconY - 7, wrapWidth, true);
+    renderer.drawLine(x - 11, iconY, x + 2, iconY, wrapWidth, true);
+    renderer.drawLine(x - 11, iconY + 7, x - 3, iconY + 7, wrapWidth, true);
+    renderer.drawLine(x + 9, iconY - 7, x + 9, iconY + 6, wrapWidth, true);
+    renderer.drawLine(x + 5, iconY + 2, x + 9, iconY + 6, wrapWidth, true);
+    renderer.drawLine(x + 9, iconY + 6, x + 13, iconY + 2, wrapWidth, true);
+    const auto refresh = freeink::ui::bitmapFromIcon(icon_refresh_cw_32);
+    freeink::ui::GfxRendererTarget target(renderer);
+    target.bitmap({static_cast<int16_t>(iconX(5) - refresh.width / 2),
+                   static_cast<int16_t>(iconY - icon_refresh_cw_32.opticalCenterY),
+                   static_cast<int16_t>(refresh.width), static_cast<int16_t>(refresh.height)},
+                  refresh, freeink::ui::BitmapMode::Center);
+  }
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
diff --git a/src/activities/workflowy/WorkflowyDailyActivity.h b/src/activities/workflowy/WorkflowyDailyActivity.h
new file mode 100644
index 0000000000000000000000000000000000000000..c30661c01b024f97165c60a52752afe865023959
--- /dev/null
+++ b/src/activities/workflowy/WorkflowyDailyActivity.h
@@ -0,0 +1,236 @@
+#pragma once
+
+#include <atomic>
+#include <array>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <I18n.h>
+#include <Memory.h>
+
+#include "activities/Activity.h"
+#include "workflowy/WorkflowyOutlineLayout.h"
+
+class WorkflowyDailyActivity final : public Activity {
+ public:
+  WorkflowyDailyActivity(GfxRenderer& renderer, MappedInputManager& input);
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void serviceBackgroundWork() override;
+  void render(RenderLock&&) override;
+  bool allowGlobalHomeSwipeGesture() const override { return false; }
+  bool preventAutoSleep() override { return !saves.empty(); }
+
+ private:
+  struct Node {
+    std::string id;
+    std::string title;
+    unsigned depth = 0;
+    int priority = 0;
+    bool todo = false;
+    bool done = false;
+    bool leaf = false;
+    bool childrenConfirmed = false;
+    bool selected = false;
+  };
+
+  enum class Step { Start, Waiting, Load, Ready };
+  Step step = Step::Start;
+  std::vector<Node> rows;
+  std::string credential;
+  std::string date;
+  const char* message = nullptr;
+  bool ownsWifi = false;
+  bool showDone = false;
+  bool wrapItems = true;
+  int wrapAnchor = -1;
+  size_t page = 0;
+  int touchX = 0;
+  int touchY = 0;
+  int lastX = 0;
+  int lastY = 0;
+  unsigned long touchAt = 0;
+  unsigned long gestureEndedAt = 0;
+  bool tracking = false;
+  bool moved = false;
+  int peakY = 0;
+  bool layoutDirty = true;
+  int dragRow = -1;
+  int dropRow = -1;
+  bool dropAfter = false;
+  bool dropInside = false;
+  enum class BulkAction { None, Done, Undone, MoveDate, Delete };
+  bool selecting = false;
+  bool selectionEligible(const Node& node) const;
+  size_t selectionCount() const;
+  void cancelSelection();
+  void toggleSelection(size_t row);
+  void selectAll();
+  void showBulkMenu();
+  void startBulk(BulkAction action, std::string target = {});
+  void showBulkMoveMenu();
+  bool online = false;
+  bool connectingWifi = false;
+  unsigned long wifiStartedAt = 0;
+  bool scanningWifi = false, scannedSavedWifi = false;
+  std::vector<std::string> savedWifiCandidates;
+  void trySavedWifi(const std::string& ssid);
+  void scanSavedWifi();
+  void showWifiPicker();
+  void refresh(bool configure);
+  size_t pendingOperationsCount() const;
+  const char* statusNotice() const;
+  void pollWifiConnection();
+  unsigned long nextLinkCheck = 0;
