+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "activities/Activity.h"
+
+namespace freeink {
+class SecureHttpClient;
+}
+
+class WorkflowyShareActivity final : public Activity {
+ public:
+  // SIZE_MAX sends the current book's clippings. Color follows its list filter.
+  WorkflowyShareActivity(GfxRenderer& renderer, MappedInputManager& input, size_t index, int colorFilter = 0);
+  ~WorkflowyShareActivity() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  void onExit() override;
+  bool preventAutoSleep() override { return true; }
+
+ private:
+  enum class Step { Menu, Waiting, Key, Destination, Note, Connect, Send, Done };
+  enum class Content { Both, Quote, Note };
+  Step step = Step::Menu;
+  Content content = Content::Both;
+  size_t index;
+  size_t next = 0;
+  std::atomic<unsigned> sent{0};
+  int colorFilter;
+  bool ownsWifi = false;
+  bool sendAfterKey = false;
+  std::string credential;
+  std::string destination;
+  std::string summary;
+  std::string sentFile;
+  std::vector<uint64_t> receipts;
+  bool alreadySent = false;
+  std::unique_ptr<freeink::SecureHttpClient> client;
+
+  void menu();
+  void editSetting(bool apiKey);
+  void editNote();
+  void connect();
+  bool loadReceipts();
+  bool recordReceipt(uint64_t receipt);
+  void sendNext();
+  void complete(const char* message);
+};
