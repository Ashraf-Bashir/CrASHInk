+template <typename Work>
+int WorkflowyDailyActivity::requestWhilePaging(Work work) {
+  struct Request {
+    Work work;
+    int status = 0;
+    std::atomic<bool> ready{false};
+  } request{std::move(work)};
+  const auto task = [](void* context) {
+    auto& request = *static_cast<Request*>(context);
+    request.status = request.work();
+    request.ready.store(true, std::memory_order_release);
+    vTaskDelete(nullptr);
+  };
+  if (xTaskCreate(task, "wf-request", 8192, &request, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    LOG_ERR("WF", "Could not start Workflowy request");
+    return 0;
+  }
+  using Button = MappedInputManager::Button;
+  using Swipe = MappedInputManager::SwipeDir;
+  while (!request.ready.load(std::memory_order_acquire)) {
+    mappedInput.update();
+    Swipe swipe = Swipe::None;
+    int startX = 0, startY = 0, endX = 0, endY = 0;
+    mappedInput.wasSwipeWithPoints(swipe, startX, startY, endX, endY);
+    if (swipe == Swipe::Up || mappedInput.wasReleased(Button::Down)) nextPage(1);
+    if (swipe == Swipe::Down || mappedInput.wasReleased(Button::Up)) nextPage(-1);
+    vTaskDelay(1);
+  }
+  return request.status;
+}
