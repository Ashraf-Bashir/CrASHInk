+WorkflowyDailyActivity::WorkflowyDailyActivity(GfxRenderer& renderer, MappedInputManager& input, bool calendar)
+    : Activity("WorkflowyDaily", renderer, input), startInCalendar(calendar) {}
+
+void WorkflowyDailyActivity::onEnter() {
+  Activity::onEnter();
+  credential = workflowy::readSetting(workflowy::KEY_FILE, workflowy::KEY_MAX);
+  date = isoDate(0);
+  if (date.empty()) date = "today";
+  outbox = workflowy::readSetting(OUTBOX, OUTBOX_LIMIT);
+  JsonDocument saved;
+  if (!outbox.empty() && !deserializeJson(saved, outbox)) {
+    pendingCount = saved["items"].size();
+    outboxUncertain = saved["sending"] | false;
+  }
+  online = hasActiveStationWifiConnection();
+  if (startInCalendar) openCalendar(false);
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::onExit() {
+  if (timeChoices) {
+    timeChoices->cancel.store(true, std::memory_order_relaxed);
+    while (timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+    timeChoices.reset();
+  }
+  if (calendarFetch) {
+    calendarFetch->cancel.store(true, std::memory_order_relaxed);
+    while (!calendarFetch->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+    calendarFetch.reset();
+  }
+  for (const auto& save : saves) {
+    if (!save->started) break;
+    while (!save->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+  }
+  saves.clear();
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  if (scanningWifi) WiFi.scanDelete();
+  if (ownsWifi) WiFi.disconnect(false, false);
+  // The fetch owns a TLS session. Wait for its cleanup before the Library can open.
+  while (prefetch && !prefetch->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+  prefetch.reset();
+  if (ownsWifi) WiFi.mode(WIFI_OFF);
+  Activity::onExit();
+}
+
+void WorkflowyDailyActivity::showMessage(const char* text) {
+  {
+    RenderLock lock(*this);
+    message = text;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::showErrorDetails() {
+  if (!isErrorNotice(message)) return;
+  std::string details;
+  if (message == tr(STR_WORKFLOWY_OUTBOX_ACCOUNT) || message == tr(STR_WORKFLOWY_SAVE_FAILED)) {
+    details = tr(STR_WORKFLOWY_LOCAL_SAVE_DETAILS);
+  } else if (!online && lastStatus <= 0) {
+    details = tr(STR_WORKFLOWY_NO_WIFI_DETAILS);
+  } else if (message == tr(STR_WORKFLOWY_CLOCK_FAILED) || lastStatus == -2) {
+    details = tr(STR_WORKFLOWY_CLOCK_DETAILS);
+  } else if (lastStatus >= 400) {
+    details = "HTTP " + std::to_string(lastStatus);
+    if (lastStatus == 401 || lastStatus == 403) details += " · " + std::string(tr(STR_WORKFLOWY_AUTH_FAILED));
+    if (lastStatus == 429) details += " · " + std::string(tr(STR_WORKFLOWY_RATE_LIMIT));
+  } else if (lastTransport != ESP_OK || lastStatus == -5) {
+    details = esp_err_to_name(lastStatus == -5 ? ESP_ERR_NO_MEM : lastTransport);
+  } else if (lastStatus == -3) {
+    details = tr(STR_WORKFLOWY_RESPONSE_DETAILS);
+  }
+  if (!lastServerError.empty()) {
+    if (!details.empty()) details += " · ";
+    details += lastServerError;
+  }
+  startActivityForResult(std::make_unique<WorkflowyErrorDetails>(renderer, mappedInput, message, std::move(details)),
+                         [](const ActivityResult&) {});
+}
+
+void WorkflowyDailyActivity::connect() {
+  if (workflowy::shareInProgress()) return;
+  if (credential.empty()) return editKey();
+  if (hasActiveStationWifiConnection()) {
+    {
+      RenderLock lock(*this);
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+    return;
+  }
+  if (!WIFI_STORE.getCredentialCount()) return showWifiPicker();
+  WiFi.persistent(false);
+  const auto previousMode = WiFi.getMode();
+  if (!WiFi.mode(WIFI_STA)) {
+    step = Step::Ready;
+    return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  }
+  ownsWifi = ownsWifi || previousMode == WIFI_OFF;
+  WiFi.setAutoReconnect(false);
+  WiFi.setScanMethod(WIFI_ALL_CHANNEL_SCAN);
+  WiFi.setSortMethod(WIFI_CONNECT_AP_BY_SIGNAL);
+  savedWifiCandidates.clear();
+  scannedSavedWifi = false;
+  const auto last = WIFI_STORE.getLastConnectedSsid();
+  if (!last.empty() && WIFI_STORE.hasSavedCredential(last)) trySavedWifi(last);
+  else scanSavedWifi();
+  {
+    RenderLock lock(*this);
+    connectingWifi = true;
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::trySavedWifi(const std::string& ssid) {
+  const auto saved = WIFI_STORE.findCredential(ssid);
+  if (saved) {
+    const auto* password = saved->password.empty() ? nullptr : saved->password.c_str();
+    WiFi.begin(saved->ssid.c_str(), password);
+  }
+  wifiStartedAt = millis();
+}
+
+void WorkflowyDailyActivity::scanSavedWifi() {
+  WiFi.disconnect(false, false);
+  WiFi.scanDelete();
+  scanningWifi = true;
+  scannedSavedWifi = true;
+  wifiStartedAt = millis();
+  WiFi.scanNetworks(true);
+}
+
+void WorkflowyDailyActivity::pollWifiConnection() {
+  if (!connectingWifi || tracking) return;
+  if (hasActiveStationWifiConnection()) {
+    if (scanningWifi) WiFi.scanDelete();
+    scanningWifi = false;
+    savedWifiCandidates.clear();
+    const std::string connectedSsid = WiFi.SSID().c_str();
+    if (connectedSsid != WIFI_STORE.getLastConnectedSsid()) WIFI_STORE.setLastConnectedSsid(connectedSsid);
+    {
+      RenderLock lock(*this);
+      connectingWifi = false;
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+    return;
+  }
+  if (scanningWifi) {
+    const int count = WiFi.scanComplete();
+    if (count == WIFI_SCAN_RUNNING && millis() - wifiStartedAt < 10000) return;
+    const auto last = WIFI_STORE.getLastConnectedSsid();
+    for (int i = 0; i < count && savedWifiCandidates.size() < WIFI_STORE.getCredentialCount(); ++i) {
+      const std::string ssid = WiFi.SSID(i).c_str();
+      if (ssid != last && WIFI_STORE.hasSavedCredential(ssid) &&
+          std::find(savedWifiCandidates.begin(), savedWifiCandidates.end(), ssid) == savedWifiCandidates.end()) {
+        savedWifiCandidates.push_back(ssid);
+      }
+    }
+    WiFi.scanDelete();
+    scanningWifi = false;
+    if (savedWifiCandidates.empty()) {
+      wifiStartedAt = millis() - SAVED_WIFI_TIMEOUT;
+    }
+  } else if (millis() - wifiStartedAt < SAVED_WIFI_TIMEOUT) {
+    return;
+  }
+  if (!scannedSavedWifi) return scanSavedWifi();
+  if (!savedWifiCandidates.empty()) {
+    const auto next = std::move(savedWifiCandidates.front());
+    savedWifiCandidates.erase(savedWifiCandidates.begin());
+    WiFi.disconnect(false, false);
+    return trySavedWifi(next);
+  }
+  if (tracking || !saves.empty()) return;
+  {
+    RenderLock lock(*this);
+    connectingWifi = false;
+  }
+  if (ownsWifi) {
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+    ownsWifi = false;
+  }
+  showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+}
+
+void WorkflowyDailyActivity::showWifiPicker() {
+  const bool hadConnection = hasActiveStationWifiConnection();
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput, true),
+                         [this, hadConnection](const ActivityResult& result) {
+    const auto* wifi = std::get_if<WifiResult>(&result.data);
+    if (result.isCancelled || !wifi || !wifi->connected) {
+      step = Step::Ready;
+      return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    }
+    ownsWifi = ownsWifi || !hadConnection;
+    {
+      RenderLock lock(*this);
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+  });
+}
+
+void WorkflowyDailyActivity::refresh(bool configure) {
+  if (connectingWifi) return;
+  if (configure) {
+    if (!saves.empty()) return;
+    startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                               renderer, mappedInput, "WorkflowyConnection", StrId::STR_SYSTEM_NETWORK_SYNC,
+                               std::vector<std::string>{tr(STR_WIFI_NETWORKS), tr(STR_WORKFLOWY_API_KEY)}, 0, false, true),
+                           [this](const ActivityResult& result) {
+      if (result.isCancelled) return;
+      if (std::get<OptionSelectionResult>(result.data).index == 0) showWifiPicker();
+      else editKey();
+    });
+    return;
+  }
+  if (hasActiveStationWifiConnection() && !credential.empty()) {
+    {
+      RenderLock lock(*this);
+      for (auto& row : rows) if (row.id != zoomId && row.leaf) row.leaf = false;
+    }
+    loadDay();
+  } else {
+    step = Step::Start;
+  }
+}
+
+void WorkflowyDailyActivity::editKey() {
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                             renderer, mappedInput, tr(STR_WORKFLOWY_API_KEY), "", workflowy::KEY_MAX, InputType::Password),
+                         [this](const ActivityResult& result) {
+    step = Step::Ready;
+    if (result.isCancelled) return;
+    const auto& key = std::get<KeyboardResult>(result.data).text;
+    if (key.empty() || !workflowy::writeSetting(workflowy::KEY_FILE, key)) {
+      showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    credential = key;
+    step = Step::Start;
+  });
+}
+
+void WorkflowyDailyActivity::recordServerError(int status, int transport, const std::string& errorBody,
+                                                 const std::string& key) {
+  lastStatus = status;
+  lastTransport = transport;
+  lastServerError.clear();
+  if (!errorBody.empty()) {
+    JsonDocument error;
+    if (!deserializeJson(error, errorBody)) {
+      const char* reason = error["message"] | "";
+      if (!*reason) reason = error["error"]["message"] | "";
+      if (!*reason) reason = error["error"] | "";
+      if (!*reason) reason = error["code"] | "";
+      lastServerError = plainTitle(reason);
+      if (!key.empty()) {
+        for (size_t at = 0; (at = lastServerError.find(key, at)) != std::string::npos; at += 3) {
+          lastServerError.replace(at, key.size(), "***");
+        }
+      }
+    }
+  }
+}
+
+void WorkflowyDailyActivity::saveTask(void* argument) {
+  auto& save = *static_cast<Save*>(argument);
+  if (save.work) save.work(save);
+  else save.status = requestWithKey(save.key, save.method, save.path, save.body,
+                               save.captureResponse ? save.response.data() : nullptr,
+                               &save.received, save.response.size(), nullptr, nullptr, &save.transport, &save.error);
+  save.ready.store(true, std::memory_order_release);
+  vTaskDelete(nullptr);
+}
+
+bool WorkflowyDailyActivity::itemPending(const std::string& id) const {
+  return !id.empty() &&
+         (id == pendingDelete || std::any_of(saves.begin(), saves.end(), [&](const auto& save) {
+           return save->item == id || (!save->scope.empty() && save->scope == (zoomId.empty() ? date : zoomId));
+         }));
+}
+
+void WorkflowyDailyActivity::refreshOfflineQueuePreview() {
+  std::vector<std::string> preview;
+  JsonDocument document;
+  if (!outbox.empty() && !deserializeJson(document, outbox)) {
+    for (const auto& item : document["items"].as<JsonArray>()) {
+      const auto title = plainTitle(item["name"] | "");
+      preview.push_back(title.substr(0, 120));
+    }
+  }
+  RenderLock lock(*this);
+  offlineQueuePreview = std::move(preview);
+}
+
+size_t WorkflowyDailyActivity::pendingOperationsCount() const {
+  const bool sendingCapture = pendingCount && std::any_of(saves.begin(), saves.end(), [](const auto& save) {
+    return save->fromOutbox;
+  });
+  size_t calendarReads = 0;
+  if (calendarVisible) {
+    for (const auto& day : calendarDays) if (!day.date.empty() && !day.loaded) ++calendarReads;
+  }
+  return saves.size() + pendingCount - sendingCapture + !requestedBranch.empty() + calendarReads +
+         (!calendarVisible && awaitingOutline);
+}
+
+void WorkflowyDailyActivity::showPendingOperations() {
+  {
+    RenderLock lock(*this);
+    queueVisible = !queueVisible;
+    queuePage = 0;
+    if (!queueVisible) offlineQueuePreview.clear();
+    tracking = dragging = false;
+  }
+  if (queueVisible) refreshOfflineQueuePreview();
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::queueSave(std::string path, std::string body, bool capture,
+                                       std::function<void(const Save&)> finish, const char* method,
+                                       StrId label, std::string item, std::function<void(Save&)> work) {
+  if (saves.size() >= MAX_SAVE_QUEUE) {
+    showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+    return false;
+  }
+  auto save = makeUniqueNoThrow<Save>();
+  if (!save) {
+    recordServerError(-5, ESP_ERR_NO_MEM, {}, credential);
+    showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    return false;
+  }
+  save->key = credential;
+  save->path = std::move(path);
+  save->body = std::move(body);
+  save->captureResponse = capture;
+  save->finish = std::move(finish);
+  save->method = method;
+  save->label = label;
+  save->item = std::move(item);
+  save->work = std::move(work);
+  const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& row) { return row.id == save->item; });
+  if (node != rows.end()) save->title = node->title.substr(0, 120);
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+  if (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire))
+    timeChoices->cancel.store(true, std::memory_order_relaxed);
+  {
+    RenderLock lock(*this);
+    saves.push_back(std::move(save));
+    message = nullptr;
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::serviceBackgroundWork() {
+  if (saves.empty()) {
+    pollTimeChoices();
+    return;
+  }
+  for (auto& item : saves) {
+    auto& save = *item;
+    if (save.ready.load(std::memory_order_acquire)) continue;
+    if (save.started || (prefetch && !prefetch->ready.load(std::memory_order_acquire)) ||
+        (calendarFetch && !calendarFetch->ready.load(std::memory_order_acquire)) ||
+        (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire))) return;
+    prefetch.reset();
+    calendarFetch.reset();
+    save.started = true;
+    if (xTaskCreate(saveTask, "wf-save", 8192, &save, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+      save.status = -5;
+      save.transport = ESP_ERR_NO_MEM;
+      save.ready.store(true, std::memory_order_release);
+    }
+    return;
+  }
+}
+
+bool WorkflowyDailyActivity::pollSave() {
+  serviceBackgroundWork();
+  if (saves.empty() || !saves.front()->ready.load(std::memory_order_acquire)) return false;
+  std::unique_ptr<Save> completed;
+  {
+    RenderLock lock(*this);
+    completed = std::move(saves.front());
+    saves.pop_front();
+    layoutDirty = true;
+  }
+  recordServerError(completed->status, completed->transport, completed->error, completed->key);
+  completed->finish(*completed);
+  if (leaveAfterSave && saves.empty()) {
+    leaveAfterSave = false;
+    if (!queueVisible && completed->status >= 200 && completed->status < 300) back();
+  }
+  requestUpdate();
+  return true;
+}
+
+int WorkflowyDailyActivity::requestWithKey(const std::string& key, const char* method, const std::string& path,
+                                          const std::string& body, uint8_t* response, size_t* received,
+                                          size_t capacity, HeapByteBuffer* growable,
+                                          const std::atomic<bool>* cancel, int* transport,
+                                          std::string* serverError) {
+  if (cancel && cancel->load(std::memory_order_relaxed)) return -4;
+  if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) {
+    return -2;
+  }
+  struct Response {
+    uint8_t* buffer;
+    size_t* used;
+    size_t capacity;
+    HeapByteBuffer* growable;
+    const std::atomic<bool>* cancel;
+    std::string* serverError;
+    bool overflow = false;
+  } sink{response, received, capacity, growable, cancel, serverError};
+
+  const auto url = std::string(API) + path;
+  esp_http_client_config_t config{};
+  config.url = url.c_str();
+  config.method = strcmp(method, "GET") == 0 ? HTTP_METHOD_GET
+                  : strcmp(method, "DELETE") == 0 ? HTTP_METHOD_DELETE
+                                                  : HTTP_METHOD_POST;
+  config.crt_bundle_attach = esp_crt_bundle_attach;
+  config.user_agent = "CrASHInk/Workflowy";
+  config.timeout_ms = cancel ? 5000 : 12000;
+  config.disable_auto_redirect = true;
+  config.max_authorization_retries = -1;
+  config.user_data = &sink;
+  config.event_handler = [](esp_http_client_event_t* event) -> esp_err_t {
+    auto& target = *static_cast<Response*>(event->user_data);
+    if (target.cancel && target.cancel->load(std::memory_order_relaxed)) return ESP_FAIL;
+    if (event->event_id != HTTP_EVENT_ON_DATA || event->data_len <= 0) return ESP_OK;
+    const auto length = static_cast<size_t>(event->data_len);
+    if (target.serverError && esp_http_client_get_status_code(event->client) >= 400) {
+      const size_t available = MAX_ERROR_BODY - target.serverError->size();
+      target.serverError->append(static_cast<const char*>(event->data), std::min(available, length));
+      return ESP_OK;
+    }
+    if (!target.buffer && !target.growable) return ESP_OK;
+    const auto needed = *target.used + length;
+    if (!target.overflow && target.growable && needed > target.capacity && needed <= MAX_RESPONSE) {
+      const size_t expanded = std::max(needed, std::min(MAX_RESPONSE, std::max<size_t>(4096, target.capacity * 2)));
+      auto* resized = static_cast<uint8_t*>(
+          heap_caps_realloc(target.buffer, expanded, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+      if (resized) {
+        target.growable->release();
+        target.growable->reset(resized);
+        target.buffer = resized;
+        target.capacity = expanded;
+      }
+    }
+    if (target.overflow || needed > target.capacity) {
+      target.overflow = true;
+      return ESP_ERR_NO_MEM;
+    }
+    memcpy(target.buffer + *target.used, event->data, length);
+    *target.used += length;
+    return ESP_OK;
+  };
+
+  auto client = esp_http_client_init(&config);
+  if (!client) {
+    if (transport) *transport = ESP_ERR_NO_MEM;
+    return 0;
+  }
+  const auto authorization = "Bearer " + key;
+  auto result = esp_http_client_set_header(client, "Authorization", authorization.c_str());
+  if (result == ESP_OK && !body.empty()) {
+    result = esp_http_client_set_header(client, "Content-Type", "application/json");
+    if (result == ESP_OK) result = esp_http_client_set_post_field(client, body.data(), body.size());
+  }
+  if (result == ESP_OK && config.method == HTTP_METHOD_POST && body.empty()) {
+    result = esp_http_client_set_header(client, "Content-Length", "0");
+  }
+  if (result == ESP_OK) result = esp_http_client_perform(client);
+  const int status = esp_http_client_get_status_code(client);
+  const bool complete = esp_http_client_is_complete_data_received(client);
+  if (result != ESP_OK || status >= 400) {
+    LOG_ERR("WF", "Workflowy %s failed: transport=%s HTTP=%d", method, esp_err_to_name(result), status);
+  }
+  esp_http_client_cleanup(client);
+  if (transport) {
+    *transport = sink.overflow ? ESP_ERR_NO_MEM
+                 : result == ESP_OK && !complete && (response || growable) ? ESP_ERR_HTTP_INCOMPLETE_DATA
+                                                                          : result;
+  }
+  if (cancel && cancel->load(std::memory_order_relaxed)) return -4;
+  if (status >= 400) return status;
+  return result == ESP_OK && !sink.overflow && (complete || (!response && !growable)) ? status : 0;
+}
+
+int WorkflowyDailyActivity::fetchChildren(const std::string& key, const std::string& parent, unsigned depth,
+                                         std::vector<Node>& result, const std::atomic<bool>* cancel, int* transport) {
+  HeapByteBuffer response;
+  size_t received = 0;
+  const int status = requestWithKey(key, "GET", "?parent_id=" + parent, {}, nullptr, &received, 0, &response, cancel, transport);
+  if (status == 404 && depth == 0) return 200;
+  if (status != 200) return status;
+  if (!response) return -3;
+  JsonDocument filter;
+  auto node = filter["nodes"][0];
+  node["id"] = true;
+  node["name"] = true;
+  node["priority"] = true;
+  node["completed"] = true;
+  node["data"]["layoutMode"] = true;
+  node["note"] = true;
+  ResponseAllocator allocator;
+  JsonDocument doc(&allocator);
+  if (deserializeJson(doc, response.get(), received, DeserializationOption::Filter(filter)) || !doc["nodes"].is<JsonArray>()) {
+    return -3;
+  }
+  const auto nodes = doc["nodes"].as<JsonArrayConst>();
+  if (nodes.size() > MAX_ROWS) {
+    return -3;
+  }
+  result.reserve(nodes.size());
+  for (const auto value : nodes) {
+    std::string id = value["id"] | "";
+    if (id.empty() || id.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) continue;
+    result.push_back({std::move(id), plainTitle(value["name"] | ""), depth, value["priority"] | 0,
+                      strcmp(value["data"]["layoutMode"] | "", "todo") == 0, value["completed"] | false});
+    result.back().divider = strcmp(value["data"]["layoutMode"] | "", "divider") == 0;
+    result.back().scheduledDivider = result.back().divider && strcmp(value["note"] | "", "crASHink:scheduled-divider") == 0;
+  }
+  std::stable_sort(result.begin(), result.end(), [](const Node& a, const Node& b) { return a.priority < b.priority; });
+  return 200;
+}
+
+void WorkflowyDailyActivity::syncNode(const Node& updated) {
+  for (auto& view : viewStack) {
+    for (auto& copy : view.rows) {
+      if (copy.id != updated.id) continue;
+      copy.done = updated.done;
+      copy.todo = updated.todo;
+      copy.title = updated.title;
+    }
+  }
+}
+
+void WorkflowyDailyActivity::appendChild(std::vector<Node>& outline, const std::string& parent, Node node) {
+  if (parent.empty()) {
+    if (outline.size() < MAX_ROWS) outline.push_back(std::move(node));
+    return;
+  }
+  auto owner = std::find_if(outline.begin(), outline.end(), [&](const Node& row) { return row.id == parent; });
+  if (owner == outline.end()) return;
+  auto end = owner + 1;
+  const bool cached = owner->leaf || (end != outline.end() && end->depth > owner->depth);
+  owner->leaf = false;
+  owner->childrenConfirmed = true;
+  if (!cached || outline.size() == MAX_ROWS) return;
+  node.depth = owner->depth + 1;
+  while (end != outline.end() && end->depth > owner->depth) ++end;
+  outline.insert(end, std::move(node));
+}
+
+void WorkflowyDailyActivity::removeNode(const std::string& id, const bool moveToCurrentDay) {
+  const bool leaveZoom = id == zoomId;
+  {
+    RenderLock lock(*this);
+    std::vector<Node> movedBranch;
+    const auto removeFrom = [&](std::vector<Node>& outline) {
+      const auto first = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (first == outline.end()) return;
+      const auto depth = first->depth;
+      auto end = first + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      if (moveToCurrentDay && end - first > static_cast<ptrdiff_t>(movedBranch.size())) {
+        movedBranch.assign(first, end);
+        for (auto& node : movedBranch) node.depth -= depth;
+      }
+      if (depth > 0) {
+        auto parent = first;
+        while (parent != outline.begin() && (--parent)->depth >= depth) {}
+        if (parent + 1 == first && (end == outline.end() || end->depth < depth)) {
+          parent->leaf = true;
+          parent->childrenConfirmed = false;
+        }
+      }
+      outline.erase(first, end);
+    };
+    removeFrom(rows);
+    for (auto& view : viewStack) removeFrom(view.rows);
+    if (moveToCurrentDay && !movedBranch.empty()) {
+      auto& dailyRows = viewStack.empty() ? rows : viewStack.front().rows;
+      if (dailyRows.size() + movedBranch.size() <= MAX_ROWS)
+        dailyRows.insert(dailyRows.end(), std::make_move_iterator(movedBranch.begin()),
+                         std::make_move_iterator(movedBranch.end()));
+    }
+    layoutDirty = true;
+    message = nullptr;
+  }
+  if (leaveZoom) back();
+  else requestUpdate();
+}
+
+// Reconcile one ordered sibling list, retaining each matching node's cached subtree.
+bool WorkflowyDailyActivity::replaceSiblings(std::vector<Node>& outline, const std::string& parent,
+                                            const std::vector<Node>& siblings) {
+  auto first = outline.begin(), end = outline.end();
+  unsigned depth = 0;
+  bool changed = false;
+  if (!parent.empty()) {
+    const auto owner = std::find_if(first, end, [&](const Node& row) { return row.id == parent; });
+    if (owner == end) return false;
+    depth = owner->depth + 1;
+    first = end = owner + 1;
+    while (end != outline.end() && end->depth >= depth) ++end;
+    changed = owner->leaf != siblings.empty() || owner->childrenConfirmed == siblings.empty();
+    owner->leaf = siblings.empty();
+    owner->childrenConfirmed = !owner->leaf;
+  }
+  const auto localCreate = [depth](const Node& node) {
+    return node.depth == depth && node.id.starts_with("pending:");
+  };
+  const size_t staged = std::count_if(first, end, localCreate);
+  const size_t baseCount = outline.size() - (end - first) + siblings.size() + staged;
+  if (baseCount > MAX_ROWS) return changed;
+  auto current = first;
+  for (const auto& sibling : siblings) {
+    if (current == end || current->id != sibling.id || current->title != sibling.title ||
+        current->todo != sibling.todo || current->done != sibling.done ||
+        current->divider != sibling.divider || current->scheduledDivider != sibling.scheduledDivider) {
+      changed = true;
+      break;
+    }
+    ++current;
+    while (current != end && current->depth > depth) ++current;
+  }
+  if (!changed && current == end) return false;
+  size_t retained = 0;
+  std::vector<Node> rebuilt;
+  rebuilt.reserve(std::max(static_cast<size_t>(end - first), siblings.size()));
+  for (auto node : siblings) {
+    node.depth = depth;
+    const auto old = std::find_if(first, end, [&](const Node& candidate) {
+      return candidate.depth == depth && candidate.id == node.id;
+    });
+    if (old == end) {
+      rebuilt.push_back(std::move(node));
+      continue;
+    }
+    node.leaf = old->leaf;
+    node.childrenConfirmed = old->childrenConfirmed;
+    node.selected = old->selected;
+    if (itemPending(node.id)) {
+      node.title = old->title;
+      node.todo = old->todo;
+      node.done = old->done;
+    }
+    auto lastChild = old + 1;
+    while (lastChild != end && lastChild->depth > depth) ++lastChild;
+    const size_t count = lastChild - (old + 1);
+    const bool fits = baseCount + retained + count <= MAX_ROWS;
+    rebuilt.push_back(std::move(node));
+    if (fits) {
+      rebuilt.insert(rebuilt.end(), std::make_move_iterator(old + 1), std::make_move_iterator(lastChild));
+      retained += count;
+    }
+  }
+  std::copy_if(first, end, std::back_inserter(rebuilt), localCreate);
+  first = outline.erase(first, end);
+  outline.insert(first, std::make_move_iterator(rebuilt.begin()), std::make_move_iterator(rebuilt.end()));
+  return true;
+}
+
+void WorkflowyDailyActivity::loadDay() {
+  if (date.empty()) {
+    auto today = isoDate(0);
+    RenderLock lock(*this);
+    date = today.empty() ? "today" : std::move(today);
+  }
+  // Keep one network reader. Its existing cancellation flag lets the
+  // worker release its TLS resources before the replacement starts.
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  ++generation;
+  rootCheckedAt = millis() - SYNC_INTERVAL;
+  nextPrefetchAt = millis();
+  {
+    RenderLock lock(*this);
+    requestedBranch.clear();
+    awaitingOutline = true;
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::updateCompletion(const std::string& id, bool done) {
+  RenderLock lock(*this);
+  for (auto& node : rows) {
+    if (node.id == id) node.done = done;
+  }
+  for (auto& view : viewStack) {
+    for (auto& node : view.rows) {
+      if (node.id == id) node.done = done;
+    }
+  }
+  layoutDirty = true;
+  message = nullptr;
+}
+
+void WorkflowyDailyActivity::toggle(const size_t row) {
+  if (itemPending(rows[row].id) || (!rows[row].todo && !rows[row].done)) return;
+  const bool completed = rows[row].done;
+  const char* failed = completed ? tr(STR_WORKFLOWY_UNCOMPLETE_FAILED) : tr(STR_WORKFLOWY_COMPLETE_FAILED);
+  if (!online) {
+    recordServerError(0, 0, {}, credential);
+    return showMessage(failed);
+  }
+  const auto id = rows[row].id;
+  const auto label = completed ? StrId::STR_WORKFLOWY_MARK_UNDONE : StrId::STR_WORKFLOWY_MARK_DONE;
+  if (queueSave("/" + id + (completed ? "/uncomplete" : "/complete"), {}, false,
+                [this, id, completed, failed](const Save& save) {
+      if (save.status < 200 || save.status >= 300) {
+        updateCompletion(id, completed);
+        return showMessage(failed);
+      }
+      offerUndo([this, id, completed] {
+        if (itemPending(id)) return false;
+        if (!queueSave("/" + id + (completed ? "/complete" : "/uncomplete"), {}, false,
+                       [this, id, completed](const Save& undone) {
+          if (undone.status < 200 || undone.status >= 300) {
+            updateCompletion(id, !completed);
+            showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+          }
+        }, "POST", completed ? StrId::STR_WORKFLOWY_MARK_DONE : StrId::STR_WORKFLOWY_MARK_UNDONE, id)) return false;
+        updateCompletion(id, completed);
+        return true;
+      });
+    }, "POST", label, id)) {
+    updateCompletion(id, !completed);
+  }
+}
+
+bool WorkflowyDailyActivity::tapArrow(int x, int y) {
+  size_t row;
+  bool expanded;
+  {
+    RenderLock lock(*this);
+    const int right = laidOut.x + laidOut.width;
+    if (page != paintedPage || x < right - ROW_ARROW_TARGET || x >= right + 8) return false;
+    const auto hit = std::find_if(paintedArrows.begin(), paintedArrows.end(), [&](const PaintedArrow& arrow) {
+      return y >= arrow.top && y < arrow.bottom;
+    });
+    if (hit == paintedArrows.end()) return false;
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& item) { return item.id == hit->id; });
+    if (node == rows.end()) return true;
+    row = node - rows.begin();
+    expanded = node->id == zoomId;
+  }
+  if (expanded) {
+    if (!viewStack.empty()) back();
+  } else if (!itemPending(rows[row].id)) zoom(row);
+  return true;
+}
+
+void WorkflowyDailyActivity::edit(const size_t row, const int relative, const size_t cursor,
+                                   std::string initialText, std::string targetDate) {
+  if (row < rows.size() && itemPending(rows[row].id)) return;
+  const bool adding = relative != 0 || row >= rows.size();
+  if (!online && (!adding || relative != 0)) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const std::string id = row < rows.size() ? rows[row].id : "";
+  const std::string initial = adding ? (initialText.empty() ? "[] " : std::move(initialText)) : rows[row].title;
+  const bool originalTodo = !adding && rows[row].todo;
+  const int parentIndex = relative ? parentRow(row) : -1;
+  const bool scheduled = !targetDate.empty();
+  const std::string createDate = scheduled ? std::move(targetDate) : date;
+  const std::string parent = scheduled ? "" : relative ? (parentIndex < 0 ? "" : rows[parentIndex].id) : zoomId;
+  auto keyboard = std::make_unique<KeyboardEntryActivity>(
+      renderer, mappedInput, adding ? tr(STR_WORKFLOWY_ADD) : tr(STR_EDIT), initial, 512);
+  keyboard->setInitialCursor(adding ? initial.size() : cursor);
+  keyboard->enableWorkflowyTags(adding);
+  startActivityForResult(std::move(keyboard), [this, id, initial, originalTodo, parent, adding, relative, createDate, scheduled](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    auto text = std::get<KeyboardResult>(result.data).text;
+    workflowy::dropEmoji(text);
+    const auto first = text.find_first_not_of(" ");
+    const bool makeTodo = first != std::string::npos && (text.compare(first, 2, "[]") == 0 ||
+                                                         text.compare(first, 3, "[ ]") == 0);
+    if (makeTodo) {
+      const auto start = text.find_first_not_of(" ", first + (text[first + 1] == ']' ? 2 : 3));
+      text = start == std::string::npos ? "" : text.substr(start);
+    }
+    if (text == initial && !makeTodo) return;
+    if (text.find_first_not_of(" \t\r\n") == std::string::npos) return;
+    JsonDocument update;
+    update["name"] = escapedTitle(text, adding);
+    if (makeTodo) update["layoutMode"] = "todo";
+    if (adding) {
+      update["parent_id"] = parent.empty() ? createDate : parent;
+      update["layoutMode"] = makeTodo ? "todo" : "bullets";
+      update["position"] = "bottom";
+    }
+    if (adding && !hasActiveStationWifiConnection()) {
+      if (!relative && queueCapture(encode(update))) showMessage(tr(STR_WORKFLOWY_CAPTURE_QUEUED));
+      else showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    const auto localId = adding ? "pending:" + std::to_string(++temporaryId) : id;
+    const auto capturedDate = createDate;
+    const auto label = adding ? StrId::STR_WORKFLOWY_ADD : StrId::STR_EDIT;
+    if (!queueSave(adding ? "" : "/" + id, encode(update), adding,
+              [this, id, localId, parent, initial, originalTodo, adding, relative, capturedDate](const Save& save) {
+      if (save.status < 200 || save.status >= 300) {
+        if (adding) {
+          {
+            RenderLock lock(*this);
+            for (auto& day : calendarDays) {
+              std::erase_if(day.items, [&](const Node& item) { return item.id == localId; });
+            }
+          }
+          removeNode(localId);
+        } else applyTitle(id, initial, originalTodo);
+        return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }
+      if (!adding) return;
+
+      JsonDocument resultBody;
+      const auto invalid = deserializeJson(resultBody, save.response.data(), save.received);
+      const std::string newId = resultBody["item_id"] | "";
+      if (invalid || newId.empty() || newId.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) {
+        removeNode(localId);
+        loadDay();
+        return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+      }
+      {
+        RenderLock lock(*this);
+        for (auto& day : calendarDays) {
+          for (auto& item : day.items) if (item.id == localId) item.id = newId;
+        }
+        const auto replaceId = [&](std::vector<Node>& outline) {
+          for (auto& node : outline) if (node.id == localId) node.id = newId;
+        };
+        replaceId(rows);
+        for (auto& view : viewStack) replaceId(view.rows);
+        layoutDirty = true;
+      }
+      if (relative && capturedDate == date) {
+        const auto anchor = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        const auto added = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == newId; });
+        if (anchor != rows.end() && added != rows.end()) reorder(added - rows.begin(), anchor - rows.begin(), relative > 0);
+      }
+    }, "POST", label, localId)) return;
+    if (!adding) return applyTitle(id, text, makeTodo || originalTodo);
+    {
+      RenderLock lock(*this);
+      Node added{localId, text, 0, 0, makeTodo, false};
+      added.leaf = true;
+      if (scheduled) {
+        for (auto& day : calendarDays) if (day.date == createDate) day.items.push_back(added);
+      }
+      if (!parent.empty() || (createDate == date && zoomId.empty())) appendChild(rows, parent, added);
+      for (auto& view : viewStack) {
+        if (!parent.empty() || (createDate == date && view.zoomId.empty())) appendChild(view.rows, parent, added);
+      }
+      saves.back()->title = text.substr(0, 120);
+      layoutDirty = true;
+    }
+    requestUpdate();
+  });
+}
+
+void WorkflowyDailyActivity::applyTitle(const std::string& id, const std::string& text, bool todo) {
+  {
+    RenderLock lock(*this);
+    const auto apply = [&](std::vector<Node>& outline) {
+      for (auto& item : outline) {
+        if (item.id != id) continue;
+        item.title = text;
+        item.todo = todo;
+      }
+    };
+    apply(rows);
+    for (auto& view : viewStack) apply(view.rows);
+    layoutDirty = true;
+  }
+  requestUpdate();
+}
+
+size_t WorkflowyDailyActivity::cursorAt(std::string_view text, workflowy::TextSpan line, int width) const {
+  line.end = std::min(line.end, text.size());
+  auto caret = std::min(line.begin, line.end);
+  int previousWidth = 0;
+  while (caret < line.end) {
+    const auto next = std::min(line.end, workflowy::nextCharacter(text, caret));
+    const int nextWidth = renderer.getTextWidth(UI_12_FONT_ID,
+                                               std::string(text.substr(line.begin, next - line.begin)).c_str());
+    if (width < (previousWidth + nextWidth) / 2) break;
+    previousWidth = nextWidth;
+    caret = next;
+  }
+  return caret;
+}
+
+bool WorkflowyDailyActivity::selectionEligible(const Node& node) const {
+  return !node.divider && node.depth == (zoomId.empty() ? 0u : 1u) && !itemPending(node.id) && (showDone || !node.done) &&
+         (!replyOnly || workflowy::isReplyTask(node.title));
+}
+
+size_t WorkflowyDailyActivity::selectionCount() const {
+  return std::count_if(rows.begin(), rows.end(), [](const Node& row) { return row.selected; });
+}
+
+void WorkflowyDailyActivity::cancelSelection() {
+  {
+    RenderLock lock(*this);
+    selecting = false;
+    for (auto& row : rows) row.selected = false;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::toggleSelection(size_t row) {
+  if (!selectionEligible(rows[row])) return;
+  {
+    RenderLock lock(*this);
+    rows[row].selected = !rows[row].selected;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::selectAll() {
+  {
+    RenderLock lock(*this);
+    for (auto& row : rows) row.selected = selectionEligible(row);
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::showBulkMenu() {
+  const auto count = selectionCount();
+  if (!count) return;
+  const bool hasTodo = std::any_of(rows.begin(), rows.end(), [](const Node& node) { return node.selected && node.todo; });
+  const bool hasBullet = std::any_of(rows.begin(), rows.end(), [](const Node& node) { return node.selected && !node.todo; });
+  const bool hasCompletable = std::any_of(rows.begin(), rows.end(), [](const Node& node) {
+    return node.selected && (node.todo || node.done);
+  });
+  enum class Command { Edit, Done, Undone, Schedule, Move, Convert, Zoom, Above, Below, Delete };
+  std::vector<std::string> labels;
+  std::vector<Command> commands;
+  labels.reserve(10);
+  commands.reserve(10);
+  const auto add = [&](Command command, StrId label) {
+    commands.push_back(command);
+    labels.emplace_back(I18n::getInstance().get(label));
+  };
+  if (count == 1) add(Command::Edit, StrId::STR_EDIT);
+  if (hasCompletable) {
+    add(Command::Done, StrId::STR_WORKFLOWY_MARK_DONE);
+    add(Command::Undone, StrId::STR_WORKFLOWY_MARK_UNDONE);
+  }
+  add(Command::Schedule, StrId::STR_WORKFLOWY_SCHEDULE_VIEW);
+  add(Command::Move, StrId::STR_WORKFLOWY_MOVE);
+  add(Command::Convert, StrId::STR_WORKFLOWY_TURN_INTO);
+  if (count == 1) add(Command::Zoom, StrId::STR_WORKFLOWY_ZOOM);
+  add(Command::Above, StrId::STR_WORKFLOWY_ADD_ABOVE);
+  add(Command::Below, StrId::STR_WORKFLOWY_ADD_BELOW);
+  add(Command::Delete, StrId::STR_DELETE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyBulk", StrId::STR_WORKFLOWY_BULK_ACTIONS,
+                             std::move(labels), 0, false, true),
+                         [this, commands = std::move(commands), hasTodo, hasBullet](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t index = std::get<OptionSelectionResult>(result.data).index;
+    if (index >= commands.size()) return;
+    const auto command = commands[index];
+    if (command == Command::Done) return startBulk(BulkAction::Done);
+    if (command == Command::Undone) return startBulk(BulkAction::Undone);
+    if (command == Command::Schedule) return scheduleSelection();
+    if (command == Command::Move) return showBulkMoveMenu();
+    if (command == Command::Convert) {
+      std::vector<std::string> types;
+      types.reserve(2);
+      if (hasBullet) types.emplace_back(tr(STR_WORKFLOWY_TODO_TYPE));
+      if (hasTodo) types.emplace_back(tr(STR_WORKFLOWY_BULLET_TYPE));
+      startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                                 renderer, mappedInput, "WorkflowyBulkType", StrId::STR_WORKFLOWY_TURN_INTO,
+                                 std::move(types), 0, false, true),
+                             [this, hasBullet](const ActivityResult& choice) {
+        if (choice.isCancelled) return;
+        startBulk(hasBullet && std::get<OptionSelectionResult>(choice.data).index == 0
+                      ? BulkAction::ToTodo : BulkAction::ToBullet);
+      });
+      return;
+    }
+    if (command == Command::Delete) {
+      char prompt[64];
+      snprintf(prompt, sizeof(prompt), tr(STR_WORKFLOWY_BULK_DELETE), static_cast<unsigned>(selectionCount()));
+      startActivityForResult(std::make_unique<ConfirmationActivity>(renderer, mappedInput, tr(STR_DELETE), prompt),
+                             [this](const ActivityResult& confirmed) {
+        if (!confirmed.isCancelled) startBulk(BulkAction::Delete);
+      });
+      return;
+    }
+    auto node = std::find_if(rows.begin(), rows.end(), [](const Node& node) { return node.selected; });
+    if (command == Command::Below) {
+      const auto last = std::find_if(rows.rbegin(), rows.rend(), [](const Node& node) { return node.selected; });
+      if (last != rows.rend()) node = std::prev(last.base());
+    }
+    if (node == rows.end() || itemPending(node->id)) return;
+    const size_t row = node - rows.begin();
+    cancelSelection();
+    if (command == Command::Edit) return edit(row);
+    if (command == Command::Zoom) return zoom(row);
+    edit(row, command == Command::Above ? -1 : 1);
+  });
+}
+
+void WorkflowyDailyActivity::showBulkMoveMenu() {
+  struct Choice { BulkAction action; std::string target; };
+  std::vector<Choice> choices;
+  std::vector<std::string> labels;
+  choices.reserve(7);
+  labels.reserve(7);
+  const auto add = [&](BulkAction action, StrId label, std::string target = {}) {
+    choices.push_back({action, std::move(target)});
+    labels.emplace_back(I18n::getInstance().get(label));
+  };
+  add(BulkAction::MoveTop, StrId::STR_WORKFLOWY_MOVE_TOP);
+  add(BulkAction::MoveBottom, StrId::STR_WORKFLOWY_MOVE_BOTTOM);
+  const auto first = std::find_if(rows.begin(), rows.end(), [](const Node& node) { return node.selected; });
+  if (first != rows.end() && !parentOf(first->id).empty())
+    add(BulkAction::MoveDate, StrId::STR_WORKFLOWY_MOVE_PARENT, parentDestination(first->id));
+  constexpr StrId days[] = {StrId::STR_WORKFLOWY_MOVE_YESTERDAY, StrId::STR_WORKFLOWY_MOVE_TODAY,
+                             StrId::STR_WORKFLOWY_MOVE_TOMORROW};
+  for (int delta = -1; delta <= 1; ++delta) {
+    auto day = isoDate(delta);
+    if (day.empty() && delta >= 0) day = delta == 0 ? "today" : "tomorrow";
+    if (day.empty() || day == date || (delta == 0 && date == "today") || (delta == 1 && date == "tomorrow")) continue;
+    add(BulkAction::MoveDate, days[delta + 1], std::move(day));
+  }
+  add(BulkAction::None, StrId::STR_WORKFLOWY_MOVE_DATE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyBulkMove", StrId::STR_WORKFLOWY_MOVE,
+                             std::move(labels), 0, false, true),
+                         [this, choices = std::move(choices)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t index = std::get<OptionSelectionResult>(result.data).index;
+    if (index >= choices.size()) return;
+    if (choices[index].action != BulkAction::None) return startBulk(choices[index].action, choices[index].target);
+    const auto today = isoDate(0);
+    startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, StrId::STR_WORKFLOWY_MOVE_DATE,
+                              validDate(date) ? date : today, today), [this](const ActivityResult& picked) {
+      if (!picked.isCancelled) startBulk(BulkAction::MoveDate, std::get<KeyboardResult>(picked.data).text);
+    });
+  });
+}
+
+void WorkflowyDailyActivity::updateType(const std::string& id, bool todo) {
+  RenderLock lock(*this);
+  const auto update = [&](std::vector<Node>& nodes) {
+    for (auto& node : nodes) if (node.id == id) node.todo = todo;
+  };
+  update(rows);
+  for (auto& view : viewStack) update(view.rows);
+  for (auto& day : calendarDays) update(day.items);
+  layoutDirty = true;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::startBulk(BulkAction action, std::string target) {
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const bool completion = action == BulkAction::Done || action == BulkAction::Undone;
+  const bool done = action == BulkAction::Done;
+  const bool conversion = action == BulkAction::ToTodo || action == BulkAction::ToBullet;
+  const bool todo = action == BulkAction::ToTodo;
+  const bool boundary = action == BulkAction::MoveTop || action == BulkAction::MoveBottom;
+  const auto parent = zoomId.empty() ? date : zoomId;
+  const auto label = completion ? (done ? StrId::STR_WORKFLOWY_MARK_DONE : StrId::STR_WORKFLOWY_MARK_UNDONE)
+                   : conversion ? (todo ? StrId::STR_WORKFLOWY_TO_TODO : StrId::STR_WORKFLOWY_TO_BULLET)
+                   : action == BulkAction::MoveTop ? StrId::STR_WORKFLOWY_MOVE_TOP
+                   : action == BulkAction::MoveBottom ? StrId::STR_WORKFLOWY_MOVE_BOTTOM
+                   : action == BulkAction::Delete ? StrId::STR_DELETE : StrId::STR_WORKFLOWY_MOVE;
+  std::vector<std::string> items;
+  items.reserve(selectionCount());
+  for (const auto& node : rows) {
+    if (!node.selected || itemPending(node.id) || node.divider) continue;
+    if (completion && ((!node.todo && !node.done) || node.done == done)) continue;
+    if (conversion && node.todo == todo) continue;
+    items.push_back(node.id);
+  }
+  if (items.size() > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  // Repeated top insertion reverses order, so submit top moves in reverse.
+  if (action == BulkAction::MoveTop) std::reverse(items.begin(), items.end());
+  bool queuedAll = true;
+  for (const auto& id : items) {
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    if (node == rows.end()) continue;
+    const bool oldTodo = node->todo;
+    const auto title = node->title.substr(0, 120);
+    auto path = "/" + id;
+    std::string body;
+    if (completion) path += done ? "/complete" : "/uncomplete";
+    else if (conversion) {
+      JsonDocument update;
+      update["layoutMode"] = todo ? "todo" : "bullets";
+      body = encode(update);
+    } else if (action == BulkAction::MoveDate || boundary) {
+      JsonDocument update;
+      update["parent_id"] = boundary ? parent : target;
+      update["position"] = action == BulkAction::MoveTop ? "top" : "bottom";
+      path += "/move";
+      body = encode(update);
+    }
+    if (!queueSave(std::move(path), std::move(body), false,
+                   [this, id, done, oldTodo, completion, conversion, boundary, parent, action, target](const Save& save) {
+          if (save.status < 200 || save.status >= 300) {
+            if (completion) updateCompletion(id, !done);
+            if (conversion) updateType(id, oldTodo);
+            return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+          }
+          if (boundary) {
+            if ((zoomId.empty() ? date : zoomId) == parent) loadDay();
+          } else if (!completion && !conversion) {
+            const bool sameDay = action == BulkAction::MoveDate && (target == date ||
+                (date == "today" && target == isoDate(0)) || (date == "tomorrow" && target == isoDate(1)));
+            std::optional<Node> moved;
+            const bool cachedParent = action == BulkAction::MoveDate && !sameDay && !validDate(target) &&
+                                      target != "today" && target != "tomorrow";
+            if (cachedParent) {
+              const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+              if (node != rows.end()) moved = *node;
+            }
+            removeNode(id, sameDay);
+            if (moved) {
+              RenderLock lock(*this);
+              appendChild(rows, target, *moved);
+              for (auto& view : viewStack) appendChild(view.rows, target, *moved);
+              layoutDirty = true;
+            }
+            requestUpdate();
+          }
+        }, action == BulkAction::Delete ? "DELETE" : "POST", label, id)) { queuedAll = false; break; }
+    {
+      RenderLock lock(*this);
+      saves.back()->title = title;
+      node->selected = false;
+    }
+    if (completion) updateCompletion(id, done);
+    if (conversion) updateType(id, todo);
+  }
+  if (queuedAll) cancelSelection();
+  else requestUpdate();
+}
+
+void WorkflowyDailyActivity::actions(const size_t row) {
+  if (itemPending(rows[row].id)) return;
+  enum class Action { Edit, Complete, Schedule, Move, TurnInto, Zoom, AddAbove, AddBelow, Select, Delete };
+  std::vector<std::string> options;
+  std::vector<Action> commands;
+  options.reserve(10);
+  commands.reserve(10);
+  const auto add = [&](Action action, StrId label) {
+    commands.push_back(action);
+    options.emplace_back(I18n::getInstance().get(label));
+  };
+  if (!rows[row].divider) {
+  add(Action::Edit, StrId::STR_EDIT);
+  if (rows[row].todo || rows[row].done)
+    add(Action::Complete, rows[row].done ? StrId::STR_WORKFLOWY_MARK_UNDONE : StrId::STR_WORKFLOWY_MARK_DONE);
+  add(Action::Schedule, StrId::STR_WORKFLOWY_SCHEDULE_VIEW);
+  add(Action::Move, StrId::STR_WORKFLOWY_MOVE);
+  add(Action::TurnInto, StrId::STR_WORKFLOWY_TURN_INTO);
+  add(Action::Zoom, StrId::STR_WORKFLOWY_ZOOM);
+  if (zoomId.empty() || row != 0) {
+    add(Action::AddAbove, StrId::STR_WORKFLOWY_ADD_ABOVE);
+    add(Action::AddBelow, StrId::STR_WORKFLOWY_ADD_BELOW);
+  }
+  if (selectionEligible(rows[row])) add(Action::Select, StrId::STR_WORKFLOWY_SELECT_MULTIPLE);
+  }
+  add(Action::Delete, StrId::STR_DELETE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyItem", StrId::STR_WORKFLOWY, std::move(options),
+                             0, false, true),
+                         [this, row, commands = std::move(commands)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t index = std::get<OptionSelectionResult>(result.data).index;
+    if (index >= commands.size() || row >= rows.size()) return;
+    const auto selected = commands[index];
+    const auto id = rows[row].id;
+    if (selected == Action::Select) {
+      {
+        RenderLock lock(*this);
+        selecting = true;
+      }
+      return toggleSelection(row);
+    }
+    if (selected == Action::Schedule) return scheduleItem(row);
+    if (selected == Action::Complete) return toggle(row);
+    if (selected == Action::Edit) return edit(row);
+    if ((zoomId.empty() || row != 0) && (selected == Action::AddAbove || selected == Action::AddBelow))
+      return edit(row, selected == Action::AddAbove ? -1 : 1);
+    if (selected == Action::Zoom) return zoom(row);
+    if (selected == Action::Move) return showMoveMenu(row);
+    if (selected == Action::TurnInto) {
+      const bool todo = !rows[row].todo;
+      const auto label = todo ? StrId::STR_WORKFLOWY_TO_TODO : StrId::STR_WORKFLOWY_TO_BULLET;
+      startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                                 renderer, mappedInput, "WorkflowyTurnInto", StrId::STR_WORKFLOWY_TURN_INTO,
+                                 std::vector<std::string>{todo ? tr(STR_WORKFLOWY_TODO_TYPE) : tr(STR_WORKFLOWY_BULLET_TYPE)},
+                                 0, false, true),
+                             [this, id, todo, label](const ActivityResult& choice) {
+        if (choice.isCancelled || itemPending(id)) return;
+        const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        if (item == rows.end()) return;
+        const auto title = item->title;
+        JsonDocument update;
+        update["layoutMode"] = todo ? "todo" : "bullets";
+        if (queueSave("/" + id, encode(update), false, [this, id, todo, title](const Save& save) {
+              if (save.status >= 200 && save.status < 300) return;
+              applyTitle(id, title, !todo);
+              showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+            }, "POST", label, id)) {
+          applyTitle(id, title, todo);
+        }
+      });
+    } else if (selected == Action::Delete) {
+      startActivityForResult(std::make_unique<ConfirmationActivity>(
+                                 renderer, mappedInput, tr(STR_DELETE), rows[row].title),
+                             [this, id](const ActivityResult& confirmation) {
+        if (confirmation.isCancelled) return;
+        if (!hasActiveStationWifiConnection()) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+        commitDelete();
+        if (!pendingDelete.empty()) return;
+        {
+          RenderLock lock(*this);
+          pendingDelete = id;
+          deleteAt = millis() + DELETE_GRACE;
+          layoutDirty = true;
+        }
+        offerUndo([this] {
+          RenderLock lock(*this);
+          pendingDelete.clear();
+          layoutDirty = true;
+          return true;
+        }, true);
+      });
+    }
+  });
+}
+
+std::string WorkflowyDailyActivity::parentOf(const std::string& id) const {
+  if (id.empty()) return {};
+  const auto findParent = [&](const std::vector<Node>& outline) -> std::string {
+    auto node = std::find_if(outline.begin(), outline.end(), [&](const Node& item) { return item.id == id; });
+    if (node == outline.end() || node->depth == 0) return {};
+    const auto depth = node->depth;
+    while (node != outline.begin()) {
+      if ((--node)->depth < depth) return node->id;
+    }
+    return {};
+  };
+  if (auto parent = findParent(rows); !parent.empty()) return parent;
+  for (auto view = viewStack.rbegin(); view != viewStack.rend(); ++view) {
+    if (auto parent = findParent(view->rows); !parent.empty()) return parent;
+  }
+  return {};
+}
+
+std::string WorkflowyDailyActivity::parentDestination(const std::string& id) const {
+  auto destination = parentOf(parentOf(id));
+  return destination.empty() ? date : destination;
+}
+
+void WorkflowyDailyActivity::showMoveMenu(size_t row) {
+  const auto id = rows[row].id;
+  const bool sibling = zoomId.empty() || row != 0;
+  const auto origin = moveOrigin(row);
+  enum class Move { Top, Bottom, Parent, Date, Day };
+  struct Choice { Move action; std::string target; };
+  std::vector<Choice> choices;
+  std::vector<std::string> labels;
+  const auto add = [&](Move move, StrId label, std::string target = {}) {
+    choices.push_back({move, std::move(target)});
+    labels.emplace_back(I18n::getInstance().get(label));
+  };
+  if (sibling && origin.after) add(Move::Top, StrId::STR_WORKFLOWY_MOVE_TOP);
+  const auto next = std::find_if(rows.begin() + row + 1, rows.end(),
+                                 [&](const Node& node) { return node.depth <= rows[row].depth; });
+  if (sibling && next != rows.end() && next->depth == rows[row].depth) add(Move::Bottom, StrId::STR_WORKFLOWY_MOVE_BOTTOM);
+  if (!parentOf(id).empty()) add(Move::Parent, StrId::STR_WORKFLOWY_MOVE_PARENT, parentDestination(id));
+  constexpr StrId dayLabels[] = {StrId::STR_WORKFLOWY_MOVE_YESTERDAY, StrId::STR_WORKFLOWY_MOVE_TODAY,
+                                  StrId::STR_WORKFLOWY_MOVE_TOMORROW};
+  for (int delta = -1; delta <= 1; ++delta) {
+    auto day = isoDate(delta);
+    if (day.empty() && delta >= 0) day = delta == 0 ? "today" : "tomorrow";
+    const bool current = day == date || (delta == 0 && date == "today") || (delta == 1 && date == "tomorrow");
+    if (!day.empty() && !current) add(Move::Day, dayLabels[delta + 1], std::move(day));
+  }
+  add(Move::Date, StrId::STR_WORKFLOWY_MOVE_DATE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyMove", StrId::STR_WORKFLOWY_MOVE,
+                             std::move(labels), 0, false, true),
+                         [this, id, choices = std::move(choices)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const auto choice = std::get<OptionSelectionResult>(result.data).index;
+    if (choice < 0 || static_cast<size_t>(choice) >= choices.size() || itemPending(id)) return;
+    const auto& move = choices[choice];
+    if (move.action == Move::Date) return chooseDate(id);
+    if (move.action == Move::Day || move.action == Move::Parent) return moveToDate(id, move.target);
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& item) { return item.id == id; });
+    if (node != rows.end()) moveToBoundary(node - rows.begin(), move.action == Move::Bottom);
+  });
+}
+
+void WorkflowyDailyActivity::toggleReplyFilter() {
+  if (selecting) cancelSelection();
+  {
+    RenderLock lock(*this);
+    replyOnly = !replyOnly;
+    layoutDirty = true;
+    wrapAnchor = -1;
+    page = 0;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::sortTimedItems() {
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  if (!saves.empty() || awaitingOutline || !requestedBranch.empty()) return;
+  const auto parent = zoomId.empty() ? date : zoomId;
+  const unsigned depth = zoomId.empty() ? 0 : 1;
+  // At most MAX_ROWS IDs, retained by one queued worker until its moves finish.
+  std::vector<std::pair<int, std::string>> timed;
+  timed.reserve(rows.size());
+  std::string divider;
+  for (const auto& node : rows) {
+    if (node.depth != depth || node.id == zoomId) continue;
+    if (node.scheduledDivider) divider = node.id;
+    if (node.divider || itemPending(node.id)) continue;
+    if (const auto range = workflowy::parseTimeRange(node.title)) timed.emplace_back(range->start, node.id);
+  }
+  if (timed.empty()) return showMessage(tr(STR_WORKFLOWY_EMPTY));
+  std::stable_sort(timed.begin(), timed.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+  if (!queueSave({}, {}, false, [this, parent](const Save& save) {
+        if ((zoomId.empty() ? date : zoomId) == parent) loadDay();
+        if (save.status < 200 || save.status >= 300) showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }, "POST", StrId::STR_SORT, {},
+      [parent, divider = std::move(divider), timed = std::move(timed)](Save& save) mutable {
+        if (divider.empty()) {
+          JsonDocument create;
+          create["parent_id"] = parent;
+          create["name"] = "";
+          create["layoutMode"] = "divider";
+          create["note"] = "crASHink:scheduled-divider";
+          create["position"] = "top";
+          save.status = requestWithKey(save.key, "POST", {}, encode(create), save.response.data(), &save.received,
+                                       save.response.size(), nullptr, nullptr, &save.transport, &save.error);
+          if (save.status < 200 || save.status >= 300) return;
+          JsonDocument response;
+          if (save.received > save.response.size() ||
+              deserializeJson(response, save.response.data(), save.received)) { save.status = -3; return; }
+          divider = response["item_id"] | "";
+          if (divider.empty()) { save.status = -3; return; }
+        }
+        const auto moveTop = [&](const std::string& id) {
+          JsonDocument move;
+          move["parent_id"] = parent;
+          move["position"] = "top";
+          save.status = requestWithKey(save.key, "POST", "/" + id + "/move", encode(move), nullptr, nullptr, 0,
+                                       nullptr, nullptr, &save.transport, &save.error);
+          return save.status >= 200 && save.status < 300;
+        };
+        if (!moveTop(divider)) return;
+        // Top insertion in reverse time order leaves untimed siblings untouched.
+        for (auto item = timed.rbegin(); item != timed.rend(); ++item)
+          if (!moveTop(item->second)) return;
+      })) return;
+  {
+    RenderLock lock(*this);
+    saves.back()->scope = parent;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::moveUnfinishedForward() {
+  const auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  const auto target = workflowy::shiftScheduleDate(source, 1);
+  if (target.empty()) return showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const auto eligible = [&](const Node& node) { return node.todo && !node.done && selectionEligible(node); };
+  const size_t count = std::count_if(rows.begin(), rows.end(), eligible);
+  if (!count) return showMessage(tr(STR_WORKFLOWY_EMPTY));
+  if (count > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  {
+    RenderLock lock(*this);
+    for (auto& node : rows) node.selected = eligible(node);
+    selecting = true;
+  }
+  startBulk(BulkAction::MoveDate, target);
+}
+
+void WorkflowyDailyActivity::shiftDay(int delta) {
+  auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  if (source.empty()) return chooseDate();
+  int year, month, day;
+  if (sscanf(source.c_str(), "%d-%d-%d", &year, &month, &day) != 3) return;
+  day += delta;
+  if (day < 1) {
+    if (--month < 1) { month = 12; --year; }
+    day = monthLength(year, month);
+  } else if (day > monthLength(year, month)) {
+    if (++month > 12) { month = 1; ++year; }
+    day = 1;
+  }
+  char target[16];
+  snprintf(target, sizeof(target), "%04d-%02d-%02d", year, month, day);
+  if (validDate(target)) moveToDate({}, target);
+}
+
+void WorkflowyDailyActivity::moveToDate(const std::string& id, const std::string& target) {
+  if (id.empty()) {
+    if (date == target) return;
+    {
+      RenderLock lock(*this);
+      date = target;
+      replyOnly = false;
+      zoomId.clear();
+      viewStack.clear();
+      selecting = false;
+      page = 0;
+      rows.clear();
+      layoutDirty = true;
+    }
+    if (step != Step::Start) loadDay();
+    return;
+  }
+  const auto old = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+  if (old == rows.end()) return;
+  const auto original = moveOrigin(old - rows.begin());
+  JsonDocument update;
+  update["parent_id"] = target;
+  update["position"] = "bottom";
+  if (itemPending(id) || !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  queueSave("/" + id + "/move", encode(update), false, [this, id, target, original](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    const bool currentDay = target == date || (date == "today" && target == isoDate(0)) ||
+                            (date == "tomorrow" && target == isoDate(1));
+    const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    const bool moveToNode = !currentDay && target != original.parent && !validDate(target) &&
+                            target != "today" && target != "tomorrow";
+    Node moved;
+    const bool locallyVisible = moveToNode && item != rows.end();
+    if (locallyVisible) moved = *item;
+    removeNode(id, currentDay);
+    if (locallyVisible) {
+      RenderLock lock(*this);
+      appendChild(rows, target, moved);
+      for (auto& view : viewStack) appendChild(view.rows, target, moved);
+      layoutDirty = true;
+    }
+    offerUndo([this, id, original] { return restoreMove(id, original); });
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::chooseDate(std::string moveId) {
+  const auto title = moveId.empty() ? StrId::STR_WORKFLOWY_SHOW_DATE : StrId::STR_WORKFLOWY_MOVE_DATE;
+  const auto today = isoDate(0);
+  const auto selected = validDate(date) ? date : date == "tomorrow" ? isoDate(1) : today;
+  startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, title, selected, today),
+                         [this, moveId = std::move(moveId)](const ActivityResult& result) {
+    if (!result.isCancelled) moveToDate(moveId, std::get<KeyboardResult>(result.data).text);
+  });
+}
+
+WorkflowyDailyActivity::Layout WorkflowyDailyActivity::layout() const {
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int rowTop = top + CONTENT_TOP + (!zoomId.empty() && !selecting ? 30 : 0);
+  const int footer = renderer.getScreenHeight() - bottom - 52;
+  const int pageLabel = std::max(32, renderer.getLineHeight(SMALL_FONT_ID) + 3);
+  return {left + 8, top, renderer.getScreenWidth() - right - left - 16, rowTop, footer,
+          footer - pageLabel, std::max(1, renderer.getLineHeight(UI_12_FONT_ID))};
+}
+
+void WorkflowyDailyActivity::layoutRows(const Layout& bounds) {
+  if (!layoutDirty && laidOut == bounds) return;
+  laidOut = bounds;
+  layoutDirty = false;
+  outlineLines.clear();
+  placements.clear();
+  pageStarts.assign(1, 0);
+  const int firstLineHeight = std::max(ROW_HEIGHT, bounds.lineHeight + 12);
+  int y = bounds.rowTop;
+  const unsigned visibleDepth = zoomId.empty() ? 0 : 1;
+  const auto placeRow = [&](size_t i) {
+    const auto& node = rows[i];
+    if (node.depth > visibleDepth) return;
+    if (node.divider && !replyOnly) {
+      if (y + 20 > bounds.rowBottom) { pageStarts.push_back(placements.size()); y = bounds.rowTop; }
+      const auto first = outlineLines.size();
+      outlineLines.push_back({0, 0});
+      placements.push_back({i, first, 1, y, y + 20});
+      y += 20;
+      return;
+    }
+    if (replyOnly && node.id != zoomId && !workflowy::isReplyTask(node.title)) return;
+    if (node.done && !showDone && !itemPending(node.id) && (i != 0 || zoomId.empty())) return;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int width = std::max(1, bounds.width - indent - 25 - ROW_ARROW_TARGET);
+    size_t first = outlineLines.size();
+    if (wrapItems) {
+      const auto measure = [&](std::string_view text) {
+        return renderer.getTextWidth(UI_12_FONT_ID, std::string(text).c_str());
+      };
+      workflowy::wrapOutlineText(node.title, width, measure, outlineLines);
+      const auto capacityAt = [&](int top) {
+        return static_cast<size_t>(std::max(1, 1 + (bounds.rowBottom - top - firstLineHeight) / bounds.lineHeight));
+      };
+      const auto firstCapacity = capacityAt(y + firstLineHeight <= bounds.rowBottom ? y : bounds.rowTop);
+      if (outlineLines.size() - first > firstCapacity) {
+        const auto fullCapacity = capacityAt(bounds.rowTop);
+        const int allowance = renderer.getTextWidth(UI_12_FONT_ID, CONTINUATION) + CONTINUATION_GAP;
+        outlineLines.resize(first);
+        workflowy::wrapOutlineTextByLine(node.title, [&](size_t line) {
+          const bool leading = line >= firstCapacity && (line - firstCapacity) % fullCapacity == 0;
+          const bool trailing = line < firstCapacity ? line + 1 == firstCapacity
+                                                     : (line - firstCapacity + 1) % fullCapacity == 0;
+          return std::max(1, width - (static_cast<int>(leading) + static_cast<int>(trailing)) * allowance);
+        }, measure, outlineLines);
+      }
+    } else {
+      outlineLines.push_back({0, node.title.size()});
+    }
+    while (first < outlineLines.size()) {
+      if (y != bounds.rowTop && y + firstLineHeight > bounds.rowBottom) {
+        pageStarts.push_back(placements.size());
+        y = bounds.rowTop;
+      }
+      const int capacity = std::max(1, 1 + (bounds.rowBottom - y - firstLineHeight) / bounds.lineHeight);
+      const auto count = std::min(static_cast<size_t>(capacity), outlineLines.size() - first);
+      const int height = firstLineHeight + (static_cast<int>(count) - 1) * bounds.lineHeight;
+      placements.push_back({i, first, count, y, y + height});
+      first += count;
+      y += height;
+    }
+  };
+  const size_t firstItem = !zoomId.empty() && !rows.empty() ? 1 : 0;
+  if (firstItem) placeRow(0);
+  const bool scheduledSections = std::any_of(rows.begin(), rows.end(), [&](const Node& node) {
+    return node.depth == visibleDepth && node.scheduledDivider;
+  });
+  for (size_t i = firstItem; i < rows.size(); ++i) {
+    if (scheduledSections || !rows[i].done) placeRow(i);
+  }
+  if (showDone && !scheduledSections) {
+    for (size_t i = firstItem; i < rows.size(); ++i) {
+      if (rows[i].done) placeRow(i);
+    }
+  }
+  if (wrapAnchor >= 0) {
+    const auto match = std::find_if(placements.begin(), placements.end(), [&](const Placement& placement) {
+      return placement.row == static_cast<size_t>(wrapAnchor);
+    });
+    if (match != placements.end()) {
+      const auto index = static_cast<size_t>(match - placements.begin());
+      page = std::upper_bound(pageStarts.begin(), pageStarts.end(), index) - pageStarts.begin() - 1;
+    }
+    wrapAnchor = -1;
+  }
+  page = std::min(page, pageStarts.size() - 1);
+
+}
+
+int WorkflowyDailyActivity::rowAt(const int x, int y, const bool dropping) const {
+  RenderLock lock;
+  if (layoutDirty || paintedPage != page || page >= pageStarts.size()) return -1;
+  if (!dropping && (x < laidOut.x || x >= laidOut.x + laidOut.width)) return -1;
+  const auto first = pageStarts[page];
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  if (first == end) return -1;
+  if (dropping) {
+    if (y < laidOut.rowTop - 4 || y >= laidOut.rowBottom) return -1;
+    // Treat the outline gutter and the unused space below the final row as
+    // part of the drop area. The header and toolbar still cancel the drop.
+    y = std::clamp(y, placements[first].top, placements[end - 1].bottom - 1);
+  }
+  for (auto i = first; i < end; ++i) {
+    const auto& hit = placements[i];
+    if (y >= hit.top && y < hit.bottom) return static_cast<int>(hit.row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::nextPage(const int delta, const bool edge) {
+  {
+    RenderLock lock(*this);
+    const int last = pageStarts.empty() ? 0 : static_cast<int>(pageStarts.size() - 1);
+    const auto next = static_cast<size_t>(edge ? (delta < 0 ? 0 : last)
+                                               : std::clamp(static_cast<int>(page) + delta, 0, last));
+    if (next == page) return;
+    page = next;
+  }
+  requestUpdate();
+}
+
+int WorkflowyDailyActivity::parentRow(size_t row) const {
+  const auto depth = rows[row].depth;
+  while (row > 0) {
+    --row;
+    if (rows[row].depth < depth) return static_cast<int>(row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::zoom(size_t row) {
+  if (rows[row].id == zoomId) return;
+  Node root = rows[row];
+  std::vector<Node> focused;
+  const bool cached = row + 1 < rows.size() && rows[row + 1].depth > root.depth;
+  if (!cached && !root.leaf) {
+    if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    {
+      RenderLock lock(*this);
+      requestedBranch = root.id;
+      message = nullptr;
+      if (prefetch && prefetch->parent != root.id) prefetch->cancel.store(true, std::memory_order_relaxed);
+    }
+    requestUpdate();
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    if (cached) {
+      const auto first = rows.begin() + row + 1;
+      auto end = first;
+      while (end != rows.end() && end->depth > root.depth) ++end;
+      focused.reserve(end - first + 1);
+      focused.insert(focused.end(), std::make_move_iterator(first), std::make_move_iterator(end));
+      rows.erase(first, end);
+      for (auto& node : focused) node.depth -= root.depth;
+    }
+    root.depth = 0;
+    root.leaf = focused.empty();
+    root.childrenConfirmed = !root.leaf;
+    focused.insert(focused.begin(), std::move(root));
+    ++generation;
+    requestedBranch.clear();
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    viewStack.push_back({std::move(rows), std::move(zoomId), page});
+    zoomId = focused.front().id;
+    rows = std::move(focused);
+    page = 0;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::back() {
+  if (viewStack.empty()) {
+    commitDelete();
+    if (!saves.empty()) {
+      leaveAfterSave = true;
+      return;
+    }
+    return finish();
+  }
+  returnToDepth(viewStack.size() - 1);
+}
+
+void WorkflowyDailyActivity::returnToDepth(size_t depth) {
+  if (depth >= viewStack.size()) return;
+  {
+    RenderLock lock(*this);
+    ++generation;
+    if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+    requestedBranch.clear();
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    while (viewStack.size() > depth) {
+      auto previous = std::move(viewStack.back());
+      viewStack.pop_back();
+      const auto owner = std::find_if(previous.rows.begin(), previous.rows.end(),
+                                      [&](const Node& node) { return node.id == zoomId; });
+      if (!rows.empty() && rows.front().id == zoomId && owner != previous.rows.end()) {
+        const auto depth = owner->depth;
+        auto end = owner + 1;
+        while (end != previous.rows.end() && end->depth > depth) ++end;
+        *owner = std::move(rows.front());
+        owner->depth = depth;
+        const bool fits = previous.rows.size() - static_cast<size_t>(end - (owner + 1)) +
+                          rows.size() - 1 <= MAX_CACHED_BRANCH_ROWS;
+        const auto where = previous.rows.erase(owner + 1, end);
+        if (fits) {
+          for (auto i = rows.begin() + 1; i != rows.end(); ++i) i->depth += depth;
+          previous.rows.insert(where, std::make_move_iterator(rows.begin() + 1), std::make_move_iterator(rows.end()));
+        }
+      }
+      rows = std::move(previous.rows);
+      zoomId = std::move(previous.zoomId);
+      page = previous.page;
+    }
+    wrapAnchor = -1;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::showBreadcrumbMenu() {
+  if (viewStack.size() < 3) return;
+  std::vector<std::string> ancestors;
+  ancestors.reserve(viewStack.size() - 2);
+  const int width = std::max(1, layout().width - 56);
+  for (size_t depth = 1; depth + 1 < viewStack.size(); ++depth) {
+    const auto& view = viewStack[depth];
+    const char* label = view.rows.empty() ? tr(STR_WORKFLOWY) : view.rows.front().title.c_str();
+    ancestors.push_back(renderer.truncatedText(UI_12_FONT_ID, label, width));
+  }
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                            renderer, mappedInput, "WorkflowyAncestors", StrId::STR_WORKFLOWY,
+                            std::move(ancestors), 0, false, true),
+                         [this](const ActivityResult& result) {
+    if (!result.isCancelled) {
+      const int index = std::get<OptionSelectionResult>(result.data).index;
+      if (index >= 0) returnToDepth(static_cast<size_t>(index) + 1);
+    }
+  });
+}
+
+void WorkflowyDailyActivity::drawBreadcrumbs(const Layout& bounds, int right) {
+  const auto depth = viewStack.size();
+  if (depth == 0) return;
+  const int total = std::max(0, right - bounds.x);
+  const char* day = date.empty() || date == "today" || date == isoDate(0) ? tr(STR_WORKFLOWY_TODAY) : date.c_str();
+  const int dayWidth = std::min(renderer.getTextWidth(SMALL_FONT_ID, day) + 19, total / 3);
+  const int moreWidth = depth > 2 ? std::min(38, total / 6) : 0;
+  const char* parentTitle = depth > 1 && !viewStack.back().rows.empty()
+                                ? viewStack.back().rows.front().title.c_str() : tr(STR_WORKFLOWY);
+  const int parentWidth = depth > 1 ? std::min(renderer.getTextWidth(SMALL_FONT_ID, parentTitle) + 19,
+                                             (total - dayWidth - moreWidth) / 2) : 0;
+  breadcrumbHits = {depth, bounds.x + dayWidth, bounds.x + dayWidth + moreWidth,
+                     bounds.x + dayWidth + moreWidth + parentWidth};
+  const int y = bounds.top + CONTENT_TOP + 5;
+  const auto draw = [&](int left, int end, const char* label, bool ancestor) {
+    const int labelWidth = end - left - (ancestor ? 15 : 0);
+    if (labelWidth <= 0) return;
+    const auto fitted = renderer.truncatedText(SMALL_FONT_ID, label, labelWidth);
+    renderer.drawText(SMALL_FONT_ID, left, y, fitted.c_str());
+    if (ancestor) renderer.drawText(SMALL_FONT_ID, end - 12, y, "›");
+  };
+  draw(bounds.x, breadcrumbHits.dayEnd, day, true);
+  if (moreWidth) draw(breadcrumbHits.dayEnd, breadcrumbHits.moreEnd, "...", true);
+  if (parentWidth) {
+    const auto& parent = viewStack.back();
+    draw(breadcrumbHits.moreEnd, breadcrumbHits.parentEnd,
+         parent.rows.empty() ? tr(STR_WORKFLOWY) : parent.rows.front().title.c_str(), true);
+  }
+  draw(breadcrumbHits.parentEnd, right, rows.empty() ? tr(STR_WORKFLOWY) : rows.front().title.c_str(), false);
+}
+
+bool WorkflowyDailyActivity::tapBreadcrumb(int x, int y) {
+  if (selecting || viewStack.empty()) return false;
+  const auto bounds = layout();
+  if (y < bounds.top + CONTENT_TOP || y >= bounds.rowTop || x < bounds.x) return false;
+  BreadcrumbHits hit;
+  {
+    RenderLock lock(*this);
+    hit = breadcrumbHits;
+  }
+  if (hit.depth == 0 || viewStack.size() != hit.depth || x >= hit.parentEnd) return false;
+  if (x < hit.dayEnd) returnToDepth(0);
+  else if (x < hit.moreEnd) showBreadcrumbMenu();
+  else returnToDepth(hit.depth - 1);
+  return true;
+}
+
+bool WorkflowyDailyActivity::reorder(size_t source, size_t target, bool after, bool recordUndo) {
+  if (itemPending(rows[source].id) || itemPending(rows[target].id)) return false;
+  const int parent = parentRow(source);
+  if (source == target || parent != parentRow(target)) return false;
+  const auto parentNode = parent < 0 ? "" : rows[parent].id;
+  return reorderSiblings(parent < 0 ? date : parentNode, parentNode, rows[source].depth,
+                         rows[source].id, rows[target].id, after, recordUndo);
+}
+
+bool WorkflowyDailyActivity::reorderSiblings(const std::string& parentId, const std::string& parentNode, unsigned depth,
+                                             std::string sourceId, std::string targetId,
+                                             bool after, bool recordUndo) {
+  struct OrderResult {
+    std::vector<Node> siblings;
+    std::string neighbour;
+    bool wasFirst = false;
+    bool loaded = false;
+  };
+  auto orderResult = std::make_shared<OrderResult>();
+  const auto source = std::find_if(rows.begin(), rows.end(), [&](const Node& row) { return row.id == sourceId; });
+  const auto localOrigin = source == rows.end() ? MoveOrigin{} : moveOrigin(source - rows.begin());
+  const bool queued = queueSave({}, {}, false,
+                   [this, parentId, parentNode, depth, sourceId, orderResult, recordUndo, localOrigin](const Save& save) {
+    if (orderResult->loaded) {
+      RenderLock lock(*this);
+      if (!parentNode.empty() || (zoomId.empty() && parentId == date)) replaceSiblings(rows, parentNode, orderResult->siblings);
+      for (auto& view : viewStack) {
+        if (!parentNode.empty() || (view.zoomId.empty() && parentId == date))
+          replaceSiblings(view.rows, parentNode, orderResult->siblings);
+      }
+      layoutDirty = true;
+    }
+    if (save.status != 200) {
+      if (!orderResult->loaded && !localOrigin.neighbour.empty()) moveVisibleBoundary(sourceId, localOrigin, false, true);
+      return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    }
+    if (recordUndo) {
+      offerUndo([this, sourceId, parentId, parentNode, depth, neighbour = orderResult->neighbour,
+                 wasFirst = orderResult->wasFirst] {
+        return reorderSiblings(parentId, parentNode, depth, sourceId, neighbour, !wasFirst, false);
+      });
+    }
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, sourceId,
+     [parentId, depth, sourceId, targetId, after, orderResult](Save& save) {
+    std::vector<Node> siblings;
+    save.status = fetchChildren(save.key, parentId, depth, siblings, nullptr, &save.transport);
+    if (save.status != 200) return;
+    std::vector<size_t> order;
+    size_t source = siblings.size(), target = siblings.size();
+    for (size_t i = 0; i < siblings.size(); ++i) {
+      if (siblings[i].id == sourceId) source = i;
+      else order.push_back(i);
+      if (siblings[i].id == targetId) target = i;
+    }
+    const auto position = std::find(order.begin(), order.end(), target);
+    if (source == siblings.size() || position == order.end() || siblings.size() < 2) {
+      save.status = -3;
+      return;
+    }
+    orderResult->wasFirst = source == 0;
+    orderResult->neighbour = siblings[source == 0 ? 1 : source - 1].id;
+    order.insert(position + (after ? 1 : 0), source);
+    const auto stationary = workflowy::stationaryRange(order);
+    const auto move = [&](size_t i, const char* placement) {
+      JsonDocument update;
+      update["parent_id"] = parentId;
+      update["position"] = placement;
+      save.status = requestWithKey(save.key, "POST", "/" + siblings[order[i]].id + "/move", encode(update),
+                                   nullptr, nullptr, 0, nullptr, nullptr, &save.transport, &save.error);
+      return save.status == 200;
+    };
+    bool ok = true;
+    for (size_t i = stationary.begin; i > 0 && ok; --i) ok = move(i - 1, "top");
+    for (size_t i = stationary.end; i < order.size() && ok; ++i) ok = move(i, "bottom");
+    if (ok) {
+      for (const auto i : order) orderResult->siblings.push_back(std::move(siblings[i]));
+      orderResult->loaded = true;
+    } else {
+      orderResult->loaded = fetchChildren(save.key, parentId, depth, orderResult->siblings) == 200;
+    }
+  });
+  if (queued && !localOrigin.parent.empty()) {
+    moveVisibleBoundary(sourceId, MoveOrigin{parentId, parentNode, targetId, depth, after}, false, true);
+  }
+  return queued;
+}
+
+void WorkflowyDailyActivity::offerUndo(std::function<bool()> action, bool forDelete) {
+  undoIsDelete = forDelete;
+  undoAction = std::move(action);
+  {
+    RenderLock lock(*this);
+    undoReady = true;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::undo() {
+  if (!undoAction) return;
+  if (!undoIsDelete && !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  if (!undoAction()) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  undoAction = {};
+  {
+    RenderLock lock(*this);
+    undoReady = false;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::commitDelete() {
+  if (pendingDelete.empty() || !hasActiveStationWifiConnection()) return;
+  const auto id = pendingDelete;
+  if (!queueSave("/" + id, {}, false, [this, id](const Save& save) {
+        if (save.status >= 200 && save.status < 300) removeNode(id);
+        else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }, "DELETE", StrId::STR_DELETE, id)) return;
+  {
+    RenderLock lock(*this);
+    pendingDelete.clear();
+    if (undoIsDelete) undoReady = false;
+    layoutDirty = true;
+  }
+  if (undoIsDelete) undoAction = {};
+}
+
+bool WorkflowyDailyActivity::queueCapture(const std::string& body) {
+  JsonDocument queue, item;
+  if ((!outbox.empty() && deserializeJson(queue, outbox)) || deserializeJson(item, body)) return false;
+  const auto account = std::to_string(std::hash<std::string>{}(credential));
+  if (queue["items"].isNull()) queue["items"].to<JsonArray>();
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() && queue["account"].as<std::string>() != account) return false;
+  queue["account"] = account;
+  if (items.size() >= OUTBOX_ITEMS || !items.add(item.as<JsonVariantConst>())) return false;
+  auto saved = encode(queue);
+  if (saved.size() > OUTBOX_LIMIT || !workflowy::writeSetting(OUTBOX, saved)) return false;
+  outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    pendingCount = items.size();
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::flushCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential))) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  }
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() == 0) return;
+  std::string body;
+  serializeJson(items[0], body);
+  queue["sending"] = true;
+  auto marked = encode(queue);
+  if (!workflowy::writeSetting(OUTBOX, marked)) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+  }
+  outbox = std::move(marked);
+  if (!queueSave("", std::move(body), false, [this](const Save& save) { finishCapture(save.status); },
+                 "POST", StrId::STR_WORKFLOWY_ADD)) {
+    finishCapture(-5);
+    return;
+  }
+  RenderLock lock(*this);
+  saves.back()->fromOutbox = true;
+}
+
+void WorkflowyDailyActivity::finishCapture(int status) {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  auto items = queue["items"].as<JsonArray>();
+  if (status >= 200 && status < 300) items.remove(0);
+  // An interrupted request may have created the item. Leave it queued for explicit review.
+  const bool uncertain = status == 0 || status >= 500;
+  queue["sending"] = uncertain;
+  auto saved = encode(queue);
+  const bool persisted = workflowy::writeSetting(OUTBOX, saved);
+  if (persisted) outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    outboxUncertain = uncertain || !persisted;
+    if (persisted) pendingCount = items.size();
+  }
+  if (queueVisible) refreshOfflineQueuePreview();
+  retryOutboxAt = millis() + (status >= 200 && status < 300 ? 350 : 30000);
+  if (status >= 200 && status < 300) {
+    rootCheckedAt = millis() - SYNC_INTERVAL;
+    nextPrefetchAt = millis();
+    requestUpdate();
+  } else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+}
+
+void WorkflowyDailyActivity::reviewCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential)))
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  const auto name = plainTitle(queue["items"][0]["name"] | "");
+  std::vector<std::string> options{tr(STR_WORKFLOWY_OUTBOX_SENT), tr(STR_WORKFLOWY_OUTBOX_RETRY)};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyOutbox", StrId::STR_WORKFLOWY_SYNC_CHECK,
+                             std::move(options), 0, false, true),
+                         [this, name](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const bool sent = std::get<OptionSelectionResult>(result.data).index == 0;
+    startActivityForResult(std::make_unique<ConfirmationActivity>(
+                               renderer, mappedInput, (sent ? tr(STR_WORKFLOWY_OUTBOX_SENT) : tr(STR_WORKFLOWY_OUTBOX_RETRY)),
+                               name),
+                           [this, sent](const ActivityResult& confirmation) {
+      if (confirmation.isCancelled) return;
+      JsonDocument queue;
+      if (deserializeJson(queue, outbox)) return;
+      auto items = queue["items"].as<JsonArray>();
+      if (sent) items.remove(0);
+      queue["sending"] = false;
+      auto saved = encode(queue);
+      if (!workflowy::writeSetting(OUTBOX, saved)) return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      outbox = std::move(saved);
+      {
+        RenderLock lock(*this);
+        outboxUncertain = false;
+        pendingCount = items.size();
+      }
+      retryOutboxAt = millis();
+      if (queueVisible) refreshOfflineQueuePreview();
+      requestUpdate();
+    });
+  });
+}
+
+WorkflowyDailyActivity::MoveOrigin WorkflowyDailyActivity::moveOrigin(size_t source) const {
+  const int parent = parentRow(source);
+  const std::string parentNode = parent < 0 ? "" : rows[parent].id;
+  const unsigned depth = rows[source].depth;
+  MoveOrigin origin{parent < 0 ? date : parentNode, parentNode, {}, depth, false};
+  for (size_t i = parent < 0 ? 0 : parent + 1; i < rows.size() && rows[i].depth >= depth; ++i) {
+    if (i == source || rows[i].depth != depth) continue;
+    if (i > source && !origin.neighbour.empty()) break;
+    origin.neighbour = rows[i].id;
+    origin.after = i < source;
+    if (i > source) break;
+  }
+  return origin;
+}
+
+void WorkflowyDailyActivity::moveToBoundary(size_t row, bool bottom) {
+  if (itemPending(rows[row].id) || rows[row].id == zoomId) return;
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const auto id = rows[row].id;
+  const auto origin = moveOrigin(row);
+  JsonDocument update;
+  update["parent_id"] = origin.parent;
+  update["position"] = bottom ? "bottom" : "top";
+  if (queueSave("/" + id + "/move", encode(update), false, [this, id, origin, bottom](const Save& save) {
+        if (save.status < 200 || save.status >= 300) {
+          moveVisibleBoundary(id, origin, bottom, true);
+          return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+        }
+        offerUndo([this, id, origin] { return restoreMove(id, origin); });
+      }, "POST", bottom ? StrId::STR_WORKFLOWY_MOVE_BOTTOM : StrId::STR_WORKFLOWY_MOVE_TOP, id)) {
+    moveVisibleBoundary(id, origin, bottom, false);
+  }
+}
+
+void WorkflowyDailyActivity::moveVisibleBoundary(const std::string& id, const MoveOrigin& origin, bool bottom, bool restore) {
+  {
+    RenderLock lock(*this);
+    const auto rotateBranch = [&](std::vector<Node>& outline) {
+      const auto item = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (item == outline.end()) return;
+      const auto depth = item->depth;
+      if (depth == 0 && !outline.empty() && outline.front().id == id && id == zoomId) return;
+      auto end = item + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      auto destination = item;
+      if (restore) {
+        destination = std::find_if(outline.begin(), outline.end(), [&](const Node& node) {
+          return node.id == origin.neighbour && node.depth == depth;
+        });
+        if (destination == outline.end()) return;
+        if (origin.after) {
+          ++destination;
+          while (destination != outline.end() && destination->depth > depth) ++destination;
+        }
+      } else if (bottom) {
+        destination = end;
+        while (destination != outline.end() && destination->depth >= depth) ++destination;
+      } else {
+        while (destination != outline.begin() && std::prev(destination)->depth >= depth) --destination;
+      }
+      if (destination < item) std::rotate(destination, item, end);
+      if (destination > end) std::rotate(item, end, destination);
+    };
+    if (id != zoomId) rotateBranch(rows);
+    for (auto& view : viewStack) if (id != view.zoomId) rotateBranch(view.rows);
+    layoutDirty = true;
+  }
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::restoreMove(const std::string& id, const MoveOrigin& origin) {
+  if (itemPending(id)) return false;
+  JsonDocument update;
+  update["parent_id"] = origin.parent;
+  update["position"] = "bottom";
+  return queueSave("/" + id + "/move", encode(update), false, [this, id, origin](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    if (!origin.neighbour.empty() &&
+        reorderSiblings(origin.parent, origin.parentNode, origin.depth, id, origin.neighbour, origin.after, false)) return;
+    loadDay();
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::indent(size_t source, size_t target) {
+  if (itemPending(rows[source].id) || itemPending(rows[target].id)) return;
+  const auto id = rows[source].id;
+  const auto destination = rows[target].id;
+  const auto original = moveOrigin(source);
+  JsonDocument update;
+  update["parent_id"] = destination;
+  update["position"] = "top";
+  queueSave("/" + id + "/move", encode(update), false, [this, id, destination, original](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    removeNode(id);
+    {
+      RenderLock lock(*this);
+      for (auto& node : rows) {
+        if (node.id != destination) continue;
+        node.leaf = false;
+        node.childrenConfirmed = true;
+      }
+    }
+    offerUndo([this, id, original] { return restoreMove(id, original); });
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::prefetchTask(void* argument) {
+  {
+    std::unique_ptr<std::shared_ptr<Prefetch>> holder(static_cast<std::shared_ptr<Prefetch>*>(argument));
+    auto& job = **holder;
+    job.status = fetchChildren(job.key, job.target, job.depth, job.children, &job.cancel, &job.transport);
+    job.ready.store(true, std::memory_order_release);
+  }
+  vTaskDelete(nullptr);
+}
+
+void WorkflowyDailyActivity::pollPrefetch() {
+  if (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire)) return;
+  if (calendarFetch) {
+    calendarFetch->cancel.store(true, std::memory_order_relaxed);
+    if (!calendarFetch->ready.load(std::memory_order_acquire)) return;
+    calendarFetch.reset();
+  }
+  const auto now = millis();
+  if (prefetch) {
+    if (!prefetch->ready.load(std::memory_order_acquire)) return;
+    auto job = std::move(prefetch);
+    if (job->generation != generation || job->cancel.load(std::memory_order_relaxed)) return;
+    bool changed = false;
+    int zoomRow = -1;
+    {
+      RenderLock lock(*this);
+      if (job->root) {
+        rootCheckedAt = now;
+        if (awaitingOutline) {
+          awaitingOutline = false;
+          lastStatus = job->status;
+          lastTransport = job->transport;
+          lastServerError.clear();
+          changed = true;
+          message = job->status == 200 ? nullptr
+                    : job->status == -2 ? tr(STR_WORKFLOWY_CLOCK_FAILED)
+                    : job->status == -3 ? tr(STR_WORKFLOWY_DAILY_READ_FAILED)
+                    : job->status == 401 || job->status == 403 ? tr(STR_WORKFLOWY_AUTH_FAILED)
+                                                               : tr(STR_WORKFLOWY_NETWORK_FAILED);
+        }
+      }
+      if (!requestedBranch.empty() && requestedBranch == job->parent) {
+        const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == job->parent; });
+        requestedBranch.clear();
+        lastStatus = job->status;
+        lastTransport = job->transport;
+        lastServerError.clear();
+        changed = true;
+        if (job->status != 200) {
+          message = tr(STR_WORKFLOWY_DAILY_READ_FAILED);
+        } else if (owner != rows.end()) {
+          const auto index = static_cast<size_t>(owner - rows.begin());
+          auto end = owner + 1;
+          while (end != rows.end() && end->depth > owner->depth) ++end;
+          if (rows.size() - static_cast<size_t>(end - (owner + 1)) + job->children.size() > MAX_ROWS) {
+            message = tr(STR_WORKFLOWY_DAILY_READ_FAILED);
+          } else {
+            replaceSiblings(rows, job->parent, job->children);
+            zoomRow = static_cast<int>(index);
+            message = nullptr;
+            layoutDirty = true;
+          }
+        }
+      } else if (job->status == 200) {
+        changed |= replaceSiblings(rows, job->parent, job->children);
+        layoutDirty |= changed;
+      }
+    }
+    if (!calendarFocus.empty() && job->root && job->status == 200) {
+      const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == calendarFocus; });
+      calendarFocus.clear();
+      if (item != rows.end()) {
+        if (calendarFocusZoom) zoomRow = item - rows.begin();
+        else { wrapAnchor = item - rows.begin(); layoutDirty = true; changed = true; }
+      }
+      calendarFocusZoom = true;
+    }
+    if (zoomRow >= 0) return zoom(zoomRow);
+    if (changed) requestUpdate();
+    return;
+  }
+  const bool interactive = !requestedBranch.empty();
+  if (interactive && !online) {
+    {
+      RenderLock lock(*this);
+      requestedBranch.clear();
+    }
+    return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  }
+  if ((!interactive && static_cast<long>(now - nextPrefetchAt) < 0) || credential.empty() || date.empty() || !online)
+    return;
+  std::string parent;
+  unsigned depth = 0;
+  const bool root = !interactive && now - rootCheckedAt >= SYNC_INTERVAL;
+  {
+    RenderLock lock(*this);
+    if (interactive) {
+      const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == requestedBranch; });
+      if (owner == rows.end()) {
+        requestedBranch.clear();
+        return;
+      }
+      parent = owner->id;
+      depth = owner->depth + 1;
+    } else if (root) {
+      parent = zoomId;
+      depth = zoomId.empty() ? 0 : 1;
+    } else {
+      return;
+    }
+  }
+  auto job = makeUniqueNoThrow<Prefetch>();
+  nextPrefetchAt = now + 5000;
+  const auto failStart = [&] {
+    if (!interactive) return;
+    {
+      RenderLock lock(*this);
+      requestedBranch.clear();
+      lastStatus = 0;
+      lastTransport = ESP_ERR_NO_MEM;
+      lastServerError.clear();
+    }
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  };
+  if (!job) return failStart();
+  job->key = credential;
+  job->target = parent.empty() ? date : parent;
+  job->parent = std::move(parent);
+  job->generation = generation;
+  job->depth = depth;
+  job->root = root;
+  prefetch = std::move(job);
+  auto holder = makeUniqueNoThrow<std::shared_ptr<Prefetch>>(prefetch);
+  if (!holder) {
+    prefetch.reset();
+    return failStart();
+  }
+  // The task owns the argument and touches no activity or renderer state.
+  auto* argument = holder.release();
+  if (xTaskCreate(prefetchTask, "wf-prefetch", 8192, argument, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete argument;
+    prefetch.reset();
+    return failStart();
+  }
+  nextPrefetchAt = now + 250;
+}
+
+void WorkflowyDailyActivity::loop() {
+  using Button = MappedInputManager::Button;
+  using Swipe = MappedInputManager::SwipeDir;
+  if (mappedInput.wasReleased(Button::Back)) {
+    if (queueVisible) return showPendingOperations();
+    if (calendarVisible) {
+      {
+        RenderLock lock(*this);
+        calendarVisible = false;
+        calendarDrag = {};
+      }
+      if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+      return requestUpdate();
+    }
+    if (selecting) return cancelSelection();
+    return back();
+  }
+  int tapX = 0, tapY = 0;
+  const bool sdkTap = mappedInput.wasScreenTapped(tapX, tapY);
+  const auto now = millis();
+  if (queueVisible) {
+    const auto bounds = layout();
+    const int uncertainY = bounds.rowTop + (!requestedBranch.empty() ? ROW_HEIGHT : 0);
+    if (sdkTap && outboxUncertain && queuePage == 0 && tapY >= uncertainY && tapY < uncertainY + ROW_HEIGHT &&
+        saves.empty()) {
+      return reviewCapture();
+    }
+    if (sdkTap && (tapY < bounds.rowTop || tapY >= bounds.footer)) return showPendingOperations();
+    const auto swipe = mappedInput.wasSwipe();
+    if (swipe == Swipe::Up || swipe == Swipe::Down) {
+      RenderLock lock(*this);
+      const size_t visible = std::max(1, (bounds.rowBottom - bounds.rowTop) / ROW_HEIGHT);
+      if (swipe == Swipe::Down && queuePage) --queuePage;
+      else if (swipe == Swipe::Up && (queuePage + 1) * visible < pendingOperationsCount()) ++queuePage;
+    }
+    if (step == Step::Ready) pollWifiConnection();
+    if (step == Step::Load) loadDay();
+    if (!pollSave() && swipe != Swipe::None) requestUpdate();
+    if (calendarVisible) pollCalendar();
+    else if (saves.empty() && (!requestedBranch.empty() || awaitingOutline)) pollPrefetch();
+    else if (saves.empty() && pendingCount && !outboxUncertain && hasActiveStationWifiConnection() &&
+             static_cast<long>(now - retryOutboxAt) >= 0) flushCapture();
+    return;
+  }
+  if (calendarVisible) {
+    if (step == Step::Start) connect();
+    else if (step == Step::Ready) pollWifiConnection();
+    if (step == Step::Load) {
+      step = Step::Ready;
+      awaitingOutline = false;
+      reloadCalendar();
+    }
+    calendarLoop(sdkTap, tapX, tapY);
+    return;
+  }
+  const bool tapped = sdkTap && (tracking || gestureEndedAt == 0 || now - gestureEndedAt >= 120);
+  // The calendar is local. Open it before processing Wi-Fi or outline work.
+  if (tapped && !selecting && step != Step::Waiting && !dragging && !(tracking && moved)) {
+    const auto bounds = layout();
+    const int right = bounds.x + bounds.width;
+    if (tapY >= bounds.top + 28 && tapY < bounds.top + 63 && tapX >= bounds.x && tapX < right) {
+      const int dayRight = right - COUNT_TARGET;
+      if (tapX < dayRight) {
+        tracking = false;
+        if (tapX < bounds.x + DAY_TARGET) return shiftDay(-1);
+        if (tapX >= dayRight - DAY_TARGET) return shiftDay(1);
+        return chooseDate();
+      }
+    }
+  }
+  if (step == Step::Start) return connect();
+  if (step == Step::Load) return loadDay();
+  if (step != Step::Ready) return;
+  pollWifiConnection();
+  if (step != Step::Ready) return;
+  int touchDownX, touchDownY;
+  const bool stillTouching = sdkTap || tracking || mappedInput.wasScreenTouchReleased() ||
+                             mappedInput.wasScreenTouchDown(touchDownX, touchDownY);
+  if (!stillTouching && pollSave()) return;
+  if (static_cast<long>(now - nextLinkCheck) >= 0) {
+    nextLinkCheck = now + 500;
+    const bool connected = hasActiveStationWifiConnection();
+    if (connected != online) {
+      {
+        RenderLock lock(*this);
+        online = connected;
+      }
+      if (connected && !awaitingOutline) loadDay();
+      else requestUpdate();
+    }
+  }
+  if (isErrorNotice(message) && mappedInput.wasReleased(Button::Confirm)) return showErrorDetails();
+  if (mappedInput.wasReleased(Button::Up)) return nextPage(-1);
+  if (mappedInput.wasReleased(Button::Down)) return nextPage(1);
+  int x = 0, y = 0;
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    tracking = true;
+    dragRow = -1;
+    moved = false;
+    peakY = 0;
+    touchX = lastX = x;
+    touchY = lastY = y;
+    touchAt = millis();
+  }
+  if (tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    lastX = x;
+    lastY = y;
+    const int dx = std::abs(x - touchX), dy = std::abs(y - touchY);
+    if (dy > std::abs(peakY)) peakY = y - touchY;
+    if (!selecting && !moved && dragRow < 0 && millis() - touchAt >= 550) {
+      const int row = rowAt(touchX, touchY);
+      if (row >= 0 && !itemPending(rows[row].id)) dragRow = row;
+    }
+    moved |= std::max(dx, dy) > 26;
+    if (online && dragRow >= 0 && (dragging || dy > 26)) {
+      dragging = true;
+      const int over = rowAt(x, y, true);
+      const int nextDrop = over >= 0 && over != dragRow && !itemPending(rows[over].id) &&
+                           parentRow(over) == parentRow(dragRow) ? over : -1;
+      const bool inside = nextDrop >= 0 && x - touchX >= 32 && rows[nextDrop].depth < 8;
+      bool changed;
+      {
+        RenderLock lock(*this);
+        changed = dropRow != nextDrop || dropInside != inside;
+        dropInside = inside;
+        dropRow = nextDrop;
+        dropAfter = nextDrop > dragRow;
+      }
+      if (changed) requestUpdate(true);
+      return;
+    }
+  }
+  Swipe swipe = Swipe::None;
+  int swipeX = 0, swipeY = 0, endX = 0, endY = 0;
+  const bool sdkSwipe = mappedInput.wasSwipeWithPoints(swipe, swipeX, swipeY, endX, endY);
+  const bool release = mappedInput.wasScreenTouchReleased();
+  if (dragging) {
+    if (!release && !sdkSwipe) return;
+    tracking = false;
+    dragging = false;
+    gestureEndedAt = now;
+    int target;
+    bool after, inside;
+    {
+      RenderLock lock(*this);
+      target = dropRow;
+      after = dropAfter;
+      inside = dropInside;
+      dropRow = -1;
+    }
+    requestUpdate();
+    if (target >= 0) {
+      if (inside) indent(dragRow, target);
+      else reorder(dragRow, target, after);
+    }
+    return;
+  }
+  if (swipe == Swipe::None && release && tracking) {
+    const int dx = lastX - touchX;
+    if (std::abs(peakY) >= 28 && std::abs(peakY) >= std::abs(dx))
+      swipe = peakY < 0 ? Swipe::Up : Swipe::Down;
+    else if (std::abs(dx) >= 60)
+      swipe = dx < 0 ? Swipe::Left : Swipe::Right;
+  }
+  if (swipe != Swipe::None) {
+    const int row = sdkSwipe ? rowAt(swipeX, swipeY) : rowAt(touchX, touchY);
+    tracking = false;
+    gestureEndedAt = now;
+    if (swipe == Swipe::Up || swipe == Swipe::Down) return nextPage(swipe == Swipe::Up ? 1 : -1);
+    if (!selecting && row >= 0 && !itemPending(rows[row].id)) {
+      if (swipe == Swipe::Right) toggle(row);
+      else actions(row);
+    }
+    return;
+  }
+  if (tapped && (pendingOperationsCount() || isErrorNotice(message))) {
+    const auto area = statusArea();
+    if (tapX >= area.x && tapX < area.x + area.width && tapY >= area.y && tapY < area.y + area.height) {
+      tracking = false;
+      if (isErrorNotice(message)) return showErrorDetails();
+      return showPendingOperations();
+    }
+  }
+  if (tapped) {
+    const int statusTop = layout().top + UITheme::getTopStatusBarInset(renderer);
+    const bool lamp = GUI.isFrontlightIndicatorTap(renderer, statusTop, tapX, tapY);
+    const bool hand = GUI.isTouchscreenIndicatorHit(renderer, statusTop, tapX, tapY);
+    if (lamp || hand) {
+      tracking = false;
+      if (lamp) {
+        const bool lightOn = !Frontlight.isOn();
+        Frontlight.setOn(lightOn);
+        SETTINGS.frontlightOn = lightOn ? 1 : 0;
+      } else {
+        SETTINGS.disableReaderTouchscreen = SETTINGS.disableReaderTouchscreen ? 0 : 1;
+      }
+      activityManager.persistGlobalSettings();
+      requestUpdate();
+      return;
+    }
+    if (GUI.isReadestIndicatorTap(renderer, statusTop, tapX, tapY)) {
+      tracking = false;
+      startActivityForResult(std::make_unique<ReadestSettingsActivity>(renderer, mappedInput), {});
+      return;
+    }
+    if (GUI.isHighlightIndicatorTap(renderer, statusTop, tapX, tapY)) {
+      tracking = false;
+      startActivityForResult(std::make_unique<SavedItemsHomeActivity>(renderer, mappedInput), {});
+      return;
+    }
+  }
+  if (tapped && tapBreadcrumb(tapX, tapY)) {
+    tracking = false;
+    return;
+  }
+  if (!selecting && tapped && tapArrow(tapX, tapY)) {
+    tracking = false;
+    return;
+  }
+  const bool held = release && tracking && !moved && now - touchAt >= 550;
+  if (!tapped && !held) {
+    if (release) tracking = false;
+    if (!tracking && !release && saves.empty() && !connectingWifi) {
+      if (!requestedBranch.empty()) pollPrefetch();
+      else if (online && !pendingDelete.empty() && static_cast<long>(millis() - deleteAt) >= 0) commitDelete();
+      else if (online && pendingCount && !outboxUncertain && !prefetch &&
+               static_cast<long>(millis() - retryOutboxAt) >= 0) flushCapture();
+      else if (now - touchAt >= 180) pollPrefetch();
+    }
+    return;
+  }
+  const bool dragged = tracking && moved;
+  tracking = false;
+  x = held ? touchX : tapX;
+  y = held ? touchY : tapY;
+  const auto bounds = layout();
+  if (selecting && y >= bounds.top + 28 && y < bounds.top + 64 && !held) {
+    const int right = bounds.x + bounds.width;
+    if (x < bounds.x + ICON_TARGET) return cancelSelection();
+    if (x >= right - ICON_TARGET) return showBulkMenu();
+    if (x >= right - ICON_TARGET - 104) return selectAll();
+    return;
+  }
+  if (y >= bounds.rowBottom && y < bounds.footer) {
+    const int zone = (x - bounds.x) * 8 / bounds.width;
+    if (pageStarts.size() <= 1) return;
+    if (zone >= 0 && zone < 2) return nextPage(-1, zone == 0);
+    if (zone >= 6 && zone < 8) return nextPage(1, zone == 7);
+  }
+  if (y >= bounds.footer) {
+    if (selecting) {
+      if (x < bounds.x + bounds.width / 5) cancelSelection();
+      return;
+    }
+    const auto control = static_cast<TodoControl>(std::clamp((x - bounds.x) * FOOTER_CONTROLS / bounds.width, 0, FOOTER_CONTROLS - 1));
+    if (control == TodoControl::Back) return back();
+    if (control == TodoControl::Calendar) return openCalendar(false);
+    if (control == TodoControl::Refresh) return refresh(held);
+    if (control == TodoControl::Sort) return sortTimedItems();
+    if (control == TodoControl::Replies) return toggleReplyFilter();
+    if (control == TodoControl::MoveUnfinished) return moveUnfinishedForward();
+    if (control == TodoControl::Add) {
+      if (!credential.empty() && !date.empty()) edit(rows.size());
+      return;
+    }
+    if (control == TodoControl::Undo) {
+      if (undoReady) undo();
+      return;
+    }
+    {
+      RenderLock lock(*this);
+      if (control == TodoControl::ShowDone) showDone = !showDone;
+      else wrapItems = !wrapItems;
+      message = nullptr;
+      layoutDirty = true;
+      if (page < pageStarts.size() && pageStarts[page] < placements.size())
+        wrapAnchor = static_cast<int>(placements[pageStarts[page]].row);
+    }
+    requestUpdate();
+    return;
+  }
+  const int row = rowAt(x, y);
+  if (row < 0 || itemPending(rows[row].id)) return;
+  if (selecting) {
+    if (tapped && !held) toggleSelection(row);
+    return;
+  }
+  if (dragged) return;
+  const int indent = std::min<unsigned>(rows[row].depth, 8) * 16;
+  if (held) return actions(row);
+  if (rows[row].divider) return;
+  size_t cursor = std::string::npos;
+  bool checkboxHit = false;
+  {
+    RenderLock lock(*this);
+    const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+    for (auto i = pageStarts[page]; i < end; ++i) {
+      const auto& placement = placements[i];
+      if (placement.row != static_cast<size_t>(row) || y < placement.top || y >= placement.bottom) continue;
+      const bool firstFragment = i == 0 || placements[i - 1].row != placement.row;
+      checkboxHit = firstFragment && (rows[row].todo || rows[row].done) && x < bounds.x + indent + 30;
+      if (!checkboxHit) {
+        const auto line = std::min(placement.lineCount - 1,
+                                  static_cast<size_t>(std::max(0, y - placement.top - 6) / bounds.lineHeight));
+        const int prefix = !firstFragment && line == 0
+                               ? renderer.getTextWidth(UI_12_FONT_ID, CONTINUATION) + CONTINUATION_GAP : 0;
+        cursor = cursorAt(rows[row].title, outlineLines[placement.firstLine + line], x - bounds.x - indent - 25 - prefix);
+      }
+      break;
+    }
+  }
+  if (checkboxHit) return toggle(row);
+  edit(row, 0, cursor);
+}
+
+const char* WorkflowyDailyActivity::statusNotice() const {
+  if (isErrorNotice(message)) return message;
+  if (connectingWifi) return tr(STR_CONNECTING);
+  if ((awaitingOutline || (calendarVisible && calendarFetch)) && online) return tr(STR_LOADING_POPUP);
+  if (message) return message;
+  if (!online) return tr(STR_WORKFLOWY_OFFLINE);
+  return nullptr;
+}
+
+Rect WorkflowyDailyActivity::statusArea() const {
+  const auto bounds = layout();
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  StatusIconRow::Layout icons;
+  std::copy_n(SETTINGS.statusIconOrder, StatusIconRow::Count, icons.order);
+  StatusIconRow::sanitizeOrder(icons.order);
+  icons.enabledMask = static_cast<uint8_t>(~SETTINGS.statusIconHidden) & StatusIconRow::kAllMask;
+  icons.availableMask = Frontlight.present() ? 1u << StatusIconRow::Lamp : 0;
+  if (mappedInput.hasTouchHardware()) {
+    icons.availableMask |= 1u << StatusIconRow::Touch;
+    if (!SETTINGS.disableReaderTouchscreen)
+      icons.availableMask |= (1u << StatusIconRow::Readest) | (1u << StatusIconRow::Highlighter);
+  }
+  icons.leftX = left + metrics.statusBarHorizontalMargin;
+  const int leftEdge = std::max(left, StatusBarMetrics::sideInset);
+  const int rightEdge = renderer.getScreenWidth() - std::max(right, StatusBarMetrics::sideInset);
+  int iconsRight = icons.leftX;
+  for (unsigned slot = 0; slot < StatusIconRow::Count; ++slot)
+    if (icons.visible(slot)) iconsRight = std::max(iconsRight, icons.x(slot) + StatusIconRow::kIconSize);
+  auto config = SETTINGS.displayStatusBar.asReaderConfig();
+  if (halClock.isAvailable()) placeClockAtRight(config);
+  std::array<int, ReaderStatusBarConfig::SLOT_COUNT> widths{};
+  for (unsigned i = 0; i < widths.size(); ++i) {
+    if (i == ReaderStatusBarConfig::CENTER) continue;
+    char text[64]{};
+    switch (config.slots[i]) {
+      case ReaderStatusBarItem::Clock:
+        if (halClock.isAvailable()) halClock.formatTime(text, sizeof(text), SETTINGS.clockUtcOffsetQ, SETTINGS.clockFormat == 1);
+        break;
+      case ReaderStatusBarItem::Date:
+        formatHeaderDateText(text, sizeof(text));
+        break;
+      case ReaderStatusBarItem::Battery:
+        widths[i] = metrics.batteryWidth;
+        if (SETTINGS.hideBatteryPercentage != CrossPointSettings::HIDE_ALWAYS)
+          snprintf(text, sizeof(text), "%u%%", static_cast<unsigned>(powerManager.getBatteryPercentage()));
+        if (*text) widths[i] += 4;
+        break;
+      default: break;
+    }
+    widths[i] += renderer.getTextWidth(SMALL_FONT_ID, text);
+  }
+  const int reserve = std::max(0, iconsRight - leftEdge) + 4;
+  fitReaderStatusBarSideWidths(widths, rightEdge - leftEdge, reserve, 8);
+  const auto space = layoutReaderStatusBarItems(leftEdge, rightEdge, widths, reserve, 8);
+  const int safeLeft = std::max(space.centerLeft, iconsRight + 8);
+  const int safeRight = space.centerRight - 4;
+  return Rect{safeLeft, bounds.top + UITheme::getTopStatusBarInset(renderer) + 1,
+              std::max(0, safeRight - safeLeft), 26};
+}
+
+void WorkflowyDailyActivity::drawStatus(const Layout&, const size_t pending, const char* notice) {
+  const bool error = isErrorNotice(message);
+  if (!pending && !notice) return;
+  char count[52];
+  const char* label = notice;
+  if (!error && pending) {
+    if (pending > 1 || calendarVisible) {
+      snprintf(count, sizeof(count), pending == 1 ? tr(STR_WORKFLOWY_ACTION_PENDING)
+                                                : tr(STR_WORKFLOWY_ACTIONS_PENDING),
+               static_cast<unsigned>(pending));
+      label = count;
+    } else {
+      const auto action = !saves.empty() ? saves.front()->label
+                        : !requestedBranch.empty() ? StrId::STR_WORKFLOWY_ZOOM
+                        : awaitingOutline ? StrId::STR_LOADING_POPUP
+                        : outboxUncertain ? StrId::STR_WORKFLOWY_SYNC_CHECK : StrId::STR_WORKFLOWY_ADD;
+      label = I18n::getInstance().get(action);
+    }
+  }
+  if (!label) return;
+  const auto area = statusArea();
+  if (area.width < 16) return;
+  const bool clickable = pending || error;
+  const int arrow = clickable ? 10 : 0;
+  const int textLimit = area.width - 2 * (arrow + 4);
+  if (textLimit <= 0) return;
+  const auto fitted = renderer.truncatedText(SMALL_FONT_ID, label, textLimit);
+  const int textWidth = renderer.getTextWidth(SMALL_FONT_ID, fitted.c_str());
+  const int x = area.x + std::max(0, (area.width - textWidth) / 2);
+  const int y = area.y + (area.height - renderer.getLineHeight(SMALL_FONT_ID)) / 2;
+  renderer.fillRect(area.x, area.y, area.width, area.height, false);
+  renderer.beginTextClip(area.x, area.y, area.width, area.height);
+  renderer.drawText(SMALL_FONT_ID, x, y, fitted.c_str());
+  renderer.endTextClip();
+  if (clickable) {
+    const int tip = area.x + area.width - 5, mid = area.y + area.height / 2;
+    renderer.drawLine(tip - 4, mid - 4, tip, mid);
+    renderer.drawLine(tip, mid, tip - 4, mid + 4);
+  }
+}
+
+void WorkflowyDailyActivity::render(RenderLock&&) {
+  const auto bounds = layout();
+  renderer.clearScreen();
+  GUI.drawDisplayStatusBar(renderer, bounds.top);
+  breadcrumbHits = {};
+  if (queueVisible) {
+    renderer.drawText(UI_12_FONT_ID, bounds.x, bounds.top + 32, tr(STR_WORKFLOWY_PENDING), true, EpdFontFamily::BOLD);
+    const int right = bounds.x + bounds.width - 18;
+    const int cy = bounds.top + 46;
+    renderer.drawLine(right - 6, cy - 6, right + 6, cy + 6, 2);
+    renderer.drawLine(right + 6, cy - 6, right - 6, cy + 6, 2);
+    renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+    const size_t visible = std::max(1, (bounds.rowBottom - bounds.rowTop) / ROW_HEIGHT);
+    const size_t inFlightCapture = std::any_of(saves.begin(), saves.end(), [](const auto& save) {
+      return save->fromOutbox;
+    }) && !offlineQueuePreview.empty() ? 1 : 0;
+    const size_t branchEntries = !requestedBranch.empty();
+    std::array<const CalendarDay*, 7> calendarJobs{};
+    size_t calendarEntries = 0;
+    if (calendarVisible) for (const auto& day : calendarDays)
+      if (!day.date.empty() && !day.loaded) calendarJobs[calendarEntries++] = &day;
+    const auto offlineStart = saves.size() + branchEntries + calendarEntries;
+    const auto total = offlineStart + offlineQueuePreview.size() - inFlightCapture;
+    queuePage = std::min(queuePage, total == 0 ? 0 : (total - 1) / visible);
+    const auto opening = branchEntries ? std::find_if(rows.begin(), rows.end(), [&](const Node& node) {
+      return node.id == requestedBranch;
+    }) : rows.end();
+    for (size_t i = queuePage * visible; i < total && i < (queuePage + 1) * visible; ++i) {
+      const auto* save = i < saves.size() ? saves[i].get() : nullptr;
+      const bool openingItem = !save && i < saves.size() + branchEntries;
+      const bool calendarItem = !save && !openingItem && i < offlineStart;
+      const auto type = save ? save->label : openingItem ? StrId::STR_WORKFLOWY_ZOOM
+                        : calendarItem ? StrId::STR_LOADING_POPUP : StrId::STR_WORKFLOWY_ADD;
+      const auto name = save ? std::string_view(save->title)
+                        : openingItem ? (opening == rows.end() ? std::string_view{} : std::string_view(opening->title))
+                        : calendarItem ? std::string_view(calendarJobs[i - saves.size() - branchEntries]->date)
+                        : std::string_view(offlineQueuePreview[i - offlineStart + inFlightCapture]);
+      auto text = std::to_string(i + 1) + ". " + I18n::getInstance().get(type);
+      if (!name.empty()) {
+        text += " · ";
+        text += name;
+      }
+      if (!save && !openingItem && !calendarItem && outboxUncertain && i == offlineStart) {
+        text += " · ";
+        text += tr(STR_WORKFLOWY_SYNC_CHECK);
+      }
+      const auto fitted = renderer.truncatedText(UI_12_FONT_ID, text.c_str(), bounds.width - 14);
+      renderer.drawText(UI_12_FONT_ID, bounds.x + 4, bounds.rowTop + (i % visible) * ROW_HEIGHT + 6, fitted.c_str());
+    }
+    if (!total) renderer.drawCenteredText(UI_12_FONT_ID, bounds.rowTop + 12, tr(STR_WORKFLOWY_QUEUE_EMPTY));
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer + 13, tr(STR_BACK));
+    drawStatus(bounds, pendingOperationsCount(), statusNotice());
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+    return;
+  }
+  if (calendarVisible) {
+    renderCalendar(bounds);
+    return;
+  }
+  if (selecting) {
+    const int cy = bounds.top + 46;
+    const int left = bounds.x + 17;
+    const int right = bounds.x + bounds.width;
+    renderer.drawLine(left - 6, cy - 6, left + 6, cy + 6, 2, true);
+    renderer.drawLine(left + 6, cy - 6, left - 6, cy + 6, 2, true);
+    char summary[40];
+    snprintf(summary, sizeof(summary), tr(STR_WORKFLOWY_SELECTION_COUNT), static_cast<unsigned>(selectionCount()));
+    renderer.drawText(UI_12_FONT_ID, bounds.x + ICON_TARGET, cy - 12, summary);
+    renderer.drawText(SMALL_FONT_ID, right - ICON_TARGET - 96, cy - 9, tr(STR_WORKFLOWY_SELECT_ALL));
+    for (const int dx : {-7, 0, 7}) renderer.fillRect(right - 22 + dx, cy - 1, 3, 3);
+  } else {
+    std::string heading = date.empty() || date == "today" ? isoDate(0) : date == "tomorrow" ? isoDate(1) : date;
+    const char* relative = nullptr;
+    if (date == "today" || date.empty() || date == isoDate(0)) relative = tr(STR_WORKFLOWY_TODAY);
+    else if (date == "tomorrow" || date == isoDate(1)) relative = tr(STR_WORKFLOWY_TOMORROW);
+    else if (date == isoDate(-1)) relative = tr(STR_WORKFLOWY_YESTERDAY);
+    if (relative) heading += heading.empty() ? relative : std::string(", ") + relative;
+    unsigned completed = 0, totalTodos = 0;
+    const unsigned outlineDepth = zoomId.empty() ? 0 : 1;
+    for (const auto& row : rows) {
+      if (row.depth == outlineDepth && row.todo &&
+          (!replyOnly || workflowy::isReplyTask(row.title))) {
+        ++totalTodos;
+        if (row.done) ++completed;
+      }
+    }
+    char todoCount[24];
+    snprintf(todoCount, sizeof(todoCount), "%u/%u", completed, totalTodos);
+    const int right = bounds.x + bounds.width;
+    const int cy = bounds.top + 46;
+    const int dayRight = right - COUNT_TARGET;
+    const int dateLeft = bounds.x + DAY_TARGET;
+    const int dateRight = dayRight - DAY_TARGET;
+    const int countX = dayRight + (COUNT_TARGET - renderer.getTextWidth(SMALL_FONT_ID, todoCount)) / 2;
+    renderer.drawText(SMALL_FONT_ID, countX, bounds.top + 36, todoCount);
+    if (!zoomId.empty()) drawBreadcrumbs(bounds, right);
+    const int dateWidth = dateRight - dateLeft;
+    constexpr int dateFont = UI_12_FONT_ID;
+    const auto drawDate = [&](const std::string& text, int y) {
+      const int width = renderer.getTextWidth(dateFont, text.c_str(), EpdFontFamily::BOLD);
+      renderer.drawText(dateFont, (dateLeft + dateRight - width) / 2, y, text.c_str(), true, EpdFontFamily::BOLD);
+    };
+    if (renderer.getTextWidth(dateFont, heading.c_str(), EpdFontFamily::BOLD) > dateWidth) {
+      if (const auto split = heading.find(", "); split != std::string::npos) {
+        drawDate(heading.substr(0, split + 1), bounds.top + 28);
+        drawDate(heading.substr(split + 2), bounds.top + 46);
+      } else {
+        drawDate(heading, bounds.top + 36);
+      }
+    } else {
+      drawDate(heading, bounds.top + (dateFont == UI_12_FONT_ID ? 32 : 36));
+    }
+    for (const int direction : {-1, 1}) {
+      const int arrowX = direction < 0 ? bounds.x + DAY_TARGET / 2 : dayRight - DAY_TARGET / 2;
+      renderer.drawLine(arrowX - direction * 4, cy - 6, arrowX + direction * 4, cy, 2);
+      renderer.drawLine(arrowX + direction * 4, cy, arrowX - direction * 4, cy + 6, 2);
+    }
+  }
+  renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+  layoutRows(bounds);
+  paintedPage = page;
+  paintedArrows.clear();
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  for (auto i = pageStarts[page]; i < end; ++i) {
+    const auto& placement = placements[i];
+    const auto& node = rows[placement.row];
+    const int y = placement.top + 6;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int start = bounds.x + indent;
+    if (node.divider) {
+      renderer.drawLine(start + 4, (placement.top + placement.bottom) / 2,
+                        bounds.x + bounds.width - 4, (placement.top + placement.bottom) / 2, 2, true);
+      continue;
+    }
+    if ((selecting && node.selected) || itemPending(node.id)) {
+      renderer.fillRectDither(start, placement.top + 1, bounds.x + bounds.width - start,
+                              placement.bottom - placement.top - 2, Color::LightGray);
+    }
+    if (node.depth) renderer.drawLine(start - 7, y - 5, start - 7, placement.bottom - 1);
+    const bool firstFragment = i == 0 || placements[i - 1].row != placement.row;
+    if (firstFragment && selecting && selectionEligible(node)) {
+      renderer.drawRect(start + 1, y + 4, 18, 18);
+      if (node.selected) {
+        renderer.fillRect(start + 1, y + 4, 18, 18);
+        renderer.drawLine(start + 5, y + 12, start + 8, y + 15, 2, false);
+        renderer.drawLine(start + 8, y + 15, start + 14, y + 8, 2, false);
+      }
+    } else if (firstFragment && !selecting) {
+      if (node.todo || node.done) {
+        if (node.done) {
+          drawCheckedBox(renderer, start + 1, y + 4, 18);
+        } else {
+          renderer.drawRect(start + 1, y + 4, 18, 18);
+        }
+      } else {
+        renderer.fillRoundedRect(start + 6, y + 10, 7, 7, 3, Color::Black);
+      }
+    }
+    const int textX = start + 25;
+    const auto title = std::string_view(node.title);
+    const bool continues = i + 1 == end && end < placements.size() && placements[end].row == placement.row;
+    for (size_t line = 0; line < placement.lineCount; ++line) {
+      auto span = outlineLines[placement.firstLine + line];
+      const int lineY = y + static_cast<int>(line) * bounds.lineHeight;
+      const bool leading = !firstFragment && line == 0;
+      const int prefix = leading ? renderer.getTextWidth(UI_12_FONT_ID, CONTINUATION) + CONTINUATION_GAP : 0;
+      const int lineX = textX + prefix;
+      std::string text;
+      if (wrapItems) {
+        text = title.substr(span.begin, span.end - span.begin);
+      } else {
+        const int width = bounds.x + bounds.width - textX - ROW_ARROW_TARGET;
+        text = renderer.truncatedText(UI_12_FONT_ID, node.title.c_str(), width);
+        if (text != title && text.ends_with("…")) span.end = text.size() - 3;
+      }
+      const auto measure = [&](size_t end) {
+        // Ink bounds omit trailing spaces; use the same pen advance as drawText
+        // so the gap before a tag never becomes part of its background.
+        const uint32_t following = end < title.size() && static_cast<unsigned char>(title[end]) < 0x80
+                                       ? static_cast<unsigned char>(title[end]) : 0;
+        return renderer.getTextAdvanceX(UI_12_FONT_ID,
+                                        std::string(title.substr(span.begin, end - span.begin)).c_str(),
+                                        EpdFontFamily::REGULAR, following);
+      };
+      workflowy::forEachTag(title, [&](workflowy::TextSpan tag) {
+        if (tag.end <= span.begin || tag.begin >= span.end) return;
+        const int startX = lineX + measure(std::max(tag.begin, span.begin));
+        const int endX = lineX + measure(std::min(tag.end, span.end));
+        if (endX - startX > 2)
+          renderer.fillRectDither(startX + 1, lineY, endX - startX - 2, bounds.lineHeight, Color::LightGray);
+      });
+      if (leading) renderer.drawText(UI_12_FONT_ID, textX, lineY, CONTINUATION);
+      renderer.drawText(UI_12_FONT_ID, lineX, lineY, text.c_str());
+      if (node.done || (continues && line + 1 == placement.lineCount)) {
+        const int tail = lineX + renderer.getTextWidth(UI_12_FONT_ID, text.c_str());
+        if (node.done) renderer.drawLine(lineX, lineY + 12, tail, lineY + 12);
+        if (continues && line + 1 == placement.lineCount)
+          renderer.drawText(UI_12_FONT_ID, tail + CONTINUATION_GAP, lineY, CONTINUATION);
+      }
+    }
+    if (!selecting && firstFragment && !node.divider && (node.id == zoomId || !node.leaf)) {
+      paintedArrows.push_back({node.id, placement.top, placement.bottom});
+      drawZoomArrow(renderer, bounds.x + bounds.width - 10, y, node.id == zoomId, node.childrenConfirmed);
+    }
+  }
+  // Paint the marker over row artwork and keep its full thickness inside
+  // the target row, including at the last row on the page.
+  if (dropRow >= 0) {
+    for (auto i = pageStarts[page]; i < end; ++i) {
+      const auto& placement = placements[i];
+      if (placement.row != static_cast<size_t>(dropRow)) continue;
+      constexpr int thickness = 4;
+      const int left = bounds.x + 16 * (std::min<unsigned>(rows[placement.row].depth, 8) + dropInside);
+      const int marker = dropAfter || dropInside ? placement.bottom - thickness : placement.top;
+      renderer.fillRect(left, marker, bounds.x + bounds.width - left, thickness, true);
+      break;
+    }
+  }
+  const auto total = pageStarts.size();
+  const auto pending = pendingOperationsCount();
+  const auto* notice = statusNotice();
+  if (!pending && !notice && placements.empty()) notice = tr(STR_WORKFLOWY_EMPTY);
+  drawStatus(bounds, pending, notice);
+  constexpr int ICON_STROKE = 3;
+  if (total > 1) {
+    char pages[24];
+    snprintf(pages, sizeof(pages), "%u/%u", static_cast<unsigned>(page + 1), static_cast<unsigned>(total));
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer - renderer.getLineHeight(SMALL_FONT_ID) - 5, pages);
+    const int y = (bounds.rowBottom + bounds.footer) / 2;
+    for (const int direction : {-1, 1}) {
+      const bool enabled = direction < 0 ? page > 0 : page + 1 < total;
+      if (!enabled) continue;
+      for (const bool edge : {false, true}) {
+        const int slot = direction < 0 ? (edge ? 0 : 1) : (edge ? 7 : 6);
+        const int x = bounds.x + (2 * slot + 1) * bounds.width / 16;
+        const int tip = x + direction * 4;
+        renderer.drawLine(x - direction * 4, y - 6, tip, y, ICON_STROKE, true);
+        renderer.drawLine(tip, y, x - direction * 4, y + 6, ICON_STROKE, true);
+        if (edge) renderer.drawLine(tip + direction * 4, y - 6, tip + direction * 4, y + 6, ICON_STROKE, true);
+      }
+    }
+  }
+  renderer.drawLine(bounds.x, bounds.footer, bounds.x + bounds.width - 1, bounds.footer);
+  if (!selecting) {
+    const int iconY = bounds.footer + 23;
+    const auto iconX = [&](TodoControl control) { return bounds.x + (2 * static_cast<int>(control) + 1) * bounds.width / (2 * FOOTER_CONTROLS); };
+    int x = iconX(TodoControl::Back);
+    renderer.drawLine(x - 9, iconY, x + 9, iconY, ICON_STROKE, true);
+    renderer.drawLine(x - 9, iconY, x - 3, iconY - 6, ICON_STROKE, true);
+    renderer.drawLine(x - 9, iconY, x - 3, iconY + 6, ICON_STROKE, true);
+    const int viewX = iconX(TodoControl::ShowDone);
+    const int eyeX[] = {viewX - 11, viewX - 7, viewX, viewX + 7, viewX + 11, viewX + 7, viewX, viewX - 7};
+    const int eyeY[] = {iconY, iconY - 4, iconY - 6, iconY - 4, iconY, iconY + 4, iconY + 6, iconY + 4};
+    for (int i = 0; i < 8; ++i) {
+      const int next = (i + 1) % 8;
+      renderer.drawLine(eyeX[i], eyeY[i], eyeX[next], eyeY[next], ICON_STROKE, true);
+    }
+    renderer.fillRect(viewX - 2, iconY - 2, 5, 5);
+    if (!showDone) {
+      renderer.drawLine(viewX - 10, iconY + 8, viewX + 10, iconY - 8, ICON_STROKE + 2, false);
+      renderer.drawLine(viewX - 11, iconY + 7, viewX + 9, iconY - 9, ICON_STROKE, true);
+    }
+    x = iconX(TodoControl::Undo);
+    const int undoWidth = undoReady ? ICON_STROKE : ICON_STROKE - 1;
+    renderer.drawLine(x - 10, iconY - 3, x + 4, iconY - 3, undoWidth, true);
+    renderer.drawLine(x + 4, iconY - 3, x + 9, iconY + 2, undoWidth, true);
+    renderer.drawLine(x + 9, iconY + 2, x + 4, iconY + 8, undoWidth, true);
+    renderer.drawLine(x + 4, iconY + 8, x - 3, iconY + 8, undoWidth, true);
+    renderer.drawLine(x - 10, iconY - 3, x - 4, iconY - 9, undoWidth, true);
+    renderer.drawLine(x - 10, iconY - 3, x - 4, iconY + 3, undoWidth, true);
+    x = iconX(TodoControl::Wrap);
+    const int wrapWidth = wrapItems ? ICON_STROKE : ICON_STROKE - 1;
+    renderer.drawLine(x - 11, iconY - 7, x + 4, iconY - 7, wrapWidth, true);
+    renderer.drawLine(x - 11, iconY, x + 2, iconY, wrapWidth, true);
+    renderer.drawLine(x - 11, iconY + 7, x - 3, iconY + 7, wrapWidth, true);
+    renderer.drawLine(x + 9, iconY - 7, x + 9, iconY + 6, wrapWidth, true);
+    renderer.drawLine(x + 5, iconY + 2, x + 9, iconY + 6, wrapWidth, true);
+    renderer.drawLine(x + 9, iconY + 6, x + 13, iconY + 2, wrapWidth, true);
+    const int calendarX = iconX(TodoControl::Calendar);
+    renderer.drawRect(calendarX - 11, iconY - 10, 23, 22);
+    renderer.drawLine(calendarX - 10, iconY - 3, calendarX + 10, iconY - 3, ICON_STROKE, true);
+    renderer.drawLine(calendarX - 5, iconY - 13, calendarX - 5, iconY - 7, ICON_STROKE, true);
+    renderer.drawLine(calendarX + 5, iconY - 13, calendarX + 5, iconY - 7, ICON_STROKE, true);
+    const int sortX = iconX(TodoControl::Sort);
+    for (int line = 0; line < 3; ++line)
+      renderer.drawLine(sortX - 10, iconY - 7 + line * 7, sortX + 2 - line * 3, iconY - 7 + line * 7, ICON_STROKE, true);
+    renderer.drawLine(sortX + 9, iconY - 9, sortX + 9, iconY + 8, ICON_STROKE, true);
+    renderer.drawLine(sortX + 5, iconY + 4, sortX + 9, iconY + 8, ICON_STROKE, true);
+    renderer.drawLine(sortX + 9, iconY + 8, sortX + 13, iconY + 4, ICON_STROKE, true);
+    const auto refresh = freeink::ui::bitmapFromIcon(icon_refresh_cw_32);
+    freeink::ui::GfxRendererTarget target(renderer);
+    target.bitmap({static_cast<int16_t>(iconX(TodoControl::Refresh) - refresh.width / 2),
+                   static_cast<int16_t>(iconY - icon_refresh_cw_32.opticalCenterY),
+                   static_cast<int16_t>(refresh.width), static_cast<int16_t>(refresh.height)},
+                  refresh, freeink::ui::BitmapMode::Center);
+    const int mailX = iconX(TodoControl::Replies);
+    for (int inset = 0; inset < 2; ++inset)
+      renderer.drawRect(mailX - 12 + inset, iconY - 8 + inset, 25 - inset * 2, 18 - inset * 2);
+    renderer.drawLine(mailX - 11, iconY - 7, mailX, iconY + 1, ICON_STROKE, true);
+    renderer.drawLine(mailX, iconY + 1, mailX + 11, iconY - 7, ICON_STROKE, true);
+    if (replyOnly) renderer.drawLine(mailX - 12, iconY + 15, mailX + 12, iconY + 15, ICON_STROKE, true);
+    const int moveX = iconX(TodoControl::MoveUnfinished);
+    for (int inset = 0; inset < 2; ++inset)
+      renderer.drawRect(moveX - 13 + inset, iconY - 8 + inset, 14 - inset * 2, 17 - inset * 2);
+    renderer.drawLine(moveX - 2, iconY, moveX + 13, iconY, ICON_STROKE, true);
+    renderer.drawLine(moveX + 7, iconY - 6, moveX + 13, iconY, ICON_STROKE, true);
+    renderer.drawLine(moveX + 13, iconY, moveX + 7, iconY + 6, ICON_STROKE, true);
+    const int addX = iconX(TodoControl::Add);
+    renderer.drawLine(addX - 9, iconY, addX + 9, iconY, ICON_STROKE, true);
+    renderer.drawLine(addX, iconY - 9, addX, iconY + 9, ICON_STROKE, true);
+  }
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
