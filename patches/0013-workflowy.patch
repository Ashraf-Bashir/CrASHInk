+
+ private:
+  enum class Step { Menu, Waiting, Key, Destination, Note, Connect, Send, Done };
+  enum class Content { Both, Quote, Note };
+  Step step = Step::Menu;
+  Content content = Content::Both;
+  size_t index;
+  size_t next = 0;
+  std::atomic<unsigned> sent{0};
+  int colorFilter;
+  bool ownsWifi = false;
+  bool sendAfterKey = false;
+  std::string credential;
+  std::string destination;
+  std::string summary;
+  std::string sentFile;
+  std::vector<uint64_t> receipts;
+  bool alreadySent = false;
+  std::unique_ptr<freeink::SecureHttpClient> client;
+
+  void menu();
+  void editSetting(bool apiKey);
+  void editNote();
+  void connect();
+  bool loadReceipts();
+  bool recordReceipt(uint64_t receipt);
+  void sendNext();
+  void complete(const char* message);
+};
diff --git a/src/activities/workflowy/WorkflowyDailyActivity.cpp b/src/activities/workflowy/WorkflowyDailyActivity.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4d2ed8a799ca1632947c9183c200ee4fe962cb2e
--- /dev/null
+++ b/src/activities/workflowy/WorkflowyDailyActivity.cpp
@@ -0,0 +1,616 @@
+#include "WorkflowyDailyActivity.h"
+
+#include <ArduinoJson.h>
+#include <GfxRenderer.h>
+#include <HalClock.h>
+#include <I18n.h>
+#include <Memory.h>
+#include <SecureHttpClient.h>
+#include <WiFi.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iterator>
+#include <ctime>
+
+#include "MappedInputManager.h"
+#include "activities/network/WifiSelectionActivity.h"
+#include "activities/util/ConfirmationActivity.h"
+#include "activities/util/KeyboardEntryActivity.h"
+#include "activities/util/OptionSelectionActivity.h"
+#include "components/UITheme.h"
+#include "fontIds.h"
+#include "network/WifiUtils.h"
+#include "workflowy/WorkflowyRoot.h"
+#include "workflowy/WorkflowySettings.h"
+
+namespace {
+constexpr size_t MAX_ROWS = 1024;
+constexpr size_t MAX_RESPONSE = 384 * 1024;
+constexpr int ROW_HEIGHT = 39;
+constexpr int ICON_TARGET = 44;
+constexpr int ROW_ARROW_TARGET = 34;
+constexpr char API[] = "https://workflowy.com/api/v1/nodes";
+
+// Keep response and parsed fields out of the internal heap used by Wi-Fi/TLS.
+struct ResponseAllocator final : ArduinoJson::Allocator {
+  void* allocate(size_t size) override { return heap_caps_malloc(size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT); }
+  void deallocate(void* ptr) override { heap_caps_free(ptr); }
+  void* reallocate(void* ptr, size_t size) override {
+    return heap_caps_realloc(ptr, size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+  }
+};
+
+std::string isoDate(const int offset) {
+  const auto utc = halClock.utcNowMs();
+  if (!utc) return {};
+  const time_t local = utc / 1000 + (static_cast<int>(SETTINGS.clockUtcOffsetQ) - 48) * 900L + offset * 86400L;
+  tm date{};
+  if (!gmtime_r(&local, &date)) return {};
+  char text[16];
+  strftime(text, sizeof(text), "%Y-%m-%d", &date);
+  return text;
+}
+
+bool validDate(const std::string& date) {
+  int y = 0, m = 0, d = 0;
+  if (date.size() != 10 || date[4] != '-' || date[7] != '-' ||
+      sscanf(date.c_str(), "%4d-%2d-%2d", &y, &m, &d) != 3 || y < 1900 || y > 9999 || m < 1 || m > 12 || d < 1)
+    return false;
+  const int days[] = {31, 28 + (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  char canonical[16];
+  snprintf(canonical, sizeof(canonical), "%04d-%02d-%02d", y, m, d);
+  return d <= days[m - 1] && date == canonical;
+}
+
+std::string plainTitle(const char* value) {
+  std::string title;
+  while (*value) {
+    if (*value == '<') {
+      const char* end = strchr(value, '>');
+      if (end) {
+        value = end + 1;
+        continue;
+      }
+    }
+    bool entity = false;
+    for (const auto& [name, character] : {std::pair{"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'},
+                                           {"&quot;", '"'}, {"&#39;", '\''}, {"&nbsp;", ' '}}) {
+      const auto len = strlen(name);
+      if (strncmp(value, name, len) == 0) {
+        title += character;
+        value += len;
+        entity = true;
+        break;
+      }
+    }
+    if (!entity) {
+      const char c = *value++;
+      title += c == '\r' || c == '\n' || c == '\t' ? ' ' : c;
+    }
+  }
+  return title;
+}
+
+std::string escapedTitle(const std::string& text, const bool creating) {
+  std::string output;
+  for (const char c : text) {
+    if (!creating && c == '&') output += "&amp;";
+    else if (!creating && c == '<') output += "&lt;";
+    else if (!creating && c == '>') output += "&gt;";
+    else if (creating && strchr("\\*_[]-`#<>~", c)) {
+      output += '\\';
+      output += c;
+    } else output += c == '\r' || c == '\n' ? ' ' : c;
+  }
+  return output;
+}
+
+std::string encode(JsonDocument& doc) {
+  std::string body;
+  serializeJson(doc, body);
+  return body;
+}
+}  // namespace
+
+WorkflowyDailyActivity::WorkflowyDailyActivity(GfxRenderer& renderer, MappedInputManager& input)
+    : Activity("WorkflowyDaily", renderer, input) {}
+
+void WorkflowyDailyActivity::onEnter() {
+  Activity::onEnter();
+  credential = workflowy::readSetting(workflowy::KEY_FILE, workflowy::KEY_MAX);
+  date = isoDate(0);
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::onExit() {
+  if (ownsWifi) {
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+  }
+  Activity::onExit();
+}
+
+void WorkflowyDailyActivity::showMessage(const char* text) {
+  {
+    RenderLock lock(*this);
+    message = text;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::connect() {
+  if (credential.empty()) {
+    editKey();
+  } else if (hasActiveStationWifiConnection()) {
+    step = Step::Load;
+  } else {
+    ownsWifi = true;
+    step = Step::Waiting;
+    startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput),
+                           [this](const ActivityResult& result) {
+      const auto* wifi = std::get_if<WifiResult>(&result.data);
+      step = !result.isCancelled && wifi && wifi->connected ? Step::Load : Step::Ready;
+      if (step == Step::Ready) showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    });
+  }
+}
+
+void WorkflowyDailyActivity::editKey() {
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                             renderer, mappedInput, tr(STR_WORKFLOWY_API_KEY), "", workflowy::KEY_MAX, InputType::Password),
+                         [this](const ActivityResult& result) {
+    step = Step::Ready;
+    if (result.isCancelled) return;
+    const auto& key = std::get<KeyboardResult>(result.data).text;
+    if (key.empty() || !workflowy::writeSetting(workflowy::KEY_FILE, key)) {
+      showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    credential = key;
+    step = Step::Start;
+  });
+}
+
+int WorkflowyDailyActivity::request(const char* method, const std::string& path, const std::string& body,
+                                   uint8_t* response, size_t* received) {
+  if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) {
+    showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+    return 0;
+  }
+  freeink::SecureHttpClient http;
+  http.setCACert(WorkflowyRoot);
+  http.setTimeout(8000);
+  http.setReuse(false);
+  http.setUserAgent("CrASHInk/Workflowy");
+  if (!http.begin(std::string(API) + path)) return 0;
+  http.addHeader("Authorization", "Bearer " + credential);
+  if (!body.empty()) http.addHeader("Content-Type", "application/json");
+  const int status = http.sendRequest(method, reinterpret_cast<const uint8_t*>(body.data()), body.size(),
+                                    [response, received](const uint8_t* data, const size_t len) {
+    if (!response) return true;
+    if (len > MAX_RESPONSE - *received) return false;
+    memcpy(response + *received, data, len);
+    *received += len;
+    return true;
+  });
+  return status >= 200 && status < 300 && !http.responseComplete() ? 0 : status;
+}
+
+bool WorkflowyDailyActivity::loadChildren(const std::string& parent, const unsigned depth, std::vector<Node>& result) {
+  auto response = makePsramByteBufferNoThrow(MAX_RESPONSE);
+  if (!response) {
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+    return false;
+  }
+  size_t received = 0;
+  const int status = request("GET", "?parent_id=" + parent, {}, response.get(), &received);
+  if (status == 404 && depth == 0) return true;
+  if (status != 200) {
+    showMessage(status == 401 || status == 403 ? tr(STR_WORKFLOWY_AUTH_FAILED) : tr(STR_WORKFLOWY_NETWORK_FAILED));
+    return false;
+  }
+  JsonDocument filter;
+  auto node = filter["nodes"][0];
+  node["id"] = true;
+  node["name"] = true;
+  node["priority"] = true;
+  node["completed"] = true;
+  node["data"]["layoutMode"] = true;
+  ResponseAllocator allocator;
+  JsonDocument doc(&allocator);
+  if (deserializeJson(doc, response.get(), received, DeserializationOption::Filter(filter)) || !doc["nodes"].is<JsonArray>()) {
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+    return false;
+  }
+  const auto nodes = doc["nodes"].as<JsonArrayConst>();
+  if (nodes.size() > MAX_ROWS) {
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+    return false;
+  }
+  result.reserve(nodes.size());
+  for (const auto value : nodes) {
+    std::string id = value["id"] | "";
+    if (id.empty() || id.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) continue;
+    result.push_back({std::move(id), plainTitle(value["name"] | ""), depth, value["priority"] | 0,
+                      strcmp(value["data"]["layoutMode"] | "", "todo") == 0, value["completed"] | false});
+  }
+  std::stable_sort(result.begin(), result.end(), [](const Node& a, const Node& b) { return a.priority < b.priority; });
+  return true;
+}
+
+void WorkflowyDailyActivity::loadDay() {
+  showMessage(tr(STR_LOADING));
+  if (date.empty()) {
+    auto today = isoDate(0);
+    RenderLock lock(*this);
+    date = today.empty() ? "today" : std::move(today);
+  }
+  requestUpdateAndWait();
+  std::vector<Node> loaded;
+  if (loadChildren(date, 0, loaded)) {
+    RenderLock lock(*this);
+    rows = std::move(loaded);
+    page = std::min(page, std::max<size_t>(1, (visibleCount() + layout().rowsPerPage - 1) / layout().rowsPerPage) - 1);
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::toggle(const size_t row) {
+  const bool completed = rows[row].done;
+  const int status = request("POST", "/" + rows[row].id + (completed ? "/uncomplete" : "/complete"), {});
+  if (status != 200) {
+    showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    rows[row].done = !completed;
+    message = nullptr;
+  }
+  nextPage(0);
+}
+
+void WorkflowyDailyActivity::expand(const size_t row) {
+  if (rows[row].leaf) return;
+  const auto depth = rows[row].depth;
+  if (rows[row].expanded) {
+    {
+      RenderLock lock(*this);
+      auto first = rows.begin() + row + 1;
+      auto end = std::find_if(first, rows.end(), [depth](const Node& node) { return node.depth <= depth; });
+      rows.erase(first, end);
+      rows[row].expanded = false;
+    }
+    nextPage(0);
+    return;
+  }
+  std::vector<Node> children;
+  if (!loadChildren(rows[row].id, depth + 1, children)) return;
+  if (rows.size() + children.size() > MAX_ROWS) {
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    rows[row].leaf = children.empty();
+    rows[row].expanded = !children.empty();
+    rows.insert(rows.begin() + row + 1, std::make_move_iterator(children.begin()), std::make_move_iterator(children.end()));
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::edit(const size_t row) {
+  const bool adding = row >= rows.size();
+  const std::string id = adding ? "" : rows[row].id;
+  const std::string initial = adding ? "" : rows[row].title;
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                             renderer, mappedInput, adding ? tr(STR_WORKFLOWY_ADD) : tr(STR_EDIT), initial, 512),
+                         [this, id, initial, row, adding](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const auto& text = std::get<KeyboardResult>(result.data).text;
+    if (text.find_first_not_of(" \t\r\n") == std::string::npos || text == initial) return;
+    JsonDocument update;
+    update["name"] = escapedTitle(text, adding);
+    if (adding) {
+      update["parent_id"] = date;
+      update["layoutMode"] = "todo";
+      update["position"] = "bottom";
+    }
+    const int status = request("POST", adding ? "" : "/" + id, encode(update));
+    if (status < 200 || status >= 300) {
+      showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      return;
+    }
+    if (adding) {
+      step = Step::Load;
+    } else {
+      RenderLock lock(*this);
+      rows[row].title = text;
+      message = nullptr;
+    }
+  });
+}
+
+void WorkflowyDailyActivity::actions(const size_t row) {
+  std::vector<std::string> options{
+      tr(STR_EDIT), tr(STR_WORKFLOWY_MOVE_DATE),
+      rows[row].todo ? tr(STR_WORKFLOWY_TO_BULLET) : tr(STR_WORKFLOWY_TO_TODO), tr(STR_DELETE)};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyItem", StrId::STR_WORKFLOWY, std::move(options),
+                             0, false, true),
+                         [this, row](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const int selected = std::get<OptionSelectionResult>(result.data).index;
+    const auto id = rows[row].id;
+    if (selected == 0) return edit(row);
+    if (selected == 1) return chooseDate(id);
+    if (selected == 2) {
+      const bool todo = !rows[row].todo;
+      JsonDocument update;
+      update["layoutMode"] = todo ? "todo" : "bullets";
+      if (request("POST", "/" + id, encode(update)) == 200) {
+        RenderLock lock(*this);
+        rows[row].todo = todo;
+        message = nullptr;
+      } else {
+        showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }
+    } else if (selected == 3) {
+      startActivityForResult(std::make_unique<ConfirmationActivity>(
+                                 renderer, mappedInput, tr(STR_DELETE), rows[row].title),
+                             [this, id](const ActivityResult& confirmation) {
+        if (confirmation.isCancelled) return;
+        if (request("DELETE", "/" + id, {}) == 200) step = Step::Load;
+        else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      });
+    }
+  });
+}
+
+void WorkflowyDailyActivity::moveToDate(const std::string& id, const std::string& target) {
+  if (id.empty()) {
+    if (date == target) return;
+    {
+      RenderLock lock(*this);
+      date = target;
+      page = 0;
+      rows.clear();
+    }
+    step = Step::Load;
+    return;
+  }
+  JsonDocument update;
+  update["parent_id"] = target;
+  update["position"] = "bottom";
+  if (request("POST", "/" + id + "/move", encode(update)) == 200) step = Step::Load;
+  else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+}
+
+void WorkflowyDailyActivity::chooseDate(std::string moveId) {
+  const auto title = moveId.empty() ? StrId::STR_WORKFLOWY_SHOW_DATE : StrId::STR_WORKFLOWY_MOVE_DATE;
+  std::vector<std::string> choices{tr(STR_WORKFLOWY_YESTERDAY), tr(STR_WORKFLOWY_TODAY), tr(STR_WORKFLOWY_TOMORROW),
+                                   tr(STR_WORKFLOWY_CHOOSE_DATE)};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyDate", title, std::move(choices), 1, false, true),
+                         [this, title, moveId = std::move(moveId)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const int selected = std::get<OptionSelectionResult>(result.data).index;
+    if (selected < 0 || selected > 3) return;
+    if (selected != 3) {
+      const auto target = isoDate(selected - 1);
+      if (target.empty() && selected == 0) showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+      else moveToDate(moveId, target.empty() ? (selected == 1 ? "today" : "tomorrow") : target);
+      return;
+    }
+    startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                               renderer, mappedInput, I18n::getInstance().get(title),
+                               validDate(date) ? date : "", 10),
+                           [this, moveId](const ActivityResult& entered) {
+      if (entered.isCancelled) return;
+      const auto& target = std::get<KeyboardResult>(entered.data).text;
+      if (validDate(target)) moveToDate(moveId, target);
+      else showMessage(tr(STR_WORKFLOWY_INVALID_DATE));
+    });
+  });
+}
+
+WorkflowyDailyActivity::Layout WorkflowyDailyActivity::layout() const {
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int rowTop = top + 74;
+  const int footer = renderer.getScreenHeight() - bottom - 52;
+  const int pageLabel = renderer.getLineHeight(SMALL_FONT_ID) + 3;
+  return {left + 8, top, renderer.getScreenWidth() - right - left - 16, rowTop, footer,
+          std::max(1, (footer - rowTop - pageLabel) / ROW_HEIGHT)};
+}
+
+size_t WorkflowyDailyActivity::visibleCount() const {
+  return std::count_if(rows.begin(), rows.end(), [this](const Node& node) { return showDone || !node.done; });
+}
+
+int WorkflowyDailyActivity::rowAt(const int x, const int y) const {
+  const auto bounds = layout();
+  if (x < bounds.x || x >= bounds.x + bounds.width || y < bounds.rowTop ||
+      y >= bounds.rowTop + bounds.rowsPerPage * ROW_HEIGHT)
+    return -1;
+  size_t target = page * bounds.rowsPerPage + (y - bounds.rowTop) / ROW_HEIGHT;
+  for (size_t i = 0; i < rows.size(); ++i) {
+    if (rows[i].done && !showDone) continue;
+    if (target-- == 0) return static_cast<int>(i);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::nextPage(const int delta) {
+  {
+    RenderLock lock(*this);
+    const size_t perPage = layout().rowsPerPage;
+    const size_t count = visibleCount();
+    const int last = count ? (count - 1) / perPage : 0;
+    page = std::clamp(static_cast<int>(page) + delta, 0, last);
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::loop() {
+  using Button = MappedInputManager::Button;
+  using Swipe = MappedInputManager::SwipeDir;
+  if (mappedInput.wasReleased(Button::Back)) return finish();
+  if (step == Step::Start) return connect();
+  if (step == Step::Load) return loadDay();
+  if (step != Step::Ready) return;
+  if (mappedInput.wasReleased(Button::Up)) return nextPage(-1);
+  if (mappedInput.wasReleased(Button::Down)) return nextPage(1);
+  int x = 0, y = 0;
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    tracking = true;
+    moved = false;
+    touchX = lastX = x;
+    touchY = lastY = y;
+    touchAt = millis();
+  }
+  if (tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    lastX = x;
+    lastY = y;
+    moved |= std::max(std::abs(x - touchX), std::abs(y - touchY)) > 26;
+  }
+  Swipe swipe = Swipe::None;
+  int swipeX = 0, swipeY = 0, endX = 0, endY = 0;
+  const bool sdkSwipe = mappedInput.wasSwipeWithPoints(swipe, swipeX, swipeY, endX, endY);
+  const bool release = mappedInput.wasScreenTouchReleased();
+  if (swipe == Swipe::None && release && tracking) {
+    const int dx = lastX - touchX, dy = lastY - touchY;
+    if (std::max(std::abs(dx), std::abs(dy)) >= 40)
+      swipe = std::abs(dx) > std::abs(dy) ? (dx < 0 ? Swipe::Left : Swipe::Right) : (dy < 0 ? Swipe::Up : Swipe::Down);
+  }
+  if (swipe != Swipe::None) {
+    const int row = sdkSwipe ? rowAt(swipeX, swipeY) : rowAt(touchX, touchY);
+    tracking = false;
+    if (swipe == Swipe::Up || swipe == Swipe::Down) return nextPage(swipe == Swipe::Up ? 1 : -1);
+    if (row >= 0) {
+      if (swipe == Swipe::Right) toggle(row);
+      else actions(row);
+    }
+    return;
+  }
+  if (!release || !tracking) return;
+  tracking = false;
+  if (moved) return;
+  const bool held = millis() - touchAt >= 550;
+  if (!held && !mappedInput.wasScreenTapped(x, y)) return;
+  x = touchX;
+  y = touchY;
+  const auto bounds = layout();
+  if (y < bounds.rowTop && x >= bounds.x + bounds.width - ICON_TARGET) {
+    if (!credential.empty() && !rows.empty()) chooseDate();
+    else if (!credential.empty() && !date.empty() && hasActiveStationWifiConnection()) chooseDate();
+    return;
+  }
+  if (y >= bounds.footer) {
+    const int control = std::clamp((x - bounds.x) * 4 / bounds.width, 0, 3);
+    if (control == 0) finish();
+    if (control == 1) {
+      if (held) editKey();
+      else step = Step::Start;
+    }
+    if (control == 2 && !credential.empty() && !date.empty() && hasActiveStationWifiConnection()) edit(rows.size());
+    if (control == 3) {
+      {
+        RenderLock lock(*this);
+        showDone = !showDone;
+        page = 0;
+      }
+      requestUpdate();
+    }
+    return;
+  }
+  const int row = rowAt(x, y);
+  if (row < 0) return;
+  const int indent = std::min<unsigned>(rows[row].depth, 8) * 16;
+  if (held) actions(row);
+  else if (x >= bounds.x + bounds.width - ROW_ARROW_TARGET && !rows[row].leaf) expand(row);
+  else if (rows[row].todo && x < bounds.x + indent + 30) toggle(row);
+  else edit(row);
+}
+
+void WorkflowyDailyActivity::render(RenderLock&&) {
+  const auto bounds = layout();
+  renderer.clearScreen();
+  GUI.drawDisplayStatusBar(renderer, bounds.top);
+  std::string heading = date.empty() || date == "today" ? tr(STR_WORKFLOWY_TODAY) : date;
+  if (date == isoDate(-1) && !date.empty()) heading += std::string("  ") + tr(STR_WORKFLOWY_YESTERDAY);
+  if (date == isoDate(0) && !date.empty()) heading += std::string("  ") + tr(STR_WORKFLOWY_TODAY);
+  if (date == isoDate(1) && !date.empty()) heading += std::string("  ") + tr(STR_WORKFLOWY_TOMORROW);
+  renderer.drawText(UI_12_FONT_ID, bounds.x, bounds.top + 32, heading.c_str(), true, EpdFontFamily::BOLD);
+  const int cx = bounds.x + bounds.width - 23, cy = bounds.top + 46;
+  renderer.drawRect(cx - 10, cy - 9, 21, 19);
+  renderer.drawLine(cx - 10, cy - 3, cx + 10, cy - 3);
+  renderer.drawLine(cx - 5, cy - 12, cx - 5, cy - 6);
+  renderer.drawLine(cx + 5, cy - 12, cx + 5, cy - 6);
+  renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+  size_t skip = page * bounds.rowsPerPage;
+  int painted = 0;
+  for (const auto& node : rows) {
+    if (node.done && !showDone) continue;
+    if (skip) { --skip; continue; }
+    if (painted >= bounds.rowsPerPage) break;
+    const int y = bounds.rowTop + painted++ * ROW_HEIGHT + 6;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int start = bounds.x + indent;
+    if (node.depth) renderer.drawLine(start - 7, y - 5, start - 7, y + ROW_HEIGHT - 5);
+    if (node.todo) {
+      renderer.drawRect(start + 1, y + 5, 16, 16);
+      if (node.done) {
+        renderer.drawLine(start + 4, y + 12, start + 8, y + 16, 2, true);
+        renderer.drawLine(start + 8, y + 16, start + 14, y + 8, 2, true);
+      }
+    } else {
+      renderer.fillRect(start + 6, y + 11, 5, 5);
+    }
+    const int textX = start + 25;
+    const int width = bounds.x + bounds.width - textX - (node.leaf ? 0 : ROW_ARROW_TARGET);
+    const auto title = renderer.truncatedText(UI_12_FONT_ID, node.title.c_str(), width);
+    renderer.drawText(UI_12_FONT_ID, textX, y, title.c_str());
+    if (node.done) renderer.drawLine(textX, y + 12, textX + renderer.getTextWidth(UI_12_FONT_ID, title.c_str()), y + 12);
+    if (!node.leaf) {
+      const int tipX = bounds.x + bounds.width - 10;
+      const int xs[3] = {tipX - 5, tipX + 4, node.expanded ? tipX : tipX - 5};
+      const int ys[3] = {y + 8, node.expanded ? y + 8 : y + 13, y + 18};
+      renderer.fillPolygon(xs, ys, 3, true);
+    }
+  }
+  const size_t count = visibleCount();
+  const size_t total = std::max<size_t>(1, (count + bounds.rowsPerPage - 1) / bounds.rowsPerPage);
+  if (message || total > 1 || !count) {
+    char pages[24];
+    snprintf(pages, sizeof(pages), "%u/%u", static_cast<unsigned>(page + 1), static_cast<unsigned>(total));
+    const char* footer = message ? message : (!count ? tr(STR_WORKFLOWY_EMPTY) : pages);
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer - renderer.getLineHeight(SMALL_FONT_ID) - 2, footer);
+  }
+  renderer.drawLine(bounds.x, bounds.footer, bounds.x + bounds.width - 1, bounds.footer);
+  const int iconY = bounds.footer + 23;
+  const auto iconX = [&](int slot) { return bounds.x + (2 * slot + 1) * bounds.width / 8; };
+  int x = iconX(0);
+  renderer.drawLine(x - 9, iconY, x + 9, iconY, 2, true);
+  renderer.drawLine(x - 9, iconY, x - 3, iconY - 6, 2, true);
+  renderer.drawLine(x - 9, iconY, x - 3, iconY + 6, 2, true);
+  x = iconX(1);
+  renderer.drawText(UI_12_FONT_ID, x - 8, iconY - 13, "↻");
+  x = iconX(2);
+  renderer.drawLine(x - 8, iconY, x + 8, iconY, 2, true);
+  renderer.drawLine(x, iconY - 8, x, iconY + 8, 2, true);
+  x = iconX(3);
+  renderer.drawRect(x - 9, iconY - 9, 18, 18);
+  if (showDone) {
+    renderer.drawLine(x - 5, iconY, x - 1, iconY + 4, 2, true);
+    renderer.drawLine(x - 1, iconY + 4, x + 5, iconY - 4, 2, true);
+  }
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
