index 0000000000000000000000000000000000000000..8c12fe7b5ce0b3d267161e5c5d5e82d43cbc2e78
--- /dev/null
+++ b/src/workflowy/WorkflowyTagInput.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <cctype>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace workflowy {
+// Keep the todo marker first and group selected tags before the task body.
+inline bool prependTaskTag(std::string& text, size_t& cursor, std::string_view tag, size_t maxLength = 0) {
+  if (tag.empty() || (tag.front() != '#' && tag.front() != '@')) return false;
+  const auto space = [](unsigned char c) { return std::isspace(c) != 0; };
+  size_t at = 0;
+  while (at < text.size() && space(text[at])) ++at;
+  if (text.compare(at, 2, "[]") == 0) at += 2;
+  else if (text.compare(at, 3, "[ ]") == 0) at += 3;
+  while (at < text.size() && space(text[at])) ++at;
+  while (at < text.size() && (text[at] == '#' || text[at] == '@')) {
+    const auto begin = at;
+    while (at < text.size() && !space(text[at])) ++at;
+    if (std::string_view(text).substr(begin, at - begin) == tag) return true;
+    while (at < text.size() && space(text[at])) ++at;
+  }
+  const bool leading = at && !space(text[at - 1]);
+  const size_t added = tag.size() + 1 + leading;
+  if (maxLength && (added > maxLength || text.size() > maxLength - added)) return false;
+  if (leading) text.insert(at++, 1, ' ');
+  text.insert(at, tag.data(), tag.size());
+  text.insert(at + tag.size(), 1, ' ');
+  if (cursor >= at - leading) cursor += added;
+  return true;
+}
+// Typed prefixes are resolved atomically before moving the tag to the front.
+// The temporary is bounded by the Workflowy keyboard's 512-character limit.
+inline bool completeTaskPrefixTag(std::string& text, size_t& cursor, std::string_view tag,
+                                  size_t maxLength, size_t prefix = std::string::npos) {
+  if (prefix == std::string::npos) return prependTaskTag(text, cursor, tag, maxLength);
+  if (prefix > cursor || cursor > text.size()) return false;
+  std::string updated = text;
+  updated.erase(prefix, cursor - prefix);
+  size_t position = prefix;
+  if (!prependTaskTag(updated, position, tag, maxLength)) return false;
+  text = std::move(updated);
+  cursor = position;
+  return true;
+}
+}  // namespace workflowy
