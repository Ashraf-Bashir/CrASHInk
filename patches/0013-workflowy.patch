+#include "network/WifiUtils.h"
+#include "workflowy/WorkflowySettings.h"
+
+namespace workflowy {
+std::string readSetting(const char* path, size_t limit) {
+  FsFile file;
+  const auto backup = std::string(path) + ".bak";
+  if (!Storage.exists(path) && Storage.exists(backup.c_str())) Storage.rename(backup.c_str(), path);
+  if (!Storage.openFileForRead("WF", path, file) || file.size() > limit) return {};
+  std::string value(file.size(), '\0');
+  if (file.read(reinterpret_cast<uint8_t*>(value.data()), value.size()) != static_cast<int>(value.size())) return {};
+  if (value.find_first_of("\r\n") != std::string::npos || value.find('\0') != std::string::npos) return {};
+  return value;
+}
+
+bool writeSetting(const char* path, const std::string& value) {
+  if (value.find_first_of("\r\n") != std::string::npos || value.find('\0') != std::string::npos) return false;
+  Storage.mkdir("/.crashink");
+  const auto temp = std::string(path) + ".tmp", backup = std::string(path) + ".bak";
+  if (!Storage.exists(path) && Storage.exists(backup.c_str()) && !Storage.rename(backup.c_str(), path)) return false;
+  FsFile file = Storage.open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC);
+  if (!file) return false;
+  const bool written = file.write(reinterpret_cast<const uint8_t*>(value.data()), value.size()) == value.size() && file.sync();
+  file.close();
+  if (!written) return false;
+  const bool hadPrevious = Storage.exists(path);
+  if (Storage.exists(backup.c_str()) && !Storage.remove(backup.c_str())) return false;
+  if (hadPrevious && !Storage.rename(path, backup.c_str())) return false;
+  if (!Storage.rename(temp.c_str(), path)) {
+    if (hadPrevious) Storage.rename(backup.c_str(), path);
+    return false;
+  }
+  if (hadPrevious) Storage.remove(backup.c_str());
+  return true;
+}
+
+}  // namespace workflowy
+
+namespace {
+constexpr char API_URL[] = "https://workflowy.com/api/v1/nodes";
+constexpr char DEFAULT_DESTINATION[] = "3dbd4508b236";
+constexpr char DEST_FILE[] = "/.crashink/workflowy.destination";
+constexpr char SHARE_FILE[] = "/.crashink/.workflowy/share.tmp";
+constexpr size_t DEST_MAX = 128;
+std::atomic<bool> sending{false};
+std::atomic<StrId> error{StrId::STR_WORKFLOWY_SENT};
+
+std::string oneLine(std::string value) {
+  for (char& ch : value)
+    if (ch == '\n' || ch == '\r' || ch == '\t') ch = ' ';
+  // Preserve the full text as one bullet and escape Markdown syntax.
+  std::string escaped;
+  for (const char ch : value) {
+    if (ch == '\\' || ch == '*' || ch == '_' || ch == '[' || ch == ']' ||
+        ch == '-' || ch == '<' || ch == '>' || ch == '#' || ch == '`' || ch == '~') escaped += '\\';
+    escaped += ch;
+  }
+  return escaped;
+}
+// Local receipts identify the exact exported content and destination.
+uint64_t receiptHash(const std::string& value, uint64_t hash = 14695981039346656037ULL) {
+  for (unsigned char ch : value) hash = (hash ^ ch) * 1099511628211ULL;
+  return hash;
+}
+
+struct ShareJob {
+  std::string key;
+  std::string receiptPath;
+  bool ownsWifi = false;
+
+  bool connect() {
+    if (hasActiveStationWifiConnection()) return true;
+    const auto networks = WIFI_STORE.getCredentialSummaries();
+    if (networks.empty() || WiFi.getMode() != WIFI_OFF) return false;
+    ownsWifi = true;
+    WiFi.persistent(false);
+    if (!WiFi.mode(WIFI_STA)) return false;
+    WiFi.setAutoReconnect(false);
+    const auto trySaved = [](const std::string& ssid) {
+      const auto saved = WIFI_STORE.findCredential(ssid);
+      if (!saved) return false;
+      WiFi.disconnect(false, false);
+      WiFi.begin(saved->ssid.c_str(), saved->password.empty() ? nullptr : saved->password.c_str());
+      const auto started = millis();
+      while (!hasActiveStationWifiConnection() && millis() - started < 6500) delay(50);
+      return hasActiveStationWifiConnection();
+    };
+    const auto last = WIFI_STORE.getLastConnectedSsid();
+    if (!last.empty() && trySaved(last)) return true;
+    const int count = WiFi.scanNetworks();
+    std::vector<std::string> visible;
+    for (int i = 0; i < count && visible.size() < networks.size(); ++i) {
+      std::string ssid = WiFi.SSID(i).c_str();
+      if (ssid != last && WIFI_STORE.hasSavedCredential(ssid) &&
+          std::find(visible.begin(), visible.end(), ssid) == visible.end()) {
+        visible.push_back(std::move(ssid));
+      }
+    }
+    WiFi.scanDelete();
+    return std::any_of(visible.begin(), visible.end(), trySaved);
+  }
+
+  StrId send() {
+    if (!connect()) return StrId::STR_WORKFLOWY_NETWORK_FAILED;
+    if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) {
+      return StrId::STR_WORKFLOWY_CLOCK_FAILED;
+    }
+    const auto auth = "Bearer " + key;
+    size_t offset = 0;
+    while (true) {
+      FsFile spool;
+      if (!Storage.openFileForRead("WF", SHARE_FILE, spool)) return StrId::STR_WORKFLOWY_READ_FAILED;
+      if (offset == spool.size()) return StrId::STR_WORKFLOWY_SENT;
+      uint32_t length = 0;
+      uint64_t receipt = 0;
+      if (!spool.seek(offset) || spool.read(&receipt, sizeof(receipt)) != sizeof(receipt) ||
+          spool.read(&length, sizeof(length)) != sizeof(length) || !length || length > spool.size() - spool.position()) {
+        return StrId::STR_WORKFLOWY_READ_FAILED;
+      }
+      std::string body(length, '\0');
+      if (spool.read(body.data(), length) != static_cast<int>(length)) return StrId::STR_WORKFLOWY_READ_FAILED;
+      offset = spool.position();
+      spool.close();
+
+      esp_http_client_config_t config{};
+      config.url = API_URL;
+      config.method = HTTP_METHOD_POST;
+      config.crt_bundle_attach = esp_crt_bundle_attach;
+      config.user_agent = "CrASHInk/Workflowy";
+      config.timeout_ms = 12000;
+      config.disable_auto_redirect = true;
+      config.max_authorization_retries = -1;
+      const auto client = esp_http_client_init(&config);
+      if (!client) return StrId::STR_WORKFLOWY_NETWORK_FAILED;
+      auto result = esp_http_client_set_header(client, "Authorization", auth.c_str());
+      if (result == ESP_OK) result = esp_http_client_set_header(client, "Content-Type", "application/json");
+      if (result == ESP_OK) result = esp_http_client_set_post_field(client, body.data(), body.size());
+      if (result == ESP_OK) result = esp_http_client_perform(client);
+      const int status = esp_http_client_get_status_code(client);
+      esp_http_client_cleanup(client);
+      if (status == 401 || status == 403) return StrId::STR_WORKFLOWY_AUTH_FAILED;
+      if (status < 200 || status >= 300) {
+        LOG_ERR("WF", "Share failed: transport=%s HTTP=%d", esp_err_to_name(result), status);
+        return status <= 0 ? StrId::STR_WORKFLOWY_NETWORK_FAILED : StrId::STR_WORKFLOWY_SEND_FAILED;
+      }
+
+      FsFile receipts = Storage.open(receiptPath.c_str(), O_WRONLY | O_CREAT);
+      if (!receipts || !receipts.seek(receipts.size() / sizeof(receipt) * sizeof(receipt)) ||
+          receipts.write(&receipt, sizeof(receipt)) != sizeof(receipt) || !receipts.sync()) {
+        return StrId::STR_WORKFLOWY_RECEIPT_FAILED;
+      }
+      // A successful status acknowledges creation. Never repost on a lost or truncated response.
+    }
+  }
+};
+
+void finishShare(const StrId result) {
+  Storage.remove(SHARE_FILE);
+  error.store(result);
+  sending.store(false);
+}
+
+StrId stageShare(ShareJob& job, const size_t index, const int colorFilter, bool& hasItems) {
+  const auto destination = workflowy::readSetting(DEST_FILE, DEST_MAX);
+  char path[64];
+  snprintf(path, sizeof(path), "/.crashink/.workflowy/%016llx.sent",
+           static_cast<unsigned long long>(receiptHash(CLIPPINGS.getBookFilePath())));
+  job.receiptPath = path;
+  Storage.mkdir("/.crashink");
+  Storage.mkdir("/.crashink/.workflowy");
+
+  std::vector<uint64_t> receipts;
+  if (Storage.exists(path)) {
+    FsFile existing;
+    if (!Storage.openFileForRead("WF", path, existing)) return StrId::STR_WORKFLOWY_READ_FAILED;
+    uint64_t receipt;
+    while (existing.read(&receipt, sizeof(receipt)) == sizeof(receipt)) receipts.push_back(receipt);
+    std::sort(receipts.begin(), receipts.end());
+  }
+  FsFile spool = Storage.open(SHARE_FILE, O_WRONLY | O_CREAT | O_TRUNC);
+  if (!spool) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+  const size_t end = index == SIZE_MAX ? CLIPPINGS.clippingCount() : index + 1;
+  const auto keyHash = receiptHash(job.key);
+  for (size_t current = index == SIZE_MAX ? 0 : index; current < end; ++current) {
+    const auto* clipping = CLIPPINGS.clippingAt(current);
+    if (!clipping || (colorFilter && static_cast<int>(clipping->color) + 1 != colorFilter)) continue;
+    std::string quote, note, chapter;
+    if (!CLIPPINGS.readClippingNote(current, note) || !CLIPPINGS.readClippingText(current, quote)) {
+      return StrId::STR_WORKFLOWY_READ_FAILED;
+    }
+    CLIPPINGS.readChapterTitle(current, chapter);
+    std::string citation;
+    for (const auto* part : {&CLIPPINGS.getBookTitle(), &CLIPPINGS.getBookAuthor(), static_cast<const std::string*>(&chapter)}) {
+      if (part->empty()) continue;
+      if (!citation.empty()) citation += " — ";
+      citation += oneLine(*part);
+    }
+    auto name = oneLine(quote);
+    if (!citation.empty()) name += "\n\n📖 " + citation;
+    if (!note.empty()) name += "\n\n📝 " + oneLine(note);
+    JsonDocument request;
+    request["parent_id"] = destination.empty() ? DEFAULT_DESTINATION : destination;
+    request["name"] = name;
+    request["position"] = "bottom";
+    std::string body;
+    if (!serializeJson(request, body) || request.overflowed()) return StrId::STR_WORKFLOWY_SEND_FAILED;
+    auto receipt = receiptHash(body, keyHash);
+    receipt = (receipt ^ clipping->spineIndex) * 1099511628211ULL;
+    receipt = (receipt ^ clipping->startPage) * 1099511628211ULL;
+    receipt = (receipt ^ clipping->startWordIndex) * 1099511628211ULL;
+    if (std::binary_search(receipts.begin(), receipts.end(), receipt)) continue;
+    const auto length = static_cast<uint32_t>(body.size());
+    if (spool.write(&receipt, sizeof(receipt)) != sizeof(receipt) ||
+        spool.write(&length, sizeof(length)) != sizeof(length) ||
+        spool.write(body.data(), body.size()) != body.size()) {
+      return StrId::STR_WORKFLOWY_SAVE_FAILED;
+    }
+    hasItems = true;
+  }
+  return spool.sync() ? StrId::STR_WORKFLOWY_SENT : StrId::STR_WORKFLOWY_SAVE_FAILED;
+}
+}  // namespace
+
+void workflowy::shareClippings(const size_t index, const int colorFilter) {
+  if (sending.exchange(true)) return;
+  auto job = std::make_unique<ShareJob>();
+  job->key = readSetting(KEY_FILE, KEY_MAX);
+  if (job->key.empty()) return finishShare(StrId::STR_WORKFLOWY_AUTH_FAILED);
+  bool hasItems = false;
+  const auto result = stageShare(*job, index, colorFilter, hasItems);
+  if (result != StrId::STR_WORKFLOWY_SENT || !hasItems) return finishShare(result);
+  auto* context = job.release();
+  const auto sendTask = [](void* context) {
+    StrId result;
+    {
+      const std::unique_ptr<ShareJob> job(static_cast<ShareJob*>(context));
+      result = job->send();
+      if (job->ownsWifi) {
+        WiFi.disconnect(false, false);
+        WiFi.mode(WIFI_OFF);
+      }
+    }
+    finishShare(result);
+    vTaskDelete(nullptr);
+  };
+  if (xTaskCreate(sendTask, "wf-share", 8192, context, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete context;
+    finishShare(StrId::STR_WORKFLOWY_SEND_FAILED);
+  }
+}
+
+bool workflowy::shareInProgress() { return sending.load(); }
+
+std::optional<StrId> workflowy::takeShareError() {
+  const auto result = error.exchange(StrId::STR_WORKFLOWY_SENT);
+  if (result == StrId::STR_WORKFLOWY_SENT) return std::nullopt;
+  return result;
+}
