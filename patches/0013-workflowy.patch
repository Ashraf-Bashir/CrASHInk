diff --git a/src/workflowy/WorkflowyOutlineLayout.h b/src/workflowy/WorkflowyOutlineLayout.h
new file mode 100644
index 0000000000000000000000000000000000000000..f00bf7c537a1a80bea62d1a5d318e91f2f66e0e9
--- /dev/null
+++ b/src/workflowy/WorkflowyOutlineLayout.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <cstddef>
+#include <string_view>
+#include <vector>
+
+namespace workflowy {
+
+struct TextSpan {
+  size_t begin;
+  size_t end;
+};
+
+inline size_t nextCharacter(std::string_view text, size_t at) {
+  do {
+    ++at;
+  } while (at < text.size() && (static_cast<unsigned char>(text[at]) & 0xc0) == 0x80);
+  return at;
+}
+
+// Return byte spans so a tag split across lines keeps its original identity.
+template <typename Measure>
+void wrapOutlineText(std::string_view text, int width, Measure measure, std::vector<TextSpan>& lines) {
+  const auto initialSize = lines.size();
+  size_t begin = 0;
+  while (begin < text.size()) {
+    if (text[begin] == ' ') {
+      ++begin;
+      continue;
+    }
+    size_t end = begin;
+    size_t word = begin;
+    while (word < text.size()) {
+      const auto space = text.find(' ', word);
+      const auto wordEnd = space == std::string_view::npos ? text.size() : space;
+      if (measure(text.substr(begin, wordEnd - begin)) > width) break;
+      end = wordEnd;
+      word = wordEnd;
+      while (word < text.size() && text[word] == ' ') ++word;
+    }
+    if (end == begin) {
+      end = nextCharacter(text, begin);
+      while (end < text.size() && text[end] != ' ') {
+        const auto next = nextCharacter(text, end);
+        if (measure(text.substr(begin, next - begin)) > width) break;
+        end = next;
+      }
+    }
+    lines.push_back({begin, end});
+    begin = end;
+  }
+  if (lines.size() == initialSize) lines.push_back({0, 0});
+}
+
+inline bool tagCharacter(unsigned char c) {
+  return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+         c == '_' || c == '-' || c >= 0x80;
+}
+
+template <typename Draw>
+void forEachTag(std::string_view text, Draw draw) {
+  for (size_t i = 0; i + 1 < text.size(); ++i) {
+    if ((text[i] != '#' && text[i] != '@') || !tagCharacter(text[i + 1])) continue;
+    if (i && text[i - 1] != ' ' && text[i - 1] != '(' && text[i - 1] != '[' && text[i - 1] != '"') continue;
+    size_t end = i + 2;
+    while (end < text.size() && tagCharacter(text[end])) ++end;
+    draw(TextSpan{i, end});
+    i = end - 1;
+  }
+}
+
+// With only top/bottom moves, the longest already ordered contiguous section
+// of the target order can stay put. Move the remaining ends around it.
+inline TextSpan stationaryRange(const std::vector<size_t>& desired) {
+  TextSpan best{0, 0};
+  size_t begin = 0;
+  for (size_t i = 0; i < desired.size(); ++i) {
+    if (i && desired[i] < desired[i - 1]) begin = i;
+    if (i + 1 - begin > best.end - best.begin) best = {begin, i + 1};
+  }
+  return best;
+}
+
+}  // namespace workflowy
