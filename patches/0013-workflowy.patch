+WorkflowyDailyActivity::CalendarGrid WorkflowyDailyActivity::calendarGrid() const {
+  const auto bounds = layout();
+  const int y = bounds.top + CONTENT_TOP + (calendarWeek ? 44 : 8);
+  const int height = std::max(120, bounds.footer - y - 6);
