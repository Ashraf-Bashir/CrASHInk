+class WorkflowyDatePicker final : public Activity {
+ public:
+  WorkflowyDatePicker(GfxRenderer& renderer, MappedInputManager& input, StrId title,
+                     const std::string& date, const std::string& today)
+      : Activity("WorkflowyDatePicker", renderer, input), title(title), date(date), today(today) {
+    sscanf(date.c_str(), "%4d-%2d", &year, &month);
+  }
+
+  void onEnter() override {
+    Activity::onEnter();
+    requestUpdate();
+  }
+
+  bool allowGlobalHomeSwipeGesture() const override { return false; }
+
+  void loop() override {
+    using Button = MappedInputManager::Button;
+    using Swipe = MappedInputManager::SwipeDir;
+    if (mappedInput.wasReleased(Button::Back) || TouchHeaderBackButton::wasTapped(mappedInput, renderer)) {
+      ActivityResult result;
+      result.isCancelled = true;
+      setResult(std::move(result));
+      return finish();
+    }
+    Swipe swipe = Swipe::None;
+    int x, y, endX, endY;
+    mappedInput.wasSwipeWithPoints(swipe, x, y, endX, endY);
+    if (swipe == Swipe::Left || mappedInput.wasReleased(Button::Down)) return shiftMonth(1);
+    if (swipe == Swipe::Right || mappedInput.wasReleased(Button::Up)) return shiftMonth(-1);
+    if (!mappedInput.wasScreenTapped(x, y)) return;
+    const auto grid = layout();
+    if (y >= grid.nav && y < grid.nav + 44) {
+      if (x >= grid.left && x < grid.left + 54) return shiftMonth(-1);
+      if (x >= grid.right - 54 && x < grid.right) return shiftMonth(1);
+    }
+    if (y < grid.top || y >= grid.top + grid.cellHeight * 6 || x < grid.left || x >= grid.right) return;
+    const int column = (x - grid.left) * 7 / (grid.right - grid.left);
+    const int day = (y - grid.top) / grid.cellHeight * 7 + column - firstColumn() + 1;
+    if (day < 1 || day > monthLength(year, month)) return;
+    char selected[16];
+    snprintf(selected, sizeof(selected), "%04d-%02d-%02d", year, month, day);
+    setResult(KeyboardResult{selected});
+    finish();
+  }
+
+  void render(RenderLock&&) override {
+    renderer.clearScreen();
+    TouchHeaderBackButton::draw(renderer, TouchHeaderBackButton::headerRect(renderer, mappedInput),
+                               I18n::getInstance().get(title), false);
+    const auto grid = layout();
+    constexpr StrId months[] = {StrId::STR_MONTH_JAN, StrId::STR_MONTH_FEB, StrId::STR_MONTH_MAR,
+                                StrId::STR_MONTH_APR, StrId::STR_MONTH_MAY, StrId::STR_MONTH_JUN,
+                                StrId::STR_MONTH_JUL, StrId::STR_MONTH_AUG, StrId::STR_MONTH_SEP,
+                                StrId::STR_MONTH_OCT, StrId::STR_MONTH_NOV, StrId::STR_MONTH_DEC};
+    constexpr StrId week[] = {StrId::STR_STATS_MON, StrId::STR_STATS_TUE, StrId::STR_STATS_WED, StrId::STR_STATS_THU,
+                              StrId::STR_STATS_FRI, StrId::STR_STATS_SAT, StrId::STR_STATS_SUN};
+    const auto heading = std::string(I18n::getInstance().get(months[month - 1])) + " " + std::to_string(year);
+    renderer.drawCenteredText(UI_12_FONT_ID, grid.nav + 10, heading.c_str(), true, EpdFontFamily::BOLD);
+    for (const int direction : {-1, 1}) {
+      const int x = direction < 0 ? grid.left + 25 : grid.right - 25;
+      const int y = grid.nav + 21;
+      renderer.drawLine(x - direction * 4, y - 6, x + direction * 4, y, 2, true);
+      renderer.drawLine(x + direction * 4, y, x - direction * 4, y + 6, 2, true);
+    }
+    const auto boundary = [&](int column) { return grid.left + (column * (grid.right - grid.left) + 6) / 7; };
+    for (int col = 0; col < 7; ++col) {
+      const char* label = I18n::getInstance().get(week[col]);
+      const auto width = renderer.getTextWidth(SMALL_FONT_ID, label);
+      renderer.drawText(SMALL_FONT_ID, (boundary(col) + boundary(col + 1) - width) / 2, grid.top - 25, label);
+    }
+    const int offset = firstColumn();
+    const int fontHeight = renderer.getLineHeight(UI_12_FONT_ID);
+    for (int day = 1; day <= monthLength(year, month); ++day) {
+      const int cell = offset + day - 1;
+      const int col = cell % 7;
+      const int x = boundary(col);
+      const int width = boundary(col + 1) - x;
+      const int y = grid.top + (cell / 7) * grid.cellHeight;
+      char iso[16];
+      snprintf(iso, sizeof(iso), "%04d-%02d-%02d", year, month, day);
+      const bool selected = date == iso;
+      if (selected) renderer.fillRoundedRect(x + 3, y + 3, width - 6, grid.cellHeight - 6, 4, Color::Black);
+      else if (today == iso) renderer.drawRoundedRect(x + 3, y + 3, width - 6, grid.cellHeight - 6, 1, 4, true);
+      char label[4];
+      snprintf(label, sizeof(label), "%d", day);
+      renderer.drawText(UI_12_FONT_ID, x + (width - renderer.getTextWidth(UI_12_FONT_ID, label)) / 2,
+                        y + (grid.cellHeight - fontHeight) / 2, label, !selected);
+    }
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+  }
+
+ private:
+  struct Grid { int left, right, nav, top, cellHeight; };
+  StrId title;
+  std::string date, today;
+  int year = 2026, month = 1;
+
+  Grid layout() const {
+    int top, right, bottom, left;
+    renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+    const auto header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+    const int nav = std::max(top + 44, header.y + header.height + 5);
+    const int gridTop = nav + 72;
+    const int cellHeight = std::clamp((renderer.getScreenHeight() - bottom - gridTop - 8) / 6, 24, 50);
+    return {left + 12, renderer.getScreenWidth() - right - 12, nav, gridTop, cellHeight};
+  }
+
+  int firstColumn() const {
+    // Gregorian weekday, with Monday in the first column.
+    constexpr int offsets[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
+    const int y = year - (month < 3);
+    return (y + y / 4 - y / 100 + y / 400 + offsets[month - 1]) % 7;
+  }
+
+  void shiftMonth(int delta) {
+    const int index = std::clamp(year * 12 + month - 1 + delta, 1900 * 12, 9999 * 12 + 11);
+    {
+      RenderLock lock(*this);
+      year = index / 12;
+      month = index % 12 + 1;
+    }
+    requestUpdate();
+  }
+};
