+
+void WorkflowyDailyActivity::openCalendar(bool week) {
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  const auto current = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  if (current.empty()) return showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+  {
+    RenderLock lock(*this);
+    calendarVisible = true;
+    calendarWeek = week;
+    calendarSchedule = false;
+    schedulingItem.reset();
+    schedulingItems.reset();
+    schedulingDate.clear();
+    scheduleOffset = 0;
+    calendarAnchor = current;
+    requestedBranch.clear();
+    awaitingOutline = false;
+    calendarDrag = {};
+    calendarHits.clear();
+  }
+  reloadCalendar();
+}
+
+void WorkflowyDailyActivity::reloadCalendar() {
+  calendarRefreshAt = millis() + CALENDAR_REFRESH_MS;
+  if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+  const auto first = calendarWeek
+                         ? workflowy::shiftScheduleDate(calendarAnchor, -workflowy::scheduleWeekday(calendarAnchor))
+                         : calendarAnchor;
+  {
+    RenderLock lock(*this);
+    const auto previous = std::move(calendarDays);
+    calendarDays = {};
+    for (size_t i = 0; i < (calendarWeek ? 7u : 1u); ++i) {
+      auto& day = calendarDays[i];
+      day.date = workflowy::shiftScheduleDate(first, static_cast<int>(i));
+      const auto cached = std::find_if(previous.begin(), previous.end(), [&](const CalendarDay& item) {
+        return item.date == day.date && item.loaded;
+      });
+      if (cached != previous.end()) {
+        day.items = cached->items;
+      } else if (day.date == date) {
+        const auto& outline = viewStack.empty() ? rows : viewStack.front().rows;
+        for (const auto& node : outline) {
+          if (node.depth == 0 && workflowy::parseTimeRange(node.title)) day.items.push_back(node);
+        }
+      }
+    }
+    calendarHits.clear();
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::calendarFetchTask(void* argument) {
+  {
+    std::unique_ptr<std::shared_ptr<CalendarFetch>> holder(static_cast<std::shared_ptr<CalendarFetch>*>(argument));
+    auto& job = **holder;
+    job.status = fetchChildren(job.key, job.date, 0, job.items, &job.cancel, &job.transport);
+    // The timeline owns only timed nodes. Full child lists remain lazy in the outline.
+    std::erase_if(job.items, [](const Node& node) { return !workflowy::parseTimeRange(node.title); });
+    job.ready.store(true, std::memory_order_release);
+  }
+  vTaskDelete(nullptr);
+}
+
+void WorkflowyDailyActivity::pollCalendar() {
+  if (calendarVisible && !calendarFetch && !calendarDrag.tracking && saves.empty() &&
+      static_cast<long>(millis() - calendarRefreshAt) >= 0) {
+    {
+      RenderLock lock(*this);
+      for (auto& day : calendarDays) if (!day.date.empty()) day.loaded = false;
+      calendarRefreshAt = millis() + CALENDAR_REFRESH_MS;
+    }
+    requestUpdate();
+  }
+  if (calendarFetch) {
+    if (!calendarFetch->ready.load(std::memory_order_acquire)) return;
+    auto completed = std::move(calendarFetch);
+    if (!completed->cancel.load(std::memory_order_relaxed)) {
+      const auto day = std::find_if(calendarDays.begin(), calendarDays.end(), [&](const CalendarDay& entry) {
+        return entry.date == completed->date;
+      });
+      if (day != calendarDays.end()) {
+        {
+          RenderLock lock(*this);
+          day->loaded = true;
+          if (completed->status == 200) {
+            // Preserve optimistic items until their own save response settles.
+            for (const auto& old : day->items) {
+              if (!itemPending(old.id)) continue;
+              const auto found = std::find_if(completed->items.begin(), completed->items.end(),
+                                               [&](const Node& node) { return node.id == old.id; });
+              if (found != completed->items.end()) *found = old;
+              else if (old.id.starts_with("pending:")) completed->items.push_back(old);
+            }
+            day->items = std::move(completed->items);
+          }
+        }
+        if (completed->status != 200) {
+          recordServerError(completed->status, completed->transport, {}, credential);
+          showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+        } else requestUpdate();
+      }
+    }
+  }
+  if (!calendarVisible || !saves.empty() || !online || calendarDrag.active ||
+      (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire))) return;
+  if (prefetch) {
+    prefetch->cancel.store(true, std::memory_order_relaxed);
+    if (!prefetch->ready.load(std::memory_order_acquire)) return;
+    prefetch.reset();
+  }
+  const auto next = std::find_if(calendarDays.begin(), calendarDays.end(), [](const CalendarDay& day) {
+    return !day.date.empty() && !day.loaded;
+  });
+  if (next == calendarDays.end()) return;
+  // Shared ownership keeps a cancelled request alive until its worker closes TLS.
+  auto allocation = makeUniqueNoThrow<CalendarFetch>();
+  if (!allocation) return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  std::shared_ptr<CalendarFetch> job(std::move(allocation));
+  job->key = credential;
+  job->date = next->date;
+  auto holder = makeUniqueNoThrow<std::shared_ptr<CalendarFetch>>(job);
+  if (!holder) return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  calendarFetch = job;
+  // calendarFetchTask takes ownership of the argument.
+  auto* argument = holder.release();
+  if (xTaskCreate(calendarFetchTask, "wf-calendar", 8192, argument, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete argument;
+    calendarFetch.reset();
+    return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::openCalendarTask(unsigned day, const std::string& id) {
+  if (day >= calendarDays.size() || itemPending(id)) return;
+  const auto item = std::find_if(calendarDays[day].items.begin(), calendarDays[day].items.end(),
+                                  [&](const Node& node) { return node.id == id; });
+  if (item == calendarDays[day].items.end()) return;
+  const auto target = calendarDays[day].date;
+  if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+  {
+    RenderLock lock(*this);
+    calendarVisible = false;
+    calendarDrag = {};
+  }
+  if (!viewStack.empty()) returnToDepth(0);
+  if (target == date && std::any_of(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; })) {
+    const auto existing = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    return zoom(existing - rows.begin());
+  }
+  calendarFocusZoom = true;
+  calendarFocus = id;
+  if (target == date) loadDay();
+  else moveToDate({}, target);
+}
+
+void WorkflowyDailyActivity::createCalendarTask(unsigned day, int start) {
+  if (day >= calendarDays.size() || calendarDays[day].date.empty()) return;
+  const auto target = calendarDays[day].date;
+  std::shared_ptr<WorkflowyTimeChoices> choices;
+  const auto fixed = schedulingItem;
+  const auto bulk = schedulingItems;
+  const auto source = schedulingDate;
+  if (!fixed && !bulk) {
+    const auto today = isoDate(0);
+    if (!timeChoices) {
+      auto allocation = makeUniqueNoThrow<WorkflowyTimeChoices>();
+      if (!allocation) {
+        LOG_ERR("WF", "Could not allocate time-block choices");
+        return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+      }
+      timeChoices = std::shared_ptr<WorkflowyTimeChoices>(std::move(allocation));
+    }
+    if (!timeChoices->started || (timeChoices->ready.load(std::memory_order_acquire) &&
+        (timeChoices->cancel.load(std::memory_order_relaxed) || timeChoices->date != today ||
+         millis() - timeChoices->startedAt >= CALENDAR_REFRESH_MS))) {
+      RenderLock lock(*this);
+      timeChoices->key = credential;
+      timeChoices->date = today;
+      timeChoices->items.clear();
+      timeChoices->cancel.store(false, std::memory_order_relaxed);
+      timeChoices->ready.store(false, std::memory_order_relaxed);
+      timeChoices->started = false;
+      timeChoices->status = 0;
+    }
+    choices = timeChoices;
+    if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+    if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+  }
+  char bulkTitle[48]{};
+  if (bulk) snprintf(bulkTitle, sizeof(bulkTitle), tr(STR_WORKFLOWY_SELECTION_COUNT), static_cast<unsigned>(bulk->size()));
+  auto picker = makeUniqueNoThrow<WorkflowyTimeRangePicker>(
+      renderer, mappedInput, start, choices, [this] { pollTimeChoices(); },
+      fixed ? fixed->id : "", bulk ? std::string(bulkTitle) : fixed ? fixed->title : "",
+      [this](const char* notice) { drawStatus(layout(), 0, notice); });
+  if (!picker) {
+    LOG_ERR("WF", "Could not allocate time-block picker");
+    return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  }
+  startActivityForResult(std::move(picker),
+                         [this, target, source, fixed, bulk, choices](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const auto& picked = std::get<WorkflowyBlockResult>(result.data);
+    if (bulk) return applyScheduledSelection(*bulk, source, target, picked.start, picked.end);
+    if (fixed) return saveTaskSchedule(*fixed, source, target, picked.start, picked.end, true);
+    if (!picked.itemId.empty() && choices && choices->ready.load(std::memory_order_acquire)) {
+      const auto selected = std::find_if(choices->items.begin(), choices->items.end(),
+                                          [&](const auto& item) { return item.id == picked.itemId; });
+      if (selected == choices->items.end()) return;
+      return saveTaskSchedule(Node{selected->id, selected->title, 0, 0, selected->todo, selected->done},
+                              choices->date, target, picked.start, picked.end, false);
+    }
+    edit(rows.size(), 0, std::string::npos, "[] " + workflowy::scheduleRange(picked.start, picked.end) + " ", target);
+  });
+}
+
+void WorkflowyDailyActivity::scheduleSelection() {
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const auto count = selectionCount();
+  if (!count) return;
+  if (count > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  const auto today = isoDate(0);
+  const auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  if (today.empty() || source.empty()) return showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+  // Up to MAX_SAVE_QUEUE snapshots: the calendar may load another day before Save.
+  auto allocation = makeUniqueNoThrow<std::vector<Node>>();
+  if (!allocation) {
+    LOG_ERR("WF", "Could not allocate bulk schedule selection");
+    return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  }
+  std::shared_ptr<std::vector<Node>> items(std::move(allocation));
+  items->reserve(count);
+  for (const auto& node : rows) if (node.selected && !node.divider && !itemPending(node.id)) items->push_back(node);
+  if (items->empty()) return;
+  cancelSelection();
+  openCalendar(false);
+  {
+    RenderLock lock(*this);
+    schedulingItems = std::move(items);
+    schedulingDate = source;
+    calendarAnchor = today;
+  }
+  reloadCalendar();
+}
+
+void WorkflowyDailyActivity::applyScheduledSelection(const std::vector<Node>& items, const std::string& source,
+                                                     const std::string& target, int start, int end) {
+  if (!workflowy::scheduleSelectionFits(start, end, items.size())) {
+    lastStatus = lastTransport = 0;
+    lastServerError = tr(STR_WORKFLOWY_SCHEDULE_OVERFLOW);
+    return showMessage(tr(STR_WORKFLOWY_SCHEDULE_OVERFLOW));
+  }
+  if (items.size() > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  const int duration = end - start;
+  {
+    RenderLock lock(*this);
+    calendarVisible = false;
+    schedulingItem.reset();
+    schedulingItems.reset();
+    calendarFocus = items.front().id;
+    calendarFocusZoom = false;
+    if (std::any_of(items.begin(), items.end(), [](const Node& node) { return node.done; })) showDone = true;
+  }
+  for (const auto& item : items) {
+    saveTaskSchedule(item, source, target, start, start + duration, false);
+    start += duration;
+  }
+  if (target != date) moveToDate({}, target);
+  else {
+    const auto first = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == items.front().id; });
+    if (first != rows.end()) {
+      RenderLock lock(*this);
+      wrapAnchor = first - rows.begin();
+      layoutDirty = true;
+      calendarFocus.clear();
+    }
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::scheduleItem(size_t row) {
+  if (row >= rows.size() || itemPending(rows[row].id)) return;
+  const auto today = isoDate(0);
+  if (today.empty()) return showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+  const auto item = rows[row];
+  const auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  openCalendar(false);
+  {
+    RenderLock lock(*this);
+    calendarAnchor = today;
+    schedulingItem = item;
+    schedulingDate = source;
+  }
+  reloadCalendar();
+}
+
+void WorkflowyDailyActivity::timeChoicesTask(void* argument) {
+  {
+    std::unique_ptr<std::shared_ptr<WorkflowyTimeChoices>> holder(static_cast<std::shared_ptr<WorkflowyTimeChoices>*>(argument));
+    auto& job = **holder;
+    std::vector<Node> nodes;
+    job.status = fetchChildren(job.key, job.date, 0, nodes, &job.cancel);
+    job.items.reserve(nodes.size());
+    for (auto& node : nodes)
+      job.items.push_back({std::move(node.id), std::move(node.title), node.todo, node.done});
+    job.ready.store(true, std::memory_order_release);
+  }
+  vTaskDelete(nullptr);
+}
+
+void WorkflowyDailyActivity::pollTimeChoices() {
+  if (!timeChoices || timeChoices->started || timeChoices->ready.load(std::memory_order_acquire) || !saves.empty()) return;
+  if ((prefetch && !prefetch->ready.load(std::memory_order_acquire)) ||
+      (calendarFetch && !calendarFetch->ready.load(std::memory_order_acquire))) return;
+  prefetch.reset();
+  calendarFetch.reset();
+  auto holder = makeUniqueNoThrow<std::shared_ptr<WorkflowyTimeChoices>>(timeChoices);
+  if (!holder) {
+    LOG_ERR("WF", "Could not allocate time-block worker argument");
+    timeChoices->status = -5;
+    timeChoices->ready.store(true, std::memory_order_release);
+    return;
+  }
+  timeChoices->started = true;
+  timeChoices->startedAt = millis();
+  // The network worker owns this shared argument and never accesses UI state.
+  auto* argument = holder.release();
+  if (xTaskCreate(timeChoicesTask, "wf-time-choices", 8192, argument, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete argument;
+    timeChoices->status = -5;
+    timeChoices->ready.store(true, std::memory_order_release);
+  }
+}
+
+void WorkflowyDailyActivity::saveTaskSchedule(Node item, std::string source, std::string target,
+                                              int start, int end, bool returnToList) {
+  if (itemPending(item.id)) return;
+  auto updated = item.title;
+  if (workflowy::parseTimeRange(updated)) updated = workflowy::replaceTimeRange(updated, start, end);
+  else updated = workflowy::scheduleRange(start, end) + " " + updated;
+  JsonDocument update;
+  update["name"] = escapedTitle(updated, false);
+  const auto body = encode(update);
+  if (!queueSave("/" + item.id, body, false,
+                 [this, item, source, target, updated, returnToList](const Save& save) {
+    if (save.status < 200 || save.status >= 300) {
+      applyTitle(item.id, item.title, item.todo);
+      updateCalendarTask(item.id, target, source, item.title);
+      if (calendarVisible) reloadCalendar();
+      return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    }
+    if (target != source) removeNode(item.id);
+    if (timeChoices && timeChoices->ready.load(std::memory_order_acquire)) timeChoices->startedAt = 0;
+    if (returnToList) {
+      calendarFocusZoom = false;
+      calendarFocus = item.id;
+      if (target != date) moveToDate({}, target);
+      else {
+        const auto found = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == item.id; });
+        if (found != rows.end()) {
+          wrapAnchor = found - rows.begin();
+          layoutDirty = true;
+          calendarFocus.clear();
+          requestUpdate();
+        } else loadDay();
+      }
+    }
+  }, "POST", StrId::STR_WORKFLOWY_SCHEDULE_VIEW, item.id,
+     [body, id = item.id, original = item.title, source, target](Save& save) {
+    save.status = requestWithKey(save.key, "POST", "/" + id, body, nullptr, nullptr, 0,
+                                 nullptr, nullptr, &save.transport, &save.error);
+    if (save.status < 200 || save.status >= 300 || source == target) return;
+    JsonDocument move;
+    move["parent_id"] = target;
+    move["position"] = "bottom";
+    save.status = requestWithKey(save.key, "POST", "/" + id + "/move", encode(move), nullptr, nullptr, 0,
+                                 nullptr, nullptr, &save.transport, &save.error);
+    if (save.status < 200 || save.status >= 300) {
+      JsonDocument restore;
+      restore["name"] = escapedTitle(original, false);
+      requestWithKey(save.key, "POST", "/" + id, encode(restore), nullptr, nullptr, 0);
+    }
+  })) return;
+  applyTitle(item.id, updated, item.todo);
+  updateCalendarTask(item.id, source, target, updated);
+  {
+    RenderLock lock(*this);
+    saves.back()->title = item.title.substr(0, 120);
+    for (auto& day : calendarDays) {
+      if (day.date != target || std::any_of(day.items.begin(), day.items.end(),
+                                           [&](const Node& node) { return node.id == item.id; })) continue;
+      item.title = updated;
+      day.items.push_back(item);
+    }
+    if (returnToList) {
+      if (item.done) showDone = true;
+      calendarVisible = false;
+      schedulingItem.reset();
+    }
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::updateCalendarTask(const std::string& id, const std::string& source,
+                                                const std::string& destination, const std::string& title) {
+  RenderLock lock(*this);
+  std::optional<Node> moved;
+  for (auto& day : calendarDays) {
+    const auto node = std::find_if(day.items.begin(), day.items.end(), [&](const Node& row) { return row.id == id; });
+    if (node == day.items.end()) continue;
+    if (source != destination) {
+      moved = *node;
+      day.items.erase(node);
+    } else {
+      node->title = title;
+    }
+  }
+  if (moved) {
+    moved->title = title;
+    for (auto& day : calendarDays) {
+      if (day.date == destination && std::none_of(day.items.begin(), day.items.end(),
+                                                 [&](const Node& item) { return item.id == id; })) {
+        day.items.push_back(*moved);
+      }
+    }
+  }
+  const auto update = [&](std::vector<Node>& outline) {
+    for (auto& item : outline) if (item.id == id) item.title = title;
+  };
+  update(rows);
+  for (auto& view : viewStack) update(view.rows);
+  layoutDirty = true;
+}
+
+void WorkflowyDailyActivity::saveCalendarDrag() {
+  const auto drag = calendarDrag;
+  {
+    RenderLock lock(*this);
+    calendarDrag = {};
+  }
+  if (!drag.active || drag.day >= calendarDays.size() || itemPending(drag.id)) return requestUpdate();
+  const auto destination = calendarDays[drag.day].date;
+  if (drag.start == drag.originalStart && drag.end == drag.originalEnd && destination == drag.originDate)
+    return requestUpdate();
+  const auto updated = workflowy::replaceTimeRange(drag.title, drag.start, drag.end);
+  JsonDocument change;
+  change["name"] = escapedTitle(updated, false);
+  const auto body = encode(change);
+  if (!queueSave("/" + drag.id, body, false,
+                 [this, drag, destination, updated](const Save& save) {
+    if (save.status < 200 || save.status >= 300) {
+      updateCalendarTask(drag.id, destination, drag.originDate, drag.title);
+      showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      // A move response can be lost after the server accepts it. Refresh the
+      // visible dates to reconcile the task after restoring the local preview.
+      if (calendarVisible) {
+        reloadCalendar();
+        showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }
+      return;
+    }
+    if (destination != drag.originDate) {
+      const bool current = destination == date || (date == "today" && destination == isoDate(0));
+      removeNode(drag.id, current);
+    }
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, drag.id,
+     [id = drag.id, original = drag.title, destination, source = drag.originDate, body](Save& save) {
+    save.status = requestWithKey(save.key, "POST", "/" + id, body, nullptr, nullptr, 0,
+                                 nullptr, nullptr, &save.transport, &save.error);
+    if (save.status < 200 || save.status >= 300 || source == destination) return;
+    JsonDocument move;
+    move["parent_id"] = destination;
+    move["position"] = "bottom";
+    save.status = requestWithKey(save.key, "POST", "/" + id + "/move", encode(move), nullptr, nullptr, 0,
+                                 nullptr, nullptr, &save.transport, &save.error);
+    if (save.status < 200 || save.status >= 300) {
+      JsonDocument restore;
+      restore["name"] = escapedTitle(original, false);
+      requestWithKey(save.key, "POST", "/" + id, encode(restore), nullptr, nullptr, 0);
+    }
+  })) return requestUpdate();
+  {
+    RenderLock lock(*this);
+    saves.back()->title = drag.title.substr(0, 120);
+  }
+  updateCalendarTask(drag.id, drag.originDate, destination, updated);
+  {
+    RenderLock lock(*this);
+    for (auto& day : calendarDays) {
+      if (day.date == destination && std::none_of(day.items.begin(), day.items.end(),
+                                                 [&](const Node& item) { return item.id == drag.id; })) {
+        day.items.push_back(Node{drag.id, updated, 0, 0, drag.todo, drag.done});
+      }
+    }
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::calendarLoop(bool tapped, int tapX, int tapY) {
+  using Swipe = MappedInputManager::SwipeDir;
+  using Button = MappedInputManager::Button;
+  const auto bounds = layout();
+  const auto grid = calendarGrid();
+  int x, y;
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    RenderLock lock(*this);
+    calendarDrag = {};
+    calendarDrag.tracking = true;
+    calendarDrag.x = x;
+    calendarDrag.y = calendarDrag.lastY = y;
+    calendarDrag.lastX = x;
+    calendarDrag.inContent = y >= grid.y && y < grid.y + grid.height;
+    calendarDrag.started = millis();
+    const auto hit = std::find_if(calendarHits.rbegin(), calendarHits.rend(), [&](const CalendarHit& item) {
+      return x >= item.x && x < item.x + item.width && y >= item.y && y < item.y + item.height;
+    });
+    if (!calendarSchedule && calendarDrag.inContent && hit != calendarHits.rend() && !itemPending(hit->id)) {
+      const auto node = std::find_if(calendarDays[hit->day].items.begin(), calendarDays[hit->day].items.end(),
+                                     [&](const Node& row) { return row.id == hit->id; });
+      if (node != calendarDays[hit->day].items.end()) {
+        calendarDrag.id = hit->id;
+        calendarDrag.title = node->title;
+        calendarDrag.todo = node->todo;
+        calendarDrag.done = node->done;
+        calendarDrag.originDate = calendarDays[hit->day].date;
+        calendarDrag.day = hit->day;
+        calendarDrag.originalScroll = calendarScroll;
+        calendarDrag.start = calendarDrag.originalStart = hit->start;
+        calendarDrag.end = calendarDrag.originalEnd = hit->end;
+        const int handle = std::min(12, hit->height / 3);
+        const int visibleEnd = calendarScroll + grid.height * 60 / grid.hourHeight;
+        calendarDrag.edge = y < hit->y + handle && hit->start >= calendarScroll ? -1
+                          : y >= hit->y + hit->height - handle && hit->end <= visibleEnd ? 1 : 0;
+      }
+    }
+  }
+  if (calendarDrag.tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    calendarDrag.lastX = x;
+    calendarDrag.lastY = y;
+    const int distance = std::max(std::abs(x - calendarDrag.x), std::abs(y - calendarDrag.y));
+    if (!calendarDrag.active && distance > 12 && millis() - calendarDrag.started < 350)
+      calendarDrag.moved = true;
+    if (calendarDrag.id.empty() && distance > 12) calendarDrag.moved = true;
+  }
+  Swipe contactSwipe = Swipe::None;
+  int swipeX, swipeY, endX, endY;
+  mappedInput.wasSwipeWithPoints(contactSwipe, swipeX, swipeY, endX, endY);
+  const bool released = mappedInput.wasScreenTouchReleased();
+  if (released && calendarDrag.active) return saveCalendarDrag();
+  if (contactSwipe == Swipe::None && released && calendarDrag.tracking && calendarDrag.moved) {
+    const int dx = calendarDrag.lastX - calendarDrag.x, dy = calendarDrag.lastY - calendarDrag.y;
+    if (std::abs(dy) >= std::abs(dx)) contactSwipe = dy < 0 ? Swipe::Up : Swipe::Down;
+    else contactSwipe = dx < 0 ? Swipe::Left : Swipe::Right;
+  }
+  if (contactSwipe != Swipe::None || calendarDrag.moved) tapped = false;
+  const auto changePeriod = [&](int delta) {
+    const auto shifted = workflowy::shiftScheduleDate(calendarAnchor, delta * (calendarWeek ? 7 : 1));
+    if (shifted.empty()) return;
+    {
+      RenderLock lock(*this);
+      calendarAnchor = shifted;
+      calendarDrag = {};
+    }
+    reloadCalendar();
+  };
+  if (contactSwipe != Swipe::None && !calendarDrag.active) {
+    const bool inContent = !calendarDrag.tracking || calendarDrag.inContent;
+    gestureEndedAt = millis();
+    {
+      RenderLock lock(*this);
+      calendarDrag = {};
+    }
+    if (!inContent) return;
+    if (contactSwipe == Swipe::Left || contactSwipe == Swipe::Right) return changePeriod(contactSwipe == Swipe::Left ? 1 : -1);
+    return scrollCalendar(contactSwipe == Swipe::Up ? 1 : -1);
+  }
+  if (tapped && gestureEndedAt && millis() - gestureEndedAt < 160) tapped = false;
+  if (tapped && calendarWeek && tapY >= grid.y - 44 && tapY < grid.y &&
+      tapX >= grid.x && tapX < grid.x + grid.width) {
+    const auto column = std::clamp((tapX - grid.x) * 7 / grid.width, 0, 6);
+    {
+      RenderLock lock(*this);
+      calendarAnchor = calendarDays[column].date;
+      calendarWeek = false;
+      calendarSchedule = false;
+    }
+    return reloadCalendar();
+  }
+  if (tapped && tapY >= bounds.top + 28 && tapY < bounds.top + 63) {
+    if (tapX < bounds.x + ICON_TARGET) return changePeriod(-1);
+    if (tapX >= bounds.x + bounds.width - ICON_TARGET) return changePeriod(1);
+    startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput,
+                               StrId::STR_WORKFLOWY_SHOW_DATE, calendarAnchor, isoDate(0)),
+                           [this](const ActivityResult& result) {
+      if (!result.isCancelled) {
+        {
+          RenderLock lock(*this);
+          calendarAnchor = std::get<KeyboardResult>(result.data).text;
+        }
+        reloadCalendar();
+      }
+    });
+    return;
+  }
+  if (tapped && (pendingOperationsCount() || isErrorNotice(message))) {
+    const auto area = statusArea();
+    if (tapX >= area.x && tapX < area.x + area.width && tapY >= area.y && tapY < area.y + area.height) {
+      if (isErrorNotice(message)) return showErrorDetails();
+      return showPendingOperations();
+    }
+  }
+  if (tapped && tapY >= bounds.footer) {
+    const auto slot = static_cast<CalendarControl>(std::clamp((tapX - bounds.x) * 7 / bounds.width, 0, 6));
+    if (slot == CalendarControl::Back) {
+      {
+        RenderLock lock(*this);
+        calendarVisible = false;
+      }
+      if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+      return requestUpdate();
+    }
+    if (slot == CalendarControl::View) return showCalendarMode();
+    if (slot == CalendarControl::ZoomOut || slot == CalendarControl::ZoomIn) return zoomCalendar(slot == CalendarControl::ZoomOut ? -1 : 1);
+    if (slot == CalendarControl::Add) {
+      unsigned day = 0;
+      if (calendarWeek) {
+        for (unsigned i = 0; i < calendarDays.size(); ++i) if (calendarDays[i].date == calendarAnchor) day = i;
+      }
+      return createCalendarTask(day, calendarScroll);
+    }
+    if (slot == CalendarControl::Today) {
+      const auto today = isoDate(0);
+      if (today.empty()) return showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+      {
+        RenderLock lock(*this);
+        calendarAnchor = today;
+        scheduleOffset = 0;
+      }
+    }
+    return reloadCalendar();
+  }
+  if (calendarDrag.tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    const int distance = std::max(std::abs(x - calendarDrag.x), std::abs(y - calendarDrag.y));
+    if (!calendarDrag.active && distance > 22 && millis() - calendarDrag.started < 350) calendarDrag.moved = true;
+    if (!calendarDrag.id.empty() && !calendarDrag.moved && millis() - calendarDrag.started >= 350) {
+      bool changed;
+      bool shiftPeriod = false;
+      {
+        RenderLock lock(*this);
+        const auto now = millis();
+        if (now - calendarDrag.scrollAt >= 650) {
+          const int scrollDelta = y < grid.y + 20 ? -30 : y >= grid.y + grid.height - 20 ? 30 : 0;
+          calendarScroll = std::clamp(calendarScroll + scrollDelta, 0,
+                                      std::max(0, 1440 - grid.height * 60 / grid.hourHeight));
+          if (!calendarDrag.edge && (x < grid.x || x >= grid.x + grid.width)) {
+            const int direction = x < grid.x ? -1 : 1;
+            const auto target = workflowy::shiftScheduleDate(calendarAnchor, direction * (calendarWeek ? 7 : 1));
+            if (!target.empty()) {
+              calendarAnchor = target;
+              shiftPeriod = true;
+            }
+          }
+          calendarDrag.scrollAt = now;
+        }
+        const bool wasActive = calendarDrag.active;
+        const int delta = (((y - calendarDrag.y) * 60 / grid.hourHeight) +
+                           calendarScroll - calendarDrag.originalScroll) / 15 * 15;
+        const int oldStart = calendarDrag.start, oldEnd = calendarDrag.end;
+        const unsigned oldDay = calendarDrag.day;
+        calendarDrag.active = true;
+        if (calendarDrag.edge < 0) {
+          calendarDrag.start = std::clamp(calendarDrag.originalStart + delta, 0, calendarDrag.originalEnd - 15);
+        } else if (calendarDrag.edge > 0) {
+          calendarDrag.end = std::clamp(calendarDrag.originalEnd + delta, calendarDrag.originalStart + 15, 1440);
+        } else {
+          const int duration = calendarDrag.originalEnd - calendarDrag.originalStart;
+          calendarDrag.start = std::clamp(calendarDrag.originalStart + delta, 0, 1440 - duration);
+          calendarDrag.end = calendarDrag.start + duration;
+          if (calendarWeek)
+            calendarDrag.day = std::clamp((x - grid.x) * 7 / grid.width, 0, 6);
+        }
+        changed = !wasActive || oldStart != calendarDrag.start || oldEnd != calendarDrag.end ||
+                  oldDay != calendarDrag.day || shiftPeriod;
+      }
+      if (shiftPeriod) reloadCalendar();
+      else if (changed) requestUpdate();
+      return;
+    }
+  }
+  if (calendarDrag.active && mappedInput.wasScreenTouchReleased()) return saveCalendarDrag();
+  if (mappedInput.wasReleased(Button::Down) || mappedInput.wasReleased(Button::Up)) {
+    return scrollCalendar(mappedInput.wasReleased(Button::Down) ? 1 : -1);
+  }
+  if (tapped && tapX >= bounds.x && tapX < grid.x + grid.width && tapY >= grid.y && tapY < grid.y + grid.height) {
+    std::optional<CalendarHit> selected;
+    {
+      RenderLock lock(*this);
+      if (calendarDrag.active) return;
+      if (calendarDrag.moved) {
+        calendarDrag = {};
+        return;
+      }
+      const auto hit = std::find_if(calendarHits.rbegin(), calendarHits.rend(), [&](const CalendarHit& item) {
+        return tapX >= item.x && tapX < item.x + item.width && tapY >= item.y && tapY < item.y + item.height;
+      });
+      if (hit != calendarHits.rend()) selected = *hit;
+      calendarDrag = {};
+    }
+    if (selected) {
+      if (schedulingItem || schedulingItems) return createCalendarTask(selected->day, selected->start);
+      return openCalendarTask(selected->day, selected->id);
+    }
+    const unsigned day = calendarWeek ? std::clamp((tapX - grid.x) * 7 / grid.width, 0, 6) : 0;
+    const int start = std::clamp((calendarScroll + grid.minuteAt(tapY)) / 15 * 15, 0, 1425);
+    return createCalendarTask(day, start);
+  }
+  if (mappedInput.wasScreenTouchReleased() && !calendarDrag.active) {
+    RenderLock lock(*this);
+    calendarDrag = {};
+  }
+  // Transport progresses even if the calendar was panned while a request ran.
+  if (!pollSave()) pollCalendar();
+}
+
+void WorkflowyDailyActivity::renderCalendar(const Layout& bounds) {
+  const auto grid = calendarGrid();
+  const int right = bounds.x + bounds.width;
+  const int cy = bounds.top + 46;
+  const auto first = calendarDays.front().date.empty() ? calendarAnchor : calendarDays.front().date;
+  const auto last = calendarWeek ? workflowy::shiftScheduleDate(first, 6) : first;
+  const auto label = calendarWeek ? first.substr(5) + " — " + last.substr(5) : calendarAnchor;
+  renderer.drawCenteredText(UI_12_FONT_ID, bounds.top + 32, label.c_str(), true, EpdFontFamily::BOLD);
+  for (const int direction : {-1, 1}) {
+    const int x = direction < 0 ? bounds.x + 20 : right - 20;
+    renderer.drawLine(x - direction * 5, cy - 6, x + direction * 5, cy, 3, true);
+    renderer.drawLine(x + direction * 5, cy, x - direction * 5, cy + 6, 3, true);
+  }
+  drawStatus(bounds, pendingOperationsCount(), statusNotice());
+  if (calendarSchedule) {
+    renderSchedule(bounds);
+    calendarFooter(bounds);
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+    return;
+  }
+  const unsigned columns = calendarWeek ? 7 : 1;
+  const int minutes = grid.height * 60 / grid.hourHeight;
+  calendarScroll = std::clamp(calendarScroll, 0, std::max(0, 1440 - minutes));
+  const auto columnLeft = [&](unsigned column) { return grid.x + static_cast<int>(column) * grid.width / columns; };
+  if (calendarWeek) {
+    constexpr StrId days[] = {StrId::STR_STATS_MON, StrId::STR_STATS_TUE, StrId::STR_STATS_WED, StrId::STR_STATS_THU,
+                               StrId::STR_STATS_FRI, StrId::STR_STATS_SAT, StrId::STR_STATS_SUN};
+    for (unsigned column = 0; column < 7; ++column) {
+      const auto& day = calendarDays[column].date;
+      const int left = columnLeft(column), width = columnLeft(column + 1) - left;
+      const auto weekday = renderer.truncatedText(SMALL_FONT_ID, I18n::getInstance().get(days[column]), width - 4);
+      const bool today = day == isoDate(0);
+      renderer.drawText(SMALL_FONT_ID, left + (width - renderer.getTextWidth(SMALL_FONT_ID, weekday.c_str())) / 2,
+                        grid.y - 42, weekday.c_str());
+      const auto number = day.size() == 10 ? day.substr(8) : "";
+      if (today) renderer.drawRoundedRect(left + width / 2 - 14, grid.y - 24, 28, 23, 1, 8, true);
+      renderer.drawText(SMALL_FONT_ID, left + (width - renderer.getTextWidth(SMALL_FONT_ID, number.c_str())) / 2,
+                        grid.y - 21, number.c_str(), true, EpdFontFamily::BOLD);
+    }
+  }
+  for (int minute = (calendarScroll / 60) * 60; minute <= calendarScroll + minutes; minute += 30) {
+    const int y = grid.y + (minute - calendarScroll) * grid.hourHeight / 60;
+    if (y < grid.y || y >= grid.y + grid.height) continue;
+    if (minute % 60 == 0 && (grid.hourHeight >= 48 || minute % 120 == 0)) {
+      const auto hour = workflowy::scheduleClock(minute);
+      renderer.drawText(SMALL_FONT_ID, bounds.x, y, hour.c_str());
+      renderer.drawLine(grid.x, y, right - 1, y);
+    } else {
+      for (int x = grid.x; x < right; x += 6) renderer.drawPixel(x, y, true);
+    }
+  }
+  for (unsigned column = 0; column <= columns; ++column) {
+    renderer.drawLine(columnLeft(column), grid.y, columnLeft(column), grid.y + grid.height);
+  }
+  calendarHits.clear();
+  size_t totalBlocks = 0;
+  for (const auto& day : calendarDays) totalBlocks += day.items.size();
+  calendarHits.reserve(totalBlocks);
+  const auto drawBlock = [&](const Node& node, unsigned column, int start, int end, unsigned lane, unsigned lanes, bool preview) {
+    if (end <= calendarScroll || start >= calendarScroll + minutes) return;
+    const int left = columnLeft(column), columnWidth = columnLeft(column + 1) - left;
+    const int x = left + static_cast<int>(lane) * columnWidth / lanes + 2;
+    const int width = std::max(4, columnWidth / static_cast<int>(lanes) - 4);
+    const int y = std::max(grid.y + 1, grid.y + (start - calendarScroll) * grid.hourHeight / 60);
+    const int bottom = std::min(grid.y + grid.height - 1,
+                                grid.y + (end - calendarScroll) * grid.hourHeight / 60);
+    const int height = std::max(1, bottom - y - 1);
+    renderer.fillRoundedRect(x, y, width, height, 4, Color::White);
+    if (!node.done)
+      renderer.fillRectDither(x, y, width, height, preview || itemPending(node.id) ? Color::DarkGray : Color::LightGray);
+    renderer.drawRoundedRect(x, y, width, height, preview ? 2 : 1, 4, true);
+    renderer.fillRect(x, y + 3, std::min(3, width), std::max(1, height - 6), true);
+    if (width > 22 && height >= renderer.getLineHeight(SMALL_FONT_ID)) {
+      auto title = node.title;
+      if (const auto range = workflowy::parseTimeRange(title)) title.erase(range->begin, range->finish - range->begin);
+      while (!title.empty() && title.front() == ' ') title.erase(0, 1);
+      const int lineHeight = renderer.getLineHeight(SMALL_FONT_ID);
+      const int capacity = std::max(0, (height - 6) / lineHeight);
+      calendarTextLines.clear();
+      workflowy::wrapOutlineText(std::string_view(title), width - 10,
+                                [&](std::string_view value) {
+        return renderer.getTextWidth(SMALL_FONT_ID, std::string(value).c_str());
+      }, calendarTextLines);
+      for (int line = 0; line < capacity && static_cast<size_t>(line) < calendarTextLines.size(); ++line) {
+        const auto span = calendarTextLines[line];
+        const auto text = title.substr(span.begin, span.end - span.begin);
+        const int textY = y + 3 + line * lineHeight;
+        renderer.drawText(SMALL_FONT_ID, x + 6, textY, text.c_str());
+        if (node.done) renderer.drawLine(x + 6, textY + lineHeight / 2,
+                                         x + 6 + renderer.getTextWidth(SMALL_FONT_ID, text.c_str()),
+                                         textY + lineHeight / 2);
+      }
+    }
+    if (height > 18 && width > 20) {
+      const int cx = x + width / 2;
+      renderer.drawLine(cx - 5, y + 3, cx + 5, y + 3, 2, true);
+      renderer.drawLine(cx - 5, y + height - 4, cx + 5, y + height - 4, 2, true);
+    }
+    if (preview && calendarDrag.edge && width >= 8) {
+      const int edgeY = calendarDrag.edge < 0 ? y : y + std::max(0, height - 6);
+      renderer.fillRect(x, edgeY, width, std::min(6, height), true);
+      const int gripWidth = std::min(20, width - 4);
+      if (height >= 6) renderer.drawLine(x + (width - gripWidth) / 2, edgeY + 3,
+                                        x + (width + gripWidth) / 2, edgeY + 3, 2, false);
+    }
+    if (!preview) calendarHits.push_back({node.id, column, x, y, width, height, start, end});
+  };
+  for (unsigned column = 0; column < columns; ++column) {
+    calendarBlocks.clear();
+    const auto& day = calendarDays[column];
+    calendarBlocks.reserve(day.items.size());
+    for (size_t i = 0; i < day.items.size(); ++i) {
+      const auto& node = day.items[i];
+      if (calendarDrag.active && node.id == calendarDrag.id) continue;
+      if (const auto range = workflowy::parseTimeRange(node.title)) {
+        calendarBlocks.push_back({range->start, range->end, i});
+      }
+    }
+    workflowy::assignScheduleLanes(calendarBlocks, calendarLaneEnds);
+    for (const auto& block : calendarBlocks)
+      drawBlock(day.items[block.item], column, block.start, block.end, block.lane, block.lanes, false);
+  }
+  if (calendarDrag.active) {
+    const Node preview{calendarDrag.id, calendarDrag.title, 0, 0, calendarDrag.todo, calendarDrag.done};
+    drawBlock(preview, calendarDrag.day, calendarDrag.start, calendarDrag.end, 0, 1, true);
+  }
+  if (calendarAnchor == isoDate(0) || calendarWeek) {
+    const auto utc = halClock.utcNowMs();
+    const auto local = utc / 60000 + (static_cast<int>(SETTINGS.clockUtcOffsetQ) - 48) * 15;
+    const int minute = (local % 1440 + 1440) % 1440;
+    const int y = grid.y + (minute - calendarScroll) * grid.hourHeight / 60;
+    if (utc && y >= grid.y && y < grid.y + grid.height) {
+      for (unsigned column = 0; column < columns; ++column) {
+        if (calendarDays[column].date != isoDate(0)) continue;
+        renderer.drawLine(columnLeft(column), y, columnLeft(column + 1) - 1, y, 2, true);
+        renderer.fillRoundedRect(columnLeft(column) - 3, y - 3, 7, 7, 3, Color::Black);
+      }
+    }
+  }
+  calendarFooter(bounds);
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
+
+void WorkflowyDailyActivity::showCalendarMode() {
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyCalendarMode", StrId::STR_WORKFLOWY_CALENDAR_VIEW,
+                             std::vector<std::string>{tr(STR_WORKFLOWY_DAY), tr(STR_WORKFLOWY_WEEK), tr(STR_WORKFLOWY_SCHEDULE_VIEW)},
+                             calendarSchedule ? 2 : calendarWeek ? 1 : 0, false, true),
+                         [this](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const auto mode = std::get<OptionSelectionResult>(result.data).index;
+    {
+      RenderLock lock(*this);
+      calendarWeek = mode == 1;
+      calendarSchedule = mode == 2;
+      scheduleOffset = 0;
+      calendarDrag = {};
+    }
+    reloadCalendar();
+  });
+}
+
+void WorkflowyDailyActivity::zoomCalendar(int direction) {
+  if (calendarSchedule) return;
+  {
+    RenderLock lock(*this);
+    constexpr int scales[] = {28, 40, 64, 96, 144, 192};
+    auto found = std::lower_bound(std::begin(scales), std::end(scales), calendarHourHeight);
+    const int index = found - std::begin(scales);
+    calendarHourHeight = scales[std::clamp(index + direction, 0, static_cast<int>(std::size(scales)) - 1)];
+    const auto grid = calendarGrid();
+    calendarScroll = std::clamp(calendarScroll, 0, std::max(0, 1440 - grid.height * 60 / grid.hourHeight));
+    calendarDrag = {};
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::scrollCalendar(int direction) {
+  {
+    RenderLock lock(*this);
+    const auto grid = calendarGrid();
+    if (calendarSchedule) {
+      const int rows = std::max(1, grid.height / 72);
+      scheduleOffset = direction < 0 ? (scheduleOffset > static_cast<size_t>(rows) ? scheduleOffset - rows : 0)
+                                    : scheduleOffset + rows;
+    } else {
+      const int visibleMinutes = grid.height * 60 / grid.hourHeight;
+      const int step = std::max(30, visibleMinutes / 2 / 30 * 30);
+      calendarScroll = std::clamp(calendarScroll + direction * step, 0, std::max(0, 1440 - visibleMinutes));
+    }
+    calendarDrag = {};
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::calendarFooter(const Layout& bounds) {
+  const int right = bounds.x + bounds.width;
+  renderer.drawLine(bounds.x, bounds.footer, right, bounds.footer);
+  const auto slot = [&](CalendarControl control) { return bounds.x + (2 * static_cast<int>(control) + 1) * bounds.width / 14; };
+  const int y = bounds.footer + 23;
+  renderer.drawLine(slot(CalendarControl::Back) - 8, y, slot(CalendarControl::Back) + 8, y, 3, true);
+  renderer.drawLine(slot(CalendarControl::Back) - 8, y, slot(CalendarControl::Back) - 2, y - 6, 3, true);
+  renderer.drawLine(slot(CalendarControl::Back) - 8, y, slot(CalendarControl::Back) - 2, y + 6, 3, true);
+  const auto label = calendarSchedule ? tr(STR_WORKFLOWY_SCHEDULE_VIEW) : calendarWeek ? tr(STR_WORKFLOWY_WEEK) : tr(STR_WORKFLOWY_DAY);
+  const auto mode = renderer.truncatedText(SMALL_FONT_ID, label, bounds.width / 7 - 8);
+  renderer.drawText(SMALL_FONT_ID, slot(CalendarControl::View) - renderer.getTextWidth(SMALL_FONT_ID, mode.c_str()) / 2, y - 9,
+                    mode.c_str(), true, EpdFontFamily::BOLD);
+  renderer.drawLine(slot(CalendarControl::View) - 3, y + 11, slot(CalendarControl::View), y + 14, 2, true);
+  renderer.drawLine(slot(CalendarControl::View), y + 14, slot(CalendarControl::View) + 3, y + 11, 2, true);
+  for (const auto control : {CalendarControl::ZoomOut, CalendarControl::ZoomIn}) {
+    const int cx = slot(control);
+    const int direction = control == CalendarControl::ZoomOut ? -1 : 1;
+    for (int sign : {-1, 1}) {
+      const int tipY = y + sign * (direction > 0 ? 10 : 2);
+      const int tailY = y + sign * (direction > 0 ? 2 : 11);
+      const int stroke = calendarSchedule ? 1 : 2;
+      renderer.drawLine(cx, tailY, cx, tipY, stroke, true);
+      renderer.drawLine(cx - 4, tipY - sign * direction * 4, cx, tipY, stroke, true);
+      renderer.drawLine(cx, tipY, cx + 4, tipY - sign * direction * 4, stroke, true);
+    }
+  }
+  const auto today = tr(STR_WORKFLOWY_TODAY);
+  renderer.drawText(SMALL_FONT_ID, slot(CalendarControl::Today) - renderer.getTextWidth(SMALL_FONT_ID, today) / 2, y - 8, today);
+  const auto refresh = freeink::ui::bitmapFromIcon(icon_refresh_cw_32);
+  freeink::ui::GfxRendererTarget target(renderer);
+  target.bitmap({static_cast<int16_t>(slot(CalendarControl::Refresh) - 16), static_cast<int16_t>(y - icon_refresh_cw_32.opticalCenterY),
+                 32, 32}, refresh, freeink::ui::BitmapMode::Center);
+  renderer.drawLine(slot(CalendarControl::Add) - 9, y, slot(CalendarControl::Add) + 9, y, 3, true);
+  renderer.drawLine(slot(CalendarControl::Add), y - 9, slot(CalendarControl::Add), y + 9, 3, true);
+}
+
+void WorkflowyDailyActivity::renderSchedule(const Layout& bounds) {
+  const auto grid = calendarGrid();
+  constexpr int rowHeight = 72;
+  calendarBlocks.clear();
+  const auto& day = calendarDays.front();
+  calendarBlocks.reserve(day.items.size());
+  for (size_t i = 0; i < day.items.size(); ++i) {
+    if (const auto range = workflowy::parseTimeRange(day.items[i].title))
+      calendarBlocks.push_back({range->start, range->end, i});
+  }
+  std::stable_sort(calendarBlocks.begin(), calendarBlocks.end(), [](const auto& a, const auto& b) {
+    return a.start < b.start || (a.start == b.start && a.end < b.end);
+  });
+  const size_t visible = std::max(1, grid.height / rowHeight);
+  const size_t lastPage = calendarBlocks.empty() ? 0 : (calendarBlocks.size() - 1) / visible * visible;
+  scheduleOffset = std::min(scheduleOffset, lastPage);
+  calendarHits.clear();
+  calendarHits.reserve(visible);
+  if (calendarBlocks.empty() && day.loaded)
+    renderer.drawCenteredText(SMALL_FONT_ID, grid.y + 18, tr(STR_WORKFLOWY_EMPTY));
+  for (size_t i = scheduleOffset; i < calendarBlocks.size() && i < scheduleOffset + visible; ++i) {
+    const auto& block = calendarBlocks[i];
+    const auto& node = day.items[block.item];
+    const int y = grid.y + static_cast<int>(i - scheduleOffset) * rowHeight;
+    const auto start = workflowy::scheduleClock(block.start), end = workflowy::scheduleClock(block.end);
+    renderer.drawText(SMALL_FONT_ID, bounds.x + 4, y + 6, start.c_str(), true, EpdFontFamily::BOLD);
+    renderer.drawText(SMALL_FONT_ID, bounds.x + 4, y + 30, end.c_str());
+    const int timeWidth = renderer.getTextWidth(SMALL_FONT_ID, "12:00pm", EpdFontFamily::BOLD) + 12;
+    const int x = bounds.x + timeWidth, width = bounds.width - timeWidth - 4;
+    renderer.fillRoundedRect(x, y + 2, width, rowHeight - 7, 5, Color::White);
+    if (!node.done) renderer.fillRectDither(x, y + 2, width, rowHeight - 7,
+                                           itemPending(node.id) ? Color::DarkGray : Color::LightGray);
+    renderer.drawRoundedRect(x, y + 2, width, rowHeight - 7, 1, 5, true);
+    auto title = node.title;
+    const auto range = workflowy::parseTimeRange(title);
+    title.erase(range->begin, range->finish - range->begin);
+    calendarTextLines.clear();
+    workflowy::wrapOutlineText(std::string_view(title), width - 16, [&](std::string_view value) {
+      return renderer.getTextWidth(UI_12_FONT_ID, std::string(value).c_str());
+    }, calendarTextLines);
+    const int lineHeight = renderer.getLineHeight(UI_12_FONT_ID);
+    const int capacity = std::max(1, (rowHeight - 14) / lineHeight);
+    for (size_t line = 0; line < calendarTextLines.size() && line < static_cast<size_t>(capacity); ++line) {
+      const auto span = calendarTextLines[line];
+      const auto text = title.substr(span.begin, span.end - span.begin);
+      const int textY = y + 7 + static_cast<int>(line) * lineHeight;
+      renderer.drawText(UI_12_FONT_ID, x + 8, textY, text.c_str());
+      if (node.done) renderer.drawLine(x + 8, textY + lineHeight / 2,
+                                      x + 8 + renderer.getTextWidth(UI_12_FONT_ID, text.c_str()),
+                                      textY + lineHeight / 2);
+    }
+    calendarHits.push_back({node.id, 0, bounds.x, y, bounds.width, rowHeight,
+                           block.start, block.end});
+  }
+}
