+namespace {
+constexpr char API_URL[] = "https://workflowy.com/api/v1/nodes";
+constexpr char DEFAULT_DESTINATION[] = "3dbd4508b236";
+constexpr char DEST_FILE[] = "/.crashink/workflowy.destination";
+constexpr size_t DEST_MAX = 128;
+
+}  // namespace
+
+namespace workflowy {
+std::string readSetting(const char* path, size_t limit) {
+  FsFile file;
+  const auto backup = std::string(path) + ".bak";
+  if (!Storage.exists(path) && Storage.exists(backup.c_str())) Storage.rename(backup.c_str(), path);
+  if (!Storage.openFileForRead("WF", path, file) || file.size() > limit) return {};
+  std::string value(file.size(), '\0');
+  if (file.read(reinterpret_cast<uint8_t*>(value.data()), value.size()) != static_cast<int>(value.size())) return {};
+  if (value.find_first_of("\r\n") != std::string::npos || value.find('\0') != std::string::npos) return {};
+  return value;
+}
+
+bool writeSetting(const char* path, const std::string& value) {
+  if (value.find_first_of("\r\n") != std::string::npos || value.find('\0') != std::string::npos) return false;
+  Storage.mkdir("/.crashink");
+  const auto temp = std::string(path) + ".tmp", backup = std::string(path) + ".bak";
+  if (!Storage.exists(path) && Storage.exists(backup.c_str()) && !Storage.rename(backup.c_str(), path)) return false;
+  FsFile file = Storage.open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC);
+  if (!file) return false;
+  const bool written = file.write(reinterpret_cast<const uint8_t*>(value.data()), value.size()) == value.size() && file.sync();
+  file.close();
+  if (!written) return false;
+  const bool hadPrevious = Storage.exists(path);
+  if (Storage.exists(backup.c_str()) && !Storage.remove(backup.c_str())) return false;
+  if (hadPrevious && !Storage.rename(path, backup.c_str())) return false;
+  if (!Storage.rename(temp.c_str(), path)) {
+    if (hadPrevious) Storage.rename(backup.c_str(), path);
+    return false;
+  }
+  if (hadPrevious) Storage.remove(backup.c_str());
+  return true;
+}
+
+}  // namespace workflowy
+
+namespace {
+using workflowy::KEY_FILE;
+using workflowy::KEY_MAX;
+using workflowy::readSetting;
+using workflowy::writeSetting;
+
+std::string oneLine(std::string value) {
+  for (char& ch : value)
+    if (ch == '\n' || ch == '\r' || ch == '\t') ch = ' ';
+  // Preserve the full text as one bullet and escape Markdown syntax.
+  std::string escaped;
+  for (const char ch : value) {
+    if (ch == '\\' || ch == '*' || ch == '_' || ch == '[' || ch == ']' ||
+        ch == '-' || ch == '<' || ch == '>' || ch == '#' || ch == '`' || ch == '~') escaped += '\\';
+    escaped += ch;
+  }
+  return escaped;
+}
+// Local receipts identify the exact exported content and destination.
+uint64_t receiptHash(const std::string& value, uint64_t hash = 14695981039346656037ULL) {
+  for (unsigned char ch : value) hash = (hash ^ ch) * 1099511628211ULL;
+  return hash;
+}
+}  // namespace
+
+WorkflowyShareActivity::WorkflowyShareActivity(GfxRenderer& renderer, MappedInputManager& input, size_t index,
+                                               int colorFilter)
+    : Activity("WorkflowyShare", renderer, input), index(index), colorFilter(colorFilter) {}
+
+WorkflowyShareActivity::~WorkflowyShareActivity() = default;
+
+void WorkflowyShareActivity::onExit() {
+  client.reset();
+  if (ownsWifi) {
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+  }
+  Activity::onExit();
+}
+
+void WorkflowyShareActivity::menu() {
+  std::vector<std::string> options{tr(STR_WORKFLOWY_BOTH), tr(STR_WORKFLOWY_QUOTE), tr(STR_WORKFLOWY_NOTE)};
+  if (index != SIZE_MAX) options.emplace_back(tr(STR_WORKFLOWY_EDIT_NOTE));
+  options.emplace_back(tr(STR_WORKFLOWY_API_KEY));
+  options.emplace_back(tr(STR_WORKFLOWY_DESTINATION));
+  step = Step::Waiting;
+  startActivityForResult(
+      std::make_unique<OptionSelectionActivity>(renderer, mappedInput, "WorkflowyActions", StrId::STR_SEND_TO_WORKFLOWY,
+                                                std::move(options), 0, false, true),
+      [this](const ActivityResult& result) {
+        if (result.isCancelled) {
+          finish();
+          return;
+        }
+        const auto selected = std::get<OptionSelectionResult>(result.data).index;
+        if (selected < 3) {
+          content = static_cast<Content>(selected);
+          if (content == Content::Note && index != SIZE_MAX &&
+              (!CLIPPINGS.clippingAt(index) || !CLIPPINGS.clippingAt(index)->noteLength)) {
+            complete(tr(STR_WORKFLOWY_NO_NOTES));
+            return;
+          }
+          credential = readSetting(KEY_FILE, KEY_MAX);
+          destination = readSetting(DEST_FILE, DEST_MAX);
+          sendAfterKey = credential.empty();
+          step = sendAfterKey ? Step::Key : Step::Connect;
+        } else if (index != SIZE_MAX && selected == 3) {
+          step = Step::Note;
+        } else {
+          step = selected == (index == SIZE_MAX ? 3 : 4) ? Step::Key : Step::Destination;
+        }
+      });
+}
+
+void WorkflowyShareActivity::editSetting(bool apiKey) {
+  step = Step::Waiting;
+  const auto title = apiKey ? StrId::STR_WORKFLOWY_API_KEY : StrId::STR_WORKFLOWY_DESTINATION;
+  startActivityForResult(
+      std::make_unique<KeyboardEntryActivity>(renderer, mappedInput, I18n::getInstance().get(title),
+                                             apiKey ? "" : readSetting(DEST_FILE, DEST_MAX),
+                                             apiKey ? KEY_MAX : DEST_MAX, apiKey ? InputType::Password : InputType::Text),
+      [this, apiKey](const ActivityResult& result) {
+        if (result.isCancelled) {
+          sendAfterKey = false;
+          step = Step::Menu;
+          return;
+        }
+        const auto& value = std::get<KeyboardResult>(result.data).text;
+        if (!writeSetting(apiKey ? KEY_FILE : DEST_FILE, value)) {
+          complete(tr(STR_WORKFLOWY_SAVE_FAILED));
+          return;
+        }
+        if (apiKey) credential = value;
+        step = sendAfterKey && !credential.empty() ? Step::Connect : Step::Menu;
+        sendAfterKey = false;
+      });
+}
+
+void WorkflowyShareActivity::editNote() {
+  std::string note;
+  if (!CLIPPINGS.readClippingNote(index, note)) {
+    complete(tr(STR_WORKFLOWY_SAVE_FAILED));
+    return;
+  }
+  step = Step::Waiting;
+  startActivityForResult(
+      std::make_unique<KeyboardEntryActivity>(renderer, mappedInput, tr(STR_WORKFLOWY_EDIT_NOTE), std::move(note),
+                                             CLIPPING_NOTE_MAX, InputType::Text),
+      [this](const ActivityResult& result) {
+        if (!result.isCancelled && !CLIPPINGS.setClippingNote(index, std::get<KeyboardResult>(result.data).text)) {
+          complete(tr(STR_WORKFLOWY_SAVE_FAILED));
+          return;
+        }
+        step = Step::Menu;
+      });
+}
+
+void WorkflowyShareActivity::connect() {
+  next = index == SIZE_MAX ? 0 : index;
+  if (!loadReceipts()) {
+    complete(tr(STR_WORKFLOWY_SAVE_FAILED));
+    return;
+  }
+  if (hasActiveStationWifiConnection()) {
+    step = Step::Send;
+    return;
+  }
+  ownsWifi = true;
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput),
+                         [this](const ActivityResult& result) {
+                           const auto* wifi = std::get_if<WifiResult>(&result.data);
+                           if (result.isCancelled || !wifi || !wifi->connected)
+                             complete(tr(STR_WORKFLOWY_NETWORK_FAILED));
+                           else
+                             step = Step::Send;
+                         });
+}
+
+bool WorkflowyShareActivity::loadReceipts() {
+  char path[64];
+  snprintf(path, sizeof(path), "/.crashink/.workflowy/%016llx.sent",
+           static_cast<unsigned long long>(receiptHash(CLIPPINGS.getBookFilePath())));
+  sentFile = path;
+  Storage.mkdir("/.crashink");
+  Storage.mkdir("/.crashink/.workflowy");
+  if (!Storage.exists(sentFile.c_str())) return true;
+  FsFile file;
+  if (!Storage.openFileForRead("WF", sentFile, file)) return false;
+  uint64_t receipt;
+  while (file.read(&receipt, sizeof(receipt)) == sizeof(receipt)) receipts.push_back(receipt);
+  std::sort(receipts.begin(), receipts.end());
+  return true;
+}
+
+bool WorkflowyShareActivity::recordReceipt(uint64_t receipt) {
+  FsFile file = Storage.open(sentFile.c_str(), O_WRONLY | O_CREAT);
+  if (!file || !file.seek(file.size() / sizeof(receipt) * sizeof(receipt))) return false;
+  return file.write(&receipt, sizeof(receipt)) == sizeof(receipt) && file.sync();
+}
+
+void WorkflowyShareActivity::sendNext() {
+  const size_t end = index == SIZE_MAX ? CLIPPINGS.clippingCount() : index + 1;
+  if (next >= end) {
+    complete(sent.load() ? tr(STR_WORKFLOWY_SENT) :
+             alreadySent ? tr(STR_WORKFLOWY_ALREADY_SENT) : tr(STR_WORKFLOWY_NO_NOTES));
+    return;
+  }
+  const size_t current = next++;
+  const auto* clipping = CLIPPINGS.clippingAt(current);
+  if (!clipping || (colorFilter && static_cast<int>(clipping->color) + 1 != colorFilter)) return;
+
+  std::string note, quote, chapter;
+  if ((content != Content::Quote && !CLIPPINGS.readClippingNote(current, note)) ||
+      (content != Content::Note && !CLIPPINGS.readClippingText(current, quote))) {
+    complete(tr(STR_WORKFLOWY_READ_FAILED));
+    return;
+  }
+  if (note.empty() && (content == Content::Note || (content == Content::Both && index == SIZE_MAX))) {
+    return;
+  }
+  CLIPPINGS.readChapterTitle(current, chapter);
+  std::string name = oneLine(content == Content::Note ? note : quote);
+  std::string citation;
+  const std::string* parts[] = {&CLIPPINGS.getBookTitle(), &CLIPPINGS.getBookAuthor(), &chapter};
+  for (const auto* part : parts) {
+    if (part->empty()) continue;
+    if (!citation.empty()) citation += " — ";
+    citation += oneLine(*part);
+  }
+  // Workflowy parses double newlines as child bullets in a single create call.
+  if (!citation.empty()) name += "\n\n📖 " + citation;
+  if (content == Content::Both && !note.empty()) name += "\n\n📝 " + oneLine(note);
+
+  JsonDocument request;
+  request["parent_id"] = destination.empty() ? DEFAULT_DESTINATION : destination;
+  request["name"] = name;
+  request["position"] = "bottom";
+  std::string encoded;
+  if (!serializeJson(request, encoded) || request.overflowed()) {
+    complete(tr(STR_WORKFLOWY_SEND_FAILED));
+    return;
+  }
+  auto receipt = receiptHash(encoded, receiptHash(credential));
+  receipt = (receipt ^ clipping->spineIndex) * 1099511628211ULL;
+  receipt = (receipt ^ clipping->startPage) * 1099511628211ULL;
+  receipt = (receipt ^ clipping->startWordIndex) * 1099511628211ULL;
+  if (std::binary_search(receipts.begin(), receipts.end(), receipt)) {
+    alreadySent = true;
+    return;
+  }
+  if (!client) {
+    // Certificate validation needs an initialized system clock, even on an RTC board.
+    if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) {
+      complete(tr(STR_WORKFLOWY_CLOCK_FAILED));
+      return;
+    }
+    client = std::make_unique<freeink::SecureHttpClient>();
+    client->setCACert(WorkflowyRoot);
+    client->setTimeout(12000);
+    client->setReuse(false);  // Do not retry a POST whose response was lost.
+    client->setUserAgent("CrASHInk/Workflowy");
+  }
+  if (!client->begin(API_URL)) {
+    complete(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    return;
+  }
+  client->addHeader("Authorization", "Bearer " + credential);
+  client->addHeader("Content-Type", "application/json");
+  const int status = client->sendRequest("POST", reinterpret_cast<const uint8_t*>(encoded.data()), encoded.size(),
+                                         [](const uint8_t*, size_t) { return true; });
+  if (status < 200 || status >= 300) {
+    complete(status == 401 || status == 403 ? tr(STR_WORKFLOWY_AUTH_FAILED)
+             : status <= 0 ? tr(STR_WORKFLOWY_NETWORK_FAILED) : tr(STR_WORKFLOWY_SEND_FAILED));
+    return;
+  }
+  ++sent;
+  if (!recordReceipt(receipt)) {
+    complete(tr(STR_WORKFLOWY_RECEIPT_FAILED));
+    return;
+  }
+  receipts.insert(std::lower_bound(receipts.begin(), receipts.end(), receipt), receipt);
+  requestUpdate();
+}
+
+void WorkflowyShareActivity::complete(const char* message) {
+  client.reset();
+  if (ownsWifi) {
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+    ownsWifi = false;
+  }
+  {
+    RenderLock lock(*this);
+    summary = message;
+    step = Step::Done;
+  }
+  requestUpdate();
+}
+
+void WorkflowyShareActivity::loop() {
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back) || TouchHeaderBackButton::wasTapped(mappedInput, renderer)) {
+    finish();
+    return;
+  }
+  switch (step) {
+    case Step::Menu: menu(); break;
+    case Step::Key: editSetting(true); break;
+    case Step::Destination: editSetting(false); break;
+    case Step::Note: editNote(); break;
+    case Step::Connect: connect(); break;
+    case Step::Send: sendNext(); break;
+    case Step::Done:
+      if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) finish();
+      break;
+    case Step::Waiting: break;
+  }
+}
+
+void WorkflowyShareActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+  TouchHeaderBackButton::drawCompact(renderer, tr(STR_SEND_TO_WORKFLOWY), false, true);
+  const int middle = renderer.getScreenHeight() / 2;
+  const auto message = renderer.truncatedText(UI_12_FONT_ID, summary.empty() ? tr(STR_WORKFLOWY_SENDING) : summary.c_str(),
+                                              renderer.getScreenWidth() - 24);
+  renderer.drawCenteredText(UI_12_FONT_ID, middle - 16, message.c_str());
+  char counts[48];
+  snprintf(counts, sizeof(counts), "%s %u", tr(STR_WORKFLOWY_SENT), sent.load());
+  renderer.drawCenteredText(UI_10_FONT_ID, middle + 18, counts);
+  renderer.displayBuffer();
+}
