+
+class WorkflowyShareActivity final : public Activity {
+ public:
+  // SIZE_MAX sends the current book's clippings. Color follows its list filter.
+  WorkflowyShareActivity(GfxRenderer& renderer, MappedInputManager& input, size_t index, int colorFilter = 0);
+  ~WorkflowyShareActivity() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  void onExit() override;
