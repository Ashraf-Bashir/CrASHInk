+  }
+  online = hasActiveStationWifiConnection();
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::onExit() {
+  for (const auto& save : saves) {
+    if (!save->started) break;
+    while (!save->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+  }
+  saves.clear();
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  if (scanningWifi) WiFi.scanDelete();
+  if (ownsWifi) WiFi.disconnect(false, false);
+  // The fetch owns a TLS session. Wait for its cleanup before the Library can open.
+  while (prefetch && !prefetch->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+  prefetch.reset();
+  if (ownsWifi) WiFi.mode(WIFI_OFF);
+  Activity::onExit();
+}
