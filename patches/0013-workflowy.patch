+  unsigned generation = 0;
+  unsigned long rootCheckedAt = 0;
+  unsigned long nextPrefetchAt = 0;
+  void pollPrefetch();
+  static void prefetchTask(void* argument);
+  size_t paintedPage = 0;
+  struct Placement {
+    size_t row, firstLine, lineCount;
+    int top, bottom;
+  };
+  std::vector<workflowy::TextSpan> outlineLines;
+  std::vector<Placement> placements;
+  std::vector<size_t> pageStarts;
