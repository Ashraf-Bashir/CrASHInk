+void WorkflowyDailyActivity::showErrorDetails() {
+  if (!isErrorNotice(message)) return;
+  std::string details;
+  if (message == tr(STR_WORKFLOWY_OUTBOX_ACCOUNT) || message == tr(STR_WORKFLOWY_SAVE_FAILED)) {
+    details = tr(STR_WORKFLOWY_LOCAL_SAVE_DETAILS);
+  } else if (!online && lastStatus <= 0) {
+    details = tr(STR_WORKFLOWY_NO_WIFI_DETAILS);
+  } else if (message == tr(STR_WORKFLOWY_CLOCK_FAILED) || lastStatus == -2) {
+    details = tr(STR_WORKFLOWY_CLOCK_DETAILS);
+  } else if (lastStatus >= 400) {
+    details = "HTTP " + std::to_string(lastStatus);
+    if (lastStatus == 401 || lastStatus == 403) details += " · " + std::string(tr(STR_WORKFLOWY_AUTH_FAILED));
+    if (lastStatus == 429) details += " · " + std::string(tr(STR_WORKFLOWY_RATE_LIMIT));
+  } else if (lastTransport != ESP_OK || lastStatus == -5) {
+    details = esp_err_to_name(lastStatus == -5 ? ESP_ERR_NO_MEM : lastTransport);
+  } else if (lastStatus == -3) {
+    details = tr(STR_WORKFLOWY_RESPONSE_DETAILS);
+  }
+  if (!lastServerError.empty()) {
+    if (!details.empty()) details += " · ";
+    details += lastServerError;
+  }
+  startActivityForResult(std::make_unique<WorkflowyErrorDetails>(renderer, mappedInput, message, std::move(details)),
+                         [](const ActivityResult&) {});
+}
+
+void WorkflowyDailyActivity::connect() {
+  if (workflowy::shareInProgress()) return;
+  if (credential.empty()) return editKey();
+  if (hasActiveStationWifiConnection()) {
+    {
+      RenderLock lock(*this);
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+    return;
+  }
+  if (!WIFI_STORE.getCredentialCount()) return showWifiPicker();
+  WiFi.persistent(false);
+  const auto previousMode = WiFi.getMode();
+  if (!WiFi.mode(WIFI_STA)) {
+    step = Step::Ready;
+    return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  }
+  ownsWifi = ownsWifi || previousMode == WIFI_OFF;
+  WiFi.setAutoReconnect(false);
+  WiFi.setScanMethod(WIFI_ALL_CHANNEL_SCAN);
+  WiFi.setSortMethod(WIFI_CONNECT_AP_BY_SIGNAL);
+  savedWifiCandidates.clear();
+  scannedSavedWifi = false;
+  const auto last = WIFI_STORE.getLastConnectedSsid();
+  if (!last.empty() && WIFI_STORE.hasSavedCredential(last)) trySavedWifi(last);
+  else scanSavedWifi();
+  {
+    RenderLock lock(*this);
+    connectingWifi = true;
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::trySavedWifi(const std::string& ssid) {
+  const auto saved = WIFI_STORE.findCredential(ssid);
+  if (saved) {
+    const auto* password = saved->password.empty() ? nullptr : saved->password.c_str();
+    WiFi.begin(saved->ssid.c_str(), password);
+  }
+  wifiStartedAt = millis();
+}
+
+void WorkflowyDailyActivity::scanSavedWifi() {
+  WiFi.disconnect(false, false);
+  WiFi.scanDelete();
+  scanningWifi = true;
+  scannedSavedWifi = true;
+  wifiStartedAt = millis();
+  WiFi.scanNetworks(true);
+}
+
+void WorkflowyDailyActivity::pollWifiConnection() {
+  if (!connectingWifi || tracking) return;
+  if (hasActiveStationWifiConnection()) {
+    if (scanningWifi) WiFi.scanDelete();
+    scanningWifi = false;
+    savedWifiCandidates.clear();
+    const std::string connectedSsid = WiFi.SSID().c_str();
+    if (connectedSsid != WIFI_STORE.getLastConnectedSsid()) WIFI_STORE.setLastConnectedSsid(connectedSsid);
+    {
+      RenderLock lock(*this);
+      connectingWifi = false;
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+    return;
+  }
+  if (scanningWifi) {
+    const int count = WiFi.scanComplete();
+    if (count == WIFI_SCAN_RUNNING && millis() - wifiStartedAt < 10000) return;
+    const auto last = WIFI_STORE.getLastConnectedSsid();
+    for (int i = 0; i < count && savedWifiCandidates.size() < WIFI_STORE.getCredentialCount(); ++i) {
+      const std::string ssid = WiFi.SSID(i).c_str();
+      if (ssid != last && WIFI_STORE.hasSavedCredential(ssid) &&
+          std::find(savedWifiCandidates.begin(), savedWifiCandidates.end(), ssid) == savedWifiCandidates.end()) {
+        savedWifiCandidates.push_back(ssid);
+      }
+    }
+    WiFi.scanDelete();
+    scanningWifi = false;
+    if (savedWifiCandidates.empty()) {
+      wifiStartedAt = millis() - SAVED_WIFI_TIMEOUT;
+    }
+  } else if (millis() - wifiStartedAt < SAVED_WIFI_TIMEOUT) {
+    return;
+  }
+  if (!scannedSavedWifi) return scanSavedWifi();
+  if (!savedWifiCandidates.empty()) {
+    const auto next = std::move(savedWifiCandidates.front());
+    savedWifiCandidates.erase(savedWifiCandidates.begin());
+    WiFi.disconnect(false, false);
+    return trySavedWifi(next);
+  }
+  if (tracking || !saves.empty()) return;
+  {
+    RenderLock lock(*this);
+    connectingWifi = false;
+  }
+  if (ownsWifi) {
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+    ownsWifi = false;
+  }
+  showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+}
+
+void WorkflowyDailyActivity::showWifiPicker() {
+  const bool hadConnection = hasActiveStationWifiConnection();
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput, true),
+                         [this, hadConnection](const ActivityResult& result) {
+    const auto* wifi = std::get_if<WifiResult>(&result.data);
+    if (result.isCancelled || !wifi || !wifi->connected) {
+      step = Step::Ready;
+      return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    }
+    ownsWifi = ownsWifi || !hadConnection;
+    {
+      RenderLock lock(*this);
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+  });
+}
+
+void WorkflowyDailyActivity::refresh(bool configure) {
+  if (connectingWifi) return;
+  if (configure) {
+    if (!saves.empty()) return;
+    startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                               renderer, mappedInput, "WorkflowyConnection", StrId::STR_SYSTEM_NETWORK_SYNC,
+                               std::vector<std::string>{tr(STR_WIFI_NETWORKS), tr(STR_WORKFLOWY_API_KEY)}, 0, false, true),
+                           [this](const ActivityResult& result) {
+      if (result.isCancelled) return;
+      if (std::get<OptionSelectionResult>(result.data).index == 0) showWifiPicker();
+      else editKey();
+    });
+    return;
+  }
+  if (hasActiveStationWifiConnection() && !credential.empty()) {
+    {
+      RenderLock lock(*this);
+      for (auto& row : rows) if (row.id != zoomId && row.leaf) row.leaf = false;
+    }
+    loadDay();
+  } else {
+    step = Step::Start;
+  }
+}
+
+void WorkflowyDailyActivity::editKey() {
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                             renderer, mappedInput, tr(STR_WORKFLOWY_API_KEY), "", workflowy::KEY_MAX, InputType::Password),
+                         [this](const ActivityResult& result) {
+    step = Step::Ready;
+    if (result.isCancelled) return;
+    const auto& key = std::get<KeyboardResult>(result.data).text;
+    if (key.empty() || !workflowy::writeSetting(workflowy::KEY_FILE, key)) {
+      showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    credential = key;
+    step = Step::Start;
+  });
+}
+
+void WorkflowyDailyActivity::recordServerError(int status, int transport, const std::string& errorBody,
+                                                 const std::string& key) {
+  lastStatus = status;
+  lastTransport = transport;
+  lastServerError.clear();
+  if (!errorBody.empty()) {
+    JsonDocument error;
+    if (!deserializeJson(error, errorBody)) {
+      const char* reason = error["message"] | "";
+      if (!*reason) reason = error["error"]["message"] | "";
+      if (!*reason) reason = error["error"] | "";
+      if (!*reason) reason = error["code"] | "";
+      lastServerError = plainTitle(reason);
+      if (!key.empty()) {
+        for (size_t at = 0; (at = lastServerError.find(key, at)) != std::string::npos; at += 3) {
+          lastServerError.replace(at, key.size(), "***");
+        }
+      }
+    }
+  }
+}
+
+void WorkflowyDailyActivity::saveTask(void* argument) {
+  auto& save = *static_cast<Save*>(argument);
+  if (save.work) save.work(save);
+  else save.status = requestWithKey(save.key, save.method, save.path, save.body,
+                               save.captureResponse ? save.response.data() : nullptr,
+                               &save.received, save.response.size(), nullptr, nullptr, &save.transport, &save.error);
+  save.ready.store(true, std::memory_order_release);
+  vTaskDelete(nullptr);
+}
+
+bool WorkflowyDailyActivity::itemPending(const std::string& id) const {
+  return !id.empty() &&
+         (id == pendingDelete || std::any_of(saves.begin(), saves.end(), [&](const auto& save) {
+           return save->item == id;
+         }));
+}
+
+void WorkflowyDailyActivity::refreshOfflineQueuePreview() {
+  std::vector<std::string> preview;
+  JsonDocument document;
+  if (!outbox.empty() && !deserializeJson(document, outbox)) {
+    for (const auto& item : document["items"].as<JsonArray>()) {
+      const auto title = plainTitle(item["name"] | "");
+      preview.push_back(title.substr(0, 120));
+    }
+  }
+  RenderLock lock(*this);
+  offlineQueuePreview = std::move(preview);
+}
+
+size_t WorkflowyDailyActivity::pendingOperationsCount() const {
+  const bool sendingCapture = pendingCount && std::any_of(saves.begin(), saves.end(), [](const auto& save) {
+    return save->fromOutbox;
+  });
+  return saves.size() + pendingCount - sendingCapture + !requestedBranch.empty();
+}
+
+void WorkflowyDailyActivity::showPendingOperations() {
+  {
+    RenderLock lock(*this);
+    queueVisible = !queueVisible;
+    queuePage = 0;
+    if (!queueVisible) offlineQueuePreview.clear();
+    tracking = dragging = false;
+  }
+  if (queueVisible) refreshOfflineQueuePreview();
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::queueSave(std::string path, std::string body, bool capture,
+                                       std::function<void(const Save&)> finish, const char* method,
+                                       StrId label, std::string item, std::function<void(Save&)> work) {
+  if (saves.size() >= MAX_SAVE_QUEUE) {
+    showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+    return false;
+  }
+  auto save = makeUniqueNoThrow<Save>();
+  if (!save) {
+    recordServerError(-5, ESP_ERR_NO_MEM, {}, credential);
+    showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    return false;
+  }
+  save->key = credential;
+  save->path = std::move(path);
+  save->body = std::move(body);
+  save->captureResponse = capture;
+  save->finish = std::move(finish);
+  save->method = method;
+  save->label = label;
+  save->item = std::move(item);
+  save->work = std::move(work);
+  const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& row) { return row.id == save->item; });
+  if (node != rows.end()) save->title = node->title.substr(0, 120);
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  {
+    RenderLock lock(*this);
+    saves.push_back(std::move(save));
+    message = nullptr;
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::serviceBackgroundWork() {
+  if (saves.empty()) return;
+  for (auto& item : saves) {
+    auto& save = *item;
+    if (save.ready.load(std::memory_order_acquire)) continue;
+    if (save.started || (prefetch && !prefetch->ready.load(std::memory_order_acquire))) return;
+    prefetch.reset();
+    save.started = true;
+    if (xTaskCreate(saveTask, "wf-save", 8192, &save, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+      save.status = -5;
+      save.transport = ESP_ERR_NO_MEM;
+      save.ready.store(true, std::memory_order_release);
+    }
+    return;
+  }
+}
+
+bool WorkflowyDailyActivity::pollSave() {
+  serviceBackgroundWork();
+  if (saves.empty() || !saves.front()->ready.load(std::memory_order_acquire)) return false;
+  std::unique_ptr<Save> completed;
+  {
+    RenderLock lock(*this);
+    completed = std::move(saves.front());
+    saves.pop_front();
+    layoutDirty = true;
+  }
+  recordServerError(completed->status, completed->transport, completed->error, completed->key);
+  completed->finish(*completed);
+  if (leaveAfterSave && saves.empty()) {
+    leaveAfterSave = false;
+    if (!queueVisible && completed->status >= 200 && completed->status < 300) back();
+  }
+  requestUpdate();
+  return true;
+}
+
+int WorkflowyDailyActivity::requestWithKey(const std::string& key, const char* method, const std::string& path,
+                                          const std::string& body, uint8_t* response, size_t* received,
+                                          size_t capacity, HeapByteBuffer* growable,
+                                          const std::atomic<bool>* cancel, int* transport,
+                                          std::string* serverError) {
+  if (cancel && cancel->load(std::memory_order_relaxed)) return -4;
+  if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) {
+    return -2;
+  }
+  struct Response {
+    uint8_t* buffer;
+    size_t* used;
+    size_t capacity;
+    HeapByteBuffer* growable;
+    const std::atomic<bool>* cancel;
+    std::string* serverError;
+    bool overflow = false;
+  } sink{response, received, capacity, growable, cancel, serverError};
+
+  const auto url = std::string(API) + path;
+  esp_http_client_config_t config{};
+  config.url = url.c_str();
+  config.method = strcmp(method, "GET") == 0 ? HTTP_METHOD_GET
+                  : strcmp(method, "DELETE") == 0 ? HTTP_METHOD_DELETE
+                                                  : HTTP_METHOD_POST;
+  config.crt_bundle_attach = esp_crt_bundle_attach;
+  config.user_agent = "CrASHInk/Workflowy";
+  config.timeout_ms = cancel ? 5000 : 12000;
+  config.disable_auto_redirect = true;
+  config.max_authorization_retries = -1;
+  config.user_data = &sink;
+  config.event_handler = [](esp_http_client_event_t* event) -> esp_err_t {
+    auto& target = *static_cast<Response*>(event->user_data);
+    if (target.cancel && target.cancel->load(std::memory_order_relaxed)) return ESP_FAIL;
+    if (event->event_id != HTTP_EVENT_ON_DATA || event->data_len <= 0) return ESP_OK;
+    const auto length = static_cast<size_t>(event->data_len);
+    if (target.serverError && esp_http_client_get_status_code(event->client) >= 400) {
+      const size_t available = MAX_ERROR_BODY - target.serverError->size();
+      target.serverError->append(static_cast<const char*>(event->data), std::min(available, length));
+      return ESP_OK;
+    }
+    if (!target.buffer && !target.growable) return ESP_OK;
+    const auto needed = *target.used + length;
+    if (!target.overflow && target.growable && needed > target.capacity && needed <= MAX_RESPONSE) {
+      const size_t expanded = std::max(needed, std::min(MAX_RESPONSE, std::max<size_t>(4096, target.capacity * 2)));
+      auto* resized = static_cast<uint8_t*>(
+          heap_caps_realloc(target.buffer, expanded, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+      if (resized) {
+        target.growable->release();
+        target.growable->reset(resized);
+        target.buffer = resized;
+        target.capacity = expanded;
+      }
+    }
+    if (target.overflow || needed > target.capacity) {
+      target.overflow = true;
+      return ESP_ERR_NO_MEM;
+    }
+    memcpy(target.buffer + *target.used, event->data, length);
+    *target.used += length;
+    return ESP_OK;
+  };
+
+  auto client = esp_http_client_init(&config);
+  if (!client) {
+    if (transport) *transport = ESP_ERR_NO_MEM;
+    return 0;
+  }
+  const auto authorization = "Bearer " + key;
+  auto result = esp_http_client_set_header(client, "Authorization", authorization.c_str());
+  if (result == ESP_OK && !body.empty()) {
+    result = esp_http_client_set_header(client, "Content-Type", "application/json");
+    if (result == ESP_OK) result = esp_http_client_set_post_field(client, body.data(), body.size());
+  }
+  if (result == ESP_OK && config.method == HTTP_METHOD_POST && body.empty()) {
+    result = esp_http_client_set_header(client, "Content-Length", "0");
+  }
+  if (result == ESP_OK) result = esp_http_client_perform(client);
+  const int status = esp_http_client_get_status_code(client);
+  const bool complete = esp_http_client_is_complete_data_received(client);
+  if (result != ESP_OK || status >= 400) {
+    LOG_ERR("WF", "Workflowy %s failed: transport=%s HTTP=%d", method, esp_err_to_name(result), status);
+  }
+  esp_http_client_cleanup(client);
+  if (transport) {
+    *transport = sink.overflow ? ESP_ERR_NO_MEM
+                 : result == ESP_OK && !complete && (response || growable) ? ESP_ERR_HTTP_INCOMPLETE_DATA
+                                                                          : result;
+  }
+  if (cancel && cancel->load(std::memory_order_relaxed)) return -4;
+  if (status >= 400) return status;
+  return result == ESP_OK && !sink.overflow && (complete || (!response && !growable)) ? status : 0;
+}
+
+int WorkflowyDailyActivity::fetchChildren(const std::string& key, const std::string& parent, unsigned depth,
+                                         std::vector<Node>& result, const std::atomic<bool>* cancel, int* transport) {
+  HeapByteBuffer response;
+  size_t received = 0;
+  const int status = requestWithKey(key, "GET", "?parent_id=" + parent, {}, nullptr, &received, 0, &response, cancel, transport);
+  if (status == 404 && depth == 0) return 200;
+  if (status != 200) return status;
+  if (!response) return -3;
+  JsonDocument filter;
+  auto node = filter["nodes"][0];
+  node["id"] = true;
+  node["name"] = true;
+  node["priority"] = true;
+  node["completed"] = true;
+  node["data"]["layoutMode"] = true;
+  ResponseAllocator allocator;
+  JsonDocument doc(&allocator);
+  if (deserializeJson(doc, response.get(), received, DeserializationOption::Filter(filter)) || !doc["nodes"].is<JsonArray>()) {
+    return -3;
+  }
+  const auto nodes = doc["nodes"].as<JsonArrayConst>();
+  if (nodes.size() > MAX_ROWS) {
+    return -3;
+  }
+  result.reserve(nodes.size());
+  for (const auto value : nodes) {
+    std::string id = value["id"] | "";
+    if (id.empty() || id.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) continue;
+    result.push_back({std::move(id), plainTitle(value["name"] | ""), depth, value["priority"] | 0,
+                      strcmp(value["data"]["layoutMode"] | "", "todo") == 0, value["completed"] | false});
+  }
+  std::stable_sort(result.begin(), result.end(), [](const Node& a, const Node& b) { return a.priority < b.priority; });
+  return 200;
+}
+
+void WorkflowyDailyActivity::syncNode(const Node& updated) {
+  for (auto& view : viewStack) {
+    for (auto& copy : view.rows) {
+      if (copy.id != updated.id) continue;
+      copy.done = updated.done;
+      copy.todo = updated.todo;
+      copy.title = updated.title;
+    }
+  }
+}
+
+void WorkflowyDailyActivity::appendChild(std::vector<Node>& outline, const std::string& parent, Node node) {
+  if (parent.empty()) {
+    if (outline.size() < MAX_ROWS) outline.push_back(std::move(node));
+    return;
+  }
+  auto owner = std::find_if(outline.begin(), outline.end(), [&](const Node& row) { return row.id == parent; });
+  if (owner == outline.end()) return;
+  auto end = owner + 1;
+  const bool cached = owner->leaf || (end != outline.end() && end->depth > owner->depth);
+  owner->leaf = false;
+  owner->childrenConfirmed = true;
+  if (!cached || outline.size() == MAX_ROWS) return;
+  node.depth = owner->depth + 1;
+  while (end != outline.end() && end->depth > owner->depth) ++end;
+  outline.insert(end, std::move(node));
+}
+
+void WorkflowyDailyActivity::removeNode(const std::string& id, const bool moveToCurrentDay) {
+  const bool leaveZoom = id == zoomId;
+  {
+    RenderLock lock(*this);
+    std::vector<Node> movedBranch;
+    const auto removeFrom = [&](std::vector<Node>& outline) {
+      const auto first = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (first == outline.end()) return;
+      const auto depth = first->depth;
+      auto end = first + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      if (moveToCurrentDay && end - first > static_cast<ptrdiff_t>(movedBranch.size())) {
+        movedBranch.assign(first, end);
+        for (auto& node : movedBranch) node.depth -= depth;
+      }
+      if (depth > 0) {
+        auto parent = first;
+        while (parent != outline.begin() && (--parent)->depth >= depth) {}
+        if (parent + 1 == first && (end == outline.end() || end->depth < depth)) {
+          parent->leaf = true;
+          parent->childrenConfirmed = false;
+        }
+      }
+      outline.erase(first, end);
+    };
+    removeFrom(rows);
+    for (auto& view : viewStack) removeFrom(view.rows);
+    if (moveToCurrentDay && !movedBranch.empty()) {
+      auto& dailyRows = viewStack.empty() ? rows : viewStack.front().rows;
+      if (dailyRows.size() + movedBranch.size() <= MAX_ROWS)
+        dailyRows.insert(dailyRows.end(), std::make_move_iterator(movedBranch.begin()),
+                         std::make_move_iterator(movedBranch.end()));
+    }
+    layoutDirty = true;
+    message = nullptr;
+  }
+  if (leaveZoom) back();
+  else requestUpdate();
+}
+
+// Reconcile one ordered sibling list, retaining each matching node's cached subtree.
+bool WorkflowyDailyActivity::replaceSiblings(std::vector<Node>& outline, const std::string& parent,
+                                            const std::vector<Node>& siblings) {
+  auto first = outline.begin(), end = outline.end();
+  unsigned depth = 0;
+  bool changed = false;
+  if (!parent.empty()) {
+    const auto owner = std::find_if(first, end, [&](const Node& row) { return row.id == parent; });
+    if (owner == end) return false;
+    depth = owner->depth + 1;
+    first = end = owner + 1;
+    while (end != outline.end() && end->depth >= depth) ++end;
+    changed = owner->leaf != siblings.empty() || owner->childrenConfirmed == siblings.empty();
+    owner->leaf = siblings.empty();
+    owner->childrenConfirmed = !owner->leaf;
+  }
+  const auto localCreate = [depth](const Node& node) {
+    return node.depth == depth && node.id.starts_with("pending:");
+  };
+  const size_t staged = std::count_if(first, end, localCreate);
+  const size_t baseCount = outline.size() - (end - first) + siblings.size() + staged;
+  if (baseCount > MAX_ROWS) return changed;
+  auto current = first;
+  for (const auto& sibling : siblings) {
+    if (current == end || current->id != sibling.id || current->title != sibling.title ||
+        current->todo != sibling.todo || current->done != sibling.done) {
+      changed = true;
+      break;
+    }
+    ++current;
+    while (current != end && current->depth > depth) ++current;
+  }
+  if (!changed && current == end) return false;
+  size_t retained = 0;
+  std::vector<Node> rebuilt;
+  rebuilt.reserve(std::max(static_cast<size_t>(end - first), siblings.size()));
+  for (auto node : siblings) {
+    node.depth = depth;
+    const auto old = std::find_if(first, end, [&](const Node& candidate) {
+      return candidate.depth == depth && candidate.id == node.id;
+    });
+    if (old == end) {
+      rebuilt.push_back(std::move(node));
+      continue;
+    }
+    node.leaf = old->leaf;
+    node.childrenConfirmed = old->childrenConfirmed;
+    node.selected = old->selected;
+    if (itemPending(node.id)) {
+      node.title = old->title;
+      node.todo = old->todo;
+      node.done = old->done;
+    }
+    auto lastChild = old + 1;
+    while (lastChild != end && lastChild->depth > depth) ++lastChild;
+    const size_t count = lastChild - (old + 1);
+    const bool fits = baseCount + retained + count <= MAX_ROWS;
+    rebuilt.push_back(std::move(node));
+    if (fits) {
+      rebuilt.insert(rebuilt.end(), std::make_move_iterator(old + 1), std::make_move_iterator(lastChild));
+      retained += count;
+    }
+  }
+  std::copy_if(first, end, std::back_inserter(rebuilt), localCreate);
+  first = outline.erase(first, end);
+  outline.insert(first, std::make_move_iterator(rebuilt.begin()), std::make_move_iterator(rebuilt.end()));
+  return true;
+}
+
+void WorkflowyDailyActivity::loadDay() {
+  if (date.empty()) {
+    auto today = isoDate(0);
+    RenderLock lock(*this);
+    date = today.empty() ? "today" : std::move(today);
+  }
+  // Keep one network reader. Its existing cancellation flag lets the
+  // worker release its TLS resources before the replacement starts.
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  ++generation;
+  rootCheckedAt = millis() - SYNC_INTERVAL;
+  nextPrefetchAt = millis();
+  {
+    RenderLock lock(*this);
+    requestedBranch.clear();
+    awaitingOutline = true;
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::updateCompletion(const std::string& id, bool done) {
+  RenderLock lock(*this);
+  for (auto& node : rows) {
+    if (node.id == id) node.done = done;
+  }
+  for (auto& view : viewStack) {
+    for (auto& node : view.rows) {
+      if (node.id == id) node.done = done;
+    }
+  }
+  layoutDirty = true;
+  message = nullptr;
+}
+
+void WorkflowyDailyActivity::toggle(const size_t row) {
+  if (itemPending(rows[row].id) || !rows[row].todo) return;
+  const bool completed = rows[row].done;
+  const char* failed = completed ? tr(STR_WORKFLOWY_UNCOMPLETE_FAILED) : tr(STR_WORKFLOWY_COMPLETE_FAILED);
+  if (!online) {
+    recordServerError(0, 0, {}, credential);
+    return showMessage(failed);
+  }
+  const auto id = rows[row].id;
+  const auto label = completed ? StrId::STR_WORKFLOWY_MARK_UNDONE : StrId::STR_WORKFLOWY_MARK_DONE;
+  if (queueSave("/" + id + (completed ? "/uncomplete" : "/complete"), {}, false,
+                [this, id, completed, failed](const Save& save) {
+      if (save.status < 200 || save.status >= 300) {
+        updateCompletion(id, completed);
+        return showMessage(failed);
+      }
+      offerUndo([this, id, completed] {
+        if (itemPending(id)) return false;
+        if (!queueSave("/" + id + (completed ? "/complete" : "/uncomplete"), {}, false,
+                       [this, id, completed](const Save& undone) {
+          if (undone.status < 200 || undone.status >= 300) {
+            updateCompletion(id, !completed);
+            showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+          }
+        }, "POST", completed ? StrId::STR_WORKFLOWY_MARK_DONE : StrId::STR_WORKFLOWY_MARK_UNDONE, id)) return false;
+        updateCompletion(id, completed);
+        return true;
+      });
+    }, "POST", label, id)) {
+    updateCompletion(id, !completed);
+  }
+}
+
+bool WorkflowyDailyActivity::tapArrow(int x, int y) {
+  size_t row;
+  {
+    RenderLock lock(*this);
+    const int right = laidOut.x + laidOut.width;
+    if (page != paintedPage || x < right - ROW_ARROW_TARGET || x >= right + 8) return false;
+    const auto hit = std::find_if(paintedArrows.begin(), paintedArrows.end(), [&](const PaintedArrow& arrow) {
+      return y >= arrow.top && y < arrow.bottom;
+    });
+    if (hit == paintedArrows.end()) return false;
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& item) { return item.id == hit->id; });
+    if (node == rows.end()) return true;
+    row = node - rows.begin();
+  }
+  if (!itemPending(rows[row].id)) zoom(row);
+  return true;
+}
+
+void WorkflowyDailyActivity::edit(const size_t row, const int relative, const size_t cursor) {
+  if (row < rows.size() && itemPending(rows[row].id)) return;
+  const bool adding = relative != 0 || row >= rows.size();
+  if (!online && (!adding || relative != 0)) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const std::string id = row < rows.size() ? rows[row].id : "";
+  const std::string initial = adding ? "[] " : rows[row].title;
+  const bool originalTodo = !adding && rows[row].todo;
+  const int parentIndex = relative ? parentRow(row) : -1;
+  const std::string parent = relative ? (parentIndex < 0 ? "" : rows[parentIndex].id) : zoomId;
+  auto keyboard = std::make_unique<KeyboardEntryActivity>(
+      renderer, mappedInput, adding ? tr(STR_WORKFLOWY_ADD) : tr(STR_EDIT), initial, 512);
+  keyboard->setInitialCursor(adding ? initial.size() : cursor);
+  keyboard->enableWorkflowyTags();
+  startActivityForResult(std::move(keyboard), [this, id, initial, originalTodo, parent, adding, relative](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    auto text = std::get<KeyboardResult>(result.data).text;
+    workflowy::dropEmoji(text);
+    const auto first = text.find_first_not_of(" ");
+    const bool makeTodo = first != std::string::npos && (text.compare(first, 2, "[]") == 0 ||
+                                                         text.compare(first, 3, "[ ]") == 0);
+    if (makeTodo) {
+      const auto start = text.find_first_not_of(" ", first + (text[first + 1] == ']' ? 2 : 3));
+      text = start == std::string::npos ? "" : text.substr(start);
+    }
+    if (text == initial && !makeTodo) return;
+    if (text.find_first_not_of(" \t\r\n") == std::string::npos) return;
+    JsonDocument update;
+    update["name"] = escapedTitle(text, adding);
+    if (makeTodo) update["layoutMode"] = "todo";
+    if (adding) {
+      update["parent_id"] = parent.empty() ? date : parent;
+      update["layoutMode"] = makeTodo ? "todo" : "bullets";
+      update["position"] = "bottom";
+    }
+    if (adding && !hasActiveStationWifiConnection()) {
+      if (!relative && queueCapture(encode(update))) showMessage(tr(STR_WORKFLOWY_CAPTURE_QUEUED));
+      else showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    const auto localId = adding ? "pending:" + std::to_string(++temporaryId) : id;
+    const auto capturedDate = date;
+    const auto label = adding ? StrId::STR_WORKFLOWY_ADD : StrId::STR_EDIT;
+    if (!queueSave(adding ? "" : "/" + id, encode(update), adding,
+              [this, id, localId, parent, initial, originalTodo, adding, relative, capturedDate](const Save& save) {
+      if (save.status < 200 || save.status >= 300) {
+        if (adding) removeNode(localId);
+        else applyTitle(id, initial, originalTodo);
+        return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }
+      if (!adding) return;
+
+      JsonDocument resultBody;
+      const auto invalid = deserializeJson(resultBody, save.response.data(), save.received);
+      const std::string newId = resultBody["item_id"] | "";
+      if (invalid || newId.empty() || newId.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) {
+        removeNode(localId);
+        loadDay();
+        return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+      }
+      {
+        RenderLock lock(*this);
+        const auto replaceId = [&](std::vector<Node>& outline) {
+          for (auto& node : outline) if (node.id == localId) node.id = newId;
+        };
+        replaceId(rows);
+        for (auto& view : viewStack) replaceId(view.rows);
+        layoutDirty = true;
+      }
+      if (relative && capturedDate == date) {
+        const auto anchor = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        const auto added = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == newId; });
+        if (anchor != rows.end() && added != rows.end()) reorder(added - rows.begin(), anchor - rows.begin(), relative > 0);
+      }
+    }, "POST", label, localId)) return;
+    if (!adding) return applyTitle(id, text, makeTodo || originalTodo);
+    {
+      RenderLock lock(*this);
+      Node added{localId, text, 0, 0, makeTodo, false};
+      added.leaf = true;
+      if (!parent.empty() || zoomId.empty()) appendChild(rows, parent, added);
+      for (auto& view : viewStack) {
+        if (!parent.empty() || view.zoomId.empty()) appendChild(view.rows, parent, added);
+      }
+      saves.back()->title = text.substr(0, 120);
+      layoutDirty = true;
+    }
+    requestUpdate();
+  });
+}
+
+void WorkflowyDailyActivity::applyTitle(const std::string& id, const std::string& text, bool todo) {
+  {
+    RenderLock lock(*this);
+    const auto apply = [&](std::vector<Node>& outline) {
+      for (auto& item : outline) {
+        if (item.id != id) continue;
+        item.title = text;
+        item.todo = todo;
+      }
+    };
+    apply(rows);
+    for (auto& view : viewStack) apply(view.rows);
+    layoutDirty = true;
+  }
+  requestUpdate();
+}
+
+size_t WorkflowyDailyActivity::cursorAt(std::string_view text, workflowy::TextSpan line, int width) const {
+  line.end = std::min(line.end, text.size());
+  auto caret = std::min(line.begin, line.end);
+  int previousWidth = 0;
+  while (caret < line.end) {
+    const auto next = std::min(line.end, workflowy::nextCharacter(text, caret));
+    const int nextWidth = renderer.getTextWidth(UI_12_FONT_ID,
+                                               std::string(text.substr(line.begin, next - line.begin)).c_str());
+    if (width < (previousWidth + nextWidth) / 2) break;
+    previousWidth = nextWidth;
+    caret = next;
+  }
+  return caret;
+}
+
+bool WorkflowyDailyActivity::selectionEligible(const Node& node) const {
+  return node.depth == (zoomId.empty() ? 0u : 1u) && !itemPending(node.id) && (showDone || !node.done);
+}
+
+size_t WorkflowyDailyActivity::selectionCount() const {
+  return std::count_if(rows.begin(), rows.end(), [](const Node& row) { return row.selected; });
+}
