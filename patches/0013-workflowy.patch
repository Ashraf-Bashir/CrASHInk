+void WorkflowyDailyActivity::syncNode(const Node& updated) {
+  for (auto& view : viewStack) {
+    for (auto& copy : view.rows) {
+      if (copy.id != updated.id) continue;
+      copy.done = updated.done;
+      copy.todo = updated.todo;
+      copy.title = updated.title;
+    }
+  }
+}
+
+void WorkflowyDailyActivity::appendChild(std::vector<Node>& outline, const std::string& parent, Node node) {
+  if (parent.empty()) {
+    if (outline.size() < MAX_ROWS) outline.push_back(std::move(node));
+    return;
+  }
+  auto owner = std::find_if(outline.begin(), outline.end(), [&](const Node& row) { return row.id == parent; });
+  if (owner == outline.end()) return;
+  auto end = owner + 1;
+  const bool cached = owner->leaf || (end != outline.end() && end->depth > owner->depth);
+  owner->leaf = false;
+  owner->childrenConfirmed = true;
+  if (!cached || outline.size() == MAX_ROWS) return;
+  node.depth = owner->depth + 1;
+  while (end != outline.end() && end->depth > owner->depth) ++end;
+  outline.insert(end, std::move(node));
+}
+
+void WorkflowyDailyActivity::removeNode(const std::string& id, const bool moveToCurrentDay) {
+  const bool leaveZoom = id == zoomId;
+  {
+    RenderLock lock(*this);
+    std::vector<Node> movedBranch;
+    const auto removeFrom = [&](std::vector<Node>& outline) {
+      const auto first = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (first == outline.end()) return;
+      const auto depth = first->depth;
+      auto end = first + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      if (moveToCurrentDay && end - first > static_cast<ptrdiff_t>(movedBranch.size())) {
+        movedBranch.assign(first, end);
+        for (auto& node : movedBranch) node.depth -= depth;
+      }
+      if (depth > 0) {
+        auto parent = first;
+        while (parent != outline.begin() && (--parent)->depth >= depth) {}
+        if (parent + 1 == first && (end == outline.end() || end->depth < depth)) {
+          parent->leaf = true;
+          parent->expanded = false;
+          parent->childrenConfirmed = false;
+        }
+      }
+      outline.erase(first, end);
+    };
+    removeFrom(rows);
+    for (auto& view : viewStack) removeFrom(view.rows);
+    if (moveToCurrentDay && !movedBranch.empty()) {
+      auto& dailyRows = viewStack.empty() ? rows : viewStack.front().rows;
+      if (dailyRows.size() + movedBranch.size() <= MAX_ROWS)
+        dailyRows.insert(dailyRows.end(), std::make_move_iterator(movedBranch.begin()),
+                         std::make_move_iterator(movedBranch.end()));
+    }
+    layoutDirty = true;
+    message = nullptr;
+  }
+  if (leaveZoom) back();
+  else requestUpdate();
+}
+
+// Reconcile one ordered sibling list, retaining each matching node's cached subtree.
+bool WorkflowyDailyActivity::replaceSiblings(std::vector<Node>& outline, const std::string& parent,
+                                            const std::vector<Node>& siblings) {
+  auto first = outline.begin(), end = outline.end();
+  unsigned depth = 0;
+  bool changed = false;
+  if (!parent.empty()) {
+    const auto owner = std::find_if(first, end, [&](const Node& row) { return row.id == parent; });
+    if (owner == end) return false;
+    depth = owner->depth + 1;
+    first = end = owner + 1;
+    while (end != outline.end() && end->depth >= depth) ++end;
+    changed = owner->leaf != siblings.empty() || owner->childrenConfirmed == siblings.empty();
+    owner->checkedAt = millis();
+    owner->leaf = siblings.empty();
+    owner->childrenConfirmed = !owner->leaf;
+    if (owner->leaf) owner->expanded = false;
+  }
+  const size_t baseCount = outline.size() - (end - first) + siblings.size();
+  if (baseCount > MAX_ROWS) return changed;
+  auto current = first;
+  for (const auto& sibling : siblings) {
+    if (current == end || current->id != sibling.id || current->title != sibling.title ||
+        current->todo != sibling.todo || current->done != sibling.done) {
+      changed = true;
+      break;
+    }
+    ++current;
+    while (current != end && current->depth > depth) ++current;
+  }
+  if (!changed && current == end) return false;
+  size_t retained = 0;
+  std::vector<Node> rebuilt;
+  rebuilt.reserve(end - first);
+  for (auto node : siblings) {
+    node.depth = depth;
+    const auto old = std::find_if(first, end, [&](const Node& candidate) {
+      return candidate.depth == depth && candidate.id == node.id;
+    });
+    if (old == end) {
+      rebuilt.push_back(std::move(node));
+      continue;
+    }
+    node.leaf = old->leaf;
+    node.expanded = old->expanded;
+    node.childrenConfirmed = old->childrenConfirmed;
+    node.checkedAt = old->checkedAt;
+    auto lastChild = old + 1;
+    while (lastChild != end && lastChild->depth > depth) ++lastChild;
+    const size_t count = lastChild - (old + 1);
+    const bool fits = baseCount + retained + count <= MAX_ROWS;
+    if (!fits) node.expanded = false;
+    rebuilt.push_back(std::move(node));
+    if (fits) {
+      rebuilt.insert(rebuilt.end(), std::make_move_iterator(old + 1), std::make_move_iterator(lastChild));
+      retained += count;
+    }
+  }
+  first = outline.erase(first, end);
+  outline.insert(first, std::make_move_iterator(rebuilt.begin()), std::make_move_iterator(rebuilt.end()));
+  return true;
+}
+
+void WorkflowyDailyActivity::loadDay() {
+  if (date.empty()) {
+    auto today = isoDate(0);
+    RenderLock lock(*this);
+    date = today.empty() ? "today" : std::move(today);
+  }
+  ++generation;
+  rootCheckedAt = millis() - SYNC_INTERVAL;
+  nextPrefetchAt = millis();
+  {
+    RenderLock lock(*this);
+    awaitingOutline = true;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::toggle(const size_t row) {
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const bool completed = rows[row].done;
+  setLoading(true);
+  const int status = request("POST", "/" + rows[row].id + (completed ? "/uncomplete" : "/complete"), {});
+  setLoading(false);
+  if (status != 200) {
+    showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    rows[row].done = !completed;
+    syncNode(rows[row]);
+    layoutDirty = true;
+    message = nullptr;
+  }
+  const auto id = rows[row].id;
+  offerUndo([this, id, completed] {
+    setLoading(true);
+    const bool ok = request("POST", "/" + id + (completed ? "/complete" : "/uncomplete"), {}) == 200;
+    setLoading(false);
+    if (!ok) return false;
+    RenderLock lock(*this);
+    for (auto& node : rows) {
+      if (node.id == id) node.done = completed;
+    }
+    for (auto& view : viewStack) {
+      for (auto& node : view.rows) {
+        if (node.id == id) node.done = completed;
+      }
+    }
+    layoutDirty = true;
+    return true;
+  });
+}
+
+void WorkflowyDailyActivity::expand(const size_t row) {
+  if (rows[row].leaf) return;
+  const auto depth = rows[row].depth;
+  if (row + 1 < rows.size() && rows[row + 1].depth > depth) {
+    {
+      RenderLock lock(*this);
+      rows[row].expanded = !rows[row].expanded;
+      layoutDirty = true;
+    }
+    requestUpdate();
+    return;
+  }
+  std::vector<Node> children;
+  setLoading(true);
+  const bool loadedChildren = loadChildren(rows[row].id, depth + 1, children);
+  setLoading(false);
+  if (!loadedChildren) return;
+  if (rows.size() + children.size() > MAX_ROWS) {
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    rows[row].leaf = children.empty();
+    rows[row].childrenConfirmed = !rows[row].leaf;
+    rows[row].checkedAt = millis();
+    rows[row].expanded = !children.empty();
+    layoutDirty = true;
+    rows.insert(rows.begin() + row + 1, std::make_move_iterator(children.begin()), std::make_move_iterator(children.end()));
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::edit(const size_t row, const int relative, const size_t cursor) {
+  const bool adding = relative != 0 || row >= rows.size();
+  if (!online && (!adding || relative != 0)) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const std::string id = row < rows.size() ? rows[row].id : "";
+  const std::string initial = adding ? "" : rows[row].title;
+  const int parentIndex = relative ? parentRow(row) : -1;
+  const std::string parent = relative ? (parentIndex < 0 ? "" : rows[parentIndex].id) : zoomId;
+  auto keyboard = std::make_unique<KeyboardEntryActivity>(
+      renderer, mappedInput, adding ? tr(STR_WORKFLOWY_ADD) : tr(STR_EDIT), initial, 512);
+  if (wrapItems) {
+    inlineLines.clear();
+    keyboard->setInlineField(
+        [this, row, relative, adding](const auto& draft, size_t caret, int bottom) {
+          renderInline(row, relative, adding, draft, caret, bottom);
+        },
+        [this](const std::string& draft, int x, int y, size_t& caret) {
+          RenderLock lock(*this);
+          for (const auto& line : inlineLines) {
+            if (y >= line.y && y < line.y + line.height) {
+              caret = cursorAt(draft, line.text, x - line.x);
+              return true;
+            }
+          }
+          return false;
+        },
+        cursor);
+  }
+  startActivityForResult(std::move(keyboard), [this, id, initial, parent, row, adding, relative](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    auto text = std::get<KeyboardResult>(result.data).text;
+    const auto first = text.find_first_not_of(" ");
+    const bool makeTodo = first != std::string::npos && (text.compare(first, 2, "[]") == 0 ||
+                                                         text.compare(first, 3, "[ ]") == 0);
+    if (makeTodo) {
+      const auto start = text.find_first_not_of(" ", first + (text[first + 1] == ']' ? 2 : 3));
+      text = start == std::string::npos ? "" : text.substr(start);
+    }
+    if (text.find_first_not_of(" \t\r\n") == std::string::npos || (text == initial && !makeTodo)) return;
+    JsonDocument update;
+    update["name"] = escapedTitle(text, adding);
+    if (makeTodo) update["layoutMode"] = "todo";
+    if (adding) {
+      update["parent_id"] = parent.empty() ? date : parent;
+      update["layoutMode"] = "todo";
+      update["position"] = "bottom";
+    }
+    if (adding && !hasActiveStationWifiConnection()) {
+      if (!relative && queueCapture(encode(update))) showMessage(tr(STR_WORKFLOWY_CAPTURE_QUEUED));
+      else showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    setLoading(true);
+    uint8_t response[256];
+    size_t received = 0;
+    const int status = adding ? request("POST", "", encode(update), response, &received, sizeof(response))
+                              : request("POST", "/" + id, encode(update));
+    setLoading(false);
+    if (status < 200 || status >= 300) {
+      showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      return;
+    }
+    if (adding) {
+      JsonDocument resultBody;
+      if (deserializeJson(resultBody, response, received)) {
+        showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+        return;
+      }
+      const std::string newId = resultBody["item_id"] | "";
+      if (newId.empty() || newId.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) {
+        showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+        return;
+      }
+      size_t newRow = 0;
+      {
+        RenderLock lock(*this);
+        Node added{newId, text, 0, 0, true, false};
+        added.leaf = true;
+        if (!zoomId.empty() && parent == zoomId && !rows.empty()) rows.front().expanded = true;
+        appendChild(rows, parent, added);
+        for (auto& view : viewStack) {
+          if (!parent.empty() || view.zoomId.empty()) appendChild(view.rows, parent, added);
+        }
+        const auto found = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == newId; });
+        newRow = found - rows.begin();
+        layoutDirty = true;
+        message = nullptr;
+      }
+      if (relative) {
+        const auto anchor = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        if (anchor != rows.end() && newRow < rows.size()) reorder(newRow, anchor - rows.begin(), relative > 0);
+      }
+    } else {
+      RenderLock lock(*this);
+      rows[row].title = text;
+      if (makeTodo) rows[row].todo = true;
+      syncNode(rows[row]);
+      layoutDirty = true;
+      message = nullptr;
+    }
+  });
+}
+
+size_t WorkflowyDailyActivity::cursorAt(std::string_view text, workflowy::TextSpan line, int width) const {
+  line.end = std::min(line.end, text.size());
+  auto caret = std::min(line.begin, line.end);
+  int previousWidth = 0;
+  while (caret < line.end) {
+    const auto next = std::min(line.end, workflowy::nextCharacter(text, caret));
+    const int nextWidth = renderer.getTextWidth(UI_12_FONT_ID,
+                                               std::string(text.substr(line.begin, next - line.begin)).c_str());
+    if (width < (previousWidth + nextWidth) / 2) break;
+    previousWidth = nextWidth;
+    caret = next;
+  }
+  return caret;
+}
+
+void WorkflowyDailyActivity::renderInline(size_t row, int relative, bool adding, const std::string& draft,
+                                         size_t cursor, int bottom) {
+  const auto bounds = layout();
+  inlineLines.clear();
+  const int lineHeight = bounds.lineHeight;
+  auto measure = [&](std::string_view text) {
+    return renderer.getTextWidth(UI_12_FONT_ID, std::string(text).c_str());
+  };
+  const auto depth = row < rows.size() ? rows[row].depth : zoomId.empty() ? 0 : 1;
+  const int start = bounds.x + std::min<unsigned>(depth, 8) * 16;
+  const int textX = start + 25;
+  std::vector<workflowy::TextSpan> lines;
+  workflowy::wrapOutlineText(draft, bounds.x + bounds.width - textX - ROW_ARROW_TARGET, measure, lines);
+  size_t cursorLine = 0;
+  while (cursorLine + 1 < lines.size() && cursor >= lines[cursorLine + 1].begin) ++cursorLine;
+  const int top = bounds.top + 62;
+  const size_t capacity = std::max(1, (bottom - top) / lineHeight - 1);
+  const auto first = cursorLine >= capacity ? cursorLine + 1 - capacity : 0;
+  const auto count = std::min(capacity, lines.size() - first);
+  int y = top;
+  const auto drawNeighbour = [&](size_t index) {
+    const auto& node = rows[index];
+    const int x = bounds.x + std::min<unsigned>(node.depth, 8) * 16;
+    if (node.todo) renderer.drawRect(x + 1, y + 4, 18, 18);
+    else renderer.fillRect(x + 6, y + 11, 5, 5);
+    const auto text = renderer.truncatedText(UI_12_FONT_ID, node.title.c_str(), bounds.x + bounds.width - x - 25);
+    renderer.drawText(UI_12_FONT_ID, x + 25, y, text.c_str());
+    y += lineHeight;
+  };
+  const auto anchor = std::find_if(placements.begin(), placements.end(),
+                                   [&](const Placement& entry) { return entry.row == row; });
+  if (count + 1 < capacity && !placements.empty()) {
+    if (anchor == placements.end()) drawNeighbour(placements.back().row);
+    else if (relative > 0) drawNeighbour(anchor->row);
+    else if (anchor != placements.begin()) drawNeighbour(std::prev(anchor)->row);
+  }
+  if (adding || (row < rows.size() && rows[row].todo)) renderer.drawRect(start + 1, y + 4, 18, 18);
+  else renderer.fillRect(start + 6, y + 11, 5, 5);
+  for (size_t i = first; i < first + count; ++i) {
+    const auto [begin, end] = lines[i];
+    inlineLines.push_back({lines[i], textX, y, lineHeight});
+    const auto text = draft.substr(begin, end - begin);
+    renderer.drawText(UI_12_FONT_ID, textX, y, text.c_str());
+    if (i == cursorLine) {
+      const int cursorX = textX + measure(std::string_view(draft).substr(begin, std::clamp(cursor, begin, end) - begin));
+      renderer.fillRect(cursorX, y, 2, lineHeight);
+    }
+    y += lineHeight;
+  }
+  renderer.drawLine(textX, y, bounds.x + bounds.width - ROW_ARROW_TARGET, y);
+  if (y + 2 * lineHeight < bottom && anchor != placements.end()) {
+    if (relative < 0) drawNeighbour(anchor->row);
+    else {
+      const auto next = std::find_if(std::next(anchor), placements.end(),
+                                     [&](const Placement& entry) { return entry.row != row; });
+      if (next != placements.end()) drawNeighbour(next->row);
+    }
+  }
+}
+
+void WorkflowyDailyActivity::actions(const size_t row) {
+  std::vector<std::string> options{
+      tr(STR_EDIT), tr(STR_WORKFLOWY_ZOOM), tr(STR_WORKFLOWY_MOVE_DATE),
+      rows[row].todo ? tr(STR_WORKFLOWY_TO_BULLET) : tr(STR_WORKFLOWY_TO_TODO), tr(STR_DELETE)};
+  if (zoomId.empty() || row != 0) {
+    options.emplace_back(tr(STR_WORKFLOWY_ADD_ABOVE));
+    options.emplace_back(tr(STR_WORKFLOWY_ADD_BELOW));
+  }
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyItem", StrId::STR_WORKFLOWY, std::move(options),
+                             0, false, true),
+                         [this, row](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const int selected = std::get<OptionSelectionResult>(result.data).index;
+    const auto id = rows[row].id;
+    if (selected == 0) return edit(row);
+    if (selected == 5 || selected == 6) return edit(row, selected == 5 ? -1 : 1);
+    if (selected == 1) return zoom(row);
+    if (selected == 2) return chooseDate(id);
+    if (selected == 3) {
+      const bool todo = !rows[row].todo;
+      JsonDocument update;
+      update["layoutMode"] = todo ? "todo" : "bullets";
+      setLoading(true);
+      const int status = request("POST", "/" + id, encode(update));
+      setLoading(false);
+      if (status == 200) {
+        RenderLock lock(*this);
+        rows[row].todo = todo;
+        syncNode(rows[row]);
+        message = nullptr;
+      } else {
+        showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }
+    } else if (selected == 4) {
+      startActivityForResult(std::make_unique<ConfirmationActivity>(
+                                 renderer, mappedInput, tr(STR_DELETE), rows[row].title),
+                             [this, id](const ActivityResult& confirmation) {
+        if (confirmation.isCancelled) return;
+        if (!hasActiveStationWifiConnection()) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+        commitDelete();
+        {
+          RenderLock lock(*this);
+          pendingDelete = id;
+          deleteAt = millis() + DELETE_GRACE;
+          layoutDirty = true;
+        }
+        offerUndo([this] {
+          RenderLock lock(*this);
+          pendingDelete.clear();
+          layoutDirty = true;
+          return true;
+        }, true);
+      });
+    }
+  });
+}
+
+void WorkflowyDailyActivity::moveToDate(const std::string& id, const std::string& target) {
+  if (id.empty()) {
+    if (date == target) return;
+    {
+      RenderLock lock(*this);
+      ++generation;
+      date = target;
+      zoomId.clear();
+      viewStack.clear();
+      page = 0;
+      rows.clear();
+      layoutDirty = true;
+    }
+    step = Step::Load;
+    return;
+  }
+  const auto old = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+  if (old == rows.end()) return;
+  const auto original = moveOrigin(old - rows.begin());
+  JsonDocument update;
+  update["parent_id"] = target;
+  update["position"] = "bottom";
+  setLoading(true);
+  const auto status = request("POST", "/" + id + "/move", encode(update));
+  setLoading(false);
+  const bool currentDay = target == date || (date == "today" && target == isoDate(0)) ||
+                          (date == "tomorrow" && target == isoDate(1));
+  if (status != 200) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  removeNode(id, currentDay);
+  offerUndo([this, id, original] { return restoreMove(id, original); });
+}
+
+void WorkflowyDailyActivity::chooseDate(std::string moveId) {
+  const auto title = moveId.empty() ? StrId::STR_WORKFLOWY_SHOW_DATE : StrId::STR_WORKFLOWY_MOVE_DATE;
+  std::vector<std::string> choices{tr(STR_WORKFLOWY_YESTERDAY), tr(STR_WORKFLOWY_TODAY), tr(STR_WORKFLOWY_TOMORROW),
+                                   tr(STR_WORKFLOWY_CHOOSE_DATE)};
+  int selectedDate = 1;
+  if (moveId.empty()) {
+    if (date == "today" || date.empty() || date == isoDate(0)) selectedDate = 1;
+    else if (date == isoDate(-1)) selectedDate = 0;
+    else if (date == "tomorrow" || date == isoDate(1)) selectedDate = 2;
+    else {
+      selectedDate = 3;
+      choices.back() += "  " + date;
+    }
+  }
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyDate", title, std::move(choices), selectedDate, false, true),
+                         [this, title, moveId = std::move(moveId)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const int selected = std::get<OptionSelectionResult>(result.data).index;
+    if (selected < 0 || selected > 3) return;
+    if (selected != 3) {
+      const auto target = isoDate(selected - 1);
+      if (target.empty() && selected == 0) showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+      else moveToDate(moveId, target.empty() ? (selected == 1 ? "today" : "tomorrow") : target);
+      return;
+    }
+    startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                               renderer, mappedInput, I18n::getInstance().get(title),
+                               validDate(date) ? date : "", 10),
+                           [this, moveId](const ActivityResult& entered) {
+      if (entered.isCancelled) return;
+      const auto& target = std::get<KeyboardResult>(entered.data).text;
+      if (validDate(target)) moveToDate(moveId, target);
+      else showMessage(tr(STR_WORKFLOWY_INVALID_DATE));
+    });
+  });
+}
+
+WorkflowyDailyActivity::Layout WorkflowyDailyActivity::layout() const {
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int rowTop = top + 74;
+  const int footer = renderer.getScreenHeight() - bottom - 52;
+  const int pageLabel = std::max(32, renderer.getLineHeight(SMALL_FONT_ID) + 3);
+  return {left + 8, top, renderer.getScreenWidth() - right - left - 16, rowTop, footer,
+          footer - pageLabel, std::max(1, renderer.getLineHeight(UI_12_FONT_ID))};
+}
+
+void WorkflowyDailyActivity::setLoading(const bool active) {
+  {
+    RenderLock lock(*this);
+    loading = active;
+    if (active) ++generation;
+    else {
+      tracking = false;
+      dragging = false;
+      dragRow = dropRow = -1;
+      mappedInput.suppressCurrentTouchContact();
+    }
+  }
+  if (active) requestUpdateAndWait();
+  else requestUpdate();
+}
+
+void WorkflowyDailyActivity::layoutRows(const Layout& bounds) {
+  if (!layoutDirty && laidOut == bounds) return;
+  laidOut = bounds;
+  layoutDirty = false;
+  outlineLines.clear();
+  placements.clear();
+  pageStarts.assign(1, 0);
+  const int firstLineHeight = std::max(ROW_HEIGHT, bounds.lineHeight + 12);
+  const int maxLines = std::max(1, 1 + (bounds.rowBottom - bounds.rowTop - firstLineHeight) / bounds.lineHeight);
+  int y = bounds.rowTop;
+  unsigned collapsedDepth = UINT_MAX;
+  for (size_t i = 0; i < rows.size(); ++i) {
+    const auto& node = rows[i];
+    if (node.depth > collapsedDepth) continue;
+    collapsedDepth = node.expanded ? UINT_MAX : node.depth;
+    if (node.id == pendingDelete) {
+      collapsedDepth = node.depth;
+      continue;
+    }
+    if (node.done && !showDone && (i != 0 || zoomId.empty())) continue;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int width = std::max(1, bounds.width - indent - 25 - ROW_ARROW_TARGET);
+    size_t first = outlineLines.size();
+    if (wrapItems) {
+      workflowy::wrapOutlineText(node.title, width, [&](std::string_view text) {
+        return renderer.getTextWidth(UI_12_FONT_ID, std::string(text).c_str());
+      }, outlineLines);
+    } else {
+      outlineLines.push_back({0, node.title.size()});
+    }
+    while (first < outlineLines.size()) {
+      const auto count = std::min(static_cast<size_t>(maxLines), outlineLines.size() - first);
+      const int height = firstLineHeight + (static_cast<int>(count) - 1) * bounds.lineHeight;
+      if (y != bounds.rowTop && y + height > bounds.rowBottom) {
+        pageStarts.push_back(placements.size());
+        y = bounds.rowTop;
+      }
+      placements.push_back({i, first, count, y, y + height});
+      first += count;
+      y += height;
+    }
+  }
+  if (wrapAnchor >= 0) {
+    const auto match = std::find_if(placements.begin(), placements.end(), [&](const Placement& placement) {
+      return placement.row == static_cast<size_t>(wrapAnchor);
+    });
+    if (match != placements.end()) {
+      const auto index = static_cast<size_t>(match - placements.begin());
+      page = std::upper_bound(pageStarts.begin(), pageStarts.end(), index) - pageStarts.begin() - 1;
+    }
+    wrapAnchor = -1;
+  }
+  page = std::min(page, pageStarts.size() - 1);
+}
+
+int WorkflowyDailyActivity::rowAt(const int x, const int y) const {
+  RenderLock lock;
+  if (layoutDirty || paintedPage != page || page >= pageStarts.size() || x < laidOut.x || x >= laidOut.x + laidOut.width)
+    return -1;
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  for (auto i = pageStarts[page]; i < end; ++i) {
+    const auto& hit = placements[i];
+    if (y >= hit.top && y < hit.bottom) return static_cast<int>(hit.row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::nextPage(const int delta, const bool edge) {
+  {
+    RenderLock lock(*this);
+    const int last = pageStarts.empty() ? 0 : static_cast<int>(pageStarts.size() - 1);
+    const auto next = static_cast<size_t>(edge ? (delta < 0 ? 0 : last)
+                                               : std::clamp(static_cast<int>(page) + delta, 0, last));
+    if (next == page) return;
+    page = next;
+  }
+  requestUpdate();
+}
+
+int WorkflowyDailyActivity::parentRow(size_t row) const {
+  const auto depth = rows[row].depth;
+  while (row > 0) {
+    --row;
+    if (rows[row].depth < depth) return static_cast<int>(row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::zoom(size_t row) {
+  if (rows[row].id == zoomId) return;
+  Node root = rows[row];
+  std::vector<Node> focused;
+  if (row + 1 < rows.size() && rows[row + 1].depth > root.depth) {
+    auto end = rows.begin() + row + 1;
+    while (end != rows.end() && end->depth > root.depth) ++end;
+    focused.assign(rows.begin() + row + 1, end);
+    for (auto& node : focused) node.depth -= root.depth;
+  } else if (!root.leaf) {
+    setLoading(true);
+    const bool loaded = loadChildren(root.id, 1, focused);
+    setLoading(false);
+    if (!loaded) return;
+  }
+  root.depth = 0;
+  root.leaf = focused.empty();
+  root.childrenConfirmed = !root.leaf;
+  root.checkedAt = millis();
+  root.expanded = !root.leaf;
+  focused.insert(focused.begin(), std::move(root));
+  {
+    RenderLock lock(*this);
+    ++generation;
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    viewStack.push_back({std::move(rows), std::move(zoomId), page});
+    zoomId = focused.front().id;
+    rows = std::move(focused);
+    page = 0;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::back() {
+  if (viewStack.empty()) {
+    commitDelete();
+    return finish();
+  }
+  {
+    RenderLock lock(*this);
+    ++generation;
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    auto previous = std::move(viewStack.back());
+    viewStack.pop_back();
+    rows = std::move(previous.rows);
+    zoomId = std::move(previous.zoomId);
+    page = previous.page;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::reorder(size_t source, size_t target, bool after, bool recordUndo) {
+  const int parent = parentRow(source);
+  if (source == target || parent != parentRow(target)) return false;
+  const auto parentNode = parent < 0 ? "" : rows[parent].id;
+  return reorderSiblings(parent < 0 ? date : parentNode, parentNode, rows[source].depth,
+                         rows[source].id, rows[target].id, after, recordUndo);
+}
+
+bool WorkflowyDailyActivity::reorderSiblings(const std::string& parentId, const std::string& parentNode,
+                                             unsigned depth, std::string sourceId, std::string targetId,
+                                             bool after, bool recordUndo) {
+  setLoading(true);
+  std::vector<Node> siblings;
+  if (!loadChildren(parentId, depth, siblings)) {
+    setLoading(false);
+    return false;
+  }
+  std::vector<size_t> order;
+  size_t sourceIndex = siblings.size(), targetIndex = siblings.size();
+  for (size_t i = 0; i < siblings.size(); ++i) {
+    if (siblings[i].id == sourceId) sourceIndex = i;
+    else order.push_back(i);
+    if (siblings[i].id == targetId) targetIndex = i;
+  }
+  if (sourceIndex == siblings.size() || targetIndex == siblings.size()) {
+    setLoading(false);
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+    return false;
+  }
+  const bool wasFirst = sourceIndex == 0;
+  const auto originalNeighbour = siblings[wasFirst ? 1 : sourceIndex - 1].id;
+  const auto position = std::find(order.begin(), order.end(), targetIndex);
+  order.insert(position + (after ? 1 : 0), sourceIndex);
+  const auto stationary = workflowy::stationaryRange(order);
+  const auto move = [&](size_t index, const char* placement) {
+    JsonDocument update;
+    update["parent_id"] = parentId;
+    update["position"] = placement;
+    return request("POST", "/" + siblings[order[index]].id + "/move", encode(update)) == 200;
+  };
+  bool ok = true;
+  for (size_t i = stationary.begin; i > 0 && ok; --i) ok = move(i - 1, "top");
+  for (size_t i = stationary.end; i < order.size() && ok; ++i) ok = move(i, "bottom");
+  std::vector<Node> refreshed;
+  bool loaded = true;
+  if (ok) {
+    for (const auto i : order) refreshed.push_back(std::move(siblings[i]));
+  } else {
+    // A failed move can leave a partial order. Reconcile only this sibling list.
+    loaded = loadChildren(parentId, depth, refreshed);
+  }
+  setLoading(false);
+  if (loaded) {
+    RenderLock lock(*this);
+    if (!parentNode.empty() || (zoomId.empty() && parentId == date)) replaceSiblings(rows, parentNode, refreshed);
+    for (auto& view : viewStack) {
+      if (!parentNode.empty() || (view.zoomId.empty() && parentId == date))
+        replaceSiblings(view.rows, parentNode, refreshed);
+    }
+    layoutDirty = true;
+    message = ok ? nullptr : tr(STR_WORKFLOWY_SEND_FAILED);
+  }
+  if (ok && recordUndo) {
+    offerUndo([this, sourceId, originalNeighbour, wasFirst, parentId, parentNode, depth] {
+      return reorderSiblings(parentId, parentNode, depth, sourceId, originalNeighbour, !wasFirst, false);
+    });
+  }
+  requestUpdate();
+  return ok;
+}
+
+void WorkflowyDailyActivity::offerUndo(std::function<bool()> action, bool forDelete) {
+  undoIsDelete = forDelete;
+  undoAction = std::move(action);
+  {
+    RenderLock lock(*this);
+    undoReady = true;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::undo() {
+  if (!undoAction) return;
+  if (!undoIsDelete && !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  if (!undoAction()) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  undoAction = {};
+  {
+    RenderLock lock(*this);
+    undoReady = false;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::commitDelete() {
+  if (pendingDelete.empty() || !hasActiveStationWifiConnection()) return;
+  const auto id = pendingDelete;
+  setLoading(true);
+  const bool ok = request("DELETE", "/" + id, {}) == 200;
+  setLoading(false);
+  {
+    RenderLock lock(*this);
+    pendingDelete.clear();
+    if (undoIsDelete) undoReady = false;
+    layoutDirty = true;
+  }
+  if (undoIsDelete) undoAction = {};
+  if (ok) removeNode(id);
+  else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+}
+
+bool WorkflowyDailyActivity::queueCapture(const std::string& body) {
+  JsonDocument queue, item;
+  if ((!outbox.empty() && deserializeJson(queue, outbox)) || deserializeJson(item, body)) return false;
+  const auto account = std::to_string(std::hash<std::string>{}(credential));
+  if (queue["items"].isNull()) queue["items"].to<JsonArray>();
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() && queue["account"].as<std::string>() != account) return false;
+  queue["account"] = account;
+  if (items.size() >= OUTBOX_ITEMS || !items.add(item.as<JsonVariantConst>())) return false;
+  auto saved = encode(queue);
+  if (saved.size() > OUTBOX_LIMIT || !workflowy::writeSetting(OUTBOX, saved)) return false;
+  outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    pendingCount = items.size();
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::flushCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential))) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  }
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() == 0) return;
+  std::string body;
+  serializeJson(items[0], body);
+  queue["sending"] = true;
+  auto marked = encode(queue);
+  if (!workflowy::writeSetting(OUTBOX, marked)) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+  }
+  outbox = std::move(marked);
+  setLoading(true);
+  const int status = request("POST", "", body);
+  setLoading(false);
+  if (status >= 200 && status < 300) items.remove(0);
+  // An interrupted request may have created the item. Leave it queued for explicit review.
+  const bool uncertain = status == 0 || status >= 500;
+  queue["sending"] = uncertain;
+  auto saved = encode(queue);
+  const bool persisted = workflowy::writeSetting(OUTBOX, saved);
+  if (persisted) outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    outboxUncertain = uncertain || !persisted;
+    if (persisted) pendingCount = items.size();
+  }
+  retryOutboxAt = millis() + (status >= 200 && status < 300 ? 350 : 30000);
+  if (status >= 200 && status < 300) loadDay();
+  else requestUpdate();
+}
+
+void WorkflowyDailyActivity::reviewCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential)))
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  const auto name = plainTitle(queue["items"][0]["name"] | "");
+  std::vector<std::string> options{tr(STR_WORKFLOWY_OUTBOX_SENT), tr(STR_WORKFLOWY_OUTBOX_RETRY)};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyOutbox", StrId::STR_WORKFLOWY_SYNC_CHECK,
+                             std::move(options), 0, false, true),
+                         [this, name](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const bool sent = std::get<OptionSelectionResult>(result.data).index == 0;
+    startActivityForResult(std::make_unique<ConfirmationActivity>(
+                               renderer, mappedInput, (sent ? tr(STR_WORKFLOWY_OUTBOX_SENT) : tr(STR_WORKFLOWY_OUTBOX_RETRY)),
+                               name),
+                           [this, sent](const ActivityResult& confirmation) {
+      if (confirmation.isCancelled) return;
+      JsonDocument queue;
+      if (deserializeJson(queue, outbox)) return;
+      auto items = queue["items"].as<JsonArray>();
+      if (sent) items.remove(0);
+      queue["sending"] = false;
+      auto saved = encode(queue);
+      if (!workflowy::writeSetting(OUTBOX, saved)) return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      outbox = std::move(saved);
+      {
+        RenderLock lock(*this);
+        outboxUncertain = false;
+        pendingCount = items.size();
+      }
+      retryOutboxAt = millis();
+      requestUpdate();
+    });
+  });
+}
+
+bool WorkflowyDailyActivity::moveNode(const std::string& id, const std::string& parent, const char* position) {
+  JsonDocument update;
+  update["parent_id"] = parent;
+  update["position"] = position;
+  setLoading(true);
+  const bool ok = request("POST", "/" + id + "/move", encode(update)) == 200;
+  setLoading(false);
+  if (!ok) showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  return ok;
+}
+
+WorkflowyDailyActivity::MoveOrigin WorkflowyDailyActivity::moveOrigin(size_t source) const {
+  const int parent = parentRow(source);
+  const std::string parentNode = parent < 0 ? "" : rows[parent].id;
+  const unsigned depth = rows[source].depth;
+  MoveOrigin origin{parent < 0 ? date : parentNode, parentNode, {}, depth, false};
+  for (size_t i = parent < 0 ? 0 : parent + 1; i < rows.size() && rows[i].depth >= depth; ++i) {
+    if (i == source || rows[i].depth != depth) continue;
+    if (i > source && !origin.neighbour.empty()) break;
+    origin.neighbour = rows[i].id;
+    origin.after = i < source;
+    if (i > source) break;
+  }
+  return origin;
+}
+
+bool WorkflowyDailyActivity::restoreMove(const std::string& id, const MoveOrigin& origin) {
+  if (!moveNode(id, origin.parent)) return false;
+  removeNode(id);
+  if (!origin.neighbour.empty() &&
+      !reorderSiblings(origin.parent, origin.parentNode, origin.depth, id, origin.neighbour, origin.after, false)) {
+    // The parent was restored. Reconcile if the original neighbour moved or was deleted.
+    loadDay();
+    showMessage(tr(STR_WORKFLOWY_ORDER_CHANGED));
+  } else {
+    loadDay();
+  }
+  return true;
+}
+
+void WorkflowyDailyActivity::indent(size_t source, size_t target) {
+  const auto id = rows[source].id;
+  const auto destination = rows[target].id;
+  const auto original = moveOrigin(source);
+  if (!moveNode(id, destination, "top")) return;
+  removeNode(id);
+  {
+    RenderLock lock(*this);
+    for (auto& node : rows) {
+      if (node.id != destination) continue;
+      node.leaf = false;
+      node.childrenConfirmed = true;
+      node.checkedAt = 0;
+    }
+  }
+  const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == destination; });
+  if (owner != rows.end()) {
+    std::vector<Node> children;
+    if (loadChildren(destination, owner->depth + 1, children)) {
+      RenderLock lock(*this);
+      replaceSiblings(rows, destination, children);
+      const auto refreshed = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == destination; });
+      if (refreshed != rows.end()) refreshed->expanded = true;
+      layoutDirty = true;
+    }
+  }
+  offerUndo([this, id, original] { return restoreMove(id, original); });
+}
+
+void WorkflowyDailyActivity::prefetchTask(void* argument) {
+  {
+    std::unique_ptr<std::shared_ptr<Prefetch>> holder(static_cast<std::shared_ptr<Prefetch>*>(argument));
+    auto& job = **holder;
+    job.status = fetchChildren(job.key, job.target, job.depth, job.children);
+    job.ready.store(true, std::memory_order_release);
+  }
+  vTaskDelete(nullptr);
+}
+
+void WorkflowyDailyActivity::pollPrefetch() {
+  const auto now = millis();
+  if (prefetch) {
+    if (!prefetch->ready.load(std::memory_order_acquire)) return;
+    auto job = std::move(prefetch);
+    if (job->generation != generation) return;
+    bool changed = false;
+    {
+      RenderLock lock(*this);
+      if (job->root) {
+        rootCheckedAt = now;
+        if (awaitingOutline) {
+          awaitingOutline = false;
+          changed = true;
+          message = job->status == 200 ? nullptr
+                    : job->status == -2 ? tr(STR_WORKFLOWY_CLOCK_FAILED)
+                    : job->status == -3 ? tr(STR_WORKFLOWY_DAILY_READ_FAILED)
+                    : job->status == 401 || job->status == 403 ? tr(STR_WORKFLOWY_AUTH_FAILED)
+                                                               : tr(STR_WORKFLOWY_NETWORK_FAILED);
+        }
+      }
+      if (job->status == 200) {
+        changed |= replaceSiblings(rows, job->parent, job->children);
+        for (auto& view : viewStack) {
+          if (!job->parent.empty() || view.zoomId.empty()) replaceSiblings(view.rows, job->parent, job->children);
+        }
+        layoutDirty |= changed;
+      } else {
+        for (auto& row : rows) {
+          if (row.id == job->parent) row.checkedAt = now;
+        }
+      }
+    }
+    if (changed) requestUpdate();
+    return;
+  }
+  if (static_cast<long>(now - nextPrefetchAt) < 0 || credential.empty() || date.empty() || !online) return;
+  std::string parent;
+  unsigned depth = 0;
+  const bool root = now - rootCheckedAt >= SYNC_INTERVAL;
+  {
+    RenderLock lock(*this);
+    if (root) {
+      parent = zoomId;
+      depth = zoomId.empty() ? 0 : 1;
+    } else {
+      if (layoutDirty || page != paintedPage || page >= pageStarts.size()) return;
+      const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+      for (auto i = pageStarts[page]; i < end; ++i) {
+        const auto& node = rows[placements[i].row];
+        if (node.id != zoomId && (!node.checkedAt || now - node.checkedAt >= SYNC_INTERVAL)) {
+          parent = node.id;
+          depth = node.depth + 1;
+          break;
+        }
+      }
+      if (parent.empty()) {
+        nextPrefetchAt = now + 250;
+        return;
+      }
+    }
+  }
+  auto job = makeUniqueNoThrow<Prefetch>();
+  nextPrefetchAt = now + 5000;
+  if (!job) return;
+  job->key = credential;
+  job->target = parent.empty() ? date : parent;
+  job->parent = std::move(parent);
+  job->generation = generation;
+  job->depth = depth;
+  job->root = root;
+  prefetch = std::move(job);
+  auto holder = makeUniqueNoThrow<std::shared_ptr<Prefetch>>(prefetch);
+  if (!holder) {
+    prefetch.reset();
+    return;
+  }
+  // The task owns the argument and touches no activity or renderer state.
+  auto* argument = holder.release();
+  if (xTaskCreate(prefetchTask, "wf-prefetch", 8192, argument, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete argument;
+    prefetch.reset();
+    return;
+  }
+  nextPrefetchAt = now + 250;
+}
+
+void WorkflowyDailyActivity::loop() {
+  using Button = MappedInputManager::Button;
+  using Swipe = MappedInputManager::SwipeDir;
+  if (mappedInput.wasReleased(Button::Back)) return back();
+  if (step == Step::Start) return connect();
+  if (step == Step::Load) return loadDay();
+  if (step != Step::Ready || loading) return;
+  const auto now = millis();
+  if (static_cast<long>(now - nextLinkCheck) >= 0) {
+    nextLinkCheck = now + 500;
+    const bool connected = hasActiveStationWifiConnection();
+    if (connected != online) {
+      {
+        RenderLock lock(*this);
+        online = connected;
+      }
+      if (connected && !awaitingOutline) loadDay();
+      else requestUpdate();
+    }
+  }
+  if (mappedInput.wasReleased(Button::Up)) return nextPage(-1);
+  if (mappedInput.wasReleased(Button::Down)) return nextPage(1);
+  int x = 0, y = 0;
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    tracking = true;
+    dragRow = -1;
+    moved = false;
+    touchX = lastX = x;
+    touchY = lastY = y;
+    touchAt = millis();
+  }
+  if (tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    lastX = x;
+    lastY = y;
+    const int dx = std::abs(x - touchX), dy = std::abs(y - touchY);
+    if (!moved && dragRow < 0 && millis() - touchAt >= 550) dragRow = rowAt(touchX, touchY);
+    moved |= std::max(dx, dy) > 26;
+    if (online && dragRow >= 0 && (dragging || dy > 26)) {
+      dragging = true;
+      const int over = rowAt(x, y);
+      const int nextDrop = over >= 0 && over != dragRow && parentRow(over) == parentRow(dragRow) ? over : -1;
+      const bool inside = nextDrop >= 0 && x - touchX >= 32 && rows[nextDrop].depth < 8;
+      bool changed;
+      {
+        RenderLock lock(*this);
+        changed = dropRow != nextDrop || dropInside != inside;
+        dropInside = inside;
+        dropRow = nextDrop;
+        dropAfter = nextDrop > dragRow;
+      }
+      if (changed) requestUpdate();
+      return;
+    }
+  }
+  Swipe swipe = Swipe::None;
+  int swipeX = 0, swipeY = 0, endX = 0, endY = 0;
+  const bool sdkSwipe = mappedInput.wasSwipeWithPoints(swipe, swipeX, swipeY, endX, endY);
+  const bool release = mappedInput.wasScreenTouchReleased();
+  if (dragging) {
+    if (!release && !sdkSwipe) return;
+    tracking = false;
+    dragging = false;
+    int target;
+    bool after, inside;
+    {
+      RenderLock lock(*this);
+      target = dropRow;
+      after = dropAfter;
+      inside = dropInside;
+      dropRow = -1;
+    }
+    requestUpdate();
+    if (target >= 0) {
+      if (inside) indent(dragRow, target);
+      else reorder(dragRow, target, after);
+    }
+    return;
+  }
+  if (swipe == Swipe::None && release && tracking) {
+    const int dx = lastX - touchX, dy = lastY - touchY;
+    if (std::max(std::abs(dx), std::abs(dy)) >= 40)
+      swipe = std::abs(dx) > std::abs(dy) ? (dx < 0 ? Swipe::Left : Swipe::Right) : (dy < 0 ? Swipe::Up : Swipe::Down);
+  }
+  if (swipe != Swipe::None) {
+    const int row = sdkSwipe ? rowAt(swipeX, swipeY) : rowAt(touchX, touchY);
+    tracking = false;
+    if (swipe == Swipe::Up || swipe == Swipe::Down) return nextPage(swipe == Swipe::Up ? 1 : -1);
+    if (row >= 0) {
+      if (swipe == Swipe::Right) toggle(row);
+      else actions(row);
+    }
+    return;
+  }
+  if (!release || !tracking) {
+    if (!tracking && !release) {
+      if (online && !pendingDelete.empty() && static_cast<long>(millis() - deleteAt) >= 0) commitDelete();
+      else if (online && pendingCount && !outboxUncertain && !prefetch &&
+               static_cast<long>(millis() - retryOutboxAt) >= 0) flushCapture();
+      else pollPrefetch();
+    }
+    return;
+  }
+  tracking = false;
+  if (moved) return;
+  const bool held = millis() - touchAt >= 550;
+  if (!held && !mappedInput.wasScreenTapped(x, y)) return;
+  x = touchX;
+  y = touchY;
+  const auto bounds = layout();
+  if (outboxUncertain && y >= bounds.top + 5 && y < bounds.top + 29 &&
+      x >= bounds.x + bounds.width / 4 && x < bounds.x + bounds.width * 3 / 4) return reviewCapture();
+  if (!zoomId.empty() && y >= bounds.top + 30 && y < bounds.rowTop && x < bounds.x + ICON_TARGET) return back();
+  if (undoReady && y >= bounds.top + 28 && y < bounds.rowTop &&
+      x >= bounds.x + bounds.width - 2 * ICON_TARGET && x < bounds.x + bounds.width - ICON_TARGET) return undo();
+  if (y < bounds.rowTop && x >= bounds.x + bounds.width - ICON_TARGET) {
+    if (!credential.empty() && !rows.empty()) chooseDate();
+    else if (!credential.empty() && !date.empty() && hasActiveStationWifiConnection()) chooseDate();
+    return;
+  }
+  if (y >= bounds.rowBottom && y < bounds.footer && pageStarts.size() > 1) {
+    const int zone = (x - bounds.x) * 8 / bounds.width;
+    if (zone >= 0 && zone < 2) return nextPage(-1, zone == 0);
+    if (zone >= 6 && zone < 8) return nextPage(1, zone == 7);
+  }
+  if (y >= bounds.footer) {
+    const int control = std::clamp((x - bounds.x) * 5 / bounds.width, 0, 4);
+    if (control == 0) return back();
+    if (control == 1) {
+      if (held) editKey();
+      else if (hasActiveStationWifiConnection() && !credential.empty()) step = Step::Load;
+      else step = Step::Start;
+    }
+    if (control == 2 && !credential.empty() && !date.empty()) edit(rows.size());
+    if (control == 3) {
+      {
+        RenderLock lock(*this);
+        showDone = !showDone;
+        layoutDirty = true;
+        page = 0;
+      }
+      requestUpdate();
+    }
+    if (control == 4) {
+      {
+        RenderLock lock(*this);
+        if (page < pageStarts.size() && pageStarts[page] < placements.size())
+          wrapAnchor = static_cast<int>(placements[pageStarts[page]].row);
+        wrapItems = !wrapItems;
+        layoutDirty = true;
+      }
+      requestUpdate();
+    }
+    return;
+  }
+  const int row = rowAt(x, y);
+  if (row < 0) return;
+  const int indent = std::min<unsigned>(rows[row].depth, 8) * 16;
+  if (held) actions(row);
+  else if (x >= bounds.x + bounds.width - ROW_ARROW_TARGET && !rows[row].leaf) expand(row);
+  else if (rows[row].todo && x < bounds.x + indent + 30) toggle(row);
+  else {
+    size_t cursor = std::string::npos;
+    if (wrapItems) {
+      RenderLock lock(*this);
+      const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+      for (auto i = pageStarts[page]; i < end; ++i) {
+        const auto& placement = placements[i];
+        if (placement.row != static_cast<size_t>(row) || y < placement.top || y >= placement.bottom) continue;
+        const auto line = std::min(placement.lineCount - 1,
+                                  static_cast<size_t>(std::max(0, y - placement.top - 6) / bounds.lineHeight));
+        cursor = cursorAt(rows[row].title, outlineLines[placement.firstLine + line], x - bounds.x - indent - 25);
+        break;
+      }
+    }
+    edit(row, 0, cursor);
+  }
+}
+
+void WorkflowyDailyActivity::render(RenderLock&&) {
+  const auto bounds = layout();
+  renderer.clearScreen();
+  GUI.drawDisplayStatusBar(renderer, bounds.top);
+  std::string heading = date.empty() || date == "today" ? tr(STR_WORKFLOWY_TODAY) : date;
+  if (date == isoDate(-1) && !date.empty()) heading += std::string("  ") + tr(STR_WORKFLOWY_YESTERDAY);
+  if (date == isoDate(0) && !date.empty()) heading += std::string("  ") + tr(STR_WORKFLOWY_TODAY);
+  if (date == isoDate(1) && !date.empty()) heading += std::string("  ") + tr(STR_WORKFLOWY_TOMORROW);
+  if (!zoomId.empty()) heading = std::string("‹  ") + tr(STR_WORKFLOWY);
+  unsigned remaining = 0, totalTodos = 0;
+  const unsigned outlineDepth = zoomId.empty() ? 0 : 1;
+  for (const auto& row : rows) {
+    if (row.depth == outlineDepth && row.todo) {
+      ++totalTodos;
+      if (!row.done) ++remaining;
+    }
+  }
+  char todoCount[24];
+  snprintf(todoCount, sizeof(todoCount), "%u/%u", remaining, totalTodos);
+  const int countX = bounds.x + bounds.width - (undoReady ? 2 : 1) * ICON_TARGET - 8 - renderer.getTextWidth(SMALL_FONT_ID, todoCount);
+  const auto fittedHeading = renderer.truncatedText(UI_12_FONT_ID, heading.c_str(), countX - bounds.x - 8,
+                                                     EpdFontFamily::BOLD);
+  renderer.drawText(UI_12_FONT_ID, bounds.x, bounds.top + 32, fittedHeading.c_str(), true, EpdFontFamily::BOLD);
+  renderer.drawText(SMALL_FONT_ID, countX, bounds.top + 36, todoCount);
+  const int cx = bounds.x + bounds.width - 23, cy = bounds.top + 46;
+  if (undoReady) {
+    const int ux = cx - ICON_TARGET;
+    renderer.drawLine(ux - 10, cy - 3, ux + 4, cy - 3, 2, true);
+    renderer.drawLine(ux + 4, cy - 3, ux + 9, cy + 2, 2, true);
+    renderer.drawLine(ux + 9, cy + 2, ux + 4, cy + 8, 2, true);
+    renderer.drawLine(ux + 4, cy + 8, ux - 3, cy + 8, 2, true);
+    renderer.drawLine(ux - 10, cy - 3, ux - 4, cy - 9, 2, true);
+    renderer.drawLine(ux - 10, cy - 3, ux - 4, cy + 3, 2, true);
+  }
+  renderer.drawRect(cx - 10, cy - 9, 21, 19);
+  renderer.drawLine(cx - 10, cy - 3, cx + 10, cy - 3);
+  renderer.drawLine(cx - 5, cy - 12, cx - 5, cy - 6);
+  renderer.drawLine(cx + 5, cy - 12, cx + 5, cy - 6);
+  renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+  layoutRows(bounds);
+  paintedPage = page;
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  for (auto i = pageStarts[page]; i < end; ++i) {
+    const auto& placement = placements[i];
+    const auto& node = rows[placement.row];
+    const int y = placement.top + 6;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int start = bounds.x + indent;
+    if (node.depth) renderer.drawLine(start - 7, y - 5, start - 7, placement.bottom - 1);
+    if (node.todo) {
+      if (node.done) {
+        renderer.fillRect(start + 1, y + 4, 18, 18);
+        renderer.drawLine(start + 5, y + 12, start + 8, y + 15, 2, false);
+        renderer.drawLine(start + 8, y + 15, start + 14, y + 8, 2, false);
+      } else {
+        renderer.drawRect(start + 1, y + 4, 18, 18);
+      }
+    } else {
+      renderer.fillRect(start + 6, y + 11, 5, 5);
+    }
+    const int textX = start + 25;
+    const auto title = std::string_view(node.title);
+    for (size_t line = 0; line < placement.lineCount; ++line) {
+      auto span = outlineLines[placement.firstLine + line];
+      const int lineY = y + static_cast<int>(line) * bounds.lineHeight;
+      std::string text;
+      if (wrapItems) {
+        text = title.substr(span.begin, span.end - span.begin);
+      } else {
+        const int width = bounds.x + bounds.width - textX - ROW_ARROW_TARGET;
+        text = renderer.truncatedText(UI_12_FONT_ID, node.title.c_str(), width);
+        if (text != title && text.ends_with("…")) span.end = text.size() - 3;
+      }
+      const auto measure = [&](size_t end) {
+        return renderer.getTextWidth(UI_12_FONT_ID, std::string(title.substr(span.begin, end - span.begin)).c_str());
+      };
+      workflowy::forEachTag(title, [&](workflowy::TextSpan tag) {
+        if (tag.end <= span.begin || tag.begin >= span.end) return;
+        const int startX = textX + measure(std::max(tag.begin, span.begin));
+        const int endX = textX + measure(std::min(tag.end, span.end));
+        if (endX - startX > 2)
+          renderer.fillRectDither(startX + 1, lineY, endX - startX - 2, bounds.lineHeight, Color::LightGray);
+      });
+      renderer.drawText(UI_12_FONT_ID, textX, lineY, text.c_str());
+      if (node.done)
+        renderer.drawLine(textX, lineY + 12, textX + renderer.getTextWidth(UI_12_FONT_ID, text.c_str()), lineY + 12);
+    }
+    if (static_cast<int>(placement.row) == dropRow) {
+      const int marker = dropAfter || dropInside ? placement.bottom - 1 : placement.top;
+      renderer.drawLine(start + (dropInside ? 16 : 0), marker, bounds.x + bounds.width - 1, marker, 2, true);
+    }
+    if (!node.leaf) {
+      const int tipX = bounds.x + bounds.width - 10;
+      const int xs[3] = {tipX - 5, tipX + 4, node.expanded ? tipX : tipX - 5};
+      const int ys[3] = {y + 8, node.expanded ? y + 8 : y + 13, y + 18};
+      if (node.childrenConfirmed) {
+        renderer.fillPolygon(xs, ys, 3, true);
+      } else {
+        renderer.drawLine(tipX - 5, y + 8, tipX + 1, y + 13);
+        renderer.drawLine(tipX + 1, y + 13, tipX - 5, y + 18);
+      }
+    }
+  }
+  const auto total = pageStarts.size();
+  if (!online || pendingCount) {
+    char status[48];
+    if (outboxUncertain) snprintf(status, sizeof(status), "%s", tr(STR_WORKFLOWY_SYNC_CHECK));
+    else if (pendingCount) snprintf(status, sizeof(status), "%s · %u",
+                                    (online ? tr(STR_WORKFLOWY_PENDING) : tr(STR_WORKFLOWY_OFFLINE)),
+                                    static_cast<unsigned>(pendingCount));
+    else snprintf(status, sizeof(status), "%s", tr(STR_WORKFLOWY_OFFLINE));
+    const int width = renderer.getTextWidth(SMALL_FONT_ID, status) + 16;
+    const int x = bounds.x + (bounds.width - width) / 2;
+    renderer.drawRoundedRect(x, bounds.top + 5, width, 24, 1, 7, true);
+    renderer.drawText(SMALL_FONT_ID, x + 8, bounds.top + 8, status);
+  }
+  if (awaitingOutline || message || total > 1 || placements.empty()) {
+    char pages[24];
+    snprintf(pages, sizeof(pages), "%u/%u", static_cast<unsigned>(page + 1), static_cast<unsigned>(total));
+    const char* footer = awaitingOutline ? tr(STR_LOADING_POPUP)
+                                         : message ? message : (placements.empty() ? tr(STR_WORKFLOWY_EMPTY) : pages);
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer - renderer.getLineHeight(SMALL_FONT_ID) - 2, footer);
+  }
+  if (total > 1) {
+    const int y = (bounds.rowBottom + bounds.footer) / 2;
+    for (const int direction : {-1, 1}) {
+      const bool enabled = direction < 0 ? page > 0 : page + 1 < total;
+      if (!enabled) continue;
+      for (const bool edge : {false, true}) {
+        const int slot = direction < 0 ? (edge ? 0 : 1) : (edge ? 7 : 6);
+        const int x = bounds.x + (2 * slot + 1) * bounds.width / 16;
+        const int tip = x + direction * 4;
+        renderer.drawLine(x - direction * 4, y - 6, tip, y, 2, true);
+        renderer.drawLine(tip, y, x - direction * 4, y + 6, 2, true);
+        if (edge) renderer.drawLine(tip + direction * 4, y - 6, tip + direction * 4, y + 6, 2, true);
+      }
+    }
+  }
+  renderer.drawLine(bounds.x, bounds.footer, bounds.x + bounds.width - 1, bounds.footer);
+  const int iconY = bounds.footer + 23;
+  const auto iconX = [&](int slot) { return bounds.x + (2 * slot + 1) * bounds.width / 10; };
+  int x = iconX(0);
+  renderer.drawLine(x - 9, iconY, x + 9, iconY, 2, true);
+  renderer.drawLine(x - 9, iconY, x - 3, iconY - 6, 2, true);
+  renderer.drawLine(x - 9, iconY, x - 3, iconY + 6, 2, true);
+  x = iconX(1);
+  renderer.drawText(UI_12_FONT_ID, x - 8, iconY - 13, "↻");
+  x = iconX(2);
+  renderer.drawLine(x - 8, iconY, x + 8, iconY, 2, true);
+  renderer.drawLine(x, iconY - 8, x, iconY + 8, 2, true);
+  x = iconX(3);
+  renderer.drawRect(x - 9, iconY - 9, 18, 18);
+  if (showDone) {
+    renderer.drawLine(x - 5, iconY, x - 1, iconY + 4, 2, true);
+    renderer.drawLine(x - 1, iconY + 4, x + 5, iconY - 4, 2, true);
+  }
+  x = iconX(4);
+  if (wrapItems) renderer.fillRoundedRect(x - 15, iconY - 13, 30, 26, 4, Color::LightGray);
+  renderer.drawLine(x - 9, iconY - 6, x + 8, iconY - 6, 2, true);
+  renderer.drawLine(x + 8, iconY - 6, x + 8, iconY + 3, 2, true);
+  renderer.drawLine(x - 7, iconY + 3, x + 8, iconY + 3, 2, true);
+  renderer.drawLine(x - 7, iconY + 3, x - 3, iconY - 1, 2, true);
+  renderer.drawLine(x - 7, iconY + 3, x - 3, iconY + 7, 2, true);
+  if (loading) GUI.drawPopup(renderer, tr(STR_LOADING_POPUP));
+  else renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
