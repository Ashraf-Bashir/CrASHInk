diff --git a/src/StatusIconRow.h b/src/StatusIconRow.h
new file mode 100644
--- /dev/null
+++ b/src/StatusIconRow.h
@@ -0,0 +1,113 @@
+#pragma once
+
+#include <cstdint>
+
+// Layout of the small icons at the left of the reader's top status bar
+// (frontlight shortcut, touchscreen toggle, Readest sync, highlighter, and
+// whatever gets added later). Pure arithmetic with no hardware access, so the
+// drawing code and the tap tests always agree on where each icon is.
+//
+// Icons are placed left to right in the order the user chose in
+// CrASHink > Status Bar Icons. An icon takes room only while it is shown: one
+// the user turned off, or one the device cannot use right now, is skipped and
+// the icons after it close up. Nothing keeps a blank slot.
+//
+// To add an icon: append a Slot before Count, give it a name string in
+// StatusIconsActivity, and draw it at Layout::x(slot) when Layout::visible(slot).
+// Saved orders that lack the new slot are repaired automatically, and the new
+// icon starts enabled at the end of the row.
+namespace StatusIconRow {
+
+enum Slot : uint8_t { Lamp = 0, Touch = 1, Readest = 2, Highlighter = 3, Count = 4 };
+
+constexpr int kIconSize = 20;
+constexpr int kGap = 8;
+// Extra room in front of icons drawn with no built-in blank margin (the R box
+// and the highlighter), so gaps look even next to the bitmap icons.
+constexpr int kVisualPad = 6;
+// How far past the last icon a tap still counts as a tap on it.
+constexpr int kEdgeTap = 24;
+constexpr uint8_t kAllMask = static_cast<uint8_t>((1u << Count) - 1u);
+
+inline bool needsVisualPad(const uint8_t slot) { return slot == Readest || slot == Highlighter; }
+
+// True when order holds every slot exactly once.
+inline bool isValidOrder(const uint8_t* order) {
+  uint8_t seen = 0;
+  for (uint8_t i = 0; i < Count; ++i) {
+    if (order[i] >= Count || (seen & (1u << order[i]))) return false;
+    seen |= static_cast<uint8_t>(1u << order[i]);
+  }
+  return seen == kAllMask;
+}
+
+inline void resetOrder(uint8_t* order) {
+  for (uint8_t i = 0; i < Count; ++i) order[i] = i;
+}
+
+// Makes any stored order usable: an invalid one becomes the default order.
+inline void sanitizeOrder(uint8_t* order) {
+  if (!isValidOrder(order)) resetOrder(order);
+}
+
+struct Layout {
+  uint8_t order[Count] = {0, 1, 2, 3};
+  uint8_t enabledMask = kAllMask;    // what the user switched on
+  uint8_t availableMask = kAllMask;  // what the device can show right now
+  int leftX = 0;
+
+  bool visible(const uint8_t slot) const {
+    return slot < Count && (enabledMask & availableMask & (1u << slot)) != 0;
+  }
+
+  // Left edge of the slot's icon, or -1 when it is not shown.
+  int x(const uint8_t slot) const {
+    if (!visible(slot)) return -1;
+    int cursor = leftX;
+    bool first = true;
+    for (uint8_t i = 0; i < Count; ++i) {
+      const uint8_t s = order[i];
+      if (!visible(s)) continue;
+      if (!first && needsVisualPad(s)) cursor += kVisualPad;
+      if (s == slot) return cursor;
+      cursor += kIconSize + kGap;
+      first = false;
+    }
+    return -1;
+  }
+
+  // Horizontal tap zone of a shown icon. The zones of neighbouring icons meet
+  // in the middle of the gap between them, the first starts at the screen edge
+  // and the last reaches kEdgeTap past its icon, so they never overlap.
+  // Returns false when the icon is not shown.
+  bool hitRange(const uint8_t slot, int& left, int& right) const {
+    if (!visible(slot)) return false;
+    int prevRight = -1;
+    int nextLeft = -1;
+    bool seenSelf = false;
+    for (uint8_t i = 0; i < Count; ++i) {
+      const uint8_t s = order[i];
+      if (!visible(s)) continue;
+      if (s == slot) {
+        seenSelf = true;
+      } else if (!seenSelf) {
+        prevRight = x(s) + kIconSize;
+      } else if (nextLeft < 0) {
+        nextLeft = x(s);
+      }
+    }
+    const int self = x(slot);
+    left = prevRight < 0 ? 0 : prevRight + (self - prevRight) / 2;
+    const int selfRight = self + kIconSize;
+    right = nextLeft < 0 ? selfRight + kEdgeTap : selfRight + (nextLeft - selfRight) / 2;
+    return true;
+  }
+
+  bool hits(const uint8_t slot, const int touchX) const {
+    int left = 0;
+    int right = 0;
+    return hitRange(slot, left, right) && touchX >= left && touchX < right;
+  }
+};
+
+}  // namespace StatusIconRow
