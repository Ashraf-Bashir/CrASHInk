diff --git a/src/activities/reader/CollapsibleToc.h b/src/activities/reader/CollapsibleToc.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/CollapsibleToc.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+class CollapsibleToc {
+ public:
+  std::vector<uint8_t> levels;
+  std::vector<uint8_t> expanded;
+  std::vector<uint16_t> visible;
+  bool hasChildren(size_t index) const { return index + 1 < levels.size() && levels[index + 1] > levels[index]; }
+  void reset(std::vector<uint8_t> depths, int current) {
+    levels = std::move(depths);
+    expanded.assign(levels.size(), 0);
+    visible.clear();
+    visible.reserve(levels.size());
+    if (current < 0 || current >= static_cast<int>(levels.size())) current = -1;
+    // Open only the current chapter's ancestor chain, not unrelated branches.
+    for (int i = current - 1, depth = current >= 0 && current < static_cast<int>(levels.size()) ? levels[current] : -1;
+         i >= 0; --i) {
+      if (levels[i] < depth) {
+        expanded[i] = 1;
+        depth = levels[i];
+      }
+    }
+    rebuild();
+  }
+  void rebuild() {
+    visible.clear();
+    int hiddenLevel = -1;
+    for (size_t i = 0; i < levels.size(); ++i) {
+      if (hiddenLevel >= 0 && levels[i] > hiddenLevel) continue;
+      hiddenLevel = -1;
+      visible.push_back(static_cast<uint16_t>(i));
+      if (hasChildren(i) && !expanded[i]) hiddenLevel = levels[i];
+    }
+  }
+  bool toggle(size_t index) {
+    if (!hasChildren(index)) return false;
+    expanded[index] = !expanded[index];
+    rebuild();
+    return true;
+  }
+  int rowFor(size_t index) const {
+    const auto it = std::find(visible.begin(), visible.end(), index);
+    return it == visible.end() ? 0 : static_cast<int>(it - visible.begin());
+  }
+};
