new file mode 100644
--- /dev/null
+++ b/test/collapsible_toc/CollapsibleTocTest.cpp
@@ -0,0 +1,30 @@
+#include <cassert>
+#include <iostream>
+
+#include "activities/reader/CollapsibleToc.h"
+int main() {
+  CollapsibleToc toc;
+  toc.reset({1, 2, 3, 2, 1, 2}, -1);
+  assert((toc.visible == std::vector<uint16_t>{0, 4}));
+  toc.toggle(0);
+  assert((toc.visible == std::vector<uint16_t>{0, 1, 3, 4}));
+  toc.toggle(1);
+  assert((toc.visible == std::vector<uint16_t>{0, 1, 2, 3, 4}));
+  toc.toggle(0);
+  assert((toc.visible == std::vector<uint16_t>{0, 4}));
+  toc.toggle(0);
+  assert((toc.visible == std::vector<uint16_t>{0, 1, 2, 3, 4}));
+  assert(!toc.toggle(2));
+  toc.reset({1, 2, 3, 2, 1, 2}, 2);
+  assert(toc.expanded[0] && toc.expanded[1]);
+  assert(toc.visible[toc.rowFor(2)] == 2);
+  toc.reset({2, 4, 3, 2}, -1);
+  assert((toc.visible == std::vector<uint16_t>{0, 3}));
+  toc.toggle(0);
+  assert(toc.visible.size() == 4);
+  toc.reset({}, 999);
+  assert(toc.visible.empty());
+  toc.reset({1, 1, 1}, -1);
+  assert(toc.visible.size() == 3);
+  std::cout << "Collapsible chapter tests passed\n";
+}
