+uint32_t ReadestSyncActivity::encodeBootPayload(const uint8_t orientation) {
+  return orientation < CrossPointSettings::ORIENTATION_COUNT ? static_cast<uint32_t>(orientation) + 1 : 0;
+}
+
+uint8_t ReadestSyncActivity::decodeBootOrientation(const uint32_t payload) {
+  const uint32_t bits = payload & 0xFF;
+  return bits > 0 && bits <= CrossPointSettings::ORIENTATION_COUNT ? static_cast<uint8_t>(bits - 1)
+                                                                   : CrossPointSettings::ORIENTATION_COUNT;
+}
+
+void ReadestSyncActivity::onEnter() {
+  Activity::onEnter();
+
+  const bool hasReaderOrientation = readerOrientation < CrossPointSettings::ORIENTATION_COUNT;
+  if (restartBeforeNetwork) {
+    // The network reboot restores the frontlight from the saved setting; make
+    // sure it matches the light the user actually has on.
+    const uint8_t lightOn = Frontlight.isOn() ? 1 : 0;
+    if (SETTINGS.frontlightOn != lightOn) {
+      SETTINGS.frontlightOn = lightOn;
+      activityManager.persistGlobalSettings();
+    }
+    if (hasReaderOrientation) ReaderUtils::applyOrientation(renderer, readerOrientation);
+    silentRestartToNetwork(NetworkBootTarget::READEST_SYNC, encodeBootPayload(readerOrientation));
+    return;
+  }
+
+  LOG_INF("RDS", "network entry free=%u maxAlloc=%u", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
+  ReaderUtils::applyOrientation(renderer, hasReaderOrientation ? readerOrientation : SETTINGS.orientation);
+
+  if (!READEST_STORE.hasCredentials()) {
+    fail(tr(STR_READEST_ERR_NO_CREDENTIALS));
+    return;
+  }
+
+  sdFontSystem.releaseLoadedFont(renderer);
+  wifiActivated = true;
+
+  if (hasActiveStationWifiConnection()) {
+    onWifiSelectionComplete(true);
+    return;
+  }
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput, true, true),
+                         [this](const ActivityResult& result) { onWifiSelectionComplete(!result.isCancelled); });
+}
+
+void ReadestSyncActivity::onExit() {
+  Activity::onExit();
+  if (restartBeforeNetwork) return;
+
+  CLIPPINGS.unload();
+  removeReadestCopy();
+  epub.reset();
+  if (wifiActivated) wifiOff();
+  // Always return through a clean reboot; this instance only exists in the
+  // lean network boot.
+  silentRestartToReader(true);
+}
+
+void ReadestSyncActivity::onWifiSelectionComplete(const bool success) {
+  if (!success) {
+    LOG_DBG("RDS", "WiFi connection failed, returning to reader");
+    returnToReader();
+    return;
+  }
+
+  WiFi.setSleep(false);
+  sdFontSystem.releaseForNetwork(renderer);
+
+  {
+    RenderLock lock(*this);
+    state = WORKING;
+    statusMessage = tr(STR_READEST_FINDING_BOOK);
+  }
+  if (requestUpdateAndWait() != RequestUpdateResult::Rendered) {
+    requestUpdate(true);
+  }
+
+  // Real wall-clock time for note and position timestamps.
+  if (!halClock.syncSystemTimeFromNTP()) {
+    LOG_DBG("RDS", "NTP sync unavailable; Readest will stamp records itself");
+  }
+
+  runSync();
+}
+
+void ReadestSyncActivity::setStatus(const char* message) {
+  {
+    RenderLock lock(*this);
+    statusMessage = message;
+  }
+  if (requestUpdateAndWait() != RequestUpdateResult::Rendered) {
+    requestUpdate(true);
+  }
+}
+
+void ReadestSyncActivity::fail(std::string detail) {
+  {
+    RenderLock lock(*this);
+    state = FAILED;
+    statusMessage = tr(STR_READEST_SYNC_FAILED);
+    detailMessage = std::move(detail);
+  }
+  requestUpdate(true);
+}
+
+void ReadestSyncActivity::runSync() {
+  epub = std::make_shared<Epub>(epubPath, "/.crosspoint");
+  epub->setupCacheDir();
+  // Metadata only: spine/TOC lookups and chapter streaming need no CSS or layout.
+  if (!epub->load(false, true, Epub::XLocationLoadMode::Immediate, true)) {
+    LOG_ERR("RDS", "Failed to load epub %s", epubPath.c_str());
+    epub.reset();
+    fail(tr(STR_READEST_OPEN_BOOK_FAILED));
+    return;
+  }
+
+  localHash = KOReaderDocumentId::calculate(epubPath);
+  ReadestBook book;
+  if (ReadestBookMap::lookup(localHash, book)) {
+    LOG_INF("RDS", "Using saved match \"%s\" (%s)", book.title.c_str(), book.hash.c_str());
+    syncWithBook(book);
+    return;
+  }
+
+  const auto found = client.findCandidates(epub->getTitle(), epub->getAuthor(), localHash, candidates);
+  if (found != ReadestClient::OK) {
+    std::string detail = ReadestClient::errorString(found);
+    if (found == ReadestClient::BOOK_NOT_FOUND) detail += ": " + epub->getTitle();
+    fail(std::move(detail));
+    return;
+  }
+
+  // Only ask when in doubt: an identical file, or a word-for-word title match
+  // clearly ahead of the runner-up, is taken (and remembered) straight away.
+  const int runnerUp = candidates.size() > 1 ? candidates[1].score : 0;
+  const int bestScore = candidates.front().score;
+  if (bestScore >= ReadestClient::SCORE_SAME_FILE ||
+      (bestScore >= ReadestClient::SCORE_CONFIDENT && bestScore - runnerUp >= ReadestClient::SCORE_CLEAR_LEAD)) {
+    book = candidates.front();
+    candidates.clear();
+    LOG_INF("RDS", "Auto-matched \"%s\" (score %d, runner-up %d)", book.title.c_str(), bestScore, runnerUp);
+    ReadestBookMap::remember(localHash, book);
+    syncWithBook(book);
+    return;
+  }
+  showChooser();
+}
+
+void ReadestSyncActivity::showChooser() {
+  std::vector<std::string> labels;
+  labels.reserve(candidates.size());
+  for (const auto& candidate : candidates) {
+    std::string label = candidate.title.empty() ? candidate.hash : candidate.title;
+    if (!candidate.author.empty()) label += " - " + candidate.author;
+    labels.push_back(std::move(label));
+  }
+
+  {
+    RenderLock lock(*this);
+    state = CHOOSING;
+    statusMessage = tr(STR_READEST_CHOOSE_BOOK);
+    detailMessage = epub->getTitle();
+    chosenIndex = -1;
+    choiceCancelled = false;
+    chooser.show(tr(STR_READEST_CHOOSE_BOOK), labels, 0, [this](const int index) { chosenIndex = index; });
+    chooser.setCancelCallback([this] { choiceCancelled = true; });
+  }
+  requestUpdate(true);
+}
+
+bool ReadestSyncActivity::openReadestCopy(const ReadestBook& book) {
+  readestCopyMissing = false;
+  if (!localHash.empty() && localHash == book.hash) {
+    readestEpub = epub;  // byte-identical file
+    return true;
+  }
+
+  // Readest's copy only lives for the duration of this sync (see
+  // removeReadestCopy()); nothing accumulates on the SD card.
+  removeReadestCopy();
+  setStatus(tr(STR_READEST_DOWNLOADING_BOOK));
+  const auto result = client.downloadBook(book, READEST_COPY_PATH);
+  if (result != ReadestClient::OK) {
+    LOG_ERR("RDS", "Readest copy unavailable (%d); matching against the device copy", static_cast<int>(result));
+    readestEpub = epub;
+    readestCopyMissing = true;
+    return true;
+  }
+
+  auto copy = std::make_shared<Epub>(READEST_COPY_PATH, "/.crosspoint");
+  copy->setupCacheDir();
+  // Spine/TOC only: the copy is never rendered, just streamed for text.
+  if (!copy->load(true, true, Epub::XLocationLoadMode::Skip, true)) {
+    LOG_ERR("RDS", "Cannot open Readest copy");
+    copy.reset();
+    removeReadestCopy();
+    readestEpub = epub;
+    readestCopyMissing = true;
+    return true;
+  }
+  readestEpub = std::move(copy);
+  return true;
+}
+
+void ReadestSyncActivity::removeReadestCopy() {
+  if (readestEpub && readestEpub != epub) readestEpub.reset();
+  // The temporary file and the metadata cache CrossInk builds when opening it.
+  Storage.remove(READEST_COPY_PATH);
+  const std::string cache = Epub::cachePathForFilePath(READEST_COPY_PATH, "/.crosspoint");
+  if (Storage.exists(cache.c_str())) Storage.removeDir(cache.c_str());
+}
+
+void ReadestSyncActivity::removeLegacyReadestCopies() {
+  // Earlier builds kept full copies as /.crosspoint/readest_<hash>.epub.
+  for (const std::string& hash : ReadestBookMap::allReadestHashes()) {
+    const std::string path = "/.crosspoint/readest_" + hash + ".epub";
+    if (!Storage.exists(path.c_str())) continue;
+    Storage.remove(path.c_str());
+    const std::string cache = Epub::cachePathForFilePath(path, "/.crosspoint");
+    if (Storage.exists(cache.c_str())) Storage.removeDir(cache.c_str());
+    LOG_INF("RDS", "Removed cached Readest copy %s", path.c_str());
+  }
+}
+
+void ReadestSyncActivity::syncWithBook(const ReadestBook& book) {
+  if (!CLIPPINGS.loadForBook(epubPath, epub->getTitle(), epub->getAuthor(), "epub")) {
+    fail(tr(STR_READEST_OPEN_BOOK_FAILED));
+    return;
+  }
+  removeLegacyReadestCopies();
+  openReadestCopy(book);
+
+  HighlightCounts counts;
+  if (!syncHighlights(book, counts)) {
+    removeReadestCopy();
+    return;
+  }
+  setStatus(tr(STR_READEST_SYNCING_POSITION));
+  const std::string position = syncPosition(book);
+  removeReadestCopy();
+
+  LOG_INF("RDS", "Sync done: pulled=%d pushed=%d removedHere=%d removedThere=%d skipped=%d", counts.pulled,
+          counts.pushed, counts.removedHere, counts.removedThere, counts.skipped);
+  std::string detail = formatCounts(tr(STR_READEST_SYNC_COUNTS_FORMAT), counts.pulled, counts.pushed);
+  if (counts.removedHere + counts.removedThere > 0) {
+    detail += "\n" + formatCount(tr(STR_READEST_REMOVED_FORMAT), counts.removedHere + counts.removedThere);
+  }
+  if (counts.skipped > 0) detail += "\n" + formatCount(tr(STR_READEST_SKIPPED_FORMAT), counts.skipped);
+  if (!position.empty()) detail += "\n" + position;
+  if (readestCopyMissing) detail += "\n" + std::string(tr(STR_READEST_COPY_MISSING));
+  {
+    RenderLock lock(*this);
+    state = DONE;
+    statusMessage = tr(STR_READEST_SYNC_DONE);
+    detailMessage = std::move(detail);
+    autoReturnAt = millis() + AUTO_RETURN_DELAY_MS;
+  }
+  requestUpdate(true);
+}
+
+bool ReadestSyncActivity::addPulledClipping(const ReadestNote& note, int& skipped) {
+  // Find Readest's text in the device copy, starting at the same relative
+  // spot of the book as in Readest's copy and widening to the whole book.
+  float hint = -1.0f;
+  if (readestEpub) {
+    const int sourceSpine = spineIndexFromNote(note);
+    if (sourceSpine >= 0 && sourceSpine < readestEpub->getSpineItemsCount()) {
+      hint = ChapterXPathResolver::bookFraction(readestEpub, sourceSpine, 0.5f);
+    }
+  }
+  int spine = -1;
+  XPathTextLocation location;
+  if (!ChapterXPathResolver::findTextInBook(epub, note.text, hint, -1, spine, location)) {
+    LOG_DBG("RDS", "Readest note %s not found in the device copy", note.id.c_str());
+    skipped++;
+    return true;
+  }
+
+  // Store the device's own wording so the reader's highlighter matches it.
+  std::string deviceText;
+  if (!ChapterXPathResolver::extractText(epub, spine, location, deviceText)) deviceText = note.text;
+
+  const uint16_t page =
+      location.total > 0
+          ? static_cast<uint16_t>(static_cast<uint64_t>(location.start) * (VIRTUAL_PAGE_COUNT - 1) / location.total)
+          : 0;
+  const int tocIndex = epub->getTocIndexForSpineIndex(spine);
+  const std::string chapterTitle = tocIndex >= 0 ? epub->getTocItem(tocIndex).title : "";
+
+  // layoutSignature 0 marks the range as layout-less: the reader matches the
+  // saved text on each page instead of trusting word indices.
+  const auto addResult =
+      CLIPPINGS.addClipping(static_cast<uint16_t>(spine), page, page, VIRTUAL_PAGE_COUNT, 0, 0, countWords(deviceText),
+                            chapterTitle.c_str(), UINT16_MAX, deviceText, UINT16_MAX, 0);
+  if (addResult == ClippingStore::AddResult::LimitReached) {
+    LOG_ERR("RDS", "Clipping limit reached while pulling");
+    skipped++;
+    return true;
+  }
+  if (addResult == ClippingStore::AddResult::SaveFailed) {
+    fail(tr(STR_READEST_SAVE_FAILED));
+    return false;
+  }
+  return true;
+}
+
+bool ReadestSyncActivity::syncHighlights(const ReadestBook& book, HighlightCounts& counts) {
+  setStatus(tr(STR_READEST_PULLING));
+  std::vector<ReadestNote> remote;
+  const auto pulled = client.pullNotes(book, remote);
+  if (pulled != ReadestClient::OK) {
+    fail(ReadestClient::errorString(pulled));
+    return false;
+  }
+
+  std::vector<ReadestLinks::Link> links;
+  const bool hadLinks = ReadestLinks::load(localHash, links);
+
+  // Snapshot of the device clippings, identified by their loose text.
+  struct LocalClip {
+    std::string keyHash;
+    bool claimed = false;
+    bool remove = false;
+  };
+  std::vector<LocalClip> local(CLIPPINGS.clippingCount());
+  {
+    std::string text;
+    for (size_t i = 0; i < local.size(); ++i) {
+      text.clear();
+      if (CLIPPINGS.readClippingText(i, text)) local[i].keyHash = keyHashFor(text);
+    }
+  }
+  std::vector<std::string> remoteKeys;
+  remoteKeys.reserve(remote.size());
+  for (const auto& note : remote) remoteKeys.push_back(keyHashFor(note.text));
+
+  const auto findRemote = [&](const std::string& id) -> int {
+    for (size_t i = 0; i < remote.size(); ++i) {
+      if (remote[i].id == id) return static_cast<int>(i);
+    }
+    return -1;
+  };
+  const auto claimLocal = [&](const std::string& keyHash) -> int {
+    if (keyHash.empty()) return -1;
+    for (size_t i = 0; i < local.size(); ++i) {
+      if (!local[i].claimed && !local[i].remove && local[i].keyHash == keyHash) return static_cast<int>(i);
+    }
+    return -1;
+  };
+
+  std::vector<bool> remoteHandled(remote.size(), false);
+  std::vector<size_t> toPull;       // remote notes to add on the device
+  std::vector<size_t> toTombstone;  // remote notes to delete in Readest
+  std::vector<ReadestLinks::Link> nextLinks;
+  nextLinks.reserve(links.size() + remote.size() + local.size());
+
+  // 1. What was in sync last time: detect deletions and edits on each side.
+  for (const auto& link : links) {
+    const int ri = findRemote(link.id);
+    const int li = claimLocal(link.keyHash);
+    if (ri < 0 || remote[static_cast<size_t>(ri)].deleted) {
+      if (li >= 0) local[static_cast<size_t>(li)].remove = true;  // deleted in Readest
+      if (ri >= 0) remoteHandled[static_cast<size_t>(ri)] = true;
+      continue;
+    }
+    const size_t r = static_cast<size_t>(ri);
+    remoteHandled[r] = true;
+    if (remoteKeys[r] != link.keyHash) {  // edited in Readest: replace the device copy
+      if (li >= 0) local[static_cast<size_t>(li)].remove = true;
+      toPull.push_back(r);
+      continue;
+    }
+    if (li < 0) {  // deleted on the device
+      toTombstone.push_back(r);
+      continue;
+    }
+    local[static_cast<size_t>(li)].claimed = true;
+    nextLinks.push_back(link);
+  }
+
+  // 2. Readest highlights not seen before.
+  for (size_t r = 0; r < remote.size(); ++r) {
+    if (remoteHandled[r] || remote[r].deleted) continue;
+    const int li = claimLocal(remoteKeys[r]);
+    if (li >= 0) {
+      // First sync after the text-matching fix: grey highlights we pushed
+      // before were placed by layout, not text. Re-place them once.
+      if (!hadLinks && !readestCopyMissing && remote[r].color == HIGHLIGHT_COLOR) {
+        toTombstone.push_back(r);
+        continue;  // the device clipping stays unclaimed and is pushed again
+      }
+      local[static_cast<size_t>(li)].claimed = true;
+      nextLinks.push_back({remote[r].id, remoteKeys[r]});
+      continue;
+    }
+    toPull.push_back(r);
+  }
+
+  const time_t now = time(nullptr);
+  const int64_t nowMs = now > 1600000000 ? static_cast<int64_t>(now) * 1000 : 0;
+
+  // 3. Push device clippings Readest doesn't have, located by text in
+  //    Readest's own copy.
+  setStatus(tr(STR_READEST_PUSHING));
+  JsonDocument batch;
+  JsonArray notes = batch.to<JsonArray>();
+  size_t batchCount = 0;
+  const auto flush = [&]() -> bool {
+    if (batchCount == 0) return true;
+    std::string json;
+    serializeJson(batch, json);
+    const auto result = client.pushNotes(json);
+    batch.clear();
+    notes = batch.to<JsonArray>();
+    batchCount = 0;
+    if (result != ReadestClient::OK) {
+      fail(ReadestClient::errorString(result));
+      return false;
+    }
+    return true;
+  };
+
+  std::string text;
+  text.reserve(CLIPPING_TEXT_MAX);
+  for (size_t i = 0; i < local.size(); ++i) {
+    if (local[i].claimed || local[i].remove || local[i].keyHash.empty()) continue;
+    const Clipping* clipping = CLIPPINGS.clippingAt(i);
+    text.clear();
+    if (!clipping || !CLIPPINGS.readClippingText(i, text)) continue;
+
+    // Where the clipping sits in the device copy picks the starting chapter
+    // and breaks ties between repeated passages; the match itself is text.
+    const float intra =
+        clipping->pageCount > 1 ? (static_cast<float>(clipping->startPage) + 0.5f) / clipping->pageCount : 0.5f;
+    const float hint = ChapterXPathResolver::bookFraction(epub, clipping->spineIndex, intra);
+    int spine = -1;
+    XPathTextLocation location;
+    XPathTextRange range;
+    if (!ChapterXPathResolver::findTextInBook(readestEpub, text, hint, -1, spine, location) ||
+        !ChapterXPathResolver::rangeForLocation(readestEpub, spine, location, range)) {
+      LOG_DBG("RDS", "Clipping %u not found in Readest's copy", static_cast<unsigned>(i));
+      counts.skipped++;
+      continue;
+    }
+    if (readestEpub == epub && readestCopyMissing) {
+      // Fallback: device copy standing in for Readest's; map optimizer splits.
+      ProgressMapper::currentXPathToSource(epub, spine, range.start);
+      ProgressMapper::currentXPathToSource(epub, spine, range.end);
+    }
+
+    const std::string id = noteIdFor(book.hash, range);
+    // A re-placed highlight that landed on its old id is simply kept.
+    bool reused = false;
+    for (auto it = toTombstone.begin(); it != toTombstone.end(); ++it) {
+      if (remote[*it].id == id) {
+        toTombstone.erase(it);
+        reused = true;
+        break;
+      }
+    }
+    nextLinks.push_back({id, local[i].keyHash});
+    if (reused) continue;
+
+    JsonObject note = notes.add<JsonObject>();
+    note["bookHash"] = book.hash;
+    if (!book.metaHash.empty()) note["metaHash"] = book.metaHash;
+    note["id"] = id;
+    note["type"] = "annotation";
+    note["cfi"] = "";
+    note["xpointer0"] = range.start;
+    note["xpointer1"] = range.end;
+    note["text"] = text;
+    note["note"] = "";
+    note["style"] = "highlight";
+    note["color"] = HIGHLIGHT_COLOR;
+    if (nowMs > 0) note["createdAt"] = nowMs;
+    // Deliberately ancient: Readest's last-writer-wins then never lets a
+    // re-push overwrite (or resurrect) a highlight edited/deleted in Readest.
+    // New rows get a fresh updated_at from the server on insert.
+    note["updatedAt"] = 1;
+    batchCount++;
+    counts.pushed++;
+    if (batchCount >= PUSH_BATCH && !flush()) return false;
+  }
+
+  // 4. Deletions made on the device (or re-placed highlights) go to Readest
+  //    as tombstones. They need a real clock to win last-writer-wins.
+  if (nowMs > 0) {
+    for (const size_t r : toTombstone) {
+      const ReadestNote& gone = remote[r];
+      JsonObject note = notes.add<JsonObject>();
+      note["bookHash"] = book.hash;
+      if (!book.metaHash.empty()) note["metaHash"] = book.metaHash;
+      note["id"] = gone.id;
+      note["type"] = "annotation";
+      note["cfi"] = gone.cfi;
+      if (!gone.xpointer0.empty()) note["xpointer0"] = gone.xpointer0;
+      note["text"] = gone.text;
+      note["note"] = "";
+      note["deletedAt"] = nowMs;
+      note["updatedAt"] = nowMs;
+      batchCount++;
+      if (remote[r].color != HIGHLIGHT_COLOR || hadLinks) counts.removedThere++;
+      if (batchCount >= PUSH_BATCH && !flush()) return false;
+    }
+  } else if (!toTombstone.empty()) {
+    LOG_ERR("RDS", "No wall-clock time; %u Readest deletions postponed", static_cast<unsigned>(toTombstone.size()));
+    // Keep the links so the next sync retries instead of pulling them back.
+    for (const size_t r : toTombstone) nextLinks.push_back({remote[r].id, remoteKeys[r]});
+  }
+  if (!flush()) return false;
+
+  // 5. Deletions/edits made in Readest: drop device clippings (highest index
+  //    first so earlier indices stay valid).
+  for (size_t i = local.size(); i-- > 0;) {
+    if (!local[i].remove) continue;
+    if (CLIPPINGS.removeClippingAt(i)) {
+      counts.removedHere++;
+    } else {
+      LOG_ERR("RDS", "Failed to remove clipping %u", static_cast<unsigned>(i));
+    }
+  }
+
+  // 6. Readest highlights new to the device.
+  for (const size_t r : toPull) {
+    const size_t before = CLIPPINGS.clippingCount();
+    if (!addPulledClipping(remote[r], counts.skipped)) return false;
+    if (CLIPPINGS.clippingCount() > before) {
+      counts.pulled++;
+      nextLinks.push_back({remote[r].id, remoteKeys[r]});
+    }
+  }
+
+  ReadestLinks::save(localHash, nextLinks);
+  return true;
+}
+
+std::string ReadestSyncActivity::syncPosition(const ReadestBook& book) {
+  EpubReaderUtils::Progress progress;
+  EpubReaderUtils::loadProgress(*epub, progress, "RDS");
+  if (progress.spineIndex < 0 || progress.spineIndex >= epub->getSpineItemsCount()) progress.spineIndex = 0;
+  CrossPointPosition local = {progress.spineIndex, progress.pageNumber,
+                              progress.hasPageCount ? std::max(1, progress.pageCount) : 1};
+  if (progress.hasVisibleTextOffset) {
+    local.visibleTextOffset = progress.visibleTextOffset;
+    local.hasVisibleTextOffset = true;
+  }
+  const KOReaderPosition localKo = ProgressMapper::toKOReader(epub, local);
+
+  ReadestProgress remote;
+  const auto pulled = client.pullProgress(book, remote);
+  if (pulled != ReadestClient::OK) {
+    LOG_ERR("RDS", "Position pull failed: %d", static_cast<int>(pulled));
+    return tr(STR_READEST_POS_UNAVAILABLE);
+  }
+
+  // Readest -> device: read a snippet at Readest's position in Readest's copy
+  // and find that text in the device copy.
+  bool remoteMapped = false;
+  float remotePct = -1.0f;
+  CrossPointPosition remotePos{};
+  if (remote.found && !remote.xpointer.empty()) {
+    std::string deviceXPath;
+    if (readestEpub == epub && !readestCopyMissing) {
+      deviceXPath = remote.xpointer;  // identical files
+    } else {
+      std::string snippet;
+      int remoteSpine = -1;
+      int spine = -1;
+      XPathTextLocation location;
+      XPathTextRange range;
+      if (ChapterXPathResolver::textAtXPath(readestEpub, remote.xpointer, POSITION_SNIPPET_CHARS, snippet,
+                                            remoteSpine) &&
+          ChapterXPathResolver::findTextInBook(epub, snippet, remote.fraction, -1, spine, location) &&
+          ChapterXPathResolver::rangeForLocation(epub, spine, location, range)) {
+        deviceXPath = range.start;
+      } else {
+        LOG_ERR("RDS", "Readest position text not found in the device copy");
+      }
+    }
+    if (!deviceXPath.empty()) {
+      KOReaderPosition ko;
+      ko.xpath = deviceXPath;
+      ko.percentage = remote.fraction >= 0.0f ? remote.fraction : 0.0f;
+      remotePos = ProgressMapper::toCrossPoint(epub, ko, local.spineIndex, local.totalPages);
+      if (remotePos.valid && remotePos.spineIndex >= 0 && remotePos.spineIndex < epub->getSpineItemsCount()) {
+        remoteMapped = true;
+        remotePct = ProgressMapper::toKOReader(epub, remotePos).percentage;
+      }
+    }
+  }
+
+  if (remoteMapped && remotePct > localKo.percentage + POSITION_EPSILON) {
+    const int pageCount = std::max(remotePos.totalPages, remotePos.pageNumber + 1);
+    const std::optional<uint32_t> visibleTextOffset =
+        remotePos.hasVisibleTextOffset ? std::optional<uint32_t>(remotePos.visibleTextOffset) : std::nullopt;
+    if (!EpubReaderUtils::saveProgress(*epub, remotePos.spineIndex, remotePos.pageNumber, pageCount,
+                                       visibleTextOffset)) {
+      LOG_ERR("RDS", "Failed to save Readest position");
+      return tr(STR_READEST_POS_UNAVAILABLE);
+    }
+    RecentBookProgress::saveCachedEpubPercent(*epub, remotePos.spineIndex, remotePos.pageNumber, pageCount);
+    return formatCount(tr(STR_READEST_POS_FROM_READEST_FORMAT), percentOf(remotePct));
+  }
+
+  const bool deviceAhead = !remoteMapped || localKo.percentage > remotePct + POSITION_EPSILON;
+  if (localKo.valid && !localKo.xpath.empty() && deviceAhead) {
+    // Device -> Readest: the text at the device position, found in Readest's copy.
+    std::string readestXPath;
+    if (readestEpub == epub && !readestCopyMissing) {
+      readestXPath = localKo.xpath;
+    } else if (readestCopyMissing) {
+      readestXPath = ProgressMapper::toKOReader(epub, local, PositionCoordinateSpace::SourceDocument).xpath;
+    } else {
+      std::string snippet;
+      int localSpine = -1;
+      int spine = -1;
+      XPathTextLocation location;
+      XPathTextRange range;
+      if (ChapterXPathResolver::textAtXPath(epub, localKo.xpath, POSITION_SNIPPET_CHARS, snippet, localSpine) &&
+          ChapterXPathResolver::findTextInBook(readestEpub, snippet, localKo.percentage, -1, spine, location) &&
+          ChapterXPathResolver::rangeForLocation(readestEpub, spine, location, range)) {
+        readestXPath = range.start;
+      }
+    }
+    if (readestXPath.empty()) {
+      LOG_ERR("RDS", "Device position text not found in Readest's copy");
+      return tr(STR_READEST_POS_UNAVAILABLE);
+    }
+    const auto pushed = client.pushProgress(book, readestXPath, localKo.percentage);
+    if (pushed != ReadestClient::OK) {
+      LOG_ERR("RDS", "Position push failed: %d", static_cast<int>(pushed));
+      return tr(STR_READEST_POS_UNAVAILABLE);
+    }
+    return formatCount(tr(STR_READEST_POS_TO_READEST_FORMAT), percentOf(localKo.percentage));
+  }
+
+  return remoteMapped ? tr(STR_READEST_POS_IN_SYNC) : tr(STR_READEST_POS_UNAVAILABLE);
+}
+
+void ReadestSyncActivity::returnToReader() { activityManager.goToReader(epubPath, false, false, true); }
+
+void ReadestSyncActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const Rect screen = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  const Rect header{screen.x, screen.y + metrics.topPadding, screen.width,
+                    TouchHeaderBackButton::height(metrics, mappedInput)};
+  const char* title = tr(STR_READEST_SYNC_BOOK);
+  const bool finished = state == DONE || state == FAILED;
+  if (finished && mappedInput.hasTouchHardware()) {
+    TouchHeaderBackButton::draw(renderer, header, title, false);
+  } else {
+    GUI.drawHeader(renderer, header, title);
+  }
+
+  const int lineHeight = renderer.getLineHeight(UI_10_FONT_ID);
+  const int top = screen.y + (screen.height - lineHeight * 4) / 2;
+  const Rect textArea{screen.x + metrics.contentSidePadding, screen.y, screen.width - metrics.contentSidePadding * 2,
+                      screen.height};
+  UITheme::drawCenteredWrappedText(renderer, textArea, UI_10_FONT_ID, top, statusMessage.c_str(), 2, true,
+                                   finished ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR, 4);
+  // The wrapped-text helper does not break on '\n', so draw each summary line
+  // as its own block.
+  int y = top + lineHeight * 2 + 10;
+  size_t lineStart = 0;
+  while (lineStart < detailMessage.size()) {
+    size_t lineEnd = detailMessage.find('\n', lineStart);
+    if (lineEnd == std::string::npos) lineEnd = detailMessage.size();
+    const std::string line = detailMessage.substr(lineStart, lineEnd - lineStart);
+    if (!line.empty()) {
+      y += UITheme::drawCenteredWrappedText(renderer, textArea, UI_10_FONT_ID, y, line.c_str(), 2, true,
+                                            EpdFontFamily::REGULAR, 4) +
+           6;
+    }
+    lineStart = lineEnd + 1;
+  }
+
+  // The chooser draws its own button hints and pushes the frame itself.
+  if (chooser.processRender(renderer, mappedInput)) return;
+
+  const auto labels = mappedInput.mapLabels(
+      finished ? mappedInput.withBackArrow(tr(STR_BACK)) : MappedInputManager::Label(""), "", "", "");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+  renderer.displayBuffer(screenTransitionRefresh.modeFor(static_cast<uint8_t>(state)));
+}
+
+void ReadestSyncActivity::loop() {
+  if (state == CHOOSING) {
+    chooser.handleInput(mappedInput, [this] { requestUpdate(); });
+    if (chosenIndex >= 0 && chosenIndex < static_cast<int>(candidates.size())) {
+      const ReadestBook book = candidates[static_cast<size_t>(chosenIndex)];
+      candidates.clear();
+      ReadestBookMap::remember(localHash, book);
+      {
+        RenderLock lock(*this);
+        state = WORKING;
+        detailMessage.clear();
+      }
+      syncWithBook(book);
+    } else if (choiceCancelled || !chooser.isActive()) {
+      returnToReader();
+    }
+    return;
+  }
+  if (state != DONE && state != FAILED) return;
+
+  if (autoReturnAt != 0 && static_cast<long>(millis() - autoReturnAt) >= 0) {
+    returnToReader();
+    return;
+  }
+
+  const Rect header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+  int x = 0;
+  int y = 0;
+  if (TouchHeaderBackButton::wasTapped(mappedInput, header) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Back) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Confirm) || mappedInput.wasScreenTapped(x, y)) {
+    returnToReader();
+  }
+}
diff --git a/src/activities/reader/ReadestSyncActivity.h b/src/activities/reader/ReadestSyncActivity.h
new file mode 100644
index 00000000..6b36e165
--- /dev/null
+++ b/src/activities/reader/ReadestSyncActivity.h
@@ -0,0 +1,109 @@
+#pragma once
+#include <Epub.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "CrossPointSettings.h"
+#include "activities/Activity.h"
+#include "activities/ScreenTransitionRefresh.h"
+#include "components/OptionPopup.h"
+#include "readest/ReadestClient.h"
+
+/**
+ * "Sync Readest": one pass that keeps this book and the same book in the
+ * user's Readest library in step.
+ *
+ *  1. Match the book: a remembered match (ReadestBookMap), else a confident
+ *     title/file match, else the user picks from the top 3 candidates.
+ *  2. Get Readest's own copy of the book (cached on the SD card) unless the
+ *     device file is byte-identical. Everything below is matched by TEXT
+ *     between the two copies, so differing files (optimizer splits, Calibre
+ *     conversions, other editions) still line up.
+ *  3. Highlights, reconciled against the links remembered from the last sync
+ *     (ReadestLinks): additions, deletions and edits on either side are
+ *     applied to the other. Pulled clippings store the device's own wording
+ *     so the reader always finds them.
+ *  4. Position: furthest wins, anchored on a text snippet at the reading
+ *     position and found in the other copy.
+ *
+ * Like KOReader sync, the reader first hands off to a tiny instance that
+ * reboots into the lean network mode (freeing the reader's heap before
+ * Wi-Fi/TLS); the real instance reboots back into the reader on exit.
+ */
+class ReadestSyncActivity final : public Activity {
+ public:
+  // Reader-side handoff: reboots into network mode on enter.
+  ReadestSyncActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, uint8_t readerOrientation)
+      : Activity("ReadestSync", renderer, mappedInput),
+        readerOrientation(readerOrientation),
+        restartBeforeNetwork(true) {}
+
+  // Network boot: performs the sync for `epubPath`.
+  ReadestSyncActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, std::string epubPath,
+                      uint8_t readerOrientation)
+      : Activity("ReadestSync", renderer, mappedInput),
+        epubPath(std::move(epubPath)),
+        readerOrientation(readerOrientation) {}
+
+  static uint32_t encodeBootPayload(uint8_t orientation);
+  static uint8_t decodeBootOrientation(uint32_t payload);
+
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  bool preventAutoSleep() override { return state == WORKING || state == CHOOSING; }
+
+ private:
+  enum State { WIFI_SELECTION, WORKING, CHOOSING, DONE, FAILED };
+
+  std::shared_ptr<Epub> epub;
+  // Readest's copy of the book; the same object as `epub` when the files are
+  // identical, or (fallback) when Readest's copy could not be downloaded.
+  std::shared_ptr<Epub> readestEpub;
+  bool readestCopyMissing = false;
+  std::string epubPath;
+  uint8_t readerOrientation = CrossPointSettings::ORIENTATION_COUNT;
+  bool restartBeforeNetwork = false;
+  bool wifiActivated = false;
+
+  State state = WIFI_SELECTION;
+  ScreenTransitionRefresh screenTransitionRefresh;
+  std::string statusMessage;
+  std::string detailMessage;
+  unsigned long autoReturnAt = 0;  // success screens close themselves
+  ReadestClient client;
+  std::string localHash;
+
+  // Book chooser (first sync of a book only, and only when in doubt).
+  OptionPopup chooser;
+  std::vector<ReadestBook> candidates;
+  int chosenIndex = -1;
+  bool choiceCancelled = false;
+
+  void onWifiSelectionComplete(bool success);
+  void setStatus(const char* message);
+  void fail(std::string detail);
+  void runSync();
+  void showChooser();
+  void syncWithBook(const ReadestBook& book);
+  bool openReadestCopy(const ReadestBook& book);
+  void removeReadestCopy();
+  void removeLegacyReadestCopies();
+  struct HighlightCounts {
+    int pulled = 0;
+    int pushed = 0;
+    int removedHere = 0;
+    int removedThere = 0;
+    int skipped = 0;
+  };
+  // Returns false after reporting a fatal error via fail().
+  bool syncHighlights(const ReadestBook& book, HighlightCounts& counts);
+  bool addPulledClipping(const ReadestNote& note, int& skipped);
+  std::string syncPosition(const ReadestBook& book);
+  void returnToReader();
+};
