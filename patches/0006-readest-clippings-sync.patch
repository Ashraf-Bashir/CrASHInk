+namespace {
+// How strictly clipping text must agree with the chapter text.
+//  Strict: ignore whitespace and soft hyphens only.
+//  Loose:  also ignore case, punctuation and symbols, so curly vs straight
+//          quotes, dashes and ellipses differing between readers still match.
+enum class MatchMode : uint8_t { Strict, Loose };
+
+bool isWhitespaceOrSoftHyphen(const uint32_t cp) {
+  return cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r' || cp == '\f' || cp == 0xA0 || cp == 0xAD ||
+         (cp >= 0x2000 && cp <= 0x200B) || cp == 0x202F || cp == 0x205F || cp == 0x3000 || cp == 0xFEFF;
+}
+
+bool isPunctuationOrSymbol(const uint32_t cp) {
+  if (cp < 0x80) return !((cp >= '0' && cp <= '9') || (cp >= 'a' && cp <= 'z') || (cp >= 'A' && cp <= 'Z'));
+  return (cp >= 0xA1 && cp <= 0xBF) || cp == 0xD7 || cp == 0xF7 || (cp >= 0x2010 && cp <= 0x206F) ||
+         (cp >= 0x3001 && cp <= 0x303F) || (cp >= 0xFF01 && cp <= 0xFF0F);
+}
+
+// Returns false when `cp` does not take part in matching; otherwise writes the
+// comparison form of the character.
+bool matchChar(const uint32_t cp, const MatchMode mode, uint32_t& out) {
+  if (isWhitespaceOrSoftHyphen(cp)) return false;
+  if (mode == MatchMode::Loose) {
+    if (isPunctuationOrSymbol(cp)) return false;
+    out = (cp >= 'A' && cp <= 'Z') ? cp + ('a' - 'A') : cp;
+    return true;
+  }
+  out = cp;
+  return true;
+}
+
+// crengine collapses only ASCII whitespace runs when counting xpointer offsets.
+bool isCollapsibleSpace(const uint32_t cp) { return cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r' || cp == '\f'; }
+
+// Block containers where crengine drops a leading whitespace-only text node.
+// Mirrors XCFI.BLOCK_TAGS in Readest so text()[K] indices agree.
+bool isBlockTag(const std::string& name) {
+  static const char* const kBlockTags[] = {
+      "body",   "div",    "p",   "h1",      "h2",      "h3",         "h4",      "h5",      "h6",       "ul",
+      "ol",     "li",     "dl",  "dt",      "dd",      "blockquote", "pre",     "section", "article",  "aside",
+      "header", "footer", "nav", "main",    "figure",  "figcaption", "table",   "thead",   "tbody",    "tfoot",
+      "tr",     "td",     "th",  "caption", "address", "details",    "summary", "form",    "fieldset", "center"};
+  for (const char* tag : kBlockTags) {
+    if (name == tag) return true;
+  }
+  return false;
+}
+
+bool isPreTag(const std::string& name) {
+  return name == "pre" || name == "code" || name == "listing" || name == "plaintext" || name == "xmp" ||
+         name == "textarea";
+}
+
+// JS string offsets (what Readest resolves against) count UTF-16 code units.
+size_t utf16Units(const uint32_t cp) { return cp > 0xFFFF ? 2 : 1; }
+
+void appendUtf8(std::string& out, const uint32_t cp) {
+  if (cp < 0x80) {
+    out += static_cast<char>(cp);
+  } else if (cp < 0x800) {
+    out += static_cast<char>(0xC0 | (cp >> 6));
+    out += static_cast<char>(0x80 | (cp & 0x3F));
+  } else if (cp < 0x10000) {
+    out += static_cast<char>(0xE0 | (cp >> 12));
+    out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+    out += static_cast<char>(0x80 | (cp & 0x3F));
+  } else {
+    out += static_cast<char>(0xF0 | (cp >> 18));
+    out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
+    out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+    out += static_cast<char>(0x80 | (cp & 0x3F));
+  }
+}
+
+std::vector<uint32_t> matchCodepoints(const std::string& text, const MatchMode mode) {
+  std::vector<uint32_t> out;
+  out.reserve(text.size());
+  const unsigned char* ptr = reinterpret_cast<const unsigned char*>(text.c_str());
+  const unsigned char* end = ptr + text.size();
+  while (ptr < end) {
+    uint32_t folded = 0;
+    if (matchChar(utf8NextCodepoint(&ptr), mode, folded)) out.push_back(folded);
+  }
+  return out;
+}
+
+std::string buildTextPointXPath(const int spineIndex, const std::vector<PathSegment>& path, const int textNodeIndex,
+                                const size_t offset) {
+  std::string xpath = "/body/DocFragment[" + std::to_string(spineIndex + 1) + "]/body";
+  for (const auto& segment : path) {
+    xpath += "/" + segment.name + "[" + std::to_string(segment.index) + "]";
+  }
+  xpath += "/text()[" + std::to_string(textNodeIndex) + "]." + std::to_string(offset);
+  return xpath;
+}
