+// Notes per POST. Clipping text is capped at 4 KB, so a batch stays well
+// under ~40 KB of JSON even in the worst case.
+constexpr size_t PUSH_BATCH = 10;
+// Pulled clippings have no real page layout; they store a position within a
+// virtual 1000-page chapter so "jump to clipping" lands near the right page.
+constexpr uint16_t VIRTUAL_PAGE_COUNT = 1000;
+// Position differences below this fraction count as "already in sync".
+constexpr float POSITION_EPSILON = 0.002f;
+constexpr unsigned long AUTO_RETURN_DELAY_MS = 2000;
