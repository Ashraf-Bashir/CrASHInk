+#pragma once
+
+#include <string>
+
+#include "ReadestClient.h"
+
+/**
+ * Remembers which Readest library book the user picked for a local EPUB, so
+ * the library scan and chooser only happen on the first sync of each book.
+ *
+ * Keyed by the local file's KOReader-style partial MD5, which survives moves
+ * and renames. Stored as a small JSON object in /.crosspoint/readest_books.json
+ * that is read/written only around a sync (never kept in RAM).
+ */
+namespace ReadestBookMap {
+bool lookup(const std::string& localHash, ReadestBook& out);
+bool remember(const std::string& localHash, const ReadestBook& book);
+void clearAll();
+}  // namespace ReadestBookMap
