diff --git a/src/readest/ReadestBookMap.cpp b/src/readest/ReadestBookMap.cpp
new file mode 100644
index 00000000..d298635b
--- /dev/null
+++ b/src/readest/ReadestBookMap.cpp
@@ -0,0 +1,96 @@
+#include "ReadestBookMap.h"
+
+#include <ArduinoJson.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <PersistableStore.h>
+
+namespace {
+constexpr char MAP_PATH[] = "/.crosspoint/readest_books.json";
+}  // namespace
+
+namespace ReadestBookMap {
+
+bool lookup(const std::string& localHash, ReadestBook& out) {
+  if (localHash.empty()) return false;
+  JsonDocument doc;
+  if (!PersistableStoreBase::readDocFromFile(MAP_PATH, doc)) return false;
+  const JsonObjectConst entry = doc[localHash].as<JsonObjectConst>();
+  if (entry.isNull()) return false;
+  const char* hash = entry["h"] | "";
+  if (hash[0] == '\0') return false;
+  out.hash = hash;
+  out.metaHash = entry["m"] | "";
+  out.title = entry["t"] | "";
+  out.author = entry["a"] | "";
+  out.format = entry["f"] | "";
+  return true;
+}
+
+bool remember(const std::string& localHash, const ReadestBook& book) {
+  if (localHash.empty() || book.hash.empty()) return false;
+  JsonDocument doc;
+  PersistableStoreBase::readDocFromFile(MAP_PATH, doc);  // missing file = empty map
+  if (!doc.is<JsonObject>()) doc.to<JsonObject>();
+  JsonObject entry = doc[localHash].to<JsonObject>();
+  entry["h"] = book.hash;
+  entry["m"] = book.metaHash;
+  entry["t"] = book.title;
+  entry["a"] = book.author;
+  entry["f"] = book.format;
+  if (!PersistableStoreBase::writeDocToFile(MAP_PATH, doc)) {
+    LOG_ERR("RDS", "Failed to save Readest book match");
+    return false;
+  }
+  return true;
+}
+
+std::vector<std::string> allReadestHashes() {
+  std::vector<std::string> hashes;
+  JsonDocument doc;
+  if (!PersistableStoreBase::readDocFromFile(MAP_PATH, doc)) return hashes;
+  for (const JsonPairConst pair : doc.as<JsonObjectConst>()) {
+    const char* hash = pair.value()["h"] | "";
+    if (hash[0] != '\0') hashes.emplace_back(hash);
+  }
+  return hashes;
+}
+
+void clearAll() {
+  if (Storage.exists(MAP_PATH) && !Storage.remove(MAP_PATH)) {
+    LOG_ERR("RDS", "Failed to remove %s", MAP_PATH);
+  }
+}
+
+}  // namespace ReadestBookMap
+
+namespace ReadestLinks {
+namespace {
+std::string linksPath(const std::string& localHash) { return "/.crosspoint/readest_links_" + localHash + ".json"; }
+}  // namespace
+
+bool load(const std::string& localHash, std::vector<Link>& out) {
+  out.clear();
+  if (localHash.empty()) return false;
+  JsonDocument doc;
+  if (!PersistableStoreBase::readDocFromFile(linksPath(localHash).c_str(), doc)) return false;
+  const JsonObjectConst ids = doc["ids"].as<JsonObjectConst>();
+  out.reserve(ids.size());
+  for (const JsonPairConst pair : ids) {
+    out.push_back({pair.key().c_str(), pair.value() | ""});
+  }
+  return true;
+}
+
+bool save(const std::string& localHash, const std::vector<Link>& links) {
+  if (localHash.empty()) return false;
+  JsonDocument doc;
+  JsonObject ids = doc["ids"].to<JsonObject>();
+  for (const auto& link : links) ids[link.id] = link.keyHash;
+  if (!PersistableStoreBase::writeDocToFile(linksPath(localHash).c_str(), doc)) {
+    LOG_ERR("RDS", "Failed to save Readest highlight links");
+    return false;
+  }
+  return true;
+}
+}  // namespace ReadestLinks
diff --git a/src/readest/ReadestBookMap.h b/src/readest/ReadestBookMap.h
new file mode 100644
index 00000000..b9197bb6
--- /dev/null
+++ b/src/readest/ReadestBookMap.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "ReadestClient.h"
+
+/**
+ * Remembers which Readest library book the user picked for a local EPUB, so
+ * the library scan and chooser only happen on the first sync of each book.
+ *
+ * Keyed by the local file's KOReader-style partial MD5, which survives moves
+ * and renames. Stored as a small JSON object in /.crosspoint/readest_books.json
+ * that is read/written only around a sync (never kept in RAM).
+ */
+namespace ReadestBookMap {
+bool lookup(const std::string& localHash, ReadestBook& out);
+bool remember(const std::string& localHash, const ReadestBook& book);
+void clearAll();
+// Readest book hashes of every remembered match.
+std::vector<std::string> allReadestHashes();
+}  // namespace ReadestBookMap
+
+/**
+ * Which Readest highlight each device clipping was last synced with, per
+ * book: Readest note id -> hash of the highlight's loose text. Comparing it
+ * with the current state on both sides is what lets deletions and edits
+ * propagate (without it every difference looks like an addition).
+ * Stored in /.crosspoint/readest_links_<localHash>.json.
+ */
+namespace ReadestLinks {
+struct Link {
+  std::string id;
+  std::string keyHash;
+};
+bool load(const std::string& localHash, std::vector<Link>& out);
+bool save(const std::string& localHash, const std::vector<Link>& links);
+}  // namespace ReadestLinks
