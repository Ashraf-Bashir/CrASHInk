+// Shared expat plumbing for the clipping passes below. HTML named entities
+// (&nbsp;, &mdash;, &rsquo;...) are expanded exactly like the reader's
+// ChapterHtmlSlimParser does; plain expat would silently drop them and shift
+// every offset after them.
+class ExpatTextStream : public Print {
+ public:
+  ExpatTextStream() {
+    parser = XML_ParserCreate(nullptr);
+    if (!parser) {
+      LOG_ERR("KOX", "Failed to create XML parser");
+      return;
+    }
+    XML_SetUserData(parser, this);
+    XML_SetElementHandler(parser, &ExpatTextStream::startElement, &ExpatTextStream::endElement);
+    XML_SetCharacterDataHandler(parser, &ExpatTextStream::characterData);
+    XML_SetDefaultHandlerExpand(parser, &ExpatTextStream::defaultHandler);
+  }
+
+  ~ExpatTextStream() override { destroyXmlParser(parser); }
+
+  ExpatTextStream(const ExpatTextStream&) = delete;
+  ExpatTextStream& operator=(const ExpatTextStream&) = delete;
+
+  bool ok() const { return parser != nullptr && parseOk; }
+
+  bool finish() {
+    if (!parser || !parseOk || stopped) {
+      return parseOk;
+    }
+    if (XML_Parse(parser, "", 0, XML_TRUE) == XML_STATUS_ERROR) {
+      LOG_ERR("KOX", "Final XML parse error: %s", XML_ErrorString(XML_GetErrorCode(parser)));
+      parseOk = false;
+    }
+    return parseOk;
+  }
+
+  size_t write(uint8_t c) override { return write(&c, 1); }
+
+  size_t write(const uint8_t* buffer, size_t size) override {
+    if (!parser || !parseOk || stopped) {
+      return size;
+    }
+    if (XML_Parse(parser, reinterpret_cast<const char*>(buffer), static_cast<int>(size), XML_FALSE) != XML_STATUS_OK) {
+      const enum XML_Error error = XML_GetErrorCode(parser);
+      if (error != XML_ERROR_ABORTED) {
+        LOG_ERR("KOX", "XML parse error: %s", XML_ErrorString(error));
+        parseOk = false;
+      }
+    }
+    return size;
+  }
+
+ protected:
+  virtual void onStartElement(const std::string& name) = 0;
+  virtual void onEndElement(const std::string& name) = 0;
+  virtual void onCharacterData(const XML_Char* data, int len) = 0;
+
+  void stop() {
+    stopped = true;
+    XML_StopParser(parser, XML_FALSE);
+  }
+
+  bool stopped = false;
+
+ private:
+  static void XMLCALL startElement(void* userData, const XML_Char* name, const XML_Char**) {
+    static_cast<ExpatTextStream*>(userData)->onStartElement(stripPrefix(name));
+  }
+
+  static void XMLCALL endElement(void* userData, const XML_Char* name) {
+    static_cast<ExpatTextStream*>(userData)->onEndElement(stripPrefix(name));
+  }
+
+  static void XMLCALL characterData(void* userData, const XML_Char* data, const int len) {
+    static_cast<ExpatTextStream*>(userData)->onCharacterData(data, len);
+  }
+
+  static void XMLCALL defaultHandler(void* userData, const XML_Char* s, const int len) {
+    if (len < 3 || s[0] != '&' || s[len - 1] != ';') return;
+    auto* self = static_cast<ExpatTextStream*>(userData);
+    const char* utf8Value = lookupHtmlEntity(s, static_cast<size_t>(len));
+    if (utf8Value) {
+      self->onCharacterData(utf8Value, static_cast<int>(strlen(utf8Value)));
+    } else {
+      self->onCharacterData(s, len);  // unknown entity: keep "&name;" like the reader
+    }
+  }
+
+  XML_Parser parser = nullptr;
+  bool parseOk = true;
+};
+
+// Pass 1: find every occurrence of the clipping text, counted in "match
+// positions" (visible codepoints that take part in matching). KMP keeps this
+// single-pass and O(n) with no chapter buffering.
+class TextMatchScanner final : public ExpatTextStream {
+ public:
+  struct Match {
+    uint32_t start;
+    uint32_t end;  // inclusive
+  };
+  static constexpr size_t MAX_MATCHES = 32;
+
+  TextMatchScanner(const std::vector<uint32_t>& needle, const MatchMode mode)
+      : needle(needle), mode(mode), failure(needle.size(), 0) {
+    size_t k = 0;
+    for (size_t i = 1; i < needle.size(); i++) {
+      while (k > 0 && needle[i] != needle[k]) k = failure[k - 1];
+      if (needle[i] == needle[k]) k++;
+      failure[i] = k;
+    }
+  }
+
+  const std::vector<Match>& getMatches() const { return matches; }
+  // Match positions in the whole spine item, for relative-position estimates.
+  uint32_t totalPositions() const { return position; }
+
+ protected:
+  void onStartElement(const std::string& name) override {
+    if (!insideBody) {
+      if (name == "body") {
+        insideBody = true;
+        bodyDepth = depth;
+      }
+      depth++;
+      return;
+    }
+    if (isNonVisibleTextTag(name)) nonVisibleDepth++;
+    depth++;
+  }
+
+  void onEndElement(const std::string& name) override {
+    depth--;
+    if (!insideBody) return;
+    if (depth == bodyDepth && name == "body") {
+      insideBody = false;
+      return;
+    }
+    if (isNonVisibleTextTag(name) && nonVisibleDepth > 0) nonVisibleDepth--;
+  }
+
+  void onCharacterData(const XML_Char* data, const int len) override {
+    if (!insideBody || nonVisibleDepth > 0 || len <= 0 || stopped || needle.empty()) return;
+    const size_t n = needle.size();
+    const unsigned char* ptr = reinterpret_cast<const unsigned char*>(data);
+    const unsigned char* end = ptr + len;
+    while (ptr < end) {
+      uint32_t cp = 0;
+      if (!matchChar(utf8NextCodepoint(&ptr), mode, cp)) continue;
+      while (matched > 0 && cp != needle[matched]) matched = failure[matched - 1];
+      if (cp == needle[matched]) matched++;
+      if (matched == n) {
+        if (matches.size() < MAX_MATCHES) {
+          matches.push_back({position + 1 - static_cast<uint32_t>(n), position});
+        }
+        matched = failure[matched - 1];
+      }
+      position++;
+    }
+  }
+
+ private:
+  const std::vector<uint32_t>& needle;
+  const MatchMode mode;
+  std::vector<size_t> failure;
+  std::vector<Match> matches;
+  size_t matched = 0;
+  uint32_t position = 0;
+  bool insideBody = false;
+  int depth = 0;
+  int bodyDepth = -1;
+  int nonVisibleDepth = 0;
+};
+
+// Pass 2: walk the same text again and translate two match positions into
+// crengine-style xpointers: text()[K] counts the direct text children
+// crengine keeps, and the offset counts whitespace-collapsed characters.
+class XPathPointResolver final : public ExpatTextStream {
+ public:
+  XPathPointResolver(const int spineIndex, const MatchMode mode, const uint32_t startPos, const uint32_t endPos)
+      : spineIndex(spineIndex), mode(mode), startPos(startPos), endPos(endPos) {}
+
+  bool complete() const { return !startXPath.empty() && !endXPath.empty(); }
+
+  std::string startXPath;
+  std::string endXPath;
+
+ protected:
+  void onStartElement(const std::string& name) override {
+    if (!insideBody) {
+      if (name == "body") {
+        insideBody = true;
+        bodyDepth = depth;
+        frames.clear();
+        frames.emplace_back();
+        frames.back().block = true;
+      }
+      depth++;
+      return;
+    }
+
+    inTextNode = false;
+    Frame frame;
+    frame.block = isBlockTag(name);
+    frame.pre = frames.back().pre || isPreTag(name);
+    frames.back().childNodes++;
+    const int siblingIndex = frames.back().children.nextIndex(name);
+    path.push_back({name, siblingIndex});
+    frames.push_back(std::move(frame));
+    if (isNonVisibleTextTag(name)) nonVisibleDepth++;
+    depth++;
+  }
+
+  void onEndElement(const std::string& name) override {
+    depth--;
+    if (!insideBody) return;
+    inTextNode = false;
+    if (depth == bodyDepth && name == "body") {
+      insideBody = false;
+      frames.clear();
+      path.clear();
+      return;
+    }
+    if (isNonVisibleTextTag(name) && nonVisibleDepth > 0) nonVisibleDepth--;
+    if (!path.empty()) path.pop_back();
+    if (frames.size() > 1) frames.pop_back();
+  }
+
+  void onCharacterData(const XML_Char* data, const int len) override {
+    if (!insideBody || nonVisibleDepth > 0 || len <= 0 || stopped || frames.empty()) return;
+    Frame& frame = frames.back();
+    if (!inTextNode) {
+      inTextNode = true;
+      textCounted = false;
+      nodeOffset = 0;
+      prevSpace = false;
+      firstChild = frame.childNodes == 0;
+      frame.childNodes++;
+    }
+
+    const unsigned char* ptr = reinterpret_cast<const unsigned char*>(data);
+    const unsigned char* end = ptr + len;
+    while (ptr < end) {
+      const uint32_t cp = utf8NextCodepoint(&ptr);
+      const bool space = isCollapsibleSpace(cp);
+      // A whitespace-only first child of a block is dropped by crengine, so
+      // the node only takes a text() index once it proves otherwise.
+      if (!textCounted && (!space || frame.pre || !(firstChild && frame.block))) {
+        textCounted = true;
+        frame.textNodes++;
+      }
+      uint32_t folded = 0;
+      if (matchChar(cp, mode, folded)) {
+        if (position == startPos) {
+          startXPath = buildTextPointXPath(spineIndex, path, frame.textNodes, nodeOffset);
+        }
+        if (position == endPos) {
+          endXPath = buildTextPointXPath(spineIndex, path, frame.textNodes, nodeOffset + utf16Units(cp));
+        }
+        position++;
+        if (complete()) {
+          stop();
+          return;
+        }
+      }
+      if (!(space && prevSpace && !frame.pre)) nodeOffset += utf16Units(cp);
+      prevSpace = space;
+    }
+  }
+
+ private:
+  struct Frame {
+    ParentState children;
+    int childNodes = 0;
+    int textNodes = 0;
+    bool block = false;
+    bool pre = false;
+  };
+
+  const int spineIndex;
+  const MatchMode mode;
+  const uint32_t startPos;
+  const uint32_t endPos;
+  std::vector<Frame> frames;
+  std::vector<PathSegment> path;
+  uint32_t position = 0;
+  size_t nodeOffset = 0;
+  bool inTextNode = false;
+  bool textCounted = false;
+  bool firstChild = false;
+  bool prevSpace = false;
+  bool insideBody = false;
+  int depth = 0;
+  int bodyDepth = -1;
+  int nonVisibleDepth = 0;
+};
+
+// Runs pass 1 in `mode` and picks the occurrence nearest `positionHint`.
+bool locateTextWithMode(const std::shared_ptr<Epub>& epub, const std::string& href, const std::string& text,
+                        const float positionHint, const MatchMode mode, XPathTextLocation& out) {
+  const std::vector<uint32_t> needle = matchCodepoints(text, mode);
+  if (needle.empty()) return false;
+
+  TextMatchScanner scanner(needle, mode);
+  if (!scanner.ok() || !epub->readItemContentsToStream(href, scanner, 1024) || !scanner.finish()) {
+    return false;
+  }
+  const auto& matches = scanner.getMatches();
+  if (matches.empty()) return false;
+
+  const uint32_t total = scanner.totalPositions();
+  const TextMatchScanner::Match* best = &matches.front();
+  if (positionHint >= 0.0f && total > 0 && matches.size() > 1) {
+    const auto distance = [total, positionHint](const TextMatchScanner::Match& match) {
+      return std::fabs(static_cast<float>(match.start) / static_cast<float>(total) - positionHint);
+    };
+    for (const auto& match : matches) {
+      if (distance(match) < distance(*best)) best = &match;
+    }
+  }
+
+  out.start = best->start;
+  out.end = best->end;
+  out.total = total;
+  out.loose = mode == MatchMode::Loose;
+  return true;
+}
+}  // namespace
+
+bool ChapterXPathResolver::locateText(const std::shared_ptr<Epub>& epub, const int spineIndex, const std::string& text,
+                                      const float positionHint, XPathTextLocation& out) {
+  out = XPathTextLocation{};
+  if (!epub || spineIndex < 0 || spineIndex >= epub->getSpineItemsCount()) {
+    return false;
+  }
+  const auto href = epub->getSpineItem(spineIndex).href;
+  if (href.empty()) {
+    return false;
+  }
+
+  if (locateTextWithMode(epub, href, text, positionHint, MatchMode::Strict, out)) return true;
+  if (locateTextWithMode(epub, href, text, positionHint, MatchMode::Loose, out)) {
+    LOG_DBG("KOX", "Clipping text matched loosely in spine %d", spineIndex);
+    return true;
+  }
+  LOG_DBG("KOX", "Clipping text not found in spine %d", spineIndex);
+  return false;
+}
+
+bool ChapterXPathResolver::rangeForLocation(const std::shared_ptr<Epub>& epub, const int spineIndex,
+                                            const XPathTextLocation& location, XPathTextRange& out) {
+  out = XPathTextRange{};
+  if (!epub || spineIndex < 0 || spineIndex >= epub->getSpineItemsCount()) return false;
+  const auto href = epub->getSpineItem(spineIndex).href;
+  XPathPointResolver resolver(spineIndex, location.loose ? MatchMode::Loose : MatchMode::Strict, location.start,
+                              location.end);
+  if (!resolver.ok() || !epub->readItemContentsToStream(href, resolver, 1024) || !resolver.finish() ||
+      !resolver.complete()) {
+    LOG_DBG("KOX", "Could not resolve text range in spine %d", spineIndex);
+    return false;
+  }
+  out.start = resolver.startXPath;
+  out.end = resolver.endXPath;
+  return true;
+}
+
+bool ChapterXPathResolver::findXPathRangeForText(const std::shared_ptr<Epub>& epub, const int spineIndex,
+                                                 const std::string& text, const float positionHint,
+                                                 XPathTextRange& out) {
+  out = XPathTextRange{};
+  XPathTextLocation location;
+  return locateText(epub, spineIndex, text, positionHint, location) &&
+         rangeForLocation(epub, spineIndex, location, out);
+}
+
+std::string ChapterXPathResolver::looseTextKey(const std::string& text) {
+  const std::vector<uint32_t> codepoints = matchCodepoints(text, MatchMode::Loose);
+  std::string key;
+  key.reserve(codepoints.size());
+  for (const uint32_t cp : codepoints) appendUtf8(key, cp);
+  return key;
+}
