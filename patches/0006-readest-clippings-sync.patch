--- /dev/null
+++ b/src/readest/ReadestBookMap.cpp
@@ -0,0 +1,52 @@
+#include "ReadestBookMap.h"
+
+#include <ArduinoJson.h>
+#include <HalStorage.h>
+#include <Logging.h>
+#include <PersistableStore.h>
+
+namespace {
+constexpr char MAP_PATH[] = "/.crosspoint/readest_books.json";
+}  // namespace
+
+namespace ReadestBookMap {
+
+bool lookup(const std::string& localHash, ReadestBook& out) {
+  if (localHash.empty()) return false;
+  JsonDocument doc;
+  if (!PersistableStoreBase::readDocFromFile(MAP_PATH, doc)) return false;
+  const JsonObjectConst entry = doc[localHash].as<JsonObjectConst>();
+  if (entry.isNull()) return false;
+  const char* hash = entry["h"] | "";
+  if (hash[0] == '\0') return false;
+  out.hash = hash;
+  out.metaHash = entry["m"] | "";
+  out.title = entry["t"] | "";
+  out.author = entry["a"] | "";
+  return true;
+}
+
+bool remember(const std::string& localHash, const ReadestBook& book) {
+  if (localHash.empty() || book.hash.empty()) return false;
+  JsonDocument doc;
+  PersistableStoreBase::readDocFromFile(MAP_PATH, doc);  // missing file = empty map
+  if (!doc.is<JsonObject>()) doc.to<JsonObject>();
+  JsonObject entry = doc[localHash].to<JsonObject>();
+  entry["h"] = book.hash;
+  entry["m"] = book.metaHash;
+  entry["t"] = book.title;
+  entry["a"] = book.author;
+  if (!PersistableStoreBase::writeDocToFile(MAP_PATH, doc)) {
+    LOG_ERR("RDS", "Failed to save Readest book match");
+    return false;
+  }
+  return true;
+}
+
+void clearAll() {
+  if (Storage.exists(MAP_PATH) && !Storage.remove(MAP_PATH)) {
+    LOG_ERR("RDS", "Failed to remove %s", MAP_PATH);
+  }
+}
+
+}  // namespace ReadestBookMap
