+
+ private:
+  using UiApp = freeink::ui::FreeInkApp<12, 4>;
+
+  // Keyboard pop-ups are chained from loop(), never from inside a result
+  // callback, so each one is pushed on a settled activity stack.
+  enum class PendingStep : uint8_t { None, AskPassword, Connect };
+
+  ButtonNavigator buttonNavigator;
+  size_t selectedIndex = 0;
+  PendingStep pendingStep = PendingStep::None;
+  std::string pendingEmail;
+
+  freeink::ui::GfxRendererTarget uiTarget;  // must precede `app`: the app holds a reference to it
+  UiApp app;
+  std::atomic<bool> uiReady{false};
+  int visibleRows = 1;
+  int topIndex = 0;
+  bool ignoreInitialConfirmRelease = false;
+
+  static void listScreen(UiApp::ScreenType& screen, void* user);
+  static void onRowEvent(const freeink::ui::ActionEvent& event, void* user);
+  void buildListScreen(UiApp::ScreenType& screen);
+
+  void handleSelection();
+  void askEmail();
+  void askPassword();
+};
