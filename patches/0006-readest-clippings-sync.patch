+namespace {
+// Collects the chapter text between two match positions, the way the reader
+// shows it: whitespace runs (and block boundaries) become one space, soft
+// hyphens vanish, entities are expanded.
+class TextSpanExtractor final : public ExpatTextStream {
+ public:
+  TextSpanExtractor(const MatchMode mode, const uint32_t startPos, const uint32_t endPos)
+      : mode(mode), startPos(startPos), endPos(endPos) {}
+
+  bool done = false;
+  std::string text;
+
+ protected:
+  void onStartElement(const std::string& name) override {
+    if (!insideBody) {
+      if (name == "body") {
+        insideBody = true;
+        bodyDepth = depth;
+      }
+      depth++;
+      return;
+    }
+    if (isBlockTag(name) || name == "br") pendingSpace = true;
+    if (isNonVisibleTextTag(name)) nonVisibleDepth++;
+    depth++;
+  }
+
+  void onEndElement(const std::string& name) override {
+    depth--;
+    if (!insideBody) return;
+    if (depth == bodyDepth && name == "body") {
+      insideBody = false;
+      return;
+    }
+    if (isBlockTag(name)) pendingSpace = true;
+    if (isNonVisibleTextTag(name) && nonVisibleDepth > 0) nonVisibleDepth--;
+  }
+
+  void onCharacterData(const XML_Char* data, const int len) override {
+    if (!insideBody || nonVisibleDepth > 0 || len <= 0 || stopped) return;
+    const unsigned char* ptr = reinterpret_cast<const unsigned char*>(data);
+    const unsigned char* end = ptr + len;
+    while (ptr < end) {
+      const uint32_t cp = utf8NextCodepoint(&ptr);
+      uint32_t folded = 0;
+      const bool participates = matchChar(cp, mode, folded);
+      if (trailing) {
+        // Keep punctuation glued to the end of the match ("all." or "all,").
+        if (participates || isWhitespaceOrSoftHyphen(cp)) {
+          stop();
+          return;
+        }
+        appendUtf8(text, cp);
+        continue;
+      }
+      if (participates && position == startPos) {
+        capturing = true;
+        pendingSpace = false;
+      }
+      if (capturing) {
+        if (isWhitespaceOrSoftHyphen(cp)) {
+          if (cp != 0xAD) pendingSpace = true;
+        } else {
+          if (pendingSpace && !text.empty()) text += ' ';
+          pendingSpace = false;
+          appendUtf8(text, cp);
+        }
+      }
+      if (participates) {
+        if (position == endPos) {
+          done = true;
+          trailing = true;
+        }
+        position++;
+      }
+    }
+  }
+
+ private:
+  const MatchMode mode;
+  const uint32_t startPos;
+  const uint32_t endPos;
+  uint32_t position = 0;
+  bool trailing = false;
+  bool capturing = false;
+  bool pendingSpace = false;
+  bool insideBody = false;
+  int depth = 0;
+  int bodyDepth = -1;
+  int nonVisibleDepth = 0;
+};
+
+// Target of a KOReader/Readest xpointer: element path below <body>, the kept
+// text child (0 = element start) and the collapsed offset inside it.
+struct XPathTarget {
+  std::vector<PathSegment> path;
+  int textNode = 0;
+  size_t offset = 0;
+};
+
+bool parseXPathTarget(const std::string& xpath, int& spineIndex, XPathTarget& out) {
+  static constexpr char kFragment[] = "/body/DocFragment";
+  if (xpath.rfind(kFragment, 0) != 0) return false;
+  size_t pos = sizeof(kFragment) - 1;
+  spineIndex = 0;
+  if (pos < xpath.size() && xpath[pos] == '[') {
+    spineIndex = std::atoi(xpath.c_str() + pos + 1) - 1;
+    pos = xpath.find(']', pos);
+    if (pos == std::string::npos) return false;
+    pos++;
+  }
+  static constexpr char kBody[] = "/body";
+  if (xpath.compare(pos, sizeof(kBody) - 1, kBody) != 0) return false;
+  pos += sizeof(kBody) - 1;
+
+  out = XPathTarget{};
+  while (pos < xpath.size() && xpath[pos] == '/') {
+    const size_t next = xpath.find('/', pos + 1);
+    std::string step = xpath.substr(pos + 1, next == std::string::npos ? std::string::npos : next - pos - 1);
+    pos = next == std::string::npos ? xpath.size() : next;
+    if (step.rfind("text()", 0) == 0) {
+      // text().N or text()[K].N
+      out.textNode = 1;
+      size_t cursor = 6;
+      if (cursor < step.size() && step[cursor] == '[') {
+        out.textNode = std::max(1, std::atoi(step.c_str() + cursor + 1));
+        cursor = step.find(']', cursor);
+        if (cursor == std::string::npos) return false;
+        cursor++;
+      }
+      if (cursor < step.size() && step[cursor] == '.')
+        out.offset = std::strtoul(step.c_str() + cursor + 1, nullptr, 10);
+      break;
+    }
+    // name, name[idx], or name[idx].N (offset on the element: treated as its start)
+    const size_t dot = step.find('.');
+    if (dot != std::string::npos) step.resize(dot);
+    int index = 1;
+    const size_t bracket = step.find('[');
+    if (bracket != std::string::npos) {
+      index = std::max(1, std::atoi(step.c_str() + bracket + 1));
+      step.resize(bracket);
+    }
+    if (step.empty()) return false;
+    out.path.push_back({step, index});
+  }
+  return spineIndex >= 0;
+}
+
+bool samePath(const std::vector<PathSegment>& a, const std::vector<PathSegment>& b) {
+  if (a.size() != b.size()) return false;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (a[i].index != b[i].index || a[i].name != b[i].name) return false;
+  }
+  return true;
+}
+
+// Reads up to maxChars of text starting at an xpointer (same text()[K] and
+// offset rules as XPathPointResolver).
+class XPathTextReader final : public ExpatTextStream {
+ public:
+  XPathTextReader(XPathTarget target, const size_t maxChars) : target(std::move(target)), maxChars(maxChars) {}
+
+  std::string text;
+  bool started() const { return capturing; }
+
+ protected:
+  void onStartElement(const std::string& name) override {
+    if (!insideBody) {
+      if (name == "body") {
+        insideBody = true;
+        bodyDepth = depth;
+        frames.clear();
+        frames.emplace_back();
+        frames.back().block = true;
+        if (target.path.empty() && target.textNode == 0) capturing = true;
+      }
+      depth++;
+      return;
+    }
+
+    inTextNode = false;
+    if (capturing && (isBlockTag(name) || name == "br")) pendingSpace = true;
+    Frame frame;
+    frame.block = isBlockTag(name);
+    frame.pre = frames.back().pre || isPreTag(name);
+    frames.back().childNodes++;
+    const int siblingIndex = frames.back().children.nextIndex(name);
+    path.push_back({name, siblingIndex});
+    frames.push_back(std::move(frame));
+    if (isNonVisibleTextTag(name)) nonVisibleDepth++;
+    if (!capturing && target.textNode == 0 && samePath(path, target.path)) capturing = true;
+    depth++;
+  }
+
+  void onEndElement(const std::string& name) override {
+    depth--;
+    if (!insideBody) return;
+    inTextNode = false;
+    if (capturing && isBlockTag(name)) pendingSpace = true;
+    if (depth == bodyDepth && name == "body") {
+      insideBody = false;
+      frames.clear();
+      path.clear();
+      return;
+    }
+    if (isNonVisibleTextTag(name) && nonVisibleDepth > 0) nonVisibleDepth--;
+    if (!path.empty()) path.pop_back();
+    if (frames.size() > 1) frames.pop_back();
+  }
+
+  void onCharacterData(const XML_Char* data, const int len) override {
+    if (!insideBody || nonVisibleDepth > 0 || len <= 0 || stopped || frames.empty()) return;
+    Frame& frame = frames.back();
+    if (!inTextNode) {
+      inTextNode = true;
+      textCounted = false;
+      nodeOffset = 0;
+      prevSpace = false;
+      firstChild = frame.childNodes == 0;
+      frame.childNodes++;
+    }
+
+    const unsigned char* ptr = reinterpret_cast<const unsigned char*>(data);
+    const unsigned char* end = ptr + len;
+    while (ptr < end) {
+      const uint32_t cp = utf8NextCodepoint(&ptr);
+      const bool space = isCollapsibleSpace(cp);
+      if (!textCounted && (!space || frame.pre || !(firstChild && frame.block))) {
+        textCounted = true;
+        frame.textNodes++;
+      }
+      if (!capturing && target.textNode > 0 && textCounted && frame.textNodes == target.textNode &&
+          nodeOffset >= target.offset && samePath(path, target.path)) {
+        capturing = true;
+      }
+      if (capturing) {
+        if (isWhitespaceOrSoftHyphen(cp)) {
+          if (cp != 0xAD) pendingSpace = true;
+        } else {
+          if (pendingSpace && !text.empty()) text += ' ';
+          pendingSpace = false;
+          appendUtf8(text, cp);
+          if (++captured >= maxChars) {
+            stop();
+            return;
+          }
+        }
+      }
+      if (!(space && prevSpace && !frame.pre)) nodeOffset += utf16Units(cp);
+      prevSpace = space;
+    }
+  }
+
+ private:
+  struct Frame {
+    ParentState children;
+    int childNodes = 0;
+    int textNodes = 0;
+    bool block = false;
+    bool pre = false;
+  };
+
+  const XPathTarget target;
+  const size_t maxChars;
+  size_t captured = 0;
+  std::vector<Frame> frames;
+  std::vector<PathSegment> path;
+  size_t nodeOffset = 0;
+  bool capturing = false;
+  bool pendingSpace = false;
+  bool inTextNode = false;
+  bool textCounted = false;
+  bool firstChild = false;
+  bool prevSpace = false;
+  bool insideBody = false;
+  int depth = 0;
+  int bodyDepth = -1;
+  int nonVisibleDepth = 0;
+};
+
+size_t spineStartSize(const std::shared_ptr<Epub>& epub, const int spineIndex) {
+  return spineIndex > 0 ? epub->getCumulativeSpineItemSize(spineIndex - 1) : 0;
+}
+}  // namespace
+
+bool ChapterXPathResolver::extractText(const std::shared_ptr<Epub>& epub, const int spineIndex,
+                                       const XPathTextLocation& location, std::string& out) {
+  out.clear();
+  if (!epub || spineIndex < 0 || spineIndex >= epub->getSpineItemsCount()) return false;
+  const auto href = epub->getSpineItem(spineIndex).href;
+  TextSpanExtractor extractor(location.loose ? MatchMode::Loose : MatchMode::Strict, location.start, location.end);
+  if (!extractor.ok() || !epub->readItemContentsToStream(href, extractor, 1024) || !extractor.finish() ||
+      !extractor.done) {
+    return false;
+  }
+  out = std::move(extractor.text);
+  return !out.empty();
+}
+
+bool ChapterXPathResolver::textAtXPath(const std::shared_ptr<Epub>& epub, const std::string& xpath,
+                                       const size_t maxChars, std::string& out, int& spineIndex) {
+  out.clear();
+  XPathTarget target;
+  if (!epub || !parseXPathTarget(xpath, spineIndex, target) || spineIndex >= epub->getSpineItemsCount()) {
+    return false;
+  }
+  const auto href = epub->getSpineItem(spineIndex).href;
+  XPathTextReader reader(std::move(target), maxChars);
+  if (!reader.ok() || !epub->readItemContentsToStream(href, reader, 1024)) return false;
+  reader.finish();
+  out = std::move(reader.text);
+  return !out.empty();
+}
+
+float ChapterXPathResolver::bookFraction(const std::shared_ptr<Epub>& epub, const int spineIndex,
+                                         const float intraFraction) {
+  const size_t total = epub ? epub->getBookSize() : 0;
+  if (total == 0 || spineIndex < 0 || spineIndex >= epub->getSpineItemsCount()) return 0.0f;
+  const size_t start = spineStartSize(epub, spineIndex);
+  const size_t size = epub->getCumulativeSpineItemSize(spineIndex) - start;
+  const float clamped = std::max(0.0f, std::min(1.0f, intraFraction));
+  return (static_cast<float>(start) + clamped * static_cast<float>(size)) / static_cast<float>(total);
+}
+
+bool ChapterXPathResolver::findTextInBook(const std::shared_ptr<Epub>& epub, const std::string& text,
+                                          const float bookFractionHint, const int maxSpineDistance, int& spineOut,
+                                          XPathTextLocation& out) {
+  spineOut = -1;
+  const int count = epub ? epub->getSpineItemsCount() : 0;
+  if (count <= 0) return false;
+
+  // Start where the same relative spot of the book is, then widen outwards.
+  int estimate = 0;
+  float intra = -1.0f;
+  const size_t total = epub->getBookSize();
+  if (total > 0 && bookFractionHint >= 0.0f) {
+    const size_t target = static_cast<size_t>(std::min(1.0f, bookFractionHint) * static_cast<float>(total));
+    while (estimate < count - 1 && epub->getCumulativeSpineItemSize(estimate) <= target) estimate++;
+    const size_t start = spineStartSize(epub, estimate);
+    const size_t size = epub->getCumulativeSpineItemSize(estimate) - start;
+    if (size > 0) intra = static_cast<float>(target - std::min(target, start)) / static_cast<float>(size);
+  }
+
+  const int limit = maxSpineDistance < 0 ? count : maxSpineDistance;
+  for (int distance = 0; distance <= limit; ++distance) {
+    for (const int sign : {1, -1}) {
+      if (distance == 0 && sign < 0) continue;
+      const int spine = estimate + sign * distance;
+      if (spine < 0 || spine >= count) continue;
+      if (locateText(epub, spine, text, distance == 0 ? intra : -1.0f, out)) {
+        spineOut = spine;
+        return true;
+      }
+    }
+    if (estimate - distance < 0 && estimate + distance >= count) break;
+  }
+  return false;
+}
