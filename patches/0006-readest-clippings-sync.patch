+namespace {
+// Readest renders custom hex colors; this grey is also what Readest's own
+// KOReader plugin maps KOReader's "gray" highlight to.
+constexpr char HIGHLIGHT_COLOR[] = "#9e9e9e";
+// Notes per POST. Clipping text is capped at 4 KB, so a batch stays well
+// under ~40 KB of JSON even in the worst case.
+constexpr size_t PUSH_BATCH = 10;
+// Pulled clippings have no real page layout; they store a position within a
+// virtual 1000-page chapter so "jump to clipping" lands near the right page.
+constexpr uint16_t VIRTUAL_PAGE_COUNT = 1000;
+// Position differences below this fraction count as "already in sync".
+constexpr float POSITION_EPSILON = 0.002f;
+constexpr unsigned long AUTO_RETURN_DELAY_MS = 2000;
+
+void wifiOff() {
+  WiFi.disconnect(false);
+  delay(100);
+  WiFi.mode(WIFI_OFF);
+  delay(100);
+}
+
+// Stable Readest note id so pushing the same clipping twice updates in place.
+std::string noteIdFor(const std::string& bookHash, const XPathTextRange& range) {
+  const std::string seed = "crossink:" + bookHash + ":" + range.start + ":" + range.end;
+  MD5Builder md5;
+  md5.begin();
+  md5.add(seed.c_str());
+  md5.calculate();
+  return std::string(md5.toString().c_str()).substr(0, 7);
+}
+
+// Spine index from a KOReader xpointer (/body/DocFragment[N]/...) or a CFI
+// (epubcfi(/6/2N[...]!...)). -1 if neither is usable.
+int spineIndexFromNote(const ReadestNote& note) {
+  static constexpr char kFragment[] = "/body/DocFragment";
+  if (note.xpointer0.rfind(kFragment, 0) == 0) {
+    const char* rest = note.xpointer0.c_str() + sizeof(kFragment) - 1;
+    return *rest == '[' ? std::atoi(rest + 1) - 1 : 0;
+  }
+  static constexpr char kCfiSpine[] = "epubcfi(/6/";
+  const size_t pos = note.cfi.find(kCfiSpine);
+  if (pos != std::string::npos) {
+    const int step = std::atoi(note.cfi.c_str() + pos + sizeof(kCfiSpine) - 1);
+    if (step >= 2) return step / 2 - 1;
+  }
+  return -1;
+}
+
+// Clipping text with whitespace, NBSP and soft hyphens removed, for dedupe.
+std::string compareKey(const std::string& text) {
+  std::string out;
+  out.reserve(text.size());
+  for (size_t i = 0; i < text.size(); ++i) {
+    const auto c = static_cast<unsigned char>(text[i]);
+    if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f') continue;
+    if (c == 0xC2 && i + 1 < text.size()) {
+      const auto next = static_cast<unsigned char>(text[i + 1]);
+      if (next == 0xA0 || next == 0xAD) {
+        ++i;
+        continue;
+      }
+    }
+    out += static_cast<char>(c);
+  }
+  return out;
+}
+
+uint16_t countWords(const std::string& text) {
+  uint16_t words = 0;
+  bool inWord = false;
+  for (const char ch : text) {
+    const bool space = ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r';
+    if (!space && !inWord && words < UINT16_MAX) words++;
+    inWord = !space;
+  }
+  return words;
+}
+
+std::string formatCount(const char* format, const int count) {
+  char buffer[96];
+  snprintf(buffer, sizeof(buffer), format, count);
+  return buffer;
+}
+
+std::string formatCounts(const char* format, const int first, const int second) {
+  char buffer[96];
+  snprintf(buffer, sizeof(buffer), format, first, second);
+  return buffer;
+}
+
+int percentOf(const float fraction) { return static_cast<int>(fraction * 100.0f + 0.5f); }
+
+// Spine index in *this* EPUB for a Readest note, via its xpointer or CFI
+// (both use the original/source spine numbering). -1 if unusable.
+int currentSpineForNote(const std::shared_ptr<Epub>& epub, const ReadestNote& note) {
+  const int sourceSpine = spineIndexFromNote(note);
+  if (sourceSpine < 0) return -1;
+  std::string xpath = note.xpointer0.rfind("/body/DocFragment[", 0) == 0
+                          ? note.xpointer0
+                          : "/body/DocFragment[" + std::to_string(sourceSpine + 1) + "]";
+  int spine = -1;
+  return ProgressMapper::sourceXPathToCurrent(epub, xpath, spine) ? spine : -1;
+}
+}  // namespace
+
+uint32_t ReadestSyncActivity::encodeBootPayload(const uint8_t orientation) {
+  return orientation < CrossPointSettings::ORIENTATION_COUNT ? static_cast<uint32_t>(orientation) + 1 : 0;
+}
+
+uint8_t ReadestSyncActivity::decodeBootOrientation(const uint32_t payload) {
+  const uint32_t bits = payload & 0xFF;
+  return bits > 0 && bits <= CrossPointSettings::ORIENTATION_COUNT ? static_cast<uint8_t>(bits - 1)
+                                                                   : CrossPointSettings::ORIENTATION_COUNT;
+}
+
+void ReadestSyncActivity::onEnter() {
+  Activity::onEnter();
+
+  const bool hasReaderOrientation = readerOrientation < CrossPointSettings::ORIENTATION_COUNT;
+  if (restartBeforeNetwork) {
+    if (hasReaderOrientation) ReaderUtils::applyOrientation(renderer, readerOrientation);
+    silentRestartToNetwork(NetworkBootTarget::READEST_SYNC, encodeBootPayload(readerOrientation));
+    return;
+  }
+
+  LOG_INF("RDS", "network entry free=%u maxAlloc=%u", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
+  ReaderUtils::applyOrientation(renderer, hasReaderOrientation ? readerOrientation : SETTINGS.orientation);
+
+  if (!READEST_STORE.hasCredentials()) {
+    fail(tr(STR_READEST_ERR_NO_CREDENTIALS));
+    return;
+  }
+
+  sdFontSystem.releaseLoadedFont(renderer);
+  wifiActivated = true;
+
+  if (hasActiveStationWifiConnection()) {
+    onWifiSelectionComplete(true);
+    return;
+  }
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput, true, true),
+                         [this](const ActivityResult& result) { onWifiSelectionComplete(!result.isCancelled); });
+}
+
+void ReadestSyncActivity::onExit() {
+  Activity::onExit();
+  if (restartBeforeNetwork) return;
+
+  CLIPPINGS.unload();
+  epub.reset();
+  if (wifiActivated) wifiOff();
+  // Always return through a clean reboot; this instance only exists in the
+  // lean network boot.
+  silentRestartToReader(true);
+}
+
+void ReadestSyncActivity::onWifiSelectionComplete(const bool success) {
+  if (!success) {
+    LOG_DBG("RDS", "WiFi connection failed, returning to reader");
+    returnToReader();
+    return;
+  }
+
+  WiFi.setSleep(false);
+  sdFontSystem.releaseForNetwork(renderer);
+
+  {
+    RenderLock lock(*this);
+    state = WORKING;
+    statusMessage = tr(STR_READEST_FINDING_BOOK);
+  }
+  if (requestUpdateAndWait() != RequestUpdateResult::Rendered) {
+    requestUpdate(true);
+  }
+
+  // Real wall-clock time for note and position timestamps.
+  if (!halClock.syncSystemTimeFromNTP()) {
+    LOG_DBG("RDS", "NTP sync unavailable; Readest will stamp records itself");
+  }
+
+  runSync();
+}
+
+void ReadestSyncActivity::setStatus(const char* message) {
+  {
+    RenderLock lock(*this);
+    statusMessage = message;
+  }
+  if (requestUpdateAndWait() != RequestUpdateResult::Rendered) {
+    requestUpdate(true);
+  }
+}
+
+void ReadestSyncActivity::fail(std::string detail) {
+  {
+    RenderLock lock(*this);
+    state = FAILED;
+    statusMessage = tr(STR_READEST_SYNC_FAILED);
+    detailMessage = std::move(detail);
+  }
+  requestUpdate(true);
+}
+
+void ReadestSyncActivity::runSync() {
+  epub = std::make_shared<Epub>(epubPath, "/.crosspoint");
+  epub->setupCacheDir();
+  // Metadata only: spine/TOC lookups and chapter streaming need no CSS or layout.
+  if (!epub->load(false, true, Epub::XLocationLoadMode::Immediate, true)) {
+    LOG_ERR("RDS", "Failed to load epub %s", epubPath.c_str());
+    epub.reset();
+    fail(tr(STR_READEST_OPEN_BOOK_FAILED));
+    return;
+  }
+
+  localHash = KOReaderDocumentId::calculate(epubPath);
+  ReadestBook book;
+  if (ReadestBookMap::lookup(localHash, book)) {
+    LOG_INF("RDS", "Using saved match \"%s\" (%s)", book.title.c_str(), book.hash.c_str());
+    syncWithBook(book);
+    return;
+  }
+
+  const auto found = client.findCandidates(epub->getTitle(), epub->getAuthor(), localHash, candidates);
+  if (found != ReadestClient::OK) {
+    std::string detail = ReadestClient::errorString(found);
+    if (found == ReadestClient::BOOK_NOT_FOUND) detail += ": " + epub->getTitle();
+    fail(std::move(detail));
+    return;
+  }
+
+  // Only ask when in doubt: an identical file, or a word-for-word title match
+  // clearly ahead of the runner-up, is taken (and remembered) straight away.
+  const int runnerUp = candidates.size() > 1 ? candidates[1].score : 0;
+  const int bestScore = candidates.front().score;
+  if (bestScore >= ReadestClient::SCORE_SAME_FILE ||
+      (bestScore >= ReadestClient::SCORE_CONFIDENT && bestScore - runnerUp >= ReadestClient::SCORE_CLEAR_LEAD)) {
+    book = candidates.front();
+    candidates.clear();
+    LOG_INF("RDS", "Auto-matched \"%s\" (score %d, runner-up %d)", book.title.c_str(), bestScore, runnerUp);
+    ReadestBookMap::remember(localHash, book);
+    syncWithBook(book);
+    return;
+  }
+  showChooser();
+}
+
+void ReadestSyncActivity::showChooser() {
+  std::vector<std::string> labels;
+  labels.reserve(candidates.size());
+  for (const auto& candidate : candidates) {
+    std::string label = candidate.title.empty() ? candidate.hash : candidate.title;
+    if (!candidate.author.empty()) label += " - " + candidate.author;
+    labels.push_back(std::move(label));
+  }
+
+  {
+    RenderLock lock(*this);
+    state = CHOOSING;
+    statusMessage = tr(STR_READEST_CHOOSE_BOOK);
+    detailMessage = epub->getTitle();
+    chosenIndex = -1;
+    choiceCancelled = false;
+    chooser.show(tr(STR_READEST_CHOOSE_BOOK), labels, 0, [this](const int index) { chosenIndex = index; });
+    chooser.setCancelCallback([this] { choiceCancelled = true; });
+  }
+  requestUpdate(true);
+}
+
+void ReadestSyncActivity::syncWithBook(const ReadestBook& book) {
+  if (!CLIPPINGS.loadForBook(epubPath, epub->getTitle(), epub->getAuthor(), "epub")) {
+    fail(tr(STR_READEST_OPEN_BOOK_FAILED));
+    return;
+  }
+
+  setStatus(tr(STR_READEST_PULLING));
+  std::vector<ReadestNote> remote;
+  const auto pulled = client.pullNotes(book, remote);
+  if (pulled != ReadestClient::OK) {
+    fail(ReadestClient::errorString(pulled));
+    return;
+  }
+
+  int added = 0;
+  int pushed = 0;
+  int skipped = 0;
+  if (!pullClippings(remote, added, skipped)) return;
+
+  setStatus(tr(STR_READEST_PUSHING));
+  if (!pushClippings(book, remote, pushed, skipped)) return;
+  remote.clear();
+  remote.shrink_to_fit();
+
+  setStatus(tr(STR_READEST_SYNCING_POSITION));
+  const std::string position = syncPosition(book);
+
+  LOG_INF("RDS", "Sync done: %d pulled, %d pushed, %d skipped", added, pushed, skipped);
+  std::string detail = formatCounts(tr(STR_READEST_SYNC_COUNTS_FORMAT), added, pushed);
+  if (skipped > 0) detail += "\n" + formatCount(tr(STR_READEST_SKIPPED_FORMAT), skipped);
+  if (!position.empty()) detail += "\n" + position;
+  {
+    RenderLock lock(*this);
+    state = DONE;
+    statusMessage = tr(STR_READEST_SYNC_DONE);
+    detailMessage = std::move(detail);
+    autoReturnAt = millis() + AUTO_RETURN_DELAY_MS;
+  }
+  requestUpdate(true);
+}
+
+bool ReadestSyncActivity::pullClippings(const std::vector<ReadestNote>& remote, int& added, int& skipped) {
+  // What the device already has, so repeated syncs (and our own pushed
+  // highlights coming back) don't create duplicates.
+  std::vector<std::pair<uint16_t, std::string>> existing;
+  existing.reserve(CLIPPINGS.clippingCount() + remote.size());
+  {
+    std::string text;
+    for (size_t i = 0; i < CLIPPINGS.clippingCount(); ++i) {
+      const Clipping* clipping = CLIPPINGS.clippingAt(i);
+      text.clear();
+      if (clipping && CLIPPINGS.readClippingText(i, text))
+        existing.emplace_back(clipping->spineIndex, compareKey(text));
+    }
+  }
+
+  const int spineCount = epub->getSpineItemsCount();
+  for (const ReadestNote& note : remote) {
+    if (note.deleted) continue;
+    const int spine = currentSpineForNote(epub, note);
+    if (spine < 0 || spine >= spineCount) {
+      skipped++;
+      continue;
+    }
+
+    const std::string key = compareKey(note.text);
+    bool duplicate = false;
+    for (const auto& item : existing) {
+      if (item.first == spine && item.second == key) {
+        duplicate = true;
+        break;
+      }
+    }
+    if (duplicate) continue;
+
+    XPathTextLocation location;
+    if (!ChapterXPathResolver::locateText(epub, spine, note.text, UINT16_MAX, location)) {
+      LOG_DBG("RDS", "Readest note %s not located in spine %d", note.id.c_str(), spine);
+      skipped++;
+      continue;
+    }
+
+    const uint16_t page =
+        location.total > 0
+            ? static_cast<uint16_t>(static_cast<uint64_t>(location.start) * (VIRTUAL_PAGE_COUNT - 1) / location.total)
+            : 0;
+    const int tocIndex = epub->getTocIndexForSpineIndex(spine);
+    const std::string chapterTitle = tocIndex >= 0 ? epub->getTocItem(tocIndex).title : "";
+
+    // layoutSignature 0 marks the range as layout-less: the reader matches
+    // the saved text on each page instead of trusting word indices.
+    const auto addResult =
+        CLIPPINGS.addClipping(static_cast<uint16_t>(spine), page, page, VIRTUAL_PAGE_COUNT, 0, 0, countWords(note.text),
+                              chapterTitle.c_str(), UINT16_MAX, note.text, UINT16_MAX, 0);
+    if (addResult == ClippingStore::AddResult::LimitReached) {
+      LOG_ERR("RDS", "Clipping limit reached while pulling");
+      break;
+    }
+    if (addResult == ClippingStore::AddResult::SaveFailed) {
+      fail(tr(STR_READEST_SAVE_FAILED));
+      return false;
+    }
+    existing.emplace_back(static_cast<uint16_t>(spine), key);
+    added++;
+  }
+  return true;
+}
+
+bool ReadestSyncActivity::pushClippings(const ReadestBook& book, const std::vector<ReadestNote>& remote, int& pushed,
+                                        int& skipped) {
+  if (!CLIPPINGS.hasClippings()) return true;
+
+  // Text Readest already has (live or deleted there) is never sent again: that
+  // covers clippings just pulled and highlights removed on purpose in Readest.
+  std::vector<std::string> remoteKeys;
+  remoteKeys.reserve(remote.size());
+  for (const ReadestNote& note : remote) remoteKeys.push_back(compareKey(note.text));
+
+  const time_t now = time(nullptr);
+  const int64_t nowMs = now > 1600000000 ? static_cast<int64_t>(now) * 1000 : 0;
+
+  JsonDocument batch;
+  JsonArray notes = batch.to<JsonArray>();
+  size_t batchCount = 0;
+  std::string text;
+  text.reserve(CLIPPING_TEXT_MAX);
+
+  const auto flush = [&]() -> ReadestClient::Error {
+    if (batchCount == 0) return ReadestClient::OK;
+    std::string json;
+    serializeJson(batch, json);
+    const auto result = client.pushNotes(json);
+    if (result == ReadestClient::OK) pushed += static_cast<int>(batchCount);
+    batch.clear();
+    notes = batch.to<JsonArray>();
+    batchCount = 0;
+    return result;
+  };
+
+  const size_t count = CLIPPINGS.clippingCount();
+  for (size_t i = 0; i < count; ++i) {
+    const Clipping* clipping = CLIPPINGS.clippingAt(i);
+    text.clear();
+    if (!clipping || !CLIPPINGS.readClippingText(i, text) || text.empty()) continue;
+
+    const std::string key = compareKey(text);
+    bool known = false;
+    for (const auto& remoteKey : remoteKeys) {
+      if (remoteKey == key) {
+        known = true;
+        break;
+      }
+    }
+    if (known) continue;
+
+    XPathTextRange range;
+    if (!ChapterXPathResolver::findXPathRangeForText(epub, clipping->spineIndex, text, clipping->paragraphIndex,
+                                                     range) ||
+        !ProgressMapper::currentXPathToSource(epub, clipping->spineIndex, range.start) ||
+        !ProgressMapper::currentXPathToSource(epub, clipping->spineIndex, range.end)) {
+      LOG_DBG("RDS", "Clipping %u not located in spine %u", static_cast<unsigned>(i), clipping->spineIndex);
+      skipped++;
+      continue;
+    }
+
+    JsonObject note = notes.add<JsonObject>();
+    note["bookHash"] = book.hash;
+    if (!book.metaHash.empty()) note["metaHash"] = book.metaHash;
+    note["id"] = noteIdFor(book.hash, range);
+    note["type"] = "annotation";
+    note["cfi"] = "";
+    note["xpointer0"] = range.start;
+    note["xpointer1"] = range.end;
+    note["text"] = text;
+    note["note"] = "";
+    note["style"] = "highlight";
+    note["color"] = HIGHLIGHT_COLOR;
+    if (nowMs > 0) note["createdAt"] = nowMs;
+    // Deliberately ancient: Readest's last-writer-wins then never lets a
+    // re-push overwrite (or resurrect) a highlight edited/deleted in Readest.
+    // New rows get a fresh updated_at from the server on insert.
+    note["updatedAt"] = 1;
+    batchCount++;
+
+    if (batchCount >= PUSH_BATCH) {
+      const auto result = flush();
+      if (result != ReadestClient::OK) {
+        fail(ReadestClient::errorString(result));
+        return false;
+      }
+    }
+  }
+
+  const auto result = flush();
+  if (result != ReadestClient::OK) {
+    fail(ReadestClient::errorString(result));
+    return false;
+  }
+  return true;
+}
+
+std::string ReadestSyncActivity::syncPosition(const ReadestBook& book) {
+  EpubReaderUtils::Progress progress;
+  EpubReaderUtils::loadProgress(*epub, progress, "RDS");
+  if (progress.spineIndex < 0 || progress.spineIndex >= epub->getSpineItemsCount()) progress.spineIndex = 0;
+  CrossPointPosition local = {progress.spineIndex, progress.pageNumber,
+                              progress.hasPageCount ? std::max(1, progress.pageCount) : 1};
+  if (progress.hasVisibleTextOffset) {
+    local.visibleTextOffset = progress.visibleTextOffset;
+    local.hasVisibleTextOffset = true;
+  }
+  // Readest has the original EPUB, so positions travel in source coordinates.
+  const KOReaderPosition localKo = ProgressMapper::toKOReader(epub, local, PositionCoordinateSpace::SourceDocument);
+
+  ReadestProgress remote;
+  const auto pulled = client.pullProgress(book, remote);
+  if (pulled != ReadestClient::OK) {
+    LOG_ERR("RDS", "Position pull failed: %d", static_cast<int>(pulled));
+    return tr(STR_READEST_POS_UNAVAILABLE);
+  }
+
+  // Map Readest's position into this layout and onto the same percentage
+  // scale as the local one before comparing.
+  bool remoteMapped = false;
+  float remotePct = -1.0f;
+  CrossPointPosition remotePos{};
+  if (remote.found && (!remote.xpointer.empty() || remote.fraction >= 0.0f)) {
+    KOReaderPosition ko;
+    ko.xpath = remote.xpointer;
+    ko.percentage = remote.fraction >= 0.0f ? remote.fraction : 0.0f;
+    remotePos = ProgressMapper::toCrossPoint(epub, ko, local.spineIndex, local.totalPages,
+                                             PositionCoordinateSpace::SourceDocument);
+    if (remotePos.valid && remotePos.spineIndex >= 0 && remotePos.spineIndex < epub->getSpineItemsCount()) {
+      remoteMapped = true;
+      remotePct = ProgressMapper::toKOReader(epub, remotePos).percentage;
+    }
+  }
+
+  if (remoteMapped && remotePct > localKo.percentage + POSITION_EPSILON) {
+    const int pageCount = std::max(remotePos.totalPages, remotePos.pageNumber + 1);
+    const std::optional<uint32_t> visibleTextOffset =
+        remotePos.hasVisibleTextOffset ? std::optional<uint32_t>(remotePos.visibleTextOffset) : std::nullopt;
+    if (!EpubReaderUtils::saveProgress(*epub, remotePos.spineIndex, remotePos.pageNumber, pageCount,
+                                       visibleTextOffset)) {
+      LOG_ERR("RDS", "Failed to save Readest position");
+      return tr(STR_READEST_POS_UNAVAILABLE);
+    }
+    RecentBookProgress::saveCachedEpubPercent(*epub, remotePos.spineIndex, remotePos.pageNumber, pageCount);
+    return formatCount(tr(STR_READEST_POS_FROM_READEST_FORMAT), percentOf(remotePct));
+  }
+
+  if (localKo.valid && !localKo.xpath.empty() && (!remoteMapped || localKo.percentage > remotePct + POSITION_EPSILON)) {
+    const auto pushed = client.pushProgress(book, localKo.xpath, localKo.percentage);
+    if (pushed != ReadestClient::OK) {
+      LOG_ERR("RDS", "Position push failed: %d", static_cast<int>(pushed));
+      return tr(STR_READEST_POS_UNAVAILABLE);
+    }
+    return formatCount(tr(STR_READEST_POS_TO_READEST_FORMAT), percentOf(localKo.percentage));
+  }
+
+  return remoteMapped ? tr(STR_READEST_POS_IN_SYNC) : tr(STR_READEST_POS_UNAVAILABLE);
+}
+
+void ReadestSyncActivity::returnToReader() { activityManager.goToReader(epubPath, false, false, true); }
+
+void ReadestSyncActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const Rect screen = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  const Rect header{screen.x, screen.y + metrics.topPadding, screen.width,
+                    TouchHeaderBackButton::height(metrics, mappedInput)};
+  const char* title = tr(STR_READEST_SYNC_BOOK);
+  const bool finished = state == DONE || state == FAILED;
+  if (finished && mappedInput.hasTouchHardware()) {
+    TouchHeaderBackButton::draw(renderer, header, title, false);
+  } else {
+    GUI.drawHeader(renderer, header, title);
+  }
+
+  const int lineHeight = renderer.getLineHeight(UI_10_FONT_ID);
+  const int top = screen.y + (screen.height - lineHeight * 4) / 2;
+  const Rect textArea{screen.x + metrics.contentSidePadding, screen.y, screen.width - metrics.contentSidePadding * 2,
+                      screen.height};
+  UITheme::drawCenteredWrappedText(renderer, textArea, UI_10_FONT_ID, top, statusMessage.c_str(), 2, true,
+                                   finished ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR, 4);
+  if (!detailMessage.empty()) {
+    UITheme::drawCenteredWrappedText(renderer, textArea, UI_10_FONT_ID, top + lineHeight * 2 + 10,
+                                     detailMessage.c_str(), 5, true, EpdFontFamily::REGULAR, 4);
+  }
+
+  // The chooser draws its own button hints and pushes the frame itself.
+  if (chooser.processRender(renderer, mappedInput)) return;
+
+  const auto labels = mappedInput.mapLabels(
+      finished ? mappedInput.withBackArrow(tr(STR_BACK)) : MappedInputManager::Label(""), "", "", "");
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+  renderer.displayBuffer(screenTransitionRefresh.modeFor(static_cast<uint8_t>(state)));
+}
+
+void ReadestSyncActivity::loop() {
+  if (state == CHOOSING) {
+    chooser.handleInput(mappedInput, [this] { requestUpdate(); });
+    if (chosenIndex >= 0 && chosenIndex < static_cast<int>(candidates.size())) {
+      const ReadestBook book = candidates[static_cast<size_t>(chosenIndex)];
+      candidates.clear();
+      ReadestBookMap::remember(localHash, book);
+      {
+        RenderLock lock(*this);
+        state = WORKING;
+        detailMessage.clear();
+      }
+      syncWithBook(book);
+    } else if (choiceCancelled || !chooser.isActive()) {
+      returnToReader();
+    }
+    return;
+  }
+  if (state != DONE && state != FAILED) return;
+
+  if (autoReturnAt != 0 && static_cast<long>(millis() - autoReturnAt) >= 0) {
+    returnToReader();
+    return;
+  }
+
+  const Rect header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+  int x = 0;
+  int y = 0;
+  if (TouchHeaderBackButton::wasTapped(mappedInput, header) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Back) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Confirm) || mappedInput.wasScreenTapped(x, y)) {
+    returnToReader();
+  }
+}
diff --git a/src/activities/reader/ReadestSyncActivity.h b/src/activities/reader/ReadestSyncActivity.h
new file mode 100644
index 00000000..1b36ef34
--- /dev/null
+++ b/src/activities/reader/ReadestSyncActivity.h
@@ -0,0 +1,91 @@
+#pragma once
+#include <Epub.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "CrossPointSettings.h"
+#include "activities/Activity.h"
+#include "activities/ScreenTransitionRefresh.h"
+#include "components/OptionPopup.h"
+#include "readest/ReadestClient.h"
+
+/**
+ * "Sync Readest": one pass that keeps this book and the same book in the
+ * user's Readest library in step.
+ *
+ *  1. Match the book: a remembered match (ReadestBookMap), else a confident
+ *     title/file match, else the user picks from the top 3 candidates.
+ *  2. Pull: Readest highlights not on the device become clippings. They carry
+ *     no layout signature, so the reader finds them by text.
+ *  3. Push: device clippings Readest doesn't have yet become grey Readest
+ *     highlights, located in the chapter XHTML as KOReader xpointers.
+ *  4. Position: furthest wins. The device jumps forward to Readest's
+ *     position, or sends its own position when it is ahead.
+ *
+ * Like KOReader sync, the reader first hands off to a tiny instance that
+ * reboots into the lean network mode (freeing the reader's heap before
+ * Wi-Fi/TLS); the real instance reboots back into the reader on exit.
+ */
+class ReadestSyncActivity final : public Activity {
+ public:
+  // Reader-side handoff: reboots into network mode on enter.
+  ReadestSyncActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, uint8_t readerOrientation)
+      : Activity("ReadestSync", renderer, mappedInput),
+        readerOrientation(readerOrientation),
+        restartBeforeNetwork(true) {}
+
+  // Network boot: performs the sync for `epubPath`.
+  ReadestSyncActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, std::string epubPath,
+                      uint8_t readerOrientation)
+      : Activity("ReadestSync", renderer, mappedInput),
+        epubPath(std::move(epubPath)),
+        readerOrientation(readerOrientation) {}
+
+  static uint32_t encodeBootPayload(uint8_t orientation);
+  static uint8_t decodeBootOrientation(uint32_t payload);
+
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  bool preventAutoSleep() override { return state == WORKING || state == CHOOSING; }
+
+ private:
+  enum State { WIFI_SELECTION, WORKING, CHOOSING, DONE, FAILED };
+
+  std::shared_ptr<Epub> epub;
+  std::string epubPath;
+  uint8_t readerOrientation = CrossPointSettings::ORIENTATION_COUNT;
+  bool restartBeforeNetwork = false;
+  bool wifiActivated = false;
+
+  State state = WIFI_SELECTION;
+  ScreenTransitionRefresh screenTransitionRefresh;
+  std::string statusMessage;
+  std::string detailMessage;
+  unsigned long autoReturnAt = 0;  // success screens close themselves
+  ReadestClient client;
+  std::string localHash;
+
+  // Book chooser (first sync of a book only, and only when in doubt).
+  OptionPopup chooser;
+  std::vector<ReadestBook> candidates;
+  int chosenIndex = -1;
+  bool choiceCancelled = false;
+
+  void onWifiSelectionComplete(bool success);
+  void setStatus(const char* message);
+  void fail(std::string detail);
+  void runSync();
+  void showChooser();
+  void syncWithBook(const ReadestBook& book);
+  // Each step returns false after reporting a fatal error via fail().
+  bool pullClippings(const std::vector<ReadestNote>& remote, int& added, int& skipped);
+  bool pushClippings(const ReadestBook& book, const std::vector<ReadestNote>& remote, int& pushed, int& skipped);
+  std::string syncPosition(const ReadestBook& book);
+  void returnToReader();
+};
