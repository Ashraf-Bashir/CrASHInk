+#pragma once
+
+#include <string>
+
+#include "activities/Activity.h"
+#include "activities/ScreenTransitionRefresh.h"
+
+/**
+ * Signs in to Readest with the saved email/password. Launched from the lean
+ * network boot; connects Wi-Fi, signs in, stores the session and reboots
+ * back to the normal app on exit.
+ */
+class ReadestAuthActivity final : public Activity {
+ public:
+  explicit ReadestAuthActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+      : Activity("ReadestAuth", renderer, mappedInput) {}
+
+  void onEnter() override;
+  void onExit() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+  bool preventAutoSleep() override { return state == CONNECTING || state == AUTHENTICATING; }
+
+ private:
+  enum State { WIFI_SELECTION, CONNECTING, AUTHENTICATING, SUCCESS, FAILED };
+
+  State state = WIFI_SELECTION;
+  ScreenTransitionRefresh screenTransitionRefresh;
+  std::string errorMessage;
+  unsigned long autoFinishAt = 0;  // "Connected" closes itself
+
+  void onWifiSelectionComplete(bool success);
+};
diff --git a/src/activities/settings/ReadestSettingsActivity.cpp b/src/activities/settings/ReadestSettingsActivity.cpp
new file mode 100644
index 00000000..611c867d
--- /dev/null
+++ b/src/activities/settings/ReadestSettingsActivity.cpp
@@ -0,0 +1,226 @@
+#include "ReadestSettingsActivity.h"
+
+#include <GfxRenderer.h>
+#include <HalFrontlight.h>
+#include <I18n.h>
+
+#include <string>
+#include <vector>
+
+#include "CrossPointSettings.h"
+#include "MappedInputManager.h"
+#include "SilentRestart.h"
+#include "activities/util/KeyboardEntryActivity.h"
+#include "components/TouchHeaderBackButton.h"
+#include "components/UITheme.h"
+#include "components/UIThemeTokens.h"
+#include "components/UiAppHelpers.h"
+#include "fontIds.h"
+#include "readest/ReadestBookMap.h"
+#include "readest/ReadestStore.h"
+#include "util/InputReleaseGuard.h"
+
+namespace fui = freeink::ui;
+
+namespace {
+constexpr int MENU_ITEMS = 4;
+constexpr int ROW_ACCOUNT = 0;
+constexpr int ROW_CONNECT = 1;
+constexpr int ROW_RESET_MATCHES = 2;
+constexpr int ROW_DISCONNECT = 3;
+const StrId menuNames[MENU_ITEMS] = {StrId::STR_READEST_ACCOUNT, StrId::STR_READEST_CONNECT,
+                                     StrId::STR_READEST_RESET_MATCHES, StrId::STR_READEST_DISCONNECT};
+constexpr fui::ActionId ACTION_ROW = 1;
+}  // namespace
+
+ReadestSettingsActivity::ReadestSettingsActivity(GfxRenderer& renderer, MappedInputManager& mappedInput)
+    : Activity("ReadestSettings", renderer, mappedInput),
+      uiTarget(makeUiTarget(renderer)),
+      app(uiTarget, uiTarget.deviceContext()) {}
+
+void ReadestSettingsActivity::onRowEvent(const fui::ActionEvent& event, void* user) {
+  auto* self = static_cast<ReadestSettingsActivity*>(user);
+  if (event.value < 0 || event.value >= MENU_ITEMS) return;
+  self->selectedIndex = static_cast<size_t>(event.value);
+  self->app.clearTapFlash();
+  self->handleSelection();
+}
+
+void ReadestSettingsActivity::onEnter() {
+  Activity::onEnter();
+
+  ignoreInitialConfirmRelease = mappedInput.isPressed(MappedInputManager::Button::Confirm);
+  selectedIndex = 0;
+  pendingStep = PendingStep::None;
+  uiReady = false;
+  visibleRows = 1;
+  topIndex = 0;
+  applySharedUiTheme(app, uiTarget);
+  app.on(ACTION_ROW, &ReadestSettingsActivity::onRowEvent, this);
+  app.setScreen(&ReadestSettingsActivity::listScreen, this);
+  READEST_STORE.ensureLoaded();
+  requestUpdate();
+}
+
+void ReadestSettingsActivity::onExit() { Activity::onExit(); }
+
+void ReadestSettingsActivity::askEmail() {
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(renderer, mappedInput, tr(STR_READEST_EMAIL),
+                                                                 READEST_STORE.getEmail(), 128, InputType::Text),
+                         [this](const ActivityResult& result) {
+                           if (result.isCancelled) return;
+                           pendingEmail = std::get<KeyboardResult>(result.data).text;
+                           if (!pendingEmail.empty()) pendingStep = PendingStep::AskPassword;
+                         });
+}
+
+void ReadestSettingsActivity::askPassword() {
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(renderer, mappedInput, tr(STR_READEST_PASSWORD), "",
+                                                                 128, InputType::Password),
+                         [this](const ActivityResult& result) {
+                           if (result.isCancelled) return;
+                           const std::string password = std::get<KeyboardResult>(result.data).text;
+                           if (password.empty()) return;
+                           READEST_STORE.setCredentials(pendingEmail, password);
+                           READEST_STORE.saveToFile();
+                           pendingStep = PendingStep::Connect;
+                         });
+}
+
+void ReadestSettingsActivity::loop() {
+  if (pendingStep == PendingStep::AskPassword) {
+    pendingStep = PendingStep::None;
+    askPassword();
+    return;
+  }
+  if (pendingStep == PendingStep::Connect) {
+    pendingStep = PendingStep::None;
+    // Sign-in needs Wi-Fi + TLS; reboot into the lean network mode first.
+    // That reboot restores the frontlight from the saved setting, so save the
+    // light's actual state first.
+    SETTINGS.frontlightOn = Frontlight.isOn() ? 1 : 0;
+    SETTINGS.saveToFile();
+    silentRestartToNetwork(NetworkBootTarget::READEST_AUTH);
+    return;
+  }
+
+  if (InputReleaseGuard::consumeInitialRelease(mappedInput, MappedInputManager::Button::Confirm,
+                                               ignoreInitialConfirmRelease)) {
+    return;
+  }
+
+  if (TouchHeaderBackButton::wasTapped(mappedInput, renderer) ||
+      mappedInput.wasPressed(MappedInputManager::Button::Back)) {
+    finishAfterBackPress();
+    return;
+  }
+
+  if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
+    handleSelection();
+    return;
+  }
+
+  if (uiReady) {
+    const fui::InputSnapshot snap = touchSnapshotFrom(mappedInput);
+    if (snap.touchPressed || snap.touchReleased) {
+      const auto event = app.route(snap);
+      if (app.invalidated()) requestUpdate();
+      if (event) return;
+    }
+  }
+
+  buttonNavigator.onNext([this] {
+    selectedIndex = (selectedIndex + 1) % MENU_ITEMS;
+    topIndex = followListSelection(static_cast<int>(selectedIndex), topIndex, visibleRows, MENU_ITEMS);
+    requestUpdate();
+  });
+
+  buttonNavigator.onPrevious([this] {
+    selectedIndex = (selectedIndex + MENU_ITEMS - 1) % MENU_ITEMS;
+    topIndex = followListSelection(static_cast<int>(selectedIndex), topIndex, visibleRows, MENU_ITEMS);
+    requestUpdate();
+  });
+}
+
+void ReadestSettingsActivity::handleSelection() {
+  if (selectedIndex == ROW_ACCOUNT) {
+    askEmail();
+  } else if (selectedIndex == ROW_CONNECT) {
+    if (READEST_STORE.hasCredentials()) {
+      pendingStep = PendingStep::Connect;
+    } else {
+      askEmail();
+    }
+  } else if (selectedIndex == ROW_RESET_MATCHES) {
+    // Next sync of each book asks again which Readest book it is.
+    ReadestBookMap::clearAll();
+    requestUpdate();
+  } else if (selectedIndex == ROW_DISCONNECT) {
+    READEST_STORE.clear();
+    READEST_STORE.saveToFile();
+    // Matches point at the old account's library.
+    ReadestBookMap::clearAll();
+    requestUpdate();
+  }
+}
+
+void ReadestSettingsActivity::listScreen(UiApp::ScreenType& screen, void* user) {
+  static_cast<ReadestSettingsActivity*>(user)->buildListScreen(screen);
+}
+
+void ReadestSettingsActivity::buildListScreen(UiApp::ScreenType& screen) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  screen.setContentMargin(
+      fui::Insets{static_cast<int16_t>(metrics.topPadding + TouchHeaderBackButton::height(metrics, mappedInput)), 0,
+                  static_cast<int16_t>(metrics.buttonHintsHeight), 0});
+  screen.spacer(static_cast<int16_t>(metrics.verticalSpacing));
+
+  std::vector<std::string> values(MENU_ITEMS);
+  const std::string& email = READEST_STORE.getEmail();
+  values[ROW_ACCOUNT] = email.empty() ? tr(STR_NOT_SET) : email;
+  values[ROW_CONNECT] = READEST_STORE.isConnected() ? tr(STR_READEST_CONNECTED) : tr(STR_READEST_NOT_CONNECTED);
+
+  std::vector<fui::ListItem> items;
+  items.reserve(MENU_ITEMS);
+  for (int i = 0; i < MENU_ITEMS; i++) {
+    fui::ListItem item;
+    item.label = I18N.get(menuNames[i]);
+    if (!values[i].empty()) item.value = values[i].c_str();
+    item.actionValue = static_cast<int16_t>(i);
+    items.push_back(item);
+  }
+
+  fui::ListProps props;
+  props.items = items.data();
+  props.count = static_cast<uint16_t>(items.size());
+  props.selectedIndex = static_cast<int16_t>(selectedIndex);
+  props.action = ACTION_ROW;
+  props.inputMask = fui::InputTouch;
+  props.valueInset = 8;
+  const auto rows = configureUiList(props, screen.theme(), screen.body());
+  visibleRows = rows > 0 ? rows : 1;
+  topIndex = scrollListBy(topIndex, 0, visibleRows, MENU_ITEMS);
+  props.topIndex = static_cast<uint16_t>(topIndex);
+  screen.list(props);
+}
+
+void ReadestSettingsActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+
+  const Rect header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+  if (mappedInput.hasTouchHardware()) {
+    TouchHeaderBackButton::draw(renderer, uiTarget, header, tr(STR_READEST_SYNC), false);
+  } else {
+    GUI.drawHeader(renderer, header, tr(STR_READEST_SYNC));
+  }
+
+  uiReady = false;
+  app.render();
+  uiReady = true;
+
+  const auto labels =
+      mappedInput.mapLabels(mappedInput.withBackArrow(tr(STR_BACK)), tr(STR_SELECT), tr(STR_DIR_UP), tr(STR_DIR_DOWN));
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+
+  renderer.displayBuffer();
+}
