+ReadestClient::Error ReadestClient::requestToken(const char* grantType, const std::string& body) {
+  if (insufficientHeap()) return LOW_MEMORY;
+
+  int code = 0;
+  JsonDocument doc;
+  {
+    freeink::SecureHttpClient http;
+    code = sendJson(http, "POST", std::string(SUPABASE_AUTH_URL) + grantType, "", true, body, true);
+    LOG_DBG("RDS", "Token (%s) response: %d", grantType, code);
+    if (code != 200) {
+      http.end();
+      return errorForStatus(code);
+    }
+
+    JsonDocument filter;
+    filter["access_token"] = true;
+    filter["refresh_token"] = true;
+    filter["user"]["id"] = true;
+    const DeserializationError error = deserializeJson(doc, http.getString(), DeserializationOption::Filter(filter));
+    http.end();
+    if (error) {
+      LOG_ERR("RDS", "Token JSON parse failed: %s", error.c_str());
+      return JSON_ERROR;
+    }
+  }
+
+  const char* access = doc["access_token"] | "";
+  const char* refresh = doc["refresh_token"] | "";
+  if (access[0] == '\0') {
+    LOG_ERR("RDS", "Token response had no access_token");
+    return JSON_ERROR;
+  }
+  accessToken = access;
+  // Supabase rotates refresh tokens on every use; persist the new one at once.
+  READEST_STORE.setSession(doc["user"]["id"] | "", refresh);
+  READEST_STORE.saveToFile();
+  return OK;
+}
+
+ReadestClient::Error ReadestClient::signIn() {
+  if (!READEST_STORE.hasCredentials()) return NO_CREDENTIALS;
+  JsonDocument doc;
+  doc["email"] = READEST_STORE.getEmail();
+  doc["password"] = READEST_STORE.getPassword();
+  std::string body;
+  serializeJson(doc, body);
+  const Error result = requestToken("password", body);
+  if (result == AUTH_FAILED) {
+    READEST_STORE.clearSession();
+    READEST_STORE.saveToFile();
+  }
+  return result;
+}
+
+ReadestClient::Error ReadestClient::ensureSession() {
+  if (!accessToken.empty()) return OK;
+  if (!READEST_STORE.hasCredentials()) return NO_CREDENTIALS;
+
+  const std::string refresh = READEST_STORE.getRefreshToken();
+  if (!refresh.empty()) {
+    JsonDocument doc;
+    doc["refresh_token"] = refresh;
+    std::string body;
+    serializeJson(doc, body);
+    const Error result = requestToken("refresh_token", body);
+    if (result == OK || result == NETWORK_ERROR || result == LOW_MEMORY) return result;
+    LOG_DBG("RDS", "Refresh token rejected, signing in with password");
+  }
+  return signIn();
+}
+
+ReadestClient::Error ReadestClient::findCandidates(const std::string& title, const std::string& author,
+                                                   const std::string& localHash, std::vector<ReadestBook>& out) {
+  out.clear();
+  const Error session = ensureSession();
+  if (session != OK) return session;
+
+  const std::vector<std::string> wantedTitle = titleWords(title);
+  const std::vector<std::string> wantedAuthor = titleWords(author);
+
+  JsonDocument filter;
+  JsonObject rowFilter = filter["books"][0].to<JsonObject>();
+  rowFilter["book_hash"] = true;
+  rowFilter["meta_hash"] = true;
+  rowFilter["title"] = true;
+  rowFilter["source_title"] = true;
+  rowFilter["author"] = true;
+  rowFilter["format"] = true;
+  rowFilter["deleted_at"] = true;
+  rowFilter["synced_at"] = true;
+
+  out.reserve(MAX_CANDIDATES);
+  int64_t since = 0;
+  std::string previousLast;
+  for (int page = 0; page < BOOKS_MAX_PAGES; ++page) {
+    if (insufficientHeap()) return LOW_MEMORY;
+    const std::string url = std::string(SYNC_URL) + "?since=" + std::to_string(since) +
+                            "&type=books&book=&meta_hash=&limit=" + std::to_string(BOOKS_PAGE_SIZE);
+
+    JsonDocument doc;
+    {
+      freeink::SecureHttpClient http;
+      const int code = sendJson(http, "GET", url, accessToken, false, "", true);
+      if (code != 200) {
+        LOG_ERR("RDS", "Library page %d failed: %d", page, code);
+        http.end();
+        return errorForStatus(code);
+      }
+      const DeserializationError error = deserializeJson(doc, http.getString(), DeserializationOption::Filter(filter));
+      http.end();
+      if (error) {
+        LOG_ERR("RDS", "Library JSON parse failed: %s", error.c_str());
+        return JSON_ERROR;
+      }
+    }
+
+    const JsonArrayConst rows = doc["books"].as<JsonArrayConst>();
+    std::string pageLast;
+    for (const JsonObjectConst row : rows) {
+      pageLast = row["synced_at"] | "";
+      const char* hash = row["book_hash"] | "";
+      if (hash[0] == '\0' || isDummyHash(hash) || !row["deleted_at"].isNull()) continue;
+
+      const char* rowTitle = row["title"] | "";
+      const char* rowAuthor = row["author"] | "";
+      int score = std::max(wordSimilarity(wantedTitle, titleWords(rowTitle)),
+                           wordSimilarity(wantedTitle, titleWords(row["source_title"] | "")));
+      if (score > 0 && wordSimilarity(wantedAuthor, titleWords(rowAuthor)) > 0) score += 15;
+      if (localHash == hash) score = SCORE_SAME_FILE;  // Readest imported this very file
+      if (score <= 0) continue;
+
+      ReadestBook book;
+      book.hash = hash;
+      book.metaHash = row["meta_hash"] | "";
+      book.title = rowTitle;
+      book.author = rowAuthor;
+      book.format = row["format"] | "";
+      book.score = score;
+      offerCandidate(out, std::move(book));
+    }
+
+    if (rows.size() < static_cast<size_t>(BOOKS_PAGE_SIZE)) break;
+
+    int64_t next = parseIsoMs(pageLast.c_str());
+    if (next < 0) break;
+    // The cursor is millisecond-truncated; guarantee forward progress.
+    if (next <= since || pageLast == previousLast) next = since + 1;
+    previousLast = pageLast;
+    since = next;
+  }
+
+  if (out.empty()) {
+    LOG_INF("RDS", "No Readest book resembles \"%s\"", title.c_str());
+    return BOOK_NOT_FOUND;
+  }
+  for (const auto& book : out) {
+    LOG_INF("RDS", "Candidate %d: \"%s\" (%s)", book.score, book.title.c_str(), book.hash.c_str());
+  }
+  return OK;
+}
+
+ReadestClient::Error ReadestClient::postSync(const std::string& body) {
+  const Error session = ensureSession();
+  if (session != OK) return session;
+  if (insufficientHeap()) return LOW_MEMORY;
+
+  freeink::SecureHttpClient http;
+  const int code = sendJson(http, "POST", SYNC_URL, accessToken, false, body, false);
+  http.end();
+  LOG_DBG("RDS", "Sync POST response: %d (%u bytes sent)", code, static_cast<unsigned>(body.size()));
+  if (code >= 200 && code < 300) return OK;
+  return errorForStatus(code);
+}
+
+ReadestClient::Error ReadestClient::pushNotes(const std::string& notesJson) {
+  std::string body;
+  body.reserve(notesJson.size() + 40);
+  body += "{\"books\":[],\"notes\":";
+  body += notesJson;
+  body += ",\"configs\":[]}";
+  return postSync(body);
+}
+
+ReadestClient::Error ReadestClient::downloadBook(const ReadestBook& book, const std::string& destPath) {
+  const Error session = ensureSession();
+  if (session != OK) return session;
+  if (insufficientHeap()) return LOW_MEMORY;
+  const std::string& userId = READEST_STORE.getUserId();
+  if (userId.empty() || book.hash.empty() || (!book.format.empty() && strcasecmp(book.format.c_str(), "EPUB") != 0)) {
+    return BOOK_NOT_FOUND;
+  }
+
+  // Same key shape as readest.koplugin; the server resolves the stored name.
+  const std::string fileKey = userId + "/Readest/Books/" + book.hash + "/" + book.hash + ".epub";
+  std::string downloadUrl;
+  {
+    freeink::SecureHttpClient http;
+    const int code = sendJson(http, "GET", std::string(STORAGE_DOWNLOAD_URL) + fileKey, accessToken, false, "", true);
+    if (code != 200) {
+      LOG_ERR("RDS", "Download URL request failed: %d", code);
+      http.end();
+      return code == 404 ? BOOK_NOT_FOUND : errorForStatus(code);
+    }
+    JsonDocument filter;
+    filter["downloadUrl"] = true;
+    JsonDocument doc;
+    const DeserializationError error = deserializeJson(doc, http.getString(), DeserializationOption::Filter(filter));
+    http.end();
+    if (error || !doc["downloadUrl"].is<const char*>()) {
+      LOG_ERR("RDS", "Download URL response unusable");
+      return JSON_ERROR;
+    }
+    downloadUrl = doc["downloadUrl"].as<const char*>();
+  }
+
+  // Only the text: chapters, OPF/NCX and container, fetched with range
+  // requests. Images and fonts, usually most of the file, are never downloaded.
+  if (!ReadestTextEpub::download(downloadUrl, destPath)) return SERVER_ERROR;
+  return OK;
+}
+
+ReadestClient::Error ReadestClient::pullProgress(const ReadestBook& book, ReadestProgress& out) {
+  out = ReadestProgress{};
+  const Error session = ensureSession();
+  if (session != OK) return session;
+  if (insufficientHeap()) return LOW_MEMORY;
+
+  const std::string url =
+      std::string(SYNC_URL) + "?since=0&type=configs&book=" + book.hash + "&meta_hash=" + book.metaHash;
+
+  JsonDocument filter;
+  JsonObject configFilter = filter["configs"][0].to<JsonObject>();
+  configFilter["book_hash"] = true;
+  configFilter["xpointer"] = true;
+  configFilter["progress"] = true;
+  configFilter["deleted_at"] = true;
+
+  JsonDocument doc;
+  {
+    freeink::SecureHttpClient http;
+    const int code = sendJson(http, "GET", url, accessToken, false, "", true);
+    if (code != 200) {
+      LOG_ERR("RDS", "Progress pull failed: %d", code);
+      http.end();
+      return errorForStatus(code);
+    }
+    const DeserializationError error = deserializeJson(doc, http.getString(), DeserializationOption::Filter(filter));
+    http.end();
+    if (error) {
+      LOG_ERR("RDS", "Progress JSON parse failed: %s", error.c_str());
+      return JSON_ERROR;
+    }
+  }
+
+  // Siblings (same meta_hash, other files) are skipped: their positions refer
+  // to a different file's structure, which Readest itself also refuses to trust.
+  for (const JsonObjectConst config : doc["configs"].as<JsonArrayConst>()) {
+    if (book.hash != (config["book_hash"] | "") || !config["deleted_at"].isNull()) continue;
+    out.found = true;
+    out.xpointer = config["xpointer"] | "";
+    // progress is stored as a JSON string "[current,total]" (or an array).
+    int current = 0;
+    int total = 0;
+    const JsonVariantConst progress = config["progress"];
+    if (progress.is<JsonArrayConst>()) {
+      current = progress[0] | 0;
+      total = progress[1] | 0;
+    } else if (progress.is<const char*>()) {
+      std::sscanf(progress.as<const char*>(), "[%d,%d]", &current, &total);
+    }
+    if (total > 0 && current >= 0) out.fraction = std::min(1.0f, static_cast<float>(current) / total);
+    break;
+  }
+  LOG_INF("RDS", "Readest progress: found=%d frac=%.3f xp=%s", out.found ? 1 : 0, out.fraction, out.xpointer.c_str());
+  return OK;
+}
+
+ReadestClient::Error ReadestClient::pushProgress(const ReadestBook& book, const std::string& xpointer,
+                                                 const float fraction) {
+  JsonDocument doc;
+  doc["books"].to<JsonArray>();
+  doc["notes"].to<JsonArray>();
+  JsonObject config = doc["configs"].to<JsonArray>().add<JsonObject>();
+  config["bookHash"] = book.hash;
+  if (!book.metaHash.empty()) config["metaHash"] = book.metaHash;
+  config["xpointer"] = xpointer;
+  // Readest reads progress as [current, total]; a per-mille fraction keeps the
+  // sibling-fraction comparison meaningful without inventing page numbers.
+  JsonArray progress = config["progress"].to<JsonArray>();
+  const float clamped = std::max(0.0f, std::min(1.0f, fraction));
+  progress.add(static_cast<int>(clamped * 1000.0f + 0.5f));
+  progress.add(1000);
+  const time_t now = time(nullptr);
+  if (now > 1600000000) config["updatedAt"] = static_cast<int64_t>(now) * 1000;
+
+  std::string body;
+  serializeJson(doc, body);
+  return postSync(body);
+}
+
+ReadestClient::Error ReadestClient::pullNotes(const ReadestBook& book, std::vector<ReadestNote>& out) {
+  out.clear();
+  const Error session = ensureSession();
+  if (session != OK) return session;
+  if (insufficientHeap()) return LOW_MEMORY;
+
+  const std::string url =
+      std::string(SYNC_URL) + "?since=0&type=notes&book=" + book.hash + "&meta_hash=" + book.metaHash;
+
+  JsonDocument filter;
+  JsonObject noteFilter = filter["notes"][0].to<JsonObject>();
+  noteFilter["id"] = true;
+  noteFilter["type"] = true;
+  noteFilter["cfi"] = true;
+  noteFilter["xpointer0"] = true;
+  noteFilter["text"] = true;
+  noteFilter["color"] = true;
+  noteFilter["deleted_at"] = true;
+
+  JsonDocument doc;
+  {
+    freeink::SecureHttpClient http;
+    const int code = sendJson(http, "GET", url, accessToken, false, "", true);
+    if (code != 200) {
+      LOG_ERR("RDS", "Notes pull failed: %d", code);
+      http.end();
+      return errorForStatus(code);
+    }
+    const DeserializationError error = deserializeJson(doc, http.getString(), DeserializationOption::Filter(filter));
+    http.end();
+    if (error) {
+      LOG_ERR("RDS", "Notes JSON parse failed: %s", error.c_str());
+      return JSON_ERROR;
+    }
+  }
+
+  const JsonArrayConst notes = doc["notes"].as<JsonArrayConst>();
+  out.reserve(notes.size());
+  for (const JsonObjectConst note : notes) {
+    const char* type = note["type"] | "";
+    if (std::strcmp(type, "annotation") != 0 && std::strcmp(type, "excerpt") != 0) continue;
+    const char* text = note["text"] | "";
+    if (text[0] == '\0') continue;
+    ReadestNote item;
+    item.id = note["id"] | "";
+    item.cfi = note["cfi"] | "";
+    item.xpointer0 = note["xpointer0"] | "";
+    item.text = text;
+    item.color = note["color"] | "";
+    item.deleted = !note["deleted_at"].isNull();
+    out.push_back(std::move(item));
+  }
+  LOG_INF("RDS", "Pulled %u highlights", static_cast<unsigned>(out.size()));
+  return OK;
+}
+
+const char* ReadestClient::errorString(const Error error) {
+  switch (error) {
+    case OK:
+      return "";
+    case NO_CREDENTIALS:
+      return tr(STR_READEST_ERR_NO_CREDENTIALS);
+    case NETWORK_ERROR:
+      return tr(STR_READEST_ERR_NETWORK);
+    case AUTH_FAILED:
+      return tr(STR_READEST_ERR_AUTH);
+    case SERVER_ERROR:
+      return tr(STR_READEST_ERR_SERVER);
+    case JSON_ERROR:
+      return tr(STR_READEST_ERR_JSON);
+    case BOOK_NOT_FOUND:
+      return tr(STR_READEST_ERR_BOOK);
+    case LOW_MEMORY:
+      return tr(STR_READEST_ERR_MEMORY);
+  }
+  return tr(STR_READEST_SYNC_FAILED);
+}
diff --git a/src/readest/ReadestClient.h b/src/readest/ReadestClient.h
new file mode 100644
index 00000000..c2f252c4
--- /dev/null
+++ b/src/readest/ReadestClient.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// A book row from the user's Readest library.
+struct ReadestBook {
+  std::string hash;      // Readest book_hash (KOReader-style partial MD5 of the file Readest imported)
+  std::string metaHash;  // Readest meta_hash (title/author/identifier fingerprint)
+  std::string title;
+  std::string author;
+  std::string format;  // Readest format column, e.g. "EPUB"
+  int score = 0;       // similarity to the local book, higher is closer (transient)
+};
+
+// A highlight pulled from Readest.
+struct ReadestNote {
+  std::string id;
+  std::string cfi;
+  std::string xpointer0;
+  std::string text;
+  std::string color;
+  bool deleted = false;  // tombstone: deleted in Readest
+};
+
+// Reading position Readest stores for a book (book_configs row).
+struct ReadestProgress {
+  bool found = false;
+  std::string xpointer;    // KOReader xpointer, may be empty
+  float fraction = -1.0f;  // progress[0] / progress[1], -1 when unknown
+};
+
+/**
+ * Minimal Readest cloud client (Supabase auth + /api/sync), mirroring what
+ * Readest's own KOReader plugin does.
+ *
+ * Memory: every request builds its own SecureHttpClient on the stack and
+ * releases it before returning. Large responses are either discarded while
+ * streaming (push) or parsed through an ArduinoJson filter (library, notes)
+ * so only the handful of fields we use are kept.
+ */
+class ReadestClient {
+ public:
+  enum Error {
+    OK = 0,
+    NO_CREDENTIALS,
+    NETWORK_ERROR,
+    AUTH_FAILED,
+    SERVER_ERROR,
+    JSON_ERROR,
+    BOOK_NOT_FOUND,
+    LOW_MEMORY,
+  };
+
+  // Sign in with the stored email/password and persist the new session.
+  Error signIn();
+
+  // Get an access token for this session: refresh token first, then password.
+  Error ensureSession();
+
+  // Scan the Readest library and return up to MAX_CANDIDATES books ranked by
+  // title (and author) similarity. A book imported from the identical file
+  // (`localHash`) always ranks first. BOOK_NOT_FOUND if nothing is similar.
+  static constexpr size_t MAX_CANDIDATES = 3;
+  // Candidate scores: word-overlap similarity 0..100 (+15 when the author
+  // matches too); an identical file is SCORE_SAME_FILE. A match is taken
+  // without asking when it reaches SCORE_CONFIDENT with a clear lead.
+  static constexpr int SCORE_SAME_FILE = 1000;
+  static constexpr int SCORE_CONFIDENT = 100;
+  static constexpr int SCORE_CLEAR_LEAD = 15;
+  Error findCandidates(const std::string& title, const std::string& author, const std::string& localHash,
+                       std::vector<ReadestBook>& out);
+
+  // POST {"books":[],"notes":[...],"configs":[]}; `notesJson` is the notes array.
+  Error pushNotes(const std::string& notesJson);
+
+  // All highlight/excerpt notes Readest has for the book, tombstones included.
+  Error pullNotes(const ReadestBook& book, std::vector<ReadestNote>& out);
+
+  // Download the text of Readest's own copy of the book (EPUB only) from
+  // Readest cloud storage into a slim EPUB at `destPath` (see ReadestTextEpub).
+  Error downloadBook(const ReadestBook& book, const std::string& destPath);
+
+  // Reading position for exactly this Readest book (same book_hash).
+  Error pullProgress(const ReadestBook& book, ReadestProgress& out);
+  Error pushProgress(const ReadestBook& book, const std::string& xpointer, float fraction);
+
+  static const char* errorString(Error error);
+
+ private:
+  std::string accessToken;
+
+  Error requestToken(const char* grantType, const std::string& body);
+  Error postSync(const std::string& body);
+};
diff --git a/src/readest/ReadestStore.cpp b/src/readest/ReadestStore.cpp
new file mode 100644
index 00000000..c44719f0
--- /dev/null
+++ b/src/readest/ReadestStore.cpp
@@ -0,0 +1,63 @@
+#include "ReadestStore.h"
+
+#include <Logging.h>
+#include <ObfuscationUtils.h>
+
+void ReadestStore::toJson(JsonDocument& doc) const {
+  // Fields directly: getters lazy-load and saveToFile() already holds the store mutex.
+  doc["email"] = email;
+  doc["password_obf"] = obfuscation::obfuscateToBase64(password);
+  doc["userId"] = userId;
+  doc["refresh_obf"] = obfuscation::obfuscateToBase64(refreshToken);
+  doc["connected"] = connected;
+}
+
+bool ReadestStore::fromJson(JsonVariantConst doc) {
+  email = doc["email"] | "";
+  password = obfuscation::deobfuscateFromBase64(doc["password_obf"] | "");
+  userId = doc["userId"] | "";
+  refreshToken = obfuscation::deobfuscateFromBase64(doc["refresh_obf"] | "");
+  connected = doc["connected"] | false;
+  if (!email.empty() && password.empty()) {
+    LOG_ERR("RDS", "Ignoring unreadable Readest password");
+    connected = false;
+  }
+  return true;
+}
+
+void ReadestStore::setCredentials(const std::string& newEmail, const std::string& newPassword) {
+  ensureLoaded();
+  if (newEmail != email || newPassword != password) {
+    connected = false;
+    userId.clear();
+    refreshToken.clear();
+  }
+  email = newEmail;
+  password = newPassword;
+}
+
+bool ReadestStore::hasCredentials() const {
+  ensureLoaded();
+  return !email.empty() && !password.empty();
+}
+
+void ReadestStore::setSession(const std::string& newUserId, const std::string& newRefreshToken) {
+  ensureLoaded();
+  userId = newUserId;
+  refreshToken = newRefreshToken;
+  connected = true;
+}
+
+void ReadestStore::clearSession() {
+  ensureLoaded();
+  userId.clear();
+  refreshToken.clear();
+  connected = false;
+}
+
+void ReadestStore::clear() {
+  ensureLoaded();
+  email.clear();
+  password.clear();
+  clearSession();
+}
diff --git a/src/readest/ReadestStore.h b/src/readest/ReadestStore.h
new file mode 100644
index 00000000..fa7f3025
--- /dev/null
+++ b/src/readest/ReadestStore.h
@@ -0,0 +1,65 @@
+#pragma once
+#include <ArduinoJson.h>
+#include <PersistableStore.h>
+
+#include <cstdint>
+#include <string>
+
+/**
+ * Readest account for clipping sync, stored on the SD card.
+ *
+ * The email/password are kept so the device can sign in again whenever the
+ * Supabase refresh token has been rotated away or expired. The password is
+ * XOR-obfuscated with the device MAC (same scheme as the KOReader store), so
+ * the file is useless when copied to another device.
+ */
+class ReadestStore : public PersistableStore<ReadestStore> {
+ private:
+  std::string email;
+  std::string password;
+  std::string userId;
+  std::string refreshToken;
+  bool connected = false;
+
+  ReadestStore() = default;
+  ~ReadestStore() = default;
+
+  friend class PersistableStore<ReadestStore>;
+
+ public:
+  static const char* getFilePath() { return "/.crosspoint/readest.json"; }
+  void toJson(JsonDocument& doc) const;
+  bool fromJson(JsonVariantConst doc);
+
+  void setCredentials(const std::string& newEmail, const std::string& newPassword);
+  bool hasCredentials() const;
+  const std::string& getEmail() const {
+    ensureLoaded();
+    return email;
+  }
+  const std::string& getPassword() const {
+    ensureLoaded();
+    return password;
+  }
+
+  // Session state from the last successful sign-in or token refresh.
+  void setSession(const std::string& newUserId, const std::string& newRefreshToken);
+  void clearSession();
+  const std::string& getUserId() const {
+    ensureLoaded();
+    return userId;
+  }
+  const std::string& getRefreshToken() const {
+    ensureLoaded();
+    return refreshToken;
+  }
+  bool isConnected() const {
+    ensureLoaded();
+    return connected && hasCredentials();
+  }
+
+  // Forget everything (Disconnect).
+  void clear();
+};
+
+#define READEST_STORE ReadestStore::getInstance()
diff --git a/src/readest/ReadestTextEpub.cpp b/src/readest/ReadestTextEpub.cpp
new file mode 100644
index 00000000..7b1bdc8c
--- /dev/null
+++ b/src/readest/ReadestTextEpub.cpp
@@ -0,0 +1,293 @@
+#include "ReadestTextEpub.h"
+
+#include <HalStorage.h>
+#include <Logging.h>
+#include <SecureHttpClient.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr uint32_t SIG_EOCD = 0x06054b50;
+constexpr uint32_t SIG_CENTRAL = 0x02014b50;
+constexpr size_t EOCD_SIZE = 22;
+constexpr size_t CENTRAL_HEADER_SIZE = 46;
+// EOCD plus the largest possible archive comment.
+constexpr size_t TAIL_SIZE = EOCD_SIZE + 0xFFFF;
+// Gaps up to this size between wanted entries are downloaded and dropped
+// rather than paying for another request.
+constexpr size_t MERGE_GAP = 16 * 1024;
+constexpr uint32_t REQUEST_TIMEOUT_MS = 30000;
+constexpr char USER_AGENT[] = "CrossInk-Readest/1.0";
+
+uint16_t rd16(const uint8_t* p) { return static_cast<uint16_t>(p[0] | (p[1] << 8)); }
+uint32_t rd32(const uint8_t* p) {
+  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) | (static_cast<uint32_t>(p[2]) << 16) |
+         (static_cast<uint32_t>(p[3]) << 24);
+}
+void wr16(uint8_t* p, const uint16_t v) {
+  p[0] = static_cast<uint8_t>(v);
+  p[1] = static_cast<uint8_t>(v >> 8);
+}
+void wr32(uint8_t* p, const uint32_t v) {
+  p[0] = static_cast<uint8_t>(v);
+  p[1] = static_cast<uint8_t>(v >> 8);
+  p[2] = static_cast<uint8_t>(v >> 16);
+  p[3] = static_cast<uint8_t>(v >> 24);
+}
+
+bool endsWith(const std::string& s, const char* suffix) {
+  const size_t n = std::strlen(suffix);
+  return s.size() >= n && s.compare(s.size() - n, n, suffix) == 0;
+}
+
+// Entries needed to parse the book and read its text.
+bool isTextEntry(std::string name) {
+  std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) { return std::tolower(c); });
+  return name == "mimetype" || endsWith(name, ".xhtml") || endsWith(name, ".html") || endsWith(name, ".htm") ||
+         endsWith(name, ".opf") || endsWith(name, ".ncx") || endsWith(name, ".xml");
+}
+
+struct Entry {
+  size_t record;        // offset of the central directory record in `central`
+  size_t recordSize;    // size of that record
+  uint32_t localStart;  // local header offset in the remote archive
+  uint32_t localEnd;    // start of the next entry (local header + data + descriptor)
+  uint32_t newOffset;   // local header offset in the slim archive
+  bool keep;
+};
+
+// Parses "bytes a-b/total".
+bool parseContentRange(const std::string& value, size_t& total) {
+  const size_t slash = value.rfind('/');
+  if (slash == std::string::npos || slash + 1 >= value.size() || value[slash + 1] == '*') return false;
+  total = std::strtoul(value.c_str() + slash + 1, nullptr, 10);
+  return total > 0;
+}
+
+// Range GET that streams the body to `sink`. Anything but a 206 is refused
+// before its body is consumed.
+bool rangeGet(freeink::SecureHttpClient& http, const std::string& url, const size_t first, const size_t last,
+              const std::function<bool(const uint8_t*, size_t)>& sink, std::string* contentRange = nullptr) {
+  if (!http.begin(url)) return false;
+  const std::string range = last == SIZE_MAX ? "bytes=-" + std::to_string(first)
+                                             : "bytes=" + std::to_string(first) + "-" + std::to_string(last);
+  http.addHeader("Range", range);
+  http.addHeader("Accept-Encoding", "identity");
+  bool refused = false;
+  const int code = http.GET([&](const uint8_t* data, const size_t len) {
+    if (http.getStatus() != 206) {
+      refused = true;
+      return false;
+    }
+    return sink(data, len);
+  });
+  if (code != 206 || refused || !http.responseComplete()) {
+    LOG_ERR("RDS", "Range %s failed: code=%d complete=%d", range.c_str(), code, http.responseComplete() ? 1 : 0);
+    return false;
+  }
+  if (contentRange) *contentRange = http.getHeader("content-range");
+  return true;
+}
+}  // namespace
+
+namespace ReadestTextEpub {
+
+bool download(const std::string& url, const std::string& destPath) {
+  freeink::SecureHttpClient http;  // one kept-alive TLS connection for every range
+  http.setInsecure();
+  http.setTimeout(REQUEST_TIMEOUT_MS);
+  http.setUserAgent(USER_AGENT);
+  http.setFollowRedirects(3);
+
+  // 1. The tail of the archive holds the end-of-central-directory record.
+  std::string tail;
+  std::string contentRange;
+  if (!rangeGet(
+          http, url, TAIL_SIZE, SIZE_MAX,
+          [&](const uint8_t* data, const size_t len) {
+            if (tail.size() + len > TAIL_SIZE) return false;
+            tail.append(reinterpret_cast<const char*>(data), len);
+            return true;
+          },
+          &contentRange)) {
+    return false;
+  }
+  size_t archiveSize = 0;
+  if (!parseContentRange(contentRange, archiveSize) || tail.size() < EOCD_SIZE) {
+    LOG_ERR("RDS", "Unusable Content-Range '%s'", contentRange.c_str());
+    return false;
+  }
+  const size_t tailStart = archiveSize - tail.size();
+  const auto* tailBytes = reinterpret_cast<const uint8_t*>(tail.data());
+  size_t eocd = SIZE_MAX;
+  for (size_t i = tail.size() - EOCD_SIZE + 1; i-- > 0;) {
+    if (rd32(tailBytes + i) == SIG_EOCD) {
+      eocd = i;
+      break;
+    }
+  }
+  if (eocd == SIZE_MAX) {
+    LOG_ERR("RDS", "No ZIP end record");
+    return false;
+  }
+  const uint16_t entryCount = rd16(tailBytes + eocd + 10);
+  const uint32_t centralSize = rd32(tailBytes + eocd + 12);
+  const uint32_t centralOffset = rd32(tailBytes + eocd + 16);
+  if (entryCount == 0xFFFF || centralSize == 0xFFFFFFFF || centralOffset == 0xFFFFFFFF ||
+      static_cast<size_t>(centralOffset) + centralSize > archiveSize) {
+    LOG_ERR("RDS", "ZIP64 or damaged archive; not supported");
+    return false;
+  }
+
+  // 2. The central directory (usually already inside the tail).
+  std::string central;
+  if (centralOffset >= tailStart) {
+    central = tail.substr(centralOffset - tailStart, centralSize);
+  } else {
+    central.reserve(centralSize);
+    if (!rangeGet(http, url, centralOffset, static_cast<size_t>(centralOffset) + centralSize - 1,
+                  [&](const uint8_t* data, const size_t len) {
+                    central.append(reinterpret_cast<const char*>(data), len);
+                    return central.size() <= centralSize;
+                  })) {
+      return false;
+    }
+  }
+  tail.clear();
+  tail.shrink_to_fit();
+
+  // 3. Pick the text entries and work out each entry's exact byte span.
+  std::vector<Entry> entries;
+  entries.reserve(entryCount);
+  const auto* cd = reinterpret_cast<const uint8_t*>(central.data());
+  for (size_t pos = 0; pos + CENTRAL_HEADER_SIZE <= central.size();) {
+    if (rd32(cd + pos) != SIG_CENTRAL) break;
+    const uint32_t compSize = rd32(cd + pos + 20);
+    const uint16_t nameLen = rd16(cd + pos + 28);
+    const uint16_t extraLen = rd16(cd + pos + 30);
+    const uint16_t commentLen = rd16(cd + pos + 32);
+    const uint32_t localOffset = rd32(cd + pos + 42);
+    const size_t recordSize = CENTRAL_HEADER_SIZE + nameLen + extraLen + commentLen;
+    if (pos + recordSize > central.size() || compSize == 0xFFFFFFFF || localOffset == 0xFFFFFFFF) {
+      LOG_ERR("RDS", "Bad or ZIP64 central directory record");
+      return false;
+    }
+    const std::string name(reinterpret_cast<const char*>(cd + pos + CENTRAL_HEADER_SIZE), nameLen);
+    entries.push_back({pos, recordSize, localOffset, 0, 0, isTextEntry(name)});
+    pos += recordSize;
+  }
+  std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.localStart < b.localStart; });
+  size_t textBytes = 0;
+  for (size_t i = 0; i < entries.size(); ++i) {
+    entries[i].localEnd = i + 1 < entries.size() ? entries[i + 1].localStart : centralOffset;
+    if (entries[i].localEnd < entries[i].localStart) return false;
+    if (entries[i].keep) textBytes += entries[i].localEnd - entries[i].localStart;
+  }
+  if (textBytes == 0) {
+    LOG_ERR("RDS", "No text entries in the archive");
+    return false;
+  }
+  LOG_INF("RDS", "Text-only copy: %u of %u bytes", static_cast<unsigned>(textBytes),
+          static_cast<unsigned>(archiveSize));
+
+  // 4. Fetch the kept spans (merging near neighbours) straight to the file.
+  const std::string partPath = destPath + ".part";
+  HalFile file;
+  if (!Storage.openFileForWrite("RDS", partPath, file)) {
+    LOG_ERR("RDS", "Cannot create %s", partPath.c_str());
+    return false;
+  }
+  uint32_t written = 0;
+  bool ok = true;
+  size_t i = 0;
+  while (ok && i < entries.size()) {
+    if (!entries[i].keep) {
+      ++i;
+      continue;
+    }
+    size_t j = i;  // last kept entry in this request
+    for (size_t k = i + 1; k < entries.size(); ++k) {
+      if (!entries[k].keep) continue;
+      if (entries[k].localStart - entries[j].localEnd > MERGE_GAP) break;
+      j = k;
+    }
+    const uint32_t rangeStart = entries[i].localStart;
+    const uint32_t rangeEnd = entries[j].localEnd;  // exclusive
+    size_t current = i;
+    uint32_t position = rangeStart;
+    ok = rangeGet(http, url, rangeStart, rangeEnd - 1, [&](const uint8_t* data, size_t len) {
+      while (len > 0) {
+        while (current <= j && (!entries[current].keep || position >= entries[current].localEnd)) ++current;
+        if (current > j) return true;  // trailing bytes of the range
+        Entry& entry = entries[current];
+        if (position < entry.localStart) {  // skipped neighbour
+          const size_t skip = std::min<size_t>(len, entry.localStart - position);
+          data += skip;
+          len -= skip;
+          position += static_cast<uint32_t>(skip);
+          continue;
+        }
+        if (position == entry.localStart) entry.newOffset = written;
+        const size_t take = std::min<size_t>(len, entry.localEnd - position);
+        if (file.write(data, take) != take) return false;
+        written += static_cast<uint32_t>(take);
+        data += take;
+        len -= take;
+        position += static_cast<uint32_t>(take);
+      }
+      return true;
+    });
+    i = j + 1;
+  }
+
+  // 5. New central directory: the original records with patched offsets.
+  if (ok) {
+    const uint32_t newCentralOffset = written;
+    uint16_t keptCount = 0;
+    for (const Entry& entry : entries) {
+      if (!entry.keep) continue;
+      std::string record = central.substr(entry.record, entry.recordSize);
+      wr32(reinterpret_cast<uint8_t*>(&record[0]) + 42, entry.newOffset);
+      if (file.write(reinterpret_cast<const uint8_t*>(record.data()), record.size()) != record.size()) {
+        ok = false;
+        break;
+      }
+      written += static_cast<uint32_t>(record.size());
+      keptCount++;
+    }
+    if (ok) {
+      uint8_t end[EOCD_SIZE] = {};
+      wr32(end, SIG_EOCD);
+      wr16(end + 8, keptCount);
+      wr16(end + 10, keptCount);
+      wr32(end + 12, written - newCentralOffset);
+      wr32(end + 16, newCentralOffset);
+      ok = file.write(end, sizeof(end)) == sizeof(end);
+    }
+  }
+  file.close();
+  http.end();
+
+  if (!ok) {
+    LOG_ERR("RDS", "Text-only download failed");
+    Storage.remove(partPath.c_str());
+    return false;
+  }
+  Storage.remove(destPath.c_str());
+  if (!Storage.rename(partPath.c_str(), destPath.c_str())) {
+    LOG_ERR("RDS", "Cannot move text-only copy into place");
+    Storage.remove(partPath.c_str());
+    return false;
+  }
+  LOG_INF("RDS", "Saved text-only Readest copy (%u bytes)", static_cast<unsigned>(written));
+  return true;
+}
+
+}  // namespace ReadestTextEpub
diff --git a/src/readest/ReadestTextEpub.h b/src/readest/ReadestTextEpub.h
new file mode 100644
index 00000000..0ca19c37
--- /dev/null
+++ b/src/readest/ReadestTextEpub.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstddef>
+#include <string>
+
+/**
+ * Downloads only the text of a remote EPUB into a slim, valid EPUB file.
+ *
+ * An EPUB is a ZIP whose size is mostly images and fonts. Using HTTP range
+ * requests against the (signed) URL, this reads the ZIP central directory
+ * from the end of the file, then fetches only mimetype, container.xml, the
+ * OPF/NCX and the (X)HTML chapters, copying each entry's bytes verbatim and
+ * writing a fresh central directory. Adjacent entries are fetched in one
+ * request over a single kept-alive TLS connection; everything streams
+ * straight to the SD card.
+ *
+ * Returns false (and leaves no file) if the server ignores range requests or
+ * the archive is ZIP64.
+ */
+namespace ReadestTextEpub {
+bool download(const std::string& url, const std::string& destPath);
+}  // namespace ReadestTextEpub
