+
+// Stable Readest note id so pushing the same clipping twice updates in place.
+std::string noteIdFor(const std::string& bookHash, const XPathTextRange& range) {
+  const std::string seed = "crossink:" + bookHash + ":" + range.start + ":" + range.end;
+  MD5Builder md5;
+  md5.begin();
+  md5.add(seed.c_str());
+  md5.calculate();
+  return std::string(md5.toString().c_str()).substr(0, 7);
+}
+
+// Spine index from a KOReader xpointer (/body/DocFragment[N]/...) or a CFI
+// (epubcfi(/6/2N[...]!...)). -1 if neither is usable.
+int spineIndexFromNote(const ReadestNote& note) {
+  static constexpr char kFragment[] = "/body/DocFragment";
+  if (note.xpointer0.rfind(kFragment, 0) == 0) {
+    const char* rest = note.xpointer0.c_str() + sizeof(kFragment) - 1;
+    return *rest == '[' ? std::atoi(rest + 1) - 1 : 0;
+  }
+  static constexpr char kCfiSpine[] = "epubcfi(/6/";
+  const size_t pos = note.cfi.find(kCfiSpine);
+  if (pos != std::string::npos) {
+    const int step = std::atoi(note.cfi.c_str() + pos + sizeof(kCfiSpine) - 1);
+    if (step >= 2) return step / 2 - 1;
+  }
+  return -1;
+}
+
+uint16_t countWords(const std::string& text) {
+  uint16_t words = 0;
+  bool inWord = false;
+  for (const char ch : text) {
+    const bool space = ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r';
+    if (!space && !inWord && words < UINT16_MAX) words++;
+    inWord = !space;
+  }
+  return words;
+}
+
+std::string formatCount(const char* format, const int count) {
+  char buffer[96];
+  snprintf(buffer, sizeof(buffer), format, count);
+  return buffer;
+}
+
+std::string formatCounts(const char* format, const int first, const int second) {
+  char buffer[96];
+  snprintf(buffer, sizeof(buffer), format, first, second);
+  return buffer;
+}
+
+int percentOf(const float fraction) { return static_cast<int>(fraction * 100.0f + 0.5f); }
+
+// Short, stable identity for a highlight's text (loose: case, spacing and
+// punctuation ignored), stored in the links file instead of the full text.
+std::string keyHashFor(const std::string& text) {
+  const std::string key = ChapterXPathResolver::looseTextKey(text);
+  if (key.empty()) return "";
+  MD5Builder md5;
+  md5.begin();
+  md5.add(key.c_str());
+  md5.calculate();
+  return std::string(md5.toString().c_str()).substr(0, 16);
+}
