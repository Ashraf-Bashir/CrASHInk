+constexpr char SYNC_URL[] = "https://web.readest.com/api/sync";
+constexpr char STORAGE_DOWNLOAD_URL[] = "https://web.readest.com/api/storage/download?fileKey=";
+// Readest's public Supabase anon key (the same one shipped in readest.koplugin).
+constexpr char SUPABASE_ANON_KEY[] =
+    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZic3l4ZnVzampxZHhranFseXNjIiwicm9sZSI6"
+    "ImFub24iLCJpYXQiOjE3MzQxMjM2NzEsImV4cCI6MjA0OTY5OTY3MX0.3U5Uqaou_1SgrVe1eo9rApc0uKjqhpQdUXhvwUHmUfg";
+constexpr char USER_AGENT[] = "CrossInk-Readest/1.0";
+constexpr uint32_t REQUEST_TIMEOUT_MS = 20000;
+
+// Small library pages keep each buffered response to a few tens of KB even
+// when rows carry long metadata blobs.
+constexpr int BOOKS_PAGE_SIZE = 20;
+constexpr int BOOKS_MAX_PAGES = 250;
+
+constexpr uint32_t MIN_FREE_HEAP_FOR_TLS = 35000;
+constexpr uint32_t MIN_MAX_ALLOC_HEAP_FOR_TLS = 20000;
+
+bool insufficientHeap() {
+  const uint32_t freeHeap = ESP.getFreeHeap();
+  const uint32_t maxAllocHeap = ESP.getMaxAllocHeap();
+  if (freeHeap < MIN_FREE_HEAP_FOR_TLS || maxAllocHeap < MIN_MAX_ALLOC_HEAP_FOR_TLS) {
+    LOG_ERR("RDS", "Insufficient heap for TLS: %u free, %u max alloc", freeHeap, maxAllocHeap);
+    return true;
+  }
+  return false;
+}
+
+// Sends one JSON request. With keepBody=false the response is drained and
+// dropped chunk by chunk (the sync POST echoes every stored record back).
+int sendJson(freeink::SecureHttpClient& http, const char* method, const std::string& url, const std::string& bearer,
+             const bool supabase, const std::string& body, const bool keepBody) {
+  http.setInsecure();
+  http.setTimeout(REQUEST_TIMEOUT_MS);
+  http.setUserAgent(USER_AGENT);
+  if (!http.begin(url)) {
+    LOG_ERR("RDS", "Bad URL: %s", url.c_str());
+    return -1;
+  }
+  http.addHeader("Accept", "application/json");
+  if (supabase) http.addHeader("apikey", SUPABASE_ANON_KEY);
+  if (!bearer.empty()) http.addHeader("Authorization", "Bearer " + bearer);
+  if (!body.empty()) http.addHeader("Content-Type", "application/json");
+
+  const uint8_t* payload = body.empty() ? nullptr : reinterpret_cast<const uint8_t*>(body.data());
+  if (keepBody) return http.sendRequest(method, payload, body.size());
+  return http.sendRequest(method, payload, body.size(), [](const uint8_t*, size_t) { return true; });
+}
+
+ReadestClient::Error errorForStatus(const int code) {
+  if (code <= 0) return ReadestClient::NETWORK_ERROR;
+  if (code == 400 || code == 401 || code == 403) return ReadestClient::AUTH_FAILED;
+  return ReadestClient::SERVER_ERROR;
+}
+
+// Days since 1970-01-01 for a proleptic Gregorian date (H. Hinnant).
+int64_t daysFromCivil(int y, const unsigned m, const unsigned d) {
+  y -= m <= 2 ? 1 : 0;
+  const int era = (y >= 0 ? y : y - 399) / 400;
+  const unsigned yoe = static_cast<unsigned>(y - era * 400);
+  const unsigned doy = (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1;
+  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return static_cast<int64_t>(era) * 146097 + static_cast<int64_t>(doe) - 719468;
+}
+
+// Supabase timestamps look like 2025-06-01T12:34:56.123456+00:00 (UTC).
+int64_t parseIsoMs(const char* iso) {
+  if (!iso) return -1;
+  int y = 0, mo = 0, d = 0, h = 0, mi = 0, s = 0;
+  if (std::sscanf(iso, "%d-%d-%dT%d:%d:%d", &y, &mo, &d, &h, &mi, &s) != 6) return -1;
+  int ms = 0;
+  const char* dot = std::strchr(iso, '.');
+  if (dot) {
+    int digits = 0;
+    for (const char* p = dot + 1; digits < 3 && *p >= '0' && *p <= '9'; ++p, ++digits) ms = ms * 10 + (*p - '0');
+    for (; digits < 3; ++digits) ms *= 10;
+  }
+  const int64_t days = daysFromCivil(y, static_cast<unsigned>(mo), static_cast<unsigned>(d));
+  return ((days * 24 + h) * 60 + mi) * 60000LL + s * 1000LL + ms;
+}
+
+bool isStopWord(const std::string& word) {
+  return word == "the" || word == "a" || word == "an" || word == "of" || word == "and";
+}
+
+// Lowercased words: runs of ASCII letters/digits, with non-ASCII bytes kept
+// verbatim so non-Latin titles still compare. Stop words are dropped unless
+// that would leave nothing.
+std::vector<std::string> titleWords(const std::string& text) {
+  std::vector<std::string> all;
+  std::string current;
+  for (const char ch : text) {
+    const auto c = static_cast<unsigned char>(ch);
+    if (c >= 0x80) {
+      current += ch;
+    } else if (std::isalnum(c)) {
+      current += static_cast<char>(std::tolower(c));
+    } else if (!current.empty()) {
+      all.push_back(std::move(current));
+      current.clear();
+    }
+  }
+  if (!current.empty()) all.push_back(std::move(current));
+
+  std::vector<std::string> kept;
+  kept.reserve(all.size());
+  for (auto& word : all) {
+    if (!isStopWord(word)) kept.push_back(word);
+  }
+  return kept.empty() ? all : kept;
+}
+
+// 0..100 word-overlap similarity. Identical word lists score 100; a title
+// fully contained in the other ("Dune" vs "Dune: Deluxe Edition") scores at
+// least 60; otherwise the Dice coefficient of the two word lists.
+int wordSimilarity(const std::vector<std::string>& a, const std::vector<std::string>& b) {
+  if (a.empty() || b.empty()) return 0;
+  size_t common = 0;
+  for (const auto& word : a) {
+    if (std::find(b.begin(), b.end(), word) != b.end()) common++;
+  }
+  if (common == 0) return 0;
+  if (common == a.size() && a.size() == b.size()) return 100;
+  const size_t shorter = std::min(a.size(), b.size());
+  const size_t longer = std::max(a.size(), b.size());
+  int score = static_cast<int>(200 * common / (a.size() + b.size()));
+  if (common >= shorter) score = std::max(score, 60 + static_cast<int>(40 * shorter / longer));
+  return std::min(score, 99);
+}
+
+// Keep the best MAX_CANDIDATES books, one entry per Readest hash, sorted.
+void offerCandidate(std::vector<ReadestBook>& top, ReadestBook&& book) {
+  bool changed = false;
+  for (auto& existing : top) {
+    if (existing.hash == book.hash) {
+      if (book.score <= existing.score) return;
+      existing = std::move(book);
+      changed = true;
+      break;
+    }
+  }
+  if (!changed) {
+    if (top.size() < ReadestClient::MAX_CANDIDATES) {
+      top.push_back(std::move(book));
+    } else if (book.score > top.back().score) {
+      top.back() = std::move(book);
+    } else {
+      return;
+    }
+  }
+  std::sort(top.begin(), top.end(), [](const ReadestBook& l, const ReadestBook& r) { return l.score > r.score; });
+}
+
+bool isDummyHash(const char* hash) { return hash && std::strcmp(hash, "00000000000000000000000000000000") == 0; }
+}  // namespace
