diff --git a/src/clippings/HighlightWordEdit.h b/src/clippings/HighlightWordEdit.h
new file mode 100644
--- /dev/null
+++ b/src/clippings/HighlightWordEdit.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <cstddef>
+#include <string>
+
+namespace HighlightWordEdit {
+enum class Action { ExtendStart, TrimStart, TrimEnd, ExtendEnd };
+
+// Work in reading order, independently of visual RTL direction. UTF-8 bytes
+// inside a word are never split; EPUB extraction normalizes separators to spaces.
+inline bool adjust(const std::string& text, const Action action, const std::string& neighbour, const size_t maxBytes,
+                   std::string& out) {
+  out.clear();
+  if (text.empty()) return false;
+  if (action == Action::ExtendStart || action == Action::ExtendEnd) {
+    if (neighbour.empty() || text.size() + neighbour.size() + 1 > maxBytes) return false;
+    out = action == Action::ExtendStart ? neighbour + " " + text : text + " " + neighbour;
+    return true;
+  }
+  const size_t split = action == Action::TrimStart ? text.find(' ') : text.rfind(' ');
+  if (split == std::string::npos) return false;  // Keep one word; Delete removes the whole highlight.
+  out = action == Action::TrimStart ? text.substr(split + 1) : text.substr(0, split);
+  return !out.empty();
+}
+}  // namespace HighlightWordEdit
diff --git a/src/clippings/HighlightNeighbourWord.h b/src/clippings/HighlightNeighbourWord.h
new file mode 100644
--- /dev/null
+++ b/src/clippings/HighlightNeighbourWord.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <algorithm>
+
+#include "ChapterXPathResolver.h"
+#include "ClippingStore.h"
+
+namespace HighlightWordEdit {
+// Stream bounded context, widening only when an adjacent word is unusually
+// long. Discard the incomplete word at the outer edge of each context span.
+inline bool neighbourWord(const std::shared_ptr<Epub>& book, int spine, const XPathTextLocation& location, bool before,
+                          std::string& word) {
+  if ((before && location.start == 0) || (!before && location.end + 1 >= location.total)) return false;
+  for (uint32_t budget = 256; budget <= CLIPPING_TEXT_MAX; budget *= 2) {
+    XPathTextLocation context = location;
+    if (before) {
+      context.start = location.start > budget ? location.start - budget : 0;
+      context.end = location.start - 1;
+    } else {
+      context.start = location.end + 1;
+      context.end = std::min(location.total - 1, context.start + budget - 1);
+    }
+    std::string text;
+    if (!ChapterXPathResolver::extractText(book, spine, context, text) || text.empty()) return false;
+    const size_t split = before ? text.rfind(' ') : text.find(' ');
+    const bool reachesEdge = before ? context.start == 0 : context.end + 1 == location.total;
+    if (split != std::string::npos || reachesEdge) {
+      word = split == std::string::npos ? text : before ? text.substr(split + 1) : text.substr(0, split);
+      return !word.empty();
+    }
+  }
+  return false;
+}
+
+}  // namespace HighlightWordEdit
diff --git a/test/highlight_word_edit/HighlightWordEditTest.cpp b/test/highlight_word_edit/HighlightWordEditTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/highlight_word_edit/HighlightWordEditTest.cpp
@@ -0,0 +1,54 @@
+#include <cassert>
+#include <iostream>
+
+#include "clippings/HighlightNeighbourWord.h"
+#include "clippings/HighlightWordEdit.h"
+
+int main() {
+  using HighlightWordEdit::Action;
+  const auto book = std::make_shared<Epub>(std::vector<std::string>{
+      "<html><body><p>Before, alpha <em>bravo</em> caf&#233;. After!</p><p>Next paragraph.</p></body></html>"});
+  XPathTextLocation location;
+  assert(ChapterXPathResolver::locateText(book, 0, "alpha bravo", -1, location));
+  std::string word, result;
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, true, word));
+  assert(word == "Before,");
+  assert(HighlightWordEdit::adjust("alpha bravo", Action::ExtendStart, word, 1024, result));
+  assert(result == "Before, alpha bravo");
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  assert(word == "caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust("alpha bravo", Action::ExtendEnd, word, 1024, result));
+  assert(result == "alpha bravo caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust(result, Action::TrimStart, "", 1024, word));
+  assert(word == "bravo caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust(word, Action::TrimEnd, "", 1024, result));
+  assert(result == "bravo");
+  assert(!HighlightWordEdit::adjust("bravo", Action::TrimStart, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::TrimEnd, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::ExtendEnd, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::ExtendEnd, "six", 8, result));
+  assert(ChapterXPathResolver::locateText(book, 0, "Before,", -1, location));
+  assert(!HighlightWordEdit::neighbourWord(book, 0, location, true, word));
+  assert(ChapterXPathResolver::locateText(book, 0, "paragraph.", -1, location));
+  assert(!HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  // A block/page boundary supplies a word separator, not a glued token.
+  assert(ChapterXPathResolver::locateText(book, 0, "After!", -1, location));
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  assert(word == "Next");
+  const auto rtl = std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>قبل كلمة بعد</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(rtl, 0, "كلمة", -1, location));
+  assert(HighlightWordEdit::neighbourWord(rtl, 0, location, true, word) && word == "قبل");
+  assert(HighlightWordEdit::neighbourWord(rtl, 0, location, false, word) && word == "بعد");
+  const auto softHyphen =
+      std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>one hy&#173;phen two</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(softHyphen, 0, "two", -1, location));
+  assert(HighlightWordEdit::neighbourWord(softHyphen, 0, location, true, word) && word == "hyphen");
+  // A clipped context edge must not return the last part of a long word.
+  const std::string longWord(600, 'x');
+  const auto longBook = std::make_shared<Epub>(
+      std::vector<std::string>{"<html><body><p>prefix " + longWord + " target</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(longBook, 0, "target", -1, location));
+  assert(HighlightWordEdit::neighbourWord(longBook, 0, location, true, word));
+  assert(word == longWord);
+  std::cout << "Highlight word editing checks passed\n";
+}
