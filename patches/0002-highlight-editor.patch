+#include "HighlightEditActivity.h"
+
+#include <I18n.h>
+#include <Logging.h>
+
+#include <algorithm>
+#include <climits>
+#include <cstdio>
+
+#include "ChapterXPathResolver.h"
+#include "ClippingStore.h"
+#include "clippings/HighlightNeighbourWord.h"
+#include "components/TouchHeaderBackButton.h"
+#include "components/UITheme.h"
+#include "fontIds.h"
+
+namespace {
+// KOReader's boundary controls use the symbols ◁▒▒, ▷☓▒, ▒☓◁, ▒▒▷.
+// Draw the same outline arrows, crossed-out word and shaded word blocks
+// directly: the UI font need not contain these Unicode glyphs.
+void drawBoundaryIcon(const GfxRenderer& renderer, const Rect& rect, const int action) {
+  constexpr int cell = 14;
+  constexpr int gap = 3;
+  constexpr int height = 18;
+  const int left = rect.x + (rect.width - (3 * cell + 2 * gap)) / 2;
+  const int top = rect.y + (rect.height - height) / 2;
+  for (int slot = 0; slot < 3; ++slot) {
+    const int x = left + slot * (cell + gap);
+    const bool arrow = (action < 2 && slot == 0) || (action >= 2 && slot == 2);
+    const bool removed = (action == 1 || action == 2) && slot == 1;
+    if (arrow) {
+      const bool pointsLeft = action == 0 || action == 2;
+      const int tip = pointsLeft ? x + 1 : x + cell - 2;
+      const int base = pointsLeft ? x + cell - 2 : x + 1;
+      renderer.drawLine(tip, top + height / 2, base, top + 1, 2, true);
+      renderer.drawLine(base, top + 1, base, top + height - 2, 2, true);
+      renderer.drawLine(base, top + height - 2, tip, top + height / 2, 2, true);
+    } else if (removed) {
+      renderer.drawLine(x + 2, top + 2, x + cell - 3, top + height - 3, 2, true);
+      renderer.drawLine(x + cell - 3, top + 2, x + 2, top + height - 3, 2, true);
+    } else {
+      for (int y = 0; y < height; y += 2) {
+        for (int dx = (y / 2) % 2; dx < cell; dx += 2) renderer.fillRect(x + dx, top + y, 1, 1, true);
+      }
+    }
+  }
+}
+
+// One bounded preview line at a time, without a second copy of the full draft.
+std::string nextLine(const GfxRenderer& renderer, const std::string& text, size_t& offset, int width) {
+  while (offset < text.size() && text[offset] == ' ') ++offset;
+  const size_t start = offset;
+  size_t lastSpace = std::string::npos;
+  std::string line;
+  line.reserve(128);
+  while (offset < text.size()) {
+    const unsigned char ch = text[offset];
+    size_t bytes = ch < 0x80 ? 1 : ch < 0xE0 ? 2 : ch < 0xF0 ? 3 : ch <= 0xF4 ? 4 : 1;
+    if (offset + bytes > text.size()) bytes = 1;
+    line.append(text, offset, bytes);
+    if (renderer.getTextWidth(UI_10_FONT_ID, line.c_str()) > width && offset > start) {
+      if (lastSpace != std::string::npos) offset = lastSpace;
+      line = text.substr(start, offset - start);
+      break;
+    }
+    if (ch == ' ') lastSpace = offset;
+    offset += bytes;
+  }
+  return line;
+}
+}  // namespace
+
+HighlightEditActivity::HighlightEditActivity(GfxRenderer& renderer, MappedInputManager& input,
+                                             std::shared_ptr<Epub> book, size_t index, float positionHint)
+    : Activity("HighlightEdit", renderer, input), book(std::move(book)), index(index), hint(positionHint) {}
+
+void HighlightEditActivity::onEnter() {
+  Activity::onEnter();
+  const Clipping* clipping = CLIPPINGS.clippingAt(index);
+  if (clipping && CLIPPINGS.readClippingText(index, draft)) {
+    spine = clipping->spineIndex;
+    tableSelection = clipping->tableSelection != UINT16_MAX;
+    XPathTextLocation location;
+    std::string normalized;
+    // Strict matching preserves the actual words; never edit a fuzzy guess.
+    editable = ChapterXPathResolver::locateText(book, spine, draft, hint, location) && !location.loose &&
+               ChapterXPathResolver::extractText(book, spine, location, normalized) && !normalized.empty();
+    if (editable) {
+      draft = std::move(normalized);
+      hint = location.total ? static_cast<float>(location.start) / location.total : hint;
+    }
+  }
+  failed = !editable;
+  requestUpdate();
+}
+
+Rect HighlightEditActivity::buttonRect(int button) const {
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  constexpr int gap = 6;
+  constexpr int height = 44;
+  const int row = button < 4 ? 0 : 1;
+  const int cols = row == 0 ? 4 : 3;
+  const int col = row == 0 ? button : button - 4;
+  const int width = (safe.width - gap * (cols + 1)) / cols;
+  return Rect{safe.x + gap + col * (width + gap), safe.y + safe.height - (2 - row) * (height + gap), width, height};
+}
+
+void HighlightEditActivity::adjust(HighlightWordEdit::Action action) {
+  RenderLock lock(*this);
+  confirmDelete = false;
+  failed = false;
+  if (!editable) {
+    failed = true;
+    requestUpdate();
+    return;
+  }
+  std::string neighbour;
+  const bool extending =
+      action == HighlightWordEdit::Action::ExtendStart || action == HighlightWordEdit::Action::ExtendEnd;
+  if (extending) {
+    XPathTextLocation location;
+    // Do not extend a column selection into the adjacent table cell.
+    if (tableSelection || !ChapterXPathResolver::locateText(book, spine, draft, hint, location) || location.loose ||
+        !HighlightWordEdit::neighbourWord(book, spine, location, action == HighlightWordEdit::Action::ExtendStart,
+                                          neighbour)) {
+      failed = true;
+      requestUpdate();
+      return;
+    }
+    hint = location.total ? static_cast<float>(location.start) / location.total : hint;
+  }
+  std::string replacement;
+  if (HighlightWordEdit::adjust(draft, action, neighbour, CLIPPING_TEXT_MAX, replacement)) {
+    draft = std::move(replacement);
+    changed = true;
+    previewPage =
+        action == HighlightWordEdit::Action::ExtendEnd || action == HighlightWordEdit::Action::TrimEnd ? INT_MAX : 0;
+  } else {
+    failed = true;
+  }
+  requestUpdate();
+}
+
+void HighlightEditActivity::cancel() {
+  ActivityResult result;
+  result.isCancelled = true;
+  setResult(std::move(result));
+  finish();
+}
+
+void HighlightEditActivity::accept() {
+  RenderLock lock(*this);
+  if (!changed || CLIPPINGS.updateClippingText(index, draft)) {
+    finish();
+  } else {
+    LOG_ERR("CLIP", "Failed to save edited clipping %u", static_cast<unsigned>(index));
+    failed = true;
+    requestUpdate();
+  }
+}
+
+void HighlightEditActivity::loop() {
+  if (TouchHeaderBackButton::wasTapped(mappedInput, renderer) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    cancel();
+    return;
+  }
+  if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
+    accept();
+    return;
+  }
+  const auto swipe = mappedInput.wasSwipe();
+  if (swipe == MappedInputManager::SwipeDir::Up || swipe == MappedInputManager::SwipeDir::Down) {
+    RenderLock lock(*this);
+    if (swipe == MappedInputManager::SwipeDir::Up && previewPage < previewPages - 1) {
+      ++previewPage;
+      requestUpdate();
+    } else if (swipe == MappedInputManager::SwipeDir::Down && previewPage > 0) {
+      --previewPage;
+      requestUpdate();
+    }
+    return;
+  }
+  for (int i = 0; i < 7; ++i) {
+    const Rect rect = buttonRect(i);
+    if (!mappedInput.wasTapInRect(rect.x, rect.y, rect.width, rect.height)) continue;
+    if (i < 4) {
+      static constexpr HighlightWordEdit::Action actions[] = {
+          HighlightWordEdit::Action::ExtendStart, HighlightWordEdit::Action::TrimStart,
+          HighlightWordEdit::Action::TrimEnd, HighlightWordEdit::Action::ExtendEnd};
+      adjust(actions[i]);
+    } else if (i == 4) {
+      accept();
+    } else if (i == 5) {
+      RenderLock lock(*this);
+      if (!confirmDelete) {
+        confirmDelete = true;
+        requestUpdate();
+        return;
+      }
+      if (CLIPPINGS.removeClippingAt(index))
+        finish();
+      else {
+        failed = true;
+        requestUpdate();
+      }
+    } else {
+      cancel();
+    }
+    return;
+  }
+}
+
+void HighlightEditActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+  TouchHeaderBackButton::drawCompact(renderer, tr(STR_EDIT_HIGHLIGHT), true);
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  const Rect header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+  const int top = header.y + header.height + 8;
+  const int width = std::max(1, safe.width - 24);
+  const int lineStep = renderer.getLineHeight(UI_10_FONT_ID) + 4;
+  const int rows = std::max(1, (buttonRect(0).y - top - 40) / std::max(1, lineStep));
+  size_t offset = 0;
+  int lines = 0;
+  while (offset < draft.size()) {
+    nextLine(renderer, draft, offset, width);
+    ++lines;
+  }
+  previewPages = std::max(1, (lines + rows - 1) / rows);
+  previewPage = std::min(previewPage, previewPages - 1);
+  offset = 0;
+  for (int line = 0; line < (previewPage + 1) * rows && offset < draft.size(); ++line) {
+    const std::string text = nextLine(renderer, draft, offset, width);
+    if (line >= previewPage * rows)
+      renderer.drawText(UI_10_FONT_ID, safe.x + 12, top + (line % rows) * lineStep, text.c_str());
+  }
+  char page[24];
+  snprintf(page, sizeof(page), "%d/%d", previewPage + 1, previewPages);
+  renderer.drawText(SMALL_FONT_ID, safe.x + 12, buttonRect(0).y - 30,
+                    failed ? tr(STR_HIGHLIGHT_EDIT_UNAVAILABLE) : page);
+  const char* labels[] = {tr(STR_SAVE), confirmDelete ? tr(STR_HIGHLIGHT_CONFIRM_DELETE) : tr(STR_DELETE),
+                          tr(STR_CANCEL)};
+  for (int i = 0; i < 7; ++i) {
+    const Rect rect = buttonRect(i);
+    renderer.drawRect(rect.x, rect.y, rect.width, rect.height, true);
+    if (i < 4) {
+      drawBoundaryIcon(renderer, rect, i);
+      continue;
+    }
+    const std::string label = renderer.truncatedText(UI_10_FONT_ID, labels[i - 4], rect.width - 8);
+    renderer.drawText(UI_10_FONT_ID, rect.x + (rect.width - renderer.getTextWidth(UI_10_FONT_ID, label.c_str())) / 2,
+                      rect.y + (rect.height - renderer.getLineHeight(UI_10_FONT_ID)) / 2, label.c_str());
+  }
+  renderer.displayBuffer();
+}
