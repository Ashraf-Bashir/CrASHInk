+bool ClippingStore::updateClippingText(const size_t index, const std::string& text) {
+  if (index >= clippings.size() || text.empty() || text.size() > CLIPPING_TEXT_MAX) return false;
+  const Clipping previous = clippings[index];
+  const bool previousDirty = dirty;
+  Clipping& clipping = clippings[index];
+  clipping.textLength = static_cast<uint16_t>(text.size());
+  size_t words = 1;
+  for (char ch : text) if (ch == ' ') ++words;
+  clipping.wordCount = static_cast<uint16_t>(std::min<size_t>(words, UINT16_MAX));
+  // An edit invalidates page/word ordinals. Text matching redraws the new range
+  // across pages, and Readest sync detects the changed text on its next run.
+  clipping.layoutSignature = 0;
+  clipping.resolvedLayoutBoundaries = 0;
+  dirty = true;
+  if (!writeToFile(&text, index)) {
+    clippings[index] = previous;
+    dirty = previousDirty;
+    LOG_ERR("CLIP", "Failed to replace edited clipping %u", static_cast<unsigned>(index));
+    return false;
+  }
+  dirty = false;
+  return true;
+}
 
