+inline constexpr uint8_t CLIPPING_SESSION_START_RESOLVED = 1U << 0;
+inline constexpr uint8_t CLIPPING_SESSION_END_RESOLVED = 1U << 1;
+inline constexpr uint8_t CLIPPING_SESSION_BOUNDARIES_RESOLVED =
+    CLIPPING_SESSION_START_RESOLVED | CLIPPING_SESSION_END_RESOLVED;
+// Short clippings can repeat elsewhere in a chapter and are cheap to match, so
+// only longer ones are remembered.
+inline constexpr uint16_t CLIPPING_SESSION_MIN_TOKENS = 8;
+
+inline uint16_t clippingSessionLayoutKey(const uint32_t layoutSignature) {
+  return static_cast<uint16_t>((layoutSignature ^ (layoutSignature >> 16)) & 0xFFFFU);
+}
+
+inline bool clippingSessionRangeValid(const Clipping& clipping, const uint16_t currentPageCount,
+                                      const uint32_t layoutSignature) {
+  return layoutSignature != 0 && currentPageCount > 0 &&
+         clipping.sessionResolved == CLIPPING_SESSION_BOUNDARIES_RESOLVED &&
+         clipping.sessionPageCount == currentPageCount &&
+         clipping.sessionLayoutKey == clippingSessionLayoutKey(layoutSignature) &&
+         clipping.sessionStartPage <= clipping.sessionEndPage;
+}
