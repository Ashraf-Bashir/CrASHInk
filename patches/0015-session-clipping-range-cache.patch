+void ClippingStore::recordSessionRange(const size_t index, const uint16_t page, const uint16_t currentPageCount,
+                                       const uint32_t layoutSignature, const uint16_t startWord,
+                                       const uint16_t endWord, const bool startsAtClipStart,
+                                       const bool reachesClipEnd) {
+  if (index >= clippings.size() || layoutSignature == 0 || currentPageCount == 0) return;
+  Clipping& clipping = clippings[index];
+  const uint16_t key = clippingSessionLayoutKey(layoutSignature);
+  if (clipping.sessionPageCount != currentPageCount || clipping.sessionLayoutKey != key) {
+    clipping.sessionResolved = 0;
+    clipping.sessionPageCount = currentPageCount;
+    clipping.sessionLayoutKey = key;
+  }
+  if (startsAtClipStart) {
+    clipping.sessionStartPage = page;
+    clipping.sessionStartWord = startWord;
+    clipping.sessionResolved |= CLIPPING_SESSION_START_RESOLVED;
+  }
+  if (reachesClipEnd) {
+    clipping.sessionEndPage = page;
+    clipping.sessionEndWord = endWord;
+    clipping.sessionResolved |= CLIPPING_SESSION_END_RESOLVED;
+  }
+}
