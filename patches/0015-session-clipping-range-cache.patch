+// Same as findClippingStoredRangeOnPage, but reads the session-only overlay
+// recorded after a text match (see ClippingStore::recordSessionRange).
+bool findClippingSessionRangeOnPage(const Page& page, const Clipping& clipping, const uint16_t currentPage,
+                                    ClippingPageMatch& match) {
+  if (currentPage < clipping.sessionStartPage || currentPage > clipping.sessionEndPage) return false;
+
+  const uint16_t pageWordCount = countVisiblePageWords(page);
+  if (pageWordCount == 0) return false;
+
+  uint16_t startWord = 0;
+  uint16_t endWord = static_cast<uint16_t>(pageWordCount - 1);
+  if (currentPage == clipping.sessionStartPage) {
+    if (clipping.sessionStartWord >= pageWordCount) return false;
+    startWord = clipping.sessionStartWord;
+  }
+  if (currentPage == clipping.sessionEndPage) {
+    if (clipping.sessionEndWord >= pageWordCount) return false;
+    endWord = clipping.sessionEndWord;
+  }
+  if (startWord > endWord) return false;
+
+  match.startWord = startWord;
+  match.endWord = endWord;
+  match.tableSelection = UINT16_MAX;
+  return true;
+}
