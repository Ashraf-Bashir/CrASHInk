+bool findHyphenatedClippingContinuation(Section& section, const Page& page, const std::string& text,
+                                        ClippingPageMatch& match, ClippingNeighborPageCache& neighborCache,
+                                        const int currentPage) {
+  if (currentPage <= 0) return false;
+  const TextBlock* firstBlock = nullptr;
+  uint16_t firstWord = 0;
+  forEachVisiblePageWord(page, [&](uint16_t, const PageTextLine&, const TextBlock& block, size_t word) {
+    firstBlock = &block;
+    firstWord = static_cast<uint16_t>(word);
+    return false;
+  });
+  if (!firstBlock) return false;
+  const uint16_t tokenCount = countClipTokens(text);
+  const char* cursor = text.c_str();
+  const char* token = nullptr;
+  size_t tokenLength = 0;
+  uint16_t tokenIndex = 0;
+  while (nextClipToken(cursor, token, tokenLength)) {
+    size_t offset = 0;
+    while (offset < tokenLength) {
+      ClippingTextMatcher::nextCodepoint(token, tokenLength, offset);
+      if (offset >= tokenLength) break;
+      if (matchPageWordToToken(*firstBlock, firstWord, token, tokenLength, offset, false, tokenIndex + 1 == tokenCount)
+              .match == ClippingTextMatcher::TokenFragmentMatch::MISMATCH)
+        continue;
+      const Page* previous = neighborCache.load(section, currentPage - 1);
+      if (!previous) return false;
+      const TextBlock* lastBlock = nullptr;
+      uint16_t lastWord = 0;
+      forEachVisiblePageWord(*previous, [&](uint16_t, const PageTextLine&, const TextBlock& block, size_t word) {
+        lastBlock = &block;
+        lastWord = static_cast<uint16_t>(word);
+        return true;
+      });
+      if (!lastBlock || !lastBlock->wordEndsWithInsertedHyphen(lastWord)) return false;
+      const auto prefix = matchPageWordToToken(*lastBlock, lastWord, token, tokenLength, 0, tokenIndex == 0, false);
+      if (prefix.match != ClippingTextMatcher::TokenFragmentMatch::CONTINUES_TOKEN || prefix.tokenBytes != offset)
+        continue;
+      ClippingPageMatch candidate;
+      if (matchClipRunFromPageWord(page, tokenCount, cursor, token, tokenLength, 0, tokenIndex,
+                                   std::min<uint16_t>(tokenCount, 3), UINT8_MAX, candidate, true, offset)) {
+        match = candidate;
+        return true;
+      }
+    }
+    ++tokenIndex;
+  }
+  return false;
+}
