diff --git a/src/util/CrASHinkStorage.cpp b/src/util/CrASHinkStorage.cpp
new file mode 100644
--- /dev/null
+++ b/src/util/CrASHinkStorage.cpp
@@ -0,0 +1,142 @@
+#include "CrASHinkStorage.h"
+
+#include <Epub.h>
+#include <FsHelpers.h>
+#include <HalStorage.h>
+#include <Logging.h>
+
+#include <string>
+#include <string_view>
+
+namespace crashinkStorage {
+namespace {
+constexpr char root[] = "/.crashink";
+constexpr char previousRoot[] = "/crashink";
+constexpr char migrationMarker[] = "/.crashink/.storage-v2";
+constexpr char previousMarker[] = "/.crashink/.storage-v1";
+constexpr char legacyRoot[] = "/.crosspoint";
+constexpr char clippingSource[] = "/.crosspoint/clippings";
+constexpr char clippingTarget[] = "/.crashink/.clippings";
+constexpr char readestTarget[] = "/.crashink/.readest";
+constexpr char libraryTarget[] = "/.crashink/.library";
+
+// Normalize directory names while leaving files and any conflicting copies intact.
+bool moveHiddenTree(const std::string& source, const std::string& target) {
+  bool allMoved = true;
+  HalFile directory = Storage.open(source.c_str());
+  if (!directory || !directory.isDirectory()) return false;
+  char name[256];
+  while (auto entry = directory.openNextFile()) {
+    name[0] = 0;
+    const size_t length = entry.getName(name, sizeof(name));
+    const bool isDirectory = entry.isDirectory();
+    entry.close();
+    if (!length || length >= sizeof(name) - 1) {
+      allMoved = false;
+      continue;
+    }
+    const std::string_view leaf(name, length);
+    if (leaf == "." || leaf == ".." || (!isDirectory && source == target)) continue;
+    const std::string from = source + "/" + name;
+    const std::string to = target + (isDirectory && name[0] != '.' ? "/." : "/") + name;
+    const auto resume = directory.position();
+    directory.close();
+    bool moved = true;
+    if (from == to) {
+      moved = moveHiddenTree(from, to);
+    } else if (!Storage.exists(to.c_str())) {
+      moved = Storage.rename(from.c_str(), to.c_str());
+      if (moved && isDirectory) moved = moveHiddenTree(to, to);
+    } else if (isDirectory) {
+      moved = moveHiddenTree(from, to) && Storage.rmdir(from.c_str());
+    } else {
+      moved = false;
+    }
+    if (!moved) {
+      LOG_ERR("CRASHINK", "Could not migrate SD entry %s", from.c_str());
+      allMoved = false;
+    }
+    directory = Storage.open(source.c_str());
+    if (!directory || !directory.seek(resume)) return false;
+  }
+  return allMoved && !FsHelpers::directoryIterationFailed(directory);
+}
+
+// Close each entry before renaming it. Only one directory and one entry
+// are open at a time, with no buffer proportional to the library size.
+bool moveEntries(const char* source, bool clippings) {
+  bool allMoved = true;
+  HalFile dir = Storage.open(source);
+  if (!dir || !dir.isDirectory()) return false;
+  char name[120];
+  while (auto entry = dir.openNextFile()) {
+    name[0] = 0;
+    const size_t length = entry.getName(name, sizeof(name));
+    const bool file = !entry.isDirectory();
+    entry.close();
+    if (!file || length == 0 || length >= sizeof(name) - 1) continue;
+    const std::string_view leaf(name, length);
+    const char* target = clippings ? clippingTarget : nullptr;
+    if (!clippings) {
+      if (leaf.starts_with("readest.") || leaf.starts_with("readest_")) target = readestTarget;
+      if (leaf.starts_with("library.") || leaf.starts_with("library-") || leaf.starts_with("opened."))
+        target = libraryTarget;
+    }
+    if (!target) continue;
+    const std::string from = std::string(source) + "/" + name;
+    const std::string to = std::string(target) + "/" + name;
+    if (Storage.exists(to.c_str())) {
+      LOG_ERR("CRASHINK", "Storage migration left both copies of %s intact", name);
+      allMoved = false;
+      continue;
+    }
+    if (!Storage.rename(from.c_str(), to.c_str())) {
+      LOG_ERR("CRASHINK", "Storage migration could not move %s", from.c_str());
+      allMoved = false;
+      continue;
+    }
+    if (target == readestTarget && leaf.ends_with(".epub")) {
+      const std::string oldCache = Epub::cachePathForFilePath(from, legacyRoot);
+      if (Storage.exists(oldCache.c_str()) && !Storage.removeDir(oldCache.c_str()))
+        LOG_ERR("CRASHINK", "Could not remove old cache for %s", name);
+    }
+  }
+  const bool failed = FsHelpers::directoryIterationFailed(dir);
+  dir.close();
+  return allMoved && !failed;
+}
+}  // namespace
+
+void migrate() {
+  const bool previousRootExists = Storage.exists(previousRoot);
+  if (!previousRootExists && Storage.exists(migrationMarker)) return;
+  if (previousRootExists && !Storage.exists(root)) Storage.rename(previousRoot, root);
+  if (!Storage.ensureDirectoryExists(root)) {
+    LOG_ERR("CRASHINK", "Could not prepare SD storage folder");
+    return;
+  }
+  const bool normalized = moveHiddenTree(root, root);
+  const bool previousMoved = !Storage.exists(previousRoot) ||
+                             (moveHiddenTree(previousRoot, root) && Storage.rmdir(previousRoot));
+  if (!Storage.ensureDirectoryExists(readestTarget) || !Storage.ensureDirectoryExists(libraryTarget)) {
+    LOG_ERR("CRASHINK", "Could not prepare SD storage subfolders");
+    return;
+  }
+
+  bool legacyMoved = Storage.exists(previousMarker) && Storage.exists(clippingTarget);
+  if (!legacyMoved) {
+    if (Storage.exists(clippingSource) && !Storage.exists(clippingTarget))
+      Storage.rename(clippingSource, clippingTarget);
+    if (!Storage.ensureDirectoryExists(clippingTarget)) {
+      LOG_ERR("CRASHINK", "Could not prepare clipping folder");
+      return;
+    }
+    const bool clipsMoved = !Storage.exists(clippingSource) ||
+                            (moveEntries(clippingSource, true) && Storage.rmdir(clippingSource));
+    const bool filesMoved = !Storage.exists(legacyRoot) || moveEntries(legacyRoot, false);
+    legacyMoved = clipsMoved && filesMoved;
+  }
+  if (normalized && previousMoved && legacyMoved && !Storage.writeFile(migrationMarker, "2"))
+    LOG_ERR("CRASHINK", "Could not save the SD storage migration marker");
+}
+}  // namespace crashinkStorage
