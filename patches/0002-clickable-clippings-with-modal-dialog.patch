From: Ash <eng.bashir@gmail.com>
Date: Tue, 16 Sep 2026 18:36:00 +0200
Subject: [PATCH] Make clippings clickable with delete/cancel modal dialog

Adds interaction to clipping list and detail views:
- Single tap on a clipping in list view opens a modal dialog with Delete/Cancel options
- Single tap on a highlight in detail view shows the same modal
- Tapping outside the modal (on the scrim) dismisses it without action
- Modal uses existing FileBrowserActionActivity pattern for consistency

This change improves the discoverability of the clipping delete action, which
was previously only accessible via long-press.

Co-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KaJ8XduCXoFeusbsh1W6mM
---
 src/activities/reader/EpubReaderClippingListActivity.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/activities/reader/EpubReaderClippingListActivity.cpp b/src/activities/reader/EpubReaderClippingListActivity.cpp
index 1234567..abcdefg 100644
--- a/src/activities/reader/EpubReaderClippingListActivity.cpp
+++ b/src/activities/reader/EpubReaderClippingListActivity.cpp
@@ -271,7 +271,10 @@ void EpubReaderClippingListActivity::showClippingActionMenu(const bool ignoreIn
   const Clipping* selectedClipping = CLIPPINGS.clippingAt(static_cast<size_t>(selectedIndex));
   if (!selectedClipping) return;
   const char* title = selectedClipping->chapterTitle[0] != '\0' ? selectedClipping->chapterTitle : tr(STR_CLIPPINGS);
+  // Capture clipping metadata before starting async activity, since selectedIndex may change
   const uint16_t selectedSpineIndex = selectedClipping->spineIndex;
   const uint16_t selectedStartPage = selectedClipping->startPage;
   const uint16_t selectedStartWordIndex = selectedClipping->startWordIndex;
   const uint32_t selectedTimestamp = selectedClipping->timestamp;
   std::vector<FileBrowserActionActivity::MenuItem> items;
   items.reserve(1);
+  // Offer both Delete and Cancel actions for clarity on single-tap interaction
   items.push_back({FileBrowserAction::Delete, StrId::STR_DELETE});
+  items.push_back({FileBrowserAction::Cancel, StrId::STR_CANCEL});

   startActivityForResult(
       std::make_unique<FileBrowserActionActivity>(renderer, mappedInput, title, std::move(items),
@@ -348,12 +351,23 @@ void EpubReaderClippingListActivity::loop() {
   if (CLIPPINGS.clippingCount() > 0 && !longPressConfirmHandled &&
       mappedInput.isPressed(MappedInputManager::Button::Confirm) &&
       mappedInput.getHeldTime() >= ReaderUtils::DELETE_HOLD_MS) {
     longPressConfirmHandled = true;
     showClippingActionMenu(true);
     return;
   }

   if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
     if (longPressConfirmHandled) {
       longPressConfirmHandled = false;
       return;
     }
     if (CLIPPINGS.clippingCount() > 0 && selectedIndex >= 0 &&
         selectedIndex < static_cast<int>(CLIPPINGS.clippingCount())) {
       if (detailMode) {
-        jumpToSelectedClipping();
+        // Single tap in detail view now shows action modal instead of jumping back
+        showClippingActionMenu(false);
       } else {
-        openSelectedDetail();
+        // Single tap in list view now shows action modal
+        showClippingActionMenu(false);
       }
     }
     return;
