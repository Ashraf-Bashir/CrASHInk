+// Draws a glyph lighter or bolder than it was built. Works on an "effective level"
+// per pixel (0 black, 1 dark grey, 2 light grey, 3 white - the same scale the
+// unweighted path derives from the bitmap) and then emits it exactly like the
+// unweighted path, so BW and both grayscale passes stay consistent with each other.
+//   +1  ink spreads 1px to the right      +2  ...and 1px down as well
+//   -1  every grey step gets one lighter  -2  two steps lighter (only solid black stays)
+// 1-bit fonts have no grey steps, so lighter erodes instead: -1 drops the right edge
+// of each stroke, -2 the bottom edge too. Advance widths are untouched, so layout,
+// page breaks and highlights are identical whatever the weight.
+static void renderCharWeighted(const GfxRenderer& renderer, GfxRenderer::RenderMode renderMode,
+                               const EpdFontData* fontData, const EpdGlyph* glyph, const int cursorX,
+                               const int cursorY, const bool pixelState, const int weight) {
+  const bool is2Bit = fontData->is2Bit;
+  const int width = glyph->width;
+  const int height = glyph->height;
+  const uint8_t* bitmap = renderer.getGlyphBitmap(fontData, glyph);
+  if (bitmap == nullptr || width <= 0 || height <= 0) return;
+
+  const int baseX = cursorX + glyph->left;
+  const int baseY = cursorY - glyph->top;
+  const int extraRight = weight >= 1 ? 1 : 0;
+  const int extraDown = weight >= 2 ? 1 : 0;
+
+  if (!renderer.glyphIntersectsStrip(baseX, baseY, baseX + width - 1 + extraRight, baseY + height - 1 + extraDown)) {
+    return;
+  }
+
+  // Source level at glyph coordinates; outside the glyph is white.
+  const auto levelAt = [&](const int gx, const int gy) -> int {
+    if (gx < 0 || gy < 0 || gx >= width || gy >= height) return 3;
+    const int position = gy * width + gx;
+    if (is2Bit) {
+      const uint8_t byte = bitmap[position >> 2];
+      const uint8_t bitIndex = (3 - (position & 3)) * 2;
+      return 3 - ((byte >> bitIndex) & 0x3);
+    }
+    return ((bitmap[position >> 3] >> (7 - (position & 7))) & 1) ? 0 : 3;
+  };
+
+  for (int gy = 0; gy < height + extraDown; gy++) {
+    for (int gx = 0; gx < width + extraRight; gx++) {
+      int level = levelAt(gx, gy);
+      if (weight > 0) {
+        level = std::min(level, levelAt(gx - 1, gy));
+        if (weight >= 2) {
+          level = std::min(level, levelAt(gx, gy - 1));
+          level = std::min(level, levelAt(gx - 1, gy - 1));
+        }
+      } else if (is2Bit) {
+        level = std::min(3, level + (-weight));
+      } else if (level == 0) {
+        // 1-bit erosion: keep a pixel only while its right (and, at -2, lower) neighbour is inked too.
+        if (levelAt(gx + 1, gy) != 0 || (weight <= -2 && levelAt(gx, gy + 1) != 0)) level = 3;
+      }
+      if (level >= 3) continue;
+
+      const int screenX = baseX + gx;
+      const int screenY = baseY + gy;
+      if (!is2Bit || renderMode == GfxRenderer::BW) {
+        // Black (also paints over the greys in BW mode). 1-bit fonts draw in every pass, as unweighted.
+        renderer.drawPixel(screenX, screenY, pixelState);
+      } else if (renderMode == GfxRenderer::GRAYSCALE_MSB && (level == 1 || level == 2)) {
+        renderer.drawPixel(screenX, screenY, false);
+      } else if (renderMode == GfxRenderer::GRAYSCALE_LSB && level == 1) {
+        renderer.drawPixel(screenX, screenY, false);
+      }
+    }
+  }
+}
