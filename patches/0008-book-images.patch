+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <vector>
+#define LOG_ERR(...) do {} while(0)
+constexpr int TAG_PageLine=1,TAG_PageImage=2;
+struct Block {int16_t width,height;int16_t getWidth()const{return width;}int16_t getHeight()const{return height;}};
+struct Element {int16_t xPos=0,yPos=0;virtual ~Element()=default;virtual int getTag()const{return TAG_PageLine;}};
+struct PageImage:Element {
+ Block block;
+ PageImage(int x,int y,int w,int h):block{int16_t(w),int16_t(h)}{xPos=x;yPos=y;}
+ int getTag()const override{return TAG_PageImage;}
+ const Block& getImageBlock()const{return block;}
+};
+struct Renderer;
+struct Page {
+ void renderImages(Renderer&,int,int,int,bool) const;
+ void renderText(Renderer&,int,int,int,bool) const;
+ void render(Renderer&,int,int,int,bool) const;
+ void renderWithImagePlaceholders(Renderer& renderer,int font,int left,int top,bool foreground,bool) const {
+  renderText(renderer,font,left,top,foreground);
+ }
+ unsigned decodes = 0;
+ void prepareImageCaches() { ++decodes; }
+ std::vector<std::unique_ptr<Element>>elements;
+ #include "ImageRects.inc"
+ int imageArea()const{int area=0;forEachImageRect([&](int,int,int w,int h){area+=w*h;});return area;}
+};
+namespace HalDisplay {enum {FAST_REFRESH=1,HALF_REFRESH=2};}
+struct Renderer {
+ enum RenderMode {BW,GRAYSCALE_LSB,GRAYSCALE_MSB};
+ struct FrameBufferLoan {
+  Renderer& renderer;
+  explicit FrameBufferLoan(Renderer& renderer) : renderer(renderer) {
+   std::fill(renderer.pixels.begin(), renderer.pixels.end(), 9);
+  }
+  void end() {}
+ };
+ RenderMode mode=BW;
+ uint8_t* target=nullptr;
+ std::vector<uint8_t> lsb,msb;
+ std::vector<std::array<int,4>> regions;
+ unsigned baseCalls=0,cleanups=0;
+ bool grayFails=false;
+ int failY = -1;
+ unsigned failedWindows = 0;
+ bool displayDirectGrayscaleBase(){++baseCalls;return true;}
+ uint8_t* getFrameBuffer(){return pixels.data();}
+ size_t getBufferSize()const{return pixels.size();}
+ int getDisplayHeight()const{return 160;}
+ void setRenderMode(RenderMode next){mode=next;}
+ void beginStripTarget(uint8_t* data,int,int){target=data;}
+ void endStripTarget(){target=nullptr;}
+ void copyGrayscaleLsbBuffers(uint8_t* data){lsb.assign(data,data+pixels.size());}
+ void copyGrayscaleMsbBuffers(uint8_t* data){msb.assign(data,data+pixels.size());}
+ bool displayDirectGrayRegion(int x,int y,int w,int h){
+  if (grayFails || y == failY) { ++failedWindows; return false; }
+  regions.push_back({x,y,w,h});
+  // The panel changes only the requested image. Page text stays untouched.
+  auto next=frames.back();
+  for(int j=y;j<y+h;++j)for(int i=x;i<x+w;++i)next[j*100+i]=2+lsb[j*100+i]+msb[j*100+i];
+  frames.push_back(std::move(next));return true;
+ }
+ void cleanupGrayscaleWithFrameBuffer(){++cleanups;}
+ void displayBuffer(int mode){displayGrayscaleBase(mode);}
+
+ std::vector<uint8_t> pixels = std::vector<uint8_t>(100 * 160);
+ std::vector<std::vector<uint8_t>> frames;
+ std::vector<int> modes;
+ void displayGrayscaleBase(int mode) {
+  frames.push_back(pixels);
+  modes.push_back(mode);
+ }
+};
+using GfxRenderer=Renderer;
+void Page::renderText(Renderer& renderer,int,int,int,bool) const {
+ forEachImageRect([&](int x,int y,int w,int h){
+  for(int j=y;j<y+h;++j)for(int i=x;i<x+w;++i)renderer.pixels[j*100+i]=0;
+ });
+}
+void Page::render(Renderer& renderer,int font,int left,int top,bool foreground) const {
+ renderText(renderer,font,left,top,foreground);
+ renderImages(renderer,font,left,top,foreground);
+}
+void Page::renderImages(Renderer& renderer,int,int,int,bool) const {
+ forEachImageRect([&](int x,int y,int w,int h){
+  for(int j=y;j<y+h;++j)for(int i=x;i<x+w;++i)
+   if (renderer.mode == Renderer::BW) renderer.pixels[j*100+i] = 1;
+   else renderer.target[j*100+i]=(renderer.mode==Renderer::GRAYSCALE_LSB ? (i+j)%2 : i%2);
+ });
+}
+struct Reader {
+ Page* page=nullptr;
+ std::unique_ptr<uint8_t[]> regionalImageLsb,regionalImageMsb;
+ int fontId=0,orientedMarginLeft=0,orientedMarginTop=0;
+ bool renderImage();
+ void composePage();
+ bool foregroundBlack = true, pageHasImagesNeedingDecode = false;
+ Renderer renderer;
+ bool pageHasImages = true, deferImageLoading = false, cleanImageBasePending = false;
+ int pagesUntilFullRefresh = 3;
+ int manualScreenRefreshMode() { return HalDisplay::HALF_REFRESH; }
+};
+#include "ImageRefresh.inc"
+int main() {
+ for (bool cleanup : {false, true}) {
+  Reader reader;
+  reader.cleanImageBasePending = cleanup;
+  for (size_t i = 0; i < reader.renderer.pixels.size(); ++i) reader.renderer.pixels[i] = (i % 3 != 0);
+  const auto composed = reader.renderer.pixels;
+  assert(reader.renderImage());
+  assert(reader.renderer.frames.size() == 1);
+  assert(reader.renderer.frames.front() == composed);
+  assert(reader.renderer.modes.front() == HalDisplay::FAST_REFRESH);
+  assert(reader.pagesUntilFullRefresh == 3 && !reader.cleanImageBasePending);
+ }
+ // Cached and freshly decoded images use the same image-only refinement.
+ for(bool uncached : {false,true}) {
+  Page images;images.elements.push_back(std::make_unique<PageImage>(8,12,16,16));
+  images.elements.push_back(std::make_unique<PageImage>(8,90,16,16));
+  Reader reader;reader.page=&images;reader.cleanImageBasePending=true;
+  reader.pageHasImagesNeedingDecode=uncached;
+  reader.regionalImageLsb=std::make_unique<uint8_t[]>(reader.renderer.getBufferSize());
+  reader.regionalImageMsb=std::make_unique<uint8_t[]>(reader.renderer.getBufferSize());
+  for(size_t i=0;i<reader.renderer.pixels.size();++i)reader.renderer.pixels[i]=i%3!=0;
+  reader.composePage();
+  const auto composed=reader.renderer.pixels;
+  assert(reader.renderImage());
+  assert(reader.renderer.modes==std::vector<int>{HalDisplay::FAST_REFRESH});
+  assert(reader.renderer.frames.front()==composed);
+  assert(reader.renderer.frames.front()[12*100+8]==0);
+  assert(reader.renderer.frames[1][12*100+8]>=2);
+  assert(images.decodes==unsigned(uncached));
+  assert(reader.renderer.regions.size()==2);
+  assert((reader.renderer.regions[0]==std::array<int,4>{8,12,16,16}));
+  assert((reader.renderer.regions[1]==std::array<int,4>{8,90,16,16}));
+  for(const auto& frame:reader.renderer.frames)
+   for(int y=28;y<90;++y)for(int x=0;x<100;++x)assert(frame[y*100+x]==composed[y*100+x]);
+  assert(reader.renderer.pixels[12*100+8]==1 && reader.renderer.mode==Renderer::BW);
+  assert(reader.renderer.pixels[45*100+8]==composed[45*100+8]);
+  assert(reader.renderer.cleanups==1 && !reader.cleanImageBasePending && reader.pagesUntilFullRefresh==3);
+ }
+ // A failed regional pass leaves the initial frame and makes no full-page retry.
+ Page failurePage;failurePage.elements.push_back(std::make_unique<PageImage>(8,12,16,16));
+ Reader failed;failed.page=&failurePage;failed.renderer.grayFails=true;
+ failed.regionalImageLsb=std::make_unique<uint8_t[]>(failed.renderer.getBufferSize());
+ failed.regionalImageMsb=std::make_unique<uint8_t[]>(failed.renderer.getBufferSize());
+ const auto bwFailure=failed.renderer.pixels;
+ assert(failed.renderImage() && failed.renderer.frames.size()==1);
+ assert(failed.renderer.frames.front()==bwFailure && failed.renderer.mode==Renderer::BW);
+ assert(failed.renderer.failedWindows == 2);
+ Page separate;
+ separate.elements.push_back(std::make_unique<PageImage>(8,12,16,16));
+ separate.elements.push_back(std::make_unique<PageImage>(8,90,16,16));
+ Reader partial;
+ partial.page = &separate;
+ partial.renderer.failY = 12;
+ partial.regionalImageLsb = std::make_unique<uint8_t[]>(partial.renderer.getBufferSize());
+ partial.regionalImageMsb = std::make_unique<uint8_t[]>(partial.renderer.getBufferSize());
+ partial.composePage();
+ assert(partial.renderImage());
+ assert(partial.renderer.failedWindows == 2);
+ assert((partial.renderer.regions == std::vector<std::array<int,4>>{{8,90,16,16}}));
+ assert(partial.renderer.modes == std::vector<int>{HalDisplay::FAST_REFRESH});
+ Reader manual;manual.pagesUntilFullRefresh=-1;assert(manual.renderImage());
+ assert(manual.renderer.modes==std::vector<int>{HalDisplay::HALF_REFRESH});
+ Page empty;empty.elements.push_back(std::make_unique<Element>());
+ int count=0;assert(!empty.forEachImageRect([&](int,int,int,int){++count;}));assert(count==0);
+ std::cout<<"Image refresh paints text once and updates only photo windows\n";
+}
