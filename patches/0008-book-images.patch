+
+TEST_F(EpubGrayscaleTest, CombinedImagePagePublishesOnlyFinalGrayscaleAndKeepsText) {
+  GfxRenderer r(32, 24);
+  r.orientation = GfxRenderer::LandscapeCounterClockwise;
+  Page page;
+  ImageBlock block("combined.jpg", "", 4, 4);
+  Storage.put("combined.pxc", cache(4, 4));
+  page.images.push_back({&block, 8, 2});
+  r.clearScreen(0xff);
+  r.bw[0] = 0x00;  // Book text or controls outside the illustration.
+  const auto original = r.bw;
+  std::vector<uint8_t> plane(r.getBufferSize());
+
+  EXPECT_FALSE(EpubGrayscale::runCombinedImagePass(r, page, 0, 0, 0, plane.data()));
+  EXPECT_TRUE(r.events.empty());
+  r.combinedSupported = true;
+  ASSERT_TRUE(EpubGrayscale::runCombinedImagePass(r, page, 0, 0, 0, plane.data()));
+  EXPECT_EQ(r.events, (std::vector<std::string>{"combined", "lsb", "msb", "gray", "cleanup"}));
+  EXPECT_EQ(r.bw, original);
+  EXPECT_EQ(r.lsb[0], 0x00);
+  EXPECT_EQ(r.msb[0], 0x00);
+  const int picture = 2 * r.stride + 1;
+  EXPECT_EQ(r.lsb[picture] & 0xf0, 0x50);  // levels 0/1/2/3 -> 0/1/0/1
+  EXPECT_EQ(r.msb[picture] & 0xf0, 0x30);  // levels 0/1/2/3 -> 0/0/1/1
+  EXPECT_EQ(r.getRenderMode(), GfxRenderer::BW);
+}
+
+TEST_F(EpubGrayscaleTest, PendingImageUsesBackgroundWithoutBorder) {
+  for (bool foreground : {false, true}) {
+    for (int size : {1, 2, 21}) {
+      GfxRenderer renderer;
+      ImageBlock block("pending.jpg", "", size, size);
+      block.renderPlaceholder(renderer, 7, 11, foreground);
+      ASSERT_EQ(renderer.placeholderRects.size(), 1u);
+      const std::array<int,5> expected{7,11,size,size,foreground?0:1};
+      EXPECT_EQ(renderer.placeholderRects[0], expected);
+    }
+  }
 }

