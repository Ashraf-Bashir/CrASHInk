   static constexpr uint8_t MAX_WORD_SPACING = 4;
+  // Negative values: word spacing and margins are stored in their existing byte as a signed
+  // (two's complement) value, so old settings files keep their meaning. Word spacing runs
+  // -4..4 (each negative step removes a quarter of the natural gap). Margins run -30..127
+  // and are added to the panel's viewable insets; the reader never lets the total go below 0.
+  static constexpr int WORD_SPACING_LOWEST = -4;
+  static constexpr int WORD_SPACING_HIGHEST = 4;
+  static constexpr int MARGIN_LOWEST = -30;
+  static constexpr int MARGIN_HIGHEST = 127;
+  // Decodes a stored byte. A byte below the lowest allowed negative can only be an old
+  // (pre-negative) value that was larger than the signed range, so it maps to the highest.
+  static int decodeSignedSetting(const uint8_t raw, const int lowest, const int highest) {
+    const int value = static_cast<int8_t>(raw);
+    if (value < lowest) return highest;
+    return value > highest ? highest : value;
+  }
+  static uint8_t encodeSignedSetting(const int value, const int lowest, const int highest) {
+    const int clamped = value < lowest ? lowest : (value > highest ? highest : value);
+    return static_cast<uint8_t>(static_cast<int8_t>(clamped));
+  }
+  static int wordSpacingLevelOf(const uint8_t raw) {
+    return decodeSignedSetting(raw, WORD_SPACING_LOWEST, WORD_SPACING_HIGHEST);
+  }
+  static uint8_t sanitizeWordSpacing(const uint8_t raw) {
+    return encodeSignedSetting(wordSpacingLevelOf(raw), WORD_SPACING_LOWEST, WORD_SPACING_HIGHEST);
+  }
+  static int marginOf(const uint8_t raw) { return decodeSignedSetting(raw, MARGIN_LOWEST, MARGIN_HIGHEST); }
+  static uint8_t sanitizeMargin(const uint8_t raw) {
+    return encodeSignedSetting(marginOf(raw), MARGIN_LOWEST, MARGIN_HIGHEST);
+  }
+  int wordSpacingLevel() const { return wordSpacingLevelOf(wordSpacing); }
+  int marginVertical() const { return marginOf(screenMarginVertical); }
+  int marginHorizontal() const { return marginOf(screenMarginHorizontal); }
+  // For readers that cannot use a negative margin (TXT, dictionary sheets).
+  uint8_t marginVerticalNonNegative() const { return static_cast<uint8_t>(marginVertical() < 0 ? 0 : marginVertical()); }
+  uint8_t marginHorizontalNonNegative() const {
+    return static_cast<uint8_t>(marginHorizontal() < 0 ? 0 : marginHorizontal());
+  }
