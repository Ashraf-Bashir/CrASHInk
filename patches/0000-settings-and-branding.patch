diff --git a/src/components/CrASHinkLogo.h b/src/components/CrASHinkLogo.h
new file mode 100644
index 0000000000000000000000000000000000000000..4d043e1493b05037e3a47cdb6515407c4b75d59f
--- /dev/null
+++ b/src/components/CrASHinkLogo.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <GfxRenderer.h>
+#include "images/Logo120.h"
+inline void drawCrASHinkLogo(const GfxRenderer& renderer, int x, int y) {
+  // The original droplet bytes are panel-oriented. Map them into logical rows
+  // before adding the face, so the entire mark follows the screen orientation.
+  for (int row = 0; row < 120; ++row)
+    for (int col = 0; col < 120; ++col)
+      if (!(Logo120[(119 - col) * 15 + row / 8] & (0x80 >> (row & 7)))) renderer.drawPixel(x + col, y + row, true);
+  for (int eye : {46, 74}) {
+    for (int dx = -6; dx <= 6; ++dx) {
+      const int yy = 64 - (36 - dx * dx) / 9;
+      renderer.fillRect(x + eye + dx, y + yy, 2, 3, false);
+    }
+  }
+  for (int dx = -14; dx <= 14; ++dx) {
+    const int yy = 82 + (196 - dx * dx) / 26;
+    renderer.fillRect(x + 60 + dx, y + yy, 2, 3, false);
+  }
+}
