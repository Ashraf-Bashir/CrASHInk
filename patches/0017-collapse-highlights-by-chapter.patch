+EpubReaderClippingListActivity::EpubReaderClippingListActivity(GfxRenderer& renderer, MappedInputManager& mappedInput,
+                                                               Epub* book, std::string bookPath)
     : Activity("EpubClippingList", renderer, mappedInput),
+      book(book),
+      bookPath(std::move(bookPath)),
       uiTarget(makeUiTarget(renderer)),
       app(uiTarget, uiTarget.deviceContext()) {}
+
+void EpubReaderClippingListActivity::rebuildGroups() {
+  if (!book && !bookPath.empty() && !metadataBook) {
+    metadataBook = makeUniqueNoThrow<Epub>(bookPath, "/.crosspoint");
+    if (metadataBook) {
+      metadataBook->setupCacheDir();
+      if (metadataBook->load(false, true, Epub::XLocationLoadMode::Skip, true))
+        book = metadataBook.get();
+      else
+        LOG_ERR("CLIP", "Chapter metadata unavailable; grouping by spine");
+    } else
+      LOG_ERR("CLIP", "Cannot allocate clipping chapter metadata");
+  }
+  std::vector<HighlightChapterGroups::Entry> entries;
+  entries.reserve(CLIPPINGS.clippingCount());
+  // Group by the TOC identity, not its title: repeated chapter names stay distinct.
+  int lastSpine = -1;
+  int toc = -1;
+  for (size_t i = 0; i < CLIPPINGS.clippingCount(); ++i) {
+    const Clipping* clipping = CLIPPINGS.clippingAt(i);
+    if (lastSpine != clipping->spineIndex) {
+      lastSpine = clipping->spineIndex;
+      toc = book ? book->getTocIndexForSpineIndex(clipping->spineIndex) : -1;
+    }
+    const uint32_t chapter = toc >= 0 ? static_cast<uint32_t>(toc) : 0x10000U + clipping->spineIndex;
+    entries.push_back({chapter, static_cast<uint16_t>(i)});
+  }
+  chapterGroups.build(std::move(entries));
+}
+
+std::string EpubReaderClippingListActivity::groupTitle(size_t index) const {
+  const auto& group = chapterGroups.groups[index];
+  if (book && group.chapter < 0x10000U) return book->getTocItem(static_cast<int>(group.chapter)).title;
+  std::string title;
+  CLIPPINGS.readChapterTitle(chapterGroups.entries[group.begin].clipping, title);
+  return title.empty() ? tr(STR_UNKNOWN_CHAPTER) : title;
+}
+
+void EpubReaderClippingListActivity::activateRow(bool longPress, bool ignoreInitialConfirmRelease) {
+  RenderLock lock(*this);
+  if (listNav.selected < 0 || listNav.selected >= static_cast<int>(chapterGroups.rows.size())) return;
+  if (chapterGroups.header(listNav.selected)) {
+    const auto group = -chapterGroups.rows[listNav.selected] - 1;
+    chapterGroups.toggle(listNav.selected);
+    const auto it = std::find(chapterGroups.rows.begin(), chapterGroups.rows.end(), -group - 1);
+    listNav.selected = static_cast<int>(it - chapterGroups.rows.begin());
+    listNav.follow(static_cast<int>(chapterGroups.rows.size()));
+    requestUpdate();
+    return;
+  }
+  selectedClipping = static_cast<size_t>(chapterGroups.rows[listNav.selected]);
+  if (longPress)
+    showClippingActionMenu(ignoreInitialConfirmRelease);
+  else
+    openSelectedDetail();
+}

