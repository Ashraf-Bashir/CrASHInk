+  static UITheme& getInstance(){static UITheme t;return t;}
+  Rect getScreenSafeArea(const Renderer&,bool,bool) const{return {0,0,480,800};}
+  ThemeMetrics getMetrics() const{return {};}
+};
+struct TouchHeaderBackButton { static int height(const ThemeMetrics&,const Input&){return 40;} };
+enum class UiListRowType{WithSubtitle};
+int16_t uiListRowHeight(const fui::ThemeTokens&,UiListRowType){return 72;}
+uint16_t configureUiList(fui::ListProps& props,const fui::ThemeTokens&,fui::Rect body,UiListRowType){
+ props.rowGap=8;return fui::listVisibleRows(body,props.rowHeight,props.rowGap);
+}
+enum StringId{STR_UNKNOWN_CHAPTER,STR_CLIPPINGS_LOAD_FAILED,STR_NO_CLIPPINGS,STR_CLIPPING_PREVIEW_UNAVAILABLE_FORMAT};
+const char* tr(StringId id){return id==STR_CLIPPING_PREVIEW_UNAVAILABLE_FORMAT?"Highlight %u (preview unavailable)":"Unknown";}
+class Epub {
+ public:
+  enum class XLocationLoadMode{Skip};
+  bool split=false;
+  Epub()=default;Epub(std::string,std::string){}
+  void setupCacheDir(){}
+  bool load(bool,bool,XLocationLoadMode,bool){return true;}
+  std::string getPath() const{return "book.epub";}
+  std::string getTitle() const{return "Book";}
+  std::string getAuthor() const{return "Author";}
+  int getTocItemsCount() const{return 3;}
+  int getSpineItemsCount() const{return 4;}
+  bool distinctToc=false;
+  int getTocIndexForSpineIndex(int spine) const{return distinctToc?spine:2;} // deliberately aliased metadata
+  struct Toc {std::string title;};
+  Toc getTocItem(int) const{return {"Chapter 2"};}
+  bool resolveChapterGroupRange(int spine,int& first,int& last) const{
+   first=split&&spine>=2?2:spine;last=split&&spine>=2?3:spine;return true;
+  }
+};
+template<typename T,typename...Args>std::unique_ptr<T> makeUniqueNoThrow(Args&&...args){return std::make_unique<T>(std::forward<Args>(args)...);}
+struct FsFile{};
+struct Clip {uint16_t spineIndex;std::string title;};
+using Clipping=Clip;
+struct Store {
+ std::vector<Clip> clips;
+ std::string loadedPath="book.epub";
+ uint32_t revision=1;
+ size_t opens=0,titles=0,loads=0;
+ std::function<void()> onPreview;
+ size_t clippingCount() const{return clips.size();}
+ const Clip* clippingAt(size_t i) const{return &clips.at(i);}
+ bool isLoadedFor(const std::string& path) const{return loadedPath==path;}
+ bool loadForBook(const std::string& path,const std::string&,const std::string&,const std::string&){loadedPath=path;++loads;++revision;return true;}
+ uint32_t contentRevision() const{return revision;}
+ bool hasLoadError() const{return false;}
+ bool openTextReader(FsFile&){++opens;return true;}
+ bool readChapterTitle(size_t i,std::string& out,FsFile&){++titles;out=clips.at(i).title;return true;}
+ bool readClippingPreview(size_t i,std::string& out){
+  if(onPreview){auto change=std::move(onPreview);onPreview={};change();}
+  out=i%11==0?"":"clip-"+std::to_string(i);
+  return i%13!=0;
+ }
+}CLIPPINGS;
+struct Screen {
+ struct Row{int index;std::string label,value;uint16_t iconWidth;};
+ fui::ThemeTokens tokens{};
+ fui::Rect bounds{0,0,480,800};
+ std::vector<Row> drawn;
+ uint16_t first=0;
+ const fui::ThemeTokens& theme() const{return tokens;}
+ void setContentMargin(fui::Insets margin){bounds=fui::Rect{0,0,480,800}.inset(margin);}
+ void spacer(int16_t height){bounds.y+=height;bounds.height-=height;}
+ fui::Rect body() const{return bounds;}
+ void centeredText(const char*,const fui::TextStyle&){}
+ void list(const fui::ListProps& props){
+  first=props.itemsWindowFirst;
+  for(unsigned slot=0;slot<props.itemsWindowCount;++slot){
+   const auto& item=props.items[slot];
+   assert(item.actionValue==props.itemsWindowFirst+slot);
+   drawn.push_back({item.actionValue,item.label?item.label:"",item.value?item.value:"",item.icon.width});
+  }
+ }
+};
+struct UiApp{using ScreenType=Screen;};
+class EpubReaderClippingListActivity {
+ public:
+ Epub* book=nullptr;
+ std::unique_ptr<Epub> metadataBook;
+ std::string bookPath="book.epub";
+ HighlightChapterGroups chapterGroups;
+ HighlightChapterLabels chapterLabels;
+ uint32_t groupsRevision=0;
+ Renderer renderer;Input mappedInput;Target uiTarget;
+ fui::ListNav listNav;
+ static constexpr size_t CLIPPING_WINDOW_SIZE=20;
+ static constexpr fui::ActionId ACTION_ROW=1;
+ std::array<std::string,20>uiLabels,uiChapterTitles;
+ std::array<fui::ListItem,20>uiItems;
+ int visibleRows=1;
+ void rebuildGroups();std::string groupTitle(size_t)const;void buildListScreen(UiApp::ScreenType&);
+};
+#include "ClippingList.inc"
+int main(){
+ Epub book;EpubReaderClippingListActivity list;list.book=&book;
+ const std::string names[]={"Introduction","Chapter 1","Chapter 2"};
+ for(unsigned i=0;i<90;++i)CLIPPINGS.clips.push_back({static_cast<uint16_t>(i%3),names[i%3]});
+ list.rebuildGroups();
+ assert(list.chapterGroups.groups.size()==3&&list.chapterGroups.entries.size()==90);
+ assert(CLIPPINGS.opens==1&&CLIPPINGS.titles==90); // one batched reader
+ for(unsigned g=0;g<3;++g){assert(list.groupTitle(g)==names[g]);assert(list.chapterGroups.groups[g].count==30);list.chapterGroups.groups[g].open=true;}
+ list.chapterGroups.rebuild();
+ std::vector<bool>seen(90,false);
+ int top=0;
+ for(int page=0;page<30;++page){
+  list.listNav.top=top;
+  Screen screen;list.buildListScreen(screen);
+  assert(!screen.drawn.empty());
+  for(const auto& row:screen.drawn){
+   assert(!row.label.empty());
+   if(!list.chapterGroups.header(row.index)){
+    const auto original=list.chapterGroups.rows[row.index];seen.at(original)=true;
+    if(original%11==0||original%13==0)assert(row.label.find("preview unavailable")!=std::string::npos);
+    else assert(row.label=="clip-"+std::to_string(original));
+   }
+  }
+  const int next=std::min(static_cast<int>(list.chapterGroups.rows.size())-list.visibleRows,top+list.visibleRows);
+  if(next<=top)break;top=next;
+ }
+ for(bool present:seen)assert(present); // every rendered/store record is reachable
+ // Input changes the live viewport while a preview is read. This render must
+ // keep the original top/slot/action snapshot and stay inside its array.
+ list.listNav.top=0;
+ CLIPPINGS.onPreview=[&]{list.listNav.top=40;};
+ Screen concurrent;list.buildListScreen(concurrent);
+ assert(concurrent.first==0&&concurrent.drawn.front().index==0&&list.listNav.top==40);
+ // A live store update is reflected without reopening the list.
+ CLIPPINGS.clips.push_back({0,"Introduction"});++CLIPPINGS.revision;
+ Screen updated;list.buildListScreen(updated);
+ assert(list.chapterGroups.entries.size()==91&&list.chapterGroups.groups[0].count==31);
+ // Same-name chapters in different spines stay separate; multiple saved
+ // chapter names within a single spine also stay separate.
+ auto first=list.chapterLabels.keyFor(0,"Repeated");
+ assert(first!=list.chapterLabels.keyFor(1,"Repeated"));
+ assert(list.chapterLabels.keyFor(0,"Introduction")!=list.chapterLabels.keyFor(0,"Chapter 1"));
+ const auto stable=list.chapterLabels.keyFor(0,"Introduction");
+ list.rebuildGroups();assert(list.chapterLabels.keyFor(0,"Introduction")==stable);
+ // Optimizer-created pieces still group as their logical chapter.
+ EpubReaderClippingListActivity split;book.split=true;split.book=&book;
+ CLIPPINGS.clips={{2,"Chapter 2"},{3,"Chapter 2"}};++CLIPPINGS.revision;
+ split.rebuildGroups();assert(split.chapterGroups.groups.size()==1&&split.chapterGroups.groups[0].count==2);
+ CLIPPINGS.loadedPath="other.epub";split.rebuildGroups();assert(CLIPPINGS.loads==1&&CLIPPINGS.loadedPath=="book.epub");
+ // Eight local records and one imported/other-part record for the same
+ // contents entry must produce one header, retaining every original ID.
+ EpubReaderClippingListActivity duplicate;book.split=false;duplicate.book=&book;
+ CLIPPINGS.clips.assign(8,{2,"6 Stay on Point"});
+ CLIPPINGS.clips.push_back({3," 6\xC2\xA0Stay  on Point\n"});++CLIPPINGS.revision;
+ duplicate.rebuildGroups();
+ assert(duplicate.chapterGroups.groups.size()==1 && duplicate.chapterGroups.groups[0].count==9);
+ assert(duplicate.groupTitle(0)=="6 Stay on Point");
+ duplicate.chapterGroups.toggle(0);
+ for(unsigned i=0;i<9;++i)assert(duplicate.chapterGroups.rows[i+1]==int(i));
+ duplicate.rebuildGroups();assert(duplicate.chapterGroups.groups[0].open);
+ // Repeated headings in genuinely distinct contents entries stay distinct.
+ EpubReaderClippingListActivity distinct;book.distinctToc=true;distinct.book=&book;
+ CLIPPINGS.clips={{2,"Repeated"},{3,"Repeated"}};++CLIPPINGS.revision;
+ distinct.rebuildGroups();assert(distinct.chapterGroups.groups.size()==2);
+ HighlightChapterLabels normalized;
+ const auto normal=normalized.keyFor(7,"6 Stay on Point");
+ assert(normal==normalized.keyFor(7,"\t6 Stay\xE2\x80\xAFon Point  "));
+ assert(normal!=normalized.keyFor(8,"6 Stay on Point")); // no metadata: do not guess
+ std::cout<<"All 90 clipping IDs remain reachable across aliased chapter metadata and paging; failed previews, live updates and concurrent viewport changes passed\n";
+}
