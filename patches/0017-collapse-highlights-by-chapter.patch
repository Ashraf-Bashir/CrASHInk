+void EpubReaderClippingListActivity::turnListPage(const bool next) {
+  const ClippingListPaging paging{static_cast<int>(chapterGroups.rows.size()), visibleRows, listNav.top};
+  const int top = paging.destination(next);
+  if (top == listNav.top) return;
+  listNav.top = top;
+  listNav.selected = top;
+  listNav.follow(static_cast<int>(chapterGroups.rows.size()));
+  requestUpdate();
+}
