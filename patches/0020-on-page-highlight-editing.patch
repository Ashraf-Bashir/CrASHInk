diff --git a/src/activities/reader/HighlightToolbar.h b/src/activities/reader/HighlightToolbar.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/HighlightToolbar.h
@@ -0,0 +1,75 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <optional>
+
+namespace HighlightToolbar {
+enum class Action { Edit, Delete };
+// Add future actions here; layout, drawing iteration and hit testing share it.
+inline constexpr std::array Actions{Action::Edit, Action::Delete};
+constexpr int CellWidth = 56, CellHeight = 48;
+struct Bounds {
+  int x = 0, y = 0, width = 0, height = 0;
+  bool contains(int px, int py) const {
+    return width > 0 && height > 0 && px >= x && px < x + width && py >= y && py < y + height;
+  }
+};
+struct Layout {
+  Bounds area{};
+  size_t columns = 0, count = 0;
+  static Layout place(int x, int y, int screenWidth, size_t count = Actions.size()) {
+    if (!count) return {};
+    const size_t columns = std::min(count, static_cast<size_t>(std::max(1, screenWidth / CellWidth)));
+    return {
+        {x, y, static_cast<int>(columns) * CellWidth, static_cast<int>((count + columns - 1) / columns) * CellHeight},
+        columns,
+        count};
+  }
+  Bounds button(size_t index) const {
+    if (index >= count || !columns) return {};
+    return {area.x + static_cast<int>(index % columns) * CellWidth,
+            area.y + static_cast<int>(index / columns) * CellHeight, CellWidth, CellHeight};
+  }
+  std::optional<size_t> indexAt(int x, int y) const {
+    if (!columns || !area.contains(x, y)) return std::nullopt;
+    const size_t index = static_cast<size_t>((y - area.y) / CellHeight) * columns + (x - area.x) / CellWidth;
+    return index < count ? std::optional<size_t>{index} : std::nullopt;
+  }
+};
+inline bool overlaps(const Bounds& a, const Bounds& b, int pad = 0) {
+  return a.width > 0 && a.height > 0 && b.width > 0 && b.height > 0 && a.x < b.x + b.width + pad &&
+         a.x + a.width > b.x - pad && a.y < b.y + b.height + pad && a.y + a.height > b.y - pad;
+}
+inline Layout nearSelection(const Bounds& selection, const Bounds& view, const Bounds& first, const Bounds& last) {
+  Layout result = Layout::place(0, 0, view.width);
+  const int width = result.area.width, height = result.area.height;
+  const int right = std::max(view.x, view.x + view.width - width);
+  const int bottom = std::max(view.y, view.y + view.height - height);
+  const int x = std::clamp(selection.x, view.x, right);
+  const int middleY = std::clamp(selection.y + (selection.height - height) / 2, view.y, bottom);
+  const std::array<std::array<int, 2>, 8> candidates{{{x, selection.y - height - 44},
+                                                      {x, selection.y + selection.height + 44},
+                                                      {selection.x + selection.width + 8, middleY},
+                                                      {selection.x - width - 8, middleY},
+                                                      {view.x, view.y},
+                                                      {right, view.y},
+                                                      {view.x, bottom},
+                                                      {right, bottom}}};
+  for (const bool avoidText : {true, false}) {
+    for (const auto& point : candidates) {
+      result.area.x = point[0];
+      result.area.y = point[1];
+      if (result.area.x < view.x || result.area.y < view.y || result.area.x > right || result.area.y > bottom) continue;
+      if (overlaps(result.area, first, 18) || overlaps(result.area, last, 18)) continue;
+      if (avoidText && overlaps(result.area, selection)) continue;
+      return result;
+    }
+  }
+  // A selection covering the entire viewport has no empty outside area.
+  // Keep every toolbar control on screen even in that constrained case.
+  result.area.x = x;
+  result.area.y = std::clamp(selection.y - height - 44, view.y, bottom);
+  return result;
+}
+}  // namespace HighlightToolbar
