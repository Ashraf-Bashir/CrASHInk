+++ b/src/activities/reader/OnPageHighlightModel.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+// Inclusive chapter positions. Off-page ends stay untouched when the visible
+// end moves; crossing the other end clamps to one word rather than reversing.
+struct OnPageHighlightRange {
+  uint32_t start = 0, end = 0;
+  bool move(bool first, uint32_t wordStart, uint32_t wordEnd) {
+    if (wordStart > wordEnd || (first ? wordStart > end : wordEnd < start)) return false;
+    const auto oldStart = start, oldEnd = end;
+    if (first)
+      start = std::min(wordStart, end);
+    else
+      end = std::max(wordEnd, start);
+    return start != oldStart || end != oldEnd;
+  }
+};
diff --git a/src/activities/reader/TouchDragInput.h b/src/activities/reader/TouchDragInput.h
new file mode 100644
--- /dev/null
+++ b/src/activities/reader/TouchDragInput.h
@@ -0,0 +1,17 @@
+#pragma once
+// Main-task-only coalescing: retain the latest contact point and a release
+// while the render task owns the page. No input FIFO or heap allocation.
+struct TouchDragInput {
+  int x = 0, y = 0;
+  bool pointPending = false, released = false;
+  void record(bool held, int px, int py) {
+    if (released) return;
+    if (held) {
+      x = px;
+      y = py;
+      pointPending = true;
+    } else
+      released = true;
+  }
+  void reset() { pointPending = released = false; }
+};
diff --git a/src/clippings/HighlightDraftState.h b/src/clippings/HighlightDraftState.h
new file mode 100644
--- /dev/null
+++ b/src/clippings/HighlightDraftState.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// Keep only a baseline fingerprint: a long quote must not need another full
+// 60-KiB string just to detect reversals back to the original selection.
+class HighlightDraftState {
+  uint64_t originalHash = 0;
+  size_t originalBytes = 0;
+  static uint64_t fingerprint(const std::string& text) {
+    uint64_t value = 14695981039346656037ULL;
+    for (const unsigned char byte : text) value = (value ^ byte) * 1099511628211ULL;
+    return value;
+  }
+
+ public:
+  void reset(const std::string& text) {
+    originalBytes = text.size();
+    originalHash = fingerprint(text);
+  }
+  bool changed(const std::string& text) const {
+    return text.size() != originalBytes || fingerprint(text) != originalHash;
+  }
+};
