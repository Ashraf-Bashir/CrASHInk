@@ -0,0 +1,69 @@
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <climits>
+#include <iostream>
+#include "ChapterXPathResolver.h"
+#include "clippings/HighlightWordEdit.h"
+#include "clippings/HighlightDraftState.h"
+#include "activities/reader/OnPageHighlightModel.h"
+#include "activities/reader/HighlightTouchPolicy.h"
+constexpr size_t CLIPPING_TEXT_MAX=60*1024;
+class HighlightEditActivity {
+ public:
+  std::shared_ptr<Epub> book;
+  uint16_t spine=0;
+  float hint=-1;
+  bool editable=true,tableSelection=false,failed=false;
+  std::string draft,beforeContext,afterContext;
+  HighlightDraftState originalDraft;
+  XPathTextLocation location{};
+  std::atomic<bool> changed{false};
+  int previewPage=0;
+  std::array<HighlightWordEdit::Action,32> queuedActions{};
+  std::atomic<unsigned> actionRead{0},actionWrite{0};
+  void requestUpdate() {}
+  void refreshContext();
+  void adjust(HighlightWordEdit::Action);
+  void applyAdjustment(HighlightWordEdit::Action);
+  void applyQueuedActions();
+};
+#include "BoundaryActions.inc"
+int main() {
+ using A=HighlightWordEdit::Action;
+ HighlightEditActivity editor;
+ editor.book=std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>before alpha bravo café after tail</p></body></html>"});
+ editor.draft="alpha bravo";
+ assert(ChapterXPathResolver::locateText(editor.book,0,editor.draft,-1,editor.location));
+ const auto original=editor.location;
+ editor.originalDraft.reset(editor.draft);
+ editor.refreshContext();
+ const auto reads=editor.book->streamReads;
+ // Four clicks are accepted while a panel refresh is in flight, then applied
+ // in order with no chapter reparse for these cached neighbouring words.
+ editor.adjust(A::ExtendEnd);editor.adjust(A::ExtendEnd);editor.adjust(A::TrimEnd);editor.adjust(A::TrimEnd);
+ assert(editor.draft=="alpha bravo");
+ editor.applyQueuedActions();
+ assert(editor.draft=="alpha bravo" && !editor.changed && !editor.failed);
+ assert(editor.location.start==original.start && editor.location.end==original.end);
+ assert(editor.book->streamReads==reads);
+ for(auto a:{A::ExtendStart,A::TrimStart,A::TrimEnd,A::ExtendEnd}) editor.adjust(a);
+ editor.applyQueuedActions();
+ assert(editor.draft=="alpha bravo" && !editor.changed);
+ assert(editor.book->streamReads==reads);
+ editor.adjust(A::TrimStart);editor.applyQueuedActions();
+ assert(editor.draft=="bravo" && editor.changed);
+ editor.adjust(A::TrimStart);editor.applyQueuedActions();
+ assert(editor.failed && editor.draft=="bravo");
+ editor.adjust(A::ExtendStart);editor.applyQueuedActions();
+ assert(!editor.failed && editor.draft=="alpha bravo" && !editor.changed);
+ assert(ChapterXPathResolver::strictTextLength(" a\xc2\xad b \xef\xac\x83 ")==5);
+ // Moving an end on the visible page retains the other, off-page boundary.
+ OnPageHighlightRange range{10,900};
+ assert(range.move(true,120,125) && range.start==120 && range.end==900);
+ assert(range.move(false,800,805) && range.start==120 && range.end==805);
+ assert(!range.move(true,900,905));
+ assert(!range.move(false,10,15));
+ std::cout<<"Queued boundary edits, zero-read cached clicks, reversals, Unicode and off-page preservation passed\n";
+}
