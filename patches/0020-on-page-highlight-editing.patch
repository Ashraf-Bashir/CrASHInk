+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <utility>
+#define LOG_ERR(...) \
+  do {               \
+  } while (0)
+namespace HighlightWordEdit {
+enum class Action { ExtendStart, TrimStart, TrimEnd, ExtendEnd };
+}
+struct Rect {
+  int x, y, width, height;
+};
+struct Renderer {};
+struct Clipping {
+  uint16_t spineIndex = 2, startPage = 7, pageCount = 30, paragraphIndex = 12;
+};
+struct Store {
+  Clipping clip;
+  bool saveOk = true, deleteOk = true;
+  unsigned saves = 0, deletes = 0;
+  bool updateClippingText(size_t, const std::string&) {
+    ++saves;
+    return saveOk;
+  }
+  bool removeClippingAt(size_t) {
+    ++deletes;
+    return deleteOk;
+  }
+  const Clipping* clippingAt(size_t) const { return &clip; }
+} CLIPPINGS;
+struct ClippingJumpResult {
+  uint16_t spineIndex, page, pageCount, paragraphIndex, clippingIndex;
+};
+struct ActivityResult {
+  bool isCancelled = false;
+};
+struct Input {
+  enum class Button { Back, Confirm };
+  enum class SwipeDir { None, Up, Down };
+  bool back = false, confirm = false;
+  int tap = -1;
+  SwipeDir swipe = SwipeDir::None;
+  bool wasReleased(Button b) const { return b == Button::Back ? back : confirm; }
+  SwipeDir wasSwipe() const { return swipe; }
+  bool wasTapInRect(int x, int, int, int) const { return tap == x; }
+};
+using MappedInputManager = Input;
+struct TouchHeaderBackButton {
+  static bool wasTapped(const Input&, const Renderer&) { return false; }
+};
+struct RenderLock {
+  template <typename T>
+  explicit RenderLock(T&) {}
+};
+class HighlightEditActivity {
+ public:
+  Input mappedInput;
+  Renderer renderer;
+  size_t index = 4;
+  std::string draft = "edited quote";
+  bool changed = false, failed = false, finished = false, cancelled = false, opened = false;
+  int previewPage = 0, previewPages = 3, updates = 0;
+  ClippingJumpResult jump{};
+  void finish() { finished = true; }
+  void requestUpdate() { ++updates; }
+  void setResult(ActivityResult result) { cancelled = result.isCancelled; }
+  void setResult(ClippingJumpResult result) {
+    jump = result;
+    opened = true;
+  }
+  Rect closeRect() const { return {7, 0, 1, 1}; }
+  Rect buttonRect(int i) const { return {i, 0, 1, 1}; }
+  void adjust(HighlightWordEdit::Action) {}
+  void applyQueuedActions() {}
+  void accept();
+  void cancel();
+  void openSavedClipping();
+  void loop();
+};
+#include "EditorActions.inc"
+int main() {
+  HighlightEditActivity unchanged;
+  unchanged.mappedInput.tap = 4;
+  unchanged.loop();
+  assert(!unchanged.finished && CLIPPINGS.saves == 0);
+  unchanged.mappedInput.tap = -1;
+  unchanged.mappedInput.confirm = true;
+  unchanged.loop();
+  assert(!unchanged.finished && CLIPPINGS.saves == 0);
+  HighlightEditActivity save;
+  save.changed = true;
+  save.mappedInput.tap = 4;
+  save.loop();
+  assert(save.finished && CLIPPINGS.saves == 1);
+  CLIPPINGS.saveOk = false;
+  HighlightEditActivity failed;
+  failed.changed = true;
+  failed.mappedInput.tap = 4;
+  failed.loop();
+  assert(!failed.finished && failed.failed && CLIPPINGS.saves == 2);
+  CLIPPINGS.saveOk = true;
+  // Open is navigation to the saved clipping, not an implicit draft save.
+  HighlightEditActivity open;
+  open.changed = true;
+  open.mappedInput.tap = 5;
+  open.loop();
+  assert(open.finished && open.opened && CLIPPINGS.saves == 2);
+  assert(open.jump.spineIndex == 2 && open.jump.page == 7 && open.jump.pageCount == 30 && open.jump.clippingIndex == 4);
+  HighlightEditActivity remove;
+  remove.mappedInput.tap = 6;
+  remove.loop();
+  assert(remove.finished && CLIPPINGS.deletes == 1);  // no extra confirmation
+  CLIPPINGS.deleteOk = false;
+  HighlightEditActivity failedDelete;
+  failedDelete.mappedInput.tap = 6;
+  failedDelete.loop();
+  assert(!failedDelete.finished && failedDelete.failed);
+  HighlightEditActivity cancel;
+  cancel.changed = true;
+  cancel.mappedInput.tap = 7;
+  cancel.loop();
+  assert(cancel.finished && cancel.cancelled && CLIPPINGS.saves == 2);
+  HighlightEditActivity pages;
+  pages.mappedInput.swipe = Input::SwipeDir::Up;
+  pages.loop();
+  assert(pages.previewPage == 1);
+  pages.loop();
+  pages.loop();
+  assert(pages.previewPage == 2);
+  pages.mappedInput.swipe = Input::SwipeDir::Down;
+  pages.loop();
+  assert(pages.previewPage == 1);
+  std::cout << "Save/Open/Delete/Cancel routing, disabled Save, immediate Delete and long-quote paging passed\n";
+}
