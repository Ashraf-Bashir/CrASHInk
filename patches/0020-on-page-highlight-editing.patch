+uint32_t ChapterXPathResolver::strictTextLength(const std::string& text) {
+  const auto* ptr = reinterpret_cast<const unsigned char*>(text.c_str());
+  const auto* end = ptr + text.size();
+  uint32_t length = 0;
+  uint32_t folded[3];
+  while (ptr < end) length += foldChar(utf8NextCodepoint(&ptr), MatchMode::Strict, folded);
+  return length;
+}
