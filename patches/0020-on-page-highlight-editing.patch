+void EpubReaderActivity::showOnPageHighlight(const size_t clippingIndex) {
+  std::unique_ptr<Page> page;
+  ReaderViewportLayout layout{};
+  float hint = -1.0f;
+  {
+    RenderLock lock(*this);
+    if (!section || !epub) return;
+    page = section->loadPageFromSectionFile();
+    layout = computeReaderViewportLayout(renderer, automaticPageTurnActive);
+    hint = section->pageCount > 1 ? static_cast<float>(section->currentPage) / (section->pageCount - 1) : -1.0f;
+  }
+  if (!page) return;
+  // One modal page and <=28 KiB geometry, owned only during adjustment. The
+  // object itself is small; allocation must remain fallible on C3 devices.
+  auto editor = makeUniqueNoThrow<OnPageHighlightActivity>(renderer, mappedInput, epub, std::move(page),
+      clippingIndex, layout.marginLeft, layout.marginTop, hint);
+  if (!editor) { LOG_ERR("CLIP", "Cannot allocate on-page highlight editor"); return; }
+  pauseReadingPaceTimer("highlight_handles");
+  startActivityForResult(std::move(editor), [this](const ActivityResult& result) {
+    if (const auto* action = std::get_if<HighlightPageAction>(&result.data)) {
+      if (action->editor) { showClippingEditor(action->clippingIndex); return; }
+      openWordSelect(false, action->x, action->y, true);
+      return;
+    }
+    resumeReadingPaceTimer("highlight_handles_return");
+    requestUpdate();
+  });
+}
