+struct Rect { int x=0,y=0,width=0,height=0; };
+bool contains(const Rect& r,int x,int y,int pad=0) {
+ return r.width>0&&r.height>0&&x>=r.x-pad&&x<r.x+r.width+pad&&y>=r.y-pad&&y<r.y+r.height+pad;
+}
+struct Input {
+ enum class Button { Back };
+ int x=0,y=0;bool down=false,held=false,tap=false,back=false;unsigned long duration=0;
+ bool isScreenTouchHeld(int& a,int& b) const {a=x;b=y;return held;}
+ bool wasScreenTouchDown(int& a,int& b) const {a=x;b=y;return down;}
+ bool wasScreenTapped(int& a,int& b) const {a=x;b=y;return tap;}
+ bool isScreenTouchTapCandidate(int& a,int& b,unsigned long& d) const {a=x;b=y;d=duration;return held;}
+ bool wasReleased(Button) const {return back;}
+};
+using MappedInputManager=Input;
+struct RenderLock {
+ static inline bool busy=false;
+ template<class T> explicit RenderLock(T&) {}
+ static bool peek() {return busy;}
+};
+struct HighlightPageAction {bool editor;uint16_t clippingIndex;int x,y;};
+struct Store {
+ unsigned writes=0;bool ok=true;std::string text;
+ bool updateClippingText(size_t,const std::string& value) {++writes;if(ok)text=value;return ok;}
+} CLIPPINGS;
+class OnPageHighlightActivity {
+ public:
+ struct Word {Rect rect;uint32_t start,end;};
+ std::shared_ptr<Epub> book=std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>before alpha bravo after tail</p></body></html>"});
+ Word words[5]={{{0,0,40,20},0,5},{{50,0,40,20},6,10},{{100,0,40,20},11,15},{{150,0,40,20},16,20},{{200,0,40,20},21,24}};
+ size_t wordCount=5,index=3;uint16_t spine=0;
+ XPathTextLocation original{6,15,25,false};
+ OnPageHighlightRange range{6,15},saved{6,15};
+ Rect firstHandle{40,0,20,20},lastHandle{130,0,20,20},editButton{200,100,100,40};
+ bool ready=true,failed=false,releasePending=false,ignoreOpeningRelease=false,finished=false;
+ int activeEdge=-1,updates=0;
+ std::atomic<bool> dragging{false};std::atomic<int> dragX{0},dragY{0};
+ Input mappedInput;
+ HighlightPageAction action{};
+ void requestUpdate() {++updates;}
+ void finish() {finished=true;}
+ void setResult(HighlightPageAction a) {action=a;}
+ void returnAction(bool,int=0,int=0);
+ void updateDrag();void saveRange();void loop();
+};
+#include "OnPageActions.inc"
+int main() {
+ OnPageHighlightActivity a;
+ a.mappedInput={50,10,true,true,false,false,0};a.loop();
+ assert(a.dragging && a.activeEdge==0 && CLIPPINGS.writes==0);
+ a.mappedInput={10,10,false,true,false,false,0};a.loop();a.updateDrag();
+ assert(a.range.start==0 && a.range.end==15 && CLIPPINGS.writes==0);
+ // Release is retained while a panel refresh owns the render lock.
+ RenderLock::busy=true;a.mappedInput.held=false;a.loop();
+ assert(a.releasePending && CLIPPINGS.writes==0);
+ RenderLock::busy=false;a.loop();
+ assert(!a.dragging && CLIPPINGS.writes==1 && CLIPPINGS.text=="before alpha bravo");
+ assert(a.saved.start==0 && a.saved.end==15);
+ OnPageHighlightActivity shortQuote;
+ shortQuote.firstHandle={40,0,20,20};shortQuote.lastHandle={65,0,20,20};
+ shortQuote.mappedInput={70,10,true,true,false,false,0};shortQuote.loop();
+ assert(shortQuote.dragging && shortQuote.activeEdge==1);
+ OnPageHighlightActivity edit;
+ edit.mappedInput={220,115,false,false,true,false,0};edit.loop();
+ assert(edit.finished && edit.action.editor && edit.action.clippingIndex==3);
+ OnPageHighlightActivity dictionary;
+ dictionary.mappedInput={100,10,false,true,false,false,600};dictionary.loop();
+ assert(dictionary.finished && !dictionary.action.editor && dictionary.action.x==100);
+ OnPageHighlightActivity outside;
+ outside.mappedInput={300,300,false,false,true,false,0};outside.loop();assert(outside.finished);
+ OnPageHighlightActivity failure;
+ failure.range.start=0;CLIPPINGS.ok=false;failure.saveRange();
+ assert(failure.failed && failure.range.start==6 && failure.saved.start==6);
+ std::cout<<"Actual on-page handlers: live drag, one release write, delayed release, Edit, dictionary and failure rollback passed\n";
+}
