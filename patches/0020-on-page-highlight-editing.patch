+ assert(!future.indexAt(104,150)); // empty final grid cell
+ assert(!HighlightToolbar::Layout{}.indexAt(0,0));
+
+ const HighlightToolbar::Bounds view{16,24,448,752};
+ const auto top=HighlightToolbar::nearSelection({400,30,60,20},view,{},{});
+ assert(top.area.y>=50 && top.area.x+top.area.width<=464);
+ const auto bottom=HighlightToolbar::nearSelection({20,740,100,20},view,{},{});
+ assert(bottom.area.y+bottom.area.height<740 && bottom.area.y>=24);
+ for(int y:{24,50,350,740,760}) for(int x:{16,200,450}) {
+   auto card=HighlightToolbar::nearSelection({x,y,80,20},view,{},{}).area;
+   assert(card.x>=view.x && card.y>=view.y && card.x+card.width<=view.x+view.width && card.y+card.height<=view.y+view.height);
+ }
+ const auto full=HighlightToolbar::nearSelection(view,view,{},{}).area;
+ assert(full.x>=view.x && full.y>=view.y && full.x+full.width<=464 && full.y+full.height<=776);
+ OnPageHighlightActivity a;
+ a.mappedInput={50,10,true,true,false,false,0};a.loop();
+ assert(a.dragging && a.activeEdge==0 && CLIPPINGS.writes==0);
+ a.mappedInput={10,10,false,true,false,false,0};a.loop();a.updateDrag();
+ assert(a.range.start==0 && a.range.end==15 && CLIPPINGS.writes==0);
+ // Release is retained while a panel refresh owns the render lock.
+ RenderLock::busy=true;a.mappedInput.held=false;a.loop();
+ assert(a.releasePending && CLIPPINGS.writes==0);
+ RenderLock::busy=false;a.loop();
+ assert(!a.dragging && CLIPPINGS.writes==1 && CLIPPINGS.text=="before alpha bravo");
+ assert(a.saved.start==0 && a.saved.end==15);
+ OnPageHighlightActivity shortQuote;
+ shortQuote.firstHandle={40,0,20,20};shortQuote.lastHandle={65,0,20,20};
+ shortQuote.mappedInput={70,10,true,true,false,false,0};shortQuote.loop();
+ assert(shortQuote.dragging && shortQuote.activeEdge==1);
+ OnPageHighlightActivity stem;
+ for(auto& word:stem.words) word.rect.y=100;
+ stem.firstHandle={40,70,20,20};stem.firstAnchorY=110;
+ stem.mappedInput={50,80,true,true,false,false,0};stem.loop();
+ assert(stem.dragging && stem.dragOffsetY==30);
+ stem.updateDrag();assert(stem.range.start==6 && stem.range.end==15);
+ stem.dragX=300;stem.dragY=300;stem.updateDrag();
+ assert(stem.range.start==6 && stem.range.end==15); // margins cannot grow the quote
+ OnPageHighlightActivity edit;
+ edit.mappedInput={220,115,false,false,true,false,0};edit.loop();
+ assert(edit.finished && edit.action.editor && edit.action.clippingIndex==3);
+ OnPageHighlightActivity remove;
+ remove.mappedInput={280,115,false,false,true,false,0};remove.loop();
+ assert(remove.finished && CLIPPINGS.deletes==1 && !remove.action.editor);
+ OnPageHighlightActivity failedDelete;
+ CLIPPINGS.ok=false;
+ failedDelete.mappedInput={280,115,false,false,true,false,0};failedDelete.loop();
+ assert(!failedDelete.finished && failedDelete.failed && CLIPPINGS.deletes==2);
+ CLIPPINGS.ok=true;
+ OnPageHighlightActivity holdButton;
+ holdButton.mappedInput={280,115,false,true,false,false,1000};holdButton.loop();
+ assert(!holdButton.finished && CLIPPINGS.deletes==2);
+ OnPageHighlightActivity dictionary;
+ dictionary.mappedInput={100,10,false,true,false,false,600};dictionary.loop();
+ assert(dictionary.finished && !dictionary.action.editor && dictionary.action.x==100);
+ OnPageHighlightActivity outside;
+ outside.mappedInput={300,300,false,false,true,false,0};outside.loop();assert(outside.finished);
+ OnPageHighlightActivity failure;
+ failure.range.start=0;CLIPPINGS.ok=false;failure.saveRange();
+ assert(failure.failed && failure.range.start==6 && failure.saved.start==6);
+ std::cout<<"Actual on-page handlers: live drag, one release write, delayed release, Edit, dictionary and failure rollback passed\n";
+}
