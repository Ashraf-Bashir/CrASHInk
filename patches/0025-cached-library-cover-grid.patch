+    // task stack. Shared by all following lookups and released by close().
+    folderCheckpoints = makeUniqueNoThrow<uint32_t[]>(FOLDER_CHECKPOINT_COUNT);
+    if (!folderCheckpoints) {
+      LOG_ERR("LIBIDX", "Cannot allocate folder lookup cache");
+      return false;
+    }
+  }
+  if (folderStride == 0) {
+    uint16_t candidateStride = 0;
+    if (!buildFolderCheckpoints(folderCheckpoints.get(), candidateStride)) return false;
+    folderStride = candidateStride;
+  }
+  return readPath(record, out, folderCheckpoints.get(), folderStride);
 }

 bool LibraryIndexFile::buildFolderCheckpoints(uint32_t* offsets, uint16_t& stride) {
