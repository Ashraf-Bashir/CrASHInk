+import pathlib, re, sys
+source = (pathlib.Path(sys.argv[1]) / 'src/activities/library/LibrarySettingsActivity.cpp').read_text()
+def block(signature):
+    start = source.index(signature)
+    end = source.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+enum = block('enum SettingsRow') + ';'
+methods = '\n\n'.join(block(s) for s in ['bool rowEnabled(', 'void LibrarySettingsActivity::toggle(', 'void LibrarySettingsActivity::provideRow('])
+keys = sorted(set(re.findall(r'STR_\w+', methods)))
+translations = 'enum class StrId { ' + ', '.join(keys) + ' };\n'
+translations += 'struct { const char* get(StrId id) const { static const char* labels[] = {' + ', '.join('"'+key+'"' for key in keys) + '}; return labels[static_cast<int>(id)]; } } I18N;\n'
+pathlib.Path(sys.argv[2]).write_text(translations + enum + '\n' + methods)
