diff --git a/lib/LibraryIndex/LibraryChangeProbe.h b/lib/LibraryIndex/LibraryChangeProbe.h
new file mode 100644
--- /dev/null
+++ b/lib/LibraryIndex/LibraryChangeProbe.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <HalStorage.h>
+#include <LibraryBuilder.h>
+#include <LibraryIndexFile.h>
+
+#include <cstdint>
+#include <string>
+
+namespace library {
+// A metadata-only check, paced by the activity after its first paint. Never
+// reads book contents, modifies the index, or opens a second index reader.
+class LibraryChangeProbe {
+ public:
+  enum class State : uint8_t { Idle, ReadingIndex, Walking, Unchanged, Changed, Unavailable };
+  ~LibraryChangeProbe() { reset(); }
+  void reset();
+  void begin(const LibraryIndexFile& index);
+  State step(LibraryIndexFile& index);
+
+ private:
+  struct Fingerprint {
+    uint64_t sum = 0;
+    uint64_t xored = 0;
+    uint32_t count = 0;
+    void add(uint64_t pathHash, uint32_t size, uint32_t modified);
+    bool operator==(const Fingerprint& other) const;
+  } expected, actual;
+  // Fixed ~2 KiB in the activity's owned object, never on a render-task stack.
+  // Only the current directory stays open; parents retain their resume offset.
+  struct Folder {
+    char path[256]{};
+    size_t position = 0;
+  } folders[LIBRARY_MAX_DEPTH + 1];
+  HalFile directory;
+  char name[512]{};
+  char fullPath[512]{};
+  // Reused extension-check scratch; bounded by the builder's 255-byte filename limit.
+  std::string nameText;
+  State state = State::Idle;
+  uint16_t indexRow = 0;
+  uint8_t depth = 0;
+  uint32_t entriesSeen = 0;
+  bool openFolder(bool resume);
+  State finish(State result);
+};
+}  // namespace library
diff --git a/lib/LibraryIndex/LibraryChangeProbe.cpp b/lib/LibraryIndex/LibraryChangeProbe.cpp
new file mode 100644
--- /dev/null
+++ b/lib/LibraryIndex/LibraryChangeProbe.cpp
@@ -0,0 +1,112 @@
+#include "LibraryChangeProbe.h"
+
+#include <FsHelpers.h>
+#include <LibraryFileTypes.h>
+#include <Logging.h>
+
+#include <cstdio>
+#include <cstring>
+
+namespace library {
+void LibraryChangeProbe::Fingerprint::add(uint64_t pathHash, const uint32_t size, const uint32_t modified) {
+  // Order independent: FAT enumeration order and index title order differ.
+  pathHash ^= (static_cast<uint64_t>(size) << 32) | modified;
+  pathHash ^= pathHash >> 30;
+  pathHash *= 0xbf58476d1ce4e5b9ULL;
+  pathHash ^= pathHash >> 27;
+  pathHash *= 0x94d049bb133111ebULL;
+  pathHash ^= pathHash >> 31;
+  sum += pathHash;
+  xored ^= pathHash;
+  ++count;
+}
+bool LibraryChangeProbe::Fingerprint::operator==(const Fingerprint& other) const {
+  return count == other.count && sum == other.sum && xored == other.xored;
+}
+void LibraryChangeProbe::reset() {
+  if (directory) directory.close();
+  expected = {};
+  actual = {};
+  state = State::Idle;
+  indexRow = depth = 0;
+  entriesSeen = 0;
+}
+void LibraryChangeProbe::begin(const LibraryIndexFile& index) {
+  reset();
+  // One setup allocation (at most 256 bytes), reused throughout the check.
+  nameText.reserve(255);
+  state = index.isOpen() ? State::ReadingIndex : State::Unavailable;
+}
+LibraryChangeProbe::State LibraryChangeProbe::finish(const State result) {
+  if (directory) directory.close();
+  state = result;
+  if (result == State::Unavailable) LOG_ERR("LIB", "Library change check could not complete");
+  return state;
+}
+bool LibraryChangeProbe::openFolder(const bool resume) {
+  directory = Storage.open(folders[depth].path);
+  if (!directory || !directory.isDirectory()) return false;
+  if (resume) return directory.seekSet(folders[depth].position);
+  directory.rewindDirectory();
+  folders[depth].position = 0;
+  return true;
+}
+LibraryChangeProbe::State LibraryChangeProbe::step(LibraryIndexFile& index) {
+  if (state == State::ReadingIndex) {
+    if (!index.isOpen()) return finish(State::Unavailable);
+    if (indexRow < index.bookCount()) {
+      ClixRecord record{};
+      uint64_t hash = 0;
+      if (!index.readRecord(indexRow++, record) || !index.readPathHash(record, hash)) return finish(State::Unavailable);
+      expected.add(hash, record.fileSize, record.modificationTime);
+      return state;
+    }
+    std::strcpy(folders[0].path, "/");
+    if (!openFolder(false)) return finish(State::Unavailable);
+    state = State::Walking;
+    return state;
+  }
+  if (state != State::Walking) return state;
+  HalFile entry = directory.openNextFile();
+  if (!entry) {
+    if (entry.allocationFailed() || FsHelpers::directoryIterationFailed(directory)) return finish(State::Unavailable);
+    directory.close();
+    if (depth == 0) return finish(expected == actual ? State::Unchanged : State::Changed);
+    --depth;
+    if (!openFolder(true)) return finish(State::Unavailable);
+    return state;
+  }
+  if (++entriesSeen > 100000) {
+    entry.close();
+    return finish(State::Unavailable);
+  }
+  name[0] = '\0';
+  const size_t nameLength = entry.getName(name, sizeof(name));
+  const bool isDirectory = entry.isDirectory();
+  const uint32_t size = isDirectory ? 0 : static_cast<uint32_t>(entry.fileSize());
+  const uint32_t modified = isDirectory ? 0 : entry.modificationTime();
+  entry.close();
+  if (!name[0] || name[0] == '.') return state;
+  // Match the builder's name/path limits, depth, hidden-file and zero-size rules.
+  if (nameLength > 255 || std::strlen(folders[depth].path) > 255) return state;
+  const int length =
+      std::snprintf(fullPath, sizeof(fullPath), "%s%s%s", folders[depth].path, depth == 0 ? "" : "/", name);
+  if (length < 0 || static_cast<size_t>(length) >= sizeof(fullPath)) return finish(State::Unavailable);
+  if (isDirectory) {
+    if (depth == LIBRARY_MAX_DEPTH || length > 255) return state;
+    folders[depth].position = directory.position();
+    directory.close();
+    ++depth;
+    std::memcpy(folders[depth].path, fullPath, static_cast<size_t>(length) + 1);
+    if (!openFolder(false)) return finish(State::Unavailable);
+    return state;
+  }
+  if (size == 0) return state;
+  nameText.assign(name, nameLength);
+  if (fileTypeFor(nameText) == 0) return state;
+  actual.add(clixPathHash(fullPath, static_cast<size_t>(length)), size, modified);
+  // More current books than indexed books already proves a change.
+  if (actual.count > expected.count) return finish(State::Changed);
+  return state;
+}
+}  // namespace library
