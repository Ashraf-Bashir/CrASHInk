@@ -0,0 +1,16 @@
+import pathlib, sys
+root = pathlib.Path(sys.argv[1])
+source = (root / 'src/activities/library/LibraryActivity.cpp').read_text()
+def method(signature):
+    start = source.index(signature)
+    brace = source.index('{', start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+pathlib.Path(sys.argv[2]).write_text('\n\n'.join(method(s) for s in [
+    'int gridColumns(', 'int gridPageSize(', 'std::string gridThumbPath(', 'bool LibraryActivity::gridEnabled(',
+    'void LibraryActivity::loadGridPageCovers(', 'bool LibraryActivity::loadGridCover(',
+    'void LibraryActivity::refreshIndexIfNeeded(']))
