+}
+TEST(LibraryDisplaySettings, DimmedControlsCannotChangePreferencesThroughTouchOrButtons) {
+  SETTINGS = {};
+  LibrarySettingsActivity screen;
+  fui::ListItem density;
+  screen.provideRow(nullptr, CoversPerRow, density);
+  EXPECT_FALSE(density.enabled);
+  screen.toggle(CoversPerRow);
+  EXPECT_EQ(SETTINGS.libraryGridDensity, 0);
+  EXPECT_EQ(SETTINGS.saves, 0);
+  screen.toggle(RecentView);
+  density = {};
+  screen.provideRow(nullptr, CoversPerRow, density);
+  EXPECT_TRUE(density.enabled);
+  screen.toggle(CoversPerRow);
+  EXPECT_EQ(SETTINGS.libraryGridDensity, 1);
+  screen.toggle(LibraryView);
+  fui::ListItem grouping;
+  screen.provideRow(nullptr, ListGrouping, grouping);
+  EXPECT_FALSE(grouping.enabled);
+  screen.toggle(ListGrouping);
+  EXPECT_EQ(SETTINGS.libraryListExpanded, 1);
+}
