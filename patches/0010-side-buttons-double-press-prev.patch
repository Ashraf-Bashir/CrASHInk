@@ -218,10 +218,36 @@ inline PageTurnResult detectPageTurn(const MappedInputManager& input) {
 
   const bool tiltNext = SETTINGS.tiltPageTurn && halTiltSensor.wasTiltedForward();
   const bool tiltPrev = SETTINGS.tiltPageTurn && halTiltSensor.wasTiltedBack();
-  const bool sidePrev = sideUsePress ? input.wasPressed(MappedInputManager::Button::PageBack)
-                                     : input.wasReleased(MappedInputManager::Button::PageBack);
-  const bool sideNext = sideUsePress ? input.wasPressed(MappedInputManager::Button::PageForward)
-                                     : input.wasReleased(MappedInputManager::Button::PageForward);
+  bool sidePrev = sideUsePress ? input.wasPressed(MappedInputManager::Button::PageBack)
+                               : input.wasReleased(MappedInputManager::Button::PageBack);
+  bool sideNext = sideUsePress ? input.wasPressed(MappedInputManager::Button::PageForward)
+                               : input.wasReleased(MappedInputManager::Button::PageForward);
+
+  if (SETTINGS.sideButtonLayout == CrossPointSettings::NEXT_NEXT_DOUBLE_PREV) {
+    // Next/Next with a double press for Previous, same idea as the X4 Pro home
+    // key's double tap: a single press has to wait out the double-press window
+    // before it is allowed to turn the page forward.
+    constexpr unsigned long DOUBLE_PRESS_MS = 300;
+    constexpr unsigned long STALE_PRESS_MS = 1500;  // reader was left mid-window: drop, don't fire late
+    static bool pendingPress = false;
+    static unsigned long pendingPressAt = 0;
+    const unsigned long now = millis();
+    const bool newPress = sideNext;
+    sideNext = false;
+    if (pendingPress && now - pendingPressAt > DOUBLE_PRESS_MS) {
+      pendingPress = false;
+      sideNext = now - pendingPressAt <= STALE_PRESS_MS;
+    }
+    if (newPress) {
+      if (pendingPress) {
+        pendingPress = false;
+        sidePrev = true;
+      } else {
+        pendingPress = true;
+        pendingPressAt = now;
+      }
+    }
+  }
 
   const bool frontPrev = input.wasReleased(MappedInputManager::Button::Left);
   const bool powerReleased = input.wasReleased(MappedInputManager::Button::Power);
