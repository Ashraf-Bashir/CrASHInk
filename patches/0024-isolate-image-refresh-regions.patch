 ## [Unreleased]

 ### Fixed
+
+- Image refresh blanks each image separately, keeping text between inline images visible while images are prepared for display. Pending images use an empty background instead of a temporary box border.

 - Saved highlight handles can extend or shorten across adjacent pages in the same chapter; edge dragging loads the actual page and saves once on release.

diff --git a/test/image_refresh_regions/ImageRefreshRegionsTest.cpp b/test/image_refresh_regions/ImageRefreshRegionsTest.cpp
new file mode 100644
--- /dev/null
+++ b/test/image_refresh_regions/ImageRefreshRegionsTest.cpp
@@ -0,0 +1,76 @@
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <vector>
+constexpr int TAG_PageLine=1,TAG_PageImage=2;
+struct Block {int16_t width,height;int16_t getWidth()const{return width;}int16_t getHeight()const{return height;}};
+struct Element {int16_t xPos=0,yPos=0;virtual ~Element()=default;virtual int getTag()const{return TAG_PageLine;}};
+struct PageImage:Element {
+ Block block;
+ PageImage(int x,int y,int w,int h):block{int16_t(w),int16_t(h)}{xPos=x;yPos=y;}
+ int getTag()const override{return TAG_PageImage;}
+ const Block& getImageBlock()const{return block;}
+};
+struct Page {
+ std::vector<std::unique_ptr<Element>>elements;
+ #include "ImageRects.inc"
+ int imageArea()const{int area=0;forEachImageRect([&](int,int,int w,int h){area+=w*h;});return area;}
+};
+namespace HalDisplay {enum {FAST_REFRESH=1,HALF_REFRESH=2};}
+struct Renderer {
+ bool direct=false;int width=100,height=160;
+ std::vector<uint8_t>pixels=std::vector<uint8_t>(width*height);
+ std::vector<std::vector<uint8_t>>frames;
+ std::vector<int>modes;
+ bool shouldSkipImageBlanking()const{return direct;}
+ int getScreenWidth()const{return width;}int getScreenHeight()const{return height;}
+ void fillRect(int x,int y,int w,int h,bool state){
+  for(int py=std::max(0,y);py<std::min(height,y+h);++py)
+   for(int px=std::max(0,x);px<std::min(width,x+w);++px)pixels[py*width+px]=state;
+ }
+ void displayBuffer(int mode){frames.push_back(pixels);modes.push_back(mode);}
+ void displayGrayscaleBase(int mode){displayBuffer(mode);}
+};
+struct Reader {
+ Renderer renderer;std::unique_ptr<Page>page=std::make_unique<Page>();
+ bool pageHasImages=true,deferImageLoading=false,cleanImageBasePending=false;
+ int pagesUntilFullRefresh=3,orientedMarginLeft=3,orientedMarginTop=5,compositions=0;
+ std::vector<uint8_t>composed;
+ void composePageBuffer(){++compositions;renderer.pixels=composed;}
+ int manualScreenRefreshMode(){return HalDisplay::HALF_REFRESH;}
+ void renderImageBase();
+};
+#include "ImageRefresh.inc"
+int main(){
+ for(bool direct:{false,true})for(bool cleanup:{false,true}){
+  Reader reader;reader.renderer.direct=direct;reader.cleanImageBasePending=cleanup;
+  reader.page->elements.push_back(std::make_unique<PageImage>(8,10,8,8));
+  reader.page->elements.push_back(std::make_unique<Element>()); // text is not an image region
+  reader.page->elements.push_back(std::make_unique<PageImage>(11,100,8,8));
+  reader.page->elements.push_back(std::make_unique<PageImage>(50,80,0,8));
+  for(size_t i=0;i<reader.renderer.pixels.size();++i)reader.renderer.pixels[i]=(i%3!=0);
+  reader.composed=reader.renderer.pixels;
+  reader.renderImageBase();
+  assert(reader.renderer.pixels==reader.composed);
+  assert(reader.compositions==int(!direct||cleanup));
+  assert(reader.pagesUntilFullRefresh==3&&!reader.cleanImageBasePending);
+  for(const auto& frame:reader.renderer.frames)for(int y=0;y<160;++y)for(int x=0;x<100;++x){
+   const bool image1=x>=11&&x<19&&y>=15&&y<23;
+   const bool image2=x>=14&&x<22&&y>=105&&y<113;
+   if(!image1&&!image2)assert(frame[y*100+x]==reader.composed[y*100+x]);
+  }
+  assert(reader.renderer.frames.back()==reader.composed);
+ }
+ Reader clipped;
+ clipped.page->elements.push_back(std::make_unique<PageImage>(-10,-10,12,12));
+ clipped.page->elements.push_back(std::make_unique<PageImage>(96,156,20,20));
+ clipped.composed=clipped.renderer.pixels;clipped.renderImageBase();
+ assert(clipped.compositions==1);
+ Reader large;large.page->elements.push_back(std::make_unique<PageImage>(0,0,80,100));
+ large.composed=large.renderer.pixels;large.renderImageBase();assert(large.pagesUntilFullRefresh==1);
+ Page empty;empty.elements.push_back(std::make_unique<Element>());
+ int count=0;assert(!empty.forEachImageRect([&](int,int,int,int){++count;}));assert(count==0);
+ std::cout<<"Separate image regions preserve every intervening text pixel in all base/cleanup modes\n";
+}
