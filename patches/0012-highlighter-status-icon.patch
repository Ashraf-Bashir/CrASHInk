+void BaseTheme::drawHighlightIndicator(const GfxRenderer& renderer, int topY, bool darkMode) const {
+  if (!gpio.hasTouch() || SETTINGS.disableReaderTouchscreen) {
+    return;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int iconY = baseTopY + (statusBarHeight - touchStatusIconSize) / 2;
+  const int lampX = orientedMarginLeft + metrics.statusBarHorizontalMargin;
+  const int handX = lampX + frontlightStatusIconSize + statusIndicatorGap;
+  const int rX = handX + touchStatusIconSize + statusIndicatorGap + statusIndicatorVisualPad;
+  const int iconX = rX + touchStatusIconSize + statusIndicatorGap + statusIndicatorVisualPad;
+
+  // A highlighter pen laid over the stroke it just marked, drawn from shapes
+  // (not a packed bitmap) so it stays upright in every orientation.
+  const bool ink = !darkMode;
+  renderer.drawLine(iconX + 15, iconY + 2, iconX + 9, iconY + 8, 4, ink);  // barrel
+  const int nibX[3] = {iconX + 6, iconX + 11, iconX + 4};
+  const int nibY[3] = {iconY + 7, iconY + 11, iconY + 14};
+  renderer.fillPolygon(nibX, nibY, 3, ink);                                 // chisel tip
+  renderer.fillRect(iconX + 2, iconY + 17, 16, 2, ink);                     // the highlight stroke
+}
+
+bool BaseTheme::isHighlightIndicatorTap(const GfxRenderer& renderer, int topY, int touchX, int touchY) const {
+  if (!gpio.hasTouch() || SETTINGS.disableReaderTouchscreen) {
+    return false;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return false;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int lampX = orientedMarginLeft + metrics.statusBarHorizontalMargin;
+  const int handX = lampX + frontlightStatusIconSize + statusIndicatorGap;
+  const int rX = handX + touchStatusIconSize + statusIndicatorGap + statusIndicatorVisualPad;
+  const int iconX = rX + touchStatusIconSize + statusIndicatorGap + statusIndicatorVisualPad;
+
+  // Starts midway between the R box and this icon, runs generously past it. The
+  // reader checks this before the R and hand tests, so their wider zones never
+  // steal taps aimed here.
+  constexpr int tapPaddingRight = 24;
+  const int hitLeft = rX + touchStatusIconSize + (statusIndicatorGap + statusIndicatorVisualPad) / 2;
+  const int hitRight = iconX + touchStatusIconSize + tapPaddingRight;
+  return touchX >= hitLeft && touchX < hitRight && touchY >= baseTopY && touchY < baseTopY + statusBarHeight;
+}
