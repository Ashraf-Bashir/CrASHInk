--- /dev/null
+++ b/src/activities/reader/ClippingTextExpansion.h
@@ -0,0 +1,220 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include "clippings/ClippingPreview.h"
+
+// One explicitly requested quote (<=60 KiB), plus a sparse line index. Even a
+// one-byte-per-line pathological quote uses <=15 KiB of checkpoints, not a
+// second full text copy or an allocation per wrapped line.
+class ClippingTextExpansion {
+ public:
+  struct Row {
+    int base = 0;
+    size_t chunk = 0;
+  };
+  size_t clipping = std::numeric_limits<size_t>::max();
+  int baseRow = -1;
+  std::string text;
+  bool active() const { return baseRow >= 0 && lines_ > 0; }
+  size_t chunks() const { return active() ? (lines_ + 1) / 2 : 0; }
+  int count(int baseCount) const { return baseCount + (active() ? static_cast<int>(chunks()) - 1 : 0); }
+  Row row(int displayed) const {
+    if (!active() || displayed < baseRow) return {displayed, 0};
+    if (displayed < baseRow + static_cast<int>(chunks())) return {baseRow, static_cast<size_t>(displayed - baseRow)};
+    return {displayed - static_cast<int>(chunks()) + 1, 0};
+  }
+  void clear() {
+    clipping = std::numeric_limits<size_t>::max();
+    baseRow = -1;
+    lines_ = 0;
+    width_ = 0;
+    std::string().swap(text);
+    std::string().swap(scratch_);
+    std::vector<uint32_t>().swap(checkpoints_);
+  }
+  template <class Measure>
+  void open(size_t index, int row, int width, Measure measure) {
+    clipping = index;
+    baseRow = row;
+    // Normalize whitespace in place: no second full quote is retained.
+    size_t write = 0;
+    bool space = true;
+    for (size_t read = 0; read < text.size();) {
+      size_t skip = clippingPreview::utf8SpaceLength(text.data() + read, text.size() - read);
+      if (!skip && (text[read] == '\n' || text[read] == '\r' || text[read] == '\t')) skip = 1;
+      if (skip) {
+        if (!space) text[write++] = ' ';
+        space = true;
+        read += skip;
+      } else {
+        const char ch = text[read++];
+        text[write++] = ch;
+        space = ch == ' ';
+      }
+    }
+    if (write && text[write - 1] == ' ') --write;
+    text.resize(write);
+    width_ = 0;
+    layout(width, measure);
+  }
+  template <class Measure>
+  void layout(int width, Measure measure) {
+    width = std::max(1, width);
+    if (width == width_) return;
+    width_ = width;
+    lines_ = 0;
+    checkpoints_.clear();
+    checkpoints_.reserve(text.size() / 16 + 1);
+    scratch_.reserve(std::min<size_t>(8192, static_cast<size_t>(width) * 4 + 8));
+    size_t at = 0;
+    while (at < text.size()) {
+      if (lines_ % 16 == 0) checkpoints_.push_back(static_cast<uint32_t>(at));
+      next(at, measure);
+      ++lines_;
+    }
+  }
+  template <class Measure>
+  void chunk(size_t index, Measure measure, std::string& out) {
+    out.clear();
+    const size_t first = index * 2;
+    if (first >= lines_) return;
+    size_t at = checkpoints_[first / 16];
+    for (size_t line = first / 16 * 16; line < first; ++line) next(at, measure);
+    size_t begin = at, end = at;
+    for (unsigned part = 0; part < 2 && at < text.size(); ++part) {
+      const auto span = next(at, measure);
+      if (!part) begin = span.first;
+      end = span.second;
+    }
+    out.assign(text, begin, end - begin);
+  }
+
+ private:
+  int width_ = 0;
+  size_t lines_ = 0;
+  std::string scratch_;
+  std::vector<uint32_t> checkpoints_;
+  template <class Measure>
+  std::pair<size_t, size_t> next(size_t& at, Measure measure) {
+    while (at < text.size() && text[at] == ' ') ++at;
+    const size_t start = at;
+    size_t space = std::string::npos;
+    scratch_.clear();
+    while (at < text.size()) {
+      const unsigned char c = text[at];
+      size_t bytes = c < 0x80 ? 1 : c < 0xe0 ? 2 : c < 0xf0 ? 3 : 4;
+      bytes = std::min(bytes, text.size() - at);
+      if (scratch_.size() + bytes > std::min<size_t>(8192, static_cast<size_t>(width_) * 4 + 8) && at > start)
+        return {start, at};
+      scratch_.append(text, at, bytes);
+      if (measure(scratch_) > width_ && at > start) {
+        const size_t end = space != std::string::npos ? space : at;
+        at = space != std::string::npos ? space + 1 : at;
+        return {start, end};
+      }
+      if (c == ' ') space = at;
+      at += bytes;
+    }
+    return {start, at};
+  }
+};
+
+// Multiple expansion states, but only one full quote cached. Previously
+// requested quotes are read again only if they re-enter the visible window.
+class ClippingExpansionSet {
+ public:
+  struct Entry {
+    size_t clipping;
+    int base;
+    size_t chunks;
+  };
+  ClippingTextExpansion cache;
+  std::vector<Entry> entries;
+  bool active() const { return !entries.empty(); }
+  bool isOpen(int base) const { return find(base) != entries.end(); }
+  int count(int baseCount) const {
+    for (const auto& entry : entries) baseCount += static_cast<int>(entry.chunks) - 1;
+    return baseCount;
+  }
+  int displayForBase(int base) const {
+    int display = base;
+    for (const auto& entry : entries)
+      if (entry.base < base) display += static_cast<int>(entry.chunks) - 1;
+    return display;
+  }
+  ClippingTextExpansion::Row row(int display) const {
+    int extra = 0;
+    for (const auto& entry : entries) {
+      const int first = entry.base + extra;
+      if (display < first) return {display - extra, 0};
+      if (display < first + static_cast<int>(entry.chunks)) return {entry.base, static_cast<size_t>(display - first)};
+      extra += static_cast<int>(entry.chunks) - 1;
+    }
+    return {display - extra, 0};
+  }
+  void clear() {
+    entries.clear();
+    cache.clear();
+  }
+  bool close(int base) {
+    const auto it = find(base);
+    if (it == entries.end()) return false;
+    if (cache.clipping == it->clipping) cache.clear();
+    entries.erase(it);
+    return true;
+  }
+  void remember() {
+    if (!cache.active()) return;
+    if (entries.size() == entries.capacity()) entries.reserve(entries.size() + 4);
+    entries.push_back({cache.clipping, cache.baseRow, cache.chunks()});
+    std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.base < b.base; });
+  }
+  void rebase(const std::vector<int>& rows) {
+    for (auto it = entries.begin(); it != entries.end();) {
+      const auto row = std::find(rows.begin(), rows.end(), static_cast<int>(it->clipping));
+      if (row == rows.end()) {
+        if (cache.clipping == it->clipping) cache.clear();
+        it = entries.erase(it);
+      } else {
+        it->base = static_cast<int>(row - rows.begin());
+        if (cache.clipping == it->clipping) cache.baseRow = it->base;
+        ++it;
+      }
+    }
+    std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.base < b.base; });
+  }
+  template <class Measure>
+  void layout(int width, Measure measure) {
+    if (!cache.active()) return;
+    cache.layout(width, measure);
+    for (auto& entry : entries)
+      if (entry.clipping == cache.clipping) entry.chunks = cache.chunks();
+  }
+  template <class Measure, class Read>
+  bool chunk(int base, size_t part, int width, Measure measure, Read read, std::string& out) {
+    const auto it = find(base);
+    if (it == entries.end()) return false;
+    if (!cache.active() || cache.clipping != it->clipping) {
+      cache.clear();
+      if (!read(it->clipping, cache.text)) {
+        cache.clear();
+        return false;
+      }
+      cache.open(it->clipping, base, width, measure);
+    }
+    cache.chunk(part, measure, out);
+    return !out.empty();
+  }
+
+ private:
+  std::vector<Entry>::iterator find(int base) {
+    return std::find_if(entries.begin(), entries.end(), [base](const Entry& e) { return e.base == base; });
+  }
+  std::vector<Entry>::const_iterator find(int base) const {
+    return std::find_if(entries.begin(), entries.end(), [base](const Entry& e) { return e.base == base; });
+  }
+};
