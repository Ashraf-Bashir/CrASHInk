+void EpubReaderClippingListActivity::toggleExpansion(const int displayedRow) {
+  RenderLock lock(*this);
+  const int base = expansion.row(displayedRow).base;
+  if (base < 0 || base >= static_cast<int>(chapterGroups.rows.size()) || chapterGroups.header(base)) return;
+  const size_t clipping = static_cast<size_t>(chapterGroups.rows[base]);
+  const bool collapse = expansion.close(base);
+  if (!collapse) {
+    expansion.cache.clear();
+    if (CLIPPINGS.readClippingText(clipping, expansion.cache.text)) {
+      const auto measure = [this](const std::string& line) {
+        return uiTarget.measureText(expansionStyle.font, line.c_str(), expansionStyle).width;
+      };
+      expansion.cache.open(clipping, base, expansionTextWidth, measure);
+      expansion.remember();
+      const size_t slots =
+          std::min<size_t>(CLIPPING_WINDOW_SIZE,
+                           renderer.getScreenHeight() / std::max(48, 2 * uiTarget.lineHeight(expansionStyle.font)) + 1);
+      const size_t bytes = std::min(expansion.cache.text.size(), static_cast<size_t>(expansionTextWidth) * 8 + 16);
+      for (size_t i = 0; i < slots; ++i) uiLabels[i].reserve(bytes);
+    } else
+      expansion.cache.clear();
+  }
+  listNav.selected = expansion.displayForBase(base);
+  listNav.top = listNav.selected;
+  listNav.follow(displayedRowCount());
+  requestUpdate();
+}
