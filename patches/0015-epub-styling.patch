+TEST_F(CssArenaBackingTest, ContextualItalicRulesSurviveCacheReload) {
+  const std::string styles =
+      "span.term { font-style: normal; } "
+      "#chapter > p.body span.term.emphasis { font-style: italic; } "
+      "p.body > span.term#plain { font-style: normal; }";
+  Storage.put("input.css", {styles.begin(), styles.end()});
+  FsFile input;
+  ASSERT_TRUE(Storage.openFileForRead("test", "input.css", input));
+  CssParser source("book");
+  ASSERT_TRUE(source.loadFromStream(input));
+  input.close();
+  ASSERT_TRUE(source.saveToCache());
+
+  CssParser cached("book");
+  ASSERT_TRUE(cached.loadFromCache());
+  const std::vector<CssAncestorEntry> context{{0, "section", "", "chapter"}, {1, "p", "body"}};
+  const std::vector<CssAncestorEntry> wrongContext{
+      {0, "section", "", "chapter"}, {1, "div", ""}, {2, "p", "body"}};
+  for (const CssParser* css : {&source, &cached}) {
+    EXPECT_EQ(css->resolveStyle("span", "emphasis term", context).fontStyle, CssFontStyle::Italic);
+    EXPECT_EQ(css->resolveStyle("span", "term emphasis", wrongContext).fontStyle, CssFontStyle::Normal);
+    EXPECT_EQ(css->resolveStyle("span", "term", context).fontStyle, CssFontStyle::Normal);
+    EXPECT_EQ(css->resolveStyle("span", "term", context, "plain").fontStyle, CssFontStyle::Normal);
+  }
+}
