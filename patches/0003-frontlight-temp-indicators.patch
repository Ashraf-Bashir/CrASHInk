From: Ashraf Bashir <eng.bashir@gmail.com>
Date: Fri, 18 Sep 2026 15:30:00 +0200
Subject: [PATCH 3/3] Add frontlight warm/cold percentage indicators to status
 bar

Display frontlight warm and cold percentages next to the battery icon in
the status bar. Uses a sun icon for the warm percentage and a snowflake
icon for the cold percentage.

frontlightWarmth is already stored as 0 (cool) .. 100 (warm); the cold
reading shown is its complement (100 - warmth) rather than a separate
setting. Icons are drawn with drawLine/fillRect only, since GfxRenderer
has no circle primitive.

Wired into drawHeader() right after the existing battery draw call, so it
follows the same battery-left/battery-right layout the themes already use.

diff --git a/src/components/themes/BaseTheme.cpp b/src/components/themes/BaseTheme.cpp
index cf647f0..e8fe5f7 100644
--- a/src/components/themes/BaseTheme.cpp
+++ b/src/components/themes/BaseTheme.cpp
@@ -122,6 +122,81 @@ void BaseTheme::drawBatteryRight(const GfxRenderer& renderer, Rect rect, const b
   fillBatteryIcon(renderer, iconRect, percentage, foregroundBlack);
 }
 
+void BaseTheme::drawSunIcon(const GfxRenderer& renderer, int x, int y, int size, bool foregroundBlack) const {
+  // Small sun: filled square core with four cardinal rays. No drawCircle
+  // primitive exists in GfxRenderer, so the core is a square rather than
+  // a disc - at this pixel size (6-7px) the two are visually equivalent.
+  const int cx = x + size / 2;
+  const int cy = y + size / 2;
+  const int core = std::max(1, size / 3);
+
+  renderer.fillRect(cx - core / 2, cy - core / 2, core, core, foregroundBlack);
+
+  const int rayInner = core / 2 + 1;
+  const int rayOuter = size / 2;
+  renderer.drawLine(cx, cy - rayOuter, cx, cy - rayInner, foregroundBlack);  // up
+  renderer.drawLine(cx, cy + rayInner, cx, cy + rayOuter, foregroundBlack);  // down
+  renderer.drawLine(cx - rayOuter, cy, cx - rayInner, cy, foregroundBlack);  // left
+  renderer.drawLine(cx + rayInner, cy, cx + rayOuter, cy, foregroundBlack);  // right
+}
+
+void BaseTheme::drawSnowflakeIcon(const GfxRenderer& renderer, int x, int y, int size, bool foregroundBlack) const {
+  // Small snowflake: three lines through a common center (vertical,
+  // horizontal, and both diagonals), matching the sun icon's line weight.
+  const int cx = x + size / 2;
+  const int cy = y + size / 2;
+  const int r = size / 2;
+  const int d = std::max(1, r * 2 / 3);  // diagonal reach, kept inside the box
+
+  renderer.drawLine(cx, cy - r, cx, cy + r, foregroundBlack);
+  renderer.drawLine(cx - r, cy, cx + r, cy, foregroundBlack);
+  renderer.drawLine(cx - d, cy - d, cx + d, cy + d, foregroundBlack);
+  renderer.drawLine(cx - d, cy + d, cx + d, cy - d, foregroundBlack);
+}
+
+void BaseTheme::drawFrontlightTempIndicators(const GfxRenderer& renderer, Rect batteryRect, bool batteryLeft,
+                                             bool foregroundBlack) const {
+  // Warm/cold frontlight percentages, drawn as small icon+percentage pairs
+  // beside the battery. frontlightWarmth is 0 (cool) .. 100 (warm); the cold
+  // reading is its complement rather than a separately stored setting.
+  const uint8_t warmPercent = SETTINGS.frontlightWarmth;
+  const uint8_t coldPercent = 100 - warmPercent;
+  constexpr int iconSize = 7;
+  constexpr int iconTextGap = 2;
+  constexpr int pairGap = 6;
+
+  const auto warmText = std::to_string(warmPercent) + "%";
+  const auto coldText = std::to_string(coldPercent) + "%";
+  const int warmTextWidth = renderer.getTextWidth(SMALL_FONT_ID, warmText.c_str());
+  const int coldTextWidth = renderer.getTextWidth(SMALL_FONT_ID, coldText.c_str());
+  const int iconY = batteryRect.y + (batteryRect.height - iconSize) / 2;
+  const int textY = batteryRect.y;
+
+  if (batteryLeft) {
+    // Battery icon sits at the left; extend further left: [cold][warm][battery]
+    int x = batteryRect.x - pairGap;
+    x -= warmTextWidth;
+    renderer.drawText(SMALL_FONT_ID, x, textY, warmText.c_str(), foregroundBlack);
+    x -= iconTextGap + iconSize;
+    drawSunIcon(renderer, x, iconY, iconSize, foregroundBlack);
+    x -= pairGap;
+    x -= coldTextWidth;
+    renderer.drawText(SMALL_FONT_ID, x, textY, coldText.c_str(), foregroundBlack);
+    x -= iconTextGap + iconSize;
+    drawSnowflakeIcon(renderer, x, iconY, iconSize, foregroundBlack);
+  } else {
+    // Battery icon sits at the right; extend further right: [battery][cold][warm]
+    int x = batteryRect.x + batteryRect.width + pairGap;
+    drawSnowflakeIcon(renderer, x, iconY, iconSize, foregroundBlack);
+    x += iconSize + iconTextGap;
+    renderer.drawText(SMALL_FONT_ID, x, textY, coldText.c_str(), foregroundBlack);
+    x += coldTextWidth + pairGap;
+    drawSunIcon(renderer, x, iconY, iconSize, foregroundBlack);
+    x += iconSize + iconTextGap;
+    renderer.drawText(SMALL_FONT_ID, x, textY, warmText.c_str(), foregroundBlack);
+  }
+}
+
 int BaseTheme::homeHeaderClockTextYOffset(const GfxRenderer& renderer) {
   const auto& metrics = UITheme::getInstance().getMetrics();
   const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
@@ -509,6 +584,7 @@ void BaseTheme::drawHeader(const GfxRenderer& renderer, Rect rect, const char* t
   } else {
     drawBatteryRight(renderer, batteryRect, showBatteryPercentage);
   }
+  drawFrontlightTempIndicators(renderer, batteryRect, batteryLeft);
 
   drawTopStatusBarClock(renderer, rect.y, nullptr, readerContext, clockYOffset);
 }
