index cf647f0..0a749e6 100644
--- a/src/components/themes/BaseTheme.cpp
+++ b/src/components/themes/BaseTheme.cpp
@@ -122,6 +122,83 @@ void BaseTheme::drawBatteryRight(const GfxRenderer& renderer, Rect rect, const b
   fillBatteryIcon(renderer, iconRect, percentage, foregroundBlack);
 }
 
+void BaseTheme::drawSunIcon(const GfxRenderer& renderer, int x, int y, int size, bool foregroundBlack) const {
+  // Small sun: filled square core with four cardinal rays. No drawCircle
+  // primitive exists in GfxRenderer, so the core is a square rather than
+  // a disc - at this pixel size (6-7px) the two are visually equivalent.
+  const int cx = x + size / 2;
+  const int cy = y + size / 2;
+  const int core = std::max(1, size / 3);
+
+  renderer.fillRect(cx - core / 2, cy - core / 2, core, core, foregroundBlack);
+
+  const int rayInner = core / 2 + 1;
+  const int rayOuter = size / 2;
+  renderer.drawLine(cx, cy - rayOuter, cx, cy - rayInner, foregroundBlack);  // up
+  renderer.drawLine(cx, cy + rayInner, cx, cy + rayOuter, foregroundBlack);  // down
+  renderer.drawLine(cx - rayOuter, cy, cx - rayInner, cy, foregroundBlack);  // left
+  renderer.drawLine(cx + rayInner, cy, cx + rayOuter, cy, foregroundBlack);  // right
+}
+
+void BaseTheme::drawSnowflakeIcon(const GfxRenderer& renderer, int x, int y, int size, bool foregroundBlack) const {
+  // Small snowflake: three lines through a common center (vertical,
+  // horizontal, and both diagonals), matching the sun icon's line weight.
+  const int cx = x + size / 2;
+  const int cy = y + size / 2;
+  const int r = size / 2;
+  const int d = std::max(1, r * 2 / 3);  // diagonal reach, kept inside the box
+
+  renderer.drawLine(cx, cy - r, cx, cy + r, foregroundBlack);
+  renderer.drawLine(cx - r, cy, cx + r, cy, foregroundBlack);
+  renderer.drawLine(cx - d, cy - d, cx + d, cy + d, foregroundBlack);
+  renderer.drawLine(cx - d, cy + d, cx + d, cy - d, foregroundBlack);
+}
+
+void BaseTheme::drawFrontlightTempIndicators(const GfxRenderer& renderer, int topY, bool darkMode) const {
+  // Pinned to the top-left corner, positioned entirely independently of the
+  // clock (centered) and battery (wherever its own header/status-bar logic
+  // puts it) so neither is affected. Reads frontlightWarmth directly off
+  // SETTINGS on every call - no cached/stale copy - so it always shows the
+  // current value; CrossPointSettings gives frontlightWarmth a default (50)
+  // and loads the persisted value at boot, so there is always a value to
+  // show from the very first frame, before the user ever opens the
+  // frontlight panel.
+  const bool foregroundBlack = !darkMode;
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const uint8_t warmPercent = SETTINGS.frontlightWarmth;
+  const uint8_t coldPercent = 100 - warmPercent;
+  constexpr int iconSize = 7;
+  constexpr int iconTextGap = 2;
+  constexpr int pairGap = 6;
+
+  const auto coldText = std::to_string(coldPercent) + "%";
+  const auto warmText = std::to_string(warmPercent) + "%";
+  const int lineHeight = renderer.getLineHeight(SMALL_FONT_ID);
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int textY = baseTopY + (statusBarHeight - lineHeight) / 2;
+  const int iconY = textY + (lineHeight - iconSize) / 2;
+
+  int x = orientedMarginLeft + metrics.statusBarHorizontalMargin;
+  drawSnowflakeIcon(renderer, x, iconY, iconSize, foregroundBlack);
+  x += iconSize + iconTextGap;
+  renderer.drawText(SMALL_FONT_ID, x, textY, coldText.c_str(), foregroundBlack);
+  x += renderer.getTextWidth(SMALL_FONT_ID, coldText.c_str()) + pairGap;
+  drawSunIcon(renderer, x, iconY, iconSize, foregroundBlack);
+  x += iconSize + iconTextGap;
+  renderer.drawText(SMALL_FONT_ID, x, textY, warmText.c_str(), foregroundBlack);
+}
+
