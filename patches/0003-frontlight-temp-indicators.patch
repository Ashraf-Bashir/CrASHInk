+void BaseTheme::drawSnowflakeIcon(const GfxRenderer& renderer, int x, int y, int size, bool filled) const {
+  // Draw a small snowflake icon (6-pointed star) for cold indicator
+  const int cx = x + size / 2;
+  const int cy = y + size / 2;
+  const int r = size / 2;
+
+  // Draw 6-pointed star as 3 perpendicular lines through center
+  renderer.drawLine(cx, cy - r, cx, cy + r, filled);           // Vertical
+  renderer.drawLine(cx - r, cy, cx + r, cy, filled);           // Horizontal
+  renderer.drawLine(cx - r/2, cy - r/2, cx + r/2, cy + r/2, filled);  // Diagonal \
+  renderer.drawLine(cx - r/2, cy + r/2, cx + r/2, cy - r/2, filled);  // Diagonal /
+}
+
+void BaseTheme::drawSunIcon(const GfxRenderer& renderer, int x, int y, int size, bool filled) const {
+  // Draw a small sun icon (circle with rays) for warm indicator
+  const int cx = x + size / 2;
+  const int cy = y + size / 2;
+  const int r = size / 3;
+
+  // Draw sun circle
+  renderer.drawCircle(cx, cy, r, filled);
+
+  // Draw 4 rays (cardinal directions)
+  const int rayLen = r + 1;
+  renderer.drawLine(cx, cy - rayLen, cx, cy - r, filled);      // Top
+  renderer.drawLine(cx, cy + r, cx, cy + rayLen, filled);      // Bottom
+  renderer.drawLine(cx - rayLen, cy, cx - r, cy, filled);      // Left
+  renderer.drawLine(cx + r, cy, cx + rayLen, cy, filled);      // Right
+}
+
+void BaseTheme::drawFrontlightTempIndicators(const GfxRenderer& renderer, Rect rect,
+                                              const bool foregroundBlack) const {
+  // Get frontlight settings (0-100 for both warm and cold)
+  int xOffset = rect.x + rect.width + FRONTLIGHT_TEMP_ICON_SPACING;
+
+  drawSnowflakeIcon(renderer, xOffset, rect.y + 4, FRONTLIGHT_TEMP_ICON_SIZE, foregroundBlack);
+  drawSunIcon(renderer, xOffset + FRONTLIGHT_TEMP_ICON_SIZE + 4, rect.y + 4, FRONTLIGHT_TEMP_ICON_SIZE, foregroundBlack);
+}

