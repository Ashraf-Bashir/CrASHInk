+template<class Driver>
+static void testRegionalDirectGray() {
+  Driver driver;
+  FreeInkDisplay display(1, 2, 3, 4, 5, 6);
+  display._driver = &driver;
+  display.begin();
+  auto bw = frame(7), lsb = frame(17), msb = frame(29);
+  std::memcpy(display.getFrameBuffer(), bw.data(), bw.size());
+  display.displayBuffer(FreeInkDisplay::FAST_REFRESH, false);
+  assert(display.grayscaleCapabilities(GrayscaleMode::Direct).regionalDirect);
+  constexpr bool flippedRows = std::is_same<Driver, Uc8179Driver>::value;
+  for (uint16_t y : {20, 105}) {
+    const uint16_t gate = flippedRows ? 480 - y - 12 : 120 + y;
+    const uint16_t end = gate + 11;
+    const Bytes expected = {0, 8, 0, 39, uint8_t(gate >> 8), uint8_t(gate),
+                            uint8_t(end >> 8), uint8_t(end), 1};
+    display._bus.clear();
+    assert(display.displayGrayscaleBase(GrayscaleMode::Direct));
+    assert(!display.displayDirectGrayRegion({11, y, 24, 12}));
+    display.copyGrayscaleBuffers(lsb.data(), msb.data());
+    assert(!display.displayDirectGrayRegion({790, y, 24, 12}));
+    assert(display.displayDirectGrayRegion({11, y, 24, 12}));
+    std::vector<uint8_t> sequence;
+    for (const auto& write : display._bus.writes) {
+      if (write.command == 0x90) assert(write.bytes == expected);
+      if (write.command == 0x91 || write.command == 0x90 || write.command == 0x12 || write.command == 0x92)
+        sequence.push_back(write.command);
+    }
+    assert((sequence == std::vector<uint8_t>{0x91, 0x90, 0x12, 0x92}));
+  }
+  display.deepSleep();
+  free(driver._grayBase);
+}
