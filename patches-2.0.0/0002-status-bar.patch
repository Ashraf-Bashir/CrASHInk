+void BaseTheme::drawReadestIndicator(const GfxRenderer& renderer, int topY, bool darkMode) const {
+  if (!gpio.hasTouch() || SETTINGS.disableReaderTouchscreen) {
+    return;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(renderer), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const auto layout = statusIconLayout(orientedMarginLeft + metrics.statusBarHorizontalMargin);
+  if (!layout.visible(StatusIconRow::Readest)) {
+    return;
+  }
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int boxY = baseTopY + (statusBarHeight - touchStatusIconSize) / 2;
+  const int boxX = layout.x(StatusIconRow::Readest);
+
+  // Drawn with text and a rectangle rather than a packed bitmap, so it stays
+  // upright in every orientation without a hand-rotated glyph table.
+  renderer.drawRect(boxX, boxY, touchStatusIconSize, touchStatusIconSize, !darkMode);
+  const int textWidth = renderer.getTextWidth(SMALL_FONT_ID, "R", EpdFontFamily::BOLD);
+  const int lineHeight = renderer.getLineHeight(SMALL_FONT_ID);
+  renderer.drawText(SMALL_FONT_ID, boxX + (touchStatusIconSize - textWidth) / 2,
+                    boxY + (touchStatusIconSize - lineHeight) / 2, "R", !darkMode, EpdFontFamily::BOLD);
+}
