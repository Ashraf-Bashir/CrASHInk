+bool BaseTheme::isFrontlightIndicatorTap(const GfxRenderer& renderer, int topY, int touchX, int touchY) const {
+  if (!Frontlight.present()) {
+    return false;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(renderer), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return false;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+
+  // Generous hit box, not the icon's own tight bounds: the whole top status
+  // bar row's height, and a horizontal zone that runs to the middle of the
+  // gap to the neighbouring icons (or well past the last one), since a 20px
+  // glyph is a hard target to hit precisely with a finger. Follows the user's
+  // icon order, so it stays right when icons are moved or hidden.
+  const auto layout = statusIconLayout(orientedMarginLeft + metrics.statusBarHorizontalMargin);
+  int hitLeft = 0;
+  int hitRight = 0;
+  if (!layout.hitRange(StatusIconRow::Lamp, hitLeft, hitRight)) {
+    return false;
+  }
+  const int hitTop = baseTopY;
+  const int hitBottom = baseTopY + statusBarHeight;
+
+  return touchX >= hitLeft && touchX < hitRight && touchY >= hitTop && touchY < hitBottom;
+}
+
+void BaseTheme::drawTouchscreenIndicator(const GfxRenderer& renderer, int topY, bool darkMode) const {
+  // Sits immediately to the right of the frontlight lamp icon, in the same
+  // top status bar row - drawn from drawReaderStatusBar() right after
+  // drawFrontlightStatusIndicator() so it shares that function's placement
+  // guarantees (renders every time, independent of clock/battery settings).
+  //
+  // Shows whether the reader touchscreen (SETTINGS.disableReaderTouchscreen)
+  // is currently usable: a plain hand when it is, the same hand with a
+  // diagonal strike through it when it's been turned off. Only relevant on
+  // touch hardware, so it's skipped entirely on button-only devices.
+  if (!gpio.hasTouch()) {
+    return;
+  }
+
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int statusBarHeight = std::max(UITheme::getStatusBarHeight(renderer), metrics.statusBarVerticalMargin);
+  if (statusBarHeight <= 0) {
+    return;
+  }
+
+  int orientedMarginTop, orientedMarginRight, orientedMarginBottom, orientedMarginLeft;
+  renderer.getOrientedViewableTRBL(&orientedMarginTop, &orientedMarginRight, &orientedMarginBottom,
+                                   &orientedMarginLeft);
+  (void)orientedMarginRight;
+  (void)orientedMarginBottom;
+
+  const int baseTopY = topY >= 0 ? topY : orientedMarginTop + metrics.topPadding;
+  const int iconY = baseTopY + (statusBarHeight - touchStatusIconSize) / 2;
+  const auto layout = statusIconLayout(orientedMarginLeft + metrics.statusBarHorizontalMargin);
+  if (!layout.visible(StatusIconRow::Touch)) {
+    return;
+  }
+  const int x = layout.x(StatusIconRow::Touch);
+
+  const uint8_t* bits = SETTINGS.disableReaderTouchscreen ? icon_hand_off_bits : icon_hand_bits;
+  if (darkMode) {
+    renderer.drawIconInverted(bits, x, iconY, touchStatusIconSize);
+  } else {
+    renderer.drawIcon(bits, x, iconY, touchStatusIconSize);
+  }
+}
+
+bool BaseTheme::isTouchscreenIndicatorTap(const GfxRenderer& renderer, int topY, int touchX, int touchY) const {
+  // Only meaningful while the touchscreen is currently on: this only answers
+  // "was the tap on the indicator" for the disable direction. Re-enabling it
+  // by tapping isn't handled here (or anywhere) - once
+  // SETTINGS.disableReaderTouchscreen is set, MappedInputManager stops
+  // reporting taps in the reader at all (touchInputEnabled() reads that same
+  // setting), so a tap could never reach this check in the first place; it
+  // can only be turned back on through the button shortcut (or a tap on the
+  // home screen, which uses isTouchscreenIndicatorHit directly).
+  if (SETTINGS.disableReaderTouchscreen) {
+    return false;
+  }
+  return isTouchscreenIndicatorHit(renderer, topY, touchX, touchY);
+}
