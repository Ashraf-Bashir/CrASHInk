+#pragma once
+#include <algorithm>
+#include <cmath>
+#include "util/ReaderStatusBarConfig.h"
+namespace StatusBarGeometry {
+constexpr int WifiSpace = 20;
+struct Bounds { int x, y, width, height; };
+inline Bounds wifiBounds(int x, int rowTop, int rowHeight, int textTop, int lineHeight) {
+  const int height = std::min(12, std::max(0, rowHeight));
+  const int y = std::clamp(textTop + lineHeight / 2 - height / 2, rowTop, rowTop + std::max(0, rowHeight) - height);
+  return {x, y, 16, height};
+}
+template<class Pixel> void drawWifi(const Bounds& box, Pixel pixel) {
+  if (box.height <= 0) return;
+  const auto put = [&](int x, int y) {
+    if (x >= 0 && x < 16 && y >= 0 && y < 12)
+      pixel(box.x + x * box.width / 16, box.y + y * box.height / 12);
+  };
+  for (int radius : {3, 6, 9}) for (int dx = -radius; dx <= radius; ++dx) {
+    const int dy = static_cast<int>(std::sqrt(static_cast<float>(radius * radius - dx * dx)));
+    if (dy >= radius / 2) { put(7 + dx * 7 / 9, 10 - dy); put(7 + dx * 7 / 9, 11 - dy); }
+  }
+  for (int y = 10; y < 12; ++y) for (int x = 7; x < 9; ++x) put(x, y);
+}
+}  // namespace StatusBarGeometry
