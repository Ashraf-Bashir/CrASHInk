+  if (psram.total && bytes <= psram.free && psram.free - bytes >= 128u * 1024u) {
+    auto buffer = makePsramByteBufferNoThrow(bytes);
+    if (buffer) return buffer;
+  }
+  return makeDefaultByteBufferNoThrow(bytes);
+}
