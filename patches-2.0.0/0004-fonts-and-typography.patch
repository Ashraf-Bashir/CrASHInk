diff --git a/src/DictionaryFontAdmission.h b/src/DictionaryFontAdmission.h
new file mode 100644
index 0000000000000000000000000000000000000000..ad97ddeb72883f5a9e28e579bed2b222785ff5e4
--- /dev/null
+++ b/src/DictionaryFontAdmission.h
@@ -0,0 +1,11 @@
+#pragma once
+#include <Memory.h>
+namespace DictionaryFontAdmission {
+// Metadata allocations remain fallible in the font loader. PSRAM-capable
+// devices need small internal blocks, not a contiguous 32 KiB font buffer.
+inline bool allows(const ByteHeapSnapshot& internal, const ByteHeapSnapshot& external) {
+  const bool externalReady = external.total && external.free >= 256U * 1024U && external.largest >= 128U * 1024U;
+  return internal.free >= (externalReady ? 40U * 1024U : 64U * 1024U) &&
+         internal.largest >= (externalReady ? 8U * 1024U : 32U * 1024U);
+}
+}
