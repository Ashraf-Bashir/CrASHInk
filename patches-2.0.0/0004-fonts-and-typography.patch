+bool DictionaryDefinitionActivity::visibleArabicFontMissing() const {
+  if (!dictionaryFontFamilyName_[0]) return false; // preserve ordinary reader-font dictionary fallback
+  const auto found = renderer.getFontMap().find(getDefinitionFontId());
+  std::string visual;
+  bool hasArabic = false;
+  for (const auto& segment : layoutSegments) {
+    const char* text = pagePool_.data() + segment.offset;
+    visual.clear();
+    if (BidiUtils::applyBidiVisual(text, visual, static_cast<int>(BidiUtils::BidiBaseDir::AUTO)) && !visual.empty())
+      text = visual.c_str();
+    const auto* cursor = reinterpret_cast<const uint8_t*>(text);
+    while (const uint32_t cp = utf8NextCodepoint(&cursor)) {
+      const bool arabic = (cp >= 0x0600 && cp <= 0x08ff) || (cp >= 0xfb50 && cp <= 0xfdff) ||
+                          (cp >= 0xfe70 && cp <= 0xfeff);
+      if (arabic) {
+        hasArabic = true;
+        if (found != renderer.getFontMap().end() && found->second.hasCodepoint(cp, segment.style)) return false;
+      }
+    }
+  }
+  return hasArabic;
+}
+
+bool DictionaryDefinitionActivity::reloadRequestedDictionaryFont() {
+  if (dictionaryFontReloadAttempted_ || !dictionaryFontFamilyName_[0]) return false;
+  dictionaryFontReloadAttempted_ = true;
+  LOG_ERR("DICT", "Reloading requested dictionary font %s after unavailable glyphs", dictionaryFontFamilyName_);
+  sdFontSystem.releaseLoadedFont(renderer);
+  const auto activation = sdFontSystem.activateDictionaryFont(renderer, dictionaryFontFamilyName_, dictionaryFontPointSize_);
+  definitionFontId_ = activation.fontId;
+  definitionFontSource_ = activation.usingDictionaryFont ? DefinitionFontSource::Dictionary : DefinitionFontSource::Reader;
+  if (!activation.usingDictionaryFont) return false;
+  reflowForDefinitionFontChange();
+  return !visibleArabicFontMissing();
+}
