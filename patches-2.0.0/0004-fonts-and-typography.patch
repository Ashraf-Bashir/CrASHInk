+#include <HalScalableFont.h>
+#include <cassert>
+#include <vector>
+int main(int argc,char**argv) {
+ assert(argc==3);
+ for(unsigned iteration=0;iteration<12;++iteration) {
+  {
+   HalScalableFont reader;
+   assert(reader.openFile(argv[1],HalScalableFont::MaxFileBytes,{},HalScalableFont::FileMode::Stream));
+   assert(reader.probeGlyph('T',16));
+   assert(!reader.hasCodepoint(0x0645)); // the screenshot's Latin fallback cannot render Arabic
+  }
+  {
+   // Real, separate Arabic face opened with the dictionary's temporary mode.
+   HalScalableFont dictionary;
+   assert(dictionary.openFile(argv[2],HalScalableFont::MaxFileBytes,{},HalScalableFont::FileMode::Temporary));
+   assert(dictionary.hasCodepoint(0x0645)); // meem
+   assert(dictionary.probeGlyph(0x0645,16));
+   {std::vector<unsigned char> transient(512*1024,0xa5);} // freed sharing-sized payload
+   for(auto cp:{0x0645u,0x0634u,0x0643u,0x0644u,0x0629u,0xfee3u})
+    if(dictionary.hasCodepoint(cp)) assert(dictionary.probeGlyph(cp,16));
+  }
+ }
+}
