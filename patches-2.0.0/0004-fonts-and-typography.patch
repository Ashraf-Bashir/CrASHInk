+ char dictionaryFontFamilyName_[64]="Arabic";bool dictionaryFontReloadAttempted_=false;
+ std::atomic<bool> dictionaryFontUnavailable_{false},dictionaryFontRetryAfterShare_{false};int updates=0;
+ void requestUpdate(){++updates;}
