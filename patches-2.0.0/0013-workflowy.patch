@@ -0,0 +1,11 @@
+from pathlib import Path
+import sys
+source = Path(sys.argv[1]).read_text()
+parts = []
+for begin, end in [
+    ("void WorkflowyDailyActivity::startBulk(", "void WorkflowyDailyActivity::actions("),
+    ("void WorkflowyDailyActivity::applyScheduledSelection(", "void WorkflowyDailyActivity::scheduleItem("),
+]:
+    start = source.index(begin)
+    parts.append(source[start:source.index(end, start)])
+Path(sys.argv[2]).write_text("\n".join(parts))
diff --git a/test/workflowy_bulk/WorkflowyBulkTest.cpp b/test/workflowy_bulk/WorkflowyBulkTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..aa5caf0395dfd88c5733455a6cf88c3c52061eee
--- /dev/null
+++ b/test/workflowy_bulk/WorkflowyBulkTest.cpp
@@ -0,0 +1,142 @@
+
+#include <ArduinoJson.h>
+#include <algorithm>
+#include <cassert>
+#include <functional>
+#include <memory>
+#include <optional>
+#include "WorkflowySchedule.h"
+#include <string>
+#include <vector>
+constexpr size_t MAX_SAVE_QUEUE=24;
+enum class StrId {STR_WORKFLOWY_NETWORK_FAILED,STR_WORKFLOWY_MARK_DONE,STR_WORKFLOWY_MARK_UNDONE,STR_WORKFLOWY_TO_TODO,STR_WORKFLOWY_TO_BULLET,STR_WORKFLOWY_MOVE_TOP,STR_WORKFLOWY_MOVE_BOTTOM,STR_DELETE,STR_WORKFLOWY_MOVE,STR_WORKFLOWY_QUEUE_FULL,STR_WORKFLOWY_SEND_FAILED,STR_WORKFLOWY_SCHEDULE_OVERFLOW};
+using enum StrId;
+StrId tr(StrId id){return id;}
+bool validDate(const std::string& value){return value.size()==10 && value.front()=='2';}
+std::string isoDate(int day){return day ? "2026-11-20" : "2026-11-19";}
+std::string encode(JsonDocument& doc){std::string body;serializeJson(doc,body);return body;}
+struct RenderLock {template<typename T> explicit RenderLock(T&) {}};
+struct WorkflowyDailyActivity {
+ enum class BulkAction {None,Done,Undone,ToTodo,ToBullet,MoveDate,MoveTop,MoveBottom,Delete};
+ struct Node {std::string id,title;bool selected=true,todo=false,done=false,divider=false;};
+ struct Save {std::string item,title,path,body,method;int status=0;std::function<void(const Save&)> finish;};
+ struct View {std::vector<Node> rows;};
+ std::vector<View> viewStack;
+ std::vector<Node> rows;
+ std::vector<std::unique_ptr<Save>> saves;
+ std::string date="2026-11-19",zoomId;
+ bool online=true,selecting=true;
+ int loads=0,error=-1,removed=0,queueFailAt=-1;
+
+ struct Planned {std::string id,source,target;int start,end;};
+ std::vector<Planned> plans;
+ std::shared_ptr<std::vector<Node>> schedulingItems;
+ std::optional<Node> schedulingItem;
+ bool calendarVisible=true,calendarFocusZoom=true,showDone=false,layoutDirty=false;
+ int lastStatus=0,lastTransport=0,wrapAnchor=-1;
+ struct ErrorText {ErrorText& operator=(StrId){return *this;}} lastServerError;
+ std::string calendarFocus;
+ void startBulk(BulkAction,std::string target={});
+ void applyScheduledSelection(const std::vector<Node>&,const std::string&,const std::string&,int,int);
+ void saveTaskSchedule(Node node,std::string source,std::string target,int start,int end,bool) {
+  plans.push_back({node.id,source,target,start,end});
+ }
+ void moveToDate(std::string,std::string target){date=target;rows.clear();}
+
+ bool itemPending(const std::string& id) const {return std::any_of(saves.begin(),saves.end(),[&](const auto& job){return job->item==id;});}
+ size_t selectionCount()const{return std::count_if(rows.begin(),rows.end(),[](const Node& n){return n.selected;});}
+ void showMessage(StrId id){error=static_cast<int>(id);}
+ void loadDay(){++loads;}
+ void removeNode(const std::string&,bool){++removed;}
+ void updateCompletion(const std::string& id,bool done){for(auto& n:rows)if(n.id==id)n.done=done;}
+ void updateType(const std::string& id,bool todo){for(auto& n:rows)if(n.id==id)n.todo=todo;}
+ void appendChild(std::vector<Node>& nodes,const std::string& parent,Node node){
+  if(std::any_of(nodes.begin(),nodes.end(),[&](const Node& n){return n.id==parent;}))nodes.push_back(std::move(node));
+ }
+ void requestUpdate(){}
+ void cancelSelection(){selecting=false;for(auto& n:rows)n.selected=false;}
+ bool queueSave(std::string path,std::string body,bool,std::function<void(const Save&)> finish,const char* method,StrId,std::string id){
+  if(static_cast<int>(saves.size())==queueFailAt)return false;
+  auto job=std::make_unique<Save>();job->path=path;job->body=body;job->item=id;job->method=method;job->finish=std::move(finish);saves.push_back(std::move(job));return true;
+ }
+};
+
+#include "WorkflowyBulkUnderTest.inc"
+
+int main(){
+ using App=WorkflowyDailyActivity;using Action=App::BulkAction;
+ for(bool top:{true,false}) {
+  App app;app.rows={{"a","A"},{"b","B",false},{"c","C"},{"d","D",false}};
+  app.startBulk(top?Action::MoveTop:Action::MoveBottom);
+  assert(app.saves.size()==2 && !app.selecting);
+  std::vector<std::string> server={"a","b","c","d"};
+  for(auto& job:app.saves){JsonDocument doc;assert(!deserializeJson(doc,job->body));assert(doc["parent_id"]==app.date);
+   auto at=std::find(server.begin(),server.end(),job->item);assert(at!=server.end());server.erase(at);
+   if(doc["position"]=="top")server.insert(server.begin(),job->item);else server.push_back(job->item);
+   job->status=200;job->finish(*job);
+  }
+  assert((server==(top?std::vector<std::string>{"a","c","b","d"}:std::vector<std::string>{"b","d","a","c"})));
+  assert(app.loads==2 && app.removed==0);
+ }
+ {
+  App app;app.rows={{"a","A"},{"b","B",true,true},{"c","C"}};
+  app.startBulk(Action::ToTodo);assert(app.saves.size()==2 && app.rows[0].todo && app.rows[2].todo);
+  JsonDocument doc;assert(!deserializeJson(doc,app.saves[0]->body));assert(doc["layoutMode"]=="todo");
+  app.saves[0]->status=503;app.saves[0]->finish(*app.saves[0]);assert(!app.rows[0].todo && app.rows[1].todo && app.rows[2].todo);
+ }
+ {
+  App app;app.rows={{"a","A",true,true,false},{"b","B",true,false},{"c","C",true,true,true}};
+  app.startBulk(Action::Done);assert(app.saves.size()==1 && app.rows[0].done && !app.rows[1].done);
+  app.saves[0]->status=503;app.saves[0]->finish(*app.saves[0]);assert(!app.rows[0].done && app.rows[2].done);
+ }
+ {
+  App app;app.rows={{"a","A"},{"b","B"}};app.startBulk(Action::MoveDate,"2026-11-20");
+  for(auto& job:app.saves){JsonDocument doc;assert(!deserializeJson(doc,job->body));assert(doc["parent_id"]=="2026-11-20" && doc["position"]=="bottom");job->status=200;job->finish(*job);}assert(app.removed==2);
+ }
+ {
+  App app;for(int i=0;i<25;++i)app.rows.push_back({std::to_string(i),"Task"});app.startBulk(Action::ToTodo);
+  assert(app.saves.empty() && app.selecting && app.rows[0].selected && app.error==static_cast<int>(STR_WORKFLOWY_QUEUE_FULL));
+ }
+ {
+  App app;app.rows={{"a","A"},{"b","B"},{"c","C"}};app.queueFailAt=1;app.startBulk(Action::ToTodo);
+  assert(app.saves.size()==1 && app.selecting && !app.rows[0].selected && app.rows[1].selected && app.rows[2].selected);
+ }
+
+ {
+  App app;auto held=std::make_shared<std::vector<App::Node>>();
+  *held={{"a","A",true,true},{"b","B",true,true,true},{"c","C",true,true}};
+  app.rows=*held;app.schedulingItems=held;
+  app.applyScheduledSelection(*held,app.date,app.date,540,570);
+  assert(app.plans.size()==3 && !app.calendarVisible && !app.schedulingItems && app.showDone);
+  for(size_t i=0;i<app.plans.size();++i){assert(app.plans[i].id==(*held)[i].id);assert(app.plans[i].start==540+30*static_cast<int>(i));assert(app.plans[i].end==570+30*static_cast<int>(i));}
+  assert(app.wrapAnchor==0 && app.layoutDirty);
+ }
+ {
+  App app;auto held=std::make_shared<std::vector<App::Node>>();*held={{"a","A"},{"b","B"},{"c","C"}};
+  app.schedulingItems=held;app.applyScheduledSelection(*held,app.date,app.date,1380,1410);
+  assert(app.plans.empty() && app.calendarVisible && app.schedulingItems && app.error==static_cast<int>(STR_WORKFLOWY_SCHEDULE_OVERFLOW));
+ }
+ {
+  App app;auto held=std::make_shared<std::vector<App::Node>>();*held={{"a","A"}};app.schedulingItems=held;
+  app.applyScheduledSelection(*held,app.date,"2026-11-20",540,600);
+  assert(app.date=="2026-11-20" && app.calendarFocus=="a" && !app.calendarFocusZoom && app.plans[0].end==600);
+ }
+ {
+  App app;app.zoomId="parent";app.rows={{"a","A"},{"b","B"}};
+  app.viewStack.push_back({{{"grandparent","Grandparent",false}}});
+  app.startBulk(Action::MoveDate,"grandparent");
+  for(auto& job:app.saves){job->status=200;job->finish(*job);}
+  assert(app.removed==2 && app.layoutDirty && app.viewStack[0].rows.size()==3);
+  assert(app.viewStack[0].rows[1].id=="a" && app.viewStack[0].rows[2].id=="b");
+ }
+ {
+  App app;app.rows={{"a","Completed bullet",true,false,true},
+                    {"b","Plain bullet",true,false,false},
+                    {"c","Completed todo",true,true,true}};
+  app.startBulk(Action::Undone);
+  assert(app.saves.size()==2 && app.saves[0]->path=="/a/uncomplete" && app.saves[1]->path=="/c/uncomplete");
+  assert(!app.rows[0].done && !app.rows[0].todo && !app.rows[2].done);
+  app.saves[0]->status=503;app.saves[0]->finish(*app.saves[0]);
+  assert(app.rows[0].done && !app.rows[0].todo && !app.rows[1].done);
+ }
+}
