diff --git a/test/workflowy_schedule/WorkflowyScheduleTest.cpp b/test/workflowy_schedule/WorkflowyScheduleTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..58c24df55c717b51bd452d2a0ad62590fa90c673
--- /dev/null
+++ b/test/workflowy_schedule/WorkflowyScheduleTest.cpp
@@ -0,0 +1,140 @@
+#include "WorkflowySchedule.h"
+#include "WorkflowyOutlineLayout.h"
+#include "WorkflowySettings.h"
+#include <cassert>
+#include <random>
+int main() {
+  using namespace workflowy;
+  assert(scheduleScrollForNow(720, 720, 72) == 520);
+  assert(scheduleScrollForNow(720, 720, 144) == 620);
+  assert(scheduleScrollForNow(0, 720, 72) == 0);
+  assert(scheduleScrollForNow(1439, 720, 72) == 840);
+  assert(scheduleScrollForNow(720, 720, 0) == 0);
+  assert(!saveTimedOut(100, 180099));
+  assert(saveTimedOut(100, 180100));
+  assert(saveTimeRemaining(100, 180100) == 0);
+  assert(saveTimeRemaining(100, 1100) == 179000);
+  constexpr uint32_t nearWrap = UINT32_MAX - 30000;
+  assert(!saveTimedOut(nearWrap, static_cast<uint32_t>(nearWrap + 179999)));
+  assert(saveTimedOut(nearWrap, static_cast<uint32_t>(nearWrap + 180000)));
+  assert(saveTimeRemaining(nearWrap, static_cast<uint32_t>(nearWrap + 179999)) == 1);
+  assert(leadingTaskTimeRange("8:30am - 12pm Task"));
+  assert(leadingTaskTimeRange("  📅 8:30am - 12pm Task #career"));
+  assert(leadingTaskTimeRange("⏰ 9:00 – 10:00 Task"));
+  assert(!leadingTaskTimeRange("Task 8:30am - 12pm"));
+  assert(!leadingTaskTimeRange("#career 8:30am - 12pm Task"));
+  assert(!leadingTaskTimeRange("@INSIDE 8:30am - 12pm Task"));
+  assert(!leadingTaskTimeRange("Tomorrow 📅 8:30am - 12pm Task"));
+  const std::string original = "#career 8:30am - 12pm Plan project @INSIDE with team #P0";
+  TaskTextProjection projected(original);
+  assert(projected.text(false) == "Plan project @INSIDE with team #P0");
+  assert(projected.text(true) == "#career 8:30am - 12pm");
+  assert(projected.originalOffset(false, 0) == original.find("Plan"));
+  assert(projected.originalOffset(false, 13) == original.find("@INSIDE"));
+  assert(projected.originalOffset(true, 8) == original.find("8:30"));
+  assert(original == "#career 8:30am - 12pm Plan project @INSIDE with team #P0");
+  assert(TaskTextProjection("Only task text").text(false) == "Only task text");
+  assert(TaskTextProjection("#P0 @INSIDE").text(false).empty());
+  for (bool meta : {false, true}) {
+    const auto display = projected.text(meta);
+    for (size_t at = 0; at < display.size(); ++at)
+      if (display[at] != ' ') assert(original[projected.originalOffset(meta, at)] == display[at]);
+    std::vector<TextSpan> wrapped;
+    wrapOutlineText(display, 10, [](std::string_view part) { return static_cast<int>(part.size()); }, wrapped);
+    for (const auto line : wrapped) {
+      assert(line.begin <= line.end && line.end <= display.size());
+      if (line.begin < line.end)
+        assert(original[projected.originalOffset(meta, line.begin)] == display[line.begin]);
+    }
+  }
+  TaskTextProjection unicode("#health Réviser café @INSIDE");
+  assert(unicode.text(false) == "Réviser café @INSIDE");
+  assert(unicode.text(true) == "#health");
+  assert(TaskTextProjection("Task #health @INSIDE").text(false)=="Task #health @INSIDE");
+  assert(TaskTextProjection("Task #health @INSIDE").text(true).empty());
+  assert(TaskTextProjection("  #health @INSIDE Task #career ").text(true)=="#health @INSIDE");
+  assert(TaskTextProjection("  #health @INSIDE Task #career ",false).text(false)=="Task #career");
+  const std::string taggedTask = "8:15am - 9:30am #operational @work Task #later";
+  const auto compactTagged = compactTaskText(taggedTask);
+  assert(compactTagged == "8¼–9½ Task #later");
+  assert(compactTaskOriginalOffset(taggedTask, compactTagged.find("Task")) == taggedTask.find("Task"));
+  assert(compactTaskText("#operational Task") == "#operational Task");
+  assert(compactTaskText("8:15am - 9:30am Task")=="8¼–9½ Task");
+  assert(compactTaskText("8:45pm - 12am Task")=="20¾–24 Task");
+  assert(compactScheduleClock(0)=="0" && compactScheduleClock(480)=="8");
+  assert(compactScheduleClock(485)=="8:05");
+  assert(compactTaskOriginalOffset("8:15am - 9:30am Task",compactTaskText("8:15am - 9:30am Task").find("Task"))==std::string("8:15am - 9:30am Task").find("Task"));
+  assert(timedPrefixMoves({0,1,2,-1},3)==0);
+  assert(timedPrefixMoves({1,0,2,-1},3)==1);
+  assert(timedPrefixMoves({1,2,-1,0},3)==1);
+  assert(timedPrefixMoves({-1,0,1,2},3)==3);
+  for(int iteration=0;iteration<100;++iteration){
+    std::vector<int> original={-1,0,1,2,3,-2};
+    std::mt19937 random(iteration);std::shuffle(original.begin(),original.end(),random);
+    const auto moves=timedPrefixMoves(original,4);
+    auto apply=[&](size_t count){auto result=original;for(size_t n=count;n>0;--n){auto it=std::find(result.begin(),result.end(),n-1);result.erase(it);result.insert(result.begin(),n-1);}return result;};
+    const auto result=apply(moves);for(int i=0;i<4;++i)assert(result[i]==i);
+    for(size_t fewer=0;fewer<moves;++fewer){const auto wrong=apply(fewer);assert(!std::equal(wrong.begin(),wrong.begin()+4,std::vector<int>{0,1,2,3}.begin()));}
+  }
+  auto range = parseTimeRange("8:30 to 12:00 Focus");
+  assert(range && range->start == 510 && range->end == 720);
+  assert(range->begin == 0 && range->finish == 13);
+  range = parseTimeRange("#career 8:30am to 12pm Review");
+  assert(range && range->start == 510 && range->end == 720);
+  range = parseTimeRange("12am to 8:30am Sleep");
+  assert(range && range->start == 0 && range->end == 510);
+  range = parseTimeRange("8:30pm to 12am Read");
+  assert(range && range->start == 1230 && range->end == 1440);
+  range = parseTimeRange("  [ ] 9:00 – 10:15 Work #P0");
+  assert(range && range->start == 540 && range->end == 615);
+  assert(!parseTimeRange("9:60 to 12:00"));
+  assert(!parseTimeRange("25:00 to 26:00"));
+  assert(!parseTimeRange("12:00 to 12:00"));
+  assert(!parseTimeRange("Contact 123:00 to 14:00"));
+  assert(!parseTimeRange("8:30 to 12amp"));
+  assert(replaceTimeRange("#P0 8:30 to 12:00 Task", 540, 780) == "#P0 9:00am - 1:00pm Task");
+  assert(scheduleRange(0, 1440) == "12:00am - 12:00am");
+  assert(scheduleRange(1155, 1260) == "7:15pm - 9:00pm");
+  assert(scheduleClock(0) == "12:00am");
+  assert(scheduleClock(510) == "8:30am");
+  assert(scheduleClock(720) == "12:00pm");
+  assert(scheduleClock(780) == "1:00pm");
+  assert(scheduleClock(1439) == "11:59pm");
+  assert(scheduleClock(1440) == "12:00am");
+  for (int start = 0; start < 1440; start += 15) {
+    const int end = std::min(start + 30, 1440);
+    const auto text = scheduleRange(start, end);
+    const auto roundTrip = parseTimeRange(text);
+    assert(roundTrip && roundTrip->start == start && roundTrip->end == end);
+    assert(roundTrip->finish == text.size());
+  }
+  assert(scheduleSelectionFits(540, 570, 4));
+  assert(scheduleSelectionFits(1380, 1410, 2));
+  assert(!scheduleSelectionFits(1380, 1410, 3));
+  assert(!scheduleSelectionFits(540, 540, 1));
+  assert(!scheduleSelectionFits(540, 570, 0));
+  assert(!scheduleSelectionFits(-1, 30, 1));
+  assert(!scheduleSelectionFits(1425, 1455, 1));
+  assert(shiftScheduleDate("2024-03-01", -1) == "2024-02-29");
+  assert(shiftScheduleDate("2026-12-31", 1) == "2027-01-01");
+  assert(scheduleWeekday("2026-11-16") == 0);
+  assert(scheduleWeekday("2026-11-22") == 6);
+  assert(shiftScheduleDate("2026-11-19", -scheduleWeekday("2026-11-19")) == "2026-11-16");
+  std::mt19937 random(19);
+  for (int iteration = 0; iteration < 100; ++iteration) {
+    std::vector<ScheduleLane> blocks;
+    for (size_t i = 0; i < 40; ++i) {
+      int start = random() % 1400;
+      blocks.push_back({start, std::min(start + 15 + int(random()%180), 1440), i});
+    }
+    assignScheduleLanes(blocks);
+    for (size_t i = 0; i < blocks.size(); ++i) {
+      assert(blocks[i].lane < blocks[i].lanes);
+      for (size_t j = i+1; j < blocks.size(); ++j) {
+        if (blocks[j].start >= blocks[i].end || blocks[i].start >= blocks[j].end) continue;
+        assert(blocks[i].lane != blocks[j].lane);
+        assert(blocks[i].lanes == blocks[j].lanes);
+      }
+    }
+  }
+}
