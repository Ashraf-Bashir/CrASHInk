+#pragma once
+
+#include <cstddef>
+#include "WorkflowySchedule.h"
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace workflowy {
+
+inline std::string_view trimTaskText(std::string_view text) {
+  while(!text.empty() && std::isspace(static_cast<unsigned char>(text.front())))text.remove_prefix(1);
+  while(!text.empty() && std::isspace(static_cast<unsigned char>(text.back())))text.remove_suffix(1);
+  return text;
+}
+
+// Match whole action words without allocating or changing the stored task text.
+inline bool isReplyTask(std::string_view text) {
+  constexpr std::string_view actions[] = {"reply", "replies", "replying", "replied",
+                                         "respond", "responds", "responding", "responded", "response"};
+  const auto letter = [](unsigned char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); };
+  for (size_t at = 0; at < text.size();) {
+    if (!letter(static_cast<unsigned char>(text[at]))) { ++at; continue; }
+    const size_t begin = at;
+    while (at < text.size() && letter(static_cast<unsigned char>(text[at]))) ++at;
+    const auto word = text.substr(begin, at - begin);
+    for (const auto action : actions) {
+      if (word.size() != action.size()) continue;
+      bool same = true;
+      for (size_t i = 0; i < word.size(); ++i) {
+        const char c = word[i] >= 'A' && word[i] <= 'Z' ? word[i] + ('a' - 'A') : word[i];
+        if (c != action[i]) { same = false; break; }
+      }
+      if (same) return true;
+    }
+  }
+  return false;
+}
+
+struct TextSpan {
+  size_t begin;
+  size_t end;
+  bool metadata = false;
+};
+
+inline size_t nextCharacter(std::string_view text, size_t at) {
+  do {
+    ++at;
+  } while (at < text.size() && (static_cast<unsigned char>(text[at]) & 0xc0) == 0x80);
+  return at;
+}
+
+inline void dropEmoji(std::string& text, std::string* styles = nullptr) {
+  if (styles && styles->size() != text.size()) styles = nullptr;
+  size_t write = 0;
+  for (size_t at = 0; at < text.size();) {
+    const auto end = nextCharacter(text, at);
+    const auto first = static_cast<unsigned char>(text[at]);
+    unsigned cp = first;
+    if (end - at > 1 && end - at <= 4) {
+      cp &= 0x7fu >> (end - at);
+      for (auto i = at + 1; i < end; ++i) cp = (cp << 6) | (static_cast<unsigned char>(text[i]) & 0x3f);
+    }
+    const bool key = first == '#' || first == '*' || (first >= '0' && first <= '9');
+    if (key && end == at + 1) {
+      auto tail = end;
+      if (text.compare(tail, 3, "\xef\xb8\x8f") == 0) tail += 3;
+      if (text.compare(tail, 3, "\xe2\x83\xa3") == 0) {
+        at = tail + 3;
+        continue;
+      }
+    }
+    const bool emoji = (cp >= 0x1f000 && cp <= 0x1faff) || ((cp >= 0x2600 && cp <= 0x27bf) &&
+                        ((cp != 0x2713 && cp != 0x2714 && cp != 0x2715 && cp != 0x2716) ||
+                         text.compare(end, 3, "\xef\xb8\x8f") == 0)) ||
+                       (cp >= 0x23e9 && cp <= 0x23fa) ||
+                       (cp >= 0xe0020 && cp <= 0xe007f) || cp == 0xfe0f || cp == 0x200d ||
+                       cp == 0x231a || cp == 0x231b || cp == 0x2b50 || cp == 0x2b55;
+    if (!emoji) {
+      for (auto i = at; i < end; ++i) {
+        if (styles) (*styles)[write] = (*styles)[i];
+        text[write++] = text[i];
+      }
+    }
+    at = end;
+  }
+  text.resize(write);
+  if (styles) styles->resize(write);
+}
+
+// Only a leading time range schedules a task for sorting. Decorative emoji
+// before it are ignored; tags, words and other content before it are not.
+inline std::optional<TimeRange> leadingTaskTimeRange(std::string_view text) {
+  const auto range = parseTimeRange(text);
+  if (!range) return {};
+  auto prefix = std::string(text.substr(0, range->begin));
+  dropEmoji(prefix);
+  if (prefix.find_first_not_of(" \t\r\n") != std::string::npos) return {};
+  return range;
+}
+
+// Return byte spans so a tag split across lines keeps its original identity.
+template <typename Width, typename Measure>
+void wrapOutlineTextByLine(std::string_view text, Width lineWidth, Measure measure, std::vector<TextSpan>& lines) {
+  const auto initialSize = lines.size();
+  size_t begin = 0;
+  while (begin < text.size()) {
+    if (text[begin] == ' ') {
+      ++begin;
+      continue;
+    }
+    const int width = lineWidth(lines.size() - initialSize);
+    size_t end = begin;
+    size_t word = begin;
+    while (word < text.size()) {
+      const auto space = text.find(' ', word);
+      const auto wordEnd = space == std::string_view::npos ? text.size() : space;
+      if (measure(text.substr(begin, wordEnd - begin)) > width) break;
+      end = wordEnd;
+      word = wordEnd;
+      while (word < text.size() && text[word] == ' ') ++word;
+    }
+    if (end == begin) {
+      end = nextCharacter(text, begin);
+      while (end < text.size() && text[end] != ' ') {
+        const auto next = nextCharacter(text, end);
+        if (measure(text.substr(begin, next - begin)) > width) break;
+        end = next;
+      }
+    }
+    lines.push_back({begin, end});
+    begin = end;
+  }
+  if (lines.size() == initialSize) lines.push_back({0, 0});
+}
+
+template <typename Measure>
+void wrapOutlineText(std::string_view text, int width, Measure measure, std::vector<TextSpan>& lines) {
+  wrapOutlineTextByLine(text, [width](size_t) { return width; }, measure, lines);
+}
+
+inline bool tagCharacter(unsigned char c) {
+  return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+         c == '_' || c == '-' || c >= 0x80;
+}
+
+template <typename Draw>
+void forEachTag(std::string_view text, Draw draw) {
+  size_t lastTagEnd = 0;
+  for (size_t i = 0; i + 1 < text.size(); ++i) {
+    if ((text[i] != '#' && text[i] != '@') || !tagCharacter(text[i + 1])) continue;
+    if (i != lastTagEnd && text[i - 1] != ' ' && text[i - 1] != '(' && text[i - 1] != '[' && text[i - 1] != '"') continue;
+    size_t end = i + 2;
+    while (end < text.size() && tagCharacter(text[end])) ++end;
+    draw(TextSpan{i, end});
+    lastTagEnd = end;
+    i = end - 1;
+  }
+}
+
+// Temporary rendering projection; never written back to the node. Keep only
+// source spans so cursor positions can be mapped without a per-character cache.
+struct TaskTextProjection {
+  std::string_view source;
+  std::vector<TextSpan> metadata;
+  explicit TaskTextProjection(std::string_view text, bool includeTime = true) : source(text) {
+    if (text.empty()) return;
+    metadata.reserve(4);
+    size_t prefixEnd = 0;
+    bool prefix = true;
+    forEachTag(text, [&](TextSpan span) {
+      if (!prefix) return;
+      for (auto i = prefixEnd; i < span.begin; ++i)
+        if (!std::isspace(static_cast<unsigned char>(text[i]))) { prefix = false; return; }
+      metadata.push_back(span);
+      prefixEnd = span.end;
+    });
+    if (includeTime) if (const auto time = parseTimeRange(text)) metadata.push_back({time->begin, time->finish});
+    std::sort(metadata.begin(), metadata.end(), [](TextSpan a, TextSpan b) { return a.begin < b.begin; });
+  }
+  template <typename Visit>
+  void parts(bool meta, Visit visit) const {
+    const auto emit = [&](size_t begin, size_t end) {
+      while (begin < end && std::isspace(static_cast<unsigned char>(source[begin]))) ++begin;
+      while (end > begin && std::isspace(static_cast<unsigned char>(source[end - 1]))) --end;
+      if (begin < end) visit(TextSpan{begin, end});
+    };
+    size_t at = 0;
+    for (const auto span : metadata) {
+      if (meta) emit(span.begin, span.end);
+      else if (span.begin > at) emit(at, span.begin);
+      at = std::max(at, span.end);
+    }
+    if (!meta && at < source.size()) emit(at, source.size());
+  }
+  std::string text(bool meta) const {
+    std::string result;
+    result.reserve(source.size());
+    parts(meta, [&](TextSpan span) {
+      if (!result.empty()) result += ' ';
+      result.append(source.substr(span.begin, span.end - span.begin));
+    });
+    return result;
+  }
+  size_t originalOffset(bool meta, size_t offset) const {
+    size_t drawn = 0, result = source.size();
+    bool first = true, found = false;
+    parts(meta, [&](TextSpan span) {
+      if (found) return;
+      if (!first) ++drawn;
+      first = false;
+      const auto length = span.end - span.begin;
+      if (offset <= drawn + length) {
+        result = span.begin + (offset > drawn ? offset - drawn : 0);
+        found = true;
+      }
+      drawn += length;
+    });
+    return result;
+  }
+};
+
+// Hide the leading tags immediately after the time in compact rows.
+inline size_t compactTaskBodyStart(std::string_view text, size_t timeEnd) {
+  size_t end = timeEnd;
+  size_t next = end;
+  while (next < text.size() && (text[next] == ' ' || text[next] == '\t')) ++next;
+  while (next + 1 < text.size() && (text[next] == '#' || text[next] == '@') &&
+         tagCharacter(text[next + 1])) {
+    end = next + 2;
+    while (end < text.size() && tagCharacter(text[end])) ++end;
+    next = end;
+    while (next < text.size() && (text[next] == ' ' || text[next] == '\t')) ++next;
+  }
+  return end;
+}
+
+inline std::string compactTaskText(std::string text) {
+  if (const auto time = parseTimeRange(text)) {
+    const auto bodyStart = compactTaskBodyStart(text, time->finish);
+    text.replace(time->begin, bodyStart - time->begin, compactScheduleRange(time->start, time->end));
+  }
+  return text;
+}
