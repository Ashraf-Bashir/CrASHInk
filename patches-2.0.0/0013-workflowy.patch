+void WorkflowyDailyActivity::render(RenderLock&&) {
+  const auto bounds = layout();
+  renderer.clearScreen();
+  GUI.drawDisplayStatusBar(renderer, bounds.top);
+  breadcrumbHits = {};
+  if (queueVisible) {
+    renderer.drawText(UI_12_FONT_ID, bounds.x, bounds.top + 32, tr(STR_WORKFLOWY_PENDING), true, EpdFontFamily::BOLD);
+    const int right = bounds.x + bounds.width - 18;
+    const int cy = bounds.top + 46;
+    renderer.drawLine(right - 6, cy - 6, right + 6, cy + 6, 2);
+    renderer.drawLine(right + 6, cy - 6, right - 6, cy + 6, 2);
+    renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+    const size_t visible = std::max(1, (bounds.rowBottom - bounds.rowTop) / ROW_HEIGHT);
+    const size_t inFlightCapture = std::any_of(saves.begin(), saves.end(), [](const auto& save) {
+      return save->fromOutbox;
+    }) && !offlineQueuePreview.empty() ? 1 : 0;
+    const size_t branchEntries = !requestedBranch.empty();
+    std::array<const CalendarDay*, 7> calendarJobs{};
+    size_t calendarEntries = 0;
+    if (calendarVisible) for (const auto& day : calendarDays)
+      if (!day.date.empty() && !day.loaded) calendarJobs[calendarEntries++] = &day;
+    const auto offlineStart = saves.size() + branchEntries + calendarEntries;
+    const auto total = offlineStart + offlineQueuePreview.size() - inFlightCapture + operationErrors.size();
+    queuePage = std::min(queuePage, total == 0 ? 0 : (total - 1) / visible);
+    const auto opening = branchEntries ? std::find_if(rows.begin(), rows.end(), [&](const Node& node) {
+      return node.id == requestedBranch;
+    }) : rows.end();
+    for (size_t row = queuePage * visible; row < total && row < (queuePage + 1) * visible; ++row) {
+      if(row<operationErrors.size()){
+        const auto& error=operationErrors[row];
+        const auto text=renderer.truncatedText(UI_12_FONT_ID,("! "+error.action+" · "+error.title+" ›").c_str(),bounds.width-14);
+        renderer.drawText(UI_12_FONT_ID,bounds.x+4,bounds.rowTop+(row%visible)*ROW_HEIGHT+6,text.c_str());
+        continue;
+      }
+      const auto i=row-operationErrors.size();
+      const auto* save = i < saves.size() ? saves[i].get() : nullptr;
+      const bool openingItem = !save && i < saves.size() + branchEntries;
+      const bool calendarItem = !save && !openingItem && i < offlineStart;
+      const auto type = save ? save->label : openingItem ? StrId::STR_WORKFLOWY_ZOOM
+                        : calendarItem ? StrId::STR_LOADING_POPUP : StrId::STR_WORKFLOWY_ADD;
+      const auto name = save ? std::string_view(save->title)
+                        : openingItem ? (opening == rows.end() ? std::string_view{} : std::string_view(opening->title))
+                        : calendarItem ? std::string_view(calendarJobs[i - saves.size() - branchEntries]->date)
+                        : std::string_view(offlineQueuePreview[i - offlineStart + inFlightCapture]);
+      auto text = std::to_string(i + 1) + ". " + I18n::getInstance().get(type);
+      if (!name.empty()) {
+        text += " · ";
+        text += name;
+      }
+      if (!save && !openingItem && !calendarItem && outboxUncertain && i == offlineStart) {
+        text += " · ";
+        text += tr(STR_WORKFLOWY_SYNC_CHECK);
+      }
+      const auto fitted = renderer.truncatedText(UI_12_FONT_ID, text.c_str(), bounds.width - 14);
+      renderer.drawText(UI_12_FONT_ID, bounds.x + 4, bounds.rowTop + (row % visible) * ROW_HEIGHT + 6, fitted.c_str());
+    }
+    if (!total) renderer.drawCenteredText(UI_12_FONT_ID, bounds.rowTop + 12, tr(STR_WORKFLOWY_QUEUE_EMPTY));
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer + 13, tr(STR_BACK));
+    drawStatus(bounds, pendingOperationsCount(), statusNotice());
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+    return;
+  }
+  if (calendarVisible) {
+    renderCalendar(bounds);
+    return;
+  }
+  if (selecting) {
+    const int cy = bounds.top + 46;
+    const int left = bounds.x + 17;
+    const int right = bounds.x + bounds.width;
+    renderer.drawLine(left - 6, cy - 6, left + 6, cy + 6, 2, true);
+    renderer.drawLine(left + 6, cy - 6, left - 6, cy + 6, 2, true);
+    char summary[40];
+    snprintf(summary, sizeof(summary), tr(STR_WORKFLOWY_SELECTION_COUNT), static_cast<unsigned>(selectionCount()));
+    renderer.drawText(UI_12_FONT_ID, bounds.x + ICON_TARGET, cy - 12, summary);
+    renderer.drawText(SMALL_FONT_ID, right - ICON_TARGET - 96, cy - 9, tr(STR_WORKFLOWY_SELECT_ALL));
+    for (const int dx : {-7, 0, 7}) renderer.fillRect(right - 22 + dx, cy - 1, 3, 3);
+  } else {
+    std::string heading = date.empty() || date == "today" ? isoDate(0) : date == "tomorrow" ? isoDate(1) : date;
+    const char* relative = nullptr;
+    if (date == "today" || date.empty() || date == isoDate(0)) relative = tr(STR_WORKFLOWY_TODAY);
+    else if (date == "tomorrow" || date == isoDate(1)) relative = tr(STR_WORKFLOWY_TOMORROW);
+    else if (date == isoDate(-1)) relative = tr(STR_WORKFLOWY_YESTERDAY);
+    if (relative) heading += heading.empty() ? relative : std::string(", ") + relative;
+    unsigned completed = 0, totalTodos = 0;
+    const unsigned outlineDepth = zoomId.empty() ? 0 : 1;
+    for (const auto& row : rows) {
+      if (row.depth == outlineDepth && row.todo &&
+          (!replyOnly || workflowy::isReplyTask(row.title))) {
+        ++totalTodos;
+        if (row.done) ++completed;
+      }
+    }
+    char todoCount[24];
+    snprintf(todoCount, sizeof(todoCount), "%u/%u", completed, totalTodos);
+    const int right = bounds.x + bounds.width;
+    const int cy = bounds.top + 46;
+    const int dayRight = right - COUNT_TARGET;
+    const int dateLeft = bounds.x + DAY_TARGET;
+    const int dateRight = dayRight - DAY_TARGET;
+    const int countX = dayRight + (COUNT_TARGET - renderer.getTextWidth(SMALL_FONT_ID, todoCount)) / 2;
+    renderer.drawText(SMALL_FONT_ID, countX, bounds.top + 36, todoCount);
+    if(completedOnly)renderer.drawLine(countX,bounds.top+54,countX+renderer.getTextWidth(SMALL_FONT_ID,todoCount),bounds.top+54,2,true);
+    if (!zoomId.empty()) drawBreadcrumbs(bounds, right);
+    const int dateWidth = dateRight - dateLeft;
+    constexpr int dateFont = UI_12_FONT_ID;
+    const auto drawDate = [&](const std::string& text, int y) {
+      const int width = renderer.getTextWidth(dateFont, text.c_str(), EpdFontFamily::BOLD);
+      renderer.drawText(dateFont, (dateLeft + dateRight - width) / 2, y, text.c_str(), true, EpdFontFamily::BOLD);
+    };
+    if (renderer.getTextWidth(dateFont, heading.c_str(), EpdFontFamily::BOLD) > dateWidth) {
+      if (const auto split = heading.find(", "); split != std::string::npos) {
+        drawDate(heading.substr(0, split + 1), bounds.top + 28);
+        drawDate(heading.substr(split + 2), bounds.top + 46);
+      } else {
+        drawDate(heading, bounds.top + 36);
+      }
+    } else {
+      drawDate(heading, bounds.top + (dateFont == UI_12_FONT_ID ? 32 : 36));
+    }
+    for (const int direction : {-1, 1}) {
+      const int arrowX = direction < 0 ? bounds.x + DAY_TARGET / 2 : dayRight - DAY_TARGET / 2;
+      renderer.drawLine(arrowX - direction * 4, cy - 6, arrowX + direction * 4, cy, 2);
+      renderer.drawLine(arrowX + direction * 4, cy, arrowX - direction * 4, cy + 6, 2);
+    }
+  }
+  renderer.drawLine(bounds.x, bounds.rowTop - 4, bounds.x + bounds.width - 1, bounds.rowTop - 4);
+  layoutRows(bounds);
+  paintedPage = page;
+  paintedArrows.clear();
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  for (auto i = pageStarts[page]; i < end; ++i) {
+    const auto& placement = placements[i];
+    const auto& node = rows[placement.row];
+    const int y = placement.top + 6;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int start = bounds.x + indent;
+    if (node.divider) {
+      renderer.fillRectDither(start + 4, (placement.top + placement.bottom) / 2,
+                              bounds.x + bounds.width - start - 8, 2, Color::LightGray);
+      continue;
+    }
+    if ((selecting && node.selected) || itemPending(node.id)) {
+      renderer.fillRectDither(start, placement.top + 1, bounds.x + bounds.width - start,
+                              placement.bottom - placement.top - 2, Color::LightGray);
+    }
+    if (node.depth) renderer.drawLine(start - 7, y - 5, start - 7, placement.bottom - 1);
+    const bool firstFragment = i == 0 || placements[i - 1].row != placement.row;
+    if (firstFragment && selecting && selectionEligible(node)) {
+      renderer.drawRect(start + 1, y + 4, 18, 18);
+      if (node.selected) {
+        renderer.fillRect(start + 1, y + 4, 18, 18);
+        renderer.drawLine(start + 5, y + 12, start + 8, y + 15, 2, false);
+        renderer.drawLine(start + 8, y + 15, start + 14, y + 8, 2, false);
+      }
+    } else if (firstFragment && !selecting) {
+      if (node.todo || node.done) {
+        if (node.done) {
+          drawCheckedBox(renderer, start + 1, y + 4, 18);
+        } else {
+          renderer.drawRect(start + 1, y + 4, 18, 18);
+        }
+      } else {
+        renderer.fillRoundedRect(start + 6, y + 10, 7, 7, 3, Color::Black);
+      }
+    }
+    const int textX = start + 25;
+    const workflowy::TaskTextProjection projection(node.title, wrapItems);
+    const auto bodyText = projection.text(false);
+    const auto compactText = wrapItems ? std::string{} : workflowy::compactTaskText(bodyText);
+    const auto metadataText = wrapItems ? projection.text(true) : std::string{};
+    const bool continues = i + 1 == end && end < placements.size() && placements[end].row == placement.row;
+    for (size_t line = 0; line < placement.lineCount; ++line) {
+      auto span = outlineLines[placement.firstLine + line];
+      const int font = wrapItems ? (span.metadata ? SMALL_FONT_ID : UI_12_FONT_ID) : UI_10_FONT_ID;
+      const auto title = wrapItems ? std::string_view(span.metadata ? metadataText : bodyText) : std::string_view(compactText);
+      auto timeRange = workflowy::parseTimeRange(title);
+      if (!wrapItems) {
+        timeRange = workflowy::parseTimeRange(bodyText);
+        if (timeRange) timeRange->finish = timeRange->begin + workflowy::compactScheduleRange(timeRange->start, timeRange->end).size();
+      }
+      const int lineY = y + static_cast<int>(line) * bounds.lineHeight;
+      const bool leading = !firstFragment && line == 0;
+      const int prefix = leading ? renderer.getTextWidth(font, CONTINUATION) + CONTINUATION_GAP : 0;
+      const int lineX = textX + prefix;
+      std::string text;
+      if (wrapItems) {
+        text = title.substr(span.begin, span.end - span.begin);
+      } else {
+        const int width = bounds.x + bounds.width - textX - ROW_ARROW_TARGET;
+        text = renderer.truncatedText(font, compactText.c_str(), width);
+        if (text != title && text.ends_with("…")) span.end = text.size() - 3;
+      }
+      const auto measure = [&](size_t end) {
+        // Ink bounds omit trailing spaces; use the same pen advance as drawText
+        // so the gap before a tag never becomes part of its background.
+        const uint32_t following = end < title.size() && static_cast<unsigned char>(title[end]) < 0x80
+                                       ? static_cast<unsigned char>(title[end]) : 0;
+        return renderer.getTextAdvanceX(font,
+                                        std::string(title.substr(span.begin, end - span.begin)).c_str(),
+                                        EpdFontFamily::REGULAR, following);
+      };
+      const auto highlightSpan = [&](workflowy::TextSpan tag) {
+        if (tag.end <= span.begin || tag.begin >= span.end) return;
+        const int startX = lineX + measure(std::max(tag.begin, span.begin));
+        const int endX = lineX + measure(std::min(tag.end, span.end));
+        if (endX - startX > 2)
+          renderer.fillRectDither(startX + 1, lineY, endX - startX - 2, renderer.getLineHeight(font), Color::LightGray);
+      };
+      workflowy::forEachTag(title, highlightSpan);
+      if (timeRange) highlightSpan({timeRange->begin, timeRange->finish});
+      if (leading) renderer.drawText(font, textX, lineY, CONTINUATION);
+      int richWidth = -1;
+      if (!node.textStyles.empty() && !text.empty()) {
+        std::string styles(text.size(), '\0');
+        const auto count = std::min(text.size(), span.end - span.begin);
+        for (size_t byte = 0; byte < count; ++byte) {
+          const auto offset = wrapItems ? span.begin + byte :
+              workflowy::compactTaskOriginalOffset(bodyText, span.begin + byte);
+          const auto original = projection.originalOffset(span.metadata, offset);
+          if (original < node.textStyles.size()) styles[byte] = node.textStyles[original];
+        }
+        richWidth = workflowy::layoutStyledText(renderer, font, lineX, lineY, text, styles, true);
+      } else {
+        renderer.drawText(font, lineX, lineY, text.c_str());
+      }
+      if (node.done || (continues && line + 1 == placement.lineCount)) {
+        const int tail = lineX + (richWidth >= 0 ? richWidth : renderer.getTextWidth(font, text.c_str()));
+        if (node.done) renderer.drawLine(lineX, lineY + renderer.getLineHeight(font) / 2, tail, lineY + renderer.getLineHeight(font) / 2);
+        if (continues && line + 1 == placement.lineCount)
+          renderer.drawText(font, tail + CONTINUATION_GAP, lineY, CONTINUATION);
+      }
+    }
+    if (!selecting && firstFragment && !node.divider && (node.id == zoomId || !node.leaf)) {
+      paintedArrows.push_back({node.id, placement.top, placement.bottom});
+      drawZoomArrow(renderer, bounds.x + bounds.width - 10, y, node.id == zoomId, node.childrenConfirmed);
+    }
+  }
+  // Paint the marker over row artwork and keep its full thickness inside
+  // the target row, including at the last row on the page.
+  if (dropRow >= 0) {
+    for (auto i = pageStarts[page]; i < end; ++i) {
+      const auto& placement = placements[i];
+      if (placement.row != static_cast<size_t>(dropRow)) continue;
+      constexpr int thickness = 4;
+      const int left = bounds.x + 16 * (std::min<unsigned>(rows[placement.row].depth, 8) + dropInside);
+      const int marker = dropAfter || dropInside ? placement.bottom - thickness : placement.top;
+      renderer.fillRect(left, marker, bounds.x + bounds.width - left, thickness, true);
+      break;
+    }
+  }
+  const auto total = pageStarts.size();
+  const auto pending = pendingOperationsCount();
+  const auto* notice = statusNotice();
+  if (!pending && !notice && placements.empty()) notice = tr(STR_WORKFLOWY_EMPTY);
+  drawStatus(bounds, pending, notice);
+  constexpr int ICON_STROKE = 3;
+  if (total > 1) {
+    char pages[24];
+    snprintf(pages, sizeof(pages), "%u/%u", static_cast<unsigned>(page + 1), static_cast<unsigned>(total));
+    renderer.drawCenteredText(SMALL_FONT_ID, bounds.footer - renderer.getLineHeight(SMALL_FONT_ID) - 5, pages);
+    const int y = (bounds.rowBottom + bounds.footer) / 2;
+    for (const int direction : {-1, 1}) {
+      const bool enabled = direction < 0 ? page > 0 : page + 1 < total;
+      if (!enabled) continue;
+      for (const bool edge : {false, true}) {
+        const int slot = direction < 0 ? (edge ? 0 : 1) : (edge ? 7 : 6);
+        const int x = bounds.x + (2 * slot + 1) * bounds.width / 16;
+        const int tip = x + direction * 4;
+        renderer.drawLine(x - direction * 4, y - 6, tip, y, ICON_STROKE, true);
+        renderer.drawLine(tip, y, x - direction * 4, y + 6, ICON_STROKE, true);
+        if (edge) renderer.drawLine(tip + direction * 4, y - 6, tip + direction * 4, y + 6, ICON_STROKE, true);
+      }
+    }
+  }
+  renderer.drawLine(bounds.x, bounds.footer, bounds.x + bounds.width - 1, bounds.footer);
+  if (!selecting) {
+    const int iconY = bounds.footer + 23;
+    const workflowy::ActionBar actions{FOOTER_CONTROLS, viewStack.empty() ? 1 : 0};
+    const auto iconX = [&](TodoControl control) { return actions.center(static_cast<int>(control), bounds.x, bounds.width); };
+    int x = 0;
+    if (!viewStack.empty()) {
+      x = iconX(TodoControl::Back);
+      renderer.drawLine(x - 9, iconY, x + 9, iconY, ICON_STROKE, true);
+      renderer.drawLine(x - 9, iconY, x - 3, iconY - 6, ICON_STROKE, true);
+      renderer.drawLine(x - 9, iconY, x - 3, iconY + 6, ICON_STROKE, true);
+    }
+    const int viewX = iconX(TodoControl::ShowDone);
+    const int eyeX[] = {viewX - 11, viewX - 7, viewX, viewX + 7, viewX + 11, viewX + 7, viewX, viewX - 7};
+    const int eyeY[] = {iconY, iconY - 4, iconY - 6, iconY - 4, iconY, iconY + 4, iconY + 6, iconY + 4};
+    for (int i = 0; i < 8; ++i) {
+      const int next = (i + 1) % 8;
+      renderer.drawLine(eyeX[i], eyeY[i], eyeX[next], eyeY[next], ICON_STROKE, true);
+    }
+    renderer.fillRect(viewX - 2, iconY - 2, 5, 5);
+    if (!showDone) {
+      renderer.drawLine(viewX - 10, iconY + 8, viewX + 10, iconY - 8, ICON_STROKE + 2, false);
+      renderer.drawLine(viewX - 11, iconY + 7, viewX + 9, iconY - 9, ICON_STROKE, true);
+    }
+    x = iconX(TodoControl::Undo);
+    const int undoWidth = undoReady ? ICON_STROKE : ICON_STROKE - 1;
+    renderer.drawLine(x - 10, iconY - 3, x + 4, iconY - 3, undoWidth, true);
+    renderer.drawLine(x + 4, iconY - 3, x + 9, iconY + 2, undoWidth, true);
+    renderer.drawLine(x + 9, iconY + 2, x + 4, iconY + 8, undoWidth, true);
+    renderer.drawLine(x + 4, iconY + 8, x - 3, iconY + 8, undoWidth, true);
+    renderer.drawLine(x - 10, iconY - 3, x - 4, iconY - 9, undoWidth, true);
+    renderer.drawLine(x - 10, iconY - 3, x - 4, iconY + 3, undoWidth, true);
+    x = iconX(TodoControl::Wrap);
+    drawTaskSizeToggle(renderer, x, iconY, wrapItems);
+    const int calendarX = iconX(TodoControl::Calendar);
+    renderer.drawRect(calendarX - 11, iconY - 10, 23, 22);
+    renderer.drawLine(calendarX - 10, iconY - 3, calendarX + 10, iconY - 3, ICON_STROKE, true);
+    renderer.drawLine(calendarX - 5, iconY - 13, calendarX - 5, iconY - 7, ICON_STROKE, true);
+    renderer.drawLine(calendarX + 5, iconY - 13, calendarX + 5, iconY - 7, ICON_STROKE, true);
+    const int sortX = iconX(TodoControl::Sort);
+    renderer.drawRoundedRect(sortX - 12, iconY - 11, 17, 20, 1, 3, true);
+    renderer.drawLine(sortX - 4, iconY - 6, sortX - 4, iconY, 2, true);
+    renderer.drawLine(sortX - 4, iconY, sortX + 1, iconY + 3, 2, true);
+    renderer.drawLine(sortX + 10, iconY + 10, sortX + 10, iconY - 9, 2, true);
+    renderer.drawLine(sortX + 6, iconY - 5, sortX + 10, iconY - 9, 2, true);
+    renderer.drawLine(sortX + 10, iconY - 9, sortX + 14, iconY - 5, 2, true);
+    const auto refresh = freeink::ui::bitmapFromIcon(icon_refresh_cw_32);
+    freeink::ui::GfxRendererTarget target(renderer);
+    target.bitmap({static_cast<int16_t>(iconX(TodoControl::Refresh) - refresh.width / 2),
+                   static_cast<int16_t>(iconY - icon_refresh_cw_32.opticalCenterY),
+                   static_cast<int16_t>(refresh.width), static_cast<int16_t>(refresh.height)},
+                  refresh, freeink::ui::BitmapMode::Center);
+    const int mailX = iconX(TodoControl::Replies);
+    for (int inset = 0; inset < 2; ++inset)
+      renderer.drawRect(mailX - 12 + inset, iconY - 8 + inset, 25 - inset * 2, 18 - inset * 2);
+    renderer.drawLine(mailX - 11, iconY - 7, mailX, iconY + 1, ICON_STROKE, true);
+    renderer.drawLine(mailX, iconY + 1, mailX + 11, iconY - 7, ICON_STROKE, true);
+    if (replyOnly) renderer.drawLine(mailX - 12, iconY + 15, mailX + 12, iconY + 15, ICON_STROKE, true);
+    const int moveX = iconX(TodoControl::MoveUnfinished);
+    for (int inset = 0; inset < 2; ++inset)
+      renderer.drawRect(moveX - 13 + inset, iconY - 8 + inset, 14 - inset * 2, 17 - inset * 2);
+    renderer.drawLine(moveX - 2, iconY, moveX + 13, iconY, ICON_STROKE, true);
+    renderer.drawLine(moveX + 7, iconY - 6, moveX + 13, iconY, ICON_STROKE, true);
+    renderer.drawLine(moveX + 13, iconY, moveX + 7, iconY + 6, ICON_STROKE, true);
+    const int addX = iconX(TodoControl::Add);
+    renderer.drawLine(addX - 9, iconY, addX + 9, iconY, ICON_STROKE, true);
+    renderer.drawLine(addX, iconY - 9, addX, iconY + 9, ICON_STROKE, true);
+  }
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+}
