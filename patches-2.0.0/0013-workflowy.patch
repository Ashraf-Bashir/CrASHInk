+// A narrow contrasting halo keeps the bold now-line visible over event shading.
+// Never draw into the header/footer and never add a time label.
+void drawCalendarNowLine(GfxRenderer& renderer, int left, int right, int top, int bottom, int y) {
+  if (right <= left || y < top || y >= bottom) return;
+  const int haloTop = std::max(top, y - 3), haloBottom = std::min(bottom, y + 3);
+  const int inkTop = std::max(top, y - 2), inkBottom = std::min(bottom, y + 2);
+  renderer.fillRect(left, haloTop, right - left, haloBottom - haloTop, false);
+  renderer.fillRect(left, inkTop, right - left, inkBottom - inkTop, true);
+}
