+void WorkflowyDailyActivity::showBulkMenu() {
+  const auto count = selectionCount();
+  if (!count) return;
+  const bool hasTodo = std::any_of(rows.begin(), rows.end(), [](const Node& node) { return node.selected && node.todo; });
+  const bool hasBullet = std::any_of(rows.begin(), rows.end(), [](const Node& node) { return node.selected && !node.todo; });
+  const bool hasIncomplete = std::any_of(rows.begin(), rows.end(), [](const Node& node) {
+    return node.selected && node.todo && !node.done && !node.divider;
+  });
+  const bool hasComplete = std::any_of(rows.begin(), rows.end(), [](const Node& node) {
+    return node.selected && node.done && !node.divider;
+  });
+  enum class Command { Edit, Done, Undone, Schedule, Move, Convert, Zoom, Add, Delete };
+  std::vector<std::string> labels;
+  std::vector<bool> expandable;
+  std::vector<const freeink::Icon*> icons;icons.reserve(12);
+  std::vector<Command> commands;
+  labels.reserve(10);
+  commands.reserve(10);
+  const auto add = [&](Command command, StrId label) {
+    commands.push_back(command);
+    labels.emplace_back(I18n::getInstance().get(label));
+    icons.push_back(workflowyActionIcon(label));
+    expandable.push_back(command == Command::Add || command == Command::Schedule ||
+                         command == Command::Move || command == Command::Convert);
+  };
+  if (count == 1) add(Command::Edit, StrId::STR_EDIT);
+  if (hasIncomplete) add(Command::Done, StrId::STR_WORKFLOWY_MARK_DONE);
+  if (hasComplete) add(Command::Undone, StrId::STR_WORKFLOWY_MARK_UNDONE);
+  add(Command::Schedule, StrId::STR_WORKFLOWY_SCHEDULE_VIEW);
+  add(Command::Move, StrId::STR_WORKFLOWY_MOVE);
+  add(Command::Convert, StrId::STR_WORKFLOWY_TURN_INTO);
+  if (count == 1) add(Command::Zoom, StrId::STR_WORKFLOWY_ZOOM);
+  add(Command::Add, StrId::STR_WORKFLOWY_ADD);
+  add(Command::Delete, StrId::STR_DELETE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyBulk", StrId::STR_WORKFLOWY_BULK_ACTIONS,
+                             std::move(labels), 0, false, true, std::move(icons), std::move(expandable)),
+                         [this, commands = std::move(commands), hasTodo, hasBullet](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t index = std::get<OptionSelectionResult>(result.data).index;
+    if (index >= commands.size()) return;
+    const auto command = commands[index];
+    if (command == Command::Done) return startBulk(BulkAction::Done);
+    if (command == Command::Undone) return startBulk(BulkAction::Undone);
+    if (command == Command::Schedule) return scheduleSelection();
+    if (command == Command::Move) return showBulkMoveMenu();
+    if (command == Command::Convert) {
+      std::vector<std::string> types;
+      types.reserve(2);
+      if (hasBullet) types.emplace_back(tr(STR_WORKFLOWY_TODO_TYPE));
+      if (hasTodo) types.emplace_back(tr(STR_WORKFLOWY_BULLET_TYPE));
+      startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                                 renderer, mappedInput, "WorkflowyBulkType", StrId::STR_WORKFLOWY_TURN_INTO,
+                                 std::move(types), 0, false, true),
+                             [this, hasBullet](const ActivityResult& choice) {
+        if (choice.isCancelled) return;
+        startBulk(hasBullet && std::get<OptionSelectionResult>(choice.data).index == 0
+                      ? BulkAction::ToTodo : BulkAction::ToBullet);
+      });
+      return;
+    }
+    if (command == Command::Delete) {
+      char prompt[64];
+      snprintf(prompt, sizeof(prompt), tr(STR_WORKFLOWY_BULK_DELETE), static_cast<unsigned>(selectionCount()));
+      startActivityForResult(std::make_unique<ConfirmationActivity>(renderer, mappedInput, tr(STR_DELETE), prompt),
+                             [this](const ActivityResult& confirmed) {
+        if (!confirmed.isCancelled) startBulk(BulkAction::Delete);
+      });
+      return;
+    }
+    auto node = std::find_if(rows.begin(), rows.end(), [](const Node& node) { return node.selected; });
+    if (node == rows.end() || itemPending(node->id)) return;
+    if (command == Command::Add) {
+      const auto last = std::find_if(rows.rbegin(), rows.rend(), [](const Node& node) { return node.selected; });
+      return showAddMenu(node->id, last->id, true);
+    }
+    const size_t row = node - rows.begin();
+    cancelSelection();
+    if (command == Command::Edit) return edit(row);
+    if (command == Command::Zoom) return zoom(row);
+  });
+}
