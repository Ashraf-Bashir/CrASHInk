+void WorkflowyDailyActivity::clearSessionCache() {
+  auto dir = Storage.open(SESSION_CACHE);
+  if (!dir || !dir.isDirectory()) return;
+  char name[96];
+  for (auto file = dir.openNextFile(); file; file = dir.openNextFile()) {
+    if (!file.isDirectory()) {
+      file.getName(name, sizeof(name));
+      file.close();
+      const auto path = std::string(SESSION_CACHE) + "/" + name;
+      Storage.remove(path.c_str());
+    }
+  }
+  dir.close();
+  Storage.rmdir(SESSION_CACHE);
+}
+
+void WorkflowyDailyActivity::cacheChildren(const std::string& parent, const std::vector<Node>& children) {
+  if (parent.empty() || parent.size() > 80 || parent.find_first_not_of("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-") != std::string::npos || children.size() > MAX_ROWS) return;
+  for (const auto& node : children) if (node.id.empty() || node.id.size() > 80 || node.title.size() > 8192 || node.textStyles.size() > 8192) return;
+  Storage.mkdir("/.crashink");
+  Storage.mkdir(SESSION_CACHE);
+  const auto path = std::string(SESSION_CACHE) + "/" + parent;
+  // Bound session storage by 48 views; evict the oldest cached view on overflow.
+  if (!Storage.exists(path.c_str())) {
+    auto dir = Storage.open(SESSION_CACHE);
+    size_t count = 0; uint32_t oldestAge = 0; std::string oldest;
+    char name[96];
+    for (auto file = dir.openNextFile(); file; file = dir.openNextFile()) {
+      if (file.isDirectory()) continue;
+      ++count; uint32_t header[2]{};
+      if (file.read(reinterpret_cast<uint8_t*>(header), sizeof(header)) == sizeof(header)) {
+        const auto age = static_cast<uint32_t>(millis()) - header[1];
+        if (oldest.empty() || age >= oldestAge) { file.getName(name, sizeof(name)); oldest = name; oldestAge = age; }
+      }
+      file.close();
+    }
+    dir.close();
+    if (count >= 48 && !oldest.empty()) Storage.remove((std::string(SESSION_CACHE) + "/" + oldest).c_str());
+  }
+  const auto temp = path + ".tmp";
+  auto file = Storage.open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC);
+  if (!file) return;
+  const auto write = [&](const void* data, size_t bytes) { return file.write(reinterpret_cast<const uint8_t*>(data), bytes) == bytes; };
+  const uint32_t header[] = {0x57464333, static_cast<uint32_t>(millis())};
+  const uint16_t count = children.size();
+  bool ok = write(header, sizeof(header)) && write(&count, sizeof(count));
+  for (const auto& node : children) {
+    if (!ok) break;
+    const uint8_t idLength = node.id.size(); const uint16_t titleLength = node.title.size();
+    const uint16_t stylesLength = node.textStyles.size();
+    const int32_t priority = node.priority;
+    const uint8_t flags = node.todo | (node.done << 1) | (node.leaf << 2) | (node.childrenConfirmed << 3) |
+                          (node.divider << 4) | (node.scheduledDivider << 5) | (node.legacyDividerNote << 6);
+    ok = write(&idLength, 1) && write(&titleLength, 2) && write(&stylesLength, 2) && write(&priority, 4) && write(&flags, 1) &&
+         write(node.id.data(), idLength) && write(node.title.data(), titleLength) && write(node.textStyles.data(), stylesLength);
+  }
+  ok = ok && file.sync();file.close();
+  if (ok) { Storage.remove(path.c_str()); Storage.rename(temp.c_str(), path.c_str()); }
+  else Storage.remove(temp.c_str());
+}
+
+bool WorkflowyDailyActivity::cachedChildren(const std::string& parent, unsigned depth, std::vector<Node>& children, uint32_t& at) {
+  if (parent.empty() || parent.size() > 80 || parent.find_first_not_of("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-") != std::string::npos) return false;
+  auto file = Storage.open((std::string(SESSION_CACHE) + "/" + parent).c_str());
+  if (!file || file.size() > 512 * 1024) return false;
+  const auto read = [&](void* data, size_t bytes) { return file.read(reinterpret_cast<uint8_t*>(data), bytes) == static_cast<int>(bytes); };
+  uint32_t header[2]{};uint16_t count=0;
+  if (!read(header, sizeof(header)) || header[0] != 0x57464333 || !read(&count,2) || count > MAX_ROWS ||
+      ESP.getMaxAllocHeap() < count * sizeof(Node) + 32768) return false;
+  children.clear();children.reserve(count);
+  for (unsigned i=0;i<count;++i) {
+    uint8_t idLength=0, flags=0;uint16_t titleLength=0, stylesLength=0;int32_t priority=0;
+    if (!read(&idLength,1) || !read(&titleLength,2) || !read(&stylesLength,2) || !read(&priority,4) || !read(&flags,1) ||
+        !idLength || idLength>80 || titleLength>8192 || (stylesLength && stylesLength != titleLength)) {children.clear();return false;}
+    Node node;node.id.resize(idLength);node.title.resize(titleLength);node.textStyles.resize(stylesLength);
+    if (!read(node.id.data(),idLength) || !read(node.title.data(),titleLength) || !read(node.textStyles.data(),stylesLength)) {children.clear();return false;}
+    node.depth=depth;node.priority=priority;node.todo=flags&1;node.done=flags&2;node.leaf=flags&4;
+    node.childrenConfirmed=flags&8;node.divider=flags&16;node.scheduledDivider=flags&32;node.legacyDividerNote=flags&64;
+    children.push_back(std::move(node));
+  }
+  at=header[1];return true;
+}
+
+void WorkflowyDailyActivity::onEnter() {
+  Activity::onEnter();
+  {
+    RenderLock lock;
+    // Library/reader fonts are unused here; release them before TLS allocates.
+    sdFontSystem.releaseForNetwork(renderer);
+  }
+  onUserInput();
+  clearSessionCache();
+  credential = workflowy::readSetting(workflowy::KEY_FILE, workflowy::KEY_MAX);
+  date = isoDate(0);
+  if (date.empty()) date = "today";
+  // Remember sorted sections even while all their timed tasks are completed and
+  // the separator is absent. Keep a bounded, credential-free on-device list.
+  const auto sorted = workflowy::readSetting(SORTED_PARENTS, 32 * 75);
+  timedSectionParents.reserve(32);timedSectionDividers.reserve(32);
+  for (size_t begin=0;begin<sorted.size() && timedSectionParents.size()<32;) {
+    const auto end=sorted.find(',',begin);
+    const auto record=sorted.substr(begin,end==std::string::npos?end:end-begin);
+    const auto equal=record.find('=');const auto id=record.substr(0,equal);
+    if (!id.empty() && id.size()<=36 && id.find_first_not_of("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-")==std::string::npos) {
+      timedSectionParents.push_back(id);
+      timedSectionDividers.push_back(equal==std::string::npos?"":record.substr(equal+1));
+    }
+    if(end==std::string::npos)break;begin=end+1;
+  }
+  outbox = workflowy::readSetting(OUTBOX, OUTBOX_LIMIT);
+  JsonDocument saved;
+  if (!outbox.empty() && !deserializeJson(saved, outbox)) {
+    pendingCount = saved["items"].size();
+    outboxUncertain = saved["sending"] | false;
+  }
+  online = hasActiveStationWifiConnection();
+  calendarReturnHome = startInCalendar;
+  if (startInCalendar) openCalendar(false);
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::onExit() {
+  // A keyboard/calendar popup only suspends this activity; onExit means leaving
+  // Workflowy. Stop its radio even when it inherited an existing connection.
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+  if (timeChoices) timeChoices->cancel.store(true, std::memory_order_relaxed);
+  for (const auto& save : saves) save->cancel.store(true, std::memory_order_relaxed);
+  WiFi.setAutoReconnect(false);
+  WiFi.disconnect(true, false);
+  WiFi.mode(WIFI_OFF);
+  ownsWifi = false;
+  if (timeChoices) {
+    timeChoices->cancel.store(true, std::memory_order_relaxed);
+    while (timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+    timeChoices.reset();
+  }
+  if (calendarFetch) {
+    calendarFetch->cancel.store(true, std::memory_order_relaxed);
+    while (!calendarFetch->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+    calendarFetch.reset();
+  }
+  for (const auto& save : saves) {
+    if (!save->started) break;
+    while (!save->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+  }
+  saves.clear();
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  if (scanningWifi) WiFi.scanDelete();
+  // The fetch owns a TLS session. Wait for its cleanup before the Library can open.
+  while (prefetch && !prefetch->ready.load(std::memory_order_acquire)) vTaskDelay(1);
+  prefetch.reset();
+  clearSessionCache();
+  Activity::onExit();
+}
+
+void WorkflowyDailyActivity::showMessage(const char* text) {
+  {
+    RenderLock lock(*this);
+    // Empty is a view state, not an operation error. Render it only when the
+    // visible list really is empty, never as a sticky Sort/Move error banner.
+    message = text == tr(STR_WORKFLOWY_EMPTY) ? nullptr : text;
+  }
+  requestUpdate();
+}
+
+std::string WorkflowyDailyActivity::errorDescription() const {
+  std::string details;
+  if(lastStatus==401 || lastStatus==403)details="Authentication failed. Check the Workflowy API key and account access.";
+  else if(lastStatus==404)details="The destination node was not found. It may have moved or been deleted.";
+  else if(lastStatus==429)details="Workflowy is limiting requests. Wait before retrying.";
+  else if(lastStatus==400)details="Workflowy rejected the request as invalid.";
+  else if(lastStatus>=500)details="Workflowy server failed to handle the request.";
+  else if(lastStatus==-6 || lastTransport==ESP_ERR_TIMEOUT)details="The operation timed out. Refresh to check whether the server accepted the change before retrying.";
+  else if(lastStatus==-5 || lastTransport==ESP_ERR_NO_MEM)details="Not enough free memory to start or finish this operation.";
+  else if(lastStatus==-2)details="The device clock could not be synchronized. Check Wi-Fi and the device date/time.";
+  else if(lastStatus==-3)details="Workflowy returned an invalid, incomplete, or oversized response.";
+  else if(lastStatus==-4)details="This request was canceled.";
+  else if(lastStatus<=0)details="The connection ended without a valid response. Check Wi-Fi and retry.";
+  if(lastStatus){details+="\nHTTP/status: ";details+=std::to_string(lastStatus);}
+  if(lastTransport!=ESP_OK){details+="\nTransport: ";details+=esp_err_to_name(lastTransport);}
+  if(!lastServerError.empty()){details+="\nServer: ";details+=lastServerError;}
+  return details;
+}
+
+void WorkflowyDailyActivity::showOperationError(size_t index) {
+  if(index>=operationErrors.size())return;
+  auto details=operationErrors[index].action+"\n"+operationErrors[index].title+"\n\n"+operationErrors[index].details;
+  startActivityForResult(std::make_unique<WorkflowyErrorDetails>(renderer,mappedInput,tr(STR_WORKFLOWY_SEND_FAILED),std::move(details)),
+    [this,index](const ActivityResult&){
+      if(index<operationErrors.size())operationErrors.erase(operationErrors.begin()+index);
+      if(isErrorNotice(message))message=nullptr;
+      requestUpdate();
+    });
+}
+
+void WorkflowyDailyActivity::showErrorDetails() {
+  if (!isErrorNotice(message)) return;
+  std::string details;
+  if (message == tr(STR_WORKFLOWY_OUTBOX_ACCOUNT) || message == tr(STR_WORKFLOWY_SAVE_FAILED)) {
+    details = tr(STR_WORKFLOWY_LOCAL_SAVE_DETAILS);
+  } else if (!online && lastStatus <= 0) {
+    details = tr(STR_WORKFLOWY_NO_WIFI_DETAILS);
+  } else if (message == tr(STR_WORKFLOWY_CLOCK_FAILED) || lastStatus == -2) {
+    details = tr(STR_WORKFLOWY_CLOCK_DETAILS);
+  } else if (lastStatus >= 400) {
+    details = "HTTP " + std::to_string(lastStatus);
+    if (lastStatus == 401 || lastStatus == 403) details += " · " + std::string(tr(STR_WORKFLOWY_AUTH_FAILED));
+    if (lastStatus == 429) details += " · " + std::string(tr(STR_WORKFLOWY_RATE_LIMIT));
+  } else if (lastTransport != ESP_OK || lastStatus == -5) {
+    details = esp_err_to_name(lastStatus == -5 ? ESP_ERR_NO_MEM : lastTransport);
+  } else if (lastStatus == -3) {
+    details = tr(STR_WORKFLOWY_RESPONSE_DETAILS);
+  }
+  const auto explanation=errorDescription();
+  if(!explanation.empty()){if(!details.empty())details+="\n\n";details+=explanation;}
+  startActivityForResult(std::make_unique<WorkflowyErrorDetails>(renderer, mappedInput, message, std::move(details)),
+                         [](const ActivityResult&) {});
+}
+
+void WorkflowyDailyActivity::connect() {
+  if (workflowy::shareInProgress()) return;
+  if (credential.empty()) return editKey();
+  if (hasActiveStationWifiConnection()) {
+    {
+      RenderLock lock(*this);
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+    return;
+  }
+  if (!WIFI_STORE.getCredentialCount()) return showWifiPicker();
+  WiFi.persistent(false);
+  const auto previousMode = WiFi.getMode();
+  if (!WiFi.mode(WIFI_STA)) {
+    step = Step::Ready;
+    return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  }
+  ownsWifi = ownsWifi || previousMode == WIFI_OFF;
+  WiFi.setAutoReconnect(false);
+  WiFi.setScanMethod(WIFI_ALL_CHANNEL_SCAN);
+  WiFi.setSortMethod(WIFI_CONNECT_AP_BY_SIGNAL);
+  savedWifiCandidates.clear();
+  scannedSavedWifi = false;
+  const auto last = WIFI_STORE.getLastConnectedSsid();
+  if (!last.empty() && WIFI_STORE.hasSavedCredential(last)) trySavedWifi(last);
+  else scanSavedWifi();
+  {
+    RenderLock lock(*this);
+    connectingWifi = true;
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::trySavedWifi(const std::string& ssid) {
+  const auto saved = WIFI_STORE.findCredential(ssid);
+  if (saved) {
+    const auto* password = saved->password.empty() ? nullptr : saved->password.c_str();
+    WiFi.begin(saved->ssid.c_str(), password);
+  }
+  wifiStartedAt = millis();
+}
+
+void WorkflowyDailyActivity::scanSavedWifi() {
+  WiFi.disconnect(false, false);
+  WiFi.scanDelete();
+  scanningWifi = true;
+  scannedSavedWifi = true;
+  wifiStartedAt = millis();
+  WiFi.scanNetworks(true);
+}
+
+void WorkflowyDailyActivity::pollWifiConnection() {
+  if (!connectingWifi || tracking) return;
+  if (hasActiveStationWifiConnection()) {
+    if (scanningWifi) WiFi.scanDelete();
+    scanningWifi = false;
+    savedWifiCandidates.clear();
+    const std::string connectedSsid = WiFi.SSID().c_str();
+    if (connectedSsid != WIFI_STORE.getLastConnectedSsid()) WIFI_STORE.setLastConnectedSsid(connectedSsid);
+    {
+      RenderLock lock(*this);
+      connectingWifi = false;
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+    return;
+  }
+  if (scanningWifi) {
+    const int count = WiFi.scanComplete();
+    if (count == WIFI_SCAN_RUNNING && millis() - wifiStartedAt < 10000) return;
+    const auto last = WIFI_STORE.getLastConnectedSsid();
+    for (int i = 0; i < count && savedWifiCandidates.size() < WIFI_STORE.getCredentialCount(); ++i) {
+      const std::string ssid = WiFi.SSID(i).c_str();
+      if (ssid != last && WIFI_STORE.hasSavedCredential(ssid) &&
+          std::find(savedWifiCandidates.begin(), savedWifiCandidates.end(), ssid) == savedWifiCandidates.end()) {
+        savedWifiCandidates.push_back(ssid);
+      }
+    }
+    WiFi.scanDelete();
+    scanningWifi = false;
+    if (savedWifiCandidates.empty()) {
+      wifiStartedAt = millis() - SAVED_WIFI_TIMEOUT;
+    }
+  } else if (millis() - wifiStartedAt < SAVED_WIFI_TIMEOUT) {
+    return;
+  }
+  if (!scannedSavedWifi) return scanSavedWifi();
+  if (!savedWifiCandidates.empty()) {
+    const auto next = std::move(savedWifiCandidates.front());
+    savedWifiCandidates.erase(savedWifiCandidates.begin());
+    WiFi.disconnect(false, false);
+    return trySavedWifi(next);
+  }
+  if (tracking || !saves.empty()) return;
+  {
+    RenderLock lock(*this);
+    connectingWifi = false;
+  }
+  if (ownsWifi) {
+    WiFi.disconnect(false, false);
+    WiFi.mode(WIFI_OFF);
+    ownsWifi = false;
+  }
+  showWifiPicker();
+}
+
+void WorkflowyDailyActivity::showWifiPicker() {
+  const bool hadConnection = hasActiveStationWifiConnection();
+  connectingWifi=false;
+  if(scanningWifi)WiFi.scanDelete();
+  scanningWifi=false;savedWifiCandidates.clear();
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<WifiSelectionActivity>(renderer, mappedInput, true),
+                         [this, hadConnection](const ActivityResult& result) {
+    const auto* wifi = std::get_if<WifiResult>(&result.data);
+    if (result.isCancelled || !wifi || !wifi->connected) {
+      step = Step::Ready;
+      return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    }
+    ownsWifi = ownsWifi || !hadConnection;
+    {
+      RenderLock lock(*this);
+      online = true;
+      awaitingOutline = true;
+      message = nullptr;
+    }
+    step = Step::Load;
+    requestUpdate();
+  });
+}
+
+void WorkflowyDailyActivity::refresh(bool configure) {
+  if (connectingWifi) {
+    connectingWifi = false;
+    if (scanningWifi) WiFi.scanDelete();
+    scanningWifi = false;
+    return showWifiPicker();
+  }
+  if (!online && !configure) return showWifiPicker();
+  if (configure) {
+    if (!saves.empty()) return;
+    startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                               renderer, mappedInput, "WorkflowyConnection", StrId::STR_SYSTEM_NETWORK_SYNC,
+                               std::vector<std::string>{tr(STR_WIFI_NETWORKS), tr(STR_WORKFLOWY_API_KEY)}, 0, false, true),
+                           [this](const ActivityResult& result) {
+      if (result.isCancelled) return;
+      if (std::get<OptionSelectionResult>(result.data).index == 0) showWifiPicker();
+      else editKey();
+    });
+    return;
+  }
+  forceNetworkRefresh = true;
+  clearSessionCache();
+  if (hasActiveStationWifiConnection() && !credential.empty()) {
+    {
+      RenderLock lock(*this);
+      for (auto& row : rows) if (row.id != zoomId && row.leaf) row.leaf = false;
+    }
+    loadDay();
+  } else {
+    step = Step::Start;
+  }
+}
+
+void WorkflowyDailyActivity::editKey() {
+  step = Step::Waiting;
+  startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                             renderer, mappedInput, tr(STR_WORKFLOWY_API_KEY), "", workflowy::KEY_MAX, InputType::Password),
+                         [this](const ActivityResult& result) {
+    step = Step::Ready;
+    if (result.isCancelled) return;
+    const auto& key = std::get<KeyboardResult>(result.data).text;
+    if (key.empty() || !workflowy::writeSetting(workflowy::KEY_FILE, key)) {
+      showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    credential = key;
+    step = Step::Start;
+  });
+}
+
+void WorkflowyDailyActivity::recordServerError(int status, int transport, const std::string& errorBody,
+                                                 const std::string& key) {
+  lastStatus = status;
+  lastTransport = transport;
+  lastServerError.clear();
+  if (!errorBody.empty()) {
+    JsonDocument error;
+    if (!deserializeJson(error, errorBody)) {
+      const char* reason = error["message"] | "";
+      if (!*reason) reason = error["error"]["message"] | "";
+      if (!*reason) reason = error["error"] | "";
+      if (!*reason) reason = error["code"] | "";
+      lastServerError = plainTitle(reason);
+      if (!key.empty()) {
+        for (size_t at = 0; (at = lastServerError.find(key, at)) != std::string::npos; at += 3) {
+          lastServerError.replace(at, key.size(), "***");
+        }
+      }
+    }
+  }
+}
+
+void WorkflowyDailyActivity::onUserInput() { lastUserInputAt = static_cast<uint32_t>(millis()); }
+
+bool WorkflowyDailyActivity::idleTimeoutExpired() const {
+  return static_cast<uint32_t>(millis()) - lastUserInputAt >= IDLE_CLOSE_MS;
+}
+
+bool WorkflowyDailyActivity::preventAutoSleep() {
+  const auto now = static_cast<uint32_t>(millis());
+  return std::any_of(saves.begin(), saves.end(), [&](const auto& save) {
+    return !save->ready.load(std::memory_order_acquire) && !workflowy::saveTimedOut(save->queuedAt, now);
+  });
+}
+
+void WorkflowyDailyActivity::saveTask(void* argument) {
+  auto& save = *static_cast<Save*>(argument);
+  if (save.cancel.load(std::memory_order_relaxed) || workflowy::saveTimedOut(save.queuedAt, millis())) save.status = -4;
+  else if (save.work) save.work(save);
+  else save.status = requestForSave(save, save.method, save.path, save.body,
+                               save.captureResponse ? save.response.data() : nullptr,
+                               &save.received, save.response.size(), nullptr, nullptr, &save.transport, &save.error);
+  if (workflowy::saveTimedOut(save.queuedAt, millis())) {
+    save.status = -6;
+    save.transport = ESP_ERR_TIMEOUT;
+    save.error = SAVE_TIMEOUT_ERROR;
+  }
+  save.ready.store(true, std::memory_order_release);
+  vTaskDelete(nullptr);
+}
+
+bool WorkflowyDailyActivity::itemPending(const std::string& id) const {
+  return !id.empty() &&
+         (id == pendingDelete || std::any_of(saves.begin(), saves.end(), [&](const auto& save) {
+           return save->item == id || (save->timedItems &&
+                  std::any_of(save->timedItems->begin(), save->timedItems->end(),
+                              [&](const auto& item) { return item.second == id; }));
+         }));
+}
+
+void WorkflowyDailyActivity::refreshOfflineQueuePreview() {
+  std::vector<std::string> preview;
+  JsonDocument document;
+  if (!outbox.empty() && !deserializeJson(document, outbox)) {
+    for (const auto& item : document["items"].as<JsonArray>()) {
+      const auto title = plainTitle(item["name"] | "");
+      preview.push_back(title.substr(0, 120));
+    }
+  }
+  RenderLock lock(*this);
+  offlineQueuePreview = std::move(preview);
+}
+
+size_t WorkflowyDailyActivity::pendingOperationsCount() const {
+  const bool sendingCapture = pendingCount && std::any_of(saves.begin(), saves.end(), [](const auto& save) {
+    return save->fromOutbox;
+  });
+  size_t calendarReads = 0;
+  if (calendarVisible) {
+    for (const auto& day : calendarDays) if (!day.date.empty() && !day.loaded) ++calendarReads;
+  }
+  return saves.size() + pendingCount - sendingCapture + !requestedBranch.empty() + calendarReads +
+         (!calendarVisible && awaitingOutline);
+}
+
+void WorkflowyDailyActivity::showPendingOperations() {
+  {
+    RenderLock lock(*this);
+    queueVisible = !queueVisible;
+    queuePage = 0;
+    if (!queueVisible) offlineQueuePreview.clear();
+    tracking = dragging = false;
+  }
+  if (queueVisible) refreshOfflineQueuePreview();
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::queueSave(std::string path, std::string body, bool capture,
+                                       std::function<void(const Save&)> finish, const char* method,
+                                       StrId label, std::string item, std::function<void(Save&)> work) {
+  if (saves.size() >= MAX_SAVE_QUEUE) {
+    showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+    return false;
+  }
+  auto save = makeUniqueNoThrow<Save>();
+  if (!save) {
+    recordServerError(-5, ESP_ERR_NO_MEM, {}, credential);
+    showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    return false;
+  }
+  save->queuedAt = millis();
+  save->key = credential;
+  save->path = std::move(path);
+  save->body = std::move(body);
+  save->captureResponse = capture;
+  save->finish = std::move(finish);
+  save->method = method;
+  save->label = label;
+  save->item = std::move(item);
+  save->work = std::move(work);
+  const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& row) { return row.id == save->item; });
+  if (node != rows.end()) save->title = node->title.substr(0, 120);
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+  if (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire))
+    timeChoices->cancel.store(true, std::memory_order_relaxed);
+  {
+    RenderLock lock(*this);
+    saves.push_back(std::move(save));
+    message = nullptr;
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::serviceBackgroundWork() {
+  const auto now = static_cast<uint32_t>(millis());
+  for (auto& save : saves) {
+    if (save->ready.load(std::memory_order_acquire) || !workflowy::saveTimedOut(save->queuedAt, now)) continue;
+    save->cancel.store(true, std::memory_order_relaxed);
+    // The worker owns its result until ready. Never free/kill it mid-TLS; a
+    // bounded socket timeout and cooperative cancellation release it safely.
+    if (!save->started) {
+      save->status = -6;
+      save->transport = ESP_ERR_TIMEOUT;
+      save->error = SAVE_TIMEOUT_ERROR;
+      save->ready.store(true, std::memory_order_release);
+    }
+  }
+  if (saves.empty()) {
+    pollTimeChoices();
+    return;
+  }
+  for (auto& item : saves) {
+    auto& save = *item;
+    if (save.ready.load(std::memory_order_acquire)) continue;
+    if (save.started || (prefetch && !prefetch->ready.load(std::memory_order_acquire)) ||
+        (calendarFetch && !calendarFetch->ready.load(std::memory_order_acquire)) ||
+        (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire))) return;
+    prefetch.reset();
+    calendarFetch.reset();
+    save.started = true;
+    if (xTaskCreate(saveTask, "wf-save", 8192, &save, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+      save.status = -5;
+      save.transport = ESP_ERR_NO_MEM;
+      save.ready.store(true, std::memory_order_release);
+    }
+    return;
+  }
+}
+
+bool WorkflowyDailyActivity::pollSave() {
+  if (saves.empty() || !saves.front()->ready.load(std::memory_order_acquire)) return false;
+  std::unique_ptr<Save> completed;
+  {
+    RenderLock lock(*this);
+    completed = std::move(saves.front());
+    saves.pop_front();
+    layoutDirty = true;
+  }
+  recordServerError(completed->status, completed->transport, completed->error, completed->key);
+  if(completed->status<200 || completed->status>=300){
+    if(operationErrors.size()>=8)operationErrors.pop_front();
+    operationErrors.push_back({I18n::getInstance().get(completed->label),completed->title,errorDescription()});
+  }
+  timedSectionDirty = true;
+  clearSessionCache();
+  forceNetworkRefresh = true;
+  completed->finish(*completed);
+  if (leaveAfterSave && saves.empty()) {
+    leaveAfterSave = false;
+    if (!queueVisible) back();
+  }
+  requestUpdate();
+  return true;
+}
+
+int WorkflowyDailyActivity::requestForSave(Save& save, const char* method, const std::string& path,
+                                           const std::string& body, uint8_t* response, size_t* received,
+                                           size_t capacity, HeapByteBuffer* growable,
+                                           const std::atomic<bool>* cancel, int* transport, std::string* serverError) {
+  if (save.cancel.load(std::memory_order_relaxed)) return -4;
+  return requestWithKey(save.key, method, path, body, response, received, capacity, growable,
+                        cancel ? cancel : &save.cancel, transport ? transport : &save.transport,
+                        serverError ? serverError : &save.error, &save.queuedAt);
+}
+
+int WorkflowyDailyActivity::requestWithKey(const std::string& key, const char* method, const std::string& path,
+                                          const std::string& body, uint8_t* response, size_t* received,
+                                          size_t capacity, HeapByteBuffer* growable,
+                                          const std::atomic<bool>* cancel, int* transport,
+                                          std::string* serverError, const uint32_t* saveQueuedAt) {
+  const auto expired = [&] { return saveQueuedAt && workflowy::saveTimedOut(*saveQueuedAt, millis()); };
+  const auto timeout = [&] {
+    if (transport) *transport = ESP_ERR_TIMEOUT;
+    if (serverError) *serverError = SAVE_TIMEOUT_ERROR;
+    return -6;
+  };
+  if (expired()) return timeout();
+  if (cancel && cancel->load(std::memory_order_relaxed)) return -4;
+  if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) {
+    return -2;
+  }
+  if (expired()) return timeout();
+  struct Response {
+    const uint32_t* queuedAt;
+    uint8_t* buffer;
+    size_t* used;
+    size_t capacity;
+    HeapByteBuffer* growable;
+    const std::atomic<bool>* cancel;
+    std::string* serverError;
+    bool overflow = false;
+  } sink{saveQueuedAt, response, received, capacity, growable, cancel, serverError};
+
+  const auto url = std::string(API) + path;
+  esp_http_client_config_t config{};
+  config.url = url.c_str();
+  config.method = strcmp(method, "GET") == 0 ? HTTP_METHOD_GET
+                  : strcmp(method, "DELETE") == 0 ? HTTP_METHOD_DELETE
+                                                  : HTTP_METHOD_POST;
+  config.crt_bundle_attach = esp_crt_bundle_attach;
+  config.user_agent = "CrASHInk/Workflowy";
+  config.timeout_ms = cancel && !saveQueuedAt ? 5000 : 12000;
+  if (saveQueuedAt) {
+    config.timeout_ms = std::max<uint32_t>(1, std::min<uint32_t>(config.timeout_ms,
+                                      workflowy::saveTimeRemaining(*saveQueuedAt, millis())));
+  }
+  config.disable_auto_redirect = true;
+  config.max_authorization_retries = -1;
+  config.user_data = &sink;
+  config.event_handler = [](esp_http_client_event_t* event) -> esp_err_t {
+    auto& target = *static_cast<Response*>(event->user_data);
+    if ((target.cancel && target.cancel->load(std::memory_order_relaxed)) ||
+        (target.queuedAt && workflowy::saveTimedOut(*target.queuedAt, millis()))) return ESP_FAIL;
+    if (event->event_id != HTTP_EVENT_ON_DATA || event->data_len <= 0) return ESP_OK;
+    const auto length = static_cast<size_t>(event->data_len);
+    if (target.serverError && esp_http_client_get_status_code(event->client) >= 400) {
+      const size_t available = MAX_ERROR_BODY - target.serverError->size();
+      target.serverError->append(static_cast<const char*>(event->data), std::min(available, length));
+      return ESP_OK;
+    }
+    if (!target.buffer && !target.growable) return ESP_OK;
+    const auto needed = *target.used + length;
+    if (!target.overflow && target.growable && needed > target.capacity && needed <= MAX_RESPONSE) {
+      const size_t expanded = std::max(needed, std::min(MAX_RESPONSE, std::max<size_t>(4096, target.capacity * 2)));
+      auto* resized = static_cast<uint8_t*>(
+          heap_caps_realloc(target.buffer, expanded, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+      if (resized) {
+        target.growable->release();
+        target.growable->reset(resized);
+        target.buffer = resized;
+        target.capacity = expanded;
+      }
+    }
+    if (target.overflow || needed > target.capacity) {
+      target.overflow = true;
+      return ESP_ERR_NO_MEM;
+    }
+    memcpy(target.buffer + *target.used, event->data, length);
+    *target.used += length;
+    return ESP_OK;
+  };
+
+  auto client = esp_http_client_init(&config);
+  if (!client) {
+    if (transport) *transport = ESP_ERR_NO_MEM;
+    return 0;
+  }
+  const auto authorization = "Bearer " + key;
+  auto result = esp_http_client_set_header(client, "Authorization", authorization.c_str());
+  if (result == ESP_OK && !body.empty()) {
+    result = esp_http_client_set_header(client, "Content-Type", "application/json");
+    if (result == ESP_OK) result = esp_http_client_set_post_field(client, body.data(), body.size());
+  }
+  if (result == ESP_OK && config.method == HTTP_METHOD_POST && body.empty()) {
+    result = esp_http_client_set_header(client, "Content-Length", "0");
+  }
+  if (result == ESP_OK) result = esp_http_client_perform(client);
+  const int status = esp_http_client_get_status_code(client);
+  const bool complete = esp_http_client_is_complete_data_received(client);
+  if (result != ESP_OK || status >= 400) {
+    LOG_ERR("WF", "Workflowy %s failed: transport=%s HTTP=%d", method, esp_err_to_name(result), status);
+  }
+  esp_http_client_cleanup(client);
+  if (transport) {
+    *transport = sink.overflow ? ESP_ERR_NO_MEM
+                 : result == ESP_OK && !complete && (response || growable) ? ESP_ERR_HTTP_INCOMPLETE_DATA
+                                                                          : result;
+  }
+  if (expired()) return timeout();
+  if (cancel && cancel->load(std::memory_order_relaxed)) return -4;
+  if (status >= 400) return status;
+  return result == ESP_OK && !sink.overflow && (complete || (!response && !growable)) ? status : 0;
+}
+
+int WorkflowyDailyActivity::fetchChildren(const std::string& key, const std::string& parent, unsigned depth,
+                                         std::vector<Node>& result, const std::atomic<bool>* cancel, int* transport, const uint32_t* saveQueuedAt, std::string* serverError) {
+  HeapByteBuffer response;
+  size_t received = 0;
+  const int status = requestWithKey(key, "GET", "?parent_id=" + parent, {}, nullptr, &received, 0, &response, cancel, transport, serverError, saveQueuedAt);
+  if (status == 404 && depth == 0) return 200;
+  if (status != 200) return status;
+  if (!response) return -3;
+  JsonDocument filter;
+  auto node = filter["nodes"][0];
+  node["id"] = true;
+  node["name"] = true;
+  node["priority"] = true;
+  node["completed"] = true;
+  node["data"]["layoutMode"] = true;
+  node["note"] = true;
+  ResponseAllocator allocator;
+  JsonDocument doc(&allocator);
+  if (deserializeJson(doc, response.get(), received, DeserializationOption::Filter(filter)) || !doc["nodes"].is<JsonArray>()) {
+    return -3;
+  }
+  const auto nodes = doc["nodes"].as<JsonArrayConst>();
+  if (nodes.size() > MAX_ROWS) {
+    return -3;
+  }
+  result.reserve(nodes.size());
+  const auto knownDividers = workflowy::readSetting(SORTED_PARENTS, 32 * 75);
+  const auto recordedDivider=workflowy::readSetting((std::string(DIVIDER_REGISTRY)+"/"+parent).c_str(),80);
+  for (const auto value : nodes) {
+    std::string id = value["id"] | "";
+    if (id.empty() || id.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) continue;
+    std::string styles;
+    auto title = plainTitle(value["name"] | "", &styles);
+    result.push_back({std::move(id), std::move(title), depth, value["priority"] | 0,
+                      strcmp(value["data"]["layoutMode"] | "", "todo") == 0, value["completed"] | false});
+    result.back().textStyles = std::move(styles);
+    result.back().divider = strcmp(value["data"]["layoutMode"] | "", "divider") == 0;
+    result.back().legacyDividerNote = result.back().divider && strcmp(value["note"] | "", "crASHink:scheduled-divider") == 0;
+    const auto marker = "=" + result.back().id;
+    const auto savedAt = knownDividers.find(marker);
+    const bool remembered = savedAt != std::string::npos &&
+                            (savedAt+marker.size()==knownDividers.size() || knownDividers[savedAt+marker.size()]==',');
+    result.back().scheduledDivider = result.back().divider && (result.back().legacyDividerNote || remembered || recordedDivider==result.back().id);
+  }
+  std::stable_sort(result.begin(), result.end(), [](const Node& a, const Node& b) { return a.priority < b.priority; });
+  if (!cancel || !cancel->load(std::memory_order_relaxed)) cacheChildren(parent, result);
+  return 200;
+}
+
+void WorkflowyDailyActivity::syncNode(const Node& updated) {
+  for (auto& view : viewStack) {
+    for (auto& copy : view.rows) {
+      if (copy.id != updated.id) continue;
+      copy.done = updated.done;
+      copy.todo = updated.todo;
+      copy.title = updated.title;
+    }
+  }
+}
+
+void WorkflowyDailyActivity::appendChild(std::vector<Node>& outline, const std::string& parent, Node node) {
+  if (parent.empty()) {
+    if (outline.size() < MAX_ROWS) outline.push_back(std::move(node));
+    return;
+  }
+  auto owner = std::find_if(outline.begin(), outline.end(), [&](const Node& row) { return row.id == parent; });
+  if (owner == outline.end()) return;
+  auto end = owner + 1;
+  const bool cached = owner->leaf || (end != outline.end() && end->depth > owner->depth);
+  owner->leaf = false;
+  owner->childrenConfirmed = true;
+  if (!cached || outline.size() == MAX_ROWS) return;
+  node.depth = owner->depth + 1;
+  while (end != outline.end() && end->depth > owner->depth) ++end;
+  outline.insert(end, std::move(node));
+}
+
+void WorkflowyDailyActivity::removeNode(const std::string& id, const bool moveToCurrentDay) {
+  const bool leaveZoom = id == zoomId;
+  {
+    RenderLock lock(*this);
+    std::vector<Node> movedBranch;
+    const auto removeFrom = [&](std::vector<Node>& outline) {
+      const auto first = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (first == outline.end()) return;
+      const auto depth = first->depth;
+      auto end = first + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      if (moveToCurrentDay && end - first > static_cast<ptrdiff_t>(movedBranch.size())) {
+        movedBranch.assign(first, end);
+        for (auto& node : movedBranch) node.depth -= depth;
+      }
+      if (depth > 0) {
+        auto parent = first;
+        while (parent != outline.begin() && (--parent)->depth >= depth) {}
+        if (parent + 1 == first && (end == outline.end() || end->depth < depth)) {
+          parent->leaf = true;
+          parent->childrenConfirmed = false;
+        }
+      }
+      outline.erase(first, end);
+    };
+    removeFrom(rows);
+    for (auto& view : viewStack) removeFrom(view.rows);
+    if (moveToCurrentDay && !movedBranch.empty()) {
+      auto& dailyRows = viewStack.empty() ? rows : viewStack.front().rows;
+      if (dailyRows.size() + movedBranch.size() <= MAX_ROWS)
+        dailyRows.insert(dailyRows.end(), std::make_move_iterator(movedBranch.begin()),
+                         std::make_move_iterator(movedBranch.end()));
+    }
+    layoutDirty = true;
+    message = nullptr;
+  }
+  if (leaveZoom) back();
+  else requestUpdate();
+}
+
+// Reconcile one ordered sibling list, retaining each matching node's cached subtree.
+bool WorkflowyDailyActivity::replaceSiblings(std::vector<Node>& outline, const std::string& parent,
+                                            const std::vector<Node>& siblings) {
+  auto first = outline.begin(), end = outline.end();
+  unsigned depth = 0;
+  bool changed = false;
+  if (!parent.empty()) {
+    const auto owner = std::find_if(first, end, [&](const Node& row) { return row.id == parent; });
+    if (owner == end) return false;
+    depth = owner->depth + 1;
+    first = end = owner + 1;
+    while (end != outline.end() && end->depth >= depth) ++end;
+    changed = owner->leaf != siblings.empty() || owner->childrenConfirmed == siblings.empty();
+    owner->leaf = siblings.empty();
+    owner->childrenConfirmed = !owner->leaf;
+  }
+  const auto localCreate = [depth](const Node& node) {
+    return node.depth == depth && node.id.starts_with("pending:");
+  };
+  const size_t staged = std::count_if(first, end, localCreate);
+  const size_t baseCount = outline.size() - (end - first) + siblings.size() + staged;
+  if (baseCount > MAX_ROWS) return changed;
+  auto current = first;
+  for (const auto& sibling : siblings) {
+    if (current == end || current->id != sibling.id || current->title != sibling.title ||
+        current->todo != sibling.todo || current->done != sibling.done ||
+        current->divider != sibling.divider || current->scheduledDivider != sibling.scheduledDivider) {
+      changed = true;
+      break;
+    }
+    ++current;
+    while (current != end && current->depth > depth) ++current;
+  }
+  if (!changed && current == end) return false;
+  size_t retained = 0;
+  std::vector<Node> rebuilt;
+  rebuilt.reserve(std::max(static_cast<size_t>(end - first), siblings.size()));
+  for (auto node : siblings) {
+    node.depth = depth;
+    const auto old = std::find_if(first, end, [&](const Node& candidate) {
+      return candidate.depth == depth && candidate.id == node.id;
+    });
+    if (old == end) {
+      rebuilt.push_back(std::move(node));
+      continue;
+    }
+    node.leaf = old->leaf;
+    node.childrenConfirmed = old->childrenConfirmed;
+    node.selected = old->selected;
+    if (itemPending(node.id)) {
+      node.title = old->title;
+      node.todo = old->todo;
+      node.done = old->done;
+    }
+    auto lastChild = old + 1;
+    while (lastChild != end && lastChild->depth > depth) ++lastChild;
+    const size_t count = lastChild - (old + 1);
+    const bool fits = baseCount + retained + count <= MAX_ROWS;
+    rebuilt.push_back(std::move(node));
+    if (fits) {
+      rebuilt.insert(rebuilt.end(), std::make_move_iterator(old + 1), std::make_move_iterator(lastChild));
+      retained += count;
+    }
+  }
+  std::copy_if(first, end, std::back_inserter(rebuilt), localCreate);
+  first = outline.erase(first, end);
+  outline.insert(first, std::make_move_iterator(rebuilt.begin()), std::make_move_iterator(rebuilt.end()));
+  return true;
+}
+
+void WorkflowyDailyActivity::loadDay() {
+  if (date.empty()) {
+    auto today = isoDate(0);
+    RenderLock lock(*this);
+    date = today.empty() ? "today" : std::move(today);
+  }
+  // Keep one network reader. Its existing cancellation flag lets the
+  // worker release its TLS resources before the replacement starts.
+  if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+  ++generation;
+  rootCheckedAt = millis() - SYNC_INTERVAL;
+  nextPrefetchAt = millis();
+  {
+    RenderLock lock(*this);
+    requestedBranch.clear();
+    awaitingOutline = true;
+    message = nullptr;
+  }
+  step = Step::Ready;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::updateCompletion(const std::string& id, bool done) {
+  RenderLock lock(*this);
+  for (auto& node : rows) {
+    if (node.id == id) node.done = done;
+  }
+  for (auto& view : viewStack) {
+    for (auto& node : view.rows) {
+      if (node.id == id) node.done = done;
+    }
+  }
+  layoutDirty = true;
+  timedSectionDirty = true;
+  message = nullptr;
+}
+
+void WorkflowyDailyActivity::toggle(const size_t row) {
+  if (row >= rows.size() || itemPending(rows[row].id) || rows[row].divider) return;
+  const bool completed = rows[row].done;
+  const char* failed = completed ? tr(STR_WORKFLOWY_UNCOMPLETE_FAILED) : tr(STR_WORKFLOWY_COMPLETE_FAILED);
+  if (!online) {
+    recordServerError(0, 0, {}, credential);
+    return showMessage(failed);
+  }
+  const auto id = rows[row].id;
+  const auto label = completed ? StrId::STR_WORKFLOWY_MARK_UNDONE : StrId::STR_WORKFLOWY_MARK_DONE;
+  if (queueSave("/" + id + (completed ? "/uncomplete" : "/complete"), {}, false,
+                [this, id, completed, failed](const Save& save) {
+      if (save.status < 200 || save.status >= 300) {
+        updateCompletion(id, completed);
+        return showMessage(failed);
+      }
+      offerUndo([this, id, completed] {
+        if (itemPending(id)) return false;
+        if (!queueSave("/" + id + (completed ? "/complete" : "/uncomplete"), {}, false,
+                       [this, id, completed](const Save& undone) {
+          if (undone.status < 200 || undone.status >= 300) {
+            updateCompletion(id, !completed);
+            showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+          }
+        }, "POST", completed ? StrId::STR_WORKFLOWY_MARK_DONE : StrId::STR_WORKFLOWY_MARK_UNDONE, id)) return false;
+        updateCompletion(id, completed);
+        return true;
+      });
+      if (!completed && zoomId == id && !viewStack.empty() && !calendarVisible && !queueVisible) {
+        returnToDepth(viewStack.size() - 1);
+      }
+    }, "POST", label, id)) {
+    updateCompletion(id, !completed);
+  }
+}
+
+bool WorkflowyDailyActivity::tapArrow(int x, int y) {
+  size_t row;
+  bool expanded;
+  {
+    RenderLock lock(*this);
+    const int right = laidOut.x + laidOut.width;
+    if (page != paintedPage || x < right - ROW_ARROW_TARGET || x >= right + 8) return false;
+    const auto hit = std::find_if(paintedArrows.begin(), paintedArrows.end(), [&](const PaintedArrow& arrow) {
+      return y >= arrow.top && y < arrow.bottom;
+    });
+    if (hit == paintedArrows.end()) return false;
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& item) { return item.id == hit->id; });
+    if (node == rows.end()) return true;
+    row = node - rows.begin();
+    expanded = node->id == zoomId;
+  }
+  if (expanded) {
+    if (!viewStack.empty()) back();
+  } else if (!itemPending(rows[row].id)) zoom(row);
+  return true;
+}
+
+void WorkflowyDailyActivity::edit(const size_t row, const int relative, const size_t cursor,
+                                   std::string initialText, std::string targetDate) {
+  if (row < rows.size() && itemPending(rows[row].id)) return;
+  const bool adding = relative != 0 || row >= rows.size();
+  if (!online && (!adding || relative != 0)) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const std::string id = row < rows.size() ? rows[row].id : "";
+  const std::string initial = adding ? (initialText.empty() ? "[] " : std::move(initialText)) : rows[row].title;
+  const bool originalTodo = !adding && rows[row].todo;
+  const auto originalStyles = adding ? std::string{} : rows[row].textStyles;
+  const int parentIndex = relative ? parentRow(row) : -1;
+  const bool scheduled = !targetDate.empty();
+  const std::string createDate = scheduled ? std::move(targetDate) : date;
+  const std::string parent = scheduled ? "" : relative ? (parentIndex < 0 ? "" : rows[parentIndex].id) : zoomId;
+  auto keyboard = std::make_unique<KeyboardEntryActivity>(
+      renderer, mappedInput, adding ? tr(STR_WORKFLOWY_ADD) : tr(STR_EDIT), initial, 512);
+  keyboard->setInitialCursor(adding ? initial.size() : cursor);
+  keyboard->enableWorkflowyTags(true);
+  keyboard->enableWorkflowyFormatting(originalStyles);
+  const auto today = isoDate(0);
+  const auto selectedDate = validDate(createDate) ? createDate : createDate == "tomorrow" ? isoDate(1) : today;
+  keyboard->setWorkflowyDatePicker([this, selectedDate, today]() {
+    return std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, StrId::STR_DATE, selectedDate, today);
+  });
+  startActivityForResult(std::move(keyboard), [this, id, initial, originalTodo, originalStyles, parent, adding, relative, createDate, scheduled](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    auto entered = std::get<KeyboardResult>(result.data);
+    auto& text = entered.text;
+    auto& styles = entered.workflowyStyles;
+    workflowy::dropEmoji(text, &styles);
+    const auto first = text.find_first_not_of(" ");
+    const bool makeTodo = first != std::string::npos && (text.compare(first, 2, "[]") == 0 ||
+                                                         text.compare(first, 3, "[ ]") == 0);
+    if (makeTodo) {
+      const auto start = text.find_first_not_of(" ", first + (text[first + 1] == ']' ? 2 : 3));
+      if (!styles.empty()) styles.erase(0, start);
+      text.erase(0, start);
+    }
+    workflowy::normalizeStyles(styles);
+    if (text == initial && styles == originalStyles && !makeTodo) return;
+    if (text.find_first_not_of(" \t\r\n") == std::string::npos) return;
+    JsonDocument update;
+    update["name"] = styles.empty() ? escapedTitle(text, adding) :
+        workflowy::styledHtml(text, styles, [](std::string_view run) { return escapedTitle(std::string(run), false); });
+    if (makeTodo) update["layoutMode"] = "todo";
+    if (adding) {
+      update["parent_id"] = parent.empty() ? createDate : parent;
+      update["layoutMode"] = makeTodo ? "todo" : "bullets";
+      update["position"] = "bottom";
+    }
+    if (adding && !hasActiveStationWifiConnection()) {
+      if (!relative && queueCapture(encode(update))) showMessage(tr(STR_WORKFLOWY_CAPTURE_QUEUED));
+      else showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      return;
+    }
+    const auto localId = adding ? "pending:" + std::to_string(++temporaryId) : id;
+    const auto capturedDate = createDate;
+    const auto label = adding ? StrId::STR_WORKFLOWY_ADD : StrId::STR_EDIT;
+    if (!queueSave(adding ? "" : "/" + id, encode(update), adding,
+              [this, id, localId, parent, initial, originalTodo, originalStyles, adding, relative, capturedDate](const Save& save) {
+      if (save.status < 200 || save.status >= 300) {
+        if (adding) {
+          {
+            RenderLock lock(*this);
+            for (auto& day : calendarDays) {
+              std::erase_if(day.items, [&](const Node& item) { return item.id == localId; });
+            }
+          }
+          removeNode(localId);
+        } else applyTitle(id, initial, originalTodo, &originalStyles);
+        return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }
+      if (!adding) return;
+
+      JsonDocument resultBody;
+      const auto invalid = deserializeJson(resultBody, save.response.data(), save.received);
+      const std::string newId = resultBody["item_id"] | "";
+      if (invalid || newId.empty() || newId.find_first_not_of("0123456789abcdefABCDEF-") != std::string::npos) {
+        removeNode(localId);
+        loadDay();
+        return showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+      }
+      {
+        RenderLock lock(*this);
+        for (auto& day : calendarDays) {
+          for (auto& item : day.items) if (item.id == localId) item.id = newId;
+        }
+        const auto replaceId = [&](std::vector<Node>& outline) {
+          for (auto& node : outline) if (node.id == localId) node.id = newId;
+        };
+        replaceId(rows);
+        for (auto& view : viewStack) replaceId(view.rows);
+        layoutDirty = true;
+      }
+      if (relative && capturedDate == date) {
+        const auto anchor = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        const auto added = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == newId; });
+        if (anchor != rows.end() && added != rows.end()) reorder(added - rows.begin(), anchor - rows.begin(), relative > 0);
+      }
+    }, "POST", label, localId)) return;
+    if (!adding) return applyTitle(id, text, makeTodo || originalTodo, &styles);
+    {
+      RenderLock lock(*this);
+      Node added{localId, text, 0, 0, makeTodo, false};
+      added.textStyles = styles;
+      added.leaf = true;
+      if (scheduled) {
+        for (auto& day : calendarDays) if (day.date == createDate) day.items.push_back(added);
+      }
+      if (!parent.empty() || (createDate == date && zoomId.empty())) appendChild(rows, parent, added);
+      for (auto& view : viewStack) {
+        if (!parent.empty() || (createDate == date && view.zoomId.empty())) appendChild(view.rows, parent, added);
+      }
+      saves.back()->title = text.substr(0, 120);
+      layoutDirty = true;
+    }
+    requestUpdate();
+  });
+}
+
+void WorkflowyDailyActivity::applyTitle(const std::string& id, const std::string& text, bool todo, const std::string* styles) {
+  {
+    RenderLock lock(*this);
+    const auto apply = [&](std::vector<Node>& outline) {
+      for (auto& item : outline) {
+        if (item.id != id) continue;
+        if (styles) item.textStyles = *styles;
+        else workflowy::rebaseTextStyles(item.title, text, item.textStyles);
+        item.title = text;
+        item.todo = todo;
+      }
+    };
+    apply(rows);
+    for (auto& view : viewStack) apply(view.rows);
+    for (auto& day : calendarDays) apply(day.items);
+    layoutDirty = true;
+  }
+  requestUpdate();
+}
+
+size_t WorkflowyDailyActivity::cursorAt(std::string_view text, workflowy::TextSpan line, int width, int font) const {
+  line.end = std::min(line.end, text.size());
+  auto caret = std::min(line.begin, line.end);
+  int previousWidth = 0;
+  while (caret < line.end) {
+    const auto next = std::min(line.end, workflowy::nextCharacter(text, caret));
+    const int nextWidth = renderer.getTextWidth(font,
+                                               std::string(text.substr(line.begin, next - line.begin)).c_str());
+    if (width < (previousWidth + nextWidth) / 2) break;
+    previousWidth = nextWidth;
+    caret = next;
+  }
+  return caret;
+}
+
+bool WorkflowyDailyActivity::selectionEligible(const Node& node) const {
+  return !node.divider && node.depth == (zoomId.empty() ? 0u : 1u) && !itemPending(node.id) && (!completedOnly || node.done) && (showDone || completedOnly || !node.done) &&
+         (!replyOnly || workflowy::isReplyTask(node.title));
+}
