+#include <algorithm>
+#include <atomic>
+#include <cassert>
+#include <string>
+#include <vector>
+struct RenderLock {template<class T>explicit RenderLock(T&) {}};
+class KeyboardEntryActivity {
+ public:
+ bool workflowyFormatting=true,keepCursorVisible=true,draggingSelection=false;
+ int manualInputStart=-1,paintedInputFirst=0,paintedInputLast=0,paintedInputWidth=4,paintedInputTop=100,paintedInputBottom=200;
+ size_t touchSelectionStart=std::string::npos,cursorPos=20;
+ std::string text="abcdefghijklmnopqrstuvwx";
+ std::atomic<bool> textOnlyPaint{false};int redraws=0;
+ struct Input {bool down=false,held=false;int x=0,y=0;bool wasScreenTouchDown(int& a,int& b){a=x;b=y;return down;}bool isScreenTouchHeld(int& a,int& b){a=x;b=y;return held;}bool hasTouchHardware()const{return true;}} mappedInput;
+ struct Renderer {mutable int lines=0;int getScreenWidth()const{return 480;}void drawLine(int,int y,int,int b,int,bool)const{assert(y>=100&&y<200&&b>=100&&b<200);++lines;}} renderer;
+ struct Router {int resets=0;void reset(){++resets;}}touchRouter;
+ void requestUpdate(){++redraws;}
+ std::string displayTextForCurrentState()const{return text;}
+ int lineBreakEnd(std::string& display,int start,int width)const {
+  int end=start;
+  for(int count=0;count<width&&end<(int)display.size();++count){++end;while(end<(int)display.size()&&(static_cast<unsigned char>(display[end])&0xc0)==0x80)++end;}
+  return end;
+ }
+ int firstVisibleInputLine(std::string&,int,int)const;
+ bool handleInputScroll(bool,int,int);
+ void drawInputScroll()const;
+ void paint(){paintedInputFirst=firstVisibleInputLine(text,4,3);paintedInputLast=paintedInputFirst;for(int i=0;i<3;++i)paintedInputLast=lineBreakEnd(text,paintedInputLast,4);}
+};
+#include "EditorScroll.inc"
+int main(){
+ KeyboardEntryActivity editor;editor.paint();assert(editor.paintedInputFirst==12);
+ const auto text=editor.text;const auto cursor=editor.cursorPos;
+ assert(editor.handleInputScroll(true,460,110));editor.paint();assert(editor.paintedInputFirst==8);
+ assert(editor.cursorPos==cursor&&editor.text==text&&editor.textOnlyPaint.load());
+ assert(editor.handleInputScroll(true,460,190));editor.paint();assert(editor.paintedInputFirst==12);
+ auto count=editor.redraws;assert(editor.handleInputScroll(true,460,190));assert(editor.redraws==count);
+ while(editor.paintedInputFirst){assert(editor.handleInputScroll(true,460,110));editor.paint();}
+ count=editor.redraws;editor.handleInputScroll(true,460,110);assert(editor.redraws==count);
+ assert(!editor.handleInputScroll(true,300,150));assert(!editor.handleInputScroll(true,460,250));
+ editor.drawInputScroll();assert(editor.renderer.lines==4);
+ editor.manualInputStart=-1;editor.paint();assert(editor.paintedInputFirst==12);
+ editor.text="éééééééééééééééééééééééé";editor.cursorPos=40;editor.manualInputStart=-1;editor.paint();editor.handleInputScroll(true,460,110);editor.paint();assert(editor.paintedInputFirst%2==0);assert(editor.cursorPos==40);
+}
