+// Four diagonal arrows remain distinct from Sort's horizontal lines/one arrow.
+void drawTaskSizeToggle(GfxRenderer& renderer, int x, int y, bool expanded) {
+  const int direction = expanded ? -1 : 1;
+  const int tip = expanded ? 3 : 11;
+  const int tail = expanded ? 11 : 3;
+  for (int sx : {-1, 1}) for (int sy : {-1, 1}) {
+    const int tx = x + sx * tip, ty = y + sy * tip;
+    renderer.drawLine(x + sx * tail, y + sy * tail, tx, ty, 2, true);
+    renderer.drawLine(tx - sx * direction * 5, ty, tx, ty, 2, true);
+    renderer.drawLine(tx, ty - sy * direction * 5, tx, ty, 2, true);
+  }
+}
