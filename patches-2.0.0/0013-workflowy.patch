+std::string plainTitle(const char* value, std::string* styles = nullptr) {
+  std::string title;
+  struct InlineStyle { std::string_view name; uint8_t flags; };
+  std::vector<InlineStyle> stack;
+  uint8_t flags = 0;
+  if (styles) styles->clear();
+  const auto appendStyle = [&](size_t bytes) {
+    if (styles) styles->append(bytes, static_cast<char>(flags));
+  };
+  while (*value) {
+    if (strncmp(value, "<time ", 6) == 0) {
+      int year = 0, month = 0, day = 0, consumed = 0;
+      if (sscanf(value, "<time startYear=\"%4d\" startMonth=\"%2d\" startDay=\"%2d\">%n",
+                 &year, &month, &day, &consumed) == 3 && consumed > 0) {
+        const char* closing = strstr(value + consumed, "</time>");
+        char date[16];
+        snprintf(date, sizeof(date), "%04d-%02d-%02d", year, month, day);
+        if (closing && validDate(date)) {
+          title += '[';
+          title += date;
+          title += ']';
+          appendStyle(12);
+          value = closing + 7;
+          continue;
+        }
+      }
+    }
+    if (*value == '<') {
+      const char* end = strchr(value, '>');
+      if (end) {
+        if (styles) {
+          std::string_view tag(value + 1, end - value - 1);
+          const bool closing = tag.starts_with('/');
+          if (closing) tag.remove_prefix(1);
+          const auto delimiter = tag.find_first_of(" \t\r\n/");
+          const auto name = tag.substr(0, delimiter);
+          if (closing) {
+            const auto match = std::find_if(stack.rbegin(), stack.rend(),
+                                            [&](const InlineStyle& item) { return item.name == name; });
+            if (match != stack.rend()) {
+              stack.erase(match.base() - 1, stack.end());
+              flags = stack.empty() ? 0 : stack.back().flags;
+            }
+          } else if (stack.size() < 32 && !tag.ends_with('/') && !name.empty()) {
+            flags |= workflowy::htmlTextStyle(name, delimiter == std::string_view::npos ? std::string_view{} :
+                                                                               tag.substr(delimiter));
+            stack.push_back({name, flags});
+          }
+        }
+        value = end + 1;
+        continue;
+      }
+    }
+    bool entity = false;
+    for (const auto& [name, character] : {std::pair{"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'},
+                                           {"&quot;", '"'}, {"&#39;", '\''}, {"&nbsp;", ' '}}) {
+      const auto len = strlen(name);
+      if (strncmp(value, name, len) == 0) {
+        title += character;
+        appendStyle(1);
+        value += len;
+        entity = true;
+        break;
+      }
+    }
+    if (!entity) {
+      const char c = *value++;
+      title += c == '\r' || c == '\n' || c == '\t' ? ' ' : c;
+      appendStyle(1);
+    }
+  }
+  workflowy::dropEmoji(title, styles);
+  if (styles) workflowy::normalizeStyles(*styles);
+  return title;
+}
+
+std::string escapedTitle(const std::string& text, const bool creating) {
+  std::string output;
+  for (size_t i = 0; i < text.size(); ++i) {
+    const char c = text[i];
+    if (c == '[' && i + 11 < text.size() && text[i + 11] == ']') {
+      const auto date = text.substr(i + 1, 10);
+      if (validDate(date)) {
+        if (creating) {
+          output.append(text, i, 12);
+        } else {
+          const auto month = (date[5] - '0') * 10 + date[6] - '0';
+          const auto day = (date[8] - '0') * 10 + date[9] - '0';
+          output += "<time startYear=\"" + date.substr(0, 4) + "\" startMonth=\"" + std::to_string(month) +
+                    "\" startDay=\"" + std::to_string(day) + "\">" + date + "</time>";
+        }
+        i += 11;
+        continue;
+      }
+    }
+    if (!creating && c == '&') output += "&amp;";
+    else if (!creating && c == '<') output += "&lt;";
+    else if (!creating && c == '>') output += "&gt;";
+    else if (creating && strchr("\\*_[]-`<>~", c)) {
+      output += '\\';
+      output += c;
+    } else output += c == '\r' || c == '\n' ? ' ' : c;
+  }
+  return output;
+}
