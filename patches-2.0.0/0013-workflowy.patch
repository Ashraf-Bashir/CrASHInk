+      : Activity("WorkflowyTimeRange", renderer, input), start(std::clamp(start, 0, 1425)),
+        end(std::min(1440, this->start + 30)), choices(std::move(choices)), poll(std::move(poll)),
+        selected(std::move(fixedItem)), fixedTitle(std::move(fixedTitle)), paintStatus(std::move(paintStatus)) {}
+  void onEnter() override {
+    Activity::onEnter();
+    requestUpdate();
+  }
+  bool allowGlobalHomeSwipeGesture() const override { return false; }
+  void loop() override {
+    if (mappedInput.wasReleased(MappedInputManager::Button::Back) ||
+        TouchHeaderBackButton::wasTapped(mappedInput, renderer)) {
+      ActivityResult result;
+      result.isCancelled = true;
+      setResult(std::move(result));
+      return finish();
+    }
+    if (poll) poll();
+    if (choices && choices->ready.load(std::memory_order_acquire) && !choicesPainted) {
+      choicesPainted = true;
+      requestUpdate();
+    }
+    const auto swipe = mappedInput.wasSwipe();
+    if (swipe == MappedInputManager::SwipeDir::Up || swipe == MappedInputManager::SwipeDir::Down) {
+      const int delta = swipe == MappedInputManager::SwipeDir::Up ? 4 : -4;
+      const int count = choices && choices->ready.load(std::memory_order_acquire) ? choices->items.size() + 1 : 1;
+      {
+        RenderLock lock(*this);
+        listOffset = std::clamp(listOffset + delta, 0, std::max(0, count - 1));
+      }
+      return requestUpdate();
+    }
+    const auto bounds = geometry();
+    int x, y;
+    if (!mappedInput.wasScreenTapped(x, y)) return;
+    const int row = (y - bounds.y) / 72;
+    if (y >= bounds.y && row < 2) {
+      const int delta = x < bounds.x + bounds.width / 3 ? -15 : x >= bounds.x + 2 * bounds.width / 3 ? 15 : 0;
+      if (!delta) {
+        const auto initial = workflowy::scheduleRange(start, end);
+        startActivityForResult(std::make_unique<KeyboardEntryActivity>(
+                                   renderer, mappedInput, tr(STR_WORKFLOWY_ADD_BLOCK), initial, 48),
+                               [this](const ActivityResult& result) {
+          if (result.isCancelled) return;
+          const auto& value = std::get<KeyboardResult>(result.data).text;
+          const auto range = workflowy::parseTimeRange(value);
+          if (range && range->begin == 0 && range->finish == value.size()) {
+            RenderLock lock(*this);
+            start = range->start;
+            end = range->end;
+          }
+          requestUpdate();
+        });
+        return;
+      }
+      {
+        RenderLock lock(*this);
+        if (row == 0) start = std::clamp(start + delta, 0, end - 15);
+        else end = std::clamp(end + delta, start + 15, 1440);
+      }
+      return requestUpdate();
+    }
+    if (y >= bounds.y + 164 && y < bounds.y + 216 && x >= bounds.x && x < bounds.x + bounds.width) {
+      setResult(WorkflowyBlockResult{start, end, selected});
+      finish();
+      return;
+    }
+    const int listTop = bounds.y + 260;
+    if (choices && choices->ready.load(std::memory_order_acquire) && y >= listTop) {
+      const int index = listOffset + (y - listTop) / 44;
+      if (index < 0 || index > static_cast<int>(choices->items.size())) return;
+      {
+        RenderLock lock(*this);
+        selected = index == 0 ? "" : choices->items[index - 1].id;
+      }
+      requestUpdate();
+    }
+  }
+  void render(RenderLock&&) override {
+    renderer.clearScreen();
+    TouchHeaderBackButton::draw(renderer, TouchHeaderBackButton::headerRect(renderer, mappedInput),
+                               tr(STR_WORKFLOWY_ADD_BLOCK), false);
+    const auto bounds = geometry();
+    for (int row = 0; row < 2; ++row) {
+      const int top = bounds.y + row * 72;
+      renderer.drawText(SMALL_FONT_ID, bounds.x + 12, top, row ? tr(STR_WORKFLOWY_END) : tr(STR_WORKFLOWY_START));
+      const auto value = workflowy::scheduleClock(row ? end : start);
+      renderer.drawCenteredText(UI_12_FONT_ID, top + 25, value.c_str(), true, EpdFontFamily::BOLD);
+      for (const int direction : {-1, 1}) {
+        const int cx = bounds.x + (direction < 0 ? 28 : bounds.width - 28);
+        renderer.drawLine(cx - 8, top + 35, cx + 8, top + 35, 3, true);
+        if (direction > 0) renderer.drawLine(cx, top + 27, cx, top + 43, 3, true);
+      }
+    }
+    renderer.drawRoundedRect(bounds.x, bounds.y + 164, bounds.width, 48, 1, 6, true);
+    renderer.drawCenteredText(UI_12_FONT_ID, bounds.y + 177, tr(STR_SAVE), true, EpdFontFamily::BOLD);
+    if (!fixedTitle.empty()) {
+      const auto title = renderer.truncatedText(UI_12_FONT_ID, fixedTitle.c_str(), bounds.width - 8);
+      renderer.drawText(UI_12_FONT_ID, bounds.x + 4, bounds.y + 230, title.c_str(), true, EpdFontFamily::BOLD);
+    }
+    if (choices) {
+      renderer.drawText(SMALL_FONT_ID, bounds.x + 4, bounds.y + 230, tr(STR_WORKFLOWY_TODAY));
+      if (!choices->ready.load(std::memory_order_acquire)) {
+        if (paintStatus) paintStatus(tr(STR_LOADING_POPUP));
+      } else if (choices->status != 200) {
+        if (paintStatus) paintStatus(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+      } else {
+        const int listTop = bounds.y + 260;
+        int top, right, bottom, left;
+        renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+        const int visible = std::max(1, (renderer.getScreenHeight() - bottom - listTop) / 44);
+        for (int line = 0; line < visible; ++line) {
+          const int index = listOffset + line;
+          if (index > static_cast<int>(choices->items.size())) break;
+          const auto id = index == 0 ? std::string_view{} : std::string_view(choices->items[index - 1].id);
+          const char* title = index == 0 ? tr(STR_WORKFLOWY_NEW_TASK) : choices->items[index - 1].title.c_str();
+          const int y = listTop + line * 44;
+          renderer.drawRect(bounds.x + 3, y + 10, 16, 16);
+          if (selected == id) renderer.fillRect(bounds.x + 6, y + 13, 10, 10);
+          const auto fitted = renderer.truncatedText(UI_12_FONT_ID, title, bounds.width - 34);
+          renderer.drawText(UI_12_FONT_ID, bounds.x + 28, y + 6, fitted.c_str());
+        }
+      }
+    }
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+  }
+ private:
+  int start, end;
+  std::shared_ptr<WorkflowyTimeChoices> choices;
+  std::function<void()> poll;
+  std::function<void(const char*)> paintStatus;
+  std::string selected, fixedTitle;
+  int listOffset = 0;
+  bool choicesPainted = false;
+  Rect geometry() const {
+    int top, right, bottom, left;
+    renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+    const int width = std::min(360, renderer.getScreenWidth() - left - right - 24);
+    const auto& metrics = UITheme::getInstance().getMetrics();
+    const auto header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+    const int origin = std::max(top, header.y + header.height) + metrics.verticalSpacing;
+    return Rect{(renderer.getScreenWidth() + left - right - width) / 2, origin, width, 216};
+  }
+};
