+void WorkflowyDailyActivity::showAddMenu(std::string aboveId, std::string belowId, bool bulk) {
+  std::vector<std::string> choices{tr(STR_WORKFLOWY_ADD_ABOVE), tr(STR_WORKFLOWY_ADD_BELOW)};
+  std::vector<const freeink::Icon*> icons{&workflowyActionAddIcon, &workflowyActionAddIcon};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyAdd", StrId::STR_WORKFLOWY_ADD,
+                             std::move(choices), 0, false, true, std::move(icons)),
+                         [this, aboveId = std::move(aboveId), belowId = std::move(belowId), bulk](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const bool below = std::get<OptionSelectionResult>(result.data).index == 1;
+    const auto& id = below ? belowId : aboveId;
+    const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    if (item == rows.end() || itemPending(id) || id == zoomId) return;
+    if (bulk) cancelSelection();
+    edit(item - rows.begin(), below ? 1 : -1);
+  });
+}
