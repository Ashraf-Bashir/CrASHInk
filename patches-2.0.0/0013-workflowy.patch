+// Keep response and parsed fields out of the internal heap used by Wi-Fi/TLS.
+struct ResponseAllocator final : ArduinoJson::Allocator {
+  void* allocate(size_t size) override { return heap_caps_malloc(size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT); }
+  void deallocate(void* ptr) override { heap_caps_free(ptr); }
+  void* reallocate(void* ptr, size_t size) override {
+    return heap_caps_realloc(ptr, size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+  }
+};
+
+std::string isoDate(const int offset) {
+  const auto utc = halClock.utcNowMs();
+  if (!utc) return {};
+  const time_t local = utc / 1000 + (static_cast<int>(SETTINGS.clockUtcOffsetQ) - 48) * 900L + offset * 86400L;
+  tm date{};
+  if (!gmtime_r(&local, &date)) return {};
+  char text[16];
+  strftime(text, sizeof(text), "%Y-%m-%d", &date);
+  return text;
+}
+
+int monthLength(int year, int month) {
+  constexpr int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  return days[month - 1] + (month == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0));
+}
+
+bool validDate(const std::string& date) {
+  int y = 0, m = 0, d = 0;
+  if (date.size() != 10 || date[4] != '-' || date[7] != '-' ||
+      sscanf(date.c_str(), "%4d-%2d-%2d", &y, &m, &d) != 3 || y < 1900 || y > 9999 || m < 1 || m > 12 || d < 1)
+    return false;
+  char canonical[16];
+  snprintf(canonical, sizeof(canonical), "%04d-%02d-%02d", y, m, d);
+  return d <= monthLength(y, m) && date == canonical;
+}
