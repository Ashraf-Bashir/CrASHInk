+void WorkflowyDailyActivity::showBulkMoveMenu() {
+  struct Choice { BulkAction action; std::string target; };
+  std::vector<Choice> choices;
+  std::vector<std::string> labels;
+  std::vector<bool> expandable;
+  std::vector<const freeink::Icon*> icons;icons.reserve(8);
+  choices.reserve(7);
+  labels.reserve(7);
+  const auto add = [&](BulkAction action, StrId label, std::string target = {}) {
+    choices.push_back({action, std::move(target)});
+    labels.emplace_back(I18n::getInstance().get(label));
+    icons.push_back(workflowyActionIcon(label));
+    expandable.push_back(action == BulkAction::None || choices.back().target == "@parent");
+  };
+  add(BulkAction::MoveTop, StrId::STR_WORKFLOWY_MOVE_TOP);
+  add(BulkAction::MoveBottom, StrId::STR_WORKFLOWY_MOVE_BOTTOM);
+  const auto first = std::find_if(rows.begin(), rows.end(), [](const Node& node) { return node.selected; });
+  if (first != rows.end() && !parentOf(first->id).empty())
+    add(BulkAction::MoveDate, StrId::STR_WORKFLOWY_MOVE_PARENT, "@parent");
+  constexpr StrId days[] = {StrId::STR_WORKFLOWY_MOVE_YESTERDAY, StrId::STR_WORKFLOWY_MOVE_TODAY,
+                             StrId::STR_WORKFLOWY_MOVE_TOMORROW};
+  for (int delta = -1; delta <= 1; ++delta) {
+    auto day = isoDate(delta);
+    if (day.empty() && delta >= 0) day = delta == 0 ? "today" : "tomorrow";
+    if (day.empty() || day == date || (delta == 0 && date == "today") || (delta == 1 && date == "tomorrow")) continue;
+    add(BulkAction::MoveDate, days[delta + 1], std::move(day));
+  }
+  add(BulkAction::None, StrId::STR_WORKFLOWY_MOVE_DATE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyBulkMove", StrId::STR_WORKFLOWY_MOVE,
+                             std::move(labels), 0, false, true, std::move(icons), std::move(expandable)),
+                         [this, choices = std::move(choices)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t index = std::get<OptionSelectionResult>(result.data).index;
+    if (index >= choices.size()) return;
+    if (choices[index].target == "@parent") return chooseParent({},true);
+    if (choices[index].action != BulkAction::None) return startBulk(choices[index].action, choices[index].target);
+    const auto today = isoDate(0);
+    startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, StrId::STR_WORKFLOWY_MOVE_DATE,
+                              validDate(date) ? date : today, today), [this](const ActivityResult& picked) {
+      if (!picked.isCancelled) startBulk(BulkAction::MoveDate, std::get<KeyboardResult>(picked.data).text);
+    });
+  });
+}
