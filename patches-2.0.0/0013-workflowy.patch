+void WorkflowyDailyActivity::updateType(const std::string& id, bool todo) {
+  RenderLock lock(*this);
+  const auto update = [&](std::vector<Node>& nodes) {
+    for (auto& node : nodes) if (node.id == id) node.todo = todo;
+  };
+  update(rows);
+  for (auto& view : viewStack) update(view.rows);
+  for (auto& day : calendarDays) update(day.items);
+  layoutDirty = true;
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::startBulk(BulkAction action, std::string target) {
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const bool completion = action == BulkAction::Done || action == BulkAction::Undone;
+  const bool done = action == BulkAction::Done;
+  const bool conversion = action == BulkAction::ToTodo || action == BulkAction::ToBullet;
+  const bool todo = action == BulkAction::ToTodo;
+  const bool boundary = action == BulkAction::MoveTop || action == BulkAction::MoveBottom;
+  const auto parent = zoomId.empty() ? date : zoomId;
+  const auto label = completion ? (done ? StrId::STR_WORKFLOWY_MARK_DONE : StrId::STR_WORKFLOWY_MARK_UNDONE)
+                   : conversion ? (todo ? StrId::STR_WORKFLOWY_TO_TODO : StrId::STR_WORKFLOWY_TO_BULLET)
+                   : action == BulkAction::MoveTop ? StrId::STR_WORKFLOWY_MOVE_TOP
+                   : action == BulkAction::MoveBottom ? StrId::STR_WORKFLOWY_MOVE_BOTTOM
+                   : action == BulkAction::Delete ? StrId::STR_DELETE : StrId::STR_WORKFLOWY_MOVE;
+  std::vector<std::string> items;
+  items.reserve(selectionCount());
+  for (const auto& node : rows) {
+    if (!node.selected || itemPending(node.id) || node.divider) continue;
+    if (completion && ((!node.todo && !node.done) || node.done == done)) continue;
+    if (conversion && node.todo == todo) continue;
+    items.push_back(node.id);
+  }
+  if (items.size() > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  // Repeated top insertion reverses order, so submit top moves in reverse.
+  if (action == BulkAction::MoveTop) std::reverse(items.begin(), items.end());
+  bool queuedAll = true;
+  for (const auto& id : items) {
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    if (node == rows.end()) continue;
+    const bool oldTodo = node->todo;
+    const auto title = node->title.substr(0, 120);
+    auto path = "/" + id;
+    std::string body;
+    if (completion) path += done ? "/complete" : "/uncomplete";
+    else if (conversion) {
+      JsonDocument update;
+      update["layoutMode"] = todo ? "todo" : "bullets";
+      body = encode(update);
+    } else if (action == BulkAction::MoveDate || boundary) {
+      JsonDocument update;
+      update["parent_id"] = boundary ? parent : target;
+      update["position"] = action == BulkAction::MoveTop ? "top" : "bottom";
+      path += "/move";
+      body = encode(update);
+    }
+    if (!queueSave(std::move(path), std::move(body), false,
+                   [this, id, done, oldTodo, completion, conversion, boundary, parent, action, target](const Save& save) {
+          if (save.status < 200 || save.status >= 300) {
+            if (completion) updateCompletion(id, !done);
+            if (conversion) updateType(id, oldTodo);
+            return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+          }
+          if (boundary) {
+            if ((zoomId.empty() ? date : zoomId) == parent) loadDay();
+          } else if (!completion && !conversion) {
+            const bool sameDay = action == BulkAction::MoveDate && (target == date ||
+                (date == "today" && target == isoDate(0)) || (date == "tomorrow" && target == isoDate(1)));
+            std::optional<Node> moved;
+            const bool cachedParent = action == BulkAction::MoveDate && !sameDay && !validDate(target) &&
+                                      target != "today" && target != "tomorrow";
+            if (cachedParent) {
+              const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+              if (node != rows.end()) moved = *node;
+            }
+            removeNode(id, sameDay);
+            if (moved) {
+              RenderLock lock(*this);
+              appendChild(rows, target, *moved);
+              for (auto& view : viewStack) appendChild(view.rows, target, *moved);
+              layoutDirty = true;
+            }
+            requestUpdate();
+          }
+        }, action == BulkAction::Delete ? "DELETE" : "POST", label, id)) { queuedAll = false; break; }
+    {
+      RenderLock lock(*this);
+      saves.back()->title = title;
+      node->selected = false;
+    }
+    if (completion) updateCompletion(id, done);
+    if (conversion) updateType(id, todo);
+  }
+  if (queuedAll) cancelSelection();
+  else requestUpdate();
+}
+
+void WorkflowyDailyActivity::actions(const size_t row) {
+  if (itemPending(rows[row].id)) return;
+  enum class Action { Edit, Complete, Schedule, Move, TurnInto, Zoom, Add, Select, Delete };
+  std::vector<std::string> options;
+  std::vector<bool> expandable;
+  std::vector<const freeink::Icon*> icons;icons.reserve(12);
+  std::vector<Action> commands;
+  options.reserve(10);
+  commands.reserve(10);
+  const auto add = [&](Action action, StrId label) {
+    commands.push_back(action);
+    options.emplace_back(I18n::getInstance().get(label));
+    icons.push_back(workflowyActionIcon(label));
+    expandable.push_back(action == Action::Add || action == Action::Schedule ||
+                         action == Action::Move || action == Action::TurnInto);
+  };
+  if (!rows[row].divider) {
+  add(Action::Edit, StrId::STR_EDIT);
+  add(Action::Complete, rows[row].done ? StrId::STR_WORKFLOWY_MARK_UNDONE : StrId::STR_WORKFLOWY_MARK_DONE);
+  add(Action::Schedule, StrId::STR_WORKFLOWY_SCHEDULE_VIEW);
+  add(Action::Move, StrId::STR_WORKFLOWY_MOVE);
+  add(Action::TurnInto, StrId::STR_WORKFLOWY_TURN_INTO);
+  add(Action::Zoom, StrId::STR_WORKFLOWY_ZOOM);
+  if (zoomId.empty() || row != 0) add(Action::Add, StrId::STR_WORKFLOWY_ADD);
+  if (selectionEligible(rows[row])) add(Action::Select, StrId::STR_WORKFLOWY_SELECT_MULTIPLE);
+  }
+  add(Action::Delete, StrId::STR_DELETE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyItem", StrId::STR_WORKFLOWY, std::move(options),
+                             0, false, true, std::move(icons), std::move(expandable)),
+                         [this, row, commands = std::move(commands)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const size_t index = std::get<OptionSelectionResult>(result.data).index;
+    if (index >= commands.size() || row >= rows.size()) return;
+    const auto selected = commands[index];
+    const auto id = rows[row].id;
+    if (selected == Action::Select) {
+      {
+        RenderLock lock(*this);
+        selecting = true;
+      }
+      return toggleSelection(row);
+    }
+    if (selected == Action::Schedule) return scheduleItem(row);
+    if (selected == Action::Complete) return toggle(row);
+    if (selected == Action::Edit) return edit(row);
+    if (selected == Action::Add) return showAddMenu(id, id, false);
+    if (selected == Action::Zoom) return zoom(row);
+    if (selected == Action::Move) return showMoveMenu(row);
+    if (selected == Action::TurnInto) {
+      const bool todo = !rows[row].todo;
+      const auto label = todo ? StrId::STR_WORKFLOWY_TO_TODO : StrId::STR_WORKFLOWY_TO_BULLET;
+      startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                                 renderer, mappedInput, "WorkflowyTurnInto", StrId::STR_WORKFLOWY_TURN_INTO,
+                                 std::vector<std::string>{todo ? tr(STR_WORKFLOWY_TODO_TYPE) : tr(STR_WORKFLOWY_BULLET_TYPE)},
+                                 0, false, true),
+                             [this, id, todo, label](const ActivityResult& choice) {
+        if (choice.isCancelled || itemPending(id)) return;
+        const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+        if (item == rows.end()) return;
+        const auto title = item->title;
+        JsonDocument update;
+        update["layoutMode"] = todo ? "todo" : "bullets";
+        if (queueSave("/" + id, encode(update), false, [this, id, todo, title](const Save& save) {
+              if (save.status >= 200 && save.status < 300) return;
+              applyTitle(id, title, !todo);
+              showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+            }, "POST", label, id)) {
+          applyTitle(id, title, todo);
+        }
+      });
+    } else if (selected == Action::Delete) {
+      startActivityForResult(std::make_unique<ConfirmationActivity>(
+                                 renderer, mappedInput, tr(STR_DELETE), rows[row].title),
+                             [this, id](const ActivityResult& confirmation) {
+        if (confirmation.isCancelled) return;
+        if (!hasActiveStationWifiConnection()) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+        commitDelete();
+        if (!pendingDelete.empty()) return;
+        {
+          RenderLock lock(*this);
+          pendingDelete = id;
+          deleteAt = millis() + DELETE_GRACE;
+          layoutDirty = true;
+        }
+        offerUndo([this] {
+          RenderLock lock(*this);
+          pendingDelete.clear();
+          layoutDirty = true;
+          return true;
+        }, true);
+      });
+    }
+  });
+}
