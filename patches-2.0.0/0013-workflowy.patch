+std::string WorkflowyDailyActivity::parentOf(const std::string& id) const {
+  if (id.empty()) return {};
+  const auto findParent = [&](const std::vector<Node>& outline) -> std::string {
+    auto node = std::find_if(outline.begin(), outline.end(), [&](const Node& item) { return item.id == id; });
+    if (node == outline.end() || node->depth == 0) return {};
+    const auto depth = node->depth;
+    while (node != outline.begin()) {
+      if ((--node)->depth < depth) return node->id;
+    }
+    return {};
+  };
+  if (auto parent = findParent(rows); !parent.empty()) return parent;
+  for (auto view = viewStack.rbegin(); view != viewStack.rend(); ++view) {
+    if (auto parent = findParent(view->rows); !parent.empty()) return parent;
+  }
+  return {};
+}
+
+std::string WorkflowyDailyActivity::parentDestination(const std::string& id) const {
+  auto destination = parentOf(parentOf(id));
+  return destination.empty() ? date : destination;
+}
+
+void WorkflowyDailyActivity::chooseParent(const std::string& id, bool bulk) {
+  std::vector<std::string> ids,labels;
+  ids.reserve(64);labels.reserve(64);
+  ids.push_back(date);labels.push_back(date);
+  const auto add=[&](const std::vector<Node>& outline){
+    unsigned excludedDepth=~0u;
+    for(const auto& node:outline){
+      if(node.depth<=excludedDepth && excludedDepth!=~0u)excludedDepth=~0u;
+      if(node.id==id || (bulk && std::any_of(rows.begin(),rows.end(),[&](const Node& moving){return moving.selected && moving.id==node.id;}))){excludedDepth=node.depth;continue;}
+      if(excludedDepth!=~0u || node.divider || node.id.starts_with("pending:") || ids.size()>=200)continue;
+      if(std::find(ids.begin(),ids.end(),node.id)!=ids.end())continue;
+      ids.push_back(node.id);
+      const workflowy::TaskTextProjection display(node.title,false);
+      labels.push_back(renderer.truncatedText(UI_12_FONT_ID,display.text(false).c_str(),renderer.getScreenWidth()-64));
+    }
+  };
+  for(const auto& view:viewStack)add(view.rows);add(rows);
+  std::vector<Node> cached;uint32_t at=0;
+  if(cachedChildren(date,0,cached,at))add(cached);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(renderer,mappedInput,"WorkflowyParent",StrId::STR_WORKFLOWY_MOVE_PARENT,
+      std::move(labels),0,false,true),[this,id,bulk,ids=std::move(ids)](const ActivityResult& result){
+    if(result.isCancelled)return;const auto index=std::get<OptionSelectionResult>(result.data).index;
+    if(index>=ids.size())return;
+    if(bulk)startBulk(BulkAction::MoveDate,ids[index]);else moveToDate(id,ids[index]);
+  });
+}
+
+void WorkflowyDailyActivity::showMoveMenu(size_t row) {
+  const auto id = rows[row].id;
+  const bool sibling = zoomId.empty() || row != 0;
+  const auto origin = moveOrigin(row);
+  enum class Move { Top, Bottom, Parent, Date, Day };
+  struct Choice { Move action; std::string target; };
+  std::vector<Choice> choices;
+  std::vector<std::string> labels;
+  std::vector<bool> expandable;
+  std::vector<const freeink::Icon*> icons;icons.reserve(12);
+  const auto add = [&](Move move, StrId label, std::string target = {}) {
+    choices.push_back({move, std::move(target)});
+    labels.emplace_back(I18n::getInstance().get(label));
+    icons.push_back(workflowyActionIcon(label));
+    expandable.push_back(move == Move::Parent || move == Move::Date);
+  };
+  if (sibling && origin.after) add(Move::Top, StrId::STR_WORKFLOWY_MOVE_TOP);
+  const auto next = std::find_if(rows.begin() + row + 1, rows.end(),
+                                 [&](const Node& node) { return node.depth <= rows[row].depth; });
+  if (sibling && next != rows.end() && next->depth == rows[row].depth) add(Move::Bottom, StrId::STR_WORKFLOWY_MOVE_BOTTOM);
+  add(Move::Parent, StrId::STR_WORKFLOWY_MOVE_PARENT);
+  constexpr StrId dayLabels[] = {StrId::STR_WORKFLOWY_MOVE_YESTERDAY, StrId::STR_WORKFLOWY_MOVE_TODAY,
+                                  StrId::STR_WORKFLOWY_MOVE_TOMORROW};
+  for (int delta = -1; delta <= 1; ++delta) {
+    auto day = isoDate(delta);
+    if (day.empty() && delta >= 0) day = delta == 0 ? "today" : "tomorrow";
+    const bool current = day == date || (delta == 0 && date == "today") || (delta == 1 && date == "tomorrow");
+    if (!day.empty() && !current) add(Move::Day, dayLabels[delta + 1], std::move(day));
+  }
+  add(Move::Date, StrId::STR_WORKFLOWY_MOVE_DATE);
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyMove", StrId::STR_WORKFLOWY_MOVE,
+                             std::move(labels), 0, false, true, std::move(icons), std::move(expandable)),
+                         [this, id, choices = std::move(choices)](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const auto choice = std::get<OptionSelectionResult>(result.data).index;
+    if (choice < 0 || static_cast<size_t>(choice) >= choices.size() || itemPending(id)) return;
+    const auto& move = choices[choice];
+    if (move.action == Move::Date) return chooseDate(id);
+    if (move.action == Move::Parent) return chooseParent(id);
+    if (move.action == Move::Day) return moveToDate(id, move.target);
+    const auto node = std::find_if(rows.begin(), rows.end(), [&](const Node& item) { return item.id == id; });
+    if (node != rows.end()) moveToBoundary(node - rows.begin(), move.action == Move::Bottom);
+  });
+}
