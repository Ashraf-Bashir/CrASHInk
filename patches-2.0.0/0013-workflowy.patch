+std::string oneLine(std::string value) {
+  for (char& ch : value)
+    if (ch == '\n' || ch == '\r' || ch == '\t') ch = ' ';
+  // Preserve the full text as one bullet and escape Markdown syntax.
+  std::string escaped;
+  for (const char ch : value) {
+    if (ch == '\\' || ch == '*' || ch == '_' || ch == '[' || ch == ']' ||
+        ch == '-' || ch == '<' || ch == '>' || ch == '#' || ch == '`' || ch == '~') escaped += '\\';
+    escaped += ch;
+  }
+  return escaped;
+}
+// Local receipts identify the exact exported content and destination.
+uint64_t receiptHash(const std::string& value, uint64_t hash = 14695981039346656037ULL) {
+  for (unsigned char ch : value) hash = (hash ^ ch) * 1099511628211ULL;
+  return hash;
+}
+
+struct ShareJsonAllocator final : ArduinoJson::Allocator {
+      void* allocate(size_t size) override { return heap_caps_malloc(size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT); }
+      void deallocate(void* p) override { heap_caps_free(p); }
+      void* reallocate(void* p, size_t size) override { return heap_caps_realloc(p, size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT); }
+};
+
+struct ShareJob {
+  std::string key;
+  std::string receiptPath, spoolPath;
+  uint32_t dataOffset = 0;
+  uint64_t accountHash = 0;
+  bool checkRemoteQuote = false;
+  std::string destination, bookTitle, bookAuthor, bookParent;
+  bool ownsWifi = false;
+
+  bool connect() {
+    if (millis() - workerStartedAt >= 180000u) return false;
+    if (hasActiveStationWifiConnection()) return true;
+    const auto networks = WIFI_STORE.getCredentialSummaries();
+    if (networks.empty() || WiFi.getMode() != WIFI_OFF) return false;
+    ownsWifi = true;
+    WiFi.persistent(false);
+    if (!WiFi.mode(WIFI_STA)) return false;
+    WiFi.setAutoReconnect(false);
+    const auto trySaved = [](const std::string& ssid) {
+      if (millis() - workerStartedAt >= 180000u) return false;
+      const auto saved = WIFI_STORE.findCredential(ssid);
+      if (!saved) return false;
+      WiFi.disconnect(false, false);
+      WiFi.begin(saved->ssid.c_str(), saved->password.empty() ? nullptr : saved->password.c_str());
+      const auto started = millis();
+      while (!hasActiveStationWifiConnection() && millis() - started < 6500 && millis() - workerStartedAt < 180000u) delay(50);
+      return hasActiveStationWifiConnection();
+    };
+    const auto last = WIFI_STORE.getLastConnectedSsid();
+    if (!last.empty() && trySaved(last)) return true;
+    const int count = WiFi.scanNetworks();
+    std::vector<std::string> visible;
+    for (int i = 0; i < count && visible.size() < networks.size(); ++i) {
+      std::string ssid = WiFi.SSID(i).c_str();
+      if (ssid != last && WIFI_STORE.hasSavedCredential(ssid) &&
+          std::find(visible.begin(), visible.end(), ssid) == visible.end()) {
+        visible.push_back(std::move(ssid));
+      }
+    }
+    WiFi.scanDelete();
+    return std::any_of(visible.begin(), visible.end(), trySaved);
+  }
+
+  static constexpr const char* RESPONSE_FILE = "/.crashink/.workflowy/share-response.tmp";
+  int request(const std::string& url, bool post, const std::string& body, bool capture) {
+    FsFile response;
+    if (capture && !Storage.openFileForWrite("WF", RESPONSE_FILE, response)) return -3;
+    struct Sink { FsFile* file; size_t size = 0; bool failed = false; } sink{capture ? &response : nullptr};
+    const auto auth = "Bearer " + key;
+    esp_http_client_config_t config{};
+    config.url = url.c_str(); config.method = post ? HTTP_METHOD_POST : HTTP_METHOD_GET;
+    config.crt_bundle_attach = esp_crt_bundle_attach; config.user_agent = "CrASHInk/Workflowy";
+    config.timeout_ms = 12000; config.disable_auto_redirect = true; config.max_authorization_retries = -1;
+    config.user_data = &sink;
+    config.event_handler = [](esp_http_client_event_t* event) -> esp_err_t {
+      auto& sink = *static_cast<Sink*>(event->user_data);
+      if (event->event_id != HTTP_EVENT_ON_DATA || !sink.file) return ESP_OK;
+      if (event->data_len < 0 || sink.size + event->data_len > 512u * 1024u ||
+          sink.file->write(static_cast<const uint8_t*>(event->data), event->data_len) != static_cast<size_t>(event->data_len)) {
+        sink.failed = true; return ESP_FAIL;
+      }
+      sink.size += event->data_len; return ESP_OK;
+    };
+    const auto client = esp_http_client_init(&config);
+    if (!client) return -1;
+    auto result = esp_http_client_set_header(client, "Authorization", auth.c_str());
+    if (post && result == ESP_OK) result = esp_http_client_set_header(client, "Content-Type", "application/json");
+    if (post && result == ESP_OK) result = esp_http_client_set_post_field(client, body.data(), body.size());
+    if (result == ESP_OK) result = esp_http_client_perform(client);
+    const int status = esp_http_client_get_status_code(client);
+    esp_http_client_cleanup(client);
+    const bool saved = !capture || response.sync();
+    response.close();
+    if (sink.failed || !saved || (capture && result != ESP_OK)) return -3;
+    return status > 0 ? status : -1;
+  }
+  StrId resolveBook() {
+    std::string encoded; encoded.reserve(destination.size() * 3);
+    constexpr char hex[] = "0123456789ABCDEF";
+    for (unsigned char ch : destination) {
+      if (std::isalnum(ch) || ch == '-' || ch == '_') encoded += ch;
+      else { encoded += '%'; encoded += hex[ch >> 4]; encoded += hex[ch & 15]; }
+    }
+    int status = request(std::string(API_URL) + "?parent_id=" + encoded, false, {}, true);
+    const auto failure = [](int status) {
+      return status == 401 || status == 403 ? StrId::STR_WORKFLOWY_AUTH_FAILED
+                : status <= 0 ? StrId::STR_WORKFLOWY_NETWORK_FAILED : StrId::STR_WORKFLOWY_SEND_FAILED;
+    };
+    if (status != 200) return failure(status);
+    // Response bytes stay on SD; only filtered child IDs/names use PSRAM.
+    ShareJsonAllocator allocator;
+    JsonDocument nodes(&allocator), filter;
+    filter["nodes"][0]["id"] = true; filter["nodes"][0]["name"] = true;
+    FsFile response;
+    if (!Storage.openFileForRead("WF", RESPONSE_FILE, response)) return StrId::STR_WORKFLOWY_READ_FAILED;
+    const auto invalid = deserializeJson(nodes, response, DeserializationOption::Filter(filter));
+    response.close();
+    if (invalid || !nodes["nodes"].is<JsonArray>()) return StrId::STR_WORKFLOWY_READ_FAILED;
+    bookParent = workflowy::findBookGroup(nodes["nodes"].as<JsonArrayConst>(), bookTitle, bookAuthor);
+    nodes.clear();
+    if (!bookParent.empty()) return StrId::STR_WORKFLOWY_SENT;
+    JsonDocument create;
+    create["parent_id"] = destination;
+    create["name"] = oneLine(workflowy::bookGroupLabel(bookTitle, bookAuthor));
+    create["position"] = "bottom";
+    std::string body;
+    if (!serializeJson(create, body) || create.overflowed()) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+    status = request(API_URL, true, body, true);
+    if (status < 200 || status >= 300) return failure(status);
+    JsonDocument result;
+    if (!Storage.openFileForRead("WF", RESPONSE_FILE, response)) return StrId::STR_WORKFLOWY_READ_FAILED;
+    const auto error = deserializeJson(result, response);
+    response.close();
+    bookParent = result["item_id"] | "";
+    return !error && workflowy::bookNodeId(bookParent) ? StrId::STR_WORKFLOWY_SENT : StrId::STR_WORKFLOWY_READ_FAILED;
+  }
+
+  int receiptSeen(uint64_t target) {
+    if (!Storage.exists(receiptPath.c_str())) return 0;
+    FsFile file;
+    if (!Storage.openFileForRead("WF", receiptPath.c_str(), file)) return -1;
+    uint64_t value;
+    while (file.read(&value, sizeof(value)) == sizeof(value)) if (value == target) return 1;
+    return 0;
+  }
+  bool saveReceipt(uint64_t receipt) {
+    FsFile file = Storage.open(receiptPath.c_str(), O_WRONLY | O_CREAT);
+    return file && file.seek(file.size() / sizeof(receipt) * sizeof(receipt)) &&
+           file.write(&receipt, sizeof(receipt)) == sizeof(receipt) && file.sync();
+  }
+  bool load(const std::string& path) {
+    spoolPath = path;
+    FsFile file;
+    if (!Storage.openFileForRead("WF", path.c_str(), file)) return false;
+    uint32_t bytes = 0;
+    if (file.read(&bytes, sizeof(bytes)) != sizeof(bytes) || !bytes || bytes > 4096 || bytes > file.size() - sizeof(bytes)) return false;
+    std::string header(bytes, '\0');
+    if (file.read(header.data(), bytes) != static_cast<int>(bytes)) return false;
+    JsonDocument metadata;
+    if (deserializeJson(metadata, header) || metadata["version"].as<int>() != 1) return false;
+    destination = metadata["destination"] | ""; bookTitle = metadata["title"] | ""; bookAuthor = metadata["author"] | "";
+    accountHash = metadata["account"].as<uint64_t>();
+    const char* id = metadata["receipt"] | "";
+    if (std::strlen(id) != 16 || std::string_view(id).find_first_not_of("0123456789abcdef") != std::string_view::npos || destination.empty() || bookTitle.empty()) return false;
+    receiptPath = std::string("/.crashink/.workflowy/") + id + ".sent";
+    dataOffset = sizeof(bytes) + bytes;
+    key = workflowy::readSetting(workflowy::KEY_FILE, workflowy::KEY_MAX);
+    checkRemoteQuote = Storage.exists((spoolPath + ".started").c_str());
+    return true;
+  }
+  StrId send() {
+    if (key.empty() || (accountHash && accountHash != receiptHash(key))) return StrId::STR_WORKFLOWY_AUTH_FAILED;
+    size_t offset = dataOffset;
+    bool connected = false, sentAny = false;
+    while (true) {
+      if (millis() - workerStartedAt >= 180000u) return StrId::STR_WORKFLOWY_NETWORK_FAILED;
+      FsFile spool;
+      if (!Storage.openFileForRead("WF", spoolPath.c_str(), spool)) return StrId::STR_WORKFLOWY_READ_FAILED;
+      if (offset == spool.size()) return sentAny ? StrId::STR_WORKFLOWY_SENT : StrId::STR_WORKFLOWY_ALREADY_SENT;
+      uint32_t length = 0; uint64_t receipt = 0;
+      if (!spool.seek(offset) || spool.read(&receipt, sizeof(receipt)) != sizeof(receipt) ||
+          spool.read(&length, sizeof(length)) != sizeof(length) || !length || length > 256u * 1024u || length > spool.size() - spool.position()) return StrId::STR_WORKFLOWY_READ_FAILED;
+      std::string body(length, '\0');
+      if (spool.read(body.data(), length) != static_cast<int>(length)) return StrId::STR_WORKFLOWY_READ_FAILED;
+      offset = spool.position(); spool.close();
+      const int recorded = receiptSeen(receipt);
+      if (recorded < 0) return StrId::STR_WORKFLOWY_READ_FAILED;
+      if (recorded) continue;
+      if (!connected) {
+        if (!connect()) return StrId::STR_WORKFLOWY_NETWORK_FAILED;
+        if (std::time(nullptr) < 1704067200 && !halClock.syncSystemTimeFromNTP()) return StrId::STR_WORKFLOWY_CLOCK_FAILED;
+        const auto grouped = resolveBook(); Storage.remove(RESPONSE_FILE);
+        if (grouped != StrId::STR_WORKFLOWY_SENT) return grouped;
+        connected = true;
+      }
+      JsonDocument quote;
+      if (deserializeJson(quote, body)) return StrId::STR_WORKFLOWY_READ_FAILED;
+      quote["parent_id"] = bookParent;
+      if (checkRemoteQuote) {
+        // A previous POST may have reached Workflowy before its response was lost.
+        // Compare actual child text before retrying that first unacknowledged quote.
+        const int listed = request(std::string(API_URL) + "?parent_id=" + bookParent, false, {}, true);
+        if (listed != 200) return StrId::STR_WORKFLOWY_NETWORK_FAILED;
+        FsFile response;
+        ShareJsonAllocator allocator;
+        JsonDocument children(&allocator), filter;
+        filter["nodes"][0]["name"] = true;
+        if (!Storage.openFileForRead("WF", RESPONSE_FILE, response) ||
+            deserializeJson(children, response, DeserializationOption::Filter(filter)) || !children["nodes"].is<JsonArray>()) return StrId::STR_WORKFLOWY_READ_FAILED;
+        response.close(); Storage.remove(RESPONSE_FILE);
+        bool exists = false;
+        for (JsonObjectConst child : children["nodes"].as<JsonArrayConst>())
+          if (workflowy::bookGroupKey(child["name"] | "") == workflowy::bookGroupKey(quote["name"] | "")) { exists = true; break; }
+        checkRemoteQuote = false;
+        if (exists) { if (!saveReceipt(receipt)) return StrId::STR_WORKFLOWY_RECEIPT_FAILED; sentAny = true; continue; }
+      }
+      {
+        FsFile marker = Storage.open((spoolPath + ".started").c_str(), O_WRONLY | O_CREAT | O_TRUNC);
+        const uint8_t value = 1;
+        if (!marker || marker.write(&value, 1) != 1 || !marker.sync()) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+      }
+      body.clear();
+      if (!serializeJson(quote, body) || quote.overflowed()) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+      const int status = request(API_URL, true, body, false);
+      if (status == 401 || status == 403) return StrId::STR_WORKFLOWY_AUTH_FAILED;
+      if (status < 200 || status >= 300) return status <= 0 ? StrId::STR_WORKFLOWY_NETWORK_FAILED : StrId::STR_WORKFLOWY_SEND_FAILED;
+      if (!saveReceipt(receipt)) return StrId::STR_WORKFLOWY_RECEIPT_FAILED;
+      sentAny = true;
+    }
+  }
+
+};
+
+void finishShare(const StrId result) {
+  const bool ok = result == StrId::STR_WORKFLOWY_SENT || result == StrId::STR_WORKFLOWY_ALREADY_SENT;
+  if (!ok) error.store(result);
+  // Accepted shares are confirmed once, before Wi-Fi starts. A completion
+  // must not replay a second "Sent" toast over the reader. Failed transport
+  // remains durably queued; local staging errors still use takeShareError().
+}
+
+StrId stageShare(ShareJob& job, const size_t index, const int colorFilter, bool& hasItems) {
+  const auto destination = workflowy::readSetting(DEST_FILE, DEST_MAX);
+  job.destination = destination.empty() ? DEFAULT_DESTINATION : destination;
+  job.bookTitle = CLIPPINGS.getBookTitle();
+  job.bookAuthor = CLIPPINGS.getBookAuthor();
+  if (job.bookTitle.empty()) {
+    job.bookTitle = CLIPPINGS.getBookFilePath();
+    const auto slash = job.bookTitle.find_last_of('/');
+    if (slash != std::string::npos) job.bookTitle.erase(0, slash + 1);
+    const auto dot = job.bookTitle.rfind('.');
+    if (dot != std::string::npos) job.bookTitle.resize(dot);
+  }
+  char path[64];
+  snprintf(path, sizeof(path), "/.crashink/.workflowy/%016llx.sent",
+           static_cast<unsigned long long>(receiptHash(CLIPPINGS.getBookFilePath())));
+  job.receiptPath = path;
+  Storage.mkdir("/.crashink");
+  Storage.mkdir("/.crashink/.workflowy");
+
+  Storage.mkdir(OUTBOX);
+  char pending[128];
+  snprintf(pending, sizeof(pending), "%s/%010lu-%010lu-%08lx.job", OUTBOX,
+           static_cast<unsigned long>(std::time(nullptr)), static_cast<unsigned long>(millis()),
+           static_cast<unsigned long>(esp_random()));
+  job.spoolPath = pending;
+  const auto temporary = job.spoolPath + ".tmp";
+  FsFile spool = Storage.open(temporary.c_str(), O_WRONLY | O_CREAT | O_TRUNC);
+  if (!spool) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+  JsonDocument metadata;
+  metadata["version"] = 1; metadata["destination"] = job.destination; metadata["title"] = job.bookTitle;
+  metadata["author"] = job.bookAuthor; metadata["account"] = job.key.empty() ? 0 : receiptHash(job.key);
+  metadata["receipt"] = std::string(path).substr(std::string(path).find_last_of('/') + 1, 16);
+  std::string header;
+  serializeJson(metadata, header);
+  const uint32_t headerLength = header.size();
+  if (!headerLength || headerLength > 4096 || spool.write(&headerLength, sizeof(headerLength)) != sizeof(headerLength) ||
+      spool.write(header.data(), header.size()) != header.size()) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+  const size_t end = index == SIZE_MAX ? CLIPPINGS.clippingCount() : index + 1;
+  const auto keyHash = receiptHash(job.key);
+  for (size_t current = index == SIZE_MAX ? 0 : index; current < end; ++current) {
+    const auto* clipping = CLIPPINGS.clippingAt(current);
+    if (!clipping || (colorFilter && static_cast<int>(clipping->color) + 1 != colorFilter)) continue;
+    std::string quote, note, chapter;
+    if (!CLIPPINGS.readClippingNote(current, note) || !CLIPPINGS.readClippingText(current, quote)) {
+      return StrId::STR_WORKFLOWY_READ_FAILED;
+    }
+    CLIPPINGS.readChapterTitle(current, chapter);
+    std::string citation;
+    citation = oneLine(workflowy::quoteSourceLabel(job.bookTitle, job.bookAuthor, chapter));
+    auto name = oneLine(quote);
+    if (!citation.empty()) name += "\n\n" + citation;
+    if (!note.empty()) name += "\n\n📝 " + oneLine(note);
+    JsonDocument request;
+    request["parent_id"] = destination.empty() ? DEFAULT_DESTINATION : destination;
+    request["name"] = name;
+    request["position"] = "bottom";
+    std::string body;
+    if (!serializeJson(request, body) || request.overflowed()) return StrId::STR_WORKFLOWY_SEND_FAILED;
+    auto receipt = receiptHash("book-group-v1:" + job.bookTitle + "\n" + job.bookAuthor, keyHash);
+    receipt = receiptHash(body, receipt);
+    receipt = (receipt ^ clipping->spineIndex) * 1099511628211ULL;
+    receipt = (receipt ^ clipping->startPage) * 1099511628211ULL;
+    receipt = (receipt ^ clipping->startWordIndex) * 1099511628211ULL;
+    const auto length = static_cast<uint32_t>(body.size());
+    if (spool.write(&receipt, sizeof(receipt)) != sizeof(receipt) ||
+        spool.write(&length, sizeof(length)) != sizeof(length) ||
+        spool.write(body.data(), body.size()) != body.size()) {
+      return StrId::STR_WORKFLOWY_SAVE_FAILED;
+    }
+    hasItems = true;
+  }
+  const bool saved = spool.sync();
+  spool.close();
+  if (!saved || !Storage.rename(temporary.c_str(), job.spoolPath.c_str())) return StrId::STR_WORKFLOWY_SAVE_FAILED;
+  return StrId::STR_WORKFLOWY_SENT;
+}
+}  // namespace
+
+std::string oldestShare() {
+  HalFile folder = Storage.open(OUTBOX);
+  if (!folder || !folder.isDirectory()) return {};
+  std::string oldest;
+  while (true) {
+    HalFile entry = folder.openNextFile();
+    if (!entry) break;
+    char name[128]{};
+    entry.getName(name, sizeof(name));
+    const bool regular = !entry.isDirectory(); entry.close();
+    const std::string candidate(name);
+    if (regular && candidate.ends_with(".job") && (oldest.empty() || candidate < oldest)) oldest = candidate;
+  }
+  return oldest.empty() ? std::string{} : std::string(OUTBOX) + "/" + oldest;
+}
+
+void workflowy::shareClippings(const size_t index, const int colorFilter) {
+  auto job = makeUniqueNoThrow<ShareJob>();
+  if (!job) { LOG_ERR("WF", "Cannot allocate share job"); finishShare(StrId::STR_WORKFLOWY_SAVE_FAILED); return; }
+  job->key = readSetting(KEY_FILE, KEY_MAX);
+  bool hasItems = false;
+  StrId result;
+  {
+    RenderLock lock; // serialize ClippingStore's single-reader SD handle with the clipping list render
+    result = stageShare(*job, index, colorFilter, hasItems);
+  }
+  if (result != StrId::STR_WORKFLOWY_SENT) { finishShare(result); return; }
+  if (!hasItems) { Storage.remove(job->spoolPath.c_str()); finishShare(StrId::STR_WORKFLOWY_ALREADY_SENT); return; }
+  shareGeneration.fetch_add(1);
+  notice.store(static_cast<int>(StrId::STR_WORKFLOWY_SHARING));
+  pendingKick.store(true);
+}
+
+void workflowy::startQueuedShares() {
+  if (notice.load() >= 0) return; // the UI has not confirmed the enqueue yet
+  if (!pendingKick.exchange(false) || sending.exchange(true)) return;
+  const auto sendTask = [](void*) {
+    workerStartedAt = millis();
+    bool ownsWifi = false;
+    const auto releaseWorker = [&](uint32_t generation) {
+      // Finish network cleanup before another Share can start a replacement worker.
+      if (ownsWifi) { WiFi.disconnect(false, false); WiFi.mode(WIFI_OFF); ownsWifi = false; }
+      sending.store(false);
+      if (shareGeneration.load() != generation && !sending.exchange(true)) { workerStartedAt = millis(); return true; }
+      return false;
+    };
+    while (true) {
+      const auto generation = shareGeneration.load();
+      const auto path = oldestShare();
+      if (path.empty()) {
+        if (releaseWorker(generation)) continue;
+        break;
+      }
+      auto job = makeUniqueNoThrow<ShareJob>();
+      if (!job) { LOG_ERR("WF", "Cannot allocate outbox reader"); if (releaseWorker(generation)) continue; break; }
+      if (!job->load(path)) {
+        LOG_ERR("WF", "Invalid outbox item retained for recovery");
+        Storage.rename(path.c_str(), (path + ".bad").c_str());
+
+        if (releaseWorker(generation)) continue; break;
+      }
+      const auto result = job->send(); ownsWifi |= job->ownsWifi;
+      Storage.remove(ShareJob::RESPONSE_FILE);
+      if (result != StrId::STR_WORKFLOWY_SENT && result != StrId::STR_WORKFLOWY_ALREADY_SENT) {
+        LOG_ERR("WF", "Share pending locally (reason %d)", static_cast<int>(result));
+
+        if (releaseWorker(generation)) continue; break;
+      }
+      if (!Storage.remove(path.c_str())) {
+        LOG_ERR("WF", "Cannot remove acknowledged outbox item; receipts prevent resending");
+        if (releaseWorker(generation)) continue; break;
+      }
+      Storage.remove((path + ".started").c_str());
+      finishShare(result);
+    }
+    if (ownsWifi) { WiFi.disconnect(false, false); WiFi.mode(WIFI_OFF); }
+    vTaskDelete(nullptr);
+  };
+  if (xTaskCreate(sendTask, "wf-share", 12288, nullptr, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    sending.store(false);
+    LOG_ERR("WF", "Share remains queued; cannot start network worker");
+  }
+}
+
+bool workflowy::shareInProgress() { return sending.load() || pendingKick.load(); }
+bool workflowy::shareNoticePending() { return notice.load() >= 0; }
+
+std::optional<StrId> workflowy::takeShareError() {
+  const auto result = error.exchange(StrId::STR_WORKFLOWY_SENT);
+  if (result == StrId::STR_WORKFLOWY_SENT) return std::nullopt;
+  return result;
+}
+
+std::optional<StrId> workflowy::takeShareNotice() {
+  const int value = notice.exchange(-1);
+  return value < 0 ? std::nullopt : std::optional<StrId>(static_cast<StrId>(value));
+}
