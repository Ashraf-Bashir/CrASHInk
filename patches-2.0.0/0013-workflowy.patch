@@ -0,0 +1,28 @@
+from pathlib import Path
+import sys
+source = Path(sys.argv[1]).read_text()
+# The shared ribbon is covered by app_launcher; isolate status text here.
+source = source.replace('  AppNavigation::draw(renderer, appNavigationView());\n', '')
+start = source.index('void WorkflowyDailyActivity::drawStatus(')
+end = source.index('void WorkflowyDailyActivity::render(', start)
+error_start = source.index('bool isErrorNotice(')
+error_end = source.index('class WorkflowyErrorDetails', error_start)
+notice_start = source.index('void WorkflowyDailyActivity::showMessage(')
+notice_end = source.index('std::string WorkflowyDailyActivity::errorDescription()', notice_start)
+Path(sys.argv[2]).write_text(source[error_start:error_end] + source[notice_start:notice_end] + source[start:end])
+
+keyboard = Path(sys.argv[3]).read_text()
+tags = keyboard.index('constexpr const char* TAGS[]')
+tags_end = keyboard.index('};', tags) + 2
+start = keyboard.index('size_t KeyboardEntryActivity::tagStart() const')
+end = keyboard.index('bool KeyboardEntryActivity::insertTagAt', start)
+with Path(sys.argv[2]).open('a') as output:
+    output.write('\nnamespace {\n' + keyboard[tags:tags_end] + '\n}\n' + keyboard[start:end])
+
+for begin, end in [
+    ('void drawZoomArrow(', '// Keep response and parsed fields'),
+    ('bool WorkflowyDailyActivity::tapArrow(', 'void WorkflowyDailyActivity::edit('),
+]:
+    start = source.index(begin)
+    with Path(sys.argv[2]).open('a') as output:
+        output.write('\n' + source[start:source.index(end, start)])
