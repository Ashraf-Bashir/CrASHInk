+constexpr int TAG_ROW_HEIGHT = 30;
+constexpr int TAG_ROWS = (std::size(TAGS) + TAG_COLUMNS) / TAG_COLUMNS;
+constexpr int DATE_CELL = TAG_ROWS * TAG_COLUMNS - 1;
+}  // namespace
+
+fui::Rect KeyboardEntryActivity::tagPanel() const {
+  const auto keyboard = keyboardRect();
+  return {keyboard.x, static_cast<int16_t>(keyboard.y - TAG_ROWS * TAG_ROW_HEIGHT), keyboard.width,
+          TAG_ROWS * TAG_ROW_HEIGHT};
+}
+
+size_t KeyboardEntryActivity::tagStart() const {
+  if (!workflowyTags) return std::string::npos;
+  if (cursorPos > 0 && cursorPos <= text.size()) {
+    const auto space = text.find_last_of(" \t\r\n", cursorPos - 1);
+    const auto start = space == std::string::npos ? 0 : space + 1;
+    if (start < cursorPos && (text[start] == '#' || text[start] == '@') &&
+        (cursorPos == text.size() || text[cursorPos] == ' ')) {
+      const auto prefix = std::string_view(text).substr(start, cursorPos - start);
+      if (std::any_of(std::begin(TAGS), std::end(TAGS), [&](std::string_view tag) {
+            return tag.starts_with(prefix);
+          })) return start;
+    }
+  }
+  return workflowyTagPalette ? std::min(cursorPos, text.size()) : std::string::npos;
+}
+
+bool KeyboardEntryActivity::insertTagAt(int x, int y) {
+  const auto start = tagStart();
+  if (start == std::string::npos) return false;
+  const auto panel = tagPanel();
+  if (x < panel.x || x >= panel.right() || y < panel.y || y >= panel.bottom()) return false;
+  const auto prefix = std::string_view(text).substr(start, cursorPos - start);
+  const int cell = (y - panel.y) / TAG_ROW_HEIGHT * TAG_COLUMNS + (x - panel.x) * TAG_COLUMNS / panel.width;
+  if (cell == DATE_CELL && workflowyDatePicker) {
+    startActivityForResult(workflowyDatePicker(), [this](const ActivityResult& result) {
+      if (result.isCancelled) return;
+      const auto& date = std::get<KeyboardResult>(result.data).text;
+      if (date.empty()) return;
+      std::string token = "[" + date + "]";
+      const auto cursor = std::min(cursorPos, text.size());
+      if (cursor > 0 && text[cursor - 1] != ' ') token.insert(token.begin(), ' ');
+      if (cursor < text.size() && text[cursor] != ' ') token += ' ';
+      {
+        RenderLock lock(*this);
+        insertUtf8(token.c_str());
+        keepCursorVisible = true;
+      }
+      requestUpdate();
+    });
+    return true;
+  }
+  int matched = 0;
+  for (const auto* tag : TAGS) {
+    if (!std::string_view(tag).starts_with(prefix)) continue;
+    if (matched++ != cell) continue;
+    const auto previousText = workflowyStyles.empty() ? std::string{} : text;
+    if (workflowyTagPalette) {
+      if (!workflowy::completeTaskPrefixTag(text, cursorPos, tag, maxLength,
+                                            prefix.empty() ? std::string::npos : start)) return true;
+    } else {
+      std::string replacement = tag;
+      replacement += ' ';
+      const auto previous = cursorPos - start;
+      if (maxLength && text.size() - previous + replacement.size() > maxLength) return true;
+      text.replace(start, previous, replacement);
+      cursorPos = start + replacement.size();
+      if (cursorPos < text.size() && text[cursorPos] == ' ') text.erase(cursorPos, 1);
+    }
+    symbols = false;
+    workflowy::rebaseTextStyles(previousText, text, workflowyStyles);
+    selectionAnchor = selectionEnd = std::string::npos;
+    shifted = !workflowyTagPalette || cursorPos == 0 || cursorPos > text.size() ||
+              text[cursorPos - 1] == ' ';
+    capitalizeAfterTag = shifted;
+    clampSelection();
+    touchRouter.reset();
+    requestUpdate();
+    return true;
+  }
+  return false;
+}
+
+void KeyboardEntryActivity::drawTags() const {
+  const auto start = tagStart();
+  if (start == std::string::npos) return;
+  const auto panel = tagPanel();
+  const auto prefix = std::string_view(text).substr(start, cursorPos - start);
+  const auto drawCell = [&](const char* label, int cell) {
+    const int column = cell % TAG_COLUMNS;
+    const int left = panel.x + column * panel.width / TAG_COLUMNS;
+    const int right = panel.x + (column + 1) * panel.width / TAG_COLUMNS;
+    const int y = panel.y + cell / TAG_COLUMNS * TAG_ROW_HEIGHT;
+    renderer.drawRoundedRect(left + 3, y + 2, right - left - 6, TAG_ROW_HEIGHT - 4, 1, 4, true);
+    const auto fitted = renderer.truncatedText(SMALL_FONT_ID, label, right - left - 12);
+    renderer.drawText(SMALL_FONT_ID, left + (right - left - renderer.getTextWidth(SMALL_FONT_ID, fitted.c_str())) / 2,
+                      y + (TAG_ROW_HEIGHT - renderer.getLineHeight(SMALL_FONT_ID)) / 2, fitted.c_str());
+  };
+  int cell = 0;
+  for (const auto* tag : TAGS) {
+    if (std::string_view(tag).starts_with(prefix)) drawCell(tag, cell++);
+  }
+  if (workflowyDatePicker) drawCell(tr(STR_DATE), DATE_CELL);
+}
+
+bool KeyboardEntryActivity::hasTextSelection() const {
+  return selectionAnchor != std::string::npos && selectionEnd != std::string::npos && selectionAnchor != selectionEnd;
+}
+
+fui::Rect KeyboardEntryActivity::formattingPanel() const {
+  const auto panel = tagPanel();
+  return {panel.x, static_cast<int16_t>(panel.y - TAG_ROW_HEIGHT), panel.width, TAG_ROW_HEIGHT};
+}
+
+int KeyboardEntryActivity::textInputBottom() const {
+  if (workflowyFormatting) return formattingPanel().y;
+  return tagStart() != std::string::npos ? tagPanel().y : keyboardRect().y;
+}
+
+void KeyboardEntryActivity::drawFormatting() const {
+  const auto panel = formattingPanel();
+  const int count = workflowy::textStyles.size();
+  const int y = panel.y + (panel.height - renderer.getLineHeight(UI_10_FONT_ID)) / 2;
+  const char* labels[] = {"B", "I", "U", "S"};
+  for (int i = 0; i < count; ++i) {
+    const int left = panel.x + i * panel.width / count;
+    const int right = panel.x + (i + 1) * panel.width / count;
+    renderer.drawRoundedRect(left + 3, panel.y + 2, right - left - 6, panel.height - 4, 1, 4, true);
+    if (i == 4) {
+      renderer.fillRectDither((left + right) / 2 - 10, y + 4, 20, 12, Color::LightGray);
+    } else {
+      const char flag = static_cast<char>(workflowy::textStyles[i]);
+      const int x = (left + right - renderer.getTextWidth(UI_10_FONT_ID, labels[i])) / 2;
+      workflowy::layoutStyledText(renderer, UI_10_FONT_ID, x, y, labels[i], std::string_view(&flag, 1), true);
+    }
+  }
+}
+
+bool KeyboardEntryActivity::handleFormattingTouch(bool tapped, int x, int y) {
+  const auto panel = formattingPanel();
+  if (tapped && x >= panel.x && x < panel.right() && y >= panel.y && y < panel.bottom()) {
+    if (hasTextSelection()) {
+      const auto begin = std::min(selectionAnchor, selectionEnd);
+      const auto end = std::max(selectionAnchor, selectionEnd);
+      auto index = (x - panel.x) * workflowy::textStyles.size() / panel.width;
+      {
+        RenderLock lock(*this);
+        workflowy::toggleTextStyle(workflowyStyles, text.size(), begin, end, workflowy::textStyles[index]);
+      }
+      requestUpdate();
+    }
+    return true;
+  }
+  int heldX = 0, heldY = 0;
+  if (mappedInput.wasScreenTouchDown(heldX, heldY)) {
+    touchSelectionStart = std::string::npos;
+    draggingSelection = false;
+    if (heldY < panel.y) {
+      size_t offset = 0;
+      if (inputFieldTouchTargetFromPoint(heldX, heldY, offset) == InputFieldTouchTarget::Cursor) {
+        touchSelectionStart = offset;
+        selectionTouchX = heldX;
+        selectionTouchY = heldY;
+      }
+    }
+  }
+  if (touchSelectionStart == std::string::npos) return false;
+  if (mappedInput.isScreenTouchHeld(heldX, heldY)) {
+    const bool displaced = std::abs(heldX - selectionTouchX) >= 8 || std::abs(heldY - selectionTouchY) >= 8;
+    int longX = 0, longY = 0;
+    const bool longPress = mappedInput.isScreenTouchLongPress(longX, longY, 420);
+    if (draggingSelection || displaced || longPress) {
+      size_t offset = touchSelectionStart;
+      if (inputFieldTouchTargetFromPoint(heldX, std::min<int>(heldY, panel.y - 1), offset) !=
+          InputFieldTouchTarget::Cursor) return true;
+      size_t begin = touchSelectionStart, end = offset;
+      if (!displaced && longPress) {
+        while (begin > 0 && text[utf8Prev(text, begin)] != ' ') begin = utf8Prev(text, begin);
+        while (end < text.size() && text[end] != ' ') end = utf8Next(text, end);
+      }
+      const bool changed = selectionAnchor != begin || selectionEnd != end;
+      draggingSelection = true;
+      if (changed) {
+        selectionAnchor = begin;
+        selectionEnd = end;
+        requestUpdate();
+      }
+      return true;
+    }
+  }
+  if (mappedInput.wasScreenTouchReleased() || tapped) {
+    const bool consumed = draggingSelection;
+    touchSelectionStart = std::string::npos;
+    draggingSelection = false;
+    return consumed;
   }
+  return false;
+}

