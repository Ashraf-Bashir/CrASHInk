+void drawCheckedBox(GfxRenderer& renderer, int x, int y, int size) {
+  renderer.fillRect(x, y, size, size, true);
+  const int stroke = size >= 12 ? 2 : 1;
+  renderer.drawLine(x + size / 4, y + size / 2, x + size * 5 / 12, y + size * 3 / 4, stroke, false);
+  renderer.drawLine(x + size * 5 / 12, y + size * 3 / 4, x + size * 4 / 5, y + size / 4, stroke, false);
+}
+
+void drawZoomArrow(GfxRenderer& renderer, int x, int y, bool expanded, bool confirmed) {
+  const int xs[3] = {expanded ? x - 6 : x + 4, expanded ? x + 5 : x - 5, expanded ? x : x + 4};
+  const int ys[3] = {expanded ? y + 9 : y + 8, expanded ? y + 9 : y + 13,
+                     expanded ? y + 17 : y + 18};
+  // Expanded: point down. Collapsed: point left, hollow until children are known.
+  if (expanded || confirmed) renderer.fillPolygon(xs, ys, 3, true);
+  else for (int i = 0; i < 3; ++i) {
+    const int next = (i + 1) % 3;
+    renderer.drawLine(xs[i], ys[i], xs[next], ys[next]);
+  }
+}
