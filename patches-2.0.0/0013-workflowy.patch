+class WorkflowyErrorDetails final : public Activity {
+ public:
+  WorkflowyErrorDetails(GfxRenderer& renderer, MappedInputManager& input, const char* summary, std::string details)
+      : Activity("WorkflowyErrorDetails", renderer, input), summary(summary), details(std::move(details)) {}
+
+  void loop() override {
+    using Button = MappedInputManager::Button;
+    using Swipe = MappedInputManager::SwipeDir;
+    if (mappedInput.wasReleased(Button::Back) || mappedInput.wasReleased(Button::Confirm) ||
+        TouchHeaderBackButton::wasTapped(mappedInput, renderer)) return finish();
+    const auto button = doneButton();
+    if (mappedInput.wasTapInRect(button.x, button.y, button.width, button.height)) return finish();
+    const auto swipe = mappedInput.wasSwipe();
+    const bool forward = swipe == Swipe::Up || mappedInput.wasReleased(Button::Down);
+    const bool backward = swipe == Swipe::Down || mappedInput.wasReleased(Button::Up);
+    if (!forward && !backward) return;
+    {
+      RenderLock lock(*this);
+      offset = std::clamp(offset + (forward ? pageLines : -pageLines), 0, maxOffset);
+    }
+    requestUpdate();
+  }
+
+  void render(RenderLock&&) override {
+    renderer.clearScreen();
+    const auto header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+    TouchHeaderBackButton::draw(renderer, header, tr(STR_WORKFLOWY_ERROR_DETAILS), false);
+    int top, right, bottom, left;
+    renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+    int y = std::max(top, header.y + header.height) + 14;
+    std::vector<workflowy::TextSpan> lines;
+    const int width = renderer.getScreenWidth() - left - right - 24;
+    const auto draw = [&](std::string_view text, EpdFontFamily::Style style) {
+      lines.clear();
+      workflowy::wrapOutlineText(text, width, [&](std::string_view line) {
+        return renderer.getTextWidth(UI_12_FONT_ID, std::string(line).c_str(), style);
+      }, lines);
+      const int lineHeight = renderer.getLineHeight(UI_12_FONT_ID) + 6;
+      int first = 0, count = static_cast<int>(lines.size());
+      if (style != EpdFontFamily::BOLD) {
+        pageLines = std::max(1, (doneButton().y - y - 24) / lineHeight);
+        maxOffset = std::max(0, count - pageLines);
+        offset = std::min(offset, maxOffset);
+        first = offset;
+        count = std::min(count, first + pageLines);
+      }
+      for (int i = first; i < count; ++i) {
+        const auto begin = lines[i].begin, end = lines[i].end;
+        renderer.drawText(UI_12_FONT_ID, left + 12, y, std::string(text.substr(begin, end - begin)).c_str(), true, style);
+        y += lineHeight;
+      }
+    };
+    draw(summary, EpdFontFamily::BOLD);
+    if (!details.empty()) {
+      y += 12;
+      draw(details, EpdFontFamily::REGULAR);
+      if (maxOffset) {
+        const char* more = offset == 0 ? "↓" : offset == maxOffset ? "↑" : "↑   ↓";
+        renderer.drawCenteredText(SMALL_FONT_ID, doneButton().y - 22, more);
+      }
+    }
+    const auto button = doneButton();
+    renderer.drawRoundedRect(button.x, button.y, button.width, button.height, 1, 4, true);
+    renderer.drawCenteredText(UI_12_FONT_ID, button.y + (button.height - renderer.getLineHeight(UI_12_FONT_ID)) / 2,
+                              tr(STR_DONE));
+    renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+  }
+
+ private:
+  Rect doneButton() const {
+    int top, right, bottom, left;
+    renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+    const int width = std::min(160, renderer.getScreenWidth() - left - right - 24);
+    const int x = (renderer.getScreenWidth() + left - right - width) / 2;
+    return Rect{x, renderer.getScreenHeight() - bottom - 54, width, 44};
+  }
+  const char* summary;
+  std::string details;
+  int offset = 0, maxOffset = 0, pageLines = 1;
+};
