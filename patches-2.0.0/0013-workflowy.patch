index 0000000000000000000000000000000000000000..5f703342f687228bd244618bc8d097e82bb03e3d
--- /dev/null
+++ b/src/workflowy/WorkflowyActionBar.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <algorithm>
+
+namespace workflowy {
+// Drawing and hit testing use the same contiguous subset of action IDs.
+struct ActionBar {
+  int total;
+  int first;
+  int count() const { return total - first; }
+  int controlAt(int x, int left, int width) const {
+    return first + std::clamp((x - left) * count() / std::max(1, width), 0, count() - 1);
+  }
+  int center(int control, int left, int width) const {
+    return left + (2 * (control - first) + 1) * width / (2 * count());
+  }
+};
+}  // namespace workflowy
diff --git a/src/workflowy/WorkflowyBookGroup.h b/src/workflowy/WorkflowyBookGroup.h
new file mode 100644
index 0000000000000000000000000000000000000000..df07c76619f46b7f4d28958b12c875366d923d46
--- /dev/null
+++ b/src/workflowy/WorkflowyBookGroup.h
@@ -0,0 +1,61 @@
+#pragma once
+#include <ArduinoJson.h>
+#include <algorithm>
+#include <cctype>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace workflowy {
+inline bool bookNodeId(std::string_view id) {
+  return !id.empty() && id.size() <= 64 && id.find_first_not_of("0123456789abcdefABCDEF-") == std::string_view::npos;
+}
+inline std::string bookGroupLabel(const std::string& title, const std::string& author) {
+  return std::string("📘 ") + title + (author.empty() ? "" : " — " + author);
+}
+inline std::string quoteSourceLabel(const std::string& title, const std::string& author, const std::string& chapter) {
+  return std::string("📖 ") + title + (author.empty() ? "" : " — " + author) + (chapter.empty() ? "" : " — " + chapter);
+}
+inline std::string bookGroupKey(std::string_view text) {
+  std::string clean; clean.reserve(text.size());
+  bool tag = false, escaped = false;
+  for (const unsigned char ch : text) {
+    if (escaped) { clean += ch; escaped = false; continue; }
+    if (ch == '\\') { escaped = true; continue; }
+    if (ch == '<') { tag = true; continue; }
+    if (tag) { if (ch == '>') tag = false; continue; }
+    if (ch < 128 && std::isspace(ch)) {
+      if (!clean.empty() && clean.back() != ' ') clean += ' ';
+    } else clean += ch < 128 ? static_cast<char>(std::tolower(ch)) : static_cast<char>(ch);
+  }
+  for (const auto& entity : {std::pair{"&amp;", "&"}, {"&quot;", "\""}, {"&#39;", "'"}, {"&nbsp;", " "}, {"&lt;", "<"}, {"&gt;", ">"}}) {
+    size_t pos = 0;
+    while ((pos = clean.find(entity.first, pos)) != std::string::npos) {
+      clean.replace(pos, std::char_traits<char>::length(entity.first), entity.second);
+      pos += std::char_traits<char>::length(entity.second);
+    }
+  }
+  while (!clean.empty() && clean.back() == ' ') clean.pop_back();
+  for (const auto icon : {"📘", "📖", "📚", "📕", "📗", "📙"}) {
+    if (clean.starts_with(icon)) { clean.erase(0, std::char_traits<char>::length(icon)); break; }
+  }
+  if (clean.starts_with("\xef\xb8\x8f")) clean.erase(0, 3);
+  while (!clean.empty() && clean.front() == ' ') clean.erase(0, 1);
+  return clean;
+}
+// Prefer title + author. A pre-existing title-only parent is reused as a fallback.
+// Only direct children are inspected; quotes elsewhere in the account are untouched.
+inline std::string findBookGroup(JsonArrayConst nodes, const std::string& title, const std::string& author) {
+  const auto titleKey = bookGroupKey(title);
+  const auto exactKey = bookGroupKey(title + (author.empty() ? "" : " — " + author));
+  std::string fallback;
+  for (JsonObjectConst node : nodes) {
+    const char* id = node["id"] | "";
+    if (!bookNodeId(id)) continue;
+    const auto key = bookGroupKey(node["name"] | "");
+    if (key == exactKey) return id;
+    if (key == titleKey && fallback.empty()) fallback = id;
+  }
+  return fallback;
+}
+}
