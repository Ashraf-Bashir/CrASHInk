+void WorkflowyDailyActivity::toggleReplyFilter() {
+  if (selecting) cancelSelection();
+  {
+    RenderLock lock(*this);
+    replyOnly = !replyOnly;
+    layoutDirty = true;
+    wrapAnchor = -1;
+    page = 0;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::rememberTimedSection(const std::string& parent, const std::string& divider) {
+  // The registry replaces the former server-side description and must outlive
+  // the bounded recent-view list, otherwise revisiting old days duplicates dividers.
+  Storage.mkdir("/.crashink");Storage.mkdir(DIVIDER_REGISTRY);
+  const auto path=std::string(DIVIDER_REGISTRY)+"/"+parent;
+  const auto value=divider.empty()?std::string("-"):divider;
+  if(workflowy::readSetting(path.c_str(),80)!=value)workflowy::writeSetting(path.c_str(),value);
+  const auto found=std::find(timedSectionParents.begin(),timedSectionParents.end(),parent);
+  if(found==timedSectionParents.end()) {
+    if(timedSectionParents.size()>=32){timedSectionParents.erase(timedSectionParents.begin());timedSectionDividers.erase(timedSectionDividers.begin());}
+    timedSectionParents.push_back(parent);timedSectionDividers.push_back(divider);
+  } else {
+    const auto index=found-timedSectionParents.begin();
+    if(timedSectionDividers[index]==divider)return;
+    timedSectionDividers[index]=divider;
+  }
+  std::string saved;saved.reserve(32*75);
+  for(size_t i=0;i<timedSectionParents.size();++i){
+    if(i)saved+=',';saved+=timedSectionParents[i];
+    if(!timedSectionDividers[i].empty()){saved+='=';saved+=timedSectionDividers[i];}
+  }
+  workflowy::writeSetting(SORTED_PARENTS,saved);
+}
+
+void WorkflowyDailyActivity::sortTimedItems(bool automatic) {
+  if (!online) { if (!automatic) showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED)); return; }
+  if (!saves.empty() || awaitingOutline || !requestedBranch.empty()) return;
+  const auto parent = zoomId.empty() ? date : zoomId;
+  const unsigned depth = zoomId.empty() ? 0 : 1;
+  std::vector<std::pair<int, std::string>> timed;
+  timed.reserve(rows.size());
+  std::vector<std::string_view> current;
+  current.reserve(rows.size());
+  std::string divider;bool legacy=false;
+  for (const auto& node : rows) {
+    if (node.depth != depth || node.id == zoomId) continue;
+    current.push_back(node.id);
+    if (node.scheduledDivider) {divider=node.id;legacy=node.legacyDividerNote;}
+    if (node.divider || node.done || itemPending(node.id)) continue;
+    if (const auto range = workflowy::leadingTaskTimeRange(node.title)) timed.emplace_back(range->start, node.id);
+  }
+  timedSectionDirty = false;
+  const auto known = std::find(timedSectionParents.begin(), timedSectionParents.end(), parent);
+  if (automatic && known == timedSectionParents.end() && divider.empty() && timed.empty()) return;
+  rememberTimedSection(parent,divider);
+  if (timed.empty() && divider.empty()) {
+    if (!automatic) showMessage(tr(STR_WORKFLOWY_EMPTY));
+    return;
+  }
+  std::stable_sort(timed.begin(), timed.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+  std::vector<std::string_view> desired;
+  desired.reserve(current.size() + 1);
+  for (const auto& item : timed) desired.push_back(item.second);
+  if (!timed.empty()) desired.push_back(divider);
+  for (const auto& id : current) {
+    if (id != divider && std::none_of(timed.begin(), timed.end(), [&](const auto& item) { return item.second == id; }))
+      desired.push_back(id);
+  }
+  if (desired == current && !legacy) return;
+  std::vector<int> originalRanks;originalRanks.reserve(current.size()+1);
+  for(const auto id:current){
+    int rank=-1;
+    if(id==divider)rank=timed.size();
+    else for(size_t i=0;i<timed.size();++i)if(timed[i].second==id){rank=i;break;}
+    originalRanks.push_back(rank);
+  }
+  auto allocation = makeUniqueNoThrow<std::vector<std::pair<int, std::string>>>();
+  if (!allocation) {
+    LOG_ERR("WF", "Cannot allocate timed sorting job");
+    return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  }
+  allocation->swap(timed);
+  // One immutable list is shared by the worker and pending-row rendering.
+  // Avoid retaining a second full set of task IDs for large day lists.
+  std::shared_ptr<const std::vector<std::pair<int, std::string>>> sorting(std::move(allocation));
+  if (!queueSave({}, {}, false, [this, parent, sorting](const Save& save) {
+        if(!sorting->empty() && !save.resultItem.empty())rememberTimedSection(parent,save.resultItem);
+        if (save.status < 200 || save.status >= 300) {
+          timedSectionDirty = false;
+          return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+        }
+        rememberTimedSection(parent,sorting->empty()?"":save.resultItem);
+        if ((zoomId.empty()?date:zoomId)!=parent) return;
+        {
+          RenderLock lock(*this);
+          auto previous=std::move(rows);std::vector<Node> rebuilt;rebuilt.reserve(previous.size()+1);
+          const unsigned depth=zoomId.empty()?0:1;
+          const auto take=[&](const std::string& id){
+            auto it=std::find_if(previous.begin(),previous.end(),[&](const Node& node){return node.id==id;});
+            if(it==previous.end())return;
+            const auto level=it->depth;auto end=it+1;while(end!=previous.end() && end->depth>level)++end;
+            for(;it!=end;++it){rebuilt.push_back(std::move(*it));it->id.clear();}
+          };
+          if(!zoomId.empty() && !previous.empty() && previous.front().id==zoomId){
+            rebuilt.push_back(std::move(previous.front()));previous.front().id.clear();
+          }
+          for(const auto& item:*sorting)take(item.second);
+          if(!sorting->empty()){
+            Node separator;separator.id=save.resultItem;separator.depth=depth;
+            separator.divider=true;separator.scheduledDivider=true;separator.leaf=true;
+            rebuilt.push_back(std::move(separator));
+          }
+          for(auto& node:previous)if(!node.id.empty() && !node.scheduledDivider)rebuilt.push_back(std::move(node));
+          rows=std::move(rebuilt);layoutDirty=true;rootCheckedAt=millis();timedSectionDirty=false;forceNetworkRefresh=false;
+        }
+        std::vector<Node> siblings;siblings.reserve(rows.size());
+        const unsigned depth=zoomId.empty()?0:1;
+        for(const auto& node:rows)if(node.depth==depth && node.id!=zoomId)siblings.push_back(node);
+        cacheChildren(parent,siblings);
+      }, "POST", StrId::STR_SORT, {},
+      [parent, divider = std::move(divider), sorting, legacy, originalRanks=std::move(originalRanks)](Save& save) mutable {
+        save.resultItem=divider;
+        if (sorting->empty()) {
+          save.status = requestForSave(save, "DELETE", "/" + divider, {}, nullptr, nullptr, 0,
+                                       nullptr, nullptr, &save.transport, &save.error);
+          return;
+        }
+        if (divider.empty()) {
+          JsonDocument create;
+          create["parent_id"] = parent;
+          create["name"] = "";
+          create["layoutMode"] = "divider";
+          create["position"] = "top";
+          save.status = requestForSave(save, "POST", {}, encode(create), save.response.data(), &save.received,
+                                       save.response.size(), nullptr, nullptr, &save.transport, &save.error);
+          if (save.status < 200 || save.status >= 300) return;
+          JsonDocument response;
+          if (save.received > save.response.size() ||
+              deserializeJson(response, save.response.data(), save.received)) { save.status = -3; return; }
+          divider = response["item_id"] | "";
+          if (divider.empty()) { save.status = -3; return; }
+          save.resultItem=divider;
+          // Persist identity before later moves can fail or the UI can close.
+          Storage.mkdir("/.crashink");Storage.mkdir(DIVIDER_REGISTRY);
+          workflowy::writeSetting((std::string(DIVIDER_REGISTRY)+"/"+parent).c_str(),divider);
+          originalRanks.insert(originalRanks.begin(),sorting->size());
+        }
+        if(legacy){
+          JsonDocument clean;clean["note"]="";
+          save.status=requestForSave(save,"POST","/"+divider,encode(clean),nullptr,nullptr,0);
+          if(save.status<200 || save.status>=300)return;
+        }
+        const auto count=sorting->size()+1;
+        const auto moves=workflowy::timedPrefixMoves(originalRanks,count);
+        if(!moves){save.status=200;return;}
+        for(size_t i=moves;i>0;--i){
+          const auto& id=i-1==sorting->size()?divider:(*sorting)[i-1].second;
+          JsonDocument move;move["parent_id"]=parent;move["position"]="top";
+          save.status=requestForSave(save,"POST","/"+id+"/move",encode(move),nullptr,nullptr,0,
+                                      nullptr,nullptr,&save.transport,&save.error);
+          if(save.status<200 || save.status>=300)return;
+        }
+      })) return;
+  {
+    RenderLock lock(*this);
+    saves.back()->timedItems = std::move(sorting);
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::moveUnfinishedForward() {
+  const auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  const auto target = workflowy::shiftScheduleDate(source, 1);
+  if (target.empty()) return showMessage(tr(STR_WORKFLOWY_CLOCK_FAILED));
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const auto eligible = [&](const Node& node) { return node.todo && !node.done && selectionEligible(node); };
+  const size_t count = std::count_if(rows.begin(), rows.end(), eligible);
+  if (!count) return showMessage(tr(STR_WORKFLOWY_EMPTY));
+  if (count > MAX_SAVE_QUEUE - saves.size()) return showMessage(tr(STR_WORKFLOWY_QUEUE_FULL));
+  {
+    RenderLock lock(*this);
+    for (auto& node : rows) node.selected = eligible(node);
+    selecting = true;
+  }
+  startBulk(BulkAction::MoveDate, target);
+}
+
+void WorkflowyDailyActivity::shiftDay(int delta) {
+  auto source = validDate(date) ? date : isoDate(date == "tomorrow" ? 1 : 0);
+  if (source.empty()) return chooseDate();
+  int year, month, day;
+  if (sscanf(source.c_str(), "%d-%d-%d", &year, &month, &day) != 3) return;
+  day += delta;
+  if (day < 1) {
+    if (--month < 1) { month = 12; --year; }
+    day = monthLength(year, month);
+  } else if (day > monthLength(year, month)) {
+    if (++month > 12) { month = 1; ++year; }
+    day = 1;
+  }
+  char target[16];
+  snprintf(target, sizeof(target), "%04d-%02d-%02d", year, month, day);
+  if (validDate(target)) moveToDate({}, target);
+}
+
+void WorkflowyDailyActivity::moveToDate(const std::string& id, const std::string& target) {
+  if (id.empty()) {
+    if (date == target) return;
+    {
+      RenderLock lock(*this);
+      date = target;
+      replyOnly = false;
+      zoomId.clear();
+      viewStack.clear();
+      selecting = false;
+      page = 0;
+      rows.clear();
+      layoutDirty = true;
+    }
+    if (step != Step::Start) loadDay();
+    return;
+  }
+  const auto old = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+  if (old == rows.end()) return;
+  const auto original = moveOrigin(old - rows.begin());
+  JsonDocument update;
+  update["parent_id"] = target;
+  update["position"] = "bottom";
+  if (itemPending(id) || !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  queueSave("/" + id + "/move", encode(update), false, [this, id, target, original](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    const bool currentDay = target == date || (date == "today" && target == isoDate(0)) ||
+                            (date == "tomorrow" && target == isoDate(1));
+    const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == id; });
+    const bool moveToNode = !currentDay && target != original.parent && !validDate(target) &&
+                            target != "today" && target != "tomorrow";
+    Node moved;
+    const bool locallyVisible = moveToNode && item != rows.end();
+    if (locallyVisible) moved = *item;
+    removeNode(id, currentDay);
+    if (locallyVisible) {
+      RenderLock lock(*this);
+      appendChild(rows, target, moved);
+      for (auto& view : viewStack) appendChild(view.rows, target, moved);
+      layoutDirty = true;
+    }
+    offerUndo([this, id, original] { return restoreMove(id, original); });
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::chooseDate(std::string moveId) {
+  const auto title = moveId.empty() ? StrId::STR_WORKFLOWY_SHOW_DATE : StrId::STR_WORKFLOWY_MOVE_DATE;
+  const auto today = isoDate(0);
+  const auto selected = validDate(date) ? date : date == "tomorrow" ? isoDate(1) : today;
+  startActivityForResult(std::make_unique<WorkflowyDatePicker>(renderer, mappedInput, title, selected, today),
+                         [this, moveId = std::move(moveId)](const ActivityResult& result) {
+    if (!result.isCancelled) moveToDate(moveId, std::get<KeyboardResult>(result.data).text);
+  });
+}
+
+WorkflowyDailyActivity::Layout WorkflowyDailyActivity::layout() const {
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int rowTop = top + CONTENT_TOP + (!zoomId.empty() && !selecting ? 30 : 0);
+  const int footer = renderer.getScreenHeight() - bottom - 52 - AppNavigation::Height;
+  const int pageLabel = std::max(32, renderer.getLineHeight(SMALL_FONT_ID) + 3);
+  return {left + 8, top, renderer.getScreenWidth() - right - left - 16, rowTop, footer,
+          footer - pageLabel, std::max(1, renderer.getLineHeight(wrapItems ? UI_12_FONT_ID : UI_10_FONT_ID))};
+}
+
+void WorkflowyDailyActivity::layoutRows(const Layout& bounds) {
+  if (!layoutDirty && laidOut == bounds) return;
+  laidOut = bounds;
+  layoutDirty = false;
+  outlineLines.clear();
+  placements.clear();
+  pageStarts.assign(1, 0);
+  const int firstLineHeight = std::max(ROW_HEIGHT, bounds.lineHeight + 12);
+  int y = bounds.rowTop;
+  const unsigned visibleDepth = zoomId.empty() ? 0 : 1;
+  const auto placeRow = [&](size_t i) {
+    const auto& node = rows[i];
+    if (node.depth > visibleDepth) return;
+    if (node.scheduledDivider) {
+      bool unfinishedAbove = false;
+      // Count only rows actually drawn above the divider on this page, not
+      // matching tasks hidden by filters or left on an earlier page.
+      for (size_t before = pageStarts.back(); before < placements.size(); ++before) {
+        const auto& candidate = rows[placements[before].row];
+        if (candidate.depth == visibleDepth && !candidate.done && !candidate.divider &&
+            candidate.id != zoomId && workflowy::leadingTaskTimeRange(candidate.title)) {
+          unfinishedAbove = true;
+          break;
+        }
+      }
+      // A separator must never create its own page or become its first row.
+      if (!unfinishedAbove || y + 20 > bounds.rowBottom) return;
+    }
+    if (node.divider && !replyOnly) {
+      if (y + 20 > bounds.rowBottom) { pageStarts.push_back(placements.size()); y = bounds.rowTop; }
+      const auto first = outlineLines.size();
+      outlineLines.push_back({0, 0});
+      placements.push_back({i, first, 1, y, y + 20});
+      y += 20;
+      return;
+    }
+    // The zoomed root is rendered as a row too; filtering must not leave its
+    // entire non-matching note on screen. Breadcrumbs retain the parent context.
+    if (replyOnly && !workflowy::isReplyTask(node.title)) return;
+    if (completedOnly && !node.done) return;
+    if (node.done && !showDone && !completedOnly && !itemPending(node.id) && (i != 0 || zoomId.empty())) return;
+    const int indent = std::min<unsigned>(node.depth, 8) * 16;
+    const int width = std::max(1, bounds.width - indent - 25 - ROW_ARROW_TARGET);
+    size_t first = outlineLines.size();
+    if (wrapItems) {
+      const workflowy::TaskTextProjection projection(node.title);
+      const auto appendLines = [&](bool metadata) {
+        const auto text = projection.text(metadata);
+        if (text.empty() && metadata) return;
+        const int font = metadata ? SMALL_FONT_ID : UI_12_FONT_ID;
+        const auto measure = [&](std::string_view part) {
+          return renderer.getTextWidth(font, std::string(part).c_str());
+        };
+        const auto lineStart = outlineLines.size();
+        const auto capacityAt = [&](int top) {
+          return static_cast<size_t>(std::max(1, 1 + (bounds.rowBottom - top - firstLineHeight) / bounds.lineHeight));
+        };
+        const auto firstCapacity = capacityAt(y + firstLineHeight <= bounds.rowBottom ? y : bounds.rowTop);
+        const auto fullCapacity = capacityAt(bounds.rowTop);
+        const int allowance = renderer.getTextWidth(font, CONTINUATION) + CONTINUATION_GAP;
+        workflowy::wrapOutlineTextByLine(text, [&](size_t line) {
+          line += lineStart - first;
+          const bool leading = line >= firstCapacity && (line - firstCapacity) % fullCapacity == 0;
+          const bool trailing = line < firstCapacity ? line + 1 == firstCapacity
+                                                     : (line - firstCapacity + 1) % fullCapacity == 0;
+          return std::max(1, width - (static_cast<int>(leading) + static_cast<int>(trailing)) * allowance);
+        }, measure, outlineLines);
+        for (auto i = lineStart; i < outlineLines.size(); ++i) outlineLines[i].metadata = metadata;
+      };
+      appendLines(false);
+      appendLines(true);
+    } else {
+      const workflowy::TaskTextProjection projection(node.title, false);
+      outlineLines.push_back({0, workflowy::compactTaskText(projection.text(false)).size()});
+    }
+    while (first < outlineLines.size()) {
+      if (y != bounds.rowTop && y + firstLineHeight > bounds.rowBottom) {
+        pageStarts.push_back(placements.size());
+        y = bounds.rowTop;
+      }
+      const int capacity = std::max(1, 1 + (bounds.rowBottom - y - firstLineHeight) / bounds.lineHeight);
+      const auto count = std::min(static_cast<size_t>(capacity), outlineLines.size() - first);
+      const int height = firstLineHeight + (static_cast<int>(count) - 1) * bounds.lineHeight;
+      placements.push_back({i, first, count, y, y + height});
+      first += count;
+      y += height;
+    }
+  };
+  const size_t firstItem = !zoomId.empty() && !rows.empty() ? 1 : 0;
+  if (firstItem) placeRow(0);
+  const bool scheduledSections = std::any_of(rows.begin(), rows.end(), [&](const Node& node) {
+    return node.depth == visibleDepth && node.scheduledDivider;
+  });
+  for (size_t i = firstItem; i < rows.size(); ++i) {
+    if (scheduledSections || !rows[i].done) placeRow(i);
+  }
+  if ((showDone || completedOnly) && !scheduledSections) {
+    for (size_t i = firstItem; i < rows.size(); ++i) {
+      if (rows[i].done) placeRow(i);
+    }
+  }
+  if (wrapAnchor >= 0) {
+    const auto match = std::find_if(placements.begin(), placements.end(), [&](const Placement& placement) {
+      return placement.row == static_cast<size_t>(wrapAnchor);
+    });
+    if (match != placements.end()) {
+      const auto index = static_cast<size_t>(match - placements.begin());
+      page = std::upper_bound(pageStarts.begin(), pageStarts.end(), index) - pageStarts.begin() - 1;
+    }
+    wrapAnchor = -1;
+  }
+  page = std::min(page, pageStarts.size() - 1);
+
+}
+
+int WorkflowyDailyActivity::rowAt(const int x, int y, const bool dropping) const {
+  RenderLock lock;
+  if (layoutDirty || paintedPage != page || page >= pageStarts.size()) return -1;
+  if (!dropping && (x < laidOut.x || x >= laidOut.x + laidOut.width)) return -1;
+  const auto first = pageStarts[page];
+  const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+  if (first == end) return -1;
+  if (dropping) {
+    if (y < laidOut.rowTop - 4 || y >= laidOut.rowBottom) return -1;
+    // Treat the outline gutter and the unused space below the final row as
+    // part of the drop area. The header and toolbar still cancel the drop.
+    y = std::clamp(y, placements[first].top, placements[end - 1].bottom - 1);
+  }
+  for (auto i = first; i < end; ++i) {
+    const auto& hit = placements[i];
+    if (y >= hit.top && y < hit.bottom) return static_cast<int>(hit.row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::nextPage(const int delta, const bool edge) {
+  {
+    RenderLock lock(*this);
+    const int last = pageStarts.empty() ? 0 : static_cast<int>(pageStarts.size() - 1);
+    const auto next = static_cast<size_t>(edge ? (delta < 0 ? 0 : last)
+                                               : std::clamp(static_cast<int>(page) + delta, 0, last));
+    if (next == page) return;
+    page = next;
+  }
+  requestUpdate();
+}
+
+int WorkflowyDailyActivity::parentRow(size_t row) const {
+  const auto depth = rows[row].depth;
+  while (row > 0) {
+    --row;
+    if (rows[row].depth < depth) return static_cast<int>(row);
+  }
+  return -1;
+}
+
+void WorkflowyDailyActivity::zoom(size_t row) {
+  if (row >= rows.size() || rows[row].id == zoomId) return;
+  Node root = rows[row];
+  std::vector<Node> focused;
+  const bool cached = row + 1 < rows.size() && rows[row + 1].depth > root.depth;
+  if (!cached && root.leaf) {
+    // Empty fetches mark the node as a leaf. Repaint to remove its old arrow,
+    // without pushing a root-only view onto the breadcrumb stack.
+    requestUpdate();
+    return;
+  }
+  if (!cached && !root.leaf) {
+    if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+    {
+      RenderLock lock(*this);
+      requestedBranch = root.id;
+      message = nullptr;
+      if (prefetch && prefetch->parent != root.id) prefetch->cancel.store(true, std::memory_order_relaxed);
+    }
+    requestUpdate();
+    return;
+  }
+  {
+    RenderLock lock(*this);
+    if (cached) {
+      const auto first = rows.begin() + row + 1;
+      auto end = first;
+      while (end != rows.end() && end->depth > root.depth) ++end;
+      focused.reserve(end - first + 1);
+      focused.insert(focused.end(), std::make_move_iterator(first), std::make_move_iterator(end));
+      rows.erase(first, end);
+      for (auto& node : focused) node.depth -= root.depth;
+    }
+    root.depth = 0;
+    root.leaf = focused.empty();
+    root.childrenConfirmed = !root.leaf;
+    focused.insert(focused.begin(), std::move(root));
+    ++generation;
+    requestedBranch.clear();
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    timedSectionDirty = true;
+    viewStack.push_back({std::move(rows), std::move(zoomId), page});
+    zoomId = focused.front().id;
+    rows = std::move(focused);
+    page = 0;
+    layoutDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::back() {
+  if (viewStack.empty()) {
+    commitDelete();
+    if (!saves.empty()) {
+      leaveAfterSave = true;
+      return;
+    }
+    return finish();
+  }
+  returnToDepth(viewStack.size() - 1);
+}
+
+void WorkflowyDailyActivity::returnToDepth(size_t depth) {
+  if (depth >= viewStack.size()) return;
+  {
+    RenderLock lock(*this);
+    ++generation;
+    if (prefetch) prefetch->cancel.store(true, std::memory_order_relaxed);
+    requestedBranch.clear();
+    rootCheckedAt = millis();
+    awaitingOutline = false;
+    while (viewStack.size() > depth) {
+      auto previous = std::move(viewStack.back());
+      viewStack.pop_back();
+      const auto owner = std::find_if(previous.rows.begin(), previous.rows.end(),
+                                      [&](const Node& node) { return node.id == zoomId; });
+      if (!rows.empty() && rows.front().id == zoomId && owner != previous.rows.end()) {
+        const auto depth = owner->depth;
+        auto end = owner + 1;
+        while (end != previous.rows.end() && end->depth > depth) ++end;
+        *owner = std::move(rows.front());
+        owner->depth = depth;
+        const bool fits = previous.rows.size() - static_cast<size_t>(end - (owner + 1)) +
+                          rows.size() - 1 <= MAX_CACHED_BRANCH_ROWS;
+        const auto where = previous.rows.erase(owner + 1, end);
+        if (fits) {
+          for (auto i = rows.begin() + 1; i != rows.end(); ++i) i->depth += depth;
+          previous.rows.insert(where, std::make_move_iterator(rows.begin() + 1), std::make_move_iterator(rows.end()));
+        }
+      }
+      rows = std::move(previous.rows);
+      zoomId = std::move(previous.zoomId);
+      page = previous.page;
+    }
+    wrapAnchor = -1;
+    layoutDirty = true;
+    timedSectionDirty = true;
+    message = nullptr;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::showBreadcrumbMenu() {
+  if (viewStack.size() < 3) return;
+  std::vector<std::string> ancestors;
+  ancestors.reserve(viewStack.size() - 2);
+  const int width = std::max(1, layout().width - 56);
+  for (size_t depth = 1; depth + 1 < viewStack.size(); ++depth) {
+    const auto& view = viewStack[depth];
+    const char* label = view.rows.empty() ? tr(STR_WORKFLOWY) : view.rows.front().title.c_str();
+    ancestors.push_back(renderer.truncatedText(UI_12_FONT_ID, label, width));
+  }
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                            renderer, mappedInput, "WorkflowyAncestors", StrId::STR_WORKFLOWY,
+                            std::move(ancestors), 0, false, true),
+                         [this](const ActivityResult& result) {
+    if (!result.isCancelled) {
+      const int index = std::get<OptionSelectionResult>(result.data).index;
+      if (index >= 0) returnToDepth(static_cast<size_t>(index) + 1);
+    }
+  });
+}
+
+void WorkflowyDailyActivity::drawBreadcrumbs(const Layout& bounds, int right) {
+  const auto depth = viewStack.size();
+  if (depth == 0) return;
+  const int total = std::max(0, right - bounds.x);
+  const char* day = date.empty() || date == "today" || date == isoDate(0) ? tr(STR_WORKFLOWY_TODAY) : date.c_str();
+  const int dayWidth = std::min(renderer.getTextWidth(SMALL_FONT_ID, day) + 19, total / 3);
+  const int moreWidth = depth > 2 ? std::min(38, total / 6) : 0;
+  const char* parentTitle = depth > 1 && !viewStack.back().rows.empty()
+                                ? viewStack.back().rows.front().title.c_str() : tr(STR_WORKFLOWY);
+  const int parentWidth = depth > 1 ? std::min(renderer.getTextWidth(SMALL_FONT_ID, parentTitle) + 19,
+                                             (total - dayWidth - moreWidth) / 2) : 0;
+  breadcrumbHits = {depth, bounds.x + dayWidth, bounds.x + dayWidth + moreWidth,
+                     bounds.x + dayWidth + moreWidth + parentWidth};
+  const int y = bounds.top + CONTENT_TOP + 5;
+  const auto draw = [&](int left, int end, const char* label, bool ancestor) {
+    const int labelWidth = end - left - (ancestor ? 15 : 0);
+    if (labelWidth <= 0) return;
+    const auto clean=std::string(workflowy::trimTaskText(label));
+    const auto fitted = renderer.truncatedText(SMALL_FONT_ID, clean.c_str(), labelWidth);
+    renderer.drawText(SMALL_FONT_ID, left, y, fitted.c_str());
+    if (ancestor) renderer.drawText(SMALL_FONT_ID, end - 12, y, "›");
+  };
+  draw(bounds.x, breadcrumbHits.dayEnd, day, true);
+  if (moreWidth) draw(breadcrumbHits.dayEnd, breadcrumbHits.moreEnd, "...", true);
+  if (parentWidth) {
+    const auto& parent = viewStack.back();
+    draw(breadcrumbHits.moreEnd, breadcrumbHits.parentEnd,
+         parent.rows.empty() ? tr(STR_WORKFLOWY) : parent.rows.front().title.c_str(), true);
+  }
+  draw(breadcrumbHits.parentEnd, right, rows.empty() ? tr(STR_WORKFLOWY) : rows.front().title.c_str(), false);
+}
+
+bool WorkflowyDailyActivity::tapBreadcrumb(int x, int y) {
+  if (selecting || viewStack.empty()) return false;
+  const auto bounds = layout();
+  if (y < bounds.top + CONTENT_TOP || y >= bounds.rowTop || x < bounds.x) return false;
+  BreadcrumbHits hit;
+  {
+    RenderLock lock(*this);
+    hit = breadcrumbHits;
+  }
+  if (hit.depth == 0 || viewStack.size() != hit.depth || x >= hit.parentEnd) return false;
+  if (x < hit.dayEnd) returnToDepth(0);
+  else if (x < hit.moreEnd) showBreadcrumbMenu();
+  else returnToDepth(hit.depth - 1);
+  return true;
+}
+
+bool WorkflowyDailyActivity::reorder(size_t source, size_t target, bool after, bool recordUndo) {
+  if (itemPending(rows[source].id) || itemPending(rows[target].id)) return false;
+  const int parent = parentRow(source);
+  if (source == target || parent != parentRow(target)) return false;
+  const auto parentNode = parent < 0 ? "" : rows[parent].id;
+  return reorderSiblings(parent < 0 ? date : parentNode, parentNode, rows[source].depth,
+                         rows[source].id, rows[target].id, after, recordUndo);
+}
+
+bool WorkflowyDailyActivity::reorderSiblings(const std::string& parentId, const std::string& parentNode, unsigned depth,
+                                             std::string sourceId, std::string targetId,
+                                             bool after, bool recordUndo) {
+  struct OrderResult {
+    std::vector<Node> siblings;
+    std::string neighbour;
+    bool wasFirst = false;
+    bool loaded = false;
+  };
+  auto orderResult = std::make_shared<OrderResult>();
+  const auto source = std::find_if(rows.begin(), rows.end(), [&](const Node& row) { return row.id == sourceId; });
+  const auto localOrigin = source == rows.end() ? MoveOrigin{} : moveOrigin(source - rows.begin());
+  const bool queued = queueSave({}, {}, false,
+                   [this, parentId, parentNode, depth, sourceId, orderResult, recordUndo, localOrigin](const Save& save) {
+    if (orderResult->loaded) {
+      RenderLock lock(*this);
+      if (!parentNode.empty() || (zoomId.empty() && parentId == date)) replaceSiblings(rows, parentNode, orderResult->siblings);
+      for (auto& view : viewStack) {
+        if (!parentNode.empty() || (view.zoomId.empty() && parentId == date))
+          replaceSiblings(view.rows, parentNode, orderResult->siblings);
+      }
+      layoutDirty = true;
+    }
+    if (save.status != 200) {
+      if (!orderResult->loaded && !localOrigin.neighbour.empty()) moveVisibleBoundary(sourceId, localOrigin, false, true);
+      return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    }
+    if (recordUndo) {
+      offerUndo([this, sourceId, parentId, parentNode, depth, neighbour = orderResult->neighbour,
+                 wasFirst = orderResult->wasFirst] {
+        return reorderSiblings(parentId, parentNode, depth, sourceId, neighbour, !wasFirst, false);
+      });
+    }
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, sourceId,
+     [parentId, depth, sourceId, targetId, after, orderResult](Save& save) {
+    std::vector<Node> siblings;
+    save.status = fetchChildren(save.key, parentId, depth, siblings, &save.cancel, &save.transport, &save.queuedAt);
+    if (save.status != 200) return;
+    std::vector<size_t> order;
+    size_t source = siblings.size(), target = siblings.size();
+    for (size_t i = 0; i < siblings.size(); ++i) {
+      if (siblings[i].id == sourceId) source = i;
+      else order.push_back(i);
+      if (siblings[i].id == targetId) target = i;
+    }
+    const auto position = std::find(order.begin(), order.end(), target);
+    if (source == siblings.size() || position == order.end() || siblings.size() < 2) {
+      save.status = -3;
+      return;
+    }
+    orderResult->wasFirst = source == 0;
+    orderResult->neighbour = siblings[source == 0 ? 1 : source - 1].id;
+    order.insert(position + (after ? 1 : 0), source);
+    const auto stationary = workflowy::stationaryRange(order);
+    const auto move = [&](size_t i, const char* placement) {
+      JsonDocument update;
+      update["parent_id"] = parentId;
+      update["position"] = placement;
+      save.status = requestForSave(save, "POST", "/" + siblings[order[i]].id + "/move", encode(update),
+                                   nullptr, nullptr, 0, nullptr, nullptr, &save.transport, &save.error);
+      return save.status == 200;
+    };
+    bool ok = true;
+    for (size_t i = stationary.begin; i > 0 && ok; --i) ok = move(i - 1, "top");
+    for (size_t i = stationary.end; i < order.size() && ok; ++i) ok = move(i, "bottom");
+    if (ok) {
+      for (const auto i : order) orderResult->siblings.push_back(std::move(siblings[i]));
+      orderResult->loaded = true;
+    } else {
+      orderResult->loaded = fetchChildren(save.key, parentId, depth, orderResult->siblings, &save.cancel,
+                                              &save.transport, &save.queuedAt) == 200;
+    }
+  });
+  if (queued && !localOrigin.parent.empty()) {
+    moveVisibleBoundary(sourceId, MoveOrigin{parentId, parentNode, targetId, depth, after}, false, true);
+  }
+  return queued;
+}
+
+void WorkflowyDailyActivity::offerUndo(std::function<bool()> action, bool forDelete) {
+  undoIsDelete = forDelete;
+  undoAction = std::move(action);
+  {
+    RenderLock lock(*this);
+    undoReady = true;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::undo() {
+  if (!undoAction) return;
+  if (!undoIsDelete && !online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  if (!undoAction()) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+  undoAction = {};
+  {
+    RenderLock lock(*this);
+    undoReady = false;
+  }
+  requestUpdate();
+}
+
+void WorkflowyDailyActivity::commitDelete() {
+  if (pendingDelete.empty() || !hasActiveStationWifiConnection()) return;
+  const auto id = pendingDelete;
+  if (!queueSave("/" + id, {}, false, [this, id](const Save& save) {
+        if (save.status >= 200 && save.status < 300) removeNode(id);
+        else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+      }, "DELETE", StrId::STR_DELETE, id)) return;
+  {
+    RenderLock lock(*this);
+    pendingDelete.clear();
+    if (undoIsDelete) undoReady = false;
+    layoutDirty = true;
+  }
+  if (undoIsDelete) undoAction = {};
+}
+
+bool WorkflowyDailyActivity::queueCapture(const std::string& body) {
+  JsonDocument queue, item;
+  if ((!outbox.empty() && deserializeJson(queue, outbox)) || deserializeJson(item, body)) return false;
+  const auto account = std::to_string(std::hash<std::string>{}(credential));
+  if (queue["items"].isNull()) queue["items"].to<JsonArray>();
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() && queue["account"].as<std::string>() != account) return false;
+  queue["account"] = account;
+  if (items.size() >= OUTBOX_ITEMS || !items.add(item.as<JsonVariantConst>())) return false;
+  auto saved = encode(queue);
+  if (saved.size() > OUTBOX_LIMIT || !workflowy::writeSetting(OUTBOX, saved)) return false;
+  outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    pendingCount = items.size();
+  }
+  requestUpdate();
+  return true;
+}
+
+void WorkflowyDailyActivity::flushCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential))) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  }
+  auto items = queue["items"].as<JsonArray>();
+  if (items.size() == 0) return;
+  std::string body;
+  serializeJson(items[0], body);
+  queue["sending"] = true;
+  auto marked = encode(queue);
+  if (!workflowy::writeSetting(OUTBOX, marked)) {
+    retryOutboxAt = millis() + 30000;
+    return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+  }
+  outbox = std::move(marked);
+  if (!queueSave("", std::move(body), false, [this](const Save& save) { finishCapture(save.status); },
+                 "POST", StrId::STR_WORKFLOWY_ADD)) {
+    finishCapture(-5);
+    return;
+  }
+  RenderLock lock(*this);
+  saves.back()->fromOutbox = true;
+}
+
+void WorkflowyDailyActivity::finishCapture(int status) {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  auto items = queue["items"].as<JsonArray>();
+  if (status >= 200 && status < 300) items.remove(0);
+  // An interrupted request may have created the item. Leave it queued for explicit review.
+  const bool uncertain = status == 0 || status >= 500;
+  queue["sending"] = uncertain;
+  auto saved = encode(queue);
+  const bool persisted = workflowy::writeSetting(OUTBOX, saved);
+  if (persisted) outbox = std::move(saved);
+  {
+    RenderLock lock(*this);
+    outboxUncertain = uncertain || !persisted;
+    if (persisted) pendingCount = items.size();
+  }
+  if (queueVisible) refreshOfflineQueuePreview();
+  retryOutboxAt = millis() + (status >= 200 && status < 300 ? 350 : 30000);
+  if (status >= 200 && status < 300) {
+    rootCheckedAt = millis() - SYNC_INTERVAL;
+    nextPrefetchAt = millis();
+    requestUpdate();
+  } else showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+}
+
+void WorkflowyDailyActivity::reviewCapture() {
+  JsonDocument queue;
+  if (deserializeJson(queue, outbox)) return;
+  if (queue["account"].as<std::string>() != std::to_string(std::hash<std::string>{}(credential)))
+    return showMessage(tr(STR_WORKFLOWY_OUTBOX_ACCOUNT));
+  const auto name = plainTitle(queue["items"][0]["name"] | "");
+  std::vector<std::string> options{tr(STR_WORKFLOWY_OUTBOX_SENT), tr(STR_WORKFLOWY_OUTBOX_RETRY)};
+  startActivityForResult(std::make_unique<OptionSelectionActivity>(
+                             renderer, mappedInput, "WorkflowyOutbox", StrId::STR_WORKFLOWY_SYNC_CHECK,
+                             std::move(options), 0, false, true),
+                         [this, name](const ActivityResult& result) {
+    if (result.isCancelled) return;
+    const bool sent = std::get<OptionSelectionResult>(result.data).index == 0;
+    startActivityForResult(std::make_unique<ConfirmationActivity>(
+                               renderer, mappedInput, (sent ? tr(STR_WORKFLOWY_OUTBOX_SENT) : tr(STR_WORKFLOWY_OUTBOX_RETRY)),
+                               name),
+                           [this, sent](const ActivityResult& confirmation) {
+      if (confirmation.isCancelled) return;
+      JsonDocument queue;
+      if (deserializeJson(queue, outbox)) return;
+      auto items = queue["items"].as<JsonArray>();
+      if (sent) items.remove(0);
+      queue["sending"] = false;
+      auto saved = encode(queue);
+      if (!workflowy::writeSetting(OUTBOX, saved)) return showMessage(tr(STR_WORKFLOWY_SAVE_FAILED));
+      outbox = std::move(saved);
+      {
+        RenderLock lock(*this);
+        outboxUncertain = false;
+        pendingCount = items.size();
+      }
+      retryOutboxAt = millis();
+      if (queueVisible) refreshOfflineQueuePreview();
+      requestUpdate();
+    });
+  });
+}
+
+WorkflowyDailyActivity::MoveOrigin WorkflowyDailyActivity::moveOrigin(size_t source) const {
+  const int parent = parentRow(source);
+  const std::string parentNode = parent < 0 ? "" : rows[parent].id;
+  const unsigned depth = rows[source].depth;
+  MoveOrigin origin{parent < 0 ? date : parentNode, parentNode, {}, depth, false};
+  for (size_t i = parent < 0 ? 0 : parent + 1; i < rows.size() && rows[i].depth >= depth; ++i) {
+    if (i == source || rows[i].depth != depth) continue;
+    if (i > source && !origin.neighbour.empty()) break;
+    origin.neighbour = rows[i].id;
+    origin.after = i < source;
+    if (i > source) break;
+  }
+  return origin;
+}
+
+void WorkflowyDailyActivity::moveToBoundary(size_t row, bool bottom) {
+  if (itemPending(rows[row].id) || rows[row].id == zoomId) return;
+  if (!online) return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  const auto id = rows[row].id;
+  const auto origin = moveOrigin(row);
+  JsonDocument update;
+  update["parent_id"] = origin.parent;
+  update["position"] = bottom ? "bottom" : "top";
+  if (queueSave("/" + id + "/move", encode(update), false, [this, id, origin, bottom](const Save& save) {
+        if (save.status < 200 || save.status >= 300) {
+          moveVisibleBoundary(id, origin, bottom, true);
+          return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+        }
+        offerUndo([this, id, origin] { return restoreMove(id, origin); });
+      }, "POST", bottom ? StrId::STR_WORKFLOWY_MOVE_BOTTOM : StrId::STR_WORKFLOWY_MOVE_TOP, id)) {
+    moveVisibleBoundary(id, origin, bottom, false);
+  }
+}
+
+void WorkflowyDailyActivity::moveVisibleBoundary(const std::string& id, const MoveOrigin& origin, bool bottom, bool restore) {
+  {
+    RenderLock lock(*this);
+    const auto rotateBranch = [&](std::vector<Node>& outline) {
+      const auto item = std::find_if(outline.begin(), outline.end(), [&](const Node& node) { return node.id == id; });
+      if (item == outline.end()) return;
+      const auto depth = item->depth;
+      if (depth == 0 && !outline.empty() && outline.front().id == id && id == zoomId) return;
+      auto end = item + 1;
+      while (end != outline.end() && end->depth > depth) ++end;
+      auto destination = item;
+      if (restore) {
+        destination = std::find_if(outline.begin(), outline.end(), [&](const Node& node) {
+          return node.id == origin.neighbour && node.depth == depth;
+        });
+        if (destination == outline.end()) return;
+        if (origin.after) {
+          ++destination;
+          while (destination != outline.end() && destination->depth > depth) ++destination;
+        }
+      } else if (bottom) {
+        destination = end;
+        while (destination != outline.end() && destination->depth >= depth) ++destination;
+      } else {
+        while (destination != outline.begin() && std::prev(destination)->depth >= depth) --destination;
+      }
+      if (destination < item) std::rotate(destination, item, end);
+      if (destination > end) std::rotate(item, end, destination);
+    };
+    if (id != zoomId) rotateBranch(rows);
+    for (auto& view : viewStack) if (id != view.zoomId) rotateBranch(view.rows);
+    layoutDirty = true;
+  }
+  requestUpdate();
+}
+
+bool WorkflowyDailyActivity::restoreMove(const std::string& id, const MoveOrigin& origin) {
+  if (itemPending(id)) return false;
+  JsonDocument update;
+  update["parent_id"] = origin.parent;
+  update["position"] = "bottom";
+  return queueSave("/" + id + "/move", encode(update), false, [this, id, origin](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    if (!origin.neighbour.empty() &&
+        reorderSiblings(origin.parent, origin.parentNode, origin.depth, id, origin.neighbour, origin.after, false)) return;
+    loadDay();
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::indent(size_t source, size_t target) {
+  if (itemPending(rows[source].id) || itemPending(rows[target].id)) return;
+  const auto id = rows[source].id;
+  const auto destination = rows[target].id;
+  const auto original = moveOrigin(source);
+  JsonDocument update;
+  update["parent_id"] = destination;
+  update["position"] = "top";
+  queueSave("/" + id + "/move", encode(update), false, [this, id, destination, original](const Save& save) {
+    if (save.status < 200 || save.status >= 300) return showMessage(tr(STR_WORKFLOWY_SEND_FAILED));
+    removeNode(id);
+    {
+      RenderLock lock(*this);
+      for (auto& node : rows) {
+        if (node.id != destination) continue;
+        node.leaf = false;
+        node.childrenConfirmed = true;
+      }
+    }
+    offerUndo([this, id, original] { return restoreMove(id, original); });
+  }, "POST", StrId::STR_WORKFLOWY_MOVE, id);
+}
+
+void WorkflowyDailyActivity::prefetchTask(void* argument) {
+  {
+    std::unique_ptr<std::shared_ptr<Prefetch>> holder(static_cast<std::shared_ptr<Prefetch>*>(argument));
+    auto& job = **holder;
+    job.status = fetchChildren(job.key, job.target, job.depth, job.children, &job.cancel, &job.transport, nullptr, &job.error);
+    job.ready.store(true, std::memory_order_release);
+  }
+  vTaskDelete(nullptr);
+}
+
+void WorkflowyDailyActivity::pollPrefetch() {
+  if (timeChoices && timeChoices->started && !timeChoices->ready.load(std::memory_order_acquire)) return;
+  if (calendarFetch) {
+    calendarFetch->cancel.store(true, std::memory_order_relaxed);
+    if (!calendarFetch->ready.load(std::memory_order_acquire)) return;
+    calendarFetch.reset();
+  }
+  const auto now = millis();
+  if (prefetch) {
+    if (!prefetch->ready.load(std::memory_order_acquire)) return;
+    auto job = std::move(prefetch);
+    if (job->generation != generation || job->cancel.load(std::memory_order_relaxed)) return;
+    recordServerError(job->status,job->transport,job->error,job->key);
+    bool changed = false;
+    int zoomRow = -1;
+    {
+      RenderLock lock(*this);
+      if (job->root) {
+        rootCheckedAt = now;
+        if (job->status == 200) forceNetworkRefresh = false;
+        if (awaitingOutline) {
+          awaitingOutline = false;
+          lastStatus = job->status;
+          lastTransport = job->transport;
+
+          changed = true;
+          message = job->status == 200 ? nullptr
+                    : job->status == -2 ? tr(STR_WORKFLOWY_CLOCK_FAILED)
+                    : job->status == -3 ? tr(STR_WORKFLOWY_DAILY_READ_FAILED)
+                    : job->status == 401 || job->status == 403 ? tr(STR_WORKFLOWY_AUTH_FAILED)
+                                                               : tr(STR_WORKFLOWY_NETWORK_FAILED);
+        }
+      }
+      if (!requestedBranch.empty() && requestedBranch == job->parent) {
+        const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == job->parent; });
+        requestedBranch.clear();
+        lastStatus = job->status;
+        lastTransport = job->transport;
+
+        changed = true;
+        if (job->status != 200) {
+          message = tr(STR_WORKFLOWY_DAILY_READ_FAILED);
+        } else if (owner != rows.end()) {
+          const auto index = static_cast<size_t>(owner - rows.begin());
+          auto end = owner + 1;
+          while (end != rows.end() && end->depth > owner->depth) ++end;
+          if (rows.size() - static_cast<size_t>(end - (owner + 1)) + job->children.size() > MAX_ROWS) {
+            message = tr(STR_WORKFLOWY_DAILY_READ_FAILED);
+          } else {
+            replaceSiblings(rows, job->parent, job->children);
+            zoomRow = static_cast<int>(index);
+            message = nullptr;
+            layoutDirty = true;
+          }
+        }
+      } else if (job->status == 200) {
+        changed |= replaceSiblings(rows, job->parent, job->children);
+        layoutDirty |= changed;
+      }
+    }
+    if (!calendarFocus.empty() && job->root && job->status == 200) {
+      const auto item = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == calendarFocus; });
+      calendarFocus.clear();
+      if (item != rows.end()) {
+        if (calendarFocusZoom) zoomRow = item - rows.begin();
+        else { wrapAnchor = item - rows.begin(); layoutDirty = true; changed = true; }
+      }
+      calendarFocusZoom = true;
+    }
+    if (zoomRow >= 0) return zoom(zoomRow);
+    if (changed) { timedSectionDirty = true; requestUpdate(); }
+    return;
+  }
+  const bool interactive = !requestedBranch.empty();
+  if (interactive && !online) {
+    {
+      RenderLock lock(*this);
+      requestedBranch.clear();
+    }
+    return showMessage(tr(STR_WORKFLOWY_NETWORK_FAILED));
+  }
+  if ((!interactive && static_cast<long>(now - nextPrefetchAt) < 0) || credential.empty() || date.empty() || !online)
+    return;
+  std::string parent;
+  unsigned depth = 0;
+  const bool root = !interactive && now - rootCheckedAt >= SYNC_INTERVAL;
+  {
+    RenderLock lock(*this);
+    if (interactive) {
+      const auto owner = std::find_if(rows.begin(), rows.end(), [&](const Node& node) { return node.id == requestedBranch; });
+      if (owner == rows.end()) {
+        requestedBranch.clear();
+        return;
+      }
+      parent = owner->id;
+      depth = owner->depth + 1;
+    } else if (root) {
+      parent = zoomId;
+      depth = zoomId.empty() ? 0 : 1;
+    } else {
+      return;
+    }
+  }
+  if (!forceNetworkRefresh && (interactive || awaitingOutline)) {
+    std::vector<Node> cached; uint32_t at=0;
+    if (cachedChildren(parent.empty() ? date : parent, depth, cached, at)) {
+      int focus=-1;
+      {
+        RenderLock lock(*this);
+        replaceSiblings(rows,parent,cached);
+        if (interactive) {
+          const auto owner=std::find_if(rows.begin(),rows.end(),[&](const Node& node){return node.id==parent;});
+          if (owner!=rows.end()) focus=owner-rows.begin();
+          requestedBranch.clear();
+        }
+        awaitingOutline=false;rootCheckedAt=at;layoutDirty=true;timedSectionDirty=true;message=nullptr;
+      }
+      if (focus>=0) zoom(focus);
+      else requestUpdate();
+      return;
+    }
+  }
+  auto job = makeUniqueNoThrow<Prefetch>();
+  nextPrefetchAt = now + 5000;
+  const auto failStart = [&] {
+    if (!interactive) return;
+    {
+      RenderLock lock(*this);
+      requestedBranch.clear();
+      lastStatus = 0;
+      lastTransport = ESP_ERR_NO_MEM;
+      lastServerError.clear();
+    }
+    showMessage(tr(STR_WORKFLOWY_DAILY_READ_FAILED));
+  };
+  if (!job) return failStart();
+  job->key = credential;
+  job->target = parent.empty() ? date : parent;
+  job->parent = std::move(parent);
+  job->generation = generation;
+  job->depth = depth;
+  job->root = root;
+  prefetch = std::move(job);
+  auto holder = makeUniqueNoThrow<std::shared_ptr<Prefetch>>(prefetch);
+  if (!holder) {
+    prefetch.reset();
+    return failStart();
+  }
+  // The task owns the argument and touches no activity or renderer state.
+  auto* argument = holder.release();
+  if (xTaskCreate(prefetchTask, "wf-prefetch", 8192, argument, tskIDLE_PRIORITY + 1, nullptr) != pdPASS) {
+    delete argument;
+    prefetch.reset();
+    return failStart();
+  }
+  nextPrefetchAt = now + 250;
+}
+
+void WorkflowyDailyActivity::loop() {
+  // Service requests before handling gestures, including back-to-back page turns.
+  serviceBackgroundWork();
+  if (idleTimeoutExpired()) {
+    // Finish already accepted writes, including any delete whose undo window
+    // expired, before closing the full Workflowy screen from any zoom level.
+    if (saves.empty()) commitDelete();
+    if (saves.empty()) return finish();
+    pollSave();
+    return;
+  }
+  using Button = MappedInputManager::Button;
+  using Swipe = MappedInputManager::SwipeDir;
+  if (mappedInput.wasReleased(Button::Back)) {
+    if (queueVisible) return showPendingOperations();
+    if (calendarVisible) {
+      if (calendarReturnHome) return finish();
+      {
+        RenderLock lock(*this);
+        calendarVisible = false;
+        calendarDrag = {};
+      }
+      if (calendarFetch) calendarFetch->cancel.store(true, std::memory_order_relaxed);
+      return requestUpdate();
+    }
+    if (selecting) return cancelSelection();
+    return back();
+  }
+  int tapX = 0, tapY = 0;
+  const bool sdkTap = mappedInput.wasScreenTapped(tapX, tapY);
+  const auto now = millis();
+  if (queueVisible) {
+    const auto bounds = layout();
+    const auto swipe = mappedInput.wasSwipe();
+    const bool queueTap = sdkTap && swipe == Swipe::None;
+    const size_t visible=std::max(1,(bounds.rowBottom-bounds.rowTop)/ROW_HEIGHT);
+    if(queueTap && tapY>=bounds.rowTop && tapY<bounds.rowBottom){
+      const size_t index=queuePage*visible+(tapY-bounds.rowTop)/ROW_HEIGHT;
+      if(index<operationErrors.size())return showOperationError(index);
+    }
+    const int uncertainY = bounds.rowTop + (!requestedBranch.empty() ? ROW_HEIGHT : 0);
+    if (queueTap && outboxUncertain && queuePage == 0 && tapY >= uncertainY && tapY < uncertainY + ROW_HEIGHT &&
+        saves.empty()) {
+      return reviewCapture();
+    }
+    if (queueTap && tapY >= bounds.rowTop && tapY < bounds.rowBottom && isErrorNotice(message)) return showErrorDetails();
+    if (queueTap && (tapY < bounds.rowTop || tapY >= bounds.footer)) return showPendingOperations();
+    if (swipe == Swipe::Up || swipe == Swipe::Down) {
+      RenderLock lock(*this);
+      const size_t visible = std::max(1, (bounds.rowBottom - bounds.rowTop) / ROW_HEIGHT);
+      if (swipe == Swipe::Down && queuePage) --queuePage;
+      else if (swipe == Swipe::Up && (queuePage + 1) * visible < pendingOperationsCount()+operationErrors.size()) ++queuePage;
+    }
+    if (step == Step::Ready) pollWifiConnection();
+    if (step == Step::Load) loadDay();
+    if (!pollSave() && swipe != Swipe::None) requestUpdate();
+    if (calendarVisible) pollCalendar();
+    else if (saves.empty() && (!requestedBranch.empty() || awaitingOutline)) pollPrefetch();
+    else if (saves.empty() && pendingCount && !outboxUncertain && hasActiveStationWifiConnection() &&
+             static_cast<long>(now - retryOutboxAt) >= 0) flushCapture();
+    return;
+  }
+  if (calendarVisible) {
+    if (step == Step::Start) connect();
+    else if (step == Step::Ready) pollWifiConnection();
+    if (step == Step::Load) {
+      step = Step::Ready;
+      awaitingOutline = false;
+      reloadCalendar();
+    }
+    calendarLoop(sdkTap, tapX, tapY);
+    return;
+  }
+  const bool tapped = sdkTap && (tracking || gestureEndedAt == 0 || now - gestureEndedAt >= 120);
+  // The calendar is local. Open it before processing Wi-Fi or outline work.
+  if (tapped && !selecting && step != Step::Waiting && !dragging && !(tracking && moved)) {
+    const auto bounds = layout();
+    const int right = bounds.x + bounds.width;
+    if (tapY >= bounds.top + 28 && tapY < bounds.top + 63 && tapX >= bounds.x && tapX < right) {
+      const int dayRight = right - COUNT_TARGET;
+      if (tapX < dayRight) {
+        tracking = false;
+        if (tapX < bounds.x + DAY_TARGET) return shiftDay(-1);
+        if (tapX >= dayRight - DAY_TARGET) return shiftDay(1);
+        return chooseDate();
+      }
+      { RenderLock lock(*this); completedOnly = !completedOnly; page = 0; wrapAnchor = -1; layoutDirty = true; }
+      return requestUpdate();
+    }
+  }
+  if (step == Step::Start) return connect();
+  if (step == Step::Load) return loadDay();
+  if (step != Step::Ready) return;
+  pollWifiConnection();
+  if (step != Step::Ready) return;
+  int touchDownX, touchDownY;
+  const bool stillTouching = sdkTap || tracking || mappedInput.wasScreenTouchReleased() ||
+                             mappedInput.wasScreenTouchDown(touchDownX, touchDownY);
+  if (!stillTouching && pollSave()) return;
+  if (!stillTouching && timedSectionDirty) sortTimedItems(true);
+  if (static_cast<long>(now - nextLinkCheck) >= 0) {
+    nextLinkCheck = now + 500;
+    const bool connected = hasActiveStationWifiConnection();
+    if (connected != online) {
+      {
+        RenderLock lock(*this);
+        online = connected;
+      }
+      if (connected && !awaitingOutline) loadDay();
+      else requestUpdate();
+    }
+  }
+  if (isErrorNotice(message) && mappedInput.wasReleased(Button::Confirm)) return showErrorDetails();
+  if (mappedInput.wasReleased(Button::Up)) return nextPage(-1);
+  if (mappedInput.wasReleased(Button::Down)) return nextPage(1);
+  int x = 0, y = 0;
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    tracking = true;
+    dragRow = -1;
+    moved = false;
+    peakY = 0;
+    touchX = lastX = x;
+    touchY = lastY = y;
+    touchAt = millis();
+  }
+  if (tracking && mappedInput.isScreenTouchHeld(x, y)) {
+    lastX = x;
+    lastY = y;
+    const int dx = std::abs(x - touchX), dy = std::abs(y - touchY);
+    if (dy > std::abs(peakY)) peakY = y - touchY;
+    if (!selecting && !moved && dragRow < 0 && millis() - touchAt >= 550) {
+      const int row = rowAt(touchX, touchY);
+      if (row >= 0 && !itemPending(rows[row].id)) dragRow = row;
+    }
+    moved |= std::max(dx, dy) > 26;
+    if (online && dragRow >= 0 && (dragging || dy > 26)) {
+      dragging = true;
+      const int over = rowAt(x, y, true);
+      const int nextDrop = over >= 0 && over != dragRow && !itemPending(rows[over].id) &&
+                           parentRow(over) == parentRow(dragRow) ? over : -1;
+      const bool inside = nextDrop >= 0 && x - touchX >= 32 && rows[nextDrop].depth < 8;
+      bool changed;
+      {
+        RenderLock lock(*this);
+        changed = dropRow != nextDrop || dropInside != inside;
+        dropInside = inside;
+        dropRow = nextDrop;
+        dropAfter = nextDrop > dragRow;
+      }
+      if (changed) requestUpdate(true);
+      return;
+    }
+  }
+  Swipe swipe = Swipe::None;
+  int swipeX = 0, swipeY = 0, endX = 0, endY = 0;
+  const bool sdkSwipe = mappedInput.wasSwipeWithPoints(swipe, swipeX, swipeY, endX, endY);
+  const bool release = mappedInput.wasScreenTouchReleased();
+  if (dragging) {
+    if (!release && !sdkSwipe) return;
+    tracking = false;
+    dragging = false;
+    gestureEndedAt = now;
+    int target;
+    bool after, inside;
+    {
+      RenderLock lock(*this);
+      target = dropRow;
+      after = dropAfter;
+      inside = dropInside;
+      dropRow = -1;
+    }
+    requestUpdate();
+    if (target >= 0) {
+      if (inside) indent(dragRow, target);
+      else reorder(dragRow, target, after);
+    }
+    return;
+  }
+  if (swipe == Swipe::None && release && tracking) {
+    const int dx = lastX - touchX;
+    if (std::abs(peakY) >= 28 && std::abs(peakY) >= std::abs(dx))
+      swipe = peakY < 0 ? Swipe::Up : Swipe::Down;
+    else if (std::abs(dx) >= 60)
+      swipe = dx < 0 ? Swipe::Left : Swipe::Right;
+  }
+  if (swipe != Swipe::None) {
+    const int row = sdkSwipe ? rowAt(swipeX, swipeY) : rowAt(touchX, touchY);
+    tracking = false;
+    gestureEndedAt = now;
+    if (swipe == Swipe::Up || swipe == Swipe::Down) return nextPage(swipe == Swipe::Up ? 1 : -1);
+    if (!selecting && row >= 0 && !itemPending(rows[row].id)) {
+      if (swipe == Swipe::Right) toggle(row);
+      else actions(row);
+    }
+    return;
+  }
+  if (tapped && (pendingOperationsCount() || isErrorNotice(message) || !operationErrors.empty() || !online || connectingWifi)) {
+    const auto area = statusArea();
+    if (tapX >= area.x && tapX < area.x + area.width && tapY >= area.y && tapY < area.y + area.height) {
+      tracking = false;
+      if (!operationErrors.empty()) return showPendingOperations();
+      if (isErrorNotice(message)) return showErrorDetails();
+      if (!online || connectingWifi) return showWifiPicker();
+      return showPendingOperations();
+    }
+  }
+  if (tapped) {
+    const int statusTop = layout().top + UITheme::getTopStatusBarInset(renderer);
+    const bool lamp = GUI.isFrontlightIndicatorTap(renderer, statusTop, tapX, tapY);
+    const bool hand = GUI.isTouchscreenIndicatorHit(renderer, statusTop, tapX, tapY);
+    if (lamp || hand) {
+      tracking = false;
+      if (lamp) {
+        const bool lightOn = !Frontlight.isOn();
+        Frontlight.setOn(lightOn);
+        SETTINGS.frontlightOn = lightOn ? 1 : 0;
+      } else {
+        SETTINGS.disableReaderTouchscreen = SETTINGS.disableReaderTouchscreen ? 0 : 1;
+      }
+      activityManager.persistGlobalSettings();
+      requestUpdate();
+      return;
+    }
+    if (GUI.isReadestIndicatorTap(renderer, statusTop, tapX, tapY)) {
+      tracking = false;
+      startActivityForResult(std::make_unique<ReadestSettingsActivity>(renderer, mappedInput), {});
+      return;
+    }
+    if (GUI.isHighlightIndicatorTap(renderer, statusTop, tapX, tapY)) {
+      tracking = false;
+      startActivityForResult(std::make_unique<SavedItemsHomeActivity>(renderer, mappedInput), {});
+      return;
+    }
+  }
+  if (tapped && tapBreadcrumb(tapX, tapY)) {
+    tracking = false;
+    return;
+  }
+  if (!selecting && tapped && tapArrow(tapX, tapY)) {
+    tracking = false;
+    return;
+  }
+  const bool held = release && tracking && !moved && now - touchAt >= 550;
+  if (!tapped && !held) {
+    if (release) tracking = false;
+    if (!tracking && !release && saves.empty() && !connectingWifi) {
+      if (!requestedBranch.empty()) pollPrefetch();
+      else if (online && !pendingDelete.empty() && static_cast<long>(millis() - deleteAt) >= 0) commitDelete();
+      else if (online && pendingCount && !outboxUncertain && !prefetch &&
+               static_cast<long>(millis() - retryOutboxAt) >= 0) flushCapture();
+      else if (now - touchAt >= 180) pollPrefetch();
+    }
+    return;
+  }
+  const bool dragged = tracking && moved;
+  tracking = false;
+  x = held ? touchX : tapX;
+  y = held ? touchY : tapY;
+  const auto bounds = layout();
+  if (selecting && y >= bounds.top + 28 && y < bounds.top + 64 && !held) {
+    const int right = bounds.x + bounds.width;
+    if (x < bounds.x + ICON_TARGET) return cancelSelection();
+    if (x >= right - ICON_TARGET) return showBulkMenu();
+    if (x >= right - ICON_TARGET - 104) return selectAll();
+    return;
+  }
+  if (y >= bounds.rowBottom && y < bounds.footer) {
+    const int zone = (x - bounds.x) * 8 / bounds.width;
+    if (pageStarts.size() <= 1) return;
+    if (zone >= 0 && zone < 2) return nextPage(-1, zone == 0);
+    if (zone >= 6 && zone < 8) return nextPage(1, zone == 7);
+  }
+  if (y >= bounds.footer) {
+    if (selecting) {
+      if (x < bounds.x + bounds.width / 5) cancelSelection();
+      return;
+    }
+    const workflowy::ActionBar actions{FOOTER_CONTROLS, viewStack.empty() ? 1 : 0};
+    const auto control = static_cast<TodoControl>(actions.controlAt(x, bounds.x, bounds.width));
+    if (control == TodoControl::Back) return back();
+    if (control == TodoControl::Calendar) { calendarReturnHome = false; return openCalendar(false); }
+    if (control == TodoControl::Refresh) return refresh(held);
+    if (control == TodoControl::Sort) return sortTimedItems();
+    if (control == TodoControl::Replies) return toggleReplyFilter();
+    if (control == TodoControl::MoveUnfinished) return moveUnfinishedForward();
+    if (control == TodoControl::Add) {
+      if (!credential.empty() && !date.empty()) edit(rows.size());
+      return;
+    }
+    if (control == TodoControl::Undo) {
+      if (undoReady) undo();
+      return;
+    }
+    {
+      RenderLock lock(*this);
+      if (control == TodoControl::ShowDone) showDone = !showDone;
+      else wrapItems = !wrapItems;
+      message = nullptr;
+      layoutDirty = true;
+      if (page < pageStarts.size() && pageStarts[page] < placements.size())
+        wrapAnchor = static_cast<int>(placements[pageStarts[page]].row);
+    }
+    requestUpdate();
+    return;
+  }
+  const int row = rowAt(x, y);
+  if (row < 0 || itemPending(rows[row].id)) return;
+  if (selecting) {
+    if (tapped && !held) toggleSelection(row);
+    return;
+  }
+  if (dragged) return;
+  const int indent = std::min<unsigned>(rows[row].depth, 8) * 16;
+  if (held) return actions(row);
+  if (rows[row].divider) return;
+  size_t cursor = std::string::npos;
+  bool checkboxHit = false;
+  {
+    RenderLock lock(*this);
+    const auto end = page + 1 < pageStarts.size() ? pageStarts[page + 1] : placements.size();
+    for (auto i = pageStarts[page]; i < end; ++i) {
+      const auto& placement = placements[i];
+      if (placement.row != static_cast<size_t>(row) || y < placement.top || y >= placement.bottom) continue;
+      const bool firstFragment = i == 0 || placements[i - 1].row != placement.row;
+      checkboxHit = firstFragment && (rows[row].todo || rows[row].done) && x < bounds.x + indent + 30;
+      if (!checkboxHit) {
+        const auto line = std::min(placement.lineCount - 1,
+                                  static_cast<size_t>(std::max(0, y - placement.top - 6) / bounds.lineHeight));
+        const auto span = outlineLines[placement.firstLine + line];
+        const int font = wrapItems ? (span.metadata ? SMALL_FONT_ID : UI_12_FONT_ID) : UI_10_FONT_ID;
+        const int prefix = !firstFragment && line == 0
+                               ? renderer.getTextWidth(font, CONTINUATION) + CONTINUATION_GAP : 0;
+        if (wrapItems) {
+          const workflowy::TaskTextProjection projection(rows[row].title);
+          const auto text = projection.text(span.metadata);
+          cursor = projection.originalOffset(span.metadata,
+                      cursorAt(text, span, x - bounds.x - indent - 25 - prefix, font));
+        } else {
+          const workflowy::TaskTextProjection projection(rows[row].title, false);
+          const auto body = projection.text(false);
+          const auto compact = workflowy::compactTaskText(body);
+          cursor = projection.originalOffset(false, workflowy::compactTaskOriginalOffset(body,
+                    cursorAt(compact, span, x - bounds.x - indent - 25 - prefix, font)));
+        }
+      }
+      break;
+    }
+  }
+  if (checkboxHit) return toggle(row);
+  edit(row, 0, cursor);
+}
+
+const char* WorkflowyDailyActivity::statusNotice() const {
+  if (isErrorNotice(message)) return message;
+  if (connectingWifi) return tr(STR_CONNECTING);
+  if ((awaitingOutline || (calendarVisible && calendarFetch)) && online) return tr(STR_LOADING_POPUP);
+  if (message) return message;
+  if (!operationErrors.empty()) return tr(STR_WORKFLOWY_SEND_FAILED);
+  if (!online) return tr(STR_WORKFLOWY_OFFLINE);
+  return nullptr;
+}
+
+Rect WorkflowyDailyActivity::statusArea() const {
+  const auto bounds = layout();
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  StatusIconRow::Layout icons;
+  std::copy_n(SETTINGS.statusIconOrder, StatusIconRow::Count, icons.order);
+  StatusIconRow::sanitizeOrder(icons.order);
+  icons.enabledMask = static_cast<uint8_t>(~SETTINGS.statusIconHidden) & StatusIconRow::kAllMask;
+  icons.availableMask = Frontlight.present() ? 1u << StatusIconRow::Lamp : 0;
+  if (mappedInput.hasTouchHardware()) {
+    icons.availableMask |= 1u << StatusIconRow::Touch;
+    if (!SETTINGS.disableReaderTouchscreen)
+      icons.availableMask |= (1u << StatusIconRow::Readest) | (1u << StatusIconRow::Highlighter);
+  }
+  icons.leftX = left + metrics.statusBarHorizontalMargin;
+  const int leftEdge = std::max(left, StatusBarMetrics::sideInset);
+  const int rightEdge = renderer.getScreenWidth() - std::max(right, StatusBarMetrics::sideInset);
+  int iconsRight = icons.leftX;
+  for (unsigned slot = 0; slot < StatusIconRow::Count; ++slot)
+    if (icons.visible(slot)) iconsRight = std::max(iconsRight, icons.x(slot) + StatusIconRow::kIconSize);
+  auto config = SETTINGS.displayStatusBar.asReaderConfig();
+  if (halClock.isAvailable()) placeClockAtRight(config);
+  std::array<int, ReaderStatusBarConfig::SLOT_COUNT> widths{};
+  for (unsigned i = 0; i < widths.size(); ++i) {
+    if (i == ReaderStatusBarConfig::CENTER) continue;
+    char text[64]{};
+    switch (config.slots[i]) {
+      case ReaderStatusBarItem::Clock:
+        if (WiFi.getMode() != WIFI_OFF) widths[i] += StatusBarGeometry::WifiSpace;
+        if (halClock.isAvailable()) halClock.formatTime(text, sizeof(text), SETTINGS.clockUtcOffsetQ, SETTINGS.clockFormat == 1);
+        break;
+      case ReaderStatusBarItem::Date:
+        formatHeaderDateText(text, sizeof(text));
+        break;
+      case ReaderStatusBarItem::Battery:
+        widths[i] = metrics.batteryWidth;
+        if (SETTINGS.hideBatteryPercentage != CrossPointSettings::HIDE_ALWAYS)
+          snprintf(text, sizeof(text), "%u%%", static_cast<unsigned>(powerManager.getBatteryPercentage()));
+        if (*text) widths[i] += 4;
+        break;
+      default: break;
+    }
+    widths[i] += renderer.getTextWidth(SMALL_FONT_ID, text);
+  }
+  const int reserve = std::max(0, iconsRight - leftEdge) + 4;
+  fitReaderStatusBarSideWidths(widths, rightEdge - leftEdge, reserve, 8);
+  const auto space = layoutReaderStatusBarItems(leftEdge, rightEdge, widths, reserve, 8);
+  const int safeLeft = std::max(space.centerLeft, iconsRight + 8);
+  const int safeRight = space.centerRight - 4;
+  return Rect{safeLeft, UITheme::getTopStatusBarY(renderer),
+              std::max(0, safeRight - safeLeft), metrics.statusBarVerticalMargin};
+}
+
+void WorkflowyDailyActivity::drawStatus(const Layout&, const size_t pending, const char* notice) {
+  AppNavigation::draw(renderer, appNavigationView());
+  const bool error = isErrorNotice(message) || (!pending && !operationErrors.empty());
+  if (!pending && !notice) return;
+  char count[52];
+  const char* label = notice;
+  if (pending) {
+    if (pending > 1 || calendarVisible) {
+      snprintf(count, sizeof(count), pending == 1 ? tr(STR_WORKFLOWY_ACTION_PENDING)
+                                                : tr(STR_WORKFLOWY_ACTIONS_PENDING),
+               static_cast<unsigned>(pending));
+      label = count;
+    } else {
+      const auto action = !saves.empty() ? saves.front()->label
+                        : !requestedBranch.empty() ? StrId::STR_WORKFLOWY_ZOOM
+                        : awaitingOutline ? StrId::STR_LOADING_POPUP
+                        : outboxUncertain ? StrId::STR_WORKFLOWY_SYNC_CHECK : StrId::STR_WORKFLOWY_ADD;
+      label = I18n::getInstance().get(action);
+    }
+  }
+  if (!label) return;
+  const auto area = statusArea();
+  if (area.width < 16) return;
+  const bool clickable = pending || error || connectingWifi || !online;
+  const int arrow = clickable ? 10 : 0;
+  const int textLimit = area.width - 2 * (arrow + 4);
+  if (textLimit <= 0) return;
+  const auto fitted = renderer.truncatedText(SMALL_FONT_ID, label, textLimit);
+  const int textWidth = renderer.getTextWidth(SMALL_FONT_ID, fitted.c_str());
+  // Center on the screen, not the asymmetric gap left by the status icons
+  // and clock. Only move away from that center when the label would collide.
+  const int inset = arrow + 4;
+  const int x = std::clamp((renderer.getScreenWidth() - textWidth) / 2,
+                           area.x + inset, area.x + area.width - inset - textWidth);
+  const int y = area.y + ReaderStatusBarConfig::TOP_TEXT_INSET;
+  renderer.fillRect(area.x, area.y, area.width, area.height, false);
+  renderer.beginTextClip(area.x, area.y, area.width, area.height);
+  renderer.drawText(SMALL_FONT_ID, x, y, fitted.c_str());
+  renderer.endTextClip();
+  if (clickable) {
+    const int tip = area.x + area.width - 5, mid = area.y + area.height / 2;
+    renderer.drawLine(tip - 4, mid - 4, tip, mid);
+    renderer.drawLine(tip, mid, tip - 4, mid + 4);
+  }
+}
