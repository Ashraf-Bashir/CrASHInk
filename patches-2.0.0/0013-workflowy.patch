+  const auto time = parseTimeRange(body);
+  if (!time || offset <= time->begin) return offset;
+  const auto compact = compactScheduleRange(time->start, time->end);
+  if (offset >= time->begin + compact.size())
+    return offset - compact.size() + compactTaskBodyStart(body, time->finish) - time->begin;
+  // A tap within abbreviated time opens the corresponding original clock field.
+  return time->begin;
+}
+
+// Minimum prefix of the scheduled group that needs moving to the top.
+// Non-group siblings retain their relative order and never need remote writes.
+inline size_t timedPrefixMoves(const std::vector<int>& original, size_t groupSize) {
+  for (size_t cut=0;cut<=groupSize;++cut) {
+    size_t next=cut;
+    for (int rank:original) {
+      if (next==groupSize) break;
+      if (rank>=0 && static_cast<size_t>(rank)<cut) continue;
+      if (rank<0 || static_cast<size_t>(rank)!=next) break;
+      ++next;
+    }
+    if (next==groupSize) return cut;
+  }
+  return groupSize;
+}
+
+// With only top/bottom moves, the longest already ordered contiguous section
+// of the target order can stay put. Move the remaining ends around it.
+inline TextSpan stationaryRange(const std::vector<size_t>& desired) {
+  TextSpan best{0, 0};
+  size_t begin = 0;
+  for (size_t i = 0; i < desired.size(); ++i) {
+    if (i && desired[i] < desired[i - 1]) begin = i;
+    if (i + 1 - begin > best.end - best.begin) best = {begin, i + 1};
+  }
+  return best;
+}
+
+}  // namespace workflowy
diff --git a/src/workflowy/WorkflowyRichText.h b/src/workflowy/WorkflowyRichText.h
new file mode 100644
index 0000000000000000000000000000000000000000..893bd971022b576509bff1f12bf9592c57644202
--- /dev/null
+++ b/src/workflowy/WorkflowyRichText.h
@@ -0,0 +1,96 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace workflowy {
+
+enum TextStyle : uint8_t {
+  Bold = 1,
+  Italic = 2,
+  Underline = 4,
+  Strike = 8,
+  Highlight = 16
+};
+
+inline constexpr std::array<TextStyle, 5> textStyles{Bold, Italic, Underline, Strike, Highlight};
+inline constexpr std::array<std::string_view, 5> styleOpen{
+    "<b>", "<i>", "<u>", "<s>", "<span class=\"colored bc-yellow\">"};
+inline constexpr std::array<std::string_view, 5> styleClose{"</b>", "</i>", "</u>", "</s>", "</span>"};
+
+inline uint8_t htmlTextStyle(std::string_view name, std::string_view attributes) {
+  if (name == "b" || name == "strong") return Bold;
+  if (name == "i" || name == "em") return Italic;
+  if (name == "u" || (name == "span" && attributes.find("underline") != std::string_view::npos)) return Underline;
+  if (name == "s" || name == "strike" || name == "del") return Strike;
+  if (name == "mark" || name == "font" ||
+      (name == "span" && (attributes.find("bc-") != std::string_view::npos ||
+                          attributes.find("colored") != std::string_view::npos ||
+                          attributes.find("color:") != std::string_view::npos))) return Highlight;
+  return 0;
+}
+
+inline void normalizeStyles(std::string& styles) {
+  if (styles.find_first_not_of('\0') == std::string::npos) styles.clear();
+}
+
+inline void rebaseTextStyles(std::string_view oldText, std::string_view newText, std::string& styles) {
+  if (styles.empty()) return;
+  if (styles.size() != oldText.size()) {
+    styles.clear();
+    return;
+  }
+  size_t begin = 0;
+  while (begin < oldText.size() && begin < newText.size() && oldText[begin] == newText[begin]) ++begin;
+  size_t tail = 0;
+  while (tail < oldText.size() - begin && tail < newText.size() - begin &&
+         oldText[oldText.size() - tail - 1] == newText[newText.size() - tail - 1]) ++tail;
+  const char inherited = begin && begin < styles.size() && styles[begin - 1] == styles[begin] ? styles[begin] : 0;
+  styles.replace(begin, oldText.size() - begin - tail, newText.size() - begin - tail, inherited);
+  normalizeStyles(styles);
+}
+
+inline void toggleTextStyle(std::string& styles, size_t length, size_t begin, size_t end, TextStyle flag) {
+  if (begin >= end || end > length) return;
+  styles.resize(length, '\0');
+  const auto first = styles.begin() + begin;
+  const auto last = styles.begin() + end;
+  const bool remove = std::all_of(first, last, [&](uint8_t style) { return style & flag; });
+  for (auto it = first; it != last; ++it) {
+    *it = static_cast<char>(remove ? (*it & ~flag) : (*it | flag));
+  }
+  normalizeStyles(styles);
+}
+
+template <typename Visitor>
+void forEachStyleRun(std::string_view text, std::string_view styles, Visitor visit) {
+  if (text.empty()) return;
+  if (styles.size() != text.size()) {
+    visit(text, uint8_t{0});
+    return;
+  }
+  for (size_t begin = 0; begin < text.size();) {
+    size_t end = begin + 1;
+    while (end < text.size() && styles[end] == styles[begin]) ++end;
+    visit(text.substr(begin, end - begin), static_cast<uint8_t>(styles[begin]));
+    begin = end;
+  }
+}
+
+template <typename Escape>
+std::string styledHtml(std::string_view text, std::string_view styles, Escape escape) {
+  std::string html;
+  forEachStyleRun(text, styles, [&](std::string_view run, uint8_t flags) {
+    for (size_t i = 0; i < textStyles.size(); ++i)
+      if (flags & textStyles[i]) html += styleOpen[i];
+    html += escape(run);
+    for (size_t i = textStyles.size(); i-- > 0;)
+      if (flags & textStyles[i]) html += styleClose[i];
+  });
+  return html;
+}
+
+}  // namespace workflowy
diff --git a/src/workflowy/WorkflowySchedule.h b/src/workflowy/WorkflowySchedule.h
new file mode 100644
index 0000000000000000000000000000000000000000..9bbc7f940ddf5201b898f4174852b34a5a91e596
--- /dev/null
+++ b/src/workflowy/WorkflowySchedule.h
@@ -0,0 +1,201 @@
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace workflowy {
+// Put the clock one third down the visible day, clamped to the day bounds.
+inline int scheduleScrollForNow(int minute, int viewportHeight, int hourHeight) {
+  if (viewportHeight <= 0 || hourHeight <= 0) return 0;
+  const int visible = std::max(1, viewportHeight * 60 / hourHeight);
+  return std::clamp(minute - visible / 3, 0, std::max(0, 1440 - visible));
+}
+
+struct TimeRange {
+  int start = 0, end = 0;
+  size_t begin = 0, finish = 0;
+};
+
+inline void skipTimeSpaces(std::string_view text, size_t& at) {
+  while (at < text.size() && std::isspace(static_cast<unsigned char>(text[at]))) ++at;
+}
+
+struct ClockToken {
+  int minutes;
+  bool meridiem;
+};
+
+inline std::optional<ClockToken> parseClock(std::string_view text, size_t& at) {
+  const auto begin = at;
+  int hour = 0, digits = 0, minute = 0;
+  while (at < text.size() && std::isdigit(static_cast<unsigned char>(text[at])) && digits < 2) {
+    hour = hour * 10 + text[at++] - '0';
+    ++digits;
+  }
+  if (!digits) return {};
+  bool colon = at < text.size() && text[at] == ':';
+  if (colon) {
+    ++at;
+    if (at + 2 > text.size() || !std::isdigit(static_cast<unsigned char>(text[at])) ||
+        !std::isdigit(static_cast<unsigned char>(text[at + 1]))) return {};
+    minute = (text[at] - '0') * 10 + text[at + 1] - '0';
+    at += 2;
+  }
+  auto suffix = at;
+  skipTimeSpaces(text, suffix);
+  const bool am = suffix + 2 <= text.size() && (text[suffix] == 'a' || text[suffix] == 'A') &&
+                  (text[suffix + 1] == 'm' || text[suffix + 1] == 'M');
+  const bool pm = suffix + 2 <= text.size() && (text[suffix] == 'p' || text[suffix] == 'P') &&
+                  (text[suffix + 1] == 'm' || text[suffix + 1] == 'M');
+  if (minute > 59 || hour > 24 || (hour == 24 && minute) ||
+      ((am || pm) && (hour < 1 || hour > 12)) || (!colon && !am && !pm)) return {};
+  if (am || pm) {
+    hour = hour % 12 + (pm ? 12 : 0);
+    at = suffix + 2;
+  }
+  if (at == begin || (at < text.size() && std::isalnum(static_cast<unsigned char>(text[at])))) return {};
+  return ClockToken{hour * 60 + minute, am || pm};
+}
+
+inline std::optional<TimeRange> parseTimeRange(std::string_view text) {
+  for (size_t begin = 0; begin < text.size(); ++begin) {
+    if (!std::isdigit(static_cast<unsigned char>(text[begin])) ||
+        (begin && (std::isalnum(static_cast<unsigned char>(text[begin - 1])) || text[begin - 1] == ':'))) continue;
+    auto at = begin;
+    const auto start = parseClock(text, at);
+    if (!start || start->minutes >= 1440) continue;
+    skipTimeSpaces(text, at);
+    if (text.substr(at, 2) == "to" || text.substr(at, 2) == "TO") at += 2;
+    else if (text.substr(at, 3) == "–" || text.substr(at, 3) == "—") at += 3;
+    else if (at < text.size() && text[at] == '-') ++at;
+    else continue;
+    skipTimeSpaces(text, at);
+    const auto end = parseClock(text, at);
+    if (!end) continue;
+    int finish = end->minutes;
+    if (finish == 0 && end->meridiem) finish = 1440;
+    if (finish <= start->minutes) continue;
+    return TimeRange{start->minutes, finish, begin, at};
+  }
+  return {};
+}
+
+inline std::string scheduleClock(int minutes) {
+  char value[12];
+  minutes = std::clamp(minutes, 0, 1440) % 1440;
+  const int hour = minutes / 60;
+  snprintf(value, sizeof(value), "%d:%02d%s", hour % 12 ? hour % 12 : 12, minutes % 60,
+           hour < 12 ? "am" : "pm");
+  return value;
+}
+
+inline std::string scheduleRange(int start, int end) {
+  return scheduleClock(start) + " - " + scheduleClock(end);
+}
+
+inline std::string compactScheduleClock(int minutes) {
+  minutes = std::clamp(minutes, 0, 1440);
+  std::string text = std::to_string(minutes / 60);
+  const int minute = minutes % 60;
+  if (minute == 15) text += "¼";
+  else if (minute == 30) text += "½";
+  else if (minute == 45) text += "¾";
+  else if (minute) {
+    char part[4]; snprintf(part, sizeof(part), ":%02d", minute); text += part;
+  }
+  return text;
+}
+inline std::string compactScheduleRange(int start, int end) {
+  return compactScheduleClock(start) + "–" + compactScheduleClock(end);
+}
+
+inline bool scheduleSelectionFits(int start, int end, size_t count) {
+  return count && start >= 0 && end > start && end <= 1440 &&
+         count <= static_cast<size_t>((1440 - start) / (end - start));
+}
+
+inline std::string replaceTimeRange(std::string text, int start, int end) {
+  const auto range = parseTimeRange(text);
+  if (range) text.replace(range->begin, range->finish - range->begin, scheduleRange(start, end));
+  return text;
+}
+
+inline std::string shiftScheduleDate(std::string_view value, int delta) {
+  int year, month, day;
+  if (sscanf(std::string(value).c_str(), "%d-%d-%d", &year, &month, &day) != 3 ||
+      year < 1900 || year > 9999 || month < 1 || month > 12) return {};
+  const auto length = [](int y, int m) {
+    constexpr int days[] = {31,28,31,30,31,30,31,31,30,31,30,31};
+    return days[m - 1] + (m == 2 && y % 4 == 0 && (y % 100 != 0 || y % 400 == 0));
+  };
+  if (day < 1 || day > length(year, month)) return {};
+  while (delta > 0) {
+    if (++day > length(year, month)) {
+      day = 1;
+      if (++month > 12) { month = 1; ++year; }
+    }
+    --delta;
+  }
+  while (delta < 0) {
+    if (--day < 1) {
+      if (--month < 1) { month = 12; --year; }
+      day = length(year, month);
+    }
+    ++delta;
+  }
+  if (year < 1900 || year > 9999) return {};
+  char text[16];
+  snprintf(text, sizeof(text), "%04d-%02d-%02d", year, month, day);
+  return text;
+}
+
+inline int scheduleWeekday(std::string_view value) {
+  int year, month, day;
+  if (sscanf(std::string(value).c_str(), "%d-%d-%d", &year, &month, &day) != 3 ||
+      month < 1 || month > 12) return 0;
+  constexpr int offsets[] = {0,3,2,5,0,3,5,1,4,6,2,4};
+  year -= month < 3;
+  return (year + year / 4 - year / 100 + year / 400 + offsets[month - 1] + day + 6) % 7;
+}
+
+// Connected overlaps share the same number of side-by-side lanes.
+struct ScheduleLane {
+  int start, end;
+  size_t item;
+  unsigned lane = 0, lanes = 1;
+};
+inline void assignScheduleLanes(std::vector<ScheduleLane>& blocks, std::vector<int>& laneEnds) {
+  laneEnds.reserve(blocks.size());
+  std::stable_sort(blocks.begin(), blocks.end(), [](const auto& a, const auto& b) {
+    return a.start < b.start || (a.start == b.start && a.end > b.end);
+  });
+  size_t group = 0;
+  while (group < blocks.size()) {
+    int until = blocks[group].end;
+    size_t end = group + 1;
+    while (end < blocks.size() && blocks[end].start < until) {
+      until = std::max(until, blocks[end++].end);
+    }
+    laneEnds.clear();
+    for (size_t i = group; i < end; ++i) {
+      const auto lane = std::find_if(laneEnds.begin(), laneEnds.end(), [&](int until) {
+        return until <= blocks[i].start;
+      });
+      blocks[i].lane = lane - laneEnds.begin();
+      if (lane == laneEnds.end()) laneEnds.push_back(blocks[i].end);
+      else *lane = blocks[i].end;
+    }
+    for (size_t i = group; i < end; ++i) blocks[i].lanes = laneEnds.size();
+    group = end;
+  }
+}
+inline void assignScheduleLanes(std::vector<ScheduleLane>& blocks) {
+  std::vector<int> laneEnds;
+  assignScheduleLanes(blocks, laneEnds);
+}
+}  // namespace workflowy
