+void LibraryActivity::openBookBatchActions() {
+  if (selectedBooks.empty()) return;
+  static constexpr StrId choices[]{StrId::STR_MARK_FINISHED, StrId::STR_MARK_UNFINISHED, StrId::STR_DELETE};
+  actionPopup.show(StrId::STR_LIBRARY_BATCH_ACTIONS, choices, 3, 0, [this](int choice) {
+    const auto action = static_cast<BatchAction>(choice);
+    if (action == BatchAction::Delete) {
+      char message[80];
+      snprintf(message, sizeof(message), tr(STR_LIBRARY_BATCH_DELETE_MESSAGE), unsigned(selectedBooks.size()));
+      openDialog(makeUniqueNoThrow<ConfirmationActivity>(renderer, mappedInput, tr(STR_DELETE), message),
+                 [this](const ActivityResult& result) {
+                   if (!result.isCancelled) applyBookBatch(BatchAction::Delete);
+                 });
+    } else {
+      applyBookBatch(action);
+    }
+  });
+  requestUpdate();
+}
