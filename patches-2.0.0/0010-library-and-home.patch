+#include <gtest/gtest.h>
+#include <string>
+#include "EpubThumbnailPath.h"
+struct RecentBook { std::string path; };
+struct Epub {
+  static std::string cachePathForFilePath(const std::string& path, const std::string& dir) {
+    return dir + "/opaque-cache-id" + path;
+  }
+};
+namespace FsHelpers {
+bool hasEpubExtension(const std::string& path) { return path.ends_with(".epub"); }
+bool hasXtcExtension(const std::string& path) { return path.ends_with(".xtc"); }
+}
+struct Xtc {
+  Xtc(const std::string&, const std::string&) {}
+  std::string getThumbBmpPath(int, int) { return "/xtc.bmp"; }
+};
+#include "CoverIdentity.inc"
+TEST(CoverIdentity, LibraryRequestsExactlyTheVersionedFileProducedByEpub) {
+  for (const auto& name : {"/Books/One.epub", "/Books/Other author/Two.epub"}) {
+    const RecentBook book{name};
+    const auto cache = Epub::cachePathForFilePath(name, "/.crosspoint");
+    for (const auto size : {std::pair{120, 180}, std::pair{142, 222}, std::pair{220, 320}}) {
+      const auto produced = getThumbBmpPathForDimensions(cache, size.first, size.second);
+      EXPECT_EQ(gridThumbPath(book, size.first, size.second), produced);
+      EXPECT_TRUE(produced.ends_with("_v2.bmp"));
+    }
+  }
+}
+TEST(CoverIdentity, FixedAndAdaptiveCachesRemainDistinct) {
+  EXPECT_NE(EpubThumbnailPath::fixed("/cache", 120, 180), EpubThumbnailPath::adaptive("/cache", 120, 180));
+  EXPECT_EQ(EpubThumbnailPath::pattern("/cache"), "/cache/thumb_[WIDTH]x[HEIGHT]_v2.bmp");
+  EXPECT_TRUE(gridThumbPath({"/Books/file.txt"}, 120, 180).empty());
+}
diff --git a/test/library_thumbnails/ExtractCoverIdentity.py b/test/library_thumbnails/ExtractCoverIdentity.py
new file mode 100644
index 0000000000000000000000000000000000000000..d247837d96e476bc53f63a32642bc4e0bc589e7f
--- /dev/null
+++ b/test/library_thumbnails/ExtractCoverIdentity.py
@@ -0,0 +1,15 @@
+from pathlib import Path
+import sys
+root, output = map(Path, sys.argv[1:])
+def function(path, signature):
+    text = (root / path).read_text()
+    start = text.index(signature)
+    brace = text.index('{', start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+output.write_text(function('lib/Epub/Epub.cpp', 'std::string getThumbBmpPathForDimensions(') + '\n' +
+                  function('src/components/BookCoverCache.cpp', 'std::string gridThumbPath('))
