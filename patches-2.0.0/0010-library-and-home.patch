diff --git a/lib/Epub/EpubThumbnailPath.h b/lib/Epub/EpubThumbnailPath.h
new file mode 100644
index 0000000000000000000000000000000000000000..951c35bd8aadccd45211a3ea64ec9870f60fbc8f
--- /dev/null
+++ b/lib/Epub/EpubThumbnailPath.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <string>
+
+// One cache identity for EPUB thumbnail producers and every cover consumer.
+// Change the revision here whenever the thumbnail encoding/layout changes.
+namespace EpubThumbnailPath {
+inline constexpr char Revision[] = "_v2";
+inline std::string stem(const std::string& cache, int width, int height) {
+  return cache + "/thumb_" + std::to_string(width) + "x" + std::to_string(height);
+}
+inline std::string fixed(const std::string& cache, int width, int height) {
+  return stem(cache, width, height) + Revision + ".bmp";
+}
+inline std::string adaptive(const std::string& cache, int width, int height) {
+  return stem(cache, width, height) + "_fit" + Revision + ".bmp";
+}
+inline std::string pattern(const std::string& cache) {
+  return cache + "/thumb_[WIDTH]x[HEIGHT]" + Revision + ".bmp";
+}
+}
diff --git a/scripts/generate_launcher_icons.py b/scripts/generate_launcher_icons.py
new file mode 100644
index 0000000000000000000000000000000000000000..5fd9febed43d4ef3bd72b56d38d388811da67b89
--- /dev/null
+++ b/scripts/generate_launcher_icons.py
@@ -0,0 +1,31 @@
+"""Render launcher SVGs at native screen sizes. Requires pillow and resvg-py."""
+from pathlib import Path
+import io
+import resvg_py
+from PIL import Image
+
+root = Path(__file__).resolve().parents[1]
+out = ['#pragma once', '#include <Icon.h>', '// Generated from assets/launcher/*.svg; do not edit.']
+for name in ['home', 'library', 'workflowy', 'calendar', 'browse', 'transfer', 'settings', 'plugins']:
+    for size in [32, 80]:
+        png = resvg_py.svg_to_bytes(svg_path=str(root / 'assets/launcher' / (name + '.svg')), width=size * 4, height=size * 4)
+        image = Image.open(io.BytesIO(png)).convert('RGBA')
+        image = image.crop(image.getchannel('A').getbbox())
+        inset = 4 if size == 32 else 8
+        image.thumbnail((size - 2 * inset, size - 2 * inset), Image.Resampling.LANCZOS)
+        white = Image.new('RGBA', (size, size), 'white')
+        white.alpha_composite(image, ((size - image.width) // 2, (size - image.height) // 2))
+        pixels = white.convert('L').load(); data = []; ys = []
+        for y in range(size):
+            for xb in range(0, size, 8):
+                byte = 255
+                for b in range(8):
+                    if xb + b < size and pixels[xb + b, y] < 150:
+                        byte &= ~(128 >> b); ys.append(y)
+                data.append(byte)
+        ident = f'launcher_{name}_{size}'
+        out.append(f'inline constexpr uint8_t {ident}_bits[] = {{')
+        for i in range(0, len(data), 16): out.append('  ' + ', '.join(f'0x{v:02x}' for v in data[i:i+16]) + ',')
+        out.append('};')
+        out.append(f'inline constexpr freeink::Icon {ident}{{{size}, {size}, {round(sum(ys)/len(ys))}, {ident}_bits}};')
+(root / 'src/components/icons/launcherIcons.h').write_text('\n'.join(out) + '\n')
