new file mode 100644
index 0000000000000000000000000000000000000000..2aa057ba8f6e60c5f09692d51a14103cfa94ccb7
--- /dev/null
+++ b/src/components/LauncherLayout.cpp
@@ -0,0 +1,29 @@
+#include "LauncherLayout.h"
+#include <HalStorage.h>
+#include <Logging.h>
+#include "sync/SyncFiles.h"
+
+namespace {
+constexpr char Path[] = "/.crashink/.launcher.bin";
+constexpr uint32_t Magic = 0x314c5341;
+constexpr uint8_t Version = 1;
+}
+bool LauncherLayout::load() {
+  SyncFiles::Reader reader(Path);
+  uint32_t magic = 0;
+  uint8_t version = 0;
+  LauncherLayout saved;
+  if (reader.open() == SyncFiles::Reader::Source::None || !reader.pod(magic) || magic != Magic ||
+      !reader.pod(version) || version != Version || !reader.read(saved.slots.data(), saved.slots.size()) ||
+      !reader.atEnd() || !saved.valid()) return false;
+  slots = saved.slots;
+  return true;
+}
+bool LauncherLayout::save() const {
+  if (!valid() || !Storage.ensureDirectoryExists("/.crashink")) return false;
+  SyncFiles::Writer writer(Path);
+  const bool saved = writer.open() && writer.pod(Magic) && writer.pod(Version) &&
+                     writer.write(slots.data(), slots.size()) && writer.commit();
+  if (!saved) LOG_ERR("HOME", "Could not save launcher arrangement");
+  return saved;
+}
diff --git a/src/components/LauncherLayout.h b/src/components/LauncherLayout.h
new file mode 100644
index 0000000000000000000000000000000000000000..aac02a710ac898fe7dcf26cbbc43d32fbcc06468
--- /dev/null
+++ b/src/components/LauncherLayout.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <array>
+#include <cstdint>
+
+struct LauncherLayout {
+  static constexpr int Apps = 7, Slots = 9;
+  std::array<uint8_t, Apps> slots{0, 1, 2, 3, 4, 5, 8};
+  bool valid() const {
+    uint16_t seen = 0;
+    for (auto slot : slots) {
+      if (slot >= Slots || (seen & (1u << slot))) return false;
+      seen |= 1u << slot;
+    }
+    return true;
+  }
+  int appAt(int slot) const {
+    for (int i = 0; i < Apps; ++i) if (slots[i] == slot) return i;
+    return -1;
+  }
+  bool move(int app, int destination) {
+    if (app < 0 || app >= Apps || destination < 0 || destination >= Slots || slots[app] == destination) return false;
+    const int occupant = appAt(destination);
+    if (occupant >= 0) slots[occupant] = slots[app];
+    slots[app] = static_cast<uint8_t>(destination);
+    return true;
+  }
+  int next(int app, int direction) const {
+    for (int step = 1; step <= Slots; ++step) {
+      const int candidate = appAt((slots[app] + direction * step + Slots * 2) % Slots);
+      if (candidate >= 0) return candidate;
+    }
+    return app;
+  }
+  bool load();
+  bool save() const;
+};
