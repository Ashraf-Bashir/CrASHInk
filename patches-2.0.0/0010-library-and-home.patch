+ for(int view=0;view<6;++view){renderer.clearScreen();AppNavigation::draw(renderer,static_cast<AppNavigation::View>(view));
+ int activeCenter=(2*(view+1)+1)*480/(2*AppNavigation::RibbonCount);
+ assert(renderer.pixels[(800-AppNavigation::Height+7)*480+activeCenter]==0);
+ int whiteGlyph=0;for(int yy=760;yy<785;++yy)for(int xx=activeCenter-14;xx<=activeCenter+14;++xx)whiteGlyph+=renderer.pixels[yy*480+xx]==255;
+ assert(whiteGlyph>5);
+ input.clear();input.x=40;input.y=780;assert(AppNavigation::handleInput(renderer,input,static_cast<AppNavigation::View>(view))==false);input.tap=true;assert(AppNavigation::handleInput(renderer,input,static_cast<AppNavigation::View>(view)));assert(activityManager.opened.back()==AppNavigation::View::Home);
+  for(int cell=1;cell<AppNavigation::RibbonCount;++cell){input.clear();input.x=(2*cell+1)*480/(2*AppNavigation::RibbonCount);input.y=780;input.tap=true;auto before=activityManager.opened.size();assert(AppNavigation::handleInput(renderer,input,static_cast<AppNavigation::View>(view)));if(cell-1!=view)assert(activityManager.opened.back()==static_cast<AppNavigation::View>(cell-1));else assert(activityManager.opened.size()==before);}
