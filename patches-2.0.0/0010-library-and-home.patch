diff --git a/src/activities/home/AppLauncherActivity.cpp b/src/activities/home/AppLauncherActivity.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..227b187097cae3a68c2844e5add8d63a1ec05778
--- /dev/null
+++ b/src/activities/home/AppLauncherActivity.cpp
@@ -0,0 +1,143 @@
+#include "AppLauncherActivity.h"
+#include <I18n.h>
+#include <algorithm>
+#include "components/UITheme.h"
+#include "fontIds.h"
+
+namespace {
+constexpr AppNavigation::View apps[] = {
+    AppNavigation::View::Library, AppNavigation::View::Workflowy, AppNavigation::View::Calendar,
+    AppNavigation::View::Browse, AppNavigation::View::Transfer, AppNavigation::View::Plugins,
+    AppNavigation::View::Settings};
+constexpr int appCount = sizeof(apps) / sizeof(apps[0]);
+}  // namespace
+
+void AppLauncherActivity::onEnter() {
+  Activity::onEnter();
+  { RenderLock lock; renderer.setOrientation(GfxRenderer::Orientation::Portrait); }
+  mappedInput.suppressCurrentTouchContact();
+  mappedInput.suppressNextBackRelease();
+  mappedInput.clearDeferredHomeGesture();
+  layout.load();
+  dragging = dropSlot = -1; layoutSaveFailed = false;
+  painted.store(false); pressed = -1; launching = false;
+  requestUpdate(); // Navigation must never leave the outgoing screen visible.
+}
+Rect AppLauncherActivity::slotRect(int slot) const {
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  constexpr int columns = 3, rows = 3;
+  const int startY = UITheme::getTopStatusBarY(renderer) + UITheme::getInstance().getMetrics().statusBarVerticalMargin;
+  const int width = renderer.getScreenWidth() - left - right;
+  const int height = std::max(1, renderer.getScreenHeight() - bottom - startY);
+  const int side = std::min(112, std::min((width - 48) / columns,
+                                      (height - 40 - rows * (12 + renderer.getLineHeight(UI_12_FONT_ID))) / rows));
+  const int blockHeight = side + 12 + renderer.getLineHeight(UI_12_FONT_ID);
+  const int freeX = std::max(0, width - columns * side);
+  const int freeY = std::max(0, height - rows * blockHeight);
+  const int column = slot % columns, row = slot / columns;
+  // Divide the remainder across all outside/interior gutters, within one pixel.
+  return Rect{left + (column + 1) * freeX / (columns + 1) + column * side,
+              startY + (row + 1) * freeY / (rows + 1) + row * blockHeight, side, blockHeight};
+}
+Rect AppLauncherActivity::tile(int index) const { return slotRect(layout.slots[index]); }
+int AppLauncherActivity::slotAt(int x, int y) const {
+  for (int slot = 0; slot < LauncherLayout::Slots; ++slot) {
+    const auto r = slotRect(slot);
+    if (x >= r.x - 12 && x < r.x + r.width + 12 && y >= r.y && y < r.y + r.height) return slot;
+  }
+  return -1;
+}
+void AppLauncherActivity::open(int index) {
+  if (!painted.load() || launching) return;
+  launching = true; pressed = -1;
+  mappedInput.suppressCurrentTouchContact();
+  AppNavigation::open(apps[index], renderer, mappedInput);
+}
+void AppLauncherActivity::loop() {
+  if (!painted.load()) { mappedInput.clearDeferredHomeGesture(); return; }
+  if (launching) return;
+  int x = 0, y = 0;
+  if (dragging >= 0) {
+    if (mappedInput.isScreenTouchHeld(x, y)) {
+      const int target = slotAt(x, y);
+      if (target != dropSlot) { dropSlot = target; requestUpdate(); }
+    }
+    if (mappedInput.wasScreenTouchReleased() || mappedInput.wasScreenTapped(x, y)) {
+      RenderLock lock(*this);
+      const auto previous = layout;
+      if (layout.move(dragging, dropSlot) && !layout.save()) { layout = previous; layoutSaveFailed = true; }
+      dragging = dropSlot = pressed = -1; moved = true;
+      mappedInput.suppressCurrentTouchContact();
+      requestUpdate();
+    }
+    return;
+  }
+  using Button = MappedInputManager::Button;
+  if (mappedInput.wasReleased(Button::Left) || mappedInput.wasReleased(Button::Up)) {
+    selected = layout.next(selected, -1); requestUpdate();
+  }
+  if (mappedInput.wasReleased(Button::Right) || mappedInput.wasReleased(Button::Down)) {
+    selected = layout.next(selected, 1); requestUpdate();
+  }
+  if (mappedInput.wasReleased(Button::Confirm) || mappedInput.wasHomeGesture()) { open(selected); return; }
+  const auto at = [&](int x, int y) {
+    for (int i = 0; i < appCount; ++i) {
+      const auto r = tile(i);
+      if (x >= r.x - 12 && x < r.x + r.width + 12 && y >= r.y && y < r.y + r.height) return i;
+    }
+    return -1;
+  };
+  if (mappedInput.wasScreenTouchDown(x, y)) {
+    pressed = at(x, y); touchX = x; touchY = y; moved = false; layoutSaveFailed = false;
+  }
+  if (pressed >= 0 && !moved && mappedInput.isScreenTouchLongPress(x, y, 450)) {
+    RenderLock lock(*this);
+    dragging = selected = pressed; dropSlot = layout.slots[pressed];
+    requestUpdate();
+    return;
+  }
+  if (mappedInput.isScreenTouchHeld(x, y) && (std::abs(x - touchX) > 14 || std::abs(y - touchY) > 14)) moved = true;
+  if (mappedInput.wasSwipe() != MappedInputManager::SwipeDir::None) { pressed = -1; moved = true; return; }
+  if (mappedInput.wasScreenTapped(x, y)) {
+    const int candidate = pressed; pressed = -1;
+    if (!moved && candidate >= 0 && candidate == at(x, y)) open(candidate);
+  }
+}
+void AppLauncherActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  GUI.drawDisplayStatusBar(renderer, top);
+  const char* labels[] = {tr(STR_LIBRARY), tr(STR_WORKFLOWY), tr(STR_WORKFLOWY_CALENDAR_VIEW),
+                          tr(STR_BROWSE), tr(STR_FILE_TRANSFER), tr(STR_PLUGINS), tr(STR_SETTINGS_SHORT)};
+  if (dragging >= 0) {
+    for (int slot = 0; slot < LauncherLayout::Slots; ++slot) {
+      const auto r = slotRect(slot);
+      renderer.drawRoundedRect(r.x, r.y, r.width, r.width, slot == dropSlot ? 3 : 1, 22, true);
+    }
+  }
+  for (int i = 0; i < appCount; ++i) {
+    const auto r = tile(i);
+    const int side = r.width;
+    const int x = r.x, y = r.y;
+    const bool focused = i == selected;
+    // Logical ink is reversed by the display in dark mode: selected becomes
+    // white with a black glyph there, without a second local inversion.
+    renderer.fillRoundedRect(x, y, side, side, 22, focused ? Color::Black : Color::White);
+    renderer.drawRoundedRect(x, y, side, side, 1, 22, true);
+    AppNavigation::drawMask(renderer, AppNavigation::icon(apps[i], true),
+                            x + (side - 80) / 2, y + (side - 80) / 2, !focused);
+    const auto style = focused ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR;
+    const auto label = renderer.truncatedText(UI_12_FONT_ID, labels[i], r.width + 32, style);
+    const int textX = r.x + (r.width - renderer.getTextWidth(UI_12_FONT_ID, label.c_str(), style)) / 2;
+    renderer.drawText(UI_12_FONT_ID, textX, y + side + 12, label.c_str(), true, style);
+  }
+  if (dragging >= 0 && dropSlot >= 0) {
+    const auto r = slotRect(dropSlot);
+    renderer.drawRoundedRect(r.x - 3, r.y - 3, r.width + 6, r.width + 6, 3, 25, true);
+  }
+  if (layoutSaveFailed) GUI.drawPopup(renderer, tr(STR_ERROR_GENERAL_FAILURE));
+  renderer.displayBuffer(HalDisplay::FAST_REFRESH);
+  painted.store(true);
+}
