@@ -0,0 +1,39 @@
+#include <gtest/gtest.h>
+#include <HalStorage.h>
+#include "components/LauncherLayout.h"
+#include "sync/SyncFiles.h"
+namespace {
+constexpr char Path[] = "/.crashink/.launcher.bin";
+class LauncherLayoutStore : public ::testing::Test {
+ protected:
+  void SetUp() override { Storage.reset(); }
+};
+}
+TEST_F(LauncherLayoutStore, MovesAndSwapsSurviveANewInstance) {
+  LauncherLayout original;
+  ASSERT_TRUE(original.move(0, 6)); ASSERT_TRUE(original.move(1, 6));
+  ASSERT_TRUE(original.save());
+  LauncherLayout reopened; ASSERT_TRUE(reopened.load());
+  EXPECT_EQ(reopened.slots, original.slots); EXPECT_TRUE(reopened.valid());
+}
+TEST_F(LauncherLayoutStore, FailedPublicationKeepsPreviousArrangement) {
+  LauncherLayout original; ASSERT_TRUE(original.save());
+  LauncherLayout changed = original; ASSERT_TRUE(changed.move(0, 7));
+  Storage.failNextRenameFrom(std::string(Path) + ".tmp"); EXPECT_FALSE(changed.save());
+  LauncherLayout reopened; ASSERT_TRUE(reopened.load()); EXPECT_EQ(reopened.slots, original.slots);
+}
+TEST_F(LauncherLayoutStore, CorruptMainRecoversPreviousCheckedLayout) {
+  LauncherLayout original; ASSERT_TRUE(original.save());
+  LauncherLayout changed = original; ASSERT_TRUE(changed.move(0, 7)); ASSERT_TRUE(changed.save());
+  Storage.bytes(Path)->at(6) ^= 0x10;
+  LauncherLayout reopened; ASSERT_TRUE(reopened.load()); EXPECT_EQ(reopened.slots, original.slots);
+}
+TEST_F(LauncherLayoutStore, DuplicateSlotsAreRejectedWithoutReplacingDefaults) {
+  LauncherLayout invalid; invalid.slots[1] = invalid.slots[0];
+  { SyncFiles::Writer writer(Path);
+    ASSERT_TRUE(writer.open()); ASSERT_TRUE(writer.pod(uint32_t{0x314c5341}));
+    ASSERT_TRUE(writer.pod(uint8_t{1})); ASSERT_TRUE(writer.write(invalid.slots.data(), invalid.slots.size()));
+    ASSERT_TRUE(writer.commit()); }
+  LauncherLayout reopened; const auto defaults = reopened.slots;
+  EXPECT_FALSE(reopened.load()); EXPECT_EQ(reopened.slots, defaults);
+}
