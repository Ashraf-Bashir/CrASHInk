diff --git a/src/components/AppNavigation.cpp b/src/components/AppNavigation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8b734c6bf4705723aaea1f4ead1146b2cfd51ab2
--- /dev/null
+++ b/src/components/AppNavigation.cpp
@@ -0,0 +1,75 @@
+#include "AppNavigation.h"
+#include <GfxRenderer.h>
+#include <Memory.h>
+#include "MappedInputManager.h"
+#include "activities/ActivityManager.h"
+#include "components/icons/launcherIcons.h"
+#ifndef SIMULATOR
+#include "activities/workflowy/WorkflowyDailyActivity.h"
+#endif
+namespace AppNavigation {
+const freeink::Icon& icon(View view, bool large) {
+  if (view == View::Home) return launcher_home_32;
+  if (view == View::Plugins) return large ? launcher_plugins_80 : launcher_plugins_32;
+  static constexpr const freeink::Icon* small[] = {&launcher_library_32, &launcher_workflowy_32, &launcher_calendar_32,
+    &launcher_browse_32, &launcher_transfer_32, &launcher_settings_32};
+  static constexpr const freeink::Icon* big[] = {&launcher_library_80, &launcher_workflowy_80, &launcher_calendar_80,
+    &launcher_browse_80, &launcher_transfer_80, &launcher_settings_80};
+  const auto index = static_cast<unsigned>(view);
+  return *(large ? big : small)[index < Count ? index : 0];
+}
+void drawMask(const GfxRenderer& renderer, const freeink::Icon& bitmap, int x, int y, bool foregroundBlack) {
+  // Icon masks are logical rows; legacy drawIcon expects pre-rotated panel bytes.
+  const int stride = (bitmap.w + 7) / 8;
+  for (int row = 0; row < bitmap.h; ++row)
+    for (int col = 0; col < bitmap.w; ++col)
+      if (!(bitmap.bits[row * stride + col / 8] & (0x80 >> (col & 7)))) renderer.drawPixel(x + col, y + row, foregroundBlack);
+}
+void draw(const GfxRenderer& renderer, View view) {
+  if (view == View::None) return;
+  int top, right, bottom, left;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int width = renderer.getScreenWidth() - right - left;
+  const int y = renderer.getScreenHeight() - bottom - Height;
+  renderer.fillRect(left, y, width, Height, false);
+  renderer.drawLine(left, y, left + width - 1, y, 1, true);
+  for (int i = 0; i < RibbonCount; ++i) {
+    const auto item = i == 0 ? View::Home : static_cast<View>(i - 1);
+    const int center = left + (2 * i + 1) * width / (2 * RibbonCount);
+    const bool selected = item == view;
+    if (selected) renderer.fillRoundedRect(center - 21, y + 6, 42, 42, 10, Color::Black);
+    drawMask(renderer, icon(item), center - 16, y + 11, !selected);
+  }
+}
+void open(View view, GfxRenderer& renderer, MappedInputManager& input) {
+  switch (view) {
+    case View::Home: activityManager.goHome(); break;
+    case View::Plugins: if (!activityManager.goToPlugins()) activityManager.goHome(); break;
+    case View::Library: activityManager.goToLibrary(); break;
+    case View::Browse: activityManager.goToFileBrowser(); break;
+    case View::Transfer: activityManager.goToFileTransfer(); break;
+    case View::Settings: activityManager.goToSettings(); break;
+#ifndef SIMULATOR
+    case View::Workflowy:
+    case View::Calendar: {
+      auto app = makeUniqueNoThrow<WorkflowyDailyActivity>(renderer, input, view == View::Calendar);
+      if (!app) { LOG_ERR("NAV", "Cannot allocate Workflowy"); break; }
+      activityManager.replaceActivity(std::move(app)); break;
+    }
+#endif
+    default: break;
+  }
+}
+bool handleInput(GfxRenderer& renderer, MappedInputManager& input, View current) {
+  if (current == View::None || input.wasSwipe() != MappedInputManager::SwipeDir::None) return false;
+  int x, y, top, right, bottom, left;
+  if (!input.wasScreenTapped(x, y)) return false;
+  renderer.getOrientedViewableTRBL(&top, &right, &bottom, &left);
+  const int width = renderer.getScreenWidth() - right - left;
+  if (width <= 0 || x < left || x >= left + width || y < renderer.getScreenHeight() - bottom - Height || y >= renderer.getScreenHeight() - bottom) return false;
+  const int cell = (x - left) * RibbonCount / width;
+  const auto view = cell == 0 ? View::Home : static_cast<View>(cell - 1);
+  if (view != current) open(view, renderer, input);
+  return true;
+}
+}
