+TEST(EpubTextGrayscaleTest, AsymmetricBordersMoveDrawingAndTouchTogether) {
+  HalDisplay display(800, 480);
+  GfxRenderer renderer(display);
+  renderer.begin();
+  renderer.setLightLeakBorder(5, 7, 11, 13);
+
+  struct Viewport {
+    GfxRenderer::Orientation orientation;
+    int width, height, panelX, panelY;
+  };
+  const Viewport views[] = {
+      {GfxRenderer::Portrait, 460, 784, 5, 466},
+      {GfxRenderer::LandscapeClockwise, 784, 460, 788, 466},
+      {GfxRenderer::PortraitInverted, 460, 784, 788, 7},
+      {GfxRenderer::LandscapeCounterClockwise, 784, 460, 5, 7},
+  };
+  for (const auto& view : views) {
+    renderer.setOrientation(view.orientation);
+    EXPECT_EQ(renderer.getScreenWidth(), view.width);
+    EXPECT_EQ(renderer.getScreenHeight(), view.height);
+    renderer.clearScreen(0xff);
+    renderer.drawPixel(0, 0);
+    const int offset = view.panelY * display.stride + view.panelX / 8;
+    EXPECT_EQ(display.bw[offset], 0xff & ~(0x80 >> (view.panelX % 8)));
+
+    int x, y;
+    renderer.tapToLogical((view.panelX + 0.5f) / 800, (view.panelY + 0.5f) / 480, x, y);
+    EXPECT_EQ(x, 0);
+    EXPECT_EQ(y, 0);
   }
 }
