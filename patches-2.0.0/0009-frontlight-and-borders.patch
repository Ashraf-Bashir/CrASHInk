+
+void HalDisplay::maskLightLeakBorder(uint8_t* buffer, const uint16_t firstRow, const uint16_t rows,
+                                    const bool whiteBits) const {
+  if (!buffer || !(lightLeakTop || lightLeakRight || lightLeakBottom || lightLeakLeft)) return;
+  // Keep the mask on the same physical panel edges when the book rotates.
+  // Portrait top/right/bottom/left become panel left/top/right/bottom.
+  const uint16_t stride = getDisplayWidthBytes();
+  const uint16_t height = getDisplayHeight();
+  const bool landscapeBuffer = getDisplayWidth() > height;
+  const uint8_t top = landscapeBuffer ? lightLeakRight : lightLeakTop;
+  const uint8_t right = landscapeBuffer ? lightLeakBottom : lightLeakRight;
+  const uint8_t bottom = landscapeBuffer ? lightLeakLeft : lightLeakBottom;
+  const uint8_t left = landscapeBuffer ? lightLeakTop : lightLeakLeft;
+  const auto apply = [whiteBits](uint8_t& byte, uint8_t bits) {
