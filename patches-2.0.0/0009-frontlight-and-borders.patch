+    if (left % 8) apply(line[left / 8], static_cast<uint8_t>(0xff << (8 - left % 8)));
+    if (left == 16) apply(line[1], 0xff);
+    if (right >= 8) apply(line[stride - 1], 0xff);
+    if (right % 8) apply(line[stride - 1 - right / 8], static_cast<uint8_t>((1u << (right % 8)) - 1));
+    if (right == 16) apply(line[stride - 2], 0xff);
