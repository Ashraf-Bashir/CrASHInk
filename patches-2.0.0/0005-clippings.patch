+std::array<int, GfxRenderer::Width * GfxRenderer::Height> components(const GfxRenderer& renderer) {
+  std::array<int, GfxRenderer::Width * GfxRenderer::Height> labels{};
+  int label = 0;
+  std::vector<int> pending;
+  for (int p = 0; p < static_cast<int>(labels.size()); ++p) {
+    if (labels[p] || renderer.pixels[p] != 2) continue;
+    labels[p] = ++label;
+    pending.push_back(p);
+    while (!pending.empty()) {
+      const int current = pending.back();
+      pending.pop_back();
+      const int x = current % GfxRenderer::Width, y = current / GfxRenderer::Width;
+      for (const auto [dx, dy] : {std::pair{-1, 0}, {1, 0}, {0, -1}, {0, 1}}) {
+        const int nx = x + dx, ny = y + dy;
+        if (nx < 0 || nx >= GfxRenderer::Width || ny < 0 || ny >= GfxRenderer::Height) continue;
+        const int next = ny * GfxRenderer::Width + nx;
+        if (!labels[next] && renderer.pixels[next] == 2) {
+          labels[next] = label;
+          pending.push_back(next);
+        }
+      }
+    }
+  }
+  return labels;
+}
