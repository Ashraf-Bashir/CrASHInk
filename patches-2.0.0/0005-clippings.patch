new file mode 100644
index 0000000000000000000000000000000000000000..d9193129b6d923a0553f9f93a27d364a87b603d7
--- /dev/null
+++ b/src/clippings/HighlightMerge.cpp
@@ -0,0 +1,133 @@
+#include "HighlightMerge.h"
+
+#include <Logging.h>
+#include <Memory.h>
+
+#include <algorithm>
+#include <limits>
+
+#include "ClippingStore.h"
+#include "HighlightMergeWords.h"
+
+namespace HighlightMerge {
+namespace {
+struct Candidate {
+  uint32_t start = UINT32_MAX, end = 0;
+  size_t index = 0;
+};
+struct Plan {
+  std::unique_ptr<uint8_t[]> remove;
+  XPathTextLocation combined;
+  bool merged = false;
+};
+bool plan(const std::shared_ptr<Epub>& book, uint16_t spine, uint16_t table, size_t index,
+          const XPathTextLocation& location, Plan& result) {
+  result.combined = location;
+  const auto& records = CLIPPINGS.getClippings();
+  size_t candidates = 0;
+  for (size_t i = 0; i < records.size(); ++i)
+    if (i != index && records[i].spineIndex == spine && records[i].tableSelection == table) ++candidates;
+  if (!candidates) return true;
+  // Commit-lifetime scratch: one byte per saved record, and 12 bytes per
+  // same-chapter candidate on ESP32. Fallible; never retain other quote texts.
+  result.remove = makeUniqueNoThrow<uint8_t[]>(records.size());
+  auto* remove = result.remove.get();
+  auto ranges = makeUniqueNoThrow<Candidate[]>(candidates);
+  if (!remove || !ranges) {
+    LOG_ERR("CLIP", "Cannot allocate overlap-merge scratch");
+    return false;
+  }
+  std::string other;
+  other.reserve(CLIPPING_TEXT_RESERVE);
+  size_t used = 0;
+  for (size_t i = 0; i < records.size(); ++i) {
+    const auto& clipping = records[i];
+    if (i == index || clipping.spineIndex != spine || clipping.tableSelection != table) continue;
+    auto& candidate = ranges[used++];
+    candidate.index = i;
+    if (!CLIPPINGS.readClippingText(i, other)) return false;
+    XPathTextLocation found;
+    const float hint = clipping.pageCount ? static_cast<float>(clipping.startPage) / clipping.pageCount : -1.0f;
+    if (ChapterXPathResolver::locateText(book, spine, other, hint, found) && !found.loose &&
+        found.total == location.total) {
+      candidate.start = found.start;
+      candidate.end = found.end;
+    }
+  }
+  auto& combined = result.combined;
+  bool grew = true;
+  while (grew) {
+    grew = false;
+    for (size_t i = 0; i < used; ++i) {
+      const auto& candidate = ranges[i];
+      if (remove[candidate.index] || candidate.start == UINT32_MAX || candidate.start > combined.end ||
+          candidate.end < combined.start)
+        continue;
+      if (!CLIPPINGS.readClippingText(candidate.index, other)) return false;
+      if (!sharesWord(other, candidate.start, std::max(candidate.start, combined.start),
+                      std::min(candidate.end, combined.end)))
+        continue;
+      remove[candidate.index] = 1;
+      const uint32_t start = std::min(combined.start, candidate.start), end = std::max(combined.end, candidate.end);
+      grew |= start != combined.start || end != combined.end;
+      combined.start = start;
+      combined.end = end;
+      result.merged = true;
+    }
+  }
+  return true;
+}
+bool commit(const std::shared_ptr<Epub>& book, uint16_t spine, size_t& index, Plan& plan) {
+  std::string joined;
+  if (!ChapterXPathResolver::extractText(book, spine, plan.combined, joined) || joined.empty() ||
+      joined.size() > CLIPPING_TEXT_MAX)
+    return false;
+  return CLIPPINGS.mergeClippingText(index, joined, plan.remove.get(), CLIPPINGS.clippingCount());
+}
+}  // namespace
+bool save(const std::shared_ptr<Epub>& book, uint16_t spine, size_t& index, XPathTextLocation& location,
+          const std::string& text) {
+  const auto* active = CLIPPINGS.clippingAt(index);
+  if (!active || active->spineIndex != spine || location.loose || location.start > location.end || text.empty())
+    return false;
+  Plan result;
+  if (!plan(book, spine, active->tableSelection, index, location, result)) return false;
+  if (!result.merged) return CLIPPINGS.updateClippingText(index, text);
+  if (!commit(book, spine, index, result)) return false;
+  location = result.combined;
+  return true;
+}
+ClippingStore::AddResult add(const std::shared_ptr<Epub>& book, const Clipping& metadata, const char* chapterTitle,
+                             const std::string& text, size_t& index, bool& merged) {
+  using Result = ClippingStore::AddResult;
+  merged = false;
+  XPathTextLocation location;
+  const float hint = metadata.pageCount ? static_cast<float>(metadata.startPage) / metadata.pageCount : -1.0f;
+  // A failed/loose source mapping must never absorb an existing quote. Keep
+  // the established new-clipping path available for otherwise valid selections.
+  const auto& records = CLIPPINGS.getClippings();
+  const bool hasCandidates = std::any_of(records.begin(), records.end(), [&](const Clipping& clipping) {
+    return clipping.spineIndex == metadata.spineIndex && clipping.tableSelection == metadata.tableSelection;
+  });
+  if (hasCandidates && ChapterXPathResolver::locateText(book, metadata.spineIndex, text, hint, location) &&
+      !location.loose) {
+    Plan result;
+    if (!plan(book, metadata.spineIndex, metadata.tableSelection, SIZE_MAX, location, result))
+      return Result::SaveFailed;
+    if (result.merged) {
+      const size_t count = CLIPPINGS.clippingCount();
+      for (index = 0; index < count && !result.remove[index]; ++index) {
+      }
+      if (index == count) return Result::SaveFailed;
+      result.remove[index] = 0;
+      if (!commit(book, metadata.spineIndex, index, result)) return Result::SaveFailed;
+      merged = true;
+      return Result::Added;
+    }
+  }
+  return CLIPPINGS.addClipping(metadata.spineIndex, metadata.startPage, metadata.endPage, metadata.pageCount,
+                               metadata.startWordIndex, metadata.endWordIndex, metadata.wordCount, chapterTitle,
+                               metadata.paragraphIndex, text, metadata.tableSelection, metadata.layoutSignature, &index,
+                               metadata.color, metadata.sourceStart, metadata.sourceEnd);
+}
+}  // namespace HighlightMerge
