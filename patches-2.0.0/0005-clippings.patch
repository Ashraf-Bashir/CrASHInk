+#include <memory>
+#include <string>
+#include <iostream>
+#define LOG_ERR(...) ((void)0)
+struct Page {int id;};
+struct DictionaryClippingRequest {uint8_t firstPageOffset=0,lastPageOffset=0;uint16_t firstPageWordOrdinal=1,lastPageWordOrdinal=2,firstWordByteOffset=0,lastWordByteEndOffset=4;};
+struct Renderer {int getLineHeight(int)const{return 20;}};
+struct {int getReaderFontId()const{return 0;}}SETTINGS;
+struct RenderLock {template<class T>explicit RenderLock(T&) {}};
+struct Navigator {
+ struct Word {int screenX=0,screenY=100,width=30,textLen=4,pageWordOrdinal=0,sourceWordByteOffset=0;int heightOr(int h)const{return h;}}words[3];
+ int current=1,anchor=0;
+ Navigator(){for(int i=0;i<3;++i){words[i].screenX=10+50*i;words[i].pageWordOrdinal=i;}}
+ bool getLookupSelectionRange(int& a,int& b)const{a=anchor;b=current;return true;}
+ std::string buildPhrase(int,int)const{return "next words";}
+ void releaseWorkingSet(){}
+ int getLastFlatIndex()const{return 2;}
+ const Word*getWordAt(int i)const{return i>=0&&i<3?&words[i]:nullptr;}
+ bool beginTouchMultiSelect(){anchor=current;return true;}
+ bool selectWordAtPoint(int x,int y,int,bool*hit){*hit=false;for(int i=0;i<3;++i)if(x>=words[i].screenX&&x<words[i].screenX+30&&y>=100&&y<120){current=i;*hit=true;return true;}return false;}
+};
+struct DictionaryLookupController {static size_t phraseWordCount(const std::string&){return 4;}};
+class DictionaryWordSelectActivity {
+ public:
+ int activePageOffset_=1;bool hasCrossPageSelection_=true,framebufferContainsPage_=true,crossPageFirstWordWasMerged_=false;
+ void*readerContext_=this;bool failLoad=false,failBuild=false;int loads=0,updates=0;bool fallback=false,fullRepaint=false,touchDragLookup_=true;
+ std::unique_ptr<Page>page=std::make_unique<Page>(Page{1});
+ std::unique_ptr<Page>(*readerPageLoad_)(void*,int)=[](void*c,int p){auto*self=static_cast<DictionaryWordSelectActivity*>(c);++self->loads;assert(p==0);return self->failLoad?nullptr:std::make_unique<Page>(Page{p});};
+ DictionaryClippingRequest crossPageFirstRequest_{},capturedFallback{};
+ std::string crossPageLookupPrefix_="original words",crossPageMergedFirstWord_,nextPageFirstWord;
+ Navigator navigator;Renderer renderer;struct {void clear(){}}workingSet_;
+ bool captureCurrentClippingRequest(DictionaryClippingRequest& r)const{r.firstPageOffset=r.lastPageOffset=1;return true;}
+ bool buildWorkingSet(bool){return !failBuild;}
+ void forceFullRepaintOnNextRender(){fullRepaint=true;}
+ void resetCrossPageSelection(){hasCrossPageSelection_=false;crossPageLookupPrefix_.clear();}
+ void requestUpdate(){++updates;}
+ void finishTouchLookupOnCurrentPage(const std::string&,size_t,const DictionaryClippingRequest&r){fallback=true;capturedFallback=r;}
+ bool continueTouchSelectionOnPreviousPage();
+};
+#include "DictionaryReverse.inc"
+int main(){
+ DictionaryWordSelectActivity a;assert(a.continueTouchSelectionOnPreviousPage());
+ assert(a.activePageOffset_==0&&a.page->id==0&&!a.hasCrossPageSelection_);
+ assert(a.navigator.anchor==1&&a.navigator.current==2); // original anchor was not page's first word
+ assert(a.touchDragLookup_&&!a.fallback&&a.fullRepaint&&!a.framebufferContainsPage_&&a.updates==1);
+ DictionaryWordSelectActivity blocked;blocked.failLoad=true;const auto*old=blocked.page.get();assert(!blocked.continueTouchSelectionOnPreviousPage());
+ assert(blocked.page.get()==old&&blocked.activePageOffset_==1&&blocked.hasCrossPageSelection_&&blocked.navigator.current==1);
+ DictionaryWordSelectActivity oom;oom.failBuild=true;assert(oom.continueTouchSelectionOnPreviousPage());
+ assert(oom.fallback&&oom.capturedFallback.firstPageOffset==0&&oom.capturedFallback.lastPageOffset==1);
+ DictionaryWordSelectActivity same;same.activePageOffset_=0;assert(!same.continueTouchSelectionOnPreviousPage()&&same.loads==0);
+ std::cout<<"Reverse selection preserves original anchor, live drag, repaint and failed-load range\n";
+}
