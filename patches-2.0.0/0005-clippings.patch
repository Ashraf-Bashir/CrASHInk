+inline GapRect continuationTip(const GapRect& marker, bool left, int limitLeft, int limitRight) {
+  if (marker.width <= 0 || marker.height <= 0) return {};
+  const int base = left ? marker.x : marker.x + marker.width;
+  const int available = left ? base - limitLeft : limitRight - base;
+  const int width = std::min(std::max(1, marker.height / 2), std::max(0, available));
+  return {left ? base - width : base, marker.y, width, marker.height};
