index 0000000000000000000000000000000000000000..682459ce1d65287cbe37926beae619e6271b3518
--- /dev/null
+++ b/test/highlight_word_edit/ClippingMergeStoreTest.cpp
@@ -0,0 +1,226 @@
+#include <HalStorage.h>
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <string>
+#include <vector>
+#define private public
+#include "ClippingStore.h"
+#include "clippings/ClippingSourceRange.h"
+#undef private
+struct MergeStorage : HalStorage {
+  using HalStorage::openFileForRead;
+  bool openFileForRead(const char* tag, const std::string& path, FsFile& file) {
+    return HalStorage::openFileForRead(tag, path.c_str(), file);
+  }
+} mergeStorage;
+#undef Storage
+#define Storage mergeStorage
+#define LOG_ERR(...) ((void)0)
+#define LOG_INF(...) ((void)0)
+constexpr uint8_t VERSION = 8, LEGACY_VERSION = 1, SOURCE_RANGE_VERSION = 8, NOTE_VERSION = 6,
+ LAYOUT_SIGNATURE_VERSION = 3, TABLE_SELECTION_VERSION = 4, COLOR_VERSION = 5;
+constexpr size_t TEXT_COPY_BUFFER_SIZE = 128;
+constexpr const char* CLIPPINGS_DIR = "/.crashink/.clippings";
+void ClippingStore::markChanged() {}
+int utf8SafeTruncateBuffer(const char*, int size) { return size; }
+namespace serialization {
+template <class T> bool tryReadPod(FsFile& f, T& value) { return f.read(&value, sizeof(value)) == sizeof(value); }
+bool tryReadString(FsFile& f, std::string& value) { uint32_t size = 0; if (!tryReadPod(f, size) || size > 4096) return false; value.resize(size); return f.read(value.data(), size) == size; }
+
+template <class T>
+bool tryWritePod(FsFile& f, const T& value) {
+  return f.write(&value, sizeof(value)) == sizeof(value);
+}
+bool tryWriteString(FsFile& f, const std::string& s) {
+  const uint32_t n = s.size();
+  return tryWritePod(f, n) && f.write(s.data(), n) == n;
+}
+}  // namespace serialization
+void sanitizeChapterTitle(char* title) { title[CLIPPING_CHAPTER_TITLE_MAX - 1] = 0; }
+uint32_t textLengthFieldBytes(uint8_t version) { return version == LEGACY_VERSION ? 4 : 2; }
+#include "ClippingMergeStore.inc"
+namespace {
+ClippingStore seed() {
+  fake::reset();
+  ClippingStore store;
+  store.storeFilePath = "/clips.bin";
+  store.bookFilePath = "/book.epub";
+  store.bookTitle = "Book";
+  store.fileVersion = VERSION;
+  FsFile out = Storage.open("/clips.bin", O_WRONLY | O_CREAT | O_TRUNC);
+  const uint16_t count = 3;
+  serialization::tryWritePod(out, VERSION);
+  serialization::tryWritePod(out, count);
+  serialization::tryWriteString(out, store.bookTitle);
+  serialization::tryWriteString(out, store.bookAuthor);
+  serialization::tryWriteString(out, store.bookFilePath);
+  for (const char* text : {"first quote", "second quote", "third quote"}) {
+    Clipping clip;
+    clip.textLength = std::strlen(text);
+    clip.spineIndex = 1;
+    clip.pageCount = 10;
+    clip.layoutSignature = 123;
+    char title[CLIPPING_CHAPTER_TITLE_MAX] = "Chapter";
+    writeClippingRecord(out, clip, title);
+    serialization::tryWritePod(out, clip.textLength);
+    clip.textOffset = out.position();
+    out.write(text, clip.textLength);
+    serialization::tryWritePod(out, clip.noteLength);
+    store.clippings.push_back(clip);
+  }
+  out.close();
+  return store;
+}
+std::string textAt(const ClippingStore& store, size_t row) {
+  const auto& c = store.clippings[row];
+  const auto& bytes = fake::files["/clips.bin"]->bytes;
+  return std::string(reinterpret_cast<const char*>(bytes.data() + c.textOffset), c.textLength);
+}
+}  // namespace
+TEST(ClippingMergeStore, SingleRewriteReplacesSurvivorDropsAbsorbedAndRetainsOtherText) {
+  auto store = seed();
+  size_t index = 1;
+  const uint8_t remove[] = {1, 0, 0};
+  ASSERT_TRUE(store.mergeClippingText(index, "first and second quote", remove, 3));
+  ASSERT_EQ(store.clippings.size(), 2u);
+  EXPECT_EQ(index, 0u);
+  EXPECT_EQ(textAt(store, 0), "first and second quote");
+  EXPECT_EQ(textAt(store, 1), "third quote");
+  EXPECT_EQ(store.clippings[0].layoutSignature, 0u);
+  EXPECT_EQ(store.clippings[1].layoutSignature, 123u);
+  const auto& bytes = fake::files["/clips.bin"]->bytes;
+  uint16_t count = 0;
+  std::memcpy(&count, bytes.data() + 1, sizeof(count));
+  EXPECT_EQ(count, 2);
