+    uint16_t startByte = 0;
+    uint16_t endByte = UINT16_MAX;
+    bool startsAtClipStart = false;
+    bool reachesClipEnd = false;
+  };
+  static constexpr size_t MATCHES = 16;
+  static constexpr size_t PAGES = 6;
+  struct Key {
+    const void* section = nullptr;
+    uint32_t layout = 0;
+    uint32_t revision = 0;
+    int spine = -1;
+    int pageCount = 0;
+    bool operator==(const Key& other) const {
+      return section == other.section && layout == other.layout && revision == other.revision && spine == other.spine &&
+             pageCount == other.pageCount;
+    }
+  };
+  struct Entry {
+    std::array<Match, MATCHES> matches{};
+    std::array<size_t, MATCHES> clippingIndices{};
+    size_t nextClipping = 0;
+    uint32_t usedAt = 0;
+    int page = -1;
+    uint16_t count = 0;
+    bool ready = false;
+    bool failed = false;
+  };
+  bool resetFor(const Key& next) {
+    if (key == next) return false;
+    key = next;
+    entries = {};
+    tick = 0;
+    return true;
+  }
+  Entry* find(int page) {
+    for (auto& entry : entries) {
+      if (entry.page == page) {
+        entry.usedAt = ++tick;
+        return &entry;
+      }
+    }
+    return nullptr;
+  }
+  Entry& claim(int page) {
+    if (auto* entry = find(page)) return *entry;
+    auto* victim = &entries[0];
+    for (auto& entry : entries) {
+      if (entry.page < 0) {
+        victim = &entry;
+        break;
+      }
+      if (entry.usedAt < victim->usedAt) victim = &entry;
+    }
+    *victim = {};
+    victim->page = page;
+    victim->usedAt = ++tick;
+    return *victim;
+  }
+
+ private:
+  Key key;
+  std::array<Entry, PAGES> entries{};
+  uint32_t tick = 0;
+};
+static_assert(sizeof(ClippingPageMatchCache) <= 2304, "Bounded nearby-page result cache");
diff --git a/src/clippings/ClippingSourceRange.h b/src/clippings/ClippingSourceRange.h
new file mode 100644
index 0000000000000000000000000000000000000000..82fc40555eef7375476ef416d08509b7539fd2a3
--- /dev/null
+++ b/src/clippings/ClippingSourceRange.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace clippingSource {
+enum class Slice : uint8_t { Outside, Match, Ambiguous };
+// Source coordinates count Unicode characters, never UTF-8 bytes. Synthetic
+// layout hyphens have no source character. Partial NFC-expanded words fall back
+// to the text matcher rather than widening the saved passage.
+inline Slice slice(std::string_view text, uint32_t wordStart, uint32_t wordEnd,
+                   uint32_t clipStart, uint32_t clipEnd, bool insertedHyphen,
+                   uint16_t& firstByte, uint16_t& lastByte) {
+  if (wordStart >= wordEnd || wordEnd == UINT32_MAX || wordStart >= clipEnd || wordEnd <= clipStart)
+    return Slice::Outside;
+  if (text.size() > UINT16_MAX) return Slice::Ambiguous;
+  const size_t semanticEnd = text.size() - (insertedHyphen && !text.empty() && text.back() == '-' ? 1 : 0);
+  uint32_t characters = 0;
+  for (size_t i = 0; i < semanticEnd; ++i)
+    if ((static_cast<unsigned char>(text[i]) & 0xc0) != 0x80) ++characters;
+  const bool whole = clipStart <= wordStart && clipEnd >= wordEnd;
+  if (!whole && characters != wordEnd - wordStart) return Slice::Ambiguous;
+  firstByte = 0; lastByte = UINT16_MAX;
+  if (whole) return Slice::Match;
+  uint32_t offset = 0;
+  for (size_t i = 0; i <= semanticEnd; ++i) {
+    if (i < semanticEnd && (static_cast<unsigned char>(text[i]) & 0xc0) == 0x80) continue;
+    if (wordStart + offset == clipStart) firstByte = static_cast<uint16_t>(i);
+    if (wordStart + offset == clipEnd && i < semanticEnd) lastByte = static_cast<uint16_t>(i);
+    ++offset;
+  }
+  return Slice::Match;
+}
+}  // namespace clippingSource
