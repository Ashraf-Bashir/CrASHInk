+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <string>
+#include <utility>
+#define LOG_ERR(...) \
+  do {               \
+  } while (0)
+namespace HighlightWordEdit {
+enum class Action { ExtendStart, TrimStart, TrimEnd, ExtendEnd };
+}
+struct Rect {
+  int x, y, width, height;
+};
+struct Renderer {};
+struct Clipping {
+  uint16_t spineIndex = 2, startPage = 7, pageCount = 30, paragraphIndex = 12;
+};
+struct Store {
+  Clipping clip;
+  bool saveOk = true, deleteOk = true;
+  unsigned saves = 0, deletes = 0;
+  bool updateClippingText(size_t, const std::string&) {
+    ++saves;
+    return saveOk;
+  }
+  bool removeClippingAt(size_t) {
+    ++deletes;
+    return deleteOk;
+  }
+  const Clipping* clippingAt(size_t) const { return &clip; }
+} CLIPPINGS;
+namespace HighlightMerge {
+inline bool save(int, int, size_t& index, int&, const std::string& text) { return CLIPPINGS.updateClippingText(index,text); }
+}
+struct ClippingJumpResult {
+  uint16_t spineIndex, page, pageCount, paragraphIndex, clippingIndex;
+};
+struct ActivityResult {
+  bool isCancelled = false;
+};
+struct Input {
+  enum class Button { Back, Confirm };
+  enum class SwipeDir { None, Up, Down };
+  bool back = false, confirm = false;
+  int tap = -1;
+  SwipeDir swipe = SwipeDir::None;
+  bool wasReleased(Button b) const { return b == Button::Back ? back : confirm; }
+  SwipeDir wasSwipe() const { return swipe; }
+  bool wasTapInRect(int x, int, int, int) const { return tap == x; }
+};
+using MappedInputManager = Input;
+struct TouchHeaderBackButton {
+  static bool wasTapped(const Input&, const Renderer&) { return false; }
+};
+struct RenderLock {
+  template <typename T>
+  explicit RenderLock(T&) {}
+};
+class HighlightEditActivity {
+ public:
+  Input mappedInput;
+  Renderer renderer;
+  size_t index = 4;
+  int book = 0, spine = 0, location = 0;
+  std::string draft = "edited quote";
+  bool changed = false, failed = false, finished = false, cancelled = false, opened = false;
+  int previewPage = 0, previewPages = 3, updates = 0;
+  ClippingJumpResult jump{};
+  void finish() { finished = true; }
+  void requestUpdate() { ++updates; }
+  void setResult(ActivityResult result) { cancelled = result.isCancelled; }
+  void setResult(ClippingJumpResult result) {
+    jump = result;
+    opened = true;
+  }
+  Rect closeRect() const { return {7, 0, 1, 1}; }
+  Rect buttonRect(int i) const { return {i, 0, 1, 1}; }
+  void adjust(HighlightWordEdit::Action) {}
+  void applyQueuedActions() {}
+  void accept();
+  void cancel();
+  void openSavedClipping();
+  void loop();
+};
+#include "EditorActions.inc"
+int main() {
+  HighlightEditActivity unchanged;
+  unchanged.mappedInput.tap = 6;
+  unchanged.loop();
+  assert(!unchanged.finished && CLIPPINGS.saves == 0);
+  unchanged.mappedInput.tap = -1;
+  unchanged.mappedInput.confirm = true;
+  unchanged.loop();
+  assert(!unchanged.finished && CLIPPINGS.saves == 0);
+  HighlightEditActivity save;
+  save.changed = true;
+  save.mappedInput.tap = 6;
+  save.loop();
+  assert(save.finished && CLIPPINGS.saves == 1);
+  CLIPPINGS.saveOk = false;
+  HighlightEditActivity failed;
+  failed.changed = true;
+  failed.mappedInput.tap = 6;
+  failed.loop();
+  assert(!failed.finished && failed.failed && CLIPPINGS.saves == 2);
+  CLIPPINGS.saveOk = true;
+  // Open is navigation to the saved clipping, not an implicit draft save.
+  HighlightEditActivity open;
+  open.changed = true;
+  open.mappedInput.tap = 5;
+  open.loop();
+  assert(open.finished && open.opened && CLIPPINGS.saves == 2);
+  assert(open.jump.spineIndex == 2 && open.jump.page == 7 && open.jump.pageCount == 30 && open.jump.clippingIndex == 4);
+  HighlightEditActivity remove;
+  remove.mappedInput.tap = 4;
+  remove.loop();
+  assert(remove.finished && CLIPPINGS.deletes == 1);  // no extra confirmation
+  CLIPPINGS.deleteOk = false;
+  HighlightEditActivity failedDelete;
+  failedDelete.mappedInput.tap = 4;
+  failedDelete.loop();
+  assert(!failedDelete.finished && failedDelete.failed);
+  HighlightEditActivity cancel;
+  cancel.changed = true;
+  cancel.mappedInput.tap = 7;
+  cancel.loop();
+  assert(cancel.finished && cancel.cancelled && CLIPPINGS.saves == 2);
+  HighlightEditActivity pages;
+  pages.mappedInput.swipe = Input::SwipeDir::Up;
+  pages.loop();
+  assert(pages.previewPage == 1);
+  pages.loop();
+  pages.loop();
+  assert(pages.previewPage == 2);
+  pages.mappedInput.swipe = Input::SwipeDir::Down;
+  pages.loop();
+  assert(pages.previewPage == 1);
+  std::cout << "Delete/Open/Save/Cancel routing, disabled Save, immediate Delete and long-quote paging passed\n";
+}
diff --git a/test/highlight_word_edit/HighlightWordEditTest.cpp b/test/highlight_word_edit/HighlightWordEditTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4c6112e807bb287240684a8122ad74f0d76813ca
--- /dev/null
+++ b/test/highlight_word_edit/HighlightWordEditTest.cpp
@@ -0,0 +1,80 @@
+#include <cassert>
+#include <iostream>
+
+#include "clippings/HighlightNeighbourWord.h"
+#include "clippings/HighlightWordEdit.h"
+#include "clippings/HighlightDraftState.h"
+
+int main() {
+  using HighlightWordEdit::Action;
+  HighlightDraftState baseline;
+  const std::string original = "alpha bravo";
+  baseline.reset(original);
+  assert(!baseline.changed(original));
+  for (const auto extend : {Action::ExtendStart, Action::ExtendEnd}) {
+    std::string extended, restored;
+    assert(HighlightWordEdit::adjust(original, extend, "caf\xc3\xa9.", 1024, extended));
+    assert(baseline.changed(extended));
+    assert(HighlightWordEdit::adjust(extended, extend == Action::ExtendStart ? Action::TrimStart : Action::TrimEnd,
+                                   "", 1024, restored));
+    assert(restored == original && !baseline.changed(restored));
+  }
+  for (const auto trim : {Action::TrimStart, Action::TrimEnd}) {
+    std::string reduced, restored;
+    assert(HighlightWordEdit::adjust(original, trim, "", 1024, reduced));
+    assert(baseline.changed(reduced));
+    assert(HighlightWordEdit::adjust(reduced, trim == Action::TrimStart ? Action::ExtendStart : Action::ExtendEnd,
+                                   trim == Action::TrimStart ? "alpha" : "bravo", 1024, restored));
+    assert(restored == original && !baseline.changed(restored));
+  }
+  std::string huge(60 * 1024, 'x');
+  baseline.reset(huge);
+  assert(!baseline.changed(huge));
+  huge.back() = 'y'; assert(baseline.changed(huge));
+  huge.back() = 'x'; assert(!baseline.changed(huge));
+  const auto book = std::make_shared<Epub>(std::vector<std::string>{
+      "<html><body><p>Before, alpha <em>bravo</em> caf&#233;. After!</p><p>Next paragraph.</p></body></html>"});
+  XPathTextLocation location;
+  assert(ChapterXPathResolver::locateText(book, 0, "alpha bravo", -1, location));
+  std::string word, result;
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, true, word));
+  assert(word == "Before,");
+  assert(HighlightWordEdit::adjust("alpha bravo", Action::ExtendStart, word, 1024, result));
+  assert(result == "Before, alpha bravo");
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  assert(word == "caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust("alpha bravo", Action::ExtendEnd, word, 1024, result));
+  assert(result == "alpha bravo caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust(result, Action::TrimStart, "", 1024, word));
+  assert(word == "bravo caf\xc3\xa9.");
+  assert(HighlightWordEdit::adjust(word, Action::TrimEnd, "", 1024, result));
+  assert(result == "bravo");
+  assert(!HighlightWordEdit::adjust("bravo", Action::TrimStart, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::TrimEnd, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::ExtendEnd, "", 1024, result));
+  assert(!HighlightWordEdit::adjust("bravo", Action::ExtendEnd, "six", 8, result));
+  assert(ChapterXPathResolver::locateText(book, 0, "Before,", -1, location));
+  assert(!HighlightWordEdit::neighbourWord(book, 0, location, true, word));
+  assert(ChapterXPathResolver::locateText(book, 0, "paragraph.", -1, location));
+  assert(!HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  // A block/page boundary supplies a word separator, not a glued token.
+  assert(ChapterXPathResolver::locateText(book, 0, "After!", -1, location));
+  assert(HighlightWordEdit::neighbourWord(book, 0, location, false, word));
+  assert(word == "Next");
+  const auto rtl = std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>قبل كلمة بعد</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(rtl, 0, "كلمة", -1, location));
+  assert(HighlightWordEdit::neighbourWord(rtl, 0, location, true, word) && word == "قبل");
+  assert(HighlightWordEdit::neighbourWord(rtl, 0, location, false, word) && word == "بعد");
+  const auto softHyphen =
+      std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>one hy&#173;phen two</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(softHyphen, 0, "two", -1, location));
+  assert(HighlightWordEdit::neighbourWord(softHyphen, 0, location, true, word) && word == "hyphen");
+  // A clipped context edge must not return the last part of a long word.
+  const std::string longWord(600, 'x');
+  const auto longBook = std::make_shared<Epub>(
+      std::vector<std::string>{"<html><body><p>prefix " + longWord + " target</p></body></html>"});
+  assert(ChapterXPathResolver::locateText(longBook, 0, "target", -1, location));
+  assert(HighlightWordEdit::neighbourWord(longBook, 0, location, true, word));
+  assert(word == longWord);
+  std::cout << "Highlight word editing checks passed\n";
+}
