+    detailMode = false;
+    detailText.clear();
+    detailLines.clear();
+    rebuildGroups();
+    listNav.selected = std::min<int>(listNav.selected, std::max(0, static_cast<int>(chapterGroups.rows.size()) - 1));
+    listNav.follow(static_cast<int>(chapterGroups.rows.size()));
+    requestUpdate();
+  });
