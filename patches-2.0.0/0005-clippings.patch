+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <vector>
+inline constexpr size_t CLIPPING_TEXT_MAX = 60 * 1024, CLIPPING_TEXT_RESERVE = 4096;
+struct ClippingStore {
+  enum class AddResult { Added, LimitReached, SaveFailed };
+};
+enum class ClippingColor : uint8_t { LightGrey, DarkGrey, Solid };
+struct Clipping {
+  ClippingColor color = ClippingColor::LightGrey;
+  uint16_t spineIndex = 0, startPage = 0, endPage = 0, pageCount = 100, tableSelection = UINT16_MAX;
+  uint16_t startWordIndex = 0, endWordIndex = 0, wordCount = 0, paragraphIndex = UINT16_MAX;
+  uint32_t sourceStart = UINT32_MAX, sourceEnd = UINT32_MAX;
+  uint32_t layoutSignature = 0;
+  std::string text;
+};
+struct MergeStore {
+  std::vector<Clipping> records;
+  bool failRead = false, failSave = false;
+  unsigned writes = 0, merges = 0, adds = 0, deletes = 0;
+  size_t clippingCount() const { return records.size(); }
+  bool removeClippingAt(size_t index) {
+    ++deletes;
+    records.erase(records.begin() + index);
+    return true;
+  }
+  ClippingStore::AddResult addClipping(uint16_t spine, uint16_t start, uint16_t end, uint16_t pages, uint16_t first,
+                                       uint16_t last, uint16_t words, const char*, uint16_t paragraph,
+                                       const std::string& text, uint16_t table, uint32_t layout,
+                                       size_t* index = nullptr, ClippingColor color = ClippingColor::LightGrey,
+                                       uint32_t sourceStart = UINT32_MAX, uint32_t sourceEnd = UINT32_MAX) {
+    if (failSave) return ClippingStore::AddResult::SaveFailed;
+    Clipping clip;
+    clip.spineIndex = spine;
+    clip.color = color;
+    clip.sourceStart = sourceStart; clip.sourceEnd = sourceEnd;
+    clip.startPage = start;
+    clip.endPage = end;
+    clip.pageCount = pages;
+    clip.startWordIndex = first;
+    clip.endWordIndex = last;
+    clip.wordCount = words;
+    clip.paragraphIndex = paragraph;
+    clip.tableSelection = table;
+    clip.layoutSignature = layout;
+    clip.text = text;
+    if (index) *index = records.size();
+    records.push_back(clip);
+    ++writes;
+    ++adds;
+    return ClippingStore::AddResult::Added;
+  }
+  const Clipping* clippingAt(size_t i) const { return i < records.size() ? &records[i] : nullptr; }
+  const auto& getClippings() const { return records; }
+  bool readClippingText(size_t i, std::string& text) const {
+    if (failRead) return false;
+    text = records[i].text;
+    return true;
+  }
+  bool updateClippingText(size_t i, const std::string& text) {
+    if (failSave) return false;
+    ++writes;
+    records[i].text = text;
+    return true;
+  }
+  bool mergeClippingText(size_t& index, const std::string& text, const uint8_t* remove, size_t count) {
+    if (failSave) return false;
+    ++writes;
+    ++merges;
+    records[index].text = text;
+    size_t write = 0, newIndex = 0;
+    for (size_t i = 0; i < count; ++i) {
+      if (remove[i]) continue;
+      if (i == index) newIndex = write;
+      records[write++] = records[i];
+    }
+    records.resize(write);
+    index = newIndex;
+    return true;
+  }
+};
+extern MergeStore CLIPPINGS;
