+struct Rect { int x=0,y=0,width=0,height=0; };
+bool contains(const Rect& r,int x,int y,int pad=0) {
+ return r.width>0&&r.height>0&&x>=r.x-pad&&x<r.x+r.width+pad&&y>=r.y-pad&&y<r.y+r.height+pad;
+}
+struct Input {
+ enum class Button { Back };
+ int x=0,y=0;bool down=false,held=false,tap=false,back=false;unsigned long duration=0;
+ bool isScreenTouchHeld(int& a,int& b) const {a=x;b=y;return held;}
+ bool wasScreenTouchDown(int& a,int& b) const {a=x;b=y;return down;}
+ bool wasScreenTapped(int& a,int& b) const {a=x;b=y;return tap;}
+ bool isScreenTouchTapCandidate(int& a,int& b,unsigned long& d) const {a=x;b=y;d=duration;return held;}
+ bool wasReleased(Button) const {return back;}
+};
+using MappedInputManager=Input;
+struct RenderLock {
+ static inline bool busy=false;
+ template<class T> explicit RenderLock(T&) {}
+ static bool peek() {return busy;}
+};
+struct HighlightPageAction {bool editor;uint16_t clippingIndex;int x,y;int pageOffset=0;bool adjusted=false;};
+enum class ClippingColor { LightGrey, DarkGrey, Solid };
+struct Store {
+ ClippingColor color=ClippingColor::LightGrey;
+ bool setColor(size_t,ClippingColor next) {if(ok)color=next;return ok;}
+ unsigned writes=0,deletes=0;bool ok=true;std::string text;
+ bool removeClippingAt(size_t) {++deletes;return ok;}
+ bool updateClippingText(size_t,const std::string& value) {++writes;if(ok)text=value;return ok;}
+} CLIPPINGS;
+namespace HighlightMerge {
+inline bool save(const std::shared_ptr<Epub>&, uint16_t, size_t& index, XPathTextLocation&, const std::string& text) {
+ return CLIPPINGS.updateClippingText(index,text);
+}
+}
+namespace workflowy {inline bool shared=false; inline void shareClippings(size_t){shared=true;}}
+struct ActivityResult {};
+struct WorkflowyShareActivity {
+  template <typename... Args>
+  explicit WorkflowyShareActivity(Args&&...) {}
+};
+class OnPageHighlightActivity {
+ public:
+ struct Word {Rect rect;uint32_t start,end;bool rtl=false;};
+ std::shared_ptr<Epub> book=std::make_shared<Epub>(std::vector<std::string>{"<html><body><p>before alpha bravo after tail</p></body></html>"});
+ Word words[5]={{{0,0,40,20},0,5},{{50,0,40,20},6,10},{{100,0,40,20},11,15},{{150,0,40,20},16,20},{{200,0,40,20},21,24}};
+ size_t wordCount=5,index=3;uint16_t spine=0;
+ XPathTextLocation original{6,15,25,false};
+ OnPageHighlightRange range{6,15},saved{6,15};
+ Rect firstHandle{40,0,20,20},lastHandle{130,0,20,20};
+ HighlightToolbar::Layout toolbar=HighlightToolbar::Layout::place(80,100,480);
+ bool ready=true,failed=false,releasePending=false,ignoreOpeningRelease=false,finished=false,closeAfterAdjustment=false;
+ int activeEdge=-1,updates=0;
+ int pageOffset=0;HighlightDragPaging dragPaging;
+ std::atomic<bool> waitForPageMotion{false};std::atomic<int>firstTextY{0},lastTextBottom{100};
+ int turnAttempts=0,lastTurnDirection=0;
+ bool turnPage(int direction) {++turnAttempts;lastTurnDirection=direction;return false;}
+ struct Renderer {int getScreenHeight() const{return 800;}} renderer;
+ int firstAnchorY=10,lastAnchorY=10,dragOffsetY=0,dragOffsetX=0;
+ std::atomic<bool> dragging{false};std::atomic<int> dragX{0},dragY{0};
+ Input mappedInput;
+ bool shareOpened=false,dragFrameReady=false;
+ template <typename Child, typename Handler>
+ void startActivityForResult(std::unique_ptr<Child>, Handler) {shareOpened=true;}
+ HighlightPageAction action{};
+ void requestUpdate() {++updates;}
+ void finish() {finished=true;}
+ void setResult(HighlightPageAction a) {action=a;}
+ void returnAction(bool,int=0,int=0);
+ void updateDrag();void saveRange();void loop();
+};
+#include "OnPageActions.inc"
+int main() {
+ const auto future=HighlightToolbar::Layout::place(20,30,136,5);
+ assert(future.columns==2 && future.area.width==136 && future.area.height==174);
+ for(size_t i=0;i<5;++i) { const auto b=future.button(i); assert(future.indexAt(b.x+28,b.y+24)==i); }
+ assert(!future.indexAt(110,170)); // empty final grid cell
+ assert(!HighlightToolbar::Layout{}.indexAt(0,0));
+
+ const HighlightToolbar::Bounds view{16,24,448,752};
+ const auto top=HighlightToolbar::nearSelection({400,30,60,20},view,{},{});
+ assert(top.area.y>=50 && top.area.x+top.area.width<=464);
+ const auto bottom=HighlightToolbar::nearSelection({20,740,100,20},view,{},{});
+ assert(bottom.area.y+bottom.area.height<740 && bottom.area.y>=24);
+ for(int y:{24,50,350,740,760}) for(int x:{16,200,450}) {
+   auto card=HighlightToolbar::nearSelection({x,y,80,20},view,{},{}).area;
+   assert(card.x>=view.x && card.y>=view.y && card.x+card.width<=view.x+view.width && card.y+card.height<=view.y+view.height);
+ }
+ const auto full=HighlightToolbar::nearSelection(view,view,{},{}).area;
+ assert(full.x>=view.x && full.y>=view.y && full.x+full.width<=464 && full.y+full.height<=776);
+ const auto centered=HighlightToolbar::nearSelection({100,350,200,20},view,{90,330,20,20},{290,370,20,20});
+ assert(centered.area.x==16 && centered.area.y==268);
+ const auto shortCard=HighlightToolbar::nearSelection({100,350,40,20},view,{90,330,20,20},{130,370,20,20});
+ assert(shortCard.area.x==16 && shortCard.area.y+shortCard.area.height==326);
+ OnPageHighlightActivity sharing;
+ const auto shareButton=sharing.toolbar.button(5);
+ sharing.mappedInput={shareButton.x+20,shareButton.y+20,false,false,true,false,0};
+ sharing.loop();
+ assert(workflowy::shared);
+ // Adjacent pieces share a pixel boundary: grabbing/releasing the end
+ // handle must not extend the saved selection into the next piece.
+ OnPageHighlightActivity touching;
+ touching.words[0].rect={0,0,40,20};touching.words[1].rect={40,0,40,20};
+ touching.range=touching.saved={0,5};touching.firstHandle={};touching.lastHandle={30,20,20,20};
+ const auto writesAtTouch=CLIPPINGS.writes;
+ touching.mappedInput={40,30,true,true,false,false,0};touching.loop();
+ assert(touching.activeEdge==1 && touching.dragOffsetX==-1);
+ touching.mappedInput.held=false;touching.mappedInput.down=false;touching.loop();
+ assert(touching.range.end==5 && CLIPPINGS.writes==writesAtTouch);
+ // The real held-touch loop starts edge dwell while the panel is busy,
+ // then performs one bounded attempt when the render lock becomes available.
+ for(int direction:{-1,1}) {
+   OnPageHighlightActivity paging;paging.dragging=true;paging.activeEdge=1;
+   paging.dragPaging.begin(100,200);
+   paging.mappedInput={100,direction>0?780:20,false,true,false,false,0};
+   nowMs=10;RenderLock::busy=true;paging.loop();
