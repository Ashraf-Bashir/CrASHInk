+void EpubReaderClippingListActivity::rebuildGroups() {
+  if (!book && !bookPath.empty() && !metadataBook) {
+    metadataBook = makeUniqueNoThrow<Epub>(bookPath, "/.crosspoint");
+    if (metadataBook) {
+      metadataBook->setupCacheDir();
+      if (metadataBook->load(false, true, Epub::XLocationLoadMode::Skip, true))
+        book = metadataBook.get();
+      else
+        LOG_ERR("CLIP", "Chapter metadata unavailable; grouping by spine");
+    } else
+      LOG_ERR("CLIP", "Cannot allocate clipping chapter metadata");
+  }
+  const std::string expectedPath = book ? book->getPath() : bookPath;
+  if (!expectedPath.empty() && !CLIPPINGS.isLoadedFor(expectedPath)) {
+    CLIPPINGS.loadForBook(expectedPath, book ? book->getTitle() : "", book ? book->getAuthor() : "", "epub");
+  }
+  std::vector<HighlightChapterGroups::Entry> entries;
+  entries.reserve(CLIPPINGS.clippingCount());
+  const size_t estimatedGroups = book ? static_cast<size_t>(book->getTocItemsCount() + book->getSpineItemsCount())
+                                     : CLIPPINGS.clippingCount();
+  chapterLabels.labels.reserve(std::max(chapterLabels.labels.size(), std::min(CLIPPINGS.clippingCount(), estimatedGroups)));
+  FsFile reader;
+  CLIPPINGS.openTextReader(reader);
+  int lastSpine = -1;
+  int logicalSpine = -1;
+  int chapterToc = -1;
+  std::string fallbackTitle;
+  std::string savedTitle;
+  savedTitle.reserve(CLIPPING_CHAPTER_TITLE_MAX);
+  for (size_t i = 0; i < CLIPPINGS.clippingCount(); ++i) {
+    const Clipping* clipping = CLIPPINGS.clippingAt(i);
+    if (!clipping || (colorFilter != 0 && static_cast<int>(clipping->color) + 1 != colorFilter)) continue;
+    if (lastSpine != clipping->spineIndex) {
+      lastSpine = clipping->spineIndex;
+      logicalSpine = lastSpine;
+      int lastPart = lastSpine;
+      if (book) book->resolveChapterGroupRange(lastSpine, logicalSpine, lastPart);
+      chapterToc = book ? book->getTocIndexForSpineIndex(logicalSpine) : -1;
+      fallbackTitle = chapterToc >= 0 ? book->getTocItem(chapterToc).title : tr(STR_UNKNOWN_CHAPTER);
+    }
+    if (!CLIPPINGS.readChapterTitle(i, savedTitle, reader) || savedTitle.empty()) savedTitle = fallbackTitle;
+    const uint32_t chapter = chapterLabels.keyFor(static_cast<uint16_t>(logicalSpine), savedTitle, chapterToc);
+    entries.push_back({chapter, static_cast<uint16_t>(i)});
+  }
+  filteredCount = entries.size();
+  chapterGroups.build(std::move(entries));
+  groupsRevision = CLIPPINGS.contentRevision();
+}
+
+std::string EpubReaderClippingListActivity::groupTitle(size_t index) const {
+  const char* title = chapterLabels.title(chapterGroups.groups[index].chapter);
+  return *title ? title : tr(STR_UNKNOWN_CHAPTER);
+}
