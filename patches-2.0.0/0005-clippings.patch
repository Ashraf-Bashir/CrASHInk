diff --git a/src/activities/reader/HighlightChapterGroups.h b/src/activities/reader/HighlightChapterGroups.h
new file mode 100644
index 0000000000000000000000000000000000000000..5befea651a8de85a3b2928f9b26be09e42415506
--- /dev/null
+++ b/src/activities/reader/HighlightChapterGroups.h
@@ -0,0 +1,63 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+class HighlightChapterGroups {
+ public:
+  struct Entry {
+    uint32_t chapter;
+    uint16_t clipping;
+  };
+  struct Group {
+    uint32_t chapter;
+    uint32_t begin;
+    uint32_t count;
+    bool open = false;
+  };
+  std::vector<Entry> entries;
+  std::vector<Group> groups;
+  // Negative values identify headers; nonnegative values are ORIGINAL clipping indexes.
+  std::vector<int32_t> rows;
+  void build(std::vector<Entry> values) {
+    std::vector<uint32_t> opened;
+    opened.reserve(groups.size());
+    for (const auto& group : groups)
+      if (group.open) opened.push_back(group.chapter);
+    entries = std::move(values);
+    const auto groupOrder = [](const Entry& a, const Entry& b) {
+      return a.chapter != b.chapter ? a.chapter < b.chapter : a.clipping < b.clipping;
+    };
+    if (!std::is_sorted(entries.begin(), entries.end(), groupOrder))
+      std::sort(entries.begin(), entries.end(), groupOrder);
+    size_t count = 0;
+    for (size_t i = 0; i < entries.size(); ++i)
+      if (i == 0 || entries[i].chapter != entries[i - 1].chapter) ++count;
+    groups.clear();
+    groups.reserve(count);
+    for (size_t i = 0; i < entries.size(); ++i) {
+      if (groups.empty() || groups.back().chapter != entries[i].chapter)
+        groups.push_back({entries[i].chapter, static_cast<uint32_t>(i), 0,
+                          std::find(opened.begin(), opened.end(), entries[i].chapter) != opened.end()});
+      ++groups.back().count;
+    }
+    rows.reserve(entries.size() + groups.size());
+    rebuild();
+  }
+  void rebuild() {
+    rows.clear();
+    for (size_t i = 0; i < groups.size(); ++i) {
+      rows.push_back(-static_cast<int32_t>(i) - 1);
+      if (groups[i].open)
+        for (size_t j = groups[i].begin; j < groups[i].begin + groups[i].count; ++j)
+          rows.push_back(entries[j].clipping);
+    }
+  }
+  bool header(int row) const { return row >= 0 && row < static_cast<int>(rows.size()) && rows[row] < 0; }
+  void toggle(int row) {
+    if (!header(row)) return;
+    const size_t group = static_cast<size_t>(-rows[row] - 1);
+    groups[group].open = !groups[group].open;
+    rebuild();
+  }
+};
diff --git a/src/activities/reader/HighlightChapterLabels.h b/src/activities/reader/HighlightChapterLabels.h
new file mode 100644
index 0000000000000000000000000000000000000000..67227267cbae57c5de3771ac241b53f5beef7736
--- /dev/null
+++ b/src/activities/reader/HighlightChapterLabels.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Neither a title nor a TOC entry alone identifies a chapter. Match both when
+// merging EPUB parts; without TOC metadata, retain the logical spine identity.
+// Stable keys preserve expanded groups through rebuilds and deletes.
+class HighlightChapterLabels {
+ public:
+  struct Label { uint32_t key; uint16_t spine; std::string title; int toc = -1; };
+  std::vector<Label> labels;
+  static std::string normalizedTitle(const std::string& text) {
+    std::string result;
+    result.reserve(text.size());
+    bool pendingSpace = false;
+    for (size_t i = 0; i < text.size();) {
+      const auto c = static_cast<unsigned char>(text[i]);
+      size_t space = (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\f' || c == '\v') ? 1 : 0;
+      if (i + 1 < text.size() && c == 0xC2 && static_cast<unsigned char>(text[i + 1]) == 0xA0) space = 2;
+      if (i + 2 < text.size() && c == 0xE2 && static_cast<unsigned char>(text[i + 1]) == 0x80) {
+        const auto last = static_cast<unsigned char>(text[i + 2]);
+        if ((last >= 0x80 && last <= 0x8A) || last == 0xA8 || last == 0xA9 || last == 0xAF) space = 3;
+        if (last == 0x8B || last == 0x8E || last == 0x8F) { i += 3; continue; }
+      }
+      if (space) { pendingSpace = !result.empty(); i += space; continue; }
+      if (pendingSpace) { result += ' '; pendingSpace = false; }
+      result += text[i++];
+    }
+    return result;
+  }
+  uint32_t keyFor(uint16_t spine, const std::string& title, int toc = -1) {
+    const std::string normalized = normalizedTitle(title);
+    uint32_t count = 0;
+    for (const auto& label : labels) {
+      if (label.title == normalized &&
+          (label.spine == spine || (toc >= 0 && label.toc == toc && !normalized.empty()))) return label.key;
+      if (label.spine == spine) ++count;
+    }
+    const uint32_t key = (static_cast<uint32_t>(spine) << 16) | count;
+    labels.push_back({key, spine, normalized, toc});
+    return key;
+  }
+  const char* title(uint32_t key) const {
+    for (const auto& label : labels) if (label.key == key) return label.title.c_str();
+    return "";
+  }
+};
diff --git a/src/activities/reader/HighlightDragPaging.h b/src/activities/reader/HighlightDragPaging.h
new file mode 100644
index 0000000000000000000000000000000000000000..c39babc9fef8c5efdf469b6ca9ae3d8ad21c0ab2
--- /dev/null
+++ b/src/activities/reader/HighlightDragPaging.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <cstdint>
+
+// Main-loop-only dwell state. One page per deliberate edge approach; after a
+// turn, wait for fresh movement so a stationary finger cannot skip text.
+struct HighlightDragPaging {
+  int x = 0, y = 0, direction = 0;
+  uint32_t entered = 0;
+  bool moved = false, waiting = false;
+  void begin(int px, int py) {
+    x = px;
+    y = py;
+    direction = 0;
+    entered = 0;
+    moved = false;
+    waiting = false;
+  }
+  void turned(int px, int py) {
+    begin(px, py);
+    waiting = true;
+  }
+  int track(int px, int py, int textTop, int textBottom, int screenHeight, uint32_t now) {
+    const bool motion = px != x || py != y;
+    x = px;
+    y = py;
+    if (waiting && !motion) return 0;
+    if (motion) {
+      moved = true;
+      waiting = false;
+    }
+    if (!moved) return 0;
+    const int target = py < 48 || py < textTop - 8 ? -1 : py >= screenHeight - 48 || py > textBottom + 8 ? 1 : 0;
+    if (target != direction) {
+      direction = target;
+      entered = now;
+      return 0;
+    }
+    return target && static_cast<uint32_t>(now - entered) >= 200 ? target : 0;
+  }
+};
diff --git a/src/activities/reader/HighlightEditActivity.cpp b/src/activities/reader/HighlightEditActivity.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..01464c836ce33b553ec56865b26d96604cd526d4
--- /dev/null
+++ b/src/activities/reader/HighlightEditActivity.cpp
@@ -0,0 +1,391 @@
+#include "clippings/HighlightMerge.h"
+#include "HighlightEditActivity.h"
+
+#include <I18n.h>
+#include <Logging.h>
+
+#include <algorithm>
+#include <climits>
+#include <cstdio>
+
+#include "ChapterXPathResolver.h"
+#include "ClippingStore.h"
+#include "WorkflowyShareActivity.h"
+#include "clippings/HighlightNeighbourWord.h"
+#include "components/TouchHeaderBackButton.h"
+#include "components/UITheme.h"
+#include "fontIds.h"
+
+namespace {
+// KOReader's boundary controls use the symbols ◁▒▒, ▷☓▒, ▒☓◁, ▒▒▷.
+// Draw the same outline arrows, crossed-out word and shaded word blocks
+// directly: the UI font need not contain these Unicode glyphs.
+void drawBoundaryIcon(const GfxRenderer& renderer, const Rect& rect, const int action) {
+  constexpr int cell = 14;
+  constexpr int gap = 3;
+  constexpr int height = 18;
+  const int left = rect.x + (rect.width - (3 * cell + 2 * gap)) / 2;
+  const int top = rect.y + (rect.height - height) / 2;
+  for (int slot = 0; slot < 3; ++slot) {
+    const int x = left + slot * (cell + gap);
+    const bool arrow = (action < 2 && slot == 0) || (action >= 2 && slot == 2);
+    const bool removed = (action == 1 || action == 2) && slot == 1;
+    if (arrow) {
+      const bool pointsLeft = action == 0 || action == 2;
+      const int tip = pointsLeft ? x + 1 : x + cell - 2;
+      const int base = pointsLeft ? x + cell - 2 : x + 1;
+      renderer.drawLine(tip, top + height / 2, base, top + 1, 2, true);
+      renderer.drawLine(base, top + 1, base, top + height - 2, 2, true);
+      renderer.drawLine(base, top + height - 2, tip, top + height / 2, 2, true);
+    } else if (removed) {
+      renderer.drawLine(x + 2, top + 2, x + cell - 3, top + height - 3, 2, true);
+      renderer.drawLine(x + cell - 3, top + 2, x + 2, top + height - 3, 2, true);
+    } else {
+      for (int y = 0; y < height; y += 2) {
+        for (int dx = (y / 2) % 2; dx < cell; dx += 2) renderer.fillRect(x + dx, top + y, 1, 1, true);
+      }
+    }
+  }
+}
+
+// One bounded preview line at a time, without a second copy of the full draft.
+std::string nextLine(const GfxRenderer& renderer, const std::string& text, size_t& offset, int width) {
+  while (offset < text.size() && text[offset] == ' ') ++offset;
+  const size_t start = offset;
+  size_t lastSpace = std::string::npos;
+  std::string line;
+  line.reserve(128);
+  while (offset < text.size()) {
+    const unsigned char ch = text[offset];
+    size_t bytes = ch < 0x80 ? 1 : ch < 0xE0 ? 2 : ch < 0xF0 ? 3 : ch <= 0xF4 ? 4 : 1;
+    if (offset + bytes > text.size()) bytes = 1;
+    line.append(text, offset, bytes);
+    if (renderer.getTextWidth(UI_10_FONT_ID, line.c_str()) > width && offset > start) {
+      if (lastSpace != std::string::npos) offset = lastSpace;
+      line = text.substr(start, offset - start);
+      break;
+    }
+    if (ch == ' ') lastSpace = offset;
+    offset += bytes;
+  }
+  return line;
+}
+}  // namespace
+
+HighlightEditActivity::HighlightEditActivity(GfxRenderer& renderer, MappedInputManager& input,
+                                             std::shared_ptr<Epub> book, size_t index, float positionHint)
+    : Activity("HighlightEdit", renderer, input), book(std::move(book)), index(index), hint(positionHint) {}
+
+void HighlightEditActivity::onEnter() {
+  Activity::onEnter();
+  const Clipping* clipping = CLIPPINGS.clippingAt(index);
+  if (clipping && CLIPPINGS.readClippingText(index, draft)) {
+    spine = clipping->spineIndex;
+    tableSelection = clipping->tableSelection != UINT16_MAX;
+    std::string normalized;
+    // Strict matching preserves the actual words; never edit a fuzzy guess.
+    editable = ChapterXPathResolver::locateText(book, spine, draft, hint, location) && !location.loose &&
+               ChapterXPathResolver::extractText(book, spine, location, normalized) && !normalized.empty();
+    if (editable) {
+      draft = std::move(normalized);
+      hint = location.total ? static_cast<float>(location.start) / location.total : hint;
+    }
+  }
+  originalDraft.reset(draft);
+  changed = false;
+  refreshContext();
+  failed = !editable;
+  requestUpdate();
+}
+
+void HighlightEditActivity::refreshContext() {
+  if (!editable) return;
+  // Keep nearby whole words for repeated adjustments. Refill only an exhausted
+  // side; never relocate the quote after each click (repeated quotes can drift).
+  for (const bool before : {true, false}) {
+    auto& text = before ? beforeContext : afterContext;
+    if (!text.empty() || (before ? location.start == 0 : location.end + 1 >= location.total)) continue;
+    for (uint32_t budget = 256; budget <= CLIPPING_TEXT_MAX; budget *= 2) {
+      auto context = location;
+      context.start = before ? (location.start > budget ? location.start - budget : 0) : location.end + 1;
+      context.end = before ? location.start - 1 : std::min(location.total - 1, context.start + budget - 1);
+      if (!ChapterXPathResolver::extractText(book, spine, context, text)) break;
+      const bool edge = before ? context.start == 0 : context.end + 1 == location.total;
+      const auto split = before ? text.find(' ') : text.rfind(' ');
+      if (edge) break;
+      if (split != std::string::npos) {
+        if (before)
+          text.erase(0, split + 1);
+        else
+          text.erase(split);
+        break;
+      }
+      text.clear();
+    }
+  }
+}
+
+Rect HighlightEditActivity::buttonRect(int button) const {
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  constexpr int gap = 6;
+  constexpr int height = 44;
+  const int row = button < 4 ? 0 : 1;
+  const int cols = row == 0 ? 4 : 3;
+  const int col = row == 0 ? button : button - 4;
+  const int width = (safe.width - gap * (cols + 1)) / cols;
+  return Rect{safe.x + gap + col * (width + gap), safe.y + safe.height - (2 - row) * (height + gap), width, height};
+}
+
+Rect HighlightEditActivity::closeRect() const {
+  const Rect header = TouchHeaderBackButton::compactHeaderRect(renderer);
+  return Rect{header.x + header.width - 48, header.y, 48, 48};
+}
+
+void HighlightEditActivity::adjust(HighlightWordEdit::Action action) {
+  // The panel refresh may take hundreds of ms. Let the main task keep accepting
+  // clicks while the render task displays; preserve their order in a bounded FIFO.
+  const unsigned write = actionWrite.load(std::memory_order_relaxed);
+  if (write - actionRead.load(std::memory_order_acquire) >= queuedActions.size()) return;
+  queuedActions[write % queuedActions.size()] = action;
+  actionWrite.store(write + 1, std::memory_order_release);
+  requestUpdate();
+}
+
+void HighlightEditActivity::applyQueuedActions() {
+  unsigned read = actionRead.load(std::memory_order_relaxed);
+  const unsigned write = actionWrite.load(std::memory_order_acquire);
+  while (read != write) {
+    applyAdjustment(queuedActions[read % queuedActions.size()]);
+    actionRead.store(++read, std::memory_order_release);
+  }
+}
+
+void HighlightEditActivity::applyAdjustment(HighlightWordEdit::Action action) {
+  failed = false;
+  if (!editable) {
+    failed = true;
+    return;
+  }
+  const bool start = action == HighlightWordEdit::Action::ExtendStart || action == HighlightWordEdit::Action::TrimStart;
+  const bool extending =
+      action == HighlightWordEdit::Action::ExtendStart || action == HighlightWordEdit::Action::ExtendEnd;
+  std::string neighbour;
+  auto& context = start ? beforeContext : afterContext;
+  if (extending) {
+    if (tableSelection) {
+      failed = true;
+      return;
+    }
+    refreshContext();
+    if (context.empty()) {
+      failed = true;
+      return;
+    }
+    const auto split = start ? context.rfind(' ') : context.find(' ');
+    neighbour = start ? context.substr(split == std::string::npos ? 0 : split + 1) : context.substr(0, split);
+  }
+  std::string replacement;
+  if (!HighlightWordEdit::adjust(draft, action, neighbour, CLIPPING_TEXT_MAX, replacement)) {
+    failed = true;
+    return;
+  }
+  std::string removed;
+  if (extending) {
+    if (start)
+      context.erase(context.size() - neighbour.size());
+    else
+      context.erase(0, neighbour.size());
+    if (!context.empty() && context.front() == ' ') context.erase(0, 1);
+    if (!context.empty() && context.back() == ' ') context.pop_back();
+  } else {
+    removed = start ? draft.substr(0, draft.find(' ')) : draft.substr(draft.rfind(' ') + 1);
+    if (start) {
+      if (!context.empty()) context += ' ';
+      context += removed;
+    } else
+      context = removed + (context.empty() ? "" : " ") + context;
+    // Bound nearby context growth after a long sequence of trims.
+    if (context.size() > 4096) {
+      const auto split = start ? context.find(' ', context.size() - 2048) : context.rfind(' ', 2048);
+      if (split != std::string::npos) {
+        if (start)
+          context.erase(0, split + 1);
+        else
+          context.erase(split);
+      }
+    }
+  }
+  const uint32_t count = ChapterXPathResolver::strictTextLength(extending ? neighbour : removed);
+  if (start)
+    location.start = extending ? location.start - count : location.start + count;
+  else
+    location.end = extending ? location.end + count : location.end - count;
+  draft = std::move(replacement);
+  changed = originalDraft.changed(draft);
+  hint = location.total ? static_cast<float>(location.start) / location.total : hint;
+  previewPage = start ? 0 : INT_MAX;
+}
+
+void HighlightEditActivity::cancel() {
+  ActivityResult result;
+  result.isCancelled = true;
+  setResult(std::move(result));
+  finish();
+}
+
+void HighlightEditActivity::accept() {
+  RenderLock lock(*this);
+  applyQueuedActions();
+  if (!changed) return;
+  if (HighlightMerge::save(book, spine, index, location, draft)) {
+    finish();
+  } else {
+    LOG_ERR("CLIP", "Failed to save edited clipping %u", static_cast<unsigned>(index));
+    failed = true;
+    requestUpdate();
+  }
+}
+
+void HighlightEditActivity::openSavedClipping() {
+  RenderLock lock(*this);
+  const Clipping* clipping = CLIPPINGS.clippingAt(index);
+  if (!clipping) return;
+  // Open navigates to the saved range; Save is the action that commits edits.
+  setResult(ClippingJumpResult{clipping->spineIndex, clipping->startPage, clipping->pageCount, clipping->paragraphIndex,
+                               static_cast<uint16_t>(index)});
+  finish();
+}
+
+Rect HighlightEditActivity::shareRect() const {
+  const auto close = closeRect();
+  return Rect{close.x - 124, close.y, 116, close.height};
+}
+
+void HighlightEditActivity::loop() {
+  if (mappedInput.wasTapInRect(closeRect().x, closeRect().y, closeRect().width, closeRect().height) ||
+      mappedInput.wasReleased(MappedInputManager::Button::Back)) {
+    cancel();
+    return;
+  }
+  const auto share = shareRect();
+  if (mappedInput.wasTapInRect(share.x, share.y, share.width, share.height) && CLIPPINGS.clippingAt(index)) {
+    startActivityForResult(std::make_unique<WorkflowyShareActivity>(renderer, mappedInput, index),
+                           [](const ActivityResult&) {});
+    return;
+  }
+  if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
+    accept();
+    return;
+  }
+  const auto swipe = mappedInput.wasSwipe();
+  if (swipe == MappedInputManager::SwipeDir::Up || swipe == MappedInputManager::SwipeDir::Down) {
+    RenderLock lock(*this);
+    if (swipe == MappedInputManager::SwipeDir::Up && previewPage < previewPages - 1) {
+      ++previewPage;
+      requestUpdate();
+    } else if (swipe == MappedInputManager::SwipeDir::Down && previewPage > 0) {
+      --previewPage;
+      requestUpdate();
+    }
+    return;
+  }
+  for (int i = 0; i < 7; ++i) {
+    const Rect rect = buttonRect(i);
+    if (!mappedInput.wasTapInRect(rect.x, rect.y, rect.width, rect.height)) continue;
+    if (i < 4) {
+      static constexpr HighlightWordEdit::Action actions[] = {
+          HighlightWordEdit::Action::ExtendStart, HighlightWordEdit::Action::TrimStart,
+          HighlightWordEdit::Action::TrimEnd, HighlightWordEdit::Action::ExtendEnd};
+      adjust(actions[i]);
+    } else if (i == 6) {
+      accept();
+    } else if (i == 5) {
+      openSavedClipping();
+    } else if (i == 4) {
+      RenderLock lock(*this);
+      if (CLIPPINGS.removeClippingAt(index))
+        finish();
+      else {
+        failed = true;
+        requestUpdate();
+      }
+    } else {
+      cancel();
+    }
+    return;
+  }
+}
+
+void HighlightEditActivity::render(RenderLock&&) {
+  applyQueuedActions();
+  refreshContext();
+  renderer.clearScreen();
+  const Rect title = TouchHeaderBackButton::compactHeaderRect(renderer);
+  renderer.drawText(UI_10_FONT_ID, title.x + 12, title.y + 12, tr(STR_EDIT_HIGHLIGHT));
+  const Rect close = closeRect();
+  const auto share = shareRect();
+  renderer.drawText(UI_10_FONT_ID, share.x + 8, share.y + 12, "Workflowy");
+  renderer.drawLine(close.x + 14, close.y + 14, close.x + close.width - 14, close.y + close.height - 14, 2, true);
+  renderer.drawLine(close.x + close.width - 14, close.y + 14, close.x + 14, close.y + close.height - 14, 2, true);
+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  const Rect header = TouchHeaderBackButton::headerRect(renderer, mappedInput);
+  const int contextTop = header.y + header.height + 8;
+  const int width = std::max(1, safe.width - 24);
+  const int lineStep = renderer.getLineHeight(UI_10_FONT_ID) + 4;
+  const int top = contextTop + lineStep + 4;
+  const int rows = std::max(1, (buttonRect(0).y - top - lineStep - 44) / std::max(1, lineStep));
+  size_t offset = 0;
+  int lines = 0;
+  while (offset < draft.size()) {
+    nextLine(renderer, draft, offset, width);
+    ++lines;
+  }
+  previewPages = std::max(1, (lines + rows - 1) / rows);
+  previewPage = std::min(previewPage, previewPages - 1);
+  offset = 0;
+  for (int line = 0; line < (previewPage + 1) * rows && offset < draft.size(); ++line) {
+    const std::string text = nextLine(renderer, draft, offset, width);
+    if (line >= previewPage * rows) {
+      const int y = top + (line % rows) * lineStep;
+      renderer.fillRect(safe.x + 10, y, width + 4, lineStep, true);
+      renderer.drawText(UI_10_FONT_ID, safe.x + 12, y, text.c_str(), false);
+    }
+  }
+  if (previewPage == 0 && !beforeContext.empty()) {
+    size_t start = 0;
+    while (start < beforeContext.size() &&
+           renderer.getTextWidth(UI_10_FONT_ID, beforeContext.c_str() + start) > width - 24) {
+      ++start;
+      while (start < beforeContext.size() && (static_cast<unsigned char>(beforeContext[start]) & 0xC0) == 0x80) ++start;
+    }
+    const std::string before = "... " + beforeContext.substr(start);
+    renderer.drawText(UI_10_FONT_ID, safe.x + 12, contextTop, before.c_str());
+  }
+  if (previewPage == previewPages - 1 && !afterContext.empty()) {
+    const std::string after = renderer.truncatedText(UI_10_FONT_ID, afterContext.c_str(), width);
+    renderer.drawText(UI_10_FONT_ID, safe.x + 12, top + std::min(rows, lines - previewPage * rows) * lineStep + 4,
+                      after.c_str());
+  }
+  char page[24];
+  snprintf(page, sizeof(page), "%d/%d", previewPage + 1, previewPages);
+  renderer.drawText(SMALL_FONT_ID, safe.x + 12, buttonRect(0).y - 30,
+                    failed ? tr(STR_HIGHLIGHT_EDIT_UNAVAILABLE) : page);
+  const char* labels[] = {tr(STR_DELETE), tr(STR_OPEN), tr(STR_SAVE)};
+  for (int i = 0; i < 7; ++i) {
+    const Rect rect = buttonRect(i);
+    renderer.drawRect(rect.x, rect.y, rect.width, rect.height, true);
+    if (i < 4) {
+      drawBoundaryIcon(renderer, rect, i);
+      continue;
+    }
+    const std::string label = renderer.truncatedText(UI_10_FONT_ID, labels[i - 4], rect.width - 8);
+    renderer.drawText(UI_10_FONT_ID, rect.x + (rect.width - renderer.getTextWidth(UI_10_FONT_ID, label.c_str())) / 2,
+                      rect.y + (rect.height - renderer.getLineHeight(UI_10_FONT_ID)) / 2, label.c_str());
+    if (i == 6 && !changed) {
+      // Dim the label and frame without an extra framebuffer or gray refresh.
+      for (int y = rect.y; y < rect.y + rect.height; ++y)
+        for (int x = rect.x + ((y - rect.y) & 1); x < rect.x + rect.width; x += 2) renderer.drawPixel(x, y, false);
+    }
+  }
+  renderer.displayBuffer();
+}
diff --git a/src/activities/reader/HighlightEditActivity.h b/src/activities/reader/HighlightEditActivity.h
new file mode 100644
index 0000000000000000000000000000000000000000..00e0828ad1b1ecc44c980308242a944215c81f2d
--- /dev/null
+++ b/src/activities/reader/HighlightEditActivity.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <Epub.h>
+
+#include <array>
+#include <atomic>
+#include <memory>
+#include <string>
+
+#include "ChapterXPathResolver.h"
+#include "activities/Activity.h"
+#include "clippings/HighlightDraftState.h"
+#include "clippings/HighlightWordEdit.h"
+#include "components/UITheme.h"
+
+// A temporary draft owns only the selected text and one replacement buffer,
+// bounded by CLIPPING_TEXT_MAX. The chapter is streamed rather than retained.
+class HighlightEditActivity final : public Activity {
+ public:
+  HighlightEditActivity(GfxRenderer& renderer, MappedInputManager& input, std::shared_ptr<Epub> book, size_t index,
+                        float positionHint);
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
+  std::shared_ptr<Epub> book;
+  size_t index;
+  uint16_t spine = 0;
+  float hint;
+  std::string draft;
+  std::string beforeContext;
+  std::string afterContext;
+  bool editable = false;
+  bool tableSelection = false;
+  HighlightDraftState originalDraft;
+  std::atomic<bool> changed{false};
+  XPathTextLocation location{};
+  std::array<HighlightWordEdit::Action, 32> queuedActions{};
+  std::atomic<unsigned> actionRead{0}, actionWrite{0};
+  bool failed = false;
+  int previewPage = 0;
+  int previewPages = 1;
+  Rect buttonRect(int button) const;
+  Rect closeRect() const;
+  Rect shareRect() const;
+  void adjust(HighlightWordEdit::Action action);
+  void refreshContext();
+  void applyQueuedActions();
+  void applyAdjustment(HighlightWordEdit::Action action);
+  void accept();
+  void openSavedClipping();
+  void cancel();
+};
diff --git a/src/activities/reader/HighlightToolbar.h b/src/activities/reader/HighlightToolbar.h
new file mode 100644
index 0000000000000000000000000000000000000000..b67684eb411dfd833c33d4f54bdd63f00741d137
--- /dev/null
+++ b/src/activities/reader/HighlightToolbar.h
@@ -0,0 +1,83 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <optional>
+
+namespace HighlightToolbar {
+enum class Action { LightGrey, DarkGrey, Solid, Edit, Delete, Share };
+// Add future actions here; layout, drawing iteration and hit testing share it.
+inline constexpr std::array Actions{Action::LightGrey, Action::DarkGrey, Action::Solid, Action::Edit, Action::Delete,
+                                    Action::Share};
+constexpr int CellWidth = 68, CellHeight = 58;
+struct Bounds {
+  int x = 0, y = 0, width = 0, height = 0;
+  bool contains(int px, int py) const {
+    return width > 0 && height > 0 && px >= x && px < x + width && py >= y && py < y + height;
+  }
+};
+struct Layout {
+  Bounds area{};
+  size_t columns = 0, count = 0;
+  static Layout place(int x, int y, int screenWidth, size_t count = Actions.size()) {
+    if (!count) return {};
+    const size_t columns = std::min(count, static_cast<size_t>(std::max(1, screenWidth / CellWidth)));
+    return {
+        {x, y, static_cast<int>(columns) * CellWidth, static_cast<int>((count + columns - 1) / columns) * CellHeight},
+        columns,
+        count};
+  }
+  Bounds button(size_t index) const {
+    if (index >= count || !columns) return {};
+    return {area.x + static_cast<int>(index % columns) * CellWidth,
+            area.y + static_cast<int>(index / columns) * CellHeight, CellWidth, CellHeight};
+  }
+  std::optional<size_t> indexAt(int x, int y) const {
+    if (!columns || !area.contains(x, y)) return std::nullopt;
+    const size_t index = static_cast<size_t>((y - area.y) / CellHeight) * columns + (x - area.x) / CellWidth;
+    return index < count ? std::optional<size_t>{index} : std::nullopt;
+  }
+};
+inline bool overlaps(const Bounds& a, const Bounds& b, int pad = 0) {
+  return a.width > 0 && a.height > 0 && b.width > 0 && b.height > 0 && a.x < b.x + b.width + pad &&
+         a.x + a.width > b.x - pad && a.y < b.y + b.height + pad && a.y + a.height > b.y - pad;
+}
+inline Layout nearSelection(const Bounds& selection, const Bounds& view, const Bounds& first, const Bounds& last) {
+  Layout result = Layout::place(0, 0, view.width);
+  const int width = result.area.width, height = result.area.height;
+  const int right = std::max(view.x, view.x + view.width - width);
+  const int bottom = std::max(view.y, view.y + view.height - height);
+  const int x = std::clamp(selection.x + (selection.width - width) / 2, view.x, right);
+  const int middleY = std::clamp(selection.y + (selection.height - height) / 2, view.y, bottom);
+  const int aboveHandles = std::min(selection.y, first.width > 0 ? first.y : selection.y);
+  const int belowHandles =
+      std::max(selection.y + selection.height, last.width > 0 ? last.y + last.height : selection.y + selection.height);
+  const std::array<std::array<int, 2>, 12> candidates{{{x, selection.y - height - 8},
+                                                       {x, selection.y + selection.height + 8},
+                                                       {x, aboveHandles - height - 4},
+                                                       {x, belowHandles + 4},
+                                                       {x, view.y},
+                                                       {x, bottom},
+                                                       {selection.x + selection.width + 8, middleY},
+                                                       {selection.x - width - 8, middleY},
+                                                       {view.x, view.y},
+                                                       {right, view.y},
+                                                       {view.x, bottom},
+                                                       {right, bottom}}};
+  for (const bool avoidText : {true, false}) {
+    for (const auto& point : candidates) {
+      result.area.x = point[0];
+      result.area.y = point[1];
+      if (result.area.x < view.x || result.area.y < view.y || result.area.x > right || result.area.y > bottom) continue;
+      if (overlaps(result.area, first, 4) || overlaps(result.area, last, 4)) continue;
+      if (avoidText && overlaps(result.area, selection)) continue;
+      return result;
+    }
+  }
+  // A selection covering the entire viewport has no empty outside area.
+  // Keep every toolbar control on screen even in that constrained case.
+  result.area.x = x;
+  result.area.y = std::clamp(selection.y - height - 8, view.y, bottom);
+  return result;
+}
+}  // namespace HighlightToolbar
