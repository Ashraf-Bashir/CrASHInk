+bool ClippingStore::cacheSourceRange(size_t index, uint32_t start, uint32_t end) {
+  if (index >= clippings.size() || loadFailed_) return false;
+  auto& clip = clippings[index];
+  if (clippingHasSourceRange(clip) || clippingSourceRangeBlocked(clip)) return false;
+  if (start == UINT32_MAX && end == 0) {
+    clip.sourceStart = UINT32_MAX; clip.sourceEnd = 0; clip.layoutSignature = 0;
+    dirty = true; return true;
+  }
+  if (start != UINT32_MAX) clip.sourceStart = start;
+  if (end != UINT32_MAX) clip.sourceEnd = end;
+  if (!clippingHasSourceRange(clip)) return false;
+  // Persist with the existing save/unload boundary, never on each redraw.
+  dirty = true;
+  return true;
+}
+bool ClippingStore::clippingTextMatchesEdges(const Clipping& clip, std::string_view prefix, std::string_view suffix, bool& matches) const {
+  std::string text;
+  if (!readClippingText(clip, text)) return false;
+  matches = text.starts_with(prefix) && text.ends_with(suffix);
+  return true;
+}
