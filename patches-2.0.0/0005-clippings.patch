+template <class Paint>
+void paintContinuation(const GapRect& tip, bool left, Paint&& paint) {
+  if (tip.width <= 0 || tip.height <= 0) return;
+  for (int row = 0; row < tip.height; ++row) {
+    const int distance = std::abs(2 * row + 1 - tip.height);
+    const int width = std::max(1, (tip.width * (tip.height - distance) + tip.height - 1) / tip.height);
