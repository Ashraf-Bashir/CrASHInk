diff --git a/src/clippings/HighlightWordEdit.h b/src/clippings/HighlightWordEdit.h
new file mode 100644
index 0000000000000000000000000000000000000000..5eb926a89261354afaa794a331ae40f0661857e8
--- /dev/null
+++ b/src/clippings/HighlightWordEdit.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <cstddef>
+#include <string>
+
+namespace HighlightWordEdit {
+enum class Action { ExtendStart, TrimStart, TrimEnd, ExtendEnd };
+
+// Work in reading order, independently of visual RTL direction. UTF-8 bytes
+// inside a word are never split; EPUB extraction normalizes separators to spaces.
+inline bool adjust(const std::string& text, const Action action, const std::string& neighbour, const size_t maxBytes,
+                   std::string& out) {
+  out.clear();
+  if (text.empty()) return false;
+  if (action == Action::ExtendStart || action == Action::ExtendEnd) {
+    if (neighbour.empty() || text.size() + neighbour.size() + 1 > maxBytes) return false;
+    out = action == Action::ExtendStart ? neighbour + " " + text : text + " " + neighbour;
+    return true;
+  }
+  const size_t split = action == Action::TrimStart ? text.find(' ') : text.rfind(' ');
+  if (split == std::string::npos) return false;  // Keep one word; Delete removes the whole highlight.
+  out = action == Action::TrimStart ? text.substr(split + 1) : text.substr(0, split);
+  return !out.empty();
+}
+}  // namespace HighlightWordEdit
diff --git a/src/clippings/SelectionRibbon.h b/src/clippings/SelectionRibbon.h
new file mode 100644
index 0000000000000000000000000000000000000000..d9a87198d4d394629044467b5d2162949f89a43c
--- /dev/null
+++ b/src/clippings/SelectionRibbon.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include "ClippingHighlightGeometry.h"
+
+namespace SelectionRibbon {
+using ClippingHighlightGeometry::GapRect;
+using ClippingHighlightGeometry::RibbonRows;
+using ClippingHighlightGeometry::WordRect;
+
+template <typename Paint>
+void paintDifference(const GapRect& a, const GapRect& b, const Paint& paint) {
+  if (a.width <= 0 || a.height <= 0) return;
+  const int left = std::max(a.x, b.x), right = std::min(a.x + a.width, b.x + b.width);
+  const int top = std::max(a.y, b.y), bottom = std::min(a.y + a.height, b.y + b.height);
+  if (right <= left || bottom <= top) {
+    paint(a);
+    return;
+  }
+  if (a.y < top) paint(GapRect{a.x, a.y, a.width, top - a.y});
+  if (bottom < a.y + a.height) paint(GapRect{a.x, bottom, a.width, a.y + a.height - bottom});
+  if (a.x < left) paint(GapRect{a.x, top, left - a.x, bottom - top});
+  if (right < a.x + a.width) paint(GapRect{right, top, a.x + a.width - right, bottom - top});
+}
+
+inline GapRect intersection(const GapRect& a, const GapRect& b) {
+  const int x = std::max(a.x, b.x), y = std::max(a.y, b.y);
+  return {x, y, std::max(0, std::min(a.x + a.width, b.x + b.width) - x),
+          std::max(0, std::min(a.y + a.height, b.y + b.height) - y)};
+}
+
+inline void includeWord(WordRect& line, const WordRect& word) {
+  if (word.width <= 0) return;
+  if (line.width == 0) {
+    line = word;
+    return;
+  }
+  const int right = std::max(line.x + line.width, word.x + word.width);
+  line.x = std::min(line.x, word.x);
+  line.width = right - line.x;
+  line.height = std::max(line.height, word.height);
+}
+
+// Use the saved ribbon's outer insets and continuous inter-word fill. Diff the
+// old and new bands so moving an edge does not repaint the unchanged range.
+template <typename RectAt, typename SameRow, typename Selected, typename Paint>
+void paintDelta(int count, const RectAt& rectAt, const SameRow& sameRow, const Selected& selected,
+                bool startsClipping, bool endsClipping, const Paint& paint) {
+  RibbonRows previousRows, nextRows;
+  for (int i = 0; i < count; ++i) {
+    const bool previous = selected(i, true), next = selected(i, false);
+    if (!previous && !next) continue;
+    const auto word = rectAt(i);
+    if (previous) previousRows.include(word.y, word.height);
+    if (next) nextRows.include(word.y, word.height);
+  }
+  GapRect previousOldBand, previousNewBand;
+  for (int first = 0; first < count;) {
+    WordRect previous, next;
+    int i = first;
+    do {
+      const bool wasSelected = selected(i, true), isSelected = selected(i, false);
+      if (wasSelected || isSelected) {
+        const auto word = rectAt(i);
+        if (wasSelected) includeWord(previous, word);
+        if (isSelected) includeWord(next, word);
+      }
+      ++i;
+    } while (i < count && sameRow(i - 1, i));
+    const auto oldBand = ClippingHighlightGeometry::ribbonMarker(previous, previousRows, true, true, startsClipping,
+                                                                endsClipping);
+    const auto newBand = ClippingHighlightGeometry::ribbonMarker(next, nextRows, true, true, startsClipping,
+                                                                endsClipping);
+    paintDifference(oldBand, newBand, paint);
+    paintDifference(newBand, oldBand, paint);
+
+    // Adjacent bands can overlap when the glyph ink is taller than the line
+    // spacing. Toggle their intersection once more to keep the union filled.
+    const auto oldOverlap = intersection(previousOldBand, oldBand);
+    const auto newOverlap = intersection(previousNewBand, newBand);
+    paintDifference(oldOverlap, newOverlap, paint);
+    paintDifference(newOverlap, oldOverlap, paint);
+    if (oldBand.width > 0) previousOldBand = oldBand;
+    if (newBand.width > 0) previousNewBand = newBand;
+    first = i;
+  }
+}
+}  // namespace SelectionRibbon
