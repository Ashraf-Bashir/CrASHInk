+struct Navigator {
+ int current=0,selectCalls=0;
+ int screenX=10,width=40;bool isRtl=false;
+ int heightOr(int height) const {return height;}
+ int getCurrentFlatIndex() const {return current;}
+ int getLastFlatIndex() const {return 1;}
+ bool selectWordAtPoint(int x,int y,int,bool* hit) { ++selectCalls;if(y<0||y>=20){*hit=false;return false;}*hit=true;int old=current;current=x>10?1:0;return old!=current; }
+ int screenY=0;
+ const Navigator* getWordAt(int i) const {return i>=0 && i<2?this:nullptr;}
+};
