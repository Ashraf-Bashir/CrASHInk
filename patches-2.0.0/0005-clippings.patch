+void EpubReaderClippingListActivity::editSelectedClipping() {
+  const Clipping* clipping = CLIPPINGS.clippingAt(selectedClipping);
+  if (!clipping) return;
+  const float hint = clipping->pageCount > 1 ? static_cast<float>(clipping->startPage) / (clipping->pageCount - 1) : 0;
+  // The parent list remains on the activity stack and owns (or borrows from
+  // its reader parent) this Epub until the editor closes. Aliasing an empty
+  // shared_ptr borrows it without allocating another ownership control block.
+  std::shared_ptr<Epub> borrowed(std::shared_ptr<Epub>{}, book);
+  auto editor = makeUniqueNoThrow<HighlightEditActivity>(renderer, mappedInput, std::move(borrowed), selectedClipping, hint);
+  if (!editor) return;
+  startActivityForResult(std::move(editor), [this](const ActivityResult& result) {
+    if (!result.isCancelled) {
+      if (const auto* jump = std::get_if<ClippingJumpResult>(&result.data)) {
+        setResult(*jump);
+        finish();
+        return;
