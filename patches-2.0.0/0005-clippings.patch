+#pragma once
+#include <cstdint>
+#include <string>
+
+#include "ClippingTextMatcher.h"
+
+namespace HighlightMerge {
+inline bool ignoredPosition(uint32_t cp) {
+  return cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r' || cp == '\f' || cp == 0xA0 || cp == 0xAD ||
+         (cp >= 0x2000 && cp <= 0x200B) || cp == 0x202F || cp == 0x205F || cp == 0x3000 || cp == 0xFEFF;
+}
+// Coordinates match ChapterXPathResolver's strict character positions. Require
+// a complete word core, not merely a shared punctuation mark or a word suffix.
+inline bool sharesWord(const std::string& text, uint32_t start, uint32_t overlapStart, uint32_t overlapEnd) {
+  uint32_t position = start, first = UINT32_MAX, last = 0;
+  const auto covered = [&] { return first != UINT32_MAX && first >= overlapStart && last <= overlapEnd; };
+  for (size_t offset = 0; offset < text.size();) {
+    const auto cp = ClippingTextMatcher::nextCodepoint(text.data(), text.size(), offset);
+    if (ignoredPosition(cp)) {
+      if (cp == 0xAD || cp == 0x200B || cp == 0xFEFF) continue;
+      if (covered()) return true;
+      first = UINT32_MAX;
+      continue;
+    }
+    if (!ClippingTextMatcher::isEdgePunctuation(cp)) {
+      if (first == UINT32_MAX) first = position;
+      last = position;
+    }
+    ++position;
+  }
+  return covered();
+}
+}  // namespace HighlightMerge
