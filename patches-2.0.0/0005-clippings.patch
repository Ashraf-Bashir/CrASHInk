+ for(int i=0;i<250;++i) millis();
+ RenderLock::busy=false;edgeBusy.loop();
+ assert(edgeBusy.touchPageAwaitMotion_ && edgeBusy.pageLoads==1);
+ Selection back;back.previousPageOk=true;back.mappedInput.x=100;back.mappedInput.y=-10;
+ for(int i=0;i<500 && !back.touchPageAwaitMotion_;++i)back.loop();
+ assert(back.touchPageAwaitMotion_ && back.navigator.current==1 && back.pageLoads==1);
+ const int calls=back.navigator.selectCalls;
+ for(int i=0;i<100;++i)back.loop();
+ assert(back.navigator.selectCalls==calls && back.touchDragLookup_ && back.clips==0);
+ back.mappedInput.x=50;back.mappedInput.y=10;back.loop();
+ assert(!back.touchPageAwaitMotion_ && back.touchDragLookup_ && back.controller.lookups==0);
+ back.mappedInput.held=false;back.loop();assert(back.clips==1 && back.controller.lookups==0);
+ Selection one;
+ for(int i=0;i<10000;++i) one.loop();
+ one.mappedInput.held=false;one.loop();
+ assert(one.clips==0 && one.controller.lookups==1 && one.controller.text=="one" && one.captures==1);
+ Selection reversed;
+ reversed.mappedInput.x=50;reversed.loop();
+ reversed.mappedInput.x=0;reversed.loop();
+ assert(reversed.controller.lookups==0);
+ reversed.mappedInput.held=false;reversed.loop();
+ assert(reversed.clips==0 && reversed.controller.lookups==1);
