diff --git a/src/ClippingNativeSync.cpp b/src/ClippingNativeSync.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..af0a0014025e1389fea1b78ff828e86c30186520
--- /dev/null
+++ b/src/ClippingNativeSync.cpp
@@ -0,0 +1,162 @@
+#include "ClippingStore.h"
+#include <HalStorage.h>
+#include <Memory.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+// Native v2 sync identities are separate from the custom quote format, so an
+// upgrade neither reinterprets v1 color/note records nor discards sync deletions.
+#include "clippings/ClippingIdentity.h"
+#include "sync/SyncFiles.h"
+#include "sync/SyncPending.h"
+namespace {
+constexpr uint32_t NATIVE_BINDINGS_MAGIC = 0x31424343;
+struct NativeBinding { char fingerprint[17]{}; char key[81]{}; };
+struct NativeBindings {
+  std::unique_ptr<NativeBinding[]> data;
+  size_t count = 0, capacity = 0;
+  bool reserve(size_t wanted) {
+    if (wanted <= capacity) return true;
+    if (wanted > CLIPPING_MAX_PER_BOOK) return false;
+    auto next = makeUniqueNoThrow<NativeBinding[]>(wanted);
+    if (!next) return false;
+    if (count) std::copy_n(data.get(), count, next.get());
+    data = std::move(next); capacity = wanted; return true;
+  }
+};
+std::string bindingsPath(const std::string& store) { return store + ".native-bindings"; }
+bool loadBindings(const std::string& store, NativeBindings& bindings) {
+  auto path = bindingsPath(store);
+  SyncFiles::Reader reader(path.c_str());
+  bool missing = false;
+  if (reader.open(&missing) == SyncFiles::Reader::Source::None) return missing;
+  uint32_t magic = 0; uint16_t count = 0;
+  if (!reader.pod(magic) || magic != NATIVE_BINDINGS_MAGIC || !reader.pod(count) || !bindings.reserve(count)) return false;
+  for (size_t i = 0; i < count; ++i) {
+    auto& entry = bindings.data[i];
+    if (!reader.read(&entry, sizeof(entry)) || entry.fingerprint[16] || entry.key[80] ||
+        std::strlen(entry.key) <= 16) return false;
+  }
+  bindings.count = count; return true;
+}
+bool saveBindings(const std::string& store, const NativeBindings& bindings) {
+  auto path = bindingsPath(store); SyncFiles::Writer writer(path.c_str());
+  const uint16_t count = bindings.count;
+  if (!writer.open() || !writer.pod(NATIVE_BINDINGS_MAGIC) || !writer.pod(count)) return false;
+  for (size_t i = 0; i < count; ++i)
+    if (!writer.write(&bindings.data[i], sizeof(NativeBinding))) return false;
+  return writer.commit();
+}
+bool sameFingerprint(const ClippingStore& store, size_t index, const char* fingerprint) {
+  const auto* clip = store.clippingAt(index); std::string text; char id[17];
+  return clip && store.readClippingText(index, text) && clippingSyncIdentity(clip->timestamp, text, id) &&
+         std::strcmp(id, fingerprint) == 0;
+}
+bool activeBinding(const ClippingStore& store, const NativeBinding& binding) {
+  for (size_t i = 0; i < store.clippingCount(); ++i)
+    if (sameFingerprint(store, i, binding.fingerprint)) return true;
+  return false;
+}
+}
+
+
+std::string ClippingStore::syncStatePath(const std::string& path) { return syncStorePathForBook(path) + ".sync"; }
+bool ClippingStore::prepareUploads(const std::string& path, const std::string& scope) {
+  if (scope.size() != 16) return false;
+  ClippingStore store; NativeBindings bindings;
+  if (!loadForSync(path, store) || !loadBindings(store.storeFilePath, bindings)) return false;
+  bool changed = false;
+  for (size_t i = 0; i < store.clippings.size(); ++i) {
+    std::string text; char fingerprint[17];
+    if (!store.readClippingText(i, text) || !clippingSyncIdentity(store.clippings[i].timestamp, text, fingerprint)) return false;
+    bool found = false;
+    for (size_t n = 0; n < bindings.count; ++n)
+      if (std::strcmp(bindings.data[n].fingerprint, fingerprint) == 0 && std::string_view(bindings.data[n].key).starts_with(scope)) { found = true; break; }
+    if (found) continue;
+    if (!bindings.reserve(bindings.count + 1)) return false;
+    auto& entry = bindings.data[bindings.count++];
+    std::memcpy(entry.fingerprint, fingerprint, sizeof(fingerprint));
+    const auto key = scope + newClippingSyncId();
+    if (key.size() > 80) return false;
+    std::snprintf(entry.key, sizeof(entry.key), "%s", key.c_str()); changed = true;
+  }
+  return !changed || saveBindings(store.storeFilePath, bindings);
+}
+bool ClippingStore::readForUpload(const std::string& path, size_t ordinal, SyncClipping& clip, std::string& text, bool& done, std::string* key) {
+  ClippingStore store; NativeBindings bindings;
+  if (!loadForSync(path, store) || !loadBindings(store.storeFilePath, bindings)) return false;
+  done = ordinal >= store.clippings.size(); if (done) return true;
+  static_cast<Clipping&>(clip) = store.clippings[ordinal];
+  if (!store.readClippingText(ordinal, text)) return false;
+  std::string chapter; if (!store.readChapterTitle(ordinal, chapter)) return false;
+  std::snprintf(clip.chapterTitle, sizeof(clip.chapterTitle), "%s", chapter.c_str());
+  char fingerprint[17]; if (!clippingSyncIdentity(clip.timestamp, text, fingerprint)) return false;
+  clip.uploaded = clip.scoped = false;
+  for (size_t i = bindings.count; i > 0; --i)
+    if (std::strcmp(bindings.data[i - 1].fingerprint, fingerprint) == 0) {
+      if (key) *key = bindings.data[i - 1].key;
+      clip.uploaded = clip.scoped = true; break;
+    }
+  return true;
+}
+bool ClippingStore::readDeletionForUpload(const std::string& path, size_t ordinal, std::string& id, bool& done) {
+  ClippingStore store; NativeBindings bindings;
+  if (!loadForSync(path, store) || !loadBindings(store.storeFilePath, bindings)) return false;
+  size_t deleted = 0; done = true;
+  for (size_t i = 0; i < bindings.count; ++i) {
+    if (activeBinding(store, bindings.data[i])) continue;
+    if (deleted++ == ordinal) { id = bindings.data[i].key; done = false; break; }
+  }
+  return true;
+}
+bool ClippingStore::acknowledgeDeletions(const std::string& path, const std::string& scope) {
+  ClippingStore store; NativeBindings bindings;
+  if (!loadForSync(path, store) || !loadBindings(store.storeFilePath, bindings)) return false;
+  size_t kept = 0;
+  for (size_t i = 0; i < bindings.count; ++i)
+    if (!std::string_view(bindings.data[i].key).starts_with(scope) || activeBinding(store, bindings.data[i]))
+      bindings.data[kept++] = bindings.data[i];
+  if (kept == bindings.count) return true;
+  bindings.count = kept; return saveBindings(store.storeFilePath, bindings);
+}
+bool ClippingStore::mergeFromSync(const std::string& path, const SyncClipping& incoming, const std::string& text, const std::string& key, bool deleted, bool* full) {
+  if (full) *full = false;
+  if (key.size() <= 16 || key.size() > 80) return false;
+  ClippingStore store; NativeBindings bindings;
+  if (!loadForSync(path, store) || !loadBindings(store.storeFilePath, bindings)) return false;
+  size_t binding = SIZE_MAX, match = SIZE_MAX;
+  for (size_t i = 0; i < bindings.count; ++i) if (key == bindings.data[i].key) { binding = i; break; }
+  char fingerprint[17]{};
+  if (!deleted && !clippingSyncIdentity(incoming.timestamp, text, fingerprint)) return false;
+  const char* wanted = binding == SIZE_MAX ? fingerprint : bindings.data[binding].fingerprint;
+  for (size_t i = 0; i < store.clippings.size(); ++i)
+    if (sameFingerprint(store, i, wanted)) { match = i; break; }
+  // An absent local record with an existing binding is a local deletion awaiting upload.
+  if (binding != SIZE_MAX && match == SIZE_MAX && !deleted) return true;
+  if (deleted) {
+    if (match != SIZE_MAX && !store.removeClippingAt(match)) return false;
+    if (binding != SIZE_MAX) { bindings.data[binding] = bindings.data[--bindings.count]; return saveBindings(store.storeFilePath, bindings); }
+    return true;
+  }
+  if (match == SIZE_MAX) {
+    const auto result = store.addClipping(incoming.spineIndex, incoming.startPage, incoming.endPage, incoming.pageCount,
+      incoming.startWordIndex, incoming.endWordIndex, incoming.wordCount, incoming.chapterTitle, incoming.paragraphIndex,
+      text, UINT16_MAX, 0, &match, ClippingColor::LightGrey, incoming.sourceStart, incoming.sourceEnd);
+    if (result != AddResult::Added) { if (full) *full = result == AddResult::LimitReached; return false; }
+    store.clippings[match].timestamp = incoming.timestamp;
+    store.dirty = true; if (!store.saveToFile()) return false;
+  }
+  if (binding == SIZE_MAX) {
+    if (!bindings.reserve(bindings.count + 1)) return false;
+    binding = bindings.count++;
+  }
+  std::snprintf(bindings.data[binding].fingerprint, 17, "%s", fingerprint);
+  std::snprintf(bindings.data[binding].key, 81, "%s", key.c_str());
+  return saveBindings(store.storeFilePath, bindings);
+}
+
+
+void ClippingStore::markChanged() {
+  if (!bookFilePath.empty()) SyncPending::mark(bookFilePath, SyncPending::CLIPPINGS_BIT);
+}
