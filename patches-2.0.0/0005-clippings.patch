+bool ClippingStore::loadForSync(const std::string& path, ClippingStore& store) {
+  auto file = storeFilePathForBook(path, "epub");
+  if (!Storage.exists(file.c_str())) file += ".bak";
+  ClippingFileHeader header;
+  if (Storage.exists(file.c_str()) && !readClippingFileHeader(file, nullptr, header)) return false;
+  if (!header.path.empty() && header.path != path) return false;
+  return store.loadForBook(path, header.title.empty() ? path.substr(path.find_last_of('/') + 1) : header.title, header.author, "epub");
+}
+
+ClippingStore::ClippedBookStep ClippingStore::nextClippedEpub(uint64_t& position, std::string& path) {
+  auto dir = Storage.open(CLIPPINGS_DIR); if (!dir) return ClippedBookStep::Done;
+  if (!dir.seek(position)) return ClippedBookStep::Error;
+  auto file = dir.openNextFile(); if (!file) return ClippedBookStep::Done;
+  position = dir.position();
+  const bool folder = file.isDirectory(); char name[96]{}; file.getName(name, sizeof(name)); file.close(); dir.close();
+  if (folder || !std::string_view(name).ends_with(".bin")) return ClippedBookStep::Skip;
+  const std::string filePath = std::string(CLIPPINGS_DIR) + "/" + name;
+  ClippingFileHeader header; uint16_t count = 0;
+  if (!readClippingFileHeader(filePath, nullptr, header) || !header.count || !FsHelpers::hasEpubExtension(header.path) || !Storage.exists(header.path.c_str())) return ClippedBookStep::Skip;
+  path = std::move(header.path); return ClippedBookStep::Book;
+}
+
+std::string ClippingStore::syncStorePathForBook(const std::string& path) { return storeFilePathForBook(path, "epub"); }
