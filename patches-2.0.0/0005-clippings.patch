+  int upperBottom = 0, lowerTop = 100;
+  paintSeparated(GapRect{10, 10, 20, 30}, seams, 0,
+                 [&](const GapRect& r) { upperBottom = std::max(upperBottom, r.y + r.height); });
+  paintSeparated(GapRect{10, 10, 20, 30}, seams, 1, [&](const GapRect& r) { lowerTop = std::min(lowerTop, r.y); });
