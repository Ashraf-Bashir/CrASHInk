+bool contains(const Rect& r, int x, int y, int pad = 0) {
+  return r.width > 0 && r.height > 0 && x >= r.x - pad && x < r.x + r.width + pad && y >= r.y - pad &&
+         y < r.y + r.height + pad;
+}
+void disk(const GfxRenderer& renderer, int x, int y, int radius, bool black) {
+  for (int dy = -radius; dy <= radius; ++dy)
+    for (int dx = -radius; dx <= radius; ++dx)
+      if (dx * dx + dy * dy <= radius * radius) renderer.drawPixel(x + dx, y + dy, black);
+}
+
+void toolbarIcon(const GfxRenderer& renderer, const HighlightToolbar::Bounds& button, HighlightToolbar::Action action, int selectedColor = -1) {
+  const int x = button.x + (button.width - 24) / 2;
+  const int y = button.y + (button.height - 24) / 2;
+  if (action <= HighlightToolbar::Action::Solid) {
+    const Color fill = action == HighlightToolbar::Action::LightGrey ? Color::LightGray
+                       : action == HighlightToolbar::Action::DarkGrey ? Color::DarkGray
+                       : SETTINGS.screenInverted ? Color::White : Color::Black;
+    renderer.fillRectDither(x + 2, y + 2, 20, 20, fill);
+    renderer.drawRect(x + 2, y + 2, 20, 20, true);
+    if (static_cast<int>(action) == selectedColor) {
+      // A contrasting tick stays readable on all three shades and in dark mode.
+      const bool ink = action != HighlightToolbar::Action::Solid || SETTINGS.screenInverted;
+      renderer.drawLine(x + 6, y + 12, x + 10, y + 16, 5, !ink);
+      renderer.drawLine(x + 10, y + 16, x + 18, y + 7, 5, !ink);
+      renderer.drawLine(x + 6, y + 12, x + 10, y + 16, 2, ink);
+      renderer.drawLine(x + 10, y + 16, x + 18, y + 7, 2, ink);
+    }
+    return;
+  }
+  const auto line = [&](int x1, int y1, int x2, int y2) { renderer.drawLine(x + x1, y + y1, x + x2, y + y2, 3, true); };
+  if (action == HighlightToolbar::Action::Delete) {
+    line(4, 5, 20, 5);
+    line(9, 2, 15, 2);
+    line(9, 2, 9, 5);
+    line(15, 2, 15, 5);
+    line(6, 8, 7, 22);
+    line(7, 22, 17, 22);
+    line(17, 22, 18, 8);
+    line(10, 10, 10, 18);
+    line(14, 10, 14, 18);
+  } else if (action == HighlightToolbar::Action::Share) {
+    line(5, 19, 20, 4);
+    line(11, 4, 20, 4);
+    line(20, 4, 20, 13);
+  } else {
+    line(3, 21, 5, 14);
+    line(5, 14, 17, 2);
+    line(17, 2, 22, 7);
+    line(22, 7, 10, 19);
+    line(10, 19, 3, 21);
+    line(14, 5, 19, 10);
+  }
+}
