+  const Rect safe = UITheme::getInstance().getScreenSafeArea(renderer, true, false);
+  const ClippingListPaging paging{static_cast<int>(chapterGroups.rows.size()), visibleRows, listNav.top};
+  char count[48];
+  snprintf(count, sizeof(count), tr(STR_CLIPPINGS_COUNT_FORMAT), static_cast<unsigned>(filteredCount));
+  renderer.drawText(UI_10_FONT_ID, safe.x + (safe.width - renderer.getTextWidth(UI_10_FONT_ID, count)) / 2,
+                    safe.y + safe.height - 82, count);
+  const int y = safe.y + safe.height - 28 - renderer.getLineHeight(UI_10_FONT_ID) / 2;
+  char page[48];
+  snprintf(page, sizeof(page), tr(STR_CLIPPINGS_PAGE_FORMAT), paging.page(), paging.pages());
+  renderer.drawText(UI_10_FONT_ID, safe.x + (safe.width - renderer.getTextWidth(UI_10_FONT_ID, page)) / 2, y, page);
+  for (const bool forward : {false, true}) {
+    const auto rect = listPageButton(forward);
+    if ((forward && paging.page() == paging.pages()) || (!forward && paging.page() == 1)) continue;
+    renderer.drawRect(rect.x, rect.y, rect.width, rect.height, true);
+    const int center = rect.x + rect.width / 2;
+    const int direction = forward ? 1 : -1;
+    const int x[] = {center - direction * 4, center + direction * 5, center - direction * 4};
+    const int yy[] = {rect.y + 14, rect.y + 22, rect.y + 30};
+    renderer.fillPolygon(x, yy, 3, true);
+  }
+}
