+namespace ClipSelectionPaging {
+bool hasDraggedFrom(int x,int y,int a,int b) {return std::abs(a-x)>10 || std::abs(b-y)>10;}
+}
+struct Input {
+ bool held=true;int x=0,y=0;
+ bool isScreenTouchHeld(int& a,int& b) const {a=x;b=y;return held;}
+};
+struct Renderer {int getLineHeight(int) const {return 20;}int getScreenHeight() const {return 320;}};
+struct {int getReaderFontId() const {return 0;}} SETTINGS;
+struct RenderLock {
+ static inline bool busy=false;
+ template<class T> explicit RenderLock(T&) {}
