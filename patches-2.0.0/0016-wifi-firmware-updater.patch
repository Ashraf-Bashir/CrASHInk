diff --git a/src/network/WifiFirmwareUpdate.cpp b/src/network/WifiFirmwareUpdate.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..75447bdf06ce6585997220c3fa1fcc5034fc0a57
--- /dev/null
+++ b/src/network/WifiFirmwareUpdate.cpp
@@ -0,0 +1,209 @@
+#include "WifiFirmwareUpdate.h"
+
+#if !defined(SIMULATOR) && FREEINK_DEVICE_X4PRO
+#include <Arduino.h>
+#include <HalStorage.h>
+#include <WebServer.h>
+#include <WiFi.h>
+#include <esp_ota_ops.h>
+#include <mbedtls/sha256.h>
+#include <mbedtls/pk.h>
+
+#include <array>
+#include <memory>
+#include <new>
+
+#include "FirmwareFlasher.h"
+
+namespace {
+constexpr char IMAGE_PATH[] = "/.crashink-ota-staging.bin";
+constexpr uint16_t PORT = 8081;
+constexpr char DIGEST_HEADER[] = "X-Crashink-SHA256";
+constexpr char SIGNATURE_HEADER[] = "X-Crashink-Signature";
+constexpr char SIGNING_PUBLIC_KEY[] = R"pem(-----BEGIN PUBLIC KEY-----
+MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvkvq+2wEci6kZ5V418RR
+s68kaEGwVVKcXKAT8fH8nioBruh+YuvL3c7y8shz2547JLuVCXBPfyGk0ec639oa
+F8cBTg4av8b8V2uoeWc3ELkZlEUSaogEeJZFXhsN3jYWctrCtL+dbea1lxFAAbXZ
+r56EKCaojlEN9SV8T8k6XDIbRKv56FM8UrIFQY4PUAHxCIB7W3jnviAtz5CDCNUn
+zQNWLqmapMdYtZPp85wSMLX6taBqv8aBBceIZGqG16QDpRme+3MO+2rNU3EpPSCu
++bV0rIPjzxsV4khvyfa+vQufcjRBq4GX/qx0c/Hv9qxsYdsB9egnyhwcz7oweMr/
+swIDAQAB
+-----END PUBLIC KEY-----
+)pem";
+constexpr char HEX_DIGITS[] = "0123456789abcdef";
+
+std::unique_ptr<WebServer> server;
+std::array<uint8_t, 32> expectedDigest{};
+HalFile staging;
+mbedtls_sha256_context hash;
+size_t imageSize = 0;
+int errorCode = 400;
+bool authorized = false;
+bool ready = false;
+bool ownsStaging = false;
+bool accepted = false;
+
+template <size_t N>
+bool decodeHex(const char* hex, size_t length, std::array<uint8_t, N>& result) {
+  if (length != 2 * N) return false;
+  for (size_t i = 0; i < N; ++i) {
+    const char* hi = strchr(HEX_DIGITS, hex[2 * i]);
+    const char* lo = strchr(HEX_DIGITS, hex[2 * i + 1]);
+    if (!hi || !lo || !*hi || !*lo) return false;
+    result[i] = static_cast<uint8_t>((hi - HEX_DIGITS) * 16 + lo - HEX_DIGITS);
+  }
+  return true;
+}
+
+bool equalDigest(const std::array<uint8_t, 32>& a, const std::array<uint8_t, 32>& b) {
+  unsigned difference = 0;
+  for (size_t i = 0; i < a.size(); ++i) difference |= a[i] ^ b[i];
+  return difference == 0;
+}
+
+void clearStaging() {
+  if (staging) staging.close();
+  if (ownsStaging) Storage.remove(IMAGE_PATH);
+  ownsStaging = false;
+  ready = false;
+}
+
+bool verifySignature() {
+  const auto header = server->header(SIGNATURE_HEADER);
+  std::array<uint8_t, 256> signature{};
+  if (!decodeHex(header.c_str(), header.length(), signature)) return false;
+  mbedtls_pk_context publicKey;
+  mbedtls_pk_init(&publicKey);
+  const bool valid = mbedtls_pk_parse_public_key(&publicKey,
+      reinterpret_cast<const uint8_t*>(SIGNING_PUBLIC_KEY), sizeof(SIGNING_PUBLIC_KEY)) == 0 &&
+      mbedtls_pk_verify(&publicKey, MBEDTLS_MD_SHA256, expectedDigest.data(), expectedDigest.size(),
+                       signature.data(), signature.size()) == 0;
+  mbedtls_pk_free(&publicKey);
+  return valid;
+}
+
+void receiveImage() {
+  const auto& raw = server->raw();
+  switch (raw.status) {
+    case RAW_START: {
+      clearStaging();
+      errorCode = 400;
+      authorized = false;
+      const int length = server->clientContentLength();
+      const auto* partition = esp_ota_get_next_update_partition(nullptr);
+      if (!partition || length < 24 || static_cast<size_t>(length) > partition->size) {
+        errorCode = 413;
+        return;
+      }
+      imageSize = length;
+      const auto digest = server->header(DIGEST_HEADER);
+      if (!decodeHex(digest.c_str(), digest.length(), expectedDigest)) return;
+      if (!verifySignature()) {
+        errorCode = 403;
+        return;
+      }
+      authorized = true;
+      Storage.remove(IMAGE_PATH);
+      if (!Storage.openFileForWrite("OTA", IMAGE_PATH, staging)) {
+        errorCode = 507;
+        authorized = false;
+        return;
+      }
+      ownsStaging = true;
+      mbedtls_sha256_init(&hash);
+      mbedtls_sha256_starts(&hash, 0);
+      break;
+    }
+    case RAW_WRITE:
+      if (authorized && staging) {
+        if (staging.write(raw.buf, raw.currentSize) != raw.currentSize) {
+          errorCode = 507;
+          clearStaging();
+        } else {
+          mbedtls_sha256_update(&hash, raw.buf, raw.currentSize);
+        }
+      }
+      break;
+    case RAW_END:
+    case RAW_ABORTED:
+      if (authorized) {
+        std::array<uint8_t, 32> actual{};
+        mbedtls_sha256_finish(&hash, actual.data());
+        mbedtls_sha256_free(&hash);
+        authorized = false;
+        if (raw.status == RAW_END && staging && raw.totalSize == imageSize &&
+            equalDigest(actual, expectedDigest) && staging.sync()) {
+          staging.close();
+          ready = true;
+        } else {
+          if (errorCode != 507) errorCode = 422;
+          clearStaging();
+        }
+      }
+      break;
+  }
+}
+
+void closeListener() {
+  if (!server) return;
+  server.reset();
+}
+
+void install() {
+  if (!ready) {
+    server->send(errorCode, "text/plain", "Firmware rejected before flashing");
+    return;
+  }
+  const auto* partition = esp_ota_get_next_update_partition(nullptr);
+  auto result = firmware_flash::Result::OPEN_FAIL;
+  if (partition && Storage.openFileForRead("OTA", IMAGE_PATH, staging)) {
+    result = firmware_flash::validateOpenImageFile(staging, partition->size);
+  }
+  if (result != firmware_flash::Result::OK) {
+    clearStaging();
+    server->send(422, "text/plain", firmware_flash::resultName(result));
+    return;
+  }
+  accepted = true;
+  server->send(200, "text/plain", "received\n");
+}
+}  // namespace
+
+bool wifi_firmware_update::start() {
+  if (WiFi.status() != WL_CONNECTED) return false;
+  server.reset(new (std::nothrow) WebServer(PORT));
+  if (!server) return false;
+  const char* headers[]{DIGEST_HEADER, SIGNATURE_HEADER};
+  server->collectHeaders(headers, 2);
+  server->on("/ota/status", HTTP_GET, [] { server->send(200, "text/plain", "crashink-receive-v3"); });
+  server->on("/ota/install", HTTP_POST, install, receiveImage);
+  server->begin();
+  return true;
+}
+
+void wifi_firmware_update::stop() {
+  closeListener();
+  clearStaging();
+  accepted = false;
+}
+
+bool wifi_firmware_update::poll() {
+  if (server) server->handleClient();
+  return accepted;
+}
+
+bool wifi_firmware_update::installReceived(Progress progress, void* context) {
+  if (!accepted || !staging || WiFi.getMode() != WIFI_OFF) return false;
+  const auto result = firmware_flash::flashValidatedFile(staging, progress, context);
+  stop();
+  return result == firmware_flash::Result::OK;
+}
+
+void wifi_firmware_update::stopListening() { closeListener(); }
+#else
+bool wifi_firmware_update::start() { return false; }
+void wifi_firmware_update::stop() {}
+bool wifi_firmware_update::poll() { return false; }
+bool wifi_firmware_update::installReceived(Progress, void*) { return false; }
+void wifi_firmware_update::stopListening() {}
+#endif
diff --git a/src/network/WifiFirmwareUpdate.h b/src/network/WifiFirmwareUpdate.h
new file mode 100644
index 0000000000000000000000000000000000000000..66ae641e702aa45991ee9602bc88f2d5d593a176
--- /dev/null
+++ b/src/network/WifiFirmwareUpdate.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace wifi_firmware_update {
+constexpr uint32_t LISTEN_TIMEOUT_MS = 5 * 60 * 1000;
+constexpr uint32_t remainingListenSeconds(uint32_t startedAt, uint32_t now) {
+  const uint32_t elapsed = now - startedAt;
+  return elapsed >= LISTEN_TIMEOUT_MS ? 0 : (LISTEN_TIMEOUT_MS - elapsed + 999) / 1000;
+}
+using Progress = void (*)(size_t written, size_t total, void* context);
+bool start();
+void stop();
+void stopListening();
+bool poll();
+bool installReceived(Progress progress, void* context);
+}
