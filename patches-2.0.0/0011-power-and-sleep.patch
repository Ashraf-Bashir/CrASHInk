+    EXPECT_LT(index("wake policy saved"), index("hardware sleep"));
+    EXPECT_LT(index("light sleep"), index("hardware sleep"));
+  }
+}
+TEST(SleepEntry, FailedStorageShutdownRestoresInputInsteadOfSleeping) {
+  events.clear(); storageOk = false; quick = false;
+  enterDeepSleep(true);
+  EXPECT_FALSE(deepSleepInProgress);
+  EXPECT_EQ(std::count(events.begin(), events.end(), "hardware sleep"), 0);
+  EXPECT_EQ(std::count(events.begin(), events.end(), "restart buttons"), 1);
+  EXPECT_EQ(events.back(), "home");
+}
