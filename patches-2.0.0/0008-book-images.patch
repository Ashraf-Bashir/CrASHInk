+bool runCombinedImagePass(GfxRenderer& renderer, const Page& page, const int fontId, const int marginLeft,
+                          const int marginTop, uint8_t* plane) {
+  if (!plane || !renderer.beginCombinedGrayscale()) return false;
+
+  for (const auto mode : {GfxRenderer::GRAYSCALE_LSB, GfxRenderer::GRAYSCALE_MSB}) {
+    std::memcpy(plane, renderer.getFrameBuffer(), renderer.getBufferSize());
+    renderer.setRenderMode(mode);
+    renderer.beginStripTarget(plane, 0, renderer.getDisplayHeight());
+    page.renderImages(renderer, fontId, marginLeft, marginTop);
+    renderer.endStripTarget();
+    if (mode == GfxRenderer::GRAYSCALE_LSB)
+      renderer.copyGrayscaleLsbBuffers(plane);
+    else
+      renderer.copyGrayscaleMsbBuffers(plane);
+  }
+  renderer.displayGrayBuffer();
+  renderer.setRenderMode(GfxRenderer::BW);
+  renderer.cleanupGrayscaleWithFrameBuffer();
+  return true;
+}
