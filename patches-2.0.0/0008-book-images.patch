diff --git a/lib/GfxRenderer/ImageContrast.h b/lib/GfxRenderer/ImageContrast.h
new file mode 100644
index 0000000000000000000000000000000000000000..d6c6feb4d4b2fc8775c9fa428d5cb185b93ecdcf
--- /dev/null
+++ b/lib/GfxRenderer/ImageContrast.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <cstdint>
+
+inline constexpr uint8_t NORMAL_IMAGE_CONTRAST = 100;
+
+// Move a controlled fraction of midtone pixels to the neighboring panel
+// shade. Preserve pure black and white so line art and page margins stay crisp.
+constexpr uint8_t applyImageContrast(uint8_t level, uint8_t contrast, int panelX, int panelY) {
+  if (contrast == NORMAL_IMAGE_CONTRAST || level == 0 || level >= 3) return level;
+  constexpr uint8_t matrix[4][4] = {{0, 8, 2, 10}, {12, 4, 14, 6}, {3, 11, 1, 9}, {15, 7, 13, 5}};
+  const bool stronger = contrast > NORMAL_IMAGE_CONTRAST;
+  const int distance = stronger ? contrast - NORMAL_IMAGE_CONTRAST : NORMAL_IMAGE_CONTRAST - contrast;
+  const int threshold = distance * (stronger ? 16 : 8) / 100;
+  if (matrix[panelY & 3][panelX & 3] >= threshold) return level;
+  return static_cast<uint8_t>((level == 2) == stronger ? level + 1 : level - 1);
+}
+
+constexpr uint8_t applyImageMonochrome(uint8_t level) {
+  return level < 2 ? 0 : 3;
+}
