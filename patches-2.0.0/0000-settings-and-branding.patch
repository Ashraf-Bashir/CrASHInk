+set(MENU_INCLUDES ${CMAKE_CURRENT_BINARY_DIR}/SettingsActions.inc ${CMAKE_CURRENT_BINARY_DIR}/Menus.inc
+ ${CMAKE_CURRENT_BINARY_DIR}/SettingsFooter.inc ${CMAKE_CURRENT_BINARY_DIR}/ReadestRows.inc ${CMAKE_CURRENT_BINARY_DIR}/ReadestSelection.inc)
+add_custom_command(OUTPUT ${MENU_INCLUDES}
+ COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/ExtractMenus.py ${REPO_ROOT} ${CMAKE_CURRENT_BINARY_DIR}
+ DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/ExtractMenus.py ${REPO_ROOT}/src/SettingsList.h
+ ${REPO_ROOT}/src/activities/settings/SettingsActivity.h ${REPO_ROOT}/src/activities/settings/SettingsActivity.cpp
+ ${REPO_ROOT}/src/activities/settings/ReadestSettingsActivity.cpp VERBATIM)
+add_executable(settings_menus_test SettingsMenusTest.cpp ${MENU_INCLUDES})
+target_include_directories(settings_menus_test PRIVATE ${CMAKE_CURRENT_BINARY_DIR} ${REPO_ROOT}/lib/I18n)
+target_compile_features(settings_menus_test PRIVATE cxx_std_20)
+target_compile_options(settings_menus_test PRIVATE -UNDEBUG -Wall -Wextra -Werror)
+add_test(NAME settings_menus COMMAND settings_menus_test)
