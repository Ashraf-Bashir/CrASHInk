+from pathlib import Path
+import sys
+root,out=map(Path,sys.argv[1:])
+def function(text,signature):
+ a=text.index(signature);b=text.index('\n}',a)+2
+ return text[a:b]
+text=(root/'src/SettingsList.h').read_text()
+methods=['inline void addSettingByName(', 'inline std::vector<SettingInfo> buildReaderSettingsParentList(',
+ 'inline std::vector<SettingInfo> buildBookReaderSettingsParentList(', 'inline std::vector<SettingInfo> buildReaderImageSettingsList(',
+ 'inline std::vector<SettingInfo> buildSystemSettingsParentList(']
+header=(root/'src/activities/settings/SettingsActivity.h').read_text()
+a=header.index('enum class SettingAction');b=header.index('\n};',a)+3
+(out/'SettingsActions.inc').write_text(header[a:b])
+(out/'Menus.inc').write_text('\n'.join(function(text,s) for s in methods))
+text=(root/'src/activities/settings/SettingsActivity.cpp').read_text()
+a=text.index('  int top, right, bottom, left;',text.index('void SettingsActivity::buildSettingsScreen'))
+b=text.index('\n\n  if (isFileBrowserView())',a)
+(out/'SettingsFooter.inc').write_text(text[a:b])
+text=(root/'src/activities/settings/ReadestSettingsActivity.cpp').read_text()
+a=text.index('constexpr int MENU_ITEMS');b=text.index('constexpr fui::ActionId',a)
+(out/'ReadestRows.inc').write_text(text[a:b])
+(out/'ReadestSelection.inc').write_text(function(text,'void ReadestSettingsActivity::handleSelection()'))
