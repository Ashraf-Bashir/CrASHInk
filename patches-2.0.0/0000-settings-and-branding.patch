+#include <algorithm>
+#include <cassert>
+#include <string>
+#include <vector>
+#include "I18nKeys.h"
+#define FREEINK_DEVICE_X4PRO 1
+#define FREEINK_DEVICE_PICCO 0
+#include "SettingsActions.inc"
+enum class SettingType {ENUM,ACTION,SUBMENU,TOGGLE};
+struct SettingInfo {
+ StrId nameId;SettingType type=SettingType::ENUM;SettingAction action=SettingAction::None;
+ static SettingInfo Submenu(StrId id,SettingAction action) {return {id,SettingType::SUBMENU,action};}
+ static SettingInfo Action(StrId id,SettingAction action) {return {id,SettingType::ACTION,action};}
+};
+#include "Menus.inc"
+namespace AppNavigation {constexpr int Height=54;enum class View {None,Settings};}
+namespace UITheme {int getButtonHintsReserve(int){return 24;}}
+namespace fui {struct Insets {int16_t top,right,bottom,left;};}
+struct Renderer {int edge=0;void getOrientedViewableTRBL(int* t,int* r,int* b,int* l){*t=*r=*l=0;*b=edge;}};
+struct Screen {int reserve=0;};
+void setUiContentMargin(Screen& s,Renderer&,fui::Insets i) {s.reserve=i.bottom;}
+namespace UITheme {int getButtonHintsReserve(const Renderer&){return 24;}}
+struct SettingsViewport {
+ Renderer renderer;AppNavigation::View view=AppNavigation::View::Settings;
+ AppNavigation::View appNavigationView()const{return view;}
+ void build(Screen& screen) {int tabTop=40;
+#include "SettingsFooter.inc"
+ }
+};
+#include "ReadestRows.inc"
+struct Settings {uint8_t readestAutoSync=0;bool saves=true;bool saveToFile(){return saves;}} settings;
+#define SETTINGS settings
+struct Store {bool credentials=false;bool hasCredentials(){return credentials;}void clear(){credentials=false;}bool saveToFile(){return true;}} store;
+#define READEST_STORE store
+namespace ReadestBookMap {void clearAll(){}}
+namespace ReadestCopies {void clearAll(){}}
+#define LOG_ERR(...) ((void)0)
+struct ReadestSettingsActivity {
+ enum class PendingStep {None,Connect};PendingStep pendingStep=PendingStep::None;
+ size_t selectedIndex=0;bool enableAutoSyncAfterCredentials=false;int emails=0,updates=0;
+ void askEmail(){++emails;}void requestUpdate(){++updates;}void handleSelection();
+};
+#include "ReadestSelection.inc"
+int main() {
+ std::vector<SettingInfo> all;
+ for(auto id:{StrId::STR_IMAGES,StrId::STR_IMAGE_CONTRAST,StrId::STR_INVERT_IMAGES_DARK,
+ StrId::STR_MONOCHROME_IMAGES,StrId::STR_TRANSPARENT_IMAGE_BACKGROUND,StrId::STR_READEST_AUTO_SYNC}) all.push_back({id});
+ const auto reader=buildReaderSettingsParentList(all);
+ assert(std::count_if(reader.begin(),reader.end(),[](auto v){return v.nameId==StrId::STR_IMAGES && v.type==SettingType::SUBMENU && v.action==SettingAction::ReaderImages;})==1);
+ for(auto s:reader) assert(s.nameId!=StrId::STR_IMAGE_CONTRAST && s.nameId!=StrId::STR_INVERT_IMAGES_DARK && s.nameId!=StrId::STR_MONOCHROME_IMAGES && s.nameId!=StrId::STR_TRANSPARENT_IMAGE_BACKGROUND);
+ const auto images=buildReaderImageSettingsList(all);assert(images.size()==5);
+ assert(images[0].nameId==StrId::STR_IMAGES && images[0].type==SettingType::ENUM);
+ const auto book=buildBookReaderSettingsParentList(all);assert(std::count_if(book.begin(),book.end(),[](auto v){return v.action==SettingAction::ReaderImages;})==1);
+ const auto system=buildSystemSettingsParentList(all);
+ size_t sd=system.size(),wifi=system.size();int readest=0;
+ for(size_t i=0;i<system.size();++i) {
+  assert(system[i].nameId!=StrId::STR_READEST_AUTO_SYNC);
+  if(system[i].nameId==StrId::STR_READEST)++readest;
+  if(system[i].action==SettingAction::SdFirmwareUpdate)sd=i;
+  if(system[i].action==SettingAction::ReceiveFirmwareUpdate){wifi=i;assert(system[i].nameId==StrId::STR_WIFI_FIRMWARE_UPDATE);}
+ }
+ assert(readest==1 && wifi==sd+1 && wifi<system.size());
+ for(int edge:{0,1,8,16}) {
+  SettingsViewport viewport;viewport.renderer.edge=edge;Screen screen;viewport.build(screen);
+  assert(screen.reserve==edge+AppNavigation::Height);
+  const int height=800,bodyTop=120,rowHeight=50,rows=(height-bodyTop-screen.reserve)/rowHeight;
+  assert(bodyTop+rows*rowHeight<=height-edge-AppNavigation::Height);
+  viewport.view=AppNavigation::View::None;viewport.build(screen);assert(screen.reserve==24);
+ }
+ ReadestSettingsActivity readestMenu;readestMenu.selectedIndex=ROW_AUTO_SYNC;
+ assert(MENU_ITEMS==5 && menuNames[ROW_AUTO_SYNC]==StrId::STR_READEST_AUTO_SYNC);
+ readestMenu.handleSelection();assert(readestMenu.emails==1 && readestMenu.enableAutoSyncAfterCredentials && !SETTINGS.readestAutoSync);
+ store.credentials=true;readestMenu.handleSelection();assert(SETTINGS.readestAutoSync);
+ readestMenu.handleSelection();assert(!SETTINGS.readestAutoSync);
+ SETTINGS.saves=false;readestMenu.handleSelection();assert(!SETTINGS.readestAutoSync);
+ SETTINGS.saves=true;SETTINGS.readestAutoSync=1;readestMenu.selectedIndex=ROW_DISCONNECT;
+ readestMenu.handleSelection();assert(!SETTINGS.readestAutoSync && !store.credentials);
+}
