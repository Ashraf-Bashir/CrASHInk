+TEST_F(ChapterHtmlSlimParserTest, LayoutOffPreservesCombinedEmphasis) {
+  parser.embeddedStyle = false;
+  cssParser.rulesBySelector_[".accent"] = CssParser::parseInlineStyle(
+      "font-weight:bold; font-style:italic; text-decoration:underline; display:none; font-size:300%");
+  const XML_Char* attributes[] = {"class", "accent", nullptr};
+  ChapterHtmlSlimParser::startElement(&parser, "p", nullptr);
+  ChapterHtmlSlimParser::startElement(&parser, "span", attributes);
+  ChapterHtmlSlimParser::characterData(&parser, "Combined ", 9);
+  ChapterHtmlSlimParser::endElement(&parser, "span");
+  ChapterHtmlSlimParser::characterData(&parser, "Plain", 5);
+  ChapterHtmlSlimParser::endElement(&parser, "p");
+
+  ASSERT_EQ(parser.currentTextBlock->size(), 2u);
+  EXPECT_EQ(parser.currentTextBlock->getWordStyleAt(0),
+            static_cast<EpdFontFamily::Style>(EpdFontFamily::BOLD | EpdFontFamily::ITALIC | EpdFontFamily::UNDERLINE));
+  EXPECT_EQ(parser.currentTextBlock->getWordStyleAt(1), EpdFontFamily::REGULAR);
+}
