+#include <Epub/Page.h>
+#include <GfxRenderer.h>
+#include <gtest/gtest.h>
+#include <array>
+#include <string>
+#define class struct
+#define private public
+#include "Epub/parsers/ChapterHtmlSlimParser.h"
+#undef private
+#undef class
+#include <Epub.h>
+#include <MemoryBudget.h>
+class ChapterHeadingBoldTest : public ::testing::Test {
+ protected:
+  std::string filepath="unused.xhtml";
+  Epub epub;GfxRenderer renderer;CssParser cssParser{"/tmp"};
+  ChapterHtmlSlimParser parser{epub,filepath,renderer,0,1.0f,false,false,0,480,800,false,
+    false,false,0,{},true,"","",0,{},nullptr,&cssParser};
+  std::array<ChapterHtmlSlimParser::StyleStackEntry,ChapterHtmlSlimParser::MAX_INLINE_STYLE_DEPTH> inlineStyles{};
+  std::array<BlockStyle,ChapterHtmlSlimParser::MAX_BLOCK_STYLE_DEPTH> blockStyles{};
+  void SetUp() override {
+    Storage.files.clear();GfxRenderer::loanActive=false;MemoryBudget::imageAllowed=true;
+    parser.currentTextBlock=std::make_unique<ParsedText>(false);
+    parser.inlineStyleBuf_=inlineStyles.data();parser.blockStyleBuf_=blockStyles.data();parser.blockStyleCount_=1;
+  }
+};
+TEST_F(ChapterHeadingBoldTest, HeadingAndNestedNormalWeightSpanStayBoldWithoutAffectingBody) {
+  const XML_Char* normal[] = {"style", "font-weight:normal", nullptr};
+  ChapterHtmlSlimParser::startElement(&parser, "h2", normal);
+  ChapterHtmlSlimParser::startElement(&parser, "span", normal);
+  ChapterHtmlSlimParser::characterData(&parser, "Chapter ", 8);
+  ASSERT_EQ(parser.currentTextBlock->size(), 1u);
+  EXPECT_EQ(parser.currentTextBlock->getWordStyleAt(0) & EpdFontFamily::BOLD, EpdFontFamily::BOLD);
+  ChapterHtmlSlimParser::endElement(&parser, "span");
+  ChapterHtmlSlimParser::endElement(&parser, "h2");
+  ChapterHtmlSlimParser::startElement(&parser, "p", normal);
+  ChapterHtmlSlimParser::characterData(&parser, "Body ", 5);
+  ASSERT_EQ(parser.currentTextBlock->size(), 1u);
+  EXPECT_EQ(parser.currentTextBlock->getWordStyleAt(0), EpdFontFamily::REGULAR);
+}
